\date{2026-05-19}
\title{Descent for pushouts}
\taxon{Module}
\author{fredrikbakke}

\import{stt-macros}

\agda{
module Core.DescentPushouts where

open import Foundations.Prelude
open import Axioms.UF
open import Core.Arrows
open import Core.ArrowEquiv
open import Core.CartesianDependentSpans
}

\subtree[fre-0001]{
\title{Cartesian dependent span diagrams classify cocones into the universe}
\taxon{Lemma}
\author{fredrikbakke}

\p{
For any span #{S}, the type of cocones from #{S} into the universe
#{\UU} is equivalent to the type of #{\UU}-small cartesian dependent span
diagrams over #{S}.
}

\proof{
\p{
Let #{A \xleftarrow{f} X \xrightarrow{g} B} be our span. A cocone into #{\UU}
consists of families #{L : A \to \UU} and #{R : B \to \UU} together with an
identification #{L \circ f = R \circ g}. We may expand this data with the
"redundant", i.e. contractible, information of a middle factoring point. I.e., we
factor the identification #{L \circ f = R \circ g} by a family #{C} over #{X},
yielding identifications #{C = L \circ f} and #{C = R \circ g}. Finally, by
univalence, such identifications are the same as families of equivalences.
}
}

\agda{
module _ {𝓤 𝓥 𝓦 𝓛} {S : Span 𝓤 𝓥 𝓦} where

  span←Type-cocone
    : Cocone S (Type 𝓛) → cartesian-span-diagramᵈ S 𝓛 𝓛 𝓛
  span←Type-cocone (mk-cocone P-left P-right H)
    = mk-cartesian-span-diagramᵈ
        P-left
        P-right
        (P-left ∘ Span.left S)
        (λ _ → id≃)
        (λ s → coe≃ (H s))

  Π-swap-cartesian-spanᵈ
    : (P-left : Span.Left S → Type 𝓛)
      (P-right : Span.Right S → Type 𝓛)
    → cartesian-spanᵈ S 𝓛 P-left P-right
    ≃ ( (s : Span.Centre S)
      → Σ[ P-centre ∶ Type 𝓛 ]
          ( (P-centre ≃ P-left (Span.left S s))
          × (P-centre ≃ P-right (Span.right S s))))
  Π-swap-cartesian-spanᵈ P-left P-right
    = mk≃
      ( λ R s
        → ( R .cartesian-spanᵈ.Centre s
          , R .cartesian-spanᵈ.Left≃ s
          , R .cartesian-spanᵈ.Right≃ s))
      ( mk-eqv
        ( ( λ R
            → mk-cartesian-spanᵈ (fst ∘ R) (fst ∘ snd ∘ R) (snd ∘ snd ∘ R))
          , ~refl
          , ~refl)
        (~refl))

  Type-cocone←span
    : cartesian-span-diagramᵈ S 𝓛 𝓛 𝓛 → Cocone S (Type 𝓛)
  Type-cocone←span P
    = mk-cocone
        (P .cartesian-span-diagramᵈ.Left)
        (P .cartesian-span-diagramᵈ.Right)
        (ua ∘ cartesian-span-diagramᵈ.Left≃Right P)

  opaque
    Type-cocone←span-is-retraction
      : Type-cocone←span ∘ span←Type-cocone ~ id
    Type-cocone←span-is-retraction
      (mk-cocone P-left P-right filler)
      = ap (mk-cocone P-left P-right)
           (funext→ λ _ → ap ua (≃-path→ refl) ∙ ua-coe≃)

  opaque
    span←Type-cocone-is-section
      : span←Type-cocone ∘ Type-cocone←span ~ id
    span←Type-cocone-is-section
      (mk-cartesian-span-diagramᵈ P-left P-right P-centre e-left e-right)
      = ap
        ( λ R
          → mk-cartesian-span-diagramᵈ P-left P-right
              (R .cartesian-spanᵈ.Centre)
              (R .cartesian-spanᵈ.Left≃)
              (R .cartesian-spanᵈ.Right≃))
        ( unap-equiv
          ( Π-swap-cartesian-spanᵈ P-left P-right ._≃_.fwd-is-equiv)
          ( funext→ λ s
            → equiv-J
                ( λ P-left' e-left'
                  → (e-right' : P-centre s ≃ P-right (Span.right S s))
                  → Id
                    ( Σ[ P-centre' ∶ Type 𝓛 ]
                      ( (P-centre' ≃ P-left')
                      × (P-centre' ≃ P-right (Span.right S s))))
                    ( P-left' , id≃ , coe≃ (ua (e-left' e⁻¹ ∙e e-right')))
                    ( P-centre s , e-left' , e-right'))
                ( λ _
                  → Σ-path→ (refl , ×-path→ (refl , coe≃-ua ∙ ≃-path→ refl)))
                (P-left (Span.left S s))
                (e-left s)
                (e-right s)))

  span←Type-cocone-is-equiv
    : is-equiv span←Type-cocone
  span←Type-cocone-is-equiv
    = is-equiv←qinv
        ( Type-cocone←span
        , Type-cocone←span-is-retraction
        , span←Type-cocone-is-section)

  Type-cocone≃span : Cocone S (Type 𝓛) ≃ cartesian-span-diagramᵈ S 𝓛 𝓛 𝓛
  Type-cocone≃span = mk≃ span←Type-cocone span←Type-cocone-is-equiv
}
}

\subtree[fre-0002]{
\title{Descent for pushouts}
\taxon{Theorem}
\author{fredrikbakke}

\p{
Families over pushouts are equivalent to cartesian dependent span diagrams over their
pushout spans.
}

\proof{
\p{
By the universal property of pushouts, a family over a pushout is the same as a
cocone with target #{\UU}, and by the [preceding lemma](fre-0001) cocones into the
universe are cartesian dependent span diagrams over the pushout span.
}
}

\agda{
module _ {𝓤 𝓥 𝓦 𝓛} {S : Span 𝓤 𝓥 𝓦} {X : Type 𝓛} (c : Cocone S X) where

  span←family-up-pushout
    : ∀ {𝓜} → (X → Type 𝓜) → cartesian-span-diagramᵈ S 𝓜 𝓜 𝓜
  span←family-up-pushout = span←Type-cocone ∘ cocone-map S c

module _
  {𝓤 𝓥 𝓦 𝓛} {S : Span 𝓤 𝓥 𝓦} {X : Type 𝓛}
  {c : Cocone S X} (up-c : up-pushout S c)
  where

  descent-up-pushout
    : ∀ {𝓜} → is-equiv (span←family-up-pushout c {𝓜})
  descent-up-pushout
    = is-equiv-∘ span←Type-cocone-is-equiv up-c

  descent-up-pushout≃
    : ∀ {𝓜} → (X → Type 𝓜) ≃ cartesian-span-diagramᵈ S 𝓜 𝓜 𝓜
  descent-up-pushout≃
    = mk≃ (span←family-up-pushout c) (descent-up-pushout)
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓛 𝓜} {S : Span 𝓤 𝓥 𝓦}
  {X : Type 𝓛} {c : Cocone S X} (up-c : up-pushout S c)
  (P : cartesian-span-diagramᵈ S 𝓜 𝓜 𝓜)
  (open cartesian-span-diagramᵈ)
  where

  uniqueness-descent-up-pushout
    : is-singleton (fibre (span←family-up-pushout c) P)
  uniqueness-descent-up-pushout
    = has-singleton-fibres←is-equiv (descent-up-pushout up-c) P

  family-descent-up-pushout : X → Type 𝓜
  family-descent-up-pushout
    = uniqueness-descent-up-pushout .centre .fst

  compute-family-descent-up-pushout
    : span←family-up-pushout c family-descent-up-pushout ＝ P
  compute-family-descent-up-pushout
    = uniqueness-descent-up-pushout .centre .snd

  compute-left-descent-up-pushout
    : (a : Span.Left S)
    → family-descent-up-pushout (Cocone.p c a)
    ≃ P .Left a
  compute-left-descent-up-pushout
    = coe≃
    ∘ happly (ap cartesian-span-diagramᵈ.Left compute-family-descent-up-pushout)

  compute-right-descent-up-pushout
    : (b : Span.Right S)
    → family-descent-up-pushout (Cocone.q c b)
    ≃ P .Right b
  compute-right-descent-up-pushout
    = coe≃
    ∘ happly (ap cartesian-span-diagramᵈ.Right compute-family-descent-up-pushout)

  compute-centre-descent-up-pushout
    : (s : Span.Centre S)
    → family-descent-up-pushout (Cocone.p c (Span.left S s))
    ≃ P .Centre s
  compute-centre-descent-up-pushout
    = coe≃
    ∘ happly (ap cartesian-span-diagramᵈ.Centre compute-family-descent-up-pushout)
}
}
