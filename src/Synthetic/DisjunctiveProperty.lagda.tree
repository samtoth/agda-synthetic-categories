\subtree[stt-011A]{
\title{Disjunctivity at crisp elements}
\taxon{Lemma}
\author{reidbarton}
\author{fredrikbakke}

\p{
Assume that the boundary inclusion of #{Δ¹} is #{♭}-surjective. If
#{i,j :^♭ \II} satisfy #{i\lor j = 1} then either #{i = 1} or #{j = 1}.
}

\proof{
\p{
Let #{j :^♭ \II}. Since #{(i \lor j = 1) \to (i = 1) \lor (j = 1)} is a
proposition, it suffices to check #{i} at #{0} and #{1}. If #{i = 0} then
#{i \lor j = j = 1}, and if #{i = 1} then the left clause holds by definition.
}

\agda{
module _
  (@♭ ∂Δ¹-incl-♭-surjective : is-♭-surjective ∂Δ¹-incl)
  where

  open ♭Δ-Induction ∂Δ¹-incl-♭-surjective

  generating-fam-disjunctive←∨=1-crisp
    : (@♭ ij : Δ¹ × Δ¹) → ∨=1 ij → generating-fam-disjunctive ij
  generating-fam-disjunctive←∨=1-crisp (i , j)
    = ♭Δ¹-ind
        ( λ i
          → (∨=1 (i , j) → generating-fam-disjunctive (i , j))
          , →-is-prop generating-fam-disjunctive-is-prop)
        (λ h → ι₂ (sym (∨-comm ∙ 0-bottom) ∙ h))
        (λ _ → ι₁ refl)
        (i)
}
}

\p{
Consequently, it follows that the [disjunctive inclusion](stt-00DT)
##{\Sigma1{i,j : \II}{((i = 1) \lor (j = 1))} \hookrightarrow \Sigma1{i,j : \II}{(i \lor j = 1)}}
is a #{♭}-equivalence.
}

\agda{
  Λ[2,2]-∨²-incl-♭-section : section (♭-map Λ[2,2]-∨²-incl)
  Λ[2,2]-∨²-incl-♭-section .fst (mod♭ (ij , h))
    = mod♭ (ij , generating-fam-disjunctive←∨=1-crisp ij h)
  Λ[2,2]-∨²-incl-♭-section .snd (mod♭ (ij , h))
    = mapply♭ (mod♭ (Σ-path→ (refl , ∨=1-is-prop _ _)))

  Λ[2,2]-∨²-incl-is-♭-equiv : is-♭-equiv Λ[2,2]-∨²-incl
  Λ[2,2]-∨²-incl-is-♭-equiv
    = is-equiv←section←injective
        (♭-map-is-injective (unap Λ[2,2]-∨²-incl-is-embedding))
        (Λ[2,2]-∨²-incl-♭-section)

  Λ[2,2]-∨²-incl-is-♭-surjective : is-♭-surjective Λ[2,2]-∨²-incl
  Λ[2,2]-∨²-incl-is-♭-surjective
    = is-connected-map←is-equiv (Truncation-gRSubU -1) Λ[2,2]-∨²-incl-is-♭-equiv
}
}

\subtree[stt-0115]{
\title{Disjunctivity propagates from initial objects}
\taxon{Lemma}
\author{reidbarton}
\author{fredrikbakke}

\p{
Assume that the [disjunctive inclusion](stt-00DT)
#{\Sigma1{i,j : \II}{((i = 1) \lor (j = 1))} \hookrightarrow \Sigma1{i,j : \II}{(i \lor j = 1)}}
is #{\flat}-surjective and that the interval is [directed](Synthetic.Directedness).
If #{a : A} is a crisp initial object, then every crisp map
##{f : A \to \Sigma1{i,j:\II}{(i \lor j = 1)}} lifts along the disjunctive inclusion.
}

\proof{
\p{
Write #{f(x) = ((i_x,j_x),p_x)}. To lift #{f}, it suffices to show
#{(i_x = 1) \lor (j_x = 1)} for every #{x : A}. First consider #{x = a}.
Since #{f(a)} is crisp, #{\flat}-surjectivity tells us that there is a
preimage under the disjunctive inclusion. From this we may conclude that
#{(i_a = 1) \lor (j_a = 1)}.
}

\p{
Now, for any #{x : A}, the arrow #{a \to x} gives arrows #{i_a \to i_x} and
#{j_a \to j_x}, so by directedness we have #{i_a \le i_x} and #{j_a \le j_x}. If
#{i_a = 1}, then #{1 \le i_x}, so #{i_x = 1} and the left clause holds. If
#{j_a = 1}, then #{1 \le j_x}, so #{j_x = 1} and the right clause holds.
}
}

\remark{
\author{fredrikbakke}
\p{
In the above argument, it is not essential that there is a singular initial object.
In fact, it would suffice if there were some crisp family #{a} of jointly weakly
initial objects, in the sense that for every object #{x : A}, there merely exists
some crisp object #{a_k} in this family and a finite chain of edges
#{a_k \to u_1 \to \cdots \to u_n \to x}.
}
}

\agda{
module _
  (@♭ Λ[2,2]-∨²-♭-surjective
      : is-♭-surjective Λ[2,2]-∨²-incl)
  (@♭ Δ¹-directed : Δ¹-is-directed)
  where

  generating-fam-disjunctive←Λ[2,2]-∨²-♭-surjective
    : (@♭ p : ∨²) → generating-fam-is-disjunctive p
  generating-fam-disjunctive←Λ[2,2]-∨²-♭-surjective
    = up-♭-surjection←up-♭-connected-map
        (up-connected-map←is-connected-map
          (Truncation-gRSubU -1) _ Λ[2,2]-∨²-♭-surjective)
        (λ p → generating-fam-is-disjunctive p , generating-fam-disjunctive-is-prop)
        (λ p → p .snd)

  generating-fam-disjunctive←∨=1-initial
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
        (@♭ a : A) (@♭ h : (x : A) → Hom A a x)
        (@♭ f : A → ∨²)
      → (x : A) → generating-fam-is-disjunctive (f x)
  generating-fam-disjunctive←∨=1-initial a h f x
    = generating-fam-disjunctive-is-mono
        ( ≤←Hom Δ¹-directed (ap-hom (fst ∘ fst ∘ f) (h x))
        , ≤←Hom Δ¹-directed (ap-hom (snd ∘ fst ∘ f) (h x)))
        (generating-fam-disjunctive←Λ[2,2]-∨²-♭-surjective (f a))
}
}

\subtree[stt-0117]{
\title{Postcomposition with the disjunctive inclusion is a #{♭}-equivalence at types with initial objects}
\taxon{Corollary}
\author{reidbarton}
\author{fredrikbakke}

\agda{
  postcomp-Λ[2,2]-∨²-incl-is-♭-equiv
    : ∀ {@♭ 𝓤} {@♭ X : Type-With-Initial-Obj' 𝓤}
      → is-♭-equiv (postcomp (X .fst) Λ[2,2]-∨²-incl)
  postcomp-Λ[2,2]-∨²-incl-is-♭-equiv {X = (A , a , h , ha)}
    = is-equiv←has-singleton-fibres (λ { (mod♭ f)
      → mk-singl
          ( mod♭ (λ x → f x .fst , generating-fam-disjunctive←∨=1-initial a h f x)
          , mapply♭ (mod♭ (funext→ (λ x → Σ-path→ (refl , ∨=1-is-prop _ _)))))
          (is-prop-map←is-embedding
            (♭-map-is-embedding (postcomp-is-embedding Λ[2,2]-∨²-incl-is-embedding))
            (mod♭ f) _) })
}
}

\subtree[stt-0114]{
\title{The disjunctive property}
\taxon{Theorem}
\author{reidbarton}
\contributor{fredrikbakke}

\p{
Assume the boundary inclusion of #{Δ¹} is #{♭}-surjective, the interval is directed,
and types with initial objects separate. For any #{i, j : \II}, if #{i \lor j = 1}
then either #{i = 1} or #{j = 1}.
}

\proof{
\p{
It suffices to show
##{\iota : \Sigma1{i,j : \II}{((i = 1) \lor (j = 1))} \hookrightarrow \Sigma1{i,j : \II}{(i \lor j = 1)}}
is an equivalence. By the separation axiom, it suffices to check, for crisp
types with initial objects #{A}, that
##{\modflat{A \to \Sigma1{i,j : \II}{((i = 1) \lor (j = 1))}} \hookrightarrow \modflat{A \to \Sigma1{i,j : \II}{(i \lor j = 1)}}}
is an equivalence. Since #{\iota} is an embedding it in turn suffices to show that
every crisp map #{A \to \Sigma1{i,j : \II}{(i \lor j = 1)}} merely lifts along
#{\iota}. Finally, by the assumption that the boundary inclusion of #{\II} is
#{♭}-surjective #{\iota} is also #{♭}-surjective.
Hence, the result follows by [disjunctivity propagating from initial objects](stt-0115).
}
}

\agda{
module _
  (@♭ Λ[2,2]-∨²-incl-♭-surjective : is-♭-surjective Λ[2,2]-∨²-incl)
  (@♭ Δ¹-directed : Δ¹-is-directed)
  (@♭ types-with-initial-object-separate'
    : global-structure-separates initial-obj')
  where

  Λ[2,2]-∨²-incl-is-equiv : is-equiv Λ[2,2]-∨²-incl
  Λ[2,2]-∨²-incl-is-equiv
    = large-family-separates-with-𝟙
        types-with-initial-object-separate'
        {is = (𝟙 , tt , (λ _ → idH tt) , refl)}
        (single!)
        (mk-arrow Λ[2,2]-∨²-incl)
        (λ {i = X}
         → postcomp-Λ[2,2]-∨²-incl-is-♭-equiv
             (Λ[2,2]-∨²-incl-♭-surjective)
             (Δ¹-directed)
             {X = X})

  disjunctive-property' : (i j : Δ¹) → i ∨ j ＝ i1 → (i ＝ i1) * (j ＝ i1)
  disjunctive-property' i j h
    = tr generating-fam-disjunctive
        (ap fst (is-equiv.ε Λ[2,2]-∨²-incl-is-equiv ((i , j) , h)))
        (is-equiv.bwd Λ[2,2]-∨²-incl-is-equiv ((i , j) , h) .snd)

disjunctive-property
  : @♭ is-♭-surjective ∂Δ¹-incl
  → @♭ Δ¹-is-directed
  → @♭ global-structure-separates initial-obj'
  → (i j : Δ¹) → i ∨ j ＝ i1 → (i ＝ i1) * (j ＝ i1)
disjunctive-property ∂Δ¹-incl-♭-surjective
  = disjunctive-property'
      (Λ[2,2]-∨²-incl-is-♭-surjective ∂Δ¹-incl-♭-surjective)
}
}
