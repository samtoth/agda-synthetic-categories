\subtree[bak-8E31]{
\title{Co-strict types}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-10-02}

\p{
Let #{\II} be a [bounded poset](bak-A907) with bottom #{0} and top #{1}.
A type #{X} is \em{co-strict} if it is local at the #{(0 = 1)}-indexed family of maps
#{\emptyset \hookrightarrow \b1}. Co-strict types form a lex #{\Sigma}-closed
[global reflective subuniverse](stt-00IF). We write \code{Typeˢ} for the
universe of co-strict types.
}

\agda{
generator-fam-co-strict : i0 ＝ i1 → Type lzero
generator-fam-co-strict _ = ∅

is-co-strict : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
is-co-strict = is-null generator-fam-co-strict

is-co-strict-is-prop : ∀ {𝓤} (X : Type 𝓤) → is-prop (is-co-strict X)
is-co-strict-is-prop = is-null-is-prop

Typeˢ-SubU : (𝓤 : Level) → SubU 𝓤 (𝓘 ⊔ 𝓤)
Typeˢ-SubU = Null-SubU generator-fam-co-strict

Typeˢ : (𝓤 : Level) → Type (𝓘 ⊔ lsuc 𝓤)
Typeˢ 𝓤 = Subtype.Σ̃ (Typeˢ-SubU 𝓤)

Typeˢ-gSubU : gSubU (_⊔ 𝓘)
Typeˢ-gSubU = Null-gSubU generator-fam-co-strict

Typeˢ-is-globally-reflective : is-globally-reflective Typeˢ-gSubU
Typeˢ-is-globally-reflective = Null-globally-reflective

Typeˢ-gRSubU : gRSubU (_⊔ 𝓘)
Typeˢ-gRSubU .gRSubU.GS = Typeˢ-gSubU
Typeˢ-gRSubU .gRSubU.GS-is-globally-reflective
  = Typeˢ-is-globally-reflective

open gSubU Typeˢ-gSubU public using () renaming
  ( ∈S←equiv to is-co-strict←equiv)
open gReflectiveClosure Typeˢ-gRSubU public using () renaming
  ( Π∈S to Π-is-co-strict
  ; Πᵢ∈S to Πᵢ-is-co-strict
  ; →∈S to →-is-co-strict
  ; ULift∈S to ULift-is-co-strict
  ; 𝟙∈S to 𝟙-is-co-strict
  ; ∈S←is-singleton to is-co-strict←is-singleton
  ; ∈S←retract to is-co-strict←retract
  ; Pullback∈S to Pullback-is-co-strict
  ; ＝∈S to ＝-is-co-strict
  ; ~∈S to ~-is-co-strict
  ; fibre∈S to fibre-is-co-strict
  ; Ext∈S to Ext-is-co-strict
  ; ×∈S to ×-is-co-strict
  ; retract∈S to retract-is-co-strict
  ; biinv∈S to biinv-is-co-strict
  ; ≃∈S to ≃-is-co-strict
  ; Equaliser∈S to Equaliser-is-co-strict
  ; Seq-lim∈S to Seq-lim-is-co-strict
  ; preidempotent-map∈S to preidempotent-map-is-co-strict
  ; qidempotent-map∈S to qidempotent-map-is-co-strict
  ; idempotent-map∈S to idempotent-map-is-co-strict
  ; Retracts∈S to Retracts-is-co-strict)

Σ-is-co-strict : is-globally-Σ-closed Typeˢ-gSubU
Σ-is-co-strict = Null-globally-Σ-closed

module CoStrict where
  open gRSubU Typeˢ-gRSubU public
  open gReflectiveReasoning Typeˢ-gRSubU public
  open gReflectiveClosure Typeˢ-gRSubU public
  open gRSubUInduction Typeˢ-gRSubU Σ-is-co-strict public

  Hom∈S : ∀ {𝓤} {A : Type 𝓤} → A ∈ S → {a b : A} → Hom A a b ∈ S
  Hom∈S A-is-co-strict
    = ∈S←equiv (Homᵈ-repr≃ e⁻¹)
        (Σ-is-co-strict (→∈S A-is-co-strict) (λ _
          → ×∈S (＝∈S A-is-co-strict) (＝∈S A-is-co-strict)))

open CoStrict public using () renaming
  ( Hom∈S to Hom-is-co-strict)
}
}

\subtree[bak-1389]{
\title{Co-strictness as contractibility under #{0 = 1}}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-10-02}

\p{
A type #{X} is [co-strict](bak-8E31) if and only if #{X^{(0 = 1)}} is
[contractible](stt-0006).
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  exp-is-single←is-co-strict
    : is-co-strict X → is-singleton ((i0 ＝ i1) → X)
  exp-is-single←is-co-strict X-is-co-strict
    = Π-is-single (λ p → is-single←equiv⁻¹ (null≃ X-is-co-strict p) ∅-UP-sing)

  is-co-strict←exp-is-single
    : is-singleton ((i0 ＝ i1) → X) → is-co-strict X
  is-co-strict←exp-is-single X-exp-is-single p
    = is-equiv←single-to-prop
        (is-single←retraction const (ev p , ~refl) X-exp-is-single)
        (is-prop←is-single ∅-UP-sing)
        (const: X ∅)

  is-co-strict↔exp-is-single
    : is-co-strict X ↔ is-singleton ((i0 ＝ i1) → X)
  is-co-strict↔exp-is-single
    = (exp-is-single←is-co-strict , is-co-strict←exp-is-single)
}
}

\subtree[bak-6B00]{
\title{The universe of co-strict types is co-strict}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-10-02}

\p{
The universe \code{Typeˢ} of [co-strict types](bak-8E31) is itself co-strict.
}

\agda{
Typeˢ-is-co-strict : (𝓤 : Level) → is-co-strict (Typeˢ 𝓤)
Typeˢ-is-co-strict 𝓤
  = is-co-strict←retract
      ( (λ (X , X-is-co-strict) → (X , tt , X-is-co-strict))
      , (λ (X , _ , X-is-co-strict) → (X , X-is-co-strict))
      , ~refl)
      (Null-U-is-null←is-prop (λ _ ()))
}
}

\subtree[bak-8468]{
\title{The interval is co-strict}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-10-02}

\p{The [bounded poset](bak-A907) #{\II} is [co-strict](bak-8E31).}

\proof{
\p{
The constant function at #{0} is a centre of contraction of #{\II^{(0 = 1)}}.
For any #{f \colon (0 = 1) \to \II} and #{p : 0 = 1}, boundedness gives
#{0 \le f(p) \le 1}, so by antisymmetry #{0 = f(p)}.
}
}

\agda{
Δ¹-is-co-strict : is-co-strict Δ¹
Δ¹-is-co-strict
  = is-co-strict←exp-is-single
      (mk-singl (const i0) (λ f → funext→ (λ p
        → ≤-antisym (0-bottom (f p)) (≤-trans (1-top (f p)) (≥←＝ p)))))
}
}
