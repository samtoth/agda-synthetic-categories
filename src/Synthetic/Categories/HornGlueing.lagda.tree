  (@♭ Δ²-is-coskeletal : ∀ {x y} → is-prop (Hom Δ² x y))
  where

module Δ² = Algebra.Lattice.Instances.Polynomial.Δ²
module I[x] = Lattice (Free-Lattice I I-distr)

open import Axioms.UF
}

