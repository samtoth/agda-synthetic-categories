\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Tetrahedra {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹) where

open Lattice I renaming (0l to i0; 1l to i1)
import Algebra.Lattice.Instances.Polynomial as Poly
open Poly
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
}
}

\subtree[bak-9A63]{
\title{The tetrahedron}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-21}

\p{
The \em{tetrahedron} #{Δ³}, or \em{standard 3-simplex}, consists of triples
#{s \ge t \ge u} in #{Δ¹}.
}

\agda{
record Δ³ : Type 𝓘 where
  constructor mk-tetrahedron
  field
    s t u : Δ¹
    ⦃ t≤s ⦄ : t ≤ s
    ⦃ u≤t ⦄ : u ≤ t

δ₀³ δ₁³ δ₂³ δ₃³ : Δ² I → Δ³
δ₀³ ((s , t) ⦃ p ⦄) = mk-tetrahedron i1 s t ⦃ ≤-top ⦄ ⦃ p ⦄
δ₁³ ((s , t) ⦃ p ⦄) = mk-tetrahedron s s t ⦃ ≤-refl ⦄ ⦃ p ⦄
δ₂³ ((s , t) ⦃ p ⦄) = mk-tetrahedron s t t ⦃ p ⦄ ⦃ ≤-refl ⦄
δ₃³ ((s , t) ⦃ p ⦄) = mk-tetrahedron s t i0 ⦃ p ⦄ ⦃ ≤-bot ⦄

σ₀³ σ₁³ σ₂³ : Δ³ → Δ² I
σ₀³ p = (p .Δ³.t , p .Δ³.u) ⦃ p .Δ³.u≤t ⦄
σ₁³ p = (p .Δ³.s , p .Δ³.u) ⦃ ≤-trans (p .Δ³.u≤t) (p .Δ³.t≤s) ⦄
σ₂³ p = (p .Δ³.s , p .Δ³.t) ⦃ p .Δ³.t≤s ⦄

Δ³-ext
  : {p q : Δ³}
  → p .Δ³.s ＝ q .Δ³.s
  → p .Δ³.t ＝ q .Δ³.t
  → p .Δ³.u ＝ q .Δ³.u
  → p ＝ q
Δ³-ext
  {mk-tetrahedron s t u ⦃ p ⦄ ⦃ q ⦄}
  {mk-tetrahedron .s .t .u ⦃ p' ⦄ ⦃ q' ⦄}
  refl refl refl
  = ap₂
      (λ r r' → mk-tetrahedron s t u ⦃ r ⦄ ⦃ r' ⦄)
      (≤-is-prop p p')
      (≤-is-prop q q')
}
}
