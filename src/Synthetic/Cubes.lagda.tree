\date{2026-01-09}
\title{Synthetic cubes}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}


\agda{
open import Foundations.Universes

module Synthetic.Cubes {𝓘} (I : Type 𝓘) (i0 i1 : I) where
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Axioms.UF

open import Ergonomics.Representation
open import Ergonomics.Extensionality

open import Synthetic.Hom
}
}

\subtree[stt-00CB]{
\title{The type of cubes}
\taxon{Definition}

\p{Given a bipointed type #{I}, we define the type of #{n}-dimensionl cubes
to be the #{n}-fold product of #{I} with itself.}

\agda{
□^_ : ℕ → Type 𝓘
□^ zero = 𝟙ᴸ
□^ suc zero = I
□^ suc (suc n) = □^ (suc n) × I

□-is-truncated : ∀ {n r} → is-truncated r I → is-truncated r (□^ n)
□-is-truncated {zero} t = ULift-is-truncated 𝟙-is-truncated
□-is-truncated {suc zero} t = t
□-is-truncated {suc (suc n)} t = ×-is-truncated (□-is-truncated t) t

instance
  □-Is-truncated
    : ∀ {n r} → ⦃ _ : Is-truncated r I ⦄
      → Is-truncated r (□^ (suc (suc n)))
  □-Is-truncated .Is-truncated.carrier-is-truncated
    = □-is-truncated trunc!

  {-# INCOHERENT □-Is-truncated #-}

□-is-set : ∀ {n} → is-set I → is-set (□^ n)
□-is-set {n} H
  = is-set←is-truncated (□-is-truncated (is-truncated←is-set H))

□-appendl : ∀ {n} → I → □^ n → □^ (suc n)
□-appendl {zero} i sq = i
□-appendl {suc zero} i sq = (i , sq)
□-appendl {suc (suc n)} i (sq , j) = (□-appendl i sq , j)

□-incl-top : ∀ {n} → □^ n → □^ (suc n)
□-incl-top {zero} sq = i0
□-incl-top {suc n} sq = (sq , i0)

□-incl-bot : ∀ {n} → □^ n → □^ (suc n)
□-incl-bot {zero} sq = i1
□-incl-bot {suc n} sq = (sq , i1)

□²-incl-left : □^ 1 → □^ 2
□²-incl-left i = (i0 , i)

□²-incl-right : □^ 1 → □^ 2
□²-incl-right i = (i1 , i)

□-0 : ∀ {n} → □^ n
□-0 {zero} = ttᴸ
□-0 {suc zero} = i0
□-0 {suc (suc n)} = □-0 , i0

□-1 : ∀ {n} → □^ n
□-1 {zero} = ttᴸ
□-1 {suc zero} = i1
□-1 {suc (suc n)} = □-1 , i1
}
}

\subtree[tot-9FA6]{
\title{Finite cubes as finite powers of the interval}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-03}

\p{
The inductively defined finite cube #{\square^n} is equivalent to #{\Fin n \to I}.
}

\agda{
cube←□ : {n : ℕ} → □^ n → Fin n → I
cube←□ {0} _ ()
cube←□ {1} x fzero = x
cube←□ {1} x (fsuc ())
cube←□ {suc (suc n)} (x , i) fzero = i
cube←□ {suc (suc n)} (x , i) (fsuc k) = cube←□ x k

□←cube : {n : ℕ} → (Fin n → I) → □^ n
□←cube {0} _ = ttᴸ
□←cube {1} f = f fzero
□←cube {suc (suc n)} f = □←cube (f ∘ fsuc) , f fzero

□←cube-0 : {n : ℕ} → □←cube (const: I (Fin n) i0) ＝ □-0
□←cube-0 {0} = refl
□←cube-0 {1} = refl
□←cube-0 {suc (suc n)} = ap (_, i0) □←cube-0

□←cube-retr
  : {n : ℕ} (x : □^ n) → □←cube (cube←□ x) ＝ x
□←cube-retr {0} ttᴸ = refl
□←cube-retr {1} x = refl
□←cube-retr {suc (suc n)} (x , i)
  = ap (_, i) (□←cube-retr x)

□←cube-sec
  : {n : ℕ} (f : Fin n → I) → cube←□ (□←cube f) ＝ f
□←cube-sec {0} f = funext→ λ ()
□←cube-sec {1} f = funext→ λ where
  fzero → refl
  (fsuc ())
□←cube-sec {suc (suc n)} f = funext→ λ where
  fzero → refl
  (fsuc k) → happly (□←cube-sec (f ∘ fsuc)) k

cube←□-is-equiv : {n : ℕ} → is-equiv (cube←□ {n})
cube←□-is-equiv = is-equiv←qinv (□←cube , □←cube-retr , □←cube-sec)

□≃cube : (n : ℕ) → □^ n ≃ (Fin n → I)
□≃cube n = mk≃ cube←□ cube←□-is-equiv
}
}
