\title{Miscellaneous properties of Homotopies}
\taxon{Module}
\import{stt-macros}

\agda{
open import Foundations.Funext

module Foundations.HomotopyEquiv {𝓤} (FE : Funextω 𝓤) where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.Homotopy
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences

import Foundations.Reasoning

open WithFunextω FE
}
}

\agda{
-- TODO: Maybe this is bad because we have funext at all the leaves
--       rather than once at the top of some expression
module ∙h {𝓥} {A : Type 𝓥} {B : A → Type 𝓤}
  = Foundations.Reasoning
      (Π A B) _~_ ~refl (λ H K → K ∙h H)
      (funext→ ∘ ∙h-reflr) (λ _ → refl)
      (λ H K J → funext→ (∙h-assoc J K H))

∙h-is-equiv
  : ∀ {𝓥} {A : Type 𝓥} {B : A → Type 𝓤}
      {f g h : Π A B} (H : f ~ g) → is-equiv {A = g ~ h} (H ∙h_)
∙h-is-equiv H = is-equiv←qinv qinv where
  qinv : quasi-inv (H ∙h_)
  qinv .fst = (H h⁻¹) ∙h_
  qinv .snd .fst K = funext→ (λ a → sym'∙ (H a) (K a))
  qinv .snd .snd K = funext→ (λ a → sym∙ (H a) (K a))

∙h≃
  : ∀ {𝓥} {A : Type 𝓥} {B : A → Type 𝓤}
      {f g h : Π A B} (H : f ~ g)
    → (g ~ h) ≃ (f ~ h)
∙h≃ H = mk≃ _ (∙h-is-equiv H)

∙h-is-equiv'
  : ∀ {𝓥} {A : Type 𝓥} {B : A → Type 𝓤}
      {f g h : Π A B} (H : g ~ h) → is-equiv {A = f ~ g} (_∙h H)
∙h-is-equiv' H = is-equiv←qinv qinv where
  qinv : quasi-inv (_∙h H)
  qinv .fst = _∙h (H h⁻¹)
  qinv .snd .fst K = ∙h.cancell (funext→ (∙h-sym H))
  qinv .snd .snd K = ∙h.cancell (funext→ (∙h-sym' H))

~reflr≃ : ∀ {𝓥} {A : Type 𝓥} {B : A → Type 𝓤}
                    {f g h : Π A B} (H K : g ~ h) → (H ~ K) ≃ (H ~ (K ∙h ~refl))
~reflr≃ H K = mk≃ (_∙h (_h⁻¹ (∙h-reflr K))) (∙h-is-equiv' _)
}
