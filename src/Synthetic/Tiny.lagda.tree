\date{2026-03-14}
\title{Synthetic Tiny objects}
\author{samueltoth}
\taxon{Module}
\import{stt-macros}



\agda{
module Synthetic.Tiny where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.Connectivity
open import Modalities.Cohesion.Continuity
open import Modalities.Instances.Truncation

open import Ergonomics.Extensionality

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.PiSection
open import Core.GlobalClassesMaps
open import Core.UniversalFibrations
open import Core.Small
open import Core.Postwhisker
}
}


\subtree[stt-00KC]{
\title{Idea}


\p{Let #{I} be some object in a cartesian-closed set-category #{C}, then we
say #{I} is \em{tiny} or \em{atomic} if there is a further right adjoint to
exponentiation #{({-})^I}. In \citek{LOPS18}, it was demonstrated that this
right adjoint can be internalised and used to construct universes. The recent
work by [Gratzer](danielgratzer), [Weinberger](jonathanweinberger) and
[Buchholtz](ulrikbuchholtz) use the same idea to construct universes of spaces
\citek{GWB24} and of categories \citek{GWB26}. Internalising tiny types is made
difficult by the fact that we may prove a no-go theorem that states that, internally,
if #{({-})^I} has a right adjoint, then this right adjoint must be the identity, and
hence #{I} must be contractible. This bad situation may be fixed by using the
#{\flat} modality, which in our intended model is modelled by the global sections
functor.}
}


\subtree[stt-00JY]{
\title{Tiny types}
\taxon{Definition}

\p{
We say that a type #{I} is \em{tiny} if for each crisp type #{A}, there exists:
\ul{
  \li{A crisp type #{A_I}}
  \li{A crisp map #{\epsilon \colon (A_I)^I \to A}}
}
Subject to the condition that for any crisp type #{X}, the induced map
#{\modflat{X \to A_I} \to \modflat{X^I \to A}} is an equivalence.
}

\agda{
is-tiny-structure
  : ∀ {@♭ 𝓤 𝓥 𝓦} (@♭ I : Type 𝓤) (@♭ A : Type 𝓥)
      (@♭ √A : Type 𝓦) (@♭ ε√ : (I → √A) → A) → Typeω
is-tiny-structure I A √A ε√
  = ∀ {@♭ 𝓤} {@♭ X : Type 𝓤}
    → is-equiv {A = ⟨♭| (X → √A) ⟩} {B = ⟨♭| ((I → X) → A) ⟩}
               (♭-map (postcomp _ ε√ ∘ postcomp I))
}
}

\subtree[stt-00NS]{
\title{Tiny types are closed under cartesian products}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-04-24}

\agda{
module _
  {@♭ 𝓘 𝓙 𝓤 𝓥 𝓦} {@♭ I : Type 𝓘} {@♭ J : Type 𝓙}
  {@♭ A : Type 𝓤}
  {@♭ ᴵ√A : Type 𝓥}
  {@♭ ᴶ√ᴵ√A : Type 𝓦}
  (@♭ ᴵε√A : (I → ᴵ√A) → A)
  (@♭ ᴶε√ᴵ√A : (J → ᴶ√ᴵ√A) → ᴵ√A)
  where

  ×√ : Type 𝓦
  ×√ = ᴶ√ᴵ√A

  ×ε√ : (I × J → ×√) → A
  ×ε√ f = ᴵε√A (λ i → ᴶε√ᴵ√A (λ j → f (i , j)))

  is-×-tiny-structure
    : is-tiny-structure I A ᴵ√A ᴵε√A
    → is-tiny-structure J ᴵ√A ᴶ√ᴵ√A ᴶε√ᴵ√A
    → is-tiny-structure (I × J) A ×√ ×ε√
  is-×-tiny-structure i j {X = X}
    = is-equiv←~
        (λ where (mod♭ f) → refl)
        ((mk≃ _ j ∙e mk≃ _ i ∙e ♭≃ (precomp-≃ curry≃)) ._≃_.fwd-is-equiv)
}
}

\subtree[stt-00KP]{
\title{The tiny adjunction}

\p{We expose an interfaces into the basic properties of tiny types.}

\agda{
module Tiny
  {@♭ 𝓘} (@♭ I : Type 𝓘)
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ ε√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (I → √ A) → A)
  (@♭ √-is-tiny-str : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure I A (√ A) ε√)
  where
  module is-tiny {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ X : Type 𝓥}
    = is-equiv (√-is-tiny-str {𝓤} {A} {𝓥} {X})

  transpose
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
      → ⟨♭| ((I → Γ) → A)⟩ → ⟨♭| (Γ → √ A) ⟩
  transpose = is-equiv.bwd √-is-tiny-str

  untranspose
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
      → (Γ → √ A) → ((I → Γ) → A)
  untranspose f = ε√ ∘ postcomp I f

  √-tiny≃
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
      → ⟨♭| (Γ → √ A) ⟩ ≃ ⟨♭| ((I → Γ) → A) ⟩
  √-tiny≃ = mk≃ (♭-map untranspose) √-is-tiny-str

  exp⊣√
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      → ⟨♭| ((I → A) → B) ⟩ ≃ ⟨♭| (A → √ B) ⟩
  exp⊣√ = √-tiny≃ e⁻¹

  transpose-unique'
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
        {f : ⟨♭| ((I → Γ) → A)⟩} {g : ⟨♭| (Γ → √ A) ⟩}
      → ♭-map untranspose g ＝ f
      → g ＝ transpose f
  transpose-unique' {f = f} H = unap-equiv √-is-tiny-str (H ∙ is-tiny.ε⁻¹ f)

  transpose-unique'-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
        {f : ⟨♭| ((I → Γ) → A)⟩} {g : ⟨♭| (Γ → √ A) ⟩}
      → is-equiv (transpose-unique' {f = f} {g})
  transpose-unique'-is-equiv {f = f} {g}
    = is-equiv-∘
        (unap-equiv-is-equiv √-is-tiny-str)
        (∙-is-equiv' (is-tiny.ε⁻¹ f))

  transpose-unique
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
        {@♭ f : ((I → Γ) → A)} {@♭ g : Γ → √ A}
      → ⟨♭| (untranspose g) ＝ f ⟩
      → ⟨♭| g ＝ ε♭ (transpose (mod♭ f)) ⟩
  transpose-unique {g = g}
    = ♭-map (ap ε♭ ∘ transpose-unique' {g = mod♭ g}) ∘ ap♭' mod♭

  transpose-unique-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
        {@♭ f : ((I → Γ) → A)} {@♭ g : Γ → √ A}
      → is-equiv (transpose-unique {f = f} {g})
  transpose-unique-is-equiv {Γ = Γ} {A} {f} {g}
    = src-is-equiv←Arrow-equiv
        (test , test-is-equiv)
        (is-♭-equiv←is-equiv transpose-unique'-is-equiv)
    where
    lemma
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ x : A} {@♭ y : ⟨♭| A ⟩}
        → mod♭ (ε♭ y) ＝ y
    lemma {y = mod♭ y} = refl

    lemma⁻¹
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ x : A} {@♭ y}
        → ⟨♭| x ＝ ε♭ y ⟩ → ⟨♭| (mod♭ x ＝ y) ⟩
    lemma⁻¹ {x = x} {y} = ♭-map ((_∙ lemma {x = x}) ∘ mapply♭) ∘ comult

    lemma⁻¹-refl
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ x} {@♭ y : ⟨♭| A ⟩}
        → (@♭ p : mod♭ x ＝ y)
        → lemma⁻¹ {y = y} (mod♭ (ap ε♭ p)) ＝ mod♭ p
    lemma⁻¹-refl {y = mod♭ y}
      = strong-J♭ (λ _ p → lemma⁻¹ (mod♭ (ap ε♭ p)) ＝ mod♭ p) refl

    map
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
        → ⟨♭| a ＝ b ⟩ → ⟨♭| mod♭ a ＝ mod♭ b ⟩
    map (mod♭ p) = mod♭ (ap♭ mod♭ p)

    map-is-equiv
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
        → is-equiv (map {a = a} {b})
    map-is-equiv
      = is-equiv←~
          {f = ♭-map mapply♭ ∘ comult}
          (♭-ind
            (strong-J♭
              (λ b p → mod♭ (ap♭ mod♭ p) ＝ (♭-map mapply♭ ∘ comult) (mod♭ p))
              refl))
          (is-equiv-∘
            (is-♭-equiv←is-equiv mapply♭-is-equiv)
            comult-is-equiv)

    test : Arrow-map (transpose-unique {Γ = Γ} {A} {f} {g})
                     (♭-map (transpose-unique' {Γ = Γ} {A} {mod♭ f} {mod♭ g}))
    test .Arrow-Π.top = map
    test .Arrow-Π.bot = lemma⁻¹
    test .Arrow-Π.comm (mod♭ p) = lemma⁻¹-refl _


    test-is-equiv : is-Arrow-equiv test
    test-is-equiv .fst = map-is-equiv
    test-is-equiv .snd = is-equiv-∘
      (is-♭-equiv←is-equiv (is-equiv-∘ (∙-is-equiv' lemma) mapply♭-is-equiv))
      comult-is-equiv

  transpose-context-naturality
    : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓦} {@♭ A : Type 𝓥}
      → (@♭ σ : Δ → Γ)
      → transpose ∘ ♭-map (precomp A (postcomp I σ))
      ~ ♭-map (precomp (√ A) σ) ∘ transpose
  transpose-context-naturality σ (mod♭ P) = sym (transpose-unique'
    ( (♭-map untranspose ∘ ♭-map (precomp (√ _) σ)) (transpose (mod♭ P))
    ＝⟨ sym (♭-∘ untranspose (precomp _ σ) _) ⟩
       ♭-map (untranspose ∘ precomp _ σ) (transpose (mod♭ P))
    ＝⟨⟩
       ♭-map (precomp _  (postcomp _ σ) ∘ untranspose) (transpose (mod♭ P))
    ＝⟨ ♭-∘ _ untranspose (transpose (mod♭ P)) ⟩
       ♭-map (precomp _  (postcomp _ σ)) (♭-map untranspose (transpose (mod♭ P)))
    ＝⟨ ap (♭-map _) (is-tiny.ε (mod♭ P)) ⟩
      ♭-map (precomp _ (postcomp I σ)) (mod♭ P) ∎))

  untranspose-context-naturality
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'} {@♭ A : Type 𝓥}
      → (σ : Δ → Γ)
      → (f : Γ → √ A)
      → untranspose (f ∘ σ) ＝ untranspose f ∘ postcomp _ σ
  untranspose-context-naturality σ f = refl
}
}

\subtree[stt-012C]{
\title{Tiny objects are nonempty}
\taxon{Proposition}
\author{fredrikbakke}
\author{samueltoth}
\date{2026-09-21}

\p{Every [tiny](stt-00JY) type #{I} satisfies #{\neg\neg I}.}

\proof{
\p{
Assume for the sake of reaching a contradiction that #{\neg I}. By the amazing
right adjoint it suffices to prove #{I \to \sqrt{\emptyset}}, so to prove
#{\sqrt{\emptyset}} we may assume both #{I} and #{\neg I}, which is a contradicion.
}
}

\agda{
  tiny-is-nonempty : ¬¬ I
  tiny-is-nonempty ¬I = ε√ (¡ ∘ ¬I)
}
}

\subtree[stt-00KR]{
\title{Functoriality of the amazing right adjoint}
\taxon{Lemma}

\agda{
  √₁ : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} → ⟨♭| (A → B) ⟩ → ⟨♭| (√ A → √ B)⟩
  √₁ {B = B} = transpose ∘ ♭-map (precomp B ε√)

  √₁-id : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → √₁ (mod♭ id) ＝ mod♭ (id: √ A)
  √₁-id = sym (transpose-unique' refl)

  untranspose-naturality
    : ∀ {@♭ 𝓤 𝓥 𝓥'} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ B : Type 𝓥'}
      → (f : ⟨♭| (B → A)⟩)
      → untranspose {Γ = Γ} {A} ∘ postcomp _ (ε♭ (√₁ f))
      ＝ postcomp _ (ε♭ f) ∘ untranspose
  untranspose-naturality {Γ = Γ} {A} (mod♭ f)
    = ap ((_∘ postcomp I) ∘ postcomp (I → Γ))
       ( sym (ε♭-natural (transpose (mod♭ (f ∘ ε√))))
       ∙ ap ε♭ (is-tiny.ε (mod♭ (f ∘ ε√))))

  opaque
    √₁-∘
      : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
          (@♭ f : B → C) (@♭ g : A → B)
        → ε♭ (√₁ (mod♭ f)) ∘ ε♭ (√₁ (mod♭ g)) ~ ε♭ (√₁ (mod♭ (f ∘ g)))
    √₁-∘ {A = A} {B} {C} f g = happly (ε♭ (transpose-unique (mod♭
      ( untranspose (ε♭ (√₁ (mod♭ f)) ∘ ε♭ (√₁ (mod♭ g)))
      ＝⟨⟩
        untranspose (postcomp _ (ε♭ (√₁ (mod♭ f))) (ε♭ (√₁ (mod♭ g))))
      ＝⟨⟩
        (untranspose ∘ postcomp _ (ε♭ (√₁ (mod♭ f)))) (ε♭ (√₁ (mod♭ g)))
      ＝⟨ happly (untranspose-naturality (mod♭ f)) (ε♭ (√₁ (mod♭ g))) ⟩
        postcomp _ f (untranspose (ε♭ (√₁ (mod♭ g))))
      ＝⟨⟩
        postcomp _ f (untranspose (ε♭ (transpose (♭-map (precomp _ ε√) (mod♭ g)))))
      ＝⟨ ap (postcomp _ f) (sym (ε♭-natural (transpose (♭-map (precomp _ ε√) (mod♭ g))))) ⟩
        postcomp _ f (ε♭ (♭-map untranspose (transpose (♭-map (precomp _ ε√) (mod♭ g)))))
      ＝⟨ ap (postcomp _ f ∘ ε♭) (is-tiny.ε (♭-map (precomp _ ε√) (mod♭ g))) ⟩
        postcomp _ f (precomp _ ε√ g)
      ＝⟨⟩
        f ∘ g ∘ ε√
      ∎))))
}
}


\subtree[stt-00KI]{
\title{Naturality of the counit}
\taxon{Lemma}

\p{The counit map is a natural transformation.}

\agda{
  opaque
    ε√-nat
      : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
          (@♭ f : Γ → A)
        → ε√ ∘ postcomp I (ε♭ (√₁ (mod♭ f)))
        ~ f ∘ ε√
    ε√-nat f
      = ε√ ∘ postcomp I (ε♭ (√₁ (mod♭ f)))
      ~⟨⟩
        untranspose (ε♭ (√₁ (mod♭ f)))
      ~⟨ happly (sym (ε♭-natural (√₁ (mod♭ f)))) ⟩
        ε♭ (♭-map untranspose (√₁ (mod♭ f)))
      ~⟨ happly (ap ε♭ (is-tiny.ε (mod♭ (f ∘ ε√)))) ⟩
        f ∘ ε√
      ~∎

  ε√-naturality-square
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥}
        (@♭ f : Γ → A)
      → Arrow-map (postcomp I (ε♭ (√₁ (mod♭ f)))) f
  ε√-naturality-square f .Arrow-Π.top = ε√
  ε√-naturality-square f .Arrow-Π.bot = ε√
  ε√-naturality-square f .Arrow-Π.comm = ε√-nat f
}
}

\subtree[stt-00JZ]{
\title{The amazing right adjoint preserves singletons}
\taxon{Lemma}

\agda{
  √𝟙-is-single : is-singleton (√ 𝟙)
  √𝟙-is-single = is-single←equiv⁻¹
    (mk≃ _ (types-separate (ε√ ∘ const) lemma))
    𝟙-is-singleton where
    lemma : ∀ {@♭ 𝓦} {@♭ X : Type 𝓦} → is-♭-equiv (postcomp X _)
    lemma
      = is-equiv-~∘
          {f = ♭-map (λ _ _ → tt)}
          (λ a → is-prop←is-single (♭-is-single single!) _ _)
            (is-♭-equiv←is-equiv (is-equiv←single-to-prop single! (λ _ _ → prop!) _))
            (√-is-tiny-str)

  instance
    √𝟙-Is-truncated : ∀ {n} → Is-truncated n (√ 𝟙)
    √𝟙-Is-truncated
      .Is-truncated.carrier-is-truncated = is-truncated←is-single √𝟙-is-single

  √-is-single
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
      → @♭ is-singleton A → is-singleton (√ A)
  √-is-single {A = A} as
    = is-single←equiv⁻¹
        (mk≃ _ (types-separate (ε√ ∘ const) lemma))
        as
    where
    instance
      @♭ A-Is-truncated : ∀ {n} → Is-truncated n A
      A-Is-truncated .Is-truncated.carrier-is-truncated
        = is-truncated←is-single as

    lemma
      : ∀ {@♭ 𝓦} {@♭ X : Type 𝓦}
        → is-♭-equiv (postcomp X (ε√ ∘ const))
    lemma
      = is-equiv-~∘
          {f = ♭-map (λ _ _ → as .centre)}
          (λ a → is-prop←is-single (♭-is-single single!) _ _)
          (is-♭-equiv←is-equiv (is-equiv←single-to-prop single! (λ _ _ → prop!) _))
          (√-is-tiny-str)

  module _
    (@♭ prop-is-disc : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → @♭ is-prop A → is-♭-discrete A)
    where

    √-is-single'
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
        → is-singleton A → is-singleton (√ A)
    √-is-single' {A = A} as
      = ♭-rec (λ as' → √-is-single as')
              (is-equiv.bwd (prop-is-disc is-single-is-prop) as)

    √-is-prop : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → @♭ is-prop A → is-prop (√ A)
    √-is-prop x = is-prop←is-single-if-inhabited
      (ε√ ∘ const
      ∘ ε♭ (transpose (mod♭ λ a → √-is-single' (mk-singl (ε√ a) (x _)))))
}
}

\subtree[stt-014Z]{
\title{The amazing right adjoint preserves products}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-18}

\p{For any pair of crisp types #{A} and #{B}, there is a canonical map from
#{(A \times B)_I \to A_I \times B_I} given by #{({\pi_1}_I, {\pi_2}_I)}, this map
is an equivalence and witnesses #{(A \times B)_I} as the product of #{A_I} with
#{B_I}.}

\proof{
\p{Since [types separate](stt-00NM), it suffices to show that for every crisp type
#{Γ}, the induced map #{\modflat{{(A \times B)_I}^Γ} \to \modflat{{A_I \times B_I}^Γ}}
is an equivalence. But this is equivalent as an arrow to
#{\modflat{{A \times B}^{Γ^I}} \to \modflat{A^{Γ^I} \times B^{Γ^I}}}, which is an
equivalence since the canonical product #{{-} \times {-}} satisfies the universal
property of products.}
}

\agda{
  √-×-cone
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      → √ (A × B) → √ A × √ B
  √-×-cone f .fst = ε♭ (√₁ (mod♭ fst)) f
  √-×-cone f .snd = ε♭ (√₁ (mod♭ snd)) f

  ×₁-tiny-str
    : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ B : Type 𝓦}
      → is-equiv
          {A = ⟨♭| (Γ → √ A) × (Γ → √ B) ⟩}
          (♭-map (untranspose ×₁ untranspose))
  ×₁-tiny-str
    = src-is-equiv←Arrow-equiv
        (mk-arr-equiv ♭-pres-× ♭-pres-× (♭-ind (λ _ → refl)))
        (×₁-is-equiv √-is-tiny-str √-is-tiny-str)

  ×₁-tiny≃
    : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ B : Type 𝓦}
      → ⟨♭| (Γ → √ A) × (Γ → √ B) ⟩ ≃ ⟨♭| ((I → Γ) → A) × ((I → Γ) → B) ⟩
  ×₁-tiny≃ = mk≃ (♭-map (untranspose ×₁ untranspose)) ×₁-tiny-str

  √-×-is-product
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      → is-equiv (√-×-cone {A = A}{B})
  √-×-is-product {A = A} {B} = types-separate √-×-cone
    (src-is-equiv←Arrow-equiv
      (mk-arr-equiv √-tiny≃ (♭≃ (×-→-swap≃ _ _) ∙e ×₁-tiny≃)
        (♭-ind
          (λ x' → mapply♭ (mod♭
            (×-path→
              ( happly (untranspose-naturality (mod♭ fst)) x'
              , happly (untranspose-naturality (mod♭ snd)) x'))))))
      (is-♭-equiv←is-equiv (×-→-swap≃ A B ._≃_.fwd-is-equiv)))
}
}

\subtree[stt-00KK]{
\title{Paths in amazing right adjoints}
\taxon{Lemma}

\p{Given a tiny type #{I} and #{x y \colon-flat \Gamma \to A_I}, the map
#{x \sim y \to \bar{x} \sim \bar{y}} is a flat equivalence, where #{\bar{x}} is the
transposition of #{x} across the amazing right adjoint.}


\agda{
  opaque
    √-path≃
      : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ X : Type 𝓥}
          (@♭ X Y : Γ → √ X)
        → ⟨♭| (X ＝ Y) ⟩
        ≃ ⟨♭| untranspose X ＝ untranspose Y ⟩
    √-path≃ X Y
      = ⟨♭| X ＝ Y ⟩
      ≃⟨ mapply♭≃ ⟩
        mod♭ X ＝ mod♭ Y
      ≃⟨ mk≃ (ap (♭-map untranspose)) (is-embedding←is-equiv √-is-tiny-str) ⟩
        ♭-map (untranspose) (mod♭ X) ＝ ♭-map untranspose (mod♭ Y)
      ≃⟨⟩
        mod♭ (untranspose X) ＝ mod♭ (untranspose Y)
      ≃⟨ mapply♭≃ e⁻¹ ⟩
        ⟨♭| untranspose X ＝ untranspose Y ⟩
      ≃∎

    untranspose-is-♭-embedding
      : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ x y : Γ → √ A}
        → is-♭-equiv (ap (untranspose {Γ = Γ} {A}) {x} {y})
    untranspose-is-♭-embedding {x = x} {y}
      = is-equiv←~
          (♭-ind
            (strong-J♭
              (λ x p → mod♭ (ap untranspose p) ＝ modext♭ (ap (♭-map untranspose) (mapply♭ (mod♭ p))))
              refl))
          (_≃_.fwd-is-equiv (√-path≃ x y))
}
}
