\subtree[fre-2D35]{
\title{Loop spaces of pointed types}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given a type #{A} and a point #{a : A}, we may form the \em{type of loops} at #{a},
or \em{loop space} #{\Omega(A,a)}, consisting of
[identifications](Foundations.Identity) #{a = a}. Loop spaces are canonically
[pointed](Foundations.Pointed) at the trivial identification #{\refl}, and so the
construction may be iterated. We write #{\Omega^n(A,a)} for the #{n}-fold iterate.
}

\agda{
Ω∗ : ∀ {𝓤} → Type∗ 𝓤 → Type∗ 𝓤
Ω∗ A = mk-type∗ (Type∗.pt A ＝ Type∗.pt A) refl

Ω∗^ : ∀ {𝓤} → ℕ → Type∗ 𝓤 → Type∗ 𝓤
Ω∗^ = iterate Ω∗

Ω^ : ∀ {𝓤} → ℕ → (A : Type 𝓤) → A → Type 𝓤
Ω^ n A a = Type∗.carrier (Ω∗^ n (mk-type∗ A a))

Ω : ∀ {𝓤} (A : Type 𝓤) → A → Type 𝓤
Ω = Ω^ 1

Ω∗² : ∀ {𝓤} → Type∗ 𝓤 → Type∗ 𝓤
Ω∗² = Ω∗^ 2

Ω² : ∀ {𝓤} (A : Type 𝓤) → A → Type 𝓤
Ω² = Ω^ 2

Ω∗³ : ∀ {𝓤} → Type∗ 𝓤 → Type∗ 𝓤
Ω∗³ = Ω∗^ 3

Ω³ : ∀ {𝓤} (A : Type 𝓤) → A → Type 𝓤
Ω³ = Ω^ 3
}
}

\subtree[fre-7589]{
\title{Horizontal concatenation of double loops}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
module _ {𝓤} {A : Type 𝓤} {a : A} where

  _◾Ω²_ : Ω² A a → Ω² A a → Ω² A a
  _◾Ω²_ = _◾_

  ◾Ω²-left-unit : (p : Ω² A a) → refl ◾Ω² p ＝ p
  ◾Ω²-left-unit = ◾-left-unit

  ◾Ω²-right-unit : (p : Ω² A a) → p ◾Ω² refl ＝ p
  ◾Ω²-right-unit = ◾-right-unit'

  ◾Ω²-∙-interchange
    : (p q r s : Ω² A a)
    → (p ◾Ω² q) ∙ (r ◾Ω² s) ＝ (p ∙ r) ◾Ω² (q ∙ s)
  ◾Ω²-∙-interchange = ◾-∙-interchange
}
}
