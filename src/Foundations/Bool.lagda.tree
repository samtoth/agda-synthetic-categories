\title{Booleans}
\taxon{Module}
\author{samueltoth}
\date{2025-10-22}
\import{stt-macros}

\agda{
module Foundations.Bool where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Empty
open import Foundations.Unit
}
}

\agda{
data Bool : Type where
  true false : Bool

{-# BUILTIN BOOL Bool #-}
{-# BUILTIN TRUE true #-}
{-# BUILTIN FALSE false #-}

_&_ : Bool → Bool → Bool
true  & true  = true
true  & false = false
false & b     = false

_||_ : Bool → Bool → Bool
true  || _     = true
false || true  = true
false || false = false

Bool-is-set : ∀ (x y : Bool) (p q : x ＝ y) → p ＝ q
Bool-is-set true true refl refl = refl
Bool-is-set true false ()
Bool-is-set false true ()
Bool-is-set false false refl refl = refl

if_then_else_ : ∀ {𝓤} {A : Type 𝓤} → Bool → A → A → A
if true then a else b = a
if false then a else b = b

true≠false : true ≠ false
true≠false ()

is-true : Bool → Type
is-true b = if b then 𝟙 else ∅

eq-true←is-true : {b : Bool} → is-true b → b ＝ true
eq-true←is-true {true} _ = refl
eq-true←is-true {false} ()

is-true←eq-true : {b : Bool} → b ＝ true → is-true b
is-true←eq-true refl = tt
}

\subtree[bak-D102]{
\title{The standard ordering on the booleans}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-10-18}

\agda{
infix 6 _≤ᴮ₂_ _≤₂_
_≤ᴮ₂_ : Bool → Bool → Bool
true ≤ᴮ₂ true = true
true ≤ᴮ₂ false = false
false ≤ᴮ₂ b = true

_≤₂_ : Bool → Bool → Type
a ≤₂ b = is-true (a ≤ᴮ₂ b)

≤₂-refl : (a : Bool) → a ≤₂ a
≤₂-refl false = tt
≤₂-refl true = tt
}
}
