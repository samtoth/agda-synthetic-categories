\title{A model for the homotopy theory of homotopy theory}
\author{charlesrezk}
\taxon{Reference}
\meta{venue}{[[tams]] 353(3)}
\meta{doi}{10.1090/S0002-9947-00-02653-2}
\meta{arxiv}{math/9811037}

\subtree{
\taxon{Abstract}
\p{
We describe a category, the objects of which may be viewed as models for homotopy
theories. We show that for such models, "functors between two homotopy theories form
a homotopy theory", or more precisely that the category of such models has a
well-behaved internal hom-object.
}
}

