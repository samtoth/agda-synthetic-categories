open import Modalities.Cohesion.FlatConnectedMaps

open import Modalities.Instances.Truncation
}

\agda{
module Synthetic.Categories.Spaces
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹) (@♭ I-distr : is-distributive I)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (open Synthetic.Directedness Δ¹ I)
  (open Synthetic.Cubes Δ¹ i0 i1)
  (@♭ Δ¹-directed : Δ¹-is-directed)
  (open Synthetic.Categories.Initial Δ¹ I)
  (open Synthetic.Categories.Precategories Δ¹ I)
  (open Synthetic.Hom Δ¹ i0 i1)
  (open Synthetic.Triangles Δ¹ I)
  (open Synthetic.Boundaries Δ¹ I)
  (let @♭ Δ² = Algebra.Lattice.Instances.Polynomial.Δ² I)
  (let module Δ² = Algebra.Lattice.Instances.Polynomial.Δ²)
  (let module I[x] = Lattice (Free-Lattice I I-distr))

  (@♭ 0≠1 : i0 ≠ i1)
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ √ε : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (Δ¹ → √ A) → A)
  (@♭ √-is-tiny-str
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure Δ¹ A (√ A) √ε)
  (@♭ types-with-initial-object-separate'
    : large-family-separates (λ 𝓤 → Type-With-Initial-Obj' 𝓤) fst)
  (@♭ ∂Δ¹-is-♭-connected : is-♭-connected (Truncation-gRSubU -1𝕋) ∂Δ¹-incl)
  -- The following two assumptions follow from quasicoherence, but this fact is not
  -- yet formalised
  (@♭ Δ¹-is-segal : is-segal Δ¹)
  (@♭ Δ²-is-coskeletal-acyclic : ∀ {i j : Δ²} → is-prop (Hom Δ² i j))
  where

open import Axioms.UF
}

\remark{
We formalise the construction of the category of spaces under the axiom that types
with initial objects separate rather than assuming the stronger axiom that the
finite-dimensional cubes separate, following
[Gratzer](danielgratzer)–[Weinberger](jonathanweinberger)–[Buchholtz](ulrikbuchholtz)
\citek{GWB24}. The same proof applies under both assumptions.
}

