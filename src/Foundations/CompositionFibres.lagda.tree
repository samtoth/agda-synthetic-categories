\subtree[stt-004P]{
\title{Fibres of the postcomposition map}
\taxon{Theorem}

\agda{
module _
  {𝓤 𝓥 𝓦}
  {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
  (f : A → B) (h : C → B)
  where

  fibre-postcomp≃
    : fibre (postcomp C f) h ≃ Π C (fibre f ∘ h)
  fibre-postcomp≃
    = Σ-snd-≃ (λ _ → funext≃) ∙e Σ-Π-swap≃ (λ _ → A) (λ c a → f a ＝ h c) e⁻¹
}
}

\subtree[stt-00MT]{
\date{2026-03-19}
\author{fredrikbakke}
\taxon{Theorem}
\title{Characterisation of fibres of dependent postcomposition}

\agda{
module _
  {𝓤 𝓥 𝓦 : Level}
  {C : Type 𝓤}
  {A : C → Type 𝓥}
  {B : C → Type 𝓦}
  (f : (c : C) → A c → B c)
  (h : Π C B)
  where

  fibre-postcomp-Π≃
    : fibre (postcomp-Π f) h ≃ Π C (λ c → fibre (f c) (h c))
  fibre-postcomp-Π≃
    = Σ-snd-≃ (λ _ → funext≃) ∙e Σ-Π-swap≃ A (λ c a → f c a ＝ h c) e⁻¹
}
}

\subtree[stt-00MU]{
\date{2026-03-19}
\author{fredrikbakke}
\taxon{Theorem}
\title{Dependent functions as sections over fibres}

\p{
Given a family #{U} over #{B} and a map #{f : A \to B}, dependent functions
#{(a : A) \to U(f(a))} are equivalently families of functions out of each fibre
#{\fibre{f}{b}}.
}

\agda{
module _
  {𝓤 𝓥 𝓦 : Level}
  {A : Type 𝓤} {B : Type 𝓥}
  (U : B → Type 𝓦)
  (f : A → B)
  where

  precomp-Π-over-fibres
    : Π A (U ∘ f) → Π B (λ b → fibre f b → U b)
  precomp-Π-over-fibres h b (a , p) = tr U p (h a)

  precomp-Π-over-fibres-is-equiv
    : is-equiv precomp-Π-over-fibres
  precomp-Π-over-fibres-is-equiv
    = is-equiv←qinv (bwd , ~refl , ε) where
    bwd : Π B (λ b → fibre f b → U b) → Π A (U ∘ f)
    bwd h a = h (f a) (a , refl)

    ε : precomp-Π-over-fibres ∘ bwd ~ id
    ε h = funext→ (λ _ → funext→ (λ where (a , refl) → refl))

  precomp-Π-over-fibres≃
    : Π A (U ∘ f) ≃ Π B (λ b → fibre f b → U b)
  precomp-Π-over-fibres≃
    = mk≃ precomp-Π-over-fibres precomp-Π-over-fibres-is-equiv
}
}

\subtree[stt-00JL]{
\title{Fibres of the composition of maps}
\taxon{Lemma}

\agda{
fibre-∘
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : B → C} {g : A → B}
    → ∀ a → fibre (f ∘ g) a ≃ Σ[ x ∶ fibre f a ] fibre g (fst x)
fibre-∘ {f = f} {g = g} c = equiv←qequiv qeqv where
  qeqv : fibre (f ∘ g) c ≊ Σ (fibre f c) (λ x → fibre g (fst x))
  qeqv ._≊_.fwd (x , p) = ((g x , p) , (x , refl))
  qeqv ._≊_.fwd-qinv .fst ((x , p) , (y , refl)) = (y , p)
  qeqv ._≊_.fwd-qinv .snd .fst (a , refl) = refl
  qeqv ._≊_.fwd-qinv .snd .snd ((x , p) , (y , refl)) = refl
}

\p{The following lemma is exercise 4.4 of \citek{HoTT}.}

\agda{
unstable-octahedron-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      (f : B → C) (g : A → B)
    → ∀ b → fibre (f ∘ g) (f b) → fibre f (f b)
unstable-octahedron-map f g b (x , p) = (g x , p)

fibre-unstable-octahedron
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : B → C} {g : A → B}
    → ∀ a → fibre g a ≃ fibre (unstable-octahedron-map f g a) (a , refl)
fibre-unstable-octahedron {f = f} {g} a ._≃_.fwd (x , refl)
  = ((_ , refl) , refl)
fibre-unstable-octahedron {f = f} {g} a ._≃_.fwd-is-equiv
  .is-equiv.qinv .fst (_ , refl)  = (_ , refl)
fibre-unstable-octahedron {f = f} {g} a ._≃_.fwd-is-equiv
  .is-equiv.qinv .snd .fst (_ , refl) = refl
fibre-unstable-octahedron {f = f} {g} a ._≃_.fwd-is-equiv
  .is-equiv.qinv .snd .snd (_ , refl) = refl
fibre-unstable-octahedron {f = f} {g} a ._≃_.fwd-is-equiv
  .is-equiv.coherent (_ , refl) = refl
}
}
