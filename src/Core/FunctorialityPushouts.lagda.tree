\title{Pushouts are functorial over the span diagram}
\author{samueltoth}
\date{2025-11-20}
\taxon{Module}
\import{stt-macros}

\agda{
module Core.FunctorialityPushouts where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.CanonicalPushouts
open import Core.SpanMaps
}
}


\subtree[stt-00B1]{
\title{Span maps induce functors of pushouts}
\taxon{Theorem}
\contributor{fredrikbakke}

\agda{
Cocone₁
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓛}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → let module S = Span S; module S' = Span S'
      in (F : Span-map S S')
      → {P' : Type 𝓛} (Pc' : Cocone S' P')
      → Cocone S P'
Cocone₁ F Pc'
  = mk-cocone (Pc'.p ∘ F.h₁) (Pc'.q ∘ F.h₃)
              (  Pc'.p ◃h F.H
              ∙h Pc'.filler ▹h F.h₂
              ∙h Pc'.q ◃h (F.K h⁻¹)) where
  module Pc' = Cocone Pc'
  module F = Span-map F

Pushout-map←span-map : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓜 𝓛}
                {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
              → let module S = Span S; module S' = Span S'
                in (F : Span-map S S')
                → {P : Type 𝓜} (Pc : Cocone S P)
                  (Po : up-pushout S Pc)
                  {P' : Type 𝓛} (Pc' : Cocone S' P')
                → P → P'
Pushout-map←span-map F pcc po pcc'
  = is-equiv.bwd po (Cocone₁ F pcc')

Pushout-map-id
  : ∀ {𝓤 𝓥 𝓦 𝓜} {S : Span 𝓤 𝓥 𝓦} {P : Type 𝓜} {Pc : Cocone S P}
      (Po : up-pushout S Pc)
    → Pushout-map←span-map id-span-map Pc Po (Cocone₁ id-span-map Pc)
    ＝ id
Pushout-map-id po
  = ap (is-equiv.bwd po) (ap (mk-cocone _ _)
                         (funext→ (λ a → ∙-reflr _ ∙ ∙-reflr _ ∙ sym (ap-id _))))
  ∙ is-equiv.η po id

Pushout₀ : ∀ {𝓤 𝓥 𝓦} → Span 𝓤 𝓥 𝓦 → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
Pushout₀ S = Pushout (Span.left S) (Span.right S)

Pushout₁
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
      (F : Span-map S S')
    → Pushout₀ S → Pushout₀ S'
Pushout₁ F = cogap (Cocone₁ F pushout)

cogap-∘-Pushout₁
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓛}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'} {P : Type 𝓛}
      (F : Span-map S S') (C : Cocone S' P)
    → cogap C ∘ Pushout₁ F ~ cogap (Cocone₁ F C)
cogap-∘-Pushout₁ F C
  = let module F = Span-map F in
    cogap-unique _ (cogap C) _ ~refl ~refl
      ( ∙h-reflr _
      ∙h ◃h∙∙ (cogap C) (ι₁ ◃h F.H) (glue ▹h F.h₂) (ι₂ ◃h (F.K h⁻¹))
      ∙h ( (◃h∘ (cogap C) ι₁ F.H h⁻¹)
         ◾h (pushout-rec-apβ {c = C} ∘ F.h₂)
         ◾h (◃h∘ (cogap C) ι₂ (F.K h⁻¹) h⁻¹)))

Pushout-id
  : ∀ {𝓤 𝓥 𝓦} {S : Span 𝓤 𝓥 𝓦}
    → id ~ Pushout₁ (id-span-map {S = S})
Pushout-id
  = pushout-rec-unique _ _ ~refl ~refl λ a → ap (_∙ refl) (ap-id (glue a))

Cocone₁-∘
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓤'' 𝓥'' 𝓦'' 𝓛}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'} {S'' : Span 𝓤'' 𝓥'' 𝓦''}
      {P : Type 𝓛} (F : Span-map S' S'') (G : Span-map S S') (C : Cocone S'' P)
    → Cocone₁ G (Cocone₁ F C) ＝ Cocone₁ (compose-span-map F G) C
Cocone₁-∘ F G C
  = let module F = Span-map F; module G = Span-map G; module C = Cocone C in
    ap (mk-cocone _ _) (funext→ (λ a
    → concat-rebase＝ (C.p ∘ F.h₁) (C.q ∘ F.h₃) (G.H a) (G.K a) _
    ∙ ap (rebase＝ (ap (C.p ∘ F.h₁) (sym (G.H a))) (ap (C.q ∘ F.h₃) (sym (G.K a))))
        (concat-rebase＝ C.p C.q (F.H (G.h₂ a)) (F.K (G.h₂ a)) (C.filler (F.h₂ (G.h₂ a))))
    ∙ rebase＝-ap-∘ F.h₁ F.h₃ C.p C.q
        (G.H a) (F.H (G.h₂ a)) (G.K a) (F.K (G.h₂ a))
        (C.filler (F.h₂ (G.h₂ a)))
    ∙ sym (concat-rebase＝ C.p C.q
        (ap F.h₁ (G.H a) ∙ F.H (G.h₂ a))
        (ap F.h₃ (G.K a) ∙ F.K (G.h₂ a))
        (C.filler (F.h₂ (G.h₂ a))))))

Pushout-∘
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓤'' 𝓥'' 𝓦''}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'} {S'' : Span 𝓤'' 𝓥'' 𝓦''}
      (F : Span-map S' S'') (G : Span-map S S')
    → Pushout₁ F ∘ Pushout₁ G ~ Pushout₁ (compose-span-map F G)
Pushout-∘ F G
  = Pushout₁ F ∘ Pushout₁ G
      ~⟨ cogap-∘-Pushout₁ G _ ⟩
    cogap (Cocone₁ G (Cocone₁ F pushout))
      ~⟨ happly (ap cogap (Cocone₁-∘ F G pushout)) ⟩
    Pushout₁ (compose-span-map F G)
      ~∎

Pushout-qinv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
      (F : Span-map S S')
    → Span-quasi-inv F
    → quasi-inv (Pushout₁ F)
Pushout-qinv F x .fst = Pushout₁ (x .Span-quasi-inv.bwd)
Pushout-qinv F x .snd .fst
  = Pushout-∘ (x .Span-quasi-inv.bwd) F
  ∙h happly (ap Pushout₁ (Span-map-funext→ (x .Span-quasi-inv.η)))
  ∙h (Pushout-id h⁻¹)
Pushout-qinv F x .snd .snd
  = Pushout-∘ F (x .Span-quasi-inv.bwd)
  ∙h happly (ap Pushout₁ (Span-map-funext→ (x .Span-quasi-inv.ε)))
  ∙h (Pushout-id h⁻¹)

Pushout-equiv←logical
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → is-prop-span S → is-prop-span S'
    → Span-logical-equiv S S'
    → Pushout₀ S
    ≃ Pushout₀ S'
Pushout-equiv←logical sp s'p le
  = mk≃ (Pushout₁ fwd)
        (is-equiv←qinv (Pushout-qinv fwd fwd-qinv)) where
  open Span-logical-equiv sp s'p le
}
}
