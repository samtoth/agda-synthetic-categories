\subtree[tot-0051]{
\title{The left cone on a type}
\taxon{Definition}
\date{2026-09-26}
\author{samueltoth}

\p{Given a type #{A} we may construct a type called the left cone on #{A} which can be
seen as adjoining a new point together with a morphisms from every point in #{A} to
the cone point. We can construct this type as the [relative suspension](stt-012G)
of #{A} by #{\{0\} \to Δ¹}. The left cone on #{A} is written #{A^{◅}}, and is
equivalent to the [blunt joint](stt-00CW) #{\b1 \bjoin A}.}

\agda{
_◅ : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
_◅ = RelativeSusp (point i0)

module _ {𝓤} {A : Type 𝓤} where
  ◅-ι : A → A ◅
  ◅-ι = ι₁ ∘ (i1 ,_)

  ◅-cone-point : A ◅
  ◅-cone-point = RelativeSusp∙ i0 A

  ◅-hom : ∀ (a : A) → Hom (A ◅) ◅-cone-point (◅-ι a)
  ◅-hom a .Homᵈ.hom  i = ι₁ (i , a)
  ◅-hom a .Homᵈ.hom0 = glue (tt , a)
  ◅-hom a .Homᵈ.hom1 = refl
}
}

\subtree[tot-5051]{
\title{Functoriality of the left cone operation}
\taxon{Construction}
\date{2026-09-26}
\author{samueltoth}

\p{The left cone operation determines a functor from types to pointed types.}

\agda{
LeftCone₀ : ∀ {𝓤} → Type 𝓤 → Type∗ (𝓤 ⊔ 𝓘)
LeftCone₀ A = RelativeSusp∗ i0 A

LeftCone₁
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B)
    → map∗ (LeftCone₀ A) (LeftCone₀ B)
LeftCone₁ f = RelativeSusp∗₁ i0 f
}
}

\subtree[tot-6594]{
\title{The left cone is a left adjoint}
\taxon{Lemma}
\date{2026-09-26}
\author{samueltoth}

\p{Taking left cones is left adjoint to taking coslices, when seen as an operation
on pointed types (\ref{tot-10Q6}).}

\agda{
LeftCone⊣Coslice
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type∗ 𝓥}
    → (map∗ (LeftCone₀ A) B) ≃ (A → Coslice₀ B)
LeftCone⊣Coslice = postcomp-≃ (Ext-point≃fibre-ev i0 _) ∘e Susp⊣Ext i0
}
}

\subtree[tot-0CEA]{
\title{Left cones are co-strict}
\taxon{Lemma}
\author{samueltoth}
\Contributor{fredrikbakke}
\date{2026-10-15}

\proof{
\p{If #{(0 = 1)}, then the map #{\{0\} \to Δ¹} is an equivalence. The relative suspension
of any type by an equivalence is equivalent to the domain (or codomain) of the
equivalence (\ref{tot-AYCE}) and so in this case is a singleton.}
}

\agda{
module _ {𝓤} (X : Type 𝓤) where

  ◅-is-co-strict : is-co-strict (X ◅)
  ◅-is-co-strict = is-co-strict←is-single-if-0＝1 (λ 0＝1
    → is-single←equiv
        (RelativeSusp-equiv
          (point i0)
          (is-equiv-under-0=1←is-co-strict-map
            (point-is-co-strict-map Δ¹-is-co-strict i0) 0＝1))
        𝟙-is-singleton)
}
}
