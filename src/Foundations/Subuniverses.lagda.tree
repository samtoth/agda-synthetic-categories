\title{Subuniverses}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-08}
\import{stt-macros}

\agda{
module Foundations.Subuniverses where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Subtypes
open import Foundations.Sigma
open import Foundations.Functions
}
}

\subtree[stt-003Z]{
\taxon{Definition}
\title{Subuniverse}
\author{samueltoth}

\p{A subuniverse is a subtype of some universe.}

\agda{
SubU : ∀ (𝓤 𝓥 : Level) → Type (lsuc (𝓤 ⊔ 𝓥))
SubU 𝓤 𝓥 = Subtype (Type 𝓤) 𝓥
}
}

\subtree[stt-004U]{
\date{2025-06-04}
\taxon{Definition}
\title{Sigma closed subuniverses}
\author{samueltoth}

\p{
A subuniverse \SS is \em{Sigma closed} when given
#{A : \UU} and #{B : A \to \UU} such that #{A \in \SS} and #{B(a) \in \SS}
for all #{a : A}, the type #{\Sigma_{(a : A)}B(a)} is in \SS.
}

\agda{
is-Σ-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-Σ-closed {𝓤} S
  = {A : Type 𝓤} {B : A → Type 𝓤}
  → A ∈ S → ((a : A) → B a ∈ S)
  → (Σ[ a ∶ A ] B a) ∈ S
}
}

\subtree[stt-00XQ]{
\title{#{Π}-closed subuniverses}
\taxon{Definition}
\author{fredrikbakke}

\agda{
is-Π-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-Π-closed {𝓤} S
  = {A : Type 𝓤} {B : A → Type 𝓤}
  → ((a : A) → B a ∈ S)
  → Π A B ∈ S
}
}
