\date{2026-08-28}
\title{Horizontal concatenation and whiskering of identifications}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Foundations.IdentityHorizontalConcatenation where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Functions
open import Foundations.Homotopy
}
}

\subtree[stt-00Z9]{
\title{Unit and interchange laws for whiskering identifications}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
◂-left-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → (refl ◂ α) ∙ ∙-refll q ＝ ∙-refll p ∙ α
◂-left-unit-nat = homotopy-natural~id ∙-refll

◂-left-unit
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → refl ◂ α ＝ α
◂-left-unit α = ∙-reflr' (refl ◂ α) ∙ ◂-left-unit-nat α

▸-right-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → (α ▸ refl) ∙ ∙-reflr q ＝ ∙-reflr p ∙ α
▸-right-unit-nat = homotopy-natural~id ∙-reflr

▸-right-unit'
  : ∀ {𝓤} {A : Type 𝓤} {a : A} (α : refl: a ＝ refl: a)
    → α ▸ refl ＝ α
▸-right-unit' α = ∙-reflr' (α ▸ refl) ∙ ▸-right-unit-nat α

◂▸-∙-interchange
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
      {p q : a ＝ b} {r s : b ＝ c}
    → (α : p ＝ q) (β : r ＝ s)
    → (p ◂ β) ∙ (α ▸ s) ＝ (α ▸ r) ∙ (q ◂ β)
◂▸-∙-interchange α β = sym (homotopy-natural (α ▸_) β)
}
}

\subtree[stt-00Z4]{
\title{Horizontal concatenation of identifications}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\p{The symbol we use for horizontal concatenation \code{◾} has agda-input sequence:
\code{sq5}.}

\agda{
infixr 15 _◾_

_◾_
  : ∀ {𝓤} {A : Type 𝓤} {x y z : A}
      {p q : x ＝ y} {r s : y ＝ z}
    → p ＝ q → r ＝ s → p ∙ r ＝ q ∙ s
_◾_ = ap₂ (_∙_)
}
}

\subtree[stt-00Z2]{
\title{Whiskering is horizontal concatenation}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
module _ {𝓤} {A : Type 𝓤} {a b c : A} where

  refl◾-is-◂
    : (p : a ＝ b) {q r : b ＝ c} (β : q ＝ r)
    → refl ◾ β ＝ p ◂ β
  refl◾-is-◂ p β = ap₂-left-refl (_∙_) β

  ◾refl-is-▸
    : {p q : a ＝ b} (α : p ＝ q) (r : b ＝ c)
    → α ◾ refl ＝ α ▸ r
  ◾refl-is-▸ α r = ap₂-right-refl (_∙_) α
}
}

\subtree[stt-00Z7]{
\title{Unit laws of horizontal concatenation}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-29}

\agda{
◾-left-unit
  : ∀ {𝓤} {A : Type 𝓤} {x y : A} {p q : x ＝ y} (α : p ＝ q)
    → refl ◾ α ＝ α
◾-left-unit α = refl◾-is-◂ refl α ∙ ◂-left-unit α

◾-right-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {x y : A} {p q : x ＝ y} (α : p ＝ q)
    → (α ◾ refl) ∙ ∙-reflr q ＝ ∙-reflr p ∙ α
◾-right-unit-nat α
  = ap (_∙ ∙-reflr _) (◾refl-is-▸ α refl) ∙ ▸-right-unit-nat α

◾-right-unit'
  : ∀ {𝓤} {A : Type 𝓤} {a : A} (α : refl: a ＝ refl: a)
    → α ◾ refl ＝ α
◾-right-unit' α
  = ∙-reflr' (α ◾ refl) ∙ ◾-right-unit-nat α
}
}

\subtree[stt-00Z0]{
\title{Interchange law between horizontal and vertical concatenation}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-29}

\agda{
◾-∙-interchange
  : ∀ {𝓤} {A : Type 𝓤} {x y z : A}
      {p p' p'' : x ＝ y} {q q' q'' : y ＝ z}
      (α : p ＝ p') (β : q ＝ q') (γ : p' ＝ p'') (δ : q' ＝ q'')
    → (α ◾ β) ∙ (γ ◾ δ) ＝ (α ∙ γ) ◾ (β ∙ δ)
◾-∙-interchange = ap₂-∙ (_∙_)
}
}
