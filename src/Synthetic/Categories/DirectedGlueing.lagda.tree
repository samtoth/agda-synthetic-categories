\title{Directed glueing types}
\author{samueltoth}
\date{2026-06-04}
\taxon{Module}
\import{stt-macros}


\subtree[stt-00US]{
\taxon{Idea}
\author{samueltoth}

\p{A glue type was originally introduced to give a constructive interpretation of
univalence in work on cubical type theory \citek{CCHM15}. Weaver and Licata
\citek{WL20} and later [Gratzer](danielgratzer), [Weinberger](jonathanweinberger) and
[Buchholtz](ulrikbuchholtz) \citek{GWB24} adapted it in
the directed setting to construct directed univalent universes. In this module we
use a directed glueing type to, under certain modal restrictions, give an equivalence
between covariant type families over the interval and types together with a map
between them. In \ref{Synthetic.Categories.Spaces}, we use this result to show that
the classifier for covariant families satisfies directed univalence.}
}

\agda{
open import Foundations.Universes
open import Foundations.Empty
open import Algebra.Lattice
import Synthetic.Directedness

module Synthetic.Categories.DirectedGlueing
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (open Synthetic.Directedness Δ¹ I)
  (@♭ 0≠1 : i0 ≠ i1)
  (@♭ Δ¹-directed : Δ¹-is-directed)
  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Ergonomics.Extensionality
open import Ergonomics.Auto

open import Modalities.Cohesion.Flat

open import Core.Arrows
open import Core.ArrowMorphisms
open import Core.ArrowEquiv

open import Algebra.Lattice.Instances.Free.Inductive Δ¹ I

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Categories.WalkingHom Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.CovariantClosure Δ¹ I
}
}

\subtree[stt-00UY]{
\title{The glueing of a fibrewise map}
\taxon{Construction}
\contributor{fredrikbakke}

\p{Given a pair of type families #{F, G \colon B \to \Type} and a fibrewise map
#{\alpha_b \colon F_b \to G_b}, we can construct the glueing family
#{\rm{Gl}(\alpha) \colon B \times \Delta^1 \to \Type}.
##{\rm{Gl}(\alpha)(b, i) \defeq \Sigma1{g : G_b}{((i = 0) \to \fibre{\alpha_b}{g})}}}

\p{More generally, we may replace the fibres of #{\alpha} by any type family over
the target, giving rise to the type family \code{Glᵈ}.}

\agda{
Glᵈ
  : ∀ {𝓤 𝓥 𝓦} {B : Type 𝓤}
      (G : B → Type 𝓥) (F : (b : B) → G b → Type 𝓦)
    → B × Δ¹ → Type (𝓘 ⊔ 𝓥 ⊔ 𝓦)
Glᵈ G F (b , i) = Σ[ y ∶ G b ] ((i ＝ i0) → F b y)

Gl
  : ∀ {𝓤 𝓥 𝓦} {B : Type 𝓤} (F : B → Type 𝓥) (G : B → Type 𝓦)
    → (α : (b : B) → F b → G b) → B × Δ¹ → Type (𝓘 ⊔ 𝓥 ⊔ 𝓦)
Gl F G α = Glᵈ G (fibre ∘ α)
}

\p{The endpoints of \code{Glᵈ F G} are #{\Sigma_{F(b)} G(b)} and #{F(b)}.}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  (F : B → Type 𝓥) (G : (b : B) → F b → Type 𝓦)
  where

  Glᵈ-0 : (b : B) → Glᵈ F G (b , i0) → Σ (F b) (G b)
  Glᵈ-0 b = total-map (λ _ → ev refl)

  Glᵈ-0≃ : (b : B) → Glᵈ F G (b , i0) ≃ Σ (F b) (G b)
  Glᵈ-0≃ b = Σ-snd-≃ (λ _ → sing-UP≃ (mk-singl refl (J-set! _ refl)))

  Glᵈ-0-is-equiv : is-fibrewise-equiv Glᵈ-0
  Glᵈ-0-is-equiv = _≃_.fwd-is-equiv ∘ Glᵈ-0≃

  Glᵈ-1 : (b : B) → Glᵈ F G (b , i1) → F b
  Glᵈ-1 b = fst

  Glᵈ-1≃ : (b : B) → Glᵈ F G (b , i1) ≃ F b
  Glᵈ-1≃ b = Σ-singleton (λ _ → Π-is-single (¡ ∘ 0≠1 ∘ sym))

  Glᵈ-1-is-equiv : is-fibrewise-equiv Glᵈ-1
  Glᵈ-1-is-equiv = _≃_.fwd-is-equiv ∘ Glᵈ-1≃
}

\p{#{\rm{Gl}(\alpha)(b,0) = F(b)} and #{\rm{Gl}(\alpha)(b,1) = G(b)}}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  (F : B → Type 𝓥) (G : B → Type 𝓦)
  (α : (b : B) → F b → G b)
  where

  Gl-0 : ∀ b → Gl F G α (b , i0) → F b
  Gl-0 b = fst ∘ ev refl ∘ snd

  Gl-0≃ : ∀ b → Gl F G α (b , i0) ≃ F b
  Gl-0≃ b = Glᵈ-0≃ G (fibre ∘ α) b ∙e total≃total-fibre _

  Gl-0-is-equiv : is-fibrewise-equiv Gl-0
  Gl-0-is-equiv = _≃_.fwd-is-equiv ∘ Gl-0≃

  Gl-1 : ∀ b → Gl F G α (b , i1) → G b
  Gl-1 = Glᵈ-1 G (fibre ∘ α)

  Gl-1≃ : ∀ b → Gl F G α (b , i1) ≃ G b
  Gl-1≃ = Glᵈ-1≃ G (fibre ∘ α)

  Gl-1-is-equiv : is-fibrewise-equiv Gl-1
  Gl-1-is-equiv = _≃_.fwd-is-equiv ∘ Gl-1≃
}

\p{We may also define a map from
#{\rm{Gl}(\alpha)(0,b) \to \rm{Gl}(\alpha)(1,b)}, which is equivalent as a
map to #{\alpha_b}.}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  (F : B → Type 𝓥) (G : (b : B) → F b → Type 𝓦)
  where

  Glᵈ-map : (b : B) → Glᵈ F G (b , i0) → Glᵈ F G (b , i1)
  Glᵈ-map b = total-map (λ _ → precomp-Π _ (¡ ∘ 0≠1 ∘ sym))

  Glᵈ-map-agrees : (b : B) → Arrow-equiv (Glᵈ-map b) (fst: G b)
  Glᵈ-map-agrees b = mk-arr-equiv (Glᵈ-0≃ F G b) (Glᵈ-1≃ F G b) ~refl

module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤} {F : B → Type 𝓥} {G : B → Type 𝓦} (α : (b : B) → F b → G b)
  where

  Gl-map : ∀ b → Gl F G α (b , i0) → Gl F G α (b , i1)
  Gl-map = Glᵈ-map G (fibre ∘ α)

  Gl-map-agrees : ∀ b → Arrow-equiv (Gl-map b) (α b)
  Gl-map-agrees b
    = mk-arr-equiv (Gl-0≃ F G α b) (Gl-1≃ F G α b) (sym ∘ snd ∘ ev refl ∘ snd)
}
}

\subtree[stt-00UZ]{
\title{Covariance of the directed glueing family}
\taxon{Lemma}
\contributor{fredrikbakke}

\p{If #{F} and #{G} are covariant families over #{B}, then the directed glueing of any
map #{\alpha} is also covariant over #{B \times \Delta^1}.}

\p{More generally, \code{Glᵈ F G} is covariant when #{F} and \code{uncurry G}
are covariant.}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  (F : B → Type 𝓥) (G : (b : B) → F b → Type 𝓦)
  where

  opaque
    Glᵈ-is-covariant
      : is-covariant F → is-covariant (uncurry G) → is-covariant (Glᵈ F G)
    Glᵈ-is-covariant F-is-cov G-is-cov
      = Σ-is-covariant
          {B = F ∘ fst} {C = λ bi y → (bi .snd ＝ i0) → G (bi .fst) y}
          (covariant-base-change {P = F} fst F-is-cov)
          (^●-is-covariant Δ¹-directed
            (λ ((b , i) , y) → G b y)
            (covariant-base-change {P = uncurry G}
              (λ ((b , i) , y) → (b , y)) G-is-cov)
            (snd ∘ fst))

  Glᵈ∘-is-covariant
    : ∀ {𝓧} {A : Type 𝓧} (f : A → B × Δ¹)
      → is-covariant F → is-covariant (uncurry G) → is-covariant (Glᵈ F G ∘ f)
  Glᵈ∘-is-covariant f F-is-cov G-is-cov
    = covariant-base-change {P = Glᵈ F G} f
        (Glᵈ-is-covariant F-is-cov G-is-cov)

Gl-is-covariant
  : ∀ {𝓤 𝓥 𝓦} {B : Type 𝓤}
      (F : B → Type 𝓥) (G : B → Type 𝓦)
      (α : (b : B) → F b → G b)
    → is-covariant F
    → is-covariant G
    → is-covariant (Gl F G α)
Gl-is-covariant {B = B} F G α Fc Gc
  = Glᵈ-is-covariant G (fibre ∘ α) Gc (fibre-is-covariant F G Fc Gc α)

Gl∘-is-covariant
  : ∀ {𝓤 𝓤' 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓤'} (f : A → B × Δ¹)
      (F : B → Type 𝓥) (G : B → Type 𝓦)
      (α : (b : B) → F b → G b)
    → is-covariant F → is-covariant G
    → is-covariant (Gl F G α ∘ f)
Gl∘-is-covariant f F G α Fc Gc
  = covariant-base-change {P = Gl F G α} f
      (Gl-is-covariant F G α Fc Gc)
}
}


\subtree[stt-00KF]{
\title{Paths in glue types}
\taxon{Lemma}
\contributor{fredrikbakke}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  {F : B → Type 𝓥} {G : (b : B) → F b → Type 𝓦}
  where

  IdS-Glᵈ : (bi : B × Δ¹) → Identity-system (Glᵈ F G bi) (𝓘 ⊔ 𝓥 ⊔ 𝓦)
  IdS-Glᵈ bi = IdS-Sigma ⦃ IdS-default ⦄ ⦃ IdS-Π ⦃ IdS-default ⦄ ⦄

  Glᵈ-Id : (bi : B × Δ¹) → Glᵈ F G bi → Glᵈ F G bi → Type (𝓘 ⊔ 𝓥 ⊔ 𝓦)
  Glᵈ-Id bi = IdS ⦃ IdS-Glᵈ bi ⦄

  Glᵈ-Id→ : (bi : B × Δ¹) {x y : Glᵈ F G bi} → Glᵈ-Id bi x y → x ＝ y
  Glᵈ-Id→ bi = Id←IdS ⦃ IdS-Glᵈ bi ⦄

module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  {F : B → Type 𝓥} {G : B → Type 𝓦}
  {f : (b : B) → F b → G b}
  where

  Gl-Id : ∀ (bi : B × Δ¹) → Gl F G f bi → Gl F G f bi → Type (𝓘 ⊔ 𝓥 ⊔ 𝓦)
  Gl-Id (b , i) x y
    = Σ[ p ∶ x .fst ＝ y .fst ]
       (∀ (pi : i ＝ i0)
        → Σ[ q ∶ x .snd pi .fst ＝ y .snd pi .fst ]
           (Square (x .snd pi .snd) (y .snd pi .snd) (ap (f b) q) p))

  Gl-Id-refl : ∀ i → (x : Gl F G f i) → Gl-Id i x x
  Gl-Id-refl i x = (refl , (λ pi → refl , Square-degen-hor _ _ refl))

  opaque
    Gl-Id-is-torsorial
      : ∀ (bi : B × Δ¹) → (x : Gl F G f bi) → is-singleton (Σ _ (Gl-Id bi x))
    Gl-Id-is-torsorial bi x
      = is-singleton-structure←parts
          Sing-is-singleton
          (_ , refl)
          (is-single←equiv
            (Σ-Π-swap≃ _ λ p y
              → Σ[ q ∶ x .snd p .fst ＝ y .fst ]
                 Square (x .snd p .snd) (y .snd) (ap _ q) refl)
            (Π-is-single (λ where
              refl → is-singleton-structure←parts
                       Sing-is-singleton
                       (_ , refl)
                       (Square-degen-hor-is-torsorial
                         (x .snd refl .snd)))))

  IdS-Gl
    : ∀ (bi : B × Δ¹) → Identity-system (Gl F G f bi) (𝓘 ⊔ 𝓥 ⊔ 𝓦)
  IdS-Gl bi .Identity-system.IdS = Gl-Id bi
  IdS-Gl bi .Identity-system.IdS←Id refl
    = Gl-Id-refl bi _
  IdS-Gl bi .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (Gl-Id-is-torsorial bi a) _

Gl-Id→
  : ∀ {𝓤 𝓥 𝓦} {B : Type 𝓤}
      {F : B → Type 𝓥} {G : B → Type 𝓦}
      (f : (b : B) → F b → G b)
      (bi : B × Δ¹)
      {x y : Gl F G f bi}
    → Gl-Id {f = f} bi x y → x ＝ y
Gl-Id→ f bi = Id←IdS ⦃ IdS-Gl {f = f} bi ⦄
}
}

\subtree[stt-00V3]{
\title{Covariant #{Δ¹}-bundles}
\taxon{Definition}

\p{For some base type #{B} we define covariant #{\Delta^1}-bundles over #{B} to
be the data consisting of:

\ul{
\li{A pair of covariant type families #{F} and #{G} over #{B}}
\li{A fibrewise map #{\alpha_{b} \colon F(b) \to G(b)}}
}
}

\agda{
Cov-Δ¹-bundle
  : ∀ {𝓤} 𝓥 𝓥' → Type 𝓤 → Type (𝓘 ⊔ 𝓤 ⊔ lsuc 𝓥 ⊔ lsuc 𝓥')
Cov-Δ¹-bundle 𝓥 𝓥' B
  = Σ[ X ∶ CovBundle 𝓥 B ] Σ[ Y ∶ CovBundle 𝓥' B ] ((b : B) → X .fst b → Y .fst b)
}
}

\subtree[stt-00V1]{
\title{Characterising the identity type of a [covariant #{Δ¹}-bundle](stt-00V3)}
\taxon{Lemma}

\p{Given #{(A, B , α)} and #{(X, Y, β)}, a pair of covariant #{\Delta^1}-bundles over
some type #{B}, the identity type #{(A,B,α) = (X,Y,β)} is equivalent to fibrewise
equivalences #{e \colon A \simeq X} and #{p \colon B \simeq Y} such that the resulting square
commutes (#{p\alpha \sim \beta e}). Note that this is equivalent to an arrow
equivalence #{\alpha_x \simeq \beta_x} for all #{x : B \times \Delta^1}.}

\agda{
cov-Δ¹-bundle-Path
  : ∀ {𝓤 𝓥 𝓥' 𝓦 𝓦'} {B : Type 𝓤}
      (x : Cov-Δ¹-bundle 𝓥 𝓥' B) (y : Cov-Δ¹-bundle 𝓦 𝓦' B)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓥' ⊔ 𝓦 ⊔ 𝓦')
cov-Δ¹-bundle-Path ((A , _) , (B , _) , f) ((X , _) , (Y , _) , g)
  = Σ[ e ∶ (∀ b → A b ≃ X b) ] Σ[ p ∶ (∀ b → B b ≃ Y b) ]
      (∀ b → p b ._≃_.fwd ∘ f b ~ g b ∘ e b ._≃_.fwd)

cov-Δ¹-bundle-Path-refl
  : ∀ {𝓤 𝓥 𝓥'} {B : Type 𝓤} (x : Cov-Δ¹-bundle 𝓥 𝓥' B)
    → cov-Δ¹-bundle-Path x x
cov-Δ¹-bundle-Path-refl x = ((λ _ → id≃) , (λ _ → id≃) , λ _ → ~refl)

instance
  IdS-cov-fam
    : ∀ {𝓤 𝓥} {A : Type 𝓤} → Identity-system (CovBundle 𝓥 A) (𝓤 ⊔ 𝓥)
  IdS-cov-fam = IdS←Subtype (λ E → is-covariant-is-prop E) auto!

opaque
  cov-Δ¹-bundle-Path-is-torsorial
    : ∀ {𝓤 𝓥} {B : Type 𝓤} (x : Cov-Δ¹-bundle 𝓥 𝓥 B)
      → is-singleton (Σ (Cov-Δ¹-bundle 𝓥 𝓥 B) (cov-Δ¹-bundle-Path x))
  cov-Δ¹-bundle-Path-is-torsorial (A , B , f)
    = is-singleton-structure←parts
       (SingS-is-single A)
       (A , λ _ → id≃)
       (is-singleton-structure←parts
         (SingS-is-single B)
         (B , λ _ → id≃)
         (SingS-is-single _))

instance
  cov-Δ¹-bundle-IdS
    : ∀ {𝓤 𝓥} {B : Type 𝓤} → Identity-system (Cov-Δ¹-bundle 𝓥 𝓥 B) (𝓤 ⊔ 𝓥)
  cov-Δ¹-bundle-IdS .Identity-system.IdS = cov-Δ¹-bundle-Path
  cov-Δ¹-bundle-IdS .Identity-system.IdS←Id {a = A} refl = cov-Δ¹-bundle-Path-refl A
  cov-Δ¹-bundle-IdS .Identity-system.IdS←Id-is-equiv x
    = fundamental-Id _ (cov-Δ¹-bundle-Path-is-torsorial x) _
}
}

\subtree[stt-00V0]{
\title{The induced transport of a covariant family over #{Δ¹}}
\taxon{Construction}

\p{Given a covariant type family over #{B \times \Delta^1}, we can construct a
[\em{covariant bundle}](stt-00V3) over #{\Delta^1} – i.e.  a pair of covariant
families #{B \to \Type} together with a fibrewise map between them. }

\agda{
total-tr-cov
  : ∀ {𝓤 𝓥} {B : Type 𝓤}
    → CovBundle 𝓥 (B × Δ¹)
    → Cov-Δ¹-bundle 𝓥 𝓥 B
total-tr-cov (F , Fcov)
  = ( (F ∘ (_, i0) , covariant-base-change {P = F} (_, i0) Fcov)
    , (F ∘ (_, i1) , covariant-base-change {P = F} (_, i1) Fcov)
    , (λ b → tr-cov {P = F ∘ (b ,_)} (covariant-base-change {P = F} (b ,_) Fcov) id))
}
}

\subtree[stt-00V2]{
\title{Directed univalence for covariant families}
\taxon{Theorem}

\p{The map defined in \ref{stt-00V0} induces an equivalence between covariant
families over #{B \times \Delta^1} and covariant bundles over #{B}, i.e. pairs of covariant
families over #{B} equipped with a fibrewise map between them.}

\proof{
\p{We first define a putative inverse:}

\agda{
module _
  {𝓤 𝓥 𝓥'} {B : Type 𝓤}
  where

  total-tr-cov-inv
    : Cov-Δ¹-bundle 𝓥 𝓥' B
    → CovBundle (𝓘 ⊔ 𝓥 ⊔ 𝓥') (B × Δ¹)
  total-tr-cov-inv ((A , Ac) , (B , Bc) , α)
    = (Gl A B α , Gl-is-covariant A B α Ac Bc)
}

\subtree[stt-00V4]{
\title{Left inverse}
\taxon{Lemma}
\contributor{fredrikbakke}

\p{Under no assumptions, this map is a left inverse. I.e for covariant type families
#{X} and #{Y} with a fibrewise map #{\alpha} between them, there is an equivalence
of families of arrows between transporting over the [glueing family](stt-00UY) of
#{\alpha} and #{\alpha} itself.}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤}
  (F : B → Type 𝓥) (G : (b : B) → F b → Type 𝓦)
  where

  tr-Glᵈ-hom
    : (b : B) (x : Glᵈ F G (b , i0))
    → Homᵈ (Glᵈ F G ∘ (b ,_)) x (Glᵈ-map F G b x)
  tr-Glᵈ-hom b x .Homᵈ.hom i = (x .fst , (λ _ → x .snd refl))
  tr-Glᵈ-hom b x .Homᵈ.hom0 = Σ-path→ (refl , funext→ (J-set! _ refl))
  tr-Glᵈ-hom b x .Homᵈ.hom1 = Σ-path→ (refl , funext→ (¡ ∘ 0≠1 ∘ sym))

  tr-Glᵈ
    : (Gl-is-cov : is-covariant (Glᵈ F G)) (b : B)
    → tr-cov {P = Glᵈ F G} Gl-is-cov (b ,_) ~ Glᵈ-map F G b
  tr-Glᵈ Gl-is-cov b x
    = tr-cov-unique {P = Glᵈ F G} Gl-is-cov (b ,_)
        (Glᵈ-map F G b) x (tr-Glᵈ-hom b x)

  tr-hom-Glᵈ
    : (b : B) (Gl-is-cov : is-covariant (Glᵈ F G ∘ (b ,_)))
    → tr-cov-hom {P = Glᵈ F G ∘ (b ,_)} Gl-is-cov 0≤1 ~ Glᵈ-map F G b
  tr-hom-Glᵈ b Gl-is-cov x
    = tr-cov-hom-unique Gl-is-cov 0≤1 x (Glᵈ-map F G b x) (tr-Glᵈ-hom b x)

  tr-Glᵈ-0≤1H
    : (b : B) (Gl-is-cov : is-covariant (Glᵈ F G ∘ (b ,_)))
    → Arrow-equiv (tr-cov-hom {P = Glᵈ F G ∘ (b ,_)} Gl-is-cov 0≤1) (fst: G b)
  tr-Glᵈ-0≤1H b Gl-is-cov
    = mk-arr-equiv (Glᵈ-0≃ F G b) (Glᵈ-1≃ F G b) (ap fst ∘ tr-hom-Glᵈ b Gl-is-cov)

  tr-Glᵈ-0≤1
    : (Gl-is-cov : is-covariant (Glᵈ F G)) (b : B)
    → Arrow-equiv (tr-cov {P = Glᵈ F G} Gl-is-cov (b ,_)) (fst: G b)
  tr-Glᵈ-0≤1 Gl-is-cov b
    = mk-arr-equiv (Glᵈ-0≃ F G b) (Glᵈ-1≃ F G b) (ap fst ∘ tr-Glᵈ Gl-is-cov b)

module _
  {𝓤 𝓥 𝓥'} {B : Type 𝓤}
  where

  tr-Gl-hom
    : {X : B → Type (𝓘 ⊔ 𝓥)} {Y : B → Type (𝓘 ⊔ 𝓥')}
      (α : ∀ b → X b → Y b)
    → ∀ b x → Homᵈ (Gl X Y α ∘ (b ,_)) x (Gl-map α b x)
  tr-Gl-hom {Y = Y} α = tr-Glᵈ-hom Y (fibre ∘ α)

  tr-Gl
    : {X : B → Type (𝓘 ⊔ 𝓥)} {Y : B → Type (𝓘 ⊔ 𝓥')}
      (α : ∀ b → X b → Y b)
      (Xc : is-covariant X) (Yc : is-covariant Y)
    → ∀ b
    → tr-cov {P = Gl X Y α} (Gl-is-covariant X Y α Xc Yc) (b ,_)
    ~ Gl-map α b
  tr-Gl {X} {Y} α Xc Yc
    = tr-Glᵈ Y (fibre ∘ α) (Gl-is-covariant X Y α Xc Yc)

  tr-hom-Gl
    : {X : B → Type (𝓘 ⊔ 𝓥)} {Y : B → Type (𝓘 ⊔ 𝓥')}
      (α : ∀ b → X b → Y b)
      (Xc : is-covariant X) (Yc : is-covariant Y)
    → ∀ b
    → tr-cov-hom {P = Gl X Y α ∘ (b ,_)}
        (Gl∘-is-covariant (b ,_) X Y α Xc Yc)
        0≤1
    ~ Gl-map α b
  tr-hom-Gl {X} {Y} α Xc Yc b
    = tr-hom-Glᵈ Y (fibre ∘ α) b (Gl∘-is-covariant (b ,_) X Y α Xc Yc)

  tr-Gl-0≤1H
    : {X : B → Type (𝓘 ⊔ 𝓥)} {Y : B → Type (𝓘 ⊔ 𝓥')}
      (α : ∀ b → X b → Y b)
      (Xc : is-covariant X) (Yc : is-covariant Y)
      (b : B)
    → Arrow-equiv
        (tr-cov-hom {P = Gl X Y α ∘ (b ,_)}
          (Gl∘-is-covariant (b ,_) X Y α Xc Yc) 0≤1)
        (α b)
  tr-Gl-0≤1H α Xc Yc b
    = mk-arr-equiv
        (Gl-0≃ _ _ α b)
        (Gl-1≃ _ _ α b)
        λ x → ap fst (tr-hom-Gl α Xc Yc b x) ∙ sym (x .snd refl .snd)

  tr-Gl-0≤1
    : {X : B → Type (𝓘 ⊔ 𝓥)} {Y : B → Type (𝓘 ⊔ 𝓥')}
      (α : ∀ b → X b → Y b)
      (Xc : is-covariant X) (Yc : is-covariant Y)
      (b : B)
    → Arrow-equiv
        (tr-cov {P = Gl X Y α} (Gl-is-covariant X Y α Xc Yc) (b ,_))
        (α b)
  tr-Gl-0≤1 α Xc Yc b
    = mk-arr-equiv
        (Gl-0≃ _ _ α b)
        (Gl-1≃ _ _ α b)
        ( λ x@(y , p)
          → (fst ∘ tr-cov {P = Gl _ _ α} (Gl-is-covariant _ _ α Xc Yc) (b ,_)) x
          ＝⟨ ap fst (tr-Gl α Xc Yc b x) ⟩
            x .fst
          ＝⟨ sym (p refl .snd) ⟩
            α b (p refl .fst)
          ∎)

  total-tr-cov-section
    : (x : Cov-Δ¹-bundle (𝓘 ⊔ 𝓥) (𝓘 ⊔ 𝓥') B)
    → cov-Δ¹-bundle-Path {𝓤} {𝓘 ⊔ 𝓥 ⊔ 𝓥'} {𝓘 ⊔ 𝓥 ⊔ 𝓥'} {𝓘 ⊔ 𝓥} {𝓘 ⊔ 𝓥'} {B = B}
        (total-tr-cov (total-tr-cov-inv x))
        (x)
  total-tr-cov-section ((X , _) , (Y , _) , F) .fst b
    = Gl-0≃ X Y F b
  total-tr-cov-section ((X , _) , (Y , _) , F) .snd .fst b
    = Gl-1≃ X Y F b
  total-tr-cov-section ((X , Ac) , (Y , Bc) , F) .snd .snd b
    = tr-Gl-0≤1 {X} {Y} F Ac Bc b .fst .Arrow-map.comm
}
}

\subtree[stt-00V5]{
\taxon{Lemma}
\title{Right inverse}

\p{To show that we have a right inverse, for a covariant family
#{F} over #{B \times \Delta^1}, we need that #{F(b,i)} is equal to
#{\Gl(F(b,0), F(b,1), F(b,-)_*)}. By univalence we may give a fibrewise map and show it
is an equivalence.
}

\p{To show that this map is indeed an equivalence we assume an additional axiom; namely that
for a crisp fibrewise map #{\alpha} between crisp covariant families over #{B \times
\Delta^1}, to check it is an equivalence it suffices to check that for all #{b},
#{\alpha_{(b, 0)}} and #{\alpha_{(b,1)}} are equivalences.}

\remark{
This axiom follows for example from the pair of axioms that types with an
[initial object](stt-00FO) [separate](stt-00J7) and the booleans cover the global
points of #{\Delta^1}.
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤}
  (FF@(F , Fc) : CovBundle (𝓘 ⊔ 𝓥) (B × Δ¹))
  (let Fbc b = covariant-base-change {P = F} (b ,_) Fc)
  where

  Gl←cov-fam
    : (i : B × Δ¹)
    → F i
    → Gl
       (F ∘ (_, i0))
       (F ∘ (_, i1))
       (λ b → tr-cov {P = F} Fc (b ,_))
       i
  Gl←cov-fam (b , i) x .fst
    = tr-cov-hom {P = F ∘ (b ,_)}
        (Fbc b)
        (Δ¹-hom←≤ 1-top)
        x
  Gl←cov-fam (b , i) x .snd refl
    = ( x
      , sym
         (happly
           (coe-cov-0≤1 (F ∘ (b ,_)) (Fbc b) 1-top)
           x))

  Gl←cov-fam-is-equiv-at-0
    : ∀ b → is-equiv (Gl←cov-fam (b , i0))
  Gl←cov-fam-is-equiv-at-0 b
    = 3-for-2
        (Gl-0≃
          (F ∘ (_, i0))
          (F ∘ (_, i1))
          (λ b → tr-cov {P = F} Fc (b ,_))
          b ._≃_.fwd-is-equiv)
        id-is-equiv

  Gl←cov-fam-is-equiv-at-1
    : ∀ b → is-equiv (Gl←cov-fam (b , i1))
  Gl←cov-fam-is-equiv-at-1 b
    = 3-for-2~
        (tr-cov-idH~ (F ∘ (b ,_)) (Fbc b) (Δ¹-hom←≤ 1-top) (Δ¹-hom-≤-refl 1-top) h⁻¹)
        (Gl-1≃
          (F ∘ (_, i0))
          (F ∘ (_, i1))
          (λ b → tr-cov {P = F} Fc (b ,_))
          b ._≃_.fwd-is-equiv)
        id-is-equiv

module _
  {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
  (@♭ crisp-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤} (@♭ F G : CovBundle 𝓤 (B × Δ¹))
        (@♭ α : ∀ i → F .fst i → G .fst i)
      → @♭ (∀ (@♭ b : B) (@♭ x) → is-♭-equiv (α (b , ∂Δ¹-incl x)))
      → is-fibrewise-equiv α)
  where

  Gl←cov-fam-is-equiv
    : ∀ (@♭ F : CovBundle (𝓘 ⊔ 𝓥) (B × Δ¹))
      → is-fibrewise-equiv (Gl←cov-fam {𝓤} {𝓥} F)
  Gl←cov-fam-is-equiv FF
    = crisp-cov-Nat-is-equiv FF
        (total-tr-cov-inv {𝓤} {𝓘 ⊔ 𝓥} {𝓘 ⊔ 𝓥} {B} (total-tr-cov FF))
        (Gl←cov-fam FF)
        (λ where
          b ∂Δ¹-1 → is-♭-equiv←is-equiv (Gl←cov-fam-is-equiv-at-1 FF b)
          b ∂Δ¹-0 → is-♭-equiv←is-equiv (Gl←cov-fam-is-equiv-at-0 FF b))

  total-tr-cov-retraction
    : ∀ (@♭ F : CovBundle (𝓘 ⊔ 𝓥) (B × Δ¹))
      → (bi : B × Δ¹)
      → F .fst bi ≃ total-tr-cov-inv {𝓤} {𝓘 ⊔ 𝓥} {𝓘 ⊔ 𝓥} {B} (total-tr-cov F) .fst bi
  total-tr-cov-retraction F bi ._≃_.fwd = Gl←cov-fam {𝓤} {𝓥} F bi
  total-tr-cov-retraction F bi ._≃_.fwd-is-equiv = Gl←cov-fam-is-equiv F bi
}
}

\agda{
  opaque
    total-tr-cov-is-♭-equiv
      : is-♭-equiv (total-tr-cov {𝓤} {𝓘 ⊔ 𝓥} {B = B})
    total-tr-cov-is-♭-equiv = is-equiv←qinv
      ( ♭-map total-tr-cov-inv
      , ♭-ind (λ a → mapply♭ (mod♭ (ext! (λ b → total-tr-cov-retraction a b e⁻¹))))
      , ♭-ind (λ a → mapply♭ (mod♭ (ext! (total-tr-cov-section {𝓤} {𝓥} {𝓥} a)))))
}
}
}
