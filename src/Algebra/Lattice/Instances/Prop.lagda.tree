\date{2025-10-22}
\title{The lattice of propositions}
\taxon{Module}
\import{stt-macros}

\agda{
module Algebra.Lattice.Instances.Prop where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude


open import Core.Joins
open import Modalities.Instances.Truncation
open import Algebra.Lattice
}
}


\subtree[stt-009R]{
\title{The lattice of propositions}
\taxon{Example}
\p{The subobject/subtype classifier #{\mathrm{Prop}}
has a canonical lattice structure on it, given by logical and and or}

\agda{
Prop-Lattice : ∀ 𝓤 → Lattice (Prop 𝓤)
Prop-Lattice 𝓤 = l where
  l : Lattice (Prop 𝓤)
  l .Lattice.0l = TULift -1 𝓤 (∅ , trunc! -1)
  l .Lattice.1l = TULift -1 𝓤 (𝟙 , trunc! -1)
  l .Lattice._∧_ (A , p) (B , q) = (A × B , Σ-is-truncated -1 p λ _ → q)
  l .Lattice._∨_ (A , p) (B , q)
    = (A * B , *-is-prop p q)
  l .Lattice.str-is-lattice .is-lattice.∧-assoc
    = Prop-ext→
        ( (λ x → (x .fst , x .snd .fst) , x .snd .snd)
        , (λ x → x .fst .fst , x .fst .snd , x .snd) )
  -- todo formalise untruncated *-assoc
  l .Lattice.str-is-lattice .is-lattice.∨-assoc {x} {y} {z}
    = Prop-ext→
        (*-prop-rec xyzprp
            (ι₁ ∘ ι₁)
            (*-prop-rec xyzprp (ι₁ ∘ ι₂) ι₂)
        , *-prop-rec xyzprp'
            (*-prop-rec xyzprp' ι₁ (ι₂ ∘ ι₁))
            (ι₂ ∘ ι₂))
      where

      xprp = x .snd
      yprp = y .snd
      zprp = z .snd
      xyzprp = *-is-prop (*-is-prop xprp yprp) zprp
      xyzprp' = *-is-prop xprp (*-is-prop yprp zprp)

  l .Lattice.str-is-lattice .is-lattice.∧-comm
    = Prop-ua→ ×-swap
  l .Lattice.str-is-lattice .is-lattice.∨-comm
    = Prop-ua→ *-comm
  l .Lattice.str-is-lattice .is-lattice.∨-∧-abs {x}
    = Prop-ext→ (*-prop-rec (x .snd) id fst , ι₁)
  l .Lattice.str-is-lattice .is-lattice.∧-∨-abs {x}
    = Prop-ext→ (fst , λ x → x , (ι₁ x))
  l .Lattice.str-is-lattice .is-lattice.0-bottom {x}
    = Prop-ext→ ( *-prop-rec (x .snd) id (¡ ∘ unlift) , ι₁)
  l .Lattice.str-is-lattice .is-lattice.1-top
    = Prop-ext→ ((λ z → z .fst) , (λ z → z , ttᴸ))

Prop-Lattice-is-distributive
  : ∀ {𝓤} → is-distributive (Prop-Lattice 𝓤)
Prop-Lattice-is-distributive .is-distributive.distrib-∨-∧ {x = x} {y} {z}
  = Prop-ext→
      ( *-prop-rec (×-is-prop (*-is-prop xprp yprp) (*-is-prop xprp zprp))
          (λ x → (ι₁ x , ι₁ x))
          (λ (y , z) → (ι₂ y , ι₂ z))
      , (λ (xy , xz)
         → *-prop-rec xyzprp
             ι₁
             (λ y → *-prop-rec xyzprp ι₁ (λ z → ι₂ (y , z)) xz)
             xy))
  where

  xprp = x .snd
  yprp = y .snd
  zprp = z .snd
  xyzprp = *-is-prop xprp (×-is-prop yprp zprp)
}
}
