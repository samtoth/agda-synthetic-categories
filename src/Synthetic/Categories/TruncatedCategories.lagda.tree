\subtree[stt-014A]{
\title{#{n}-Truncated categories}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Let #{n : ℕ \cup \{-1\}}. An \em{#{n}-truncated category} is a [category](stt-00PH)
whose homs are #{(n-1)}-truncated. More concretely it is a type that is Segal,
Rezk-complete, simplicial, and hom #{(n-1)}-truncated. #{-1}-Truncated categories
have contractible hom types and the underlying type is a [proposition](stt-0009).
At level #{0} we obtain posets, and #{1}-truncated categories have set-valued homs.
}

\agda{
generating-fam-is-trunc-category : (n : 𝕋₋₁) → fibrewise-map _ _
generating-fam-is-trunc-category n
  = generating-fam-is-category ⨄₁ᶠ generating-fam-hom-truncation (𝕋←suc-𝕋₋₁ n)

is-trunc-category : ∀ {𝓤} → 𝕋₋₁ → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
is-trunc-category = is-local ∘ generating-fam-is-trunc-category

TruncCategory-SubU : ∀ {𝓤} → 𝕋₋₁ → SubU 𝓤 (𝓘 ⊔ 𝓤)
TruncCategory-SubU n = Local-SubU (generating-fam-is-trunc-category n) _

TruncCategory-gSubU : 𝕋₋₁ → gSubU (𝓘 ⊔_)
TruncCategory-gSubU n = Local-gSubU (generating-fam-is-trunc-category n)
}
}

\subtree[stt-014L]{
\title{The reflective subuniverse of #{n}-truncated categories}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-19}

\p{#{n}-Truncated categories form a [global reflective subuniverse](stt-00IF).}

\agda{
TruncCategory-is-globally-reflective
  : (n : 𝕋₋₁) → is-globally-reflective (TruncCategory-gSubU n)
TruncCategory-is-globally-reflective n
  = Local-global-reflectors (generating-fam-is-trunc-category n)

TruncCategory-gRSubU : 𝕋₋₁ → gRSubU (𝓘 ⊔_)
TruncCategory-gRSubU n .gRSubU.GS
  = TruncCategory-gSubU n
TruncCategory-gRSubU n .gRSubU.GS-is-globally-reflective
  = TruncCategory-is-globally-reflective n

module _ {n : 𝕋₋₁} where

  open gSubU (TruncCategory-gSubU n) public using () renaming
    ( ∈S←equiv to is-trunc-category←equiv)
  open gReflectiveClosure (TruncCategory-gRSubU n) public using () renaming
    ( Π∈S to Π-is-trunc-category
    ; Πᵢ∈S to Πᵢ-is-trunc-category
    ; →∈S to →-is-trunc-category
    ; ULift∈S to ULift-is-trunc-category
    ; 𝟙∈S to 𝟙-is-trunc-category
    ; ∈S←is-singleton to is-trunc-category←is-singleton
    ; ∈S←retract to is-trunc-category←retract
    ; Pullback∈S to Pullback-is-trunc-category
    ; fibre∈S to fibre-is-trunc-category
    ; Ext∈S to Ext-is-trunc-category
    ; ×∈S to ×-is-trunc-category
    ; ＝∈S to ＝-is-trunc-category
    ; ~∈S to ~-is-trunc-category
    ; retract∈S to retract-is-trunc-category
    ; biinv∈S to biinv-is-trunc-category
    ; ≃∈S to ≃-is-trunc-category
    ; Equaliser∈S to Equaliser-is-trunc-category
    ; Seq-lim∈S to Seq-lim-is-trunc-category
    ; preidempotent-map∈S to preidempotent-map-is-trunc-category
    ; qidempotent-map∈S to qidempotent-map-is-trunc-category
    ; idempotent-map∈S to idempotent-map-is-trunc-category
    ; Retracts∈S to Retracts-is-trunc-category)
  open gRSubUHomClosure (TruncCategory-gRSubU n) public using () renaming
    ( Hom∈S to Hom-is-trunc-category)

module TruncCategory (n : 𝕋₋₁) where
  open gRSubU (TruncCategory-gRSubU n) public
  open gReflectiveReasoning (TruncCategory-gRSubU n) public
  open gReflectiveClosure (TruncCategory-gRSubU n) public
  open gRSubUHomClosure (TruncCategory-gRSubU n) public

TruncCategory-U : 𝕋₋₁ → (𝓤 : Level) → Type (lsuc (𝓘 ⊔ 𝓤))
TruncCategory-U n 𝓤 = Σ[ A ∶ Type (𝓘 ⊔ 𝓤) ] is-trunc-category n A
}
}

\subtree[stt-014M]{
\title{#{n}-Truncated categories are categories with #{(n-1)}-truncated homs}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
A type is an #{n}-truncated category if and only if it is a [category](stt-00PH),
hence simplicial and complete Segal, and all its hom types are #{(n-1)}-truncated.
}

\agda{
module _ (n : 𝕋₋₁) {𝓤} {A : Type 𝓤} where

  is-trunc-category-is-prop : is-prop (is-trunc-category n A)
  is-trunc-category-is-prop = is-local-is-prop A

  is-category←is-trunc-category
    : is-trunc-category n A → is-category A
  is-category←is-trunc-category A-tcat
    = ×-is-local←is-local-⨄₁ᶠ A-tcat .fst

  is-segal←is-trunc-category : is-trunc-category n A → is-segal A
  is-segal←is-trunc-category
    = is-segal←is-category ∘ is-category←is-trunc-category

  is-rezk-complete←is-trunc-category
    : is-trunc-category n A → is-rezk-complete A
  is-rezk-complete←is-trunc-category
    = is-rezk-complete←is-category ∘ is-category←is-trunc-category

  is-complete-segal←is-trunc-category
    : is-trunc-category n A → is-complete-segal A
  is-complete-segal←is-trunc-category A-tcat
    = is-complete-segal×is-simplicial←is-category
        (is-category←is-trunc-category A-tcat) .fst

  is-simplicial←is-trunc-category
    : is-trunc-category n A → is-simplicial A
  is-simplicial←is-trunc-category
    = is-simplicial←is-category ∘ is-category←is-trunc-category

  Hom-is-truncated←is-trunc-category
    : is-trunc-category n A
    → (a b : A) → is-truncated (𝕋←suc-𝕋₋₁ n) (Hom A a b)
  Hom-is-truncated←is-trunc-category A-tcat
    = Hom-is-truncated←is-hom-truncated (𝕋←suc-𝕋₋₁ n)
        (×-is-local←is-local-⨄₁ᶠ A-tcat .snd)

  is-trunc-category←is-category←Hom-is-truncated
    : is-category A
    → ((a b : A) → is-truncated (𝕋←suc-𝕋₋₁ n) (Hom A a b))
    → is-trunc-category n A
  is-trunc-category←is-category←Hom-is-truncated A-tcat h
    = is-local-⨄₁ᶠ←is-local A-tcat
        (is-hom-truncated←Hom-is-truncated (𝕋←suc-𝕋₋₁ n) h)

  is-trunc-category≃is-category×Hom-is-truncated
    : is-trunc-category n A
    ≃ (is-category A × ((a b : A) → is-truncated (𝕋←suc-𝕋₋₁ n) (Hom A a b)))
  is-trunc-category≃is-category×Hom-is-truncated
    = equiv←logical is-trunc-category-is-prop
        (×-is-prop is-category-is-prop
          (Π-is-prop (λ a → Π-is-prop (λ b
            → is-truncated-is-prop (𝕋←suc-𝕋₋₁ n) (Hom A a b)))))
        ( (λ H → ( is-category←is-trunc-category H
                  , Hom-is-truncated←is-trunc-category H))
        , (λ (H , h) → is-trunc-category←is-category←Hom-is-truncated H h))
}
}

\subtree[stt-014I]{
\title{#{n}-Truncated categories are #{n}-truncated}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-20}

\p{The underlying type of an [#{n}-truncated category](stt-014A) is #{n}-truncated.}

\agda{
opaque
  is-truncated←is-trunc-category
    : (n : 𝕋₋₁) {𝓤 : Level} {A : Type 𝓤}
    → is-trunc-category n A → is-truncated (𝕋←𝕋₋₁ n) A
  is-truncated←is-trunc-category n A-tcat
    = is-separated←is-hom-separated←is-complete-segal
        (Truncation-gRSubU (𝕋←suc-𝕋₋₁ n))
        (is-segal←is-trunc-category n A-tcat)
        (is-rezk-complete←is-trunc-category n A-tcat)
        (is-hom-separated←Hom∈S
          (Truncation-gSubU (𝕋←suc-𝕋₋₁ n))
          (Hom-is-truncated←is-trunc-category n A-tcat))
}
}

\subtree[stt-014E]{
\title{The universe of #{n}-truncated categories is simplicial}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-19}

\p{The universe of [#{n}-truncated categories](stt-014A) is [simplicial](stt-00AC).}

\agda{
TruncCategory-U-is-simplicial
  : (n : 𝕋₋₁) {𝓤 : Level} → is-simplicial (TruncCategory-U n 𝓤)
TruncCategory-U-is-simplicial n {𝓤}
  = is-simplicial←retract
      ( (λ (A , cat) → (A , cat , is-simplicial←is-trunc-category n cat))
      , (λ (A , cat , _) → (A , cat))
      , ~refl)
      (Null-in-gSubU-is-null←is-prop
        {𝓤 = 𝓘} {𝓥 = 𝓤}
        {P = generating-fam-is-simplicial}
        {S = TruncCategory-gSubU n}
        (generating-fam-is-simplicial-is-prop)
        (λ _ → Π-is-trunc-category {n = n}))
}
}

\subtree[stt-014F]{
\title{The homotopy #{n}-category}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Given a type #{A}, the reflection into #{n}-truncated categories #{h_n A} is called
the \em{homotopy #{n}-category}. In formalisation we write \code{ℎ n A}
(agda-input: `Mih`). The unit #{η \colon A \to h_n A} has the universal property that
precomposition induces an equivalence
##{(h_n A \to B) \simeq (A \to B)}
for every #{n}-truncated category #{B}.
}

\agda{
module _ (n : 𝕋₋₁) (open TruncCategory n) where

  ℎ : ∀ {𝓤} → Type 𝓤 → Type 𝓤
  ℎ = ○

  ℎ-is-category : ∀ {𝓤} {A : Type 𝓤} → is-category (ℎ A)
  ℎ-is-category = is-category←is-trunc-category n ○∈S

  ℎ-is-complete-segal : ∀ {𝓤} {A : Type 𝓤} → is-complete-segal (ℎ A)
  ℎ-is-complete-segal = is-complete-segal←is-trunc-category n ○∈S

  ℎ-is-simplicial : ∀ {𝓤} {A : Type 𝓤} → is-simplicial (ℎ A)
  ℎ-is-simplicial = is-simplicial←is-trunc-category n ○∈S

  ℎ-is-truncated : ∀ {𝓤} {A : Type 𝓤} → is-truncated (𝕋←𝕋₋₁ n) (ℎ A)
  ℎ-is-truncated = is-truncated←is-trunc-category n ○∈S

  ℎ-hom-is-truncated
    : ∀ {𝓤} {A : Type 𝓤} (a b : ℎ A)
      → is-truncated (𝕋←suc-𝕋₋₁ n) (Hom (ℎ A) a b)
  ℎ-hom-is-truncated = Hom-is-truncated←is-trunc-category n ○∈S

  ℎ-up≃ : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
        → is-trunc-category n B → (ℎ A → B) ≃ (A → B)
  ℎ-up≃ H = mk≃ (precomp _ η) (reflects H)
}
}

\subtree[bak-F699]{
\title{Factorisation through the homotopy #{n}-category}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-25}

\p{
Every diagram #{F \colon K \to A} in an [#{n}-truncated category](bak-02DF) extends
uniquely along #{η \colon K \to h_n K}. Precomposition also induces
equivalences on natural transformations.
}

\p{
For #{n = 1}, this is the universal property of the homotopy category in
\citet{Fact 2.3.6}{Hau25}.
}

\agda{
module _
  (n : 𝕋₋₁) {𝓤 𝓥} {K : Type 𝓤} {A : Type 𝓥}
  (𝐴 : is-trunc-category n A) (open TruncCategory n)
  where

  ℎ-factor : (K → A) → (ℎ n K → A)
  ℎ-factor = ○-rec 𝐴

  ℎ-factor-β : (F : K → A) → ℎ-factor F ∘ η ~ F
  ℎ-factor-β = ○-rec-β 𝐴

  ℎ-factorisation-unique : (F : K → A) → is-singleton (Ext η F)
  ℎ-factorisation-unique F
    = is-single←equiv
        (Σ-snd-≃ (λ _ → funext≃))
        (has-singleton-fibres←is-equiv (reflects 𝐴) F)

  ℎ-up-Hom≃
    : (F G : ℎ n K → A)
    → Hom (ℎ n K → A) F G ≃ Hom (K → A) (F ∘ η: K) (G ∘ η)
  ℎ-up-Hom≃ F G
    = mk≃ (ap-hom (precomp A η)) (is-ff'←is-equiv (reflects 𝐴))
}
}

\subtree[bak-A743]{
\title{Computing colimits in #{n}-truncated categories via homotopy diagrams}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-25}

\p{
If #{A} is an [#{n}-truncated category](bak-02DF), then restriction along
#{η \colon K \to h_n K} preserves and reflects colimits in #{A}.
}

\p{For #{n = 1}, this recovers \citet{Observation 8.6.10}{Hau25}.}

\proof{
\p{
Follows by [invariance of colimits under fully faithful restriction](bak-257F).
}
}

\agda{
module _
  (n : 𝕋₋₁) {𝓤 𝓥} {K : Type 𝓤} {A : Type 𝓥}
  (Atcat : is-trunc-category n A) (open TruncCategory n)
  (let 𝐴 = is-segal←is-trunc-category n Atcat)
  where

  ℎ-cocone≃
    : (F : ℎ n K → A) (a : A)
    → Colimit-cocone F a ≃ Colimit-cocone (F ∘ η: K) a
  ℎ-cocone≃ F
    = Colimit-cocone-restrict≃ (η: K) F (is-ff←is-equiv (reflects Atcat))

  ℎ-is-colimit↔
    : (F : ℎ n K → A) {a : A} (cc : Colimit-cocone F a)
    → Colimit.is-colimit 𝐴 F a cc
    ↔ Colimit.is-colimit 𝐴 (F ∘ η: K) a
        (restrict-Colimit-cocone (η: K) F cc)
  ℎ-is-colimit↔ F cc
    = is-colimit-restrict↔ (η: K) F (is-ff←is-equiv (reflects Atcat)) 𝐴 cc

  ℎ-factor-colimits≃
    : (F : K → A) (a : A)
    → (Σ[ cc ∶ Colimit-cocone (ℎ-factor n Atcat F) a ]
        Colimit.is-colimit 𝐴 (ℎ-factor n Atcat F) a cc)
    ≃ (Σ[ cc ∶ Colimit-cocone F a ] Colimit.is-colimit 𝐴 F a cc)
  ℎ-factor-colimits≃ F a
    = colimits-restrict≃ (η: K) (ℎ-factor n Atcat F)
        (is-ff←is-equiv (reflects Atcat)) 𝐴 a
    ∙e tr≃
        (λ D → Σ[ cc ∶ Colimit-cocone D a ] Colimit.is-colimit 𝐴 D a cc)
        (funext→ (ℎ-factor-β n Atcat F))
}
}
