\subtree[bak-A393]{
\title{The walking left homotopy projection is inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-22}

\p{
The projection of the walking left homotopy #{\Delta_{\sim} \to \Delta^1} is inner
anodyne.
}

\agda{
proj-Δ~-is-inner-anodyne : is-inner-anodyne proj-Δ~
proj-Δ~-is-inner-anodyne h orth
  = left-orthogonal-right-cancel
      (left-orthogonal-pushout₁-left {f = ι₁} (Λ[2,1]-incl , ~refl) ! h orth)
      (equiv⊥
        (is-equiv←~
          (pushout-rec-unique _ _ ~refl ~refl (λ _ → carrier-is-set _ _ _ _))
          (is-pushout←up-cocartesian _ left-unit-horn-is-pushout)) h)

proj-Δ~-is-segal-equiv : is-segal-equiv proj-Δ~
proj-Δ~-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne proj-Δ~-is-inner-anodyne

tgt-Δ~-is-segal-equiv : is-segal-equiv tgt-Δ~
tgt-Δ~-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-Δ~-is-segal-equiv Q-is-segal) id-is-equiv

src-Δ~-is-segal-equiv : is-segal-equiv src-Δ~
src-Δ~-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-Δ~-is-segal-equiv Q-is-segal) id-is-equiv
}
}

\subtree[bak-63FB]{
\title{The walking right homotopy projection is inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-23}

\p{
The projection of the walking right homotopy #{{}_{\sim}\Delta \to \Delta^1} is inner
anodyne.
}

\agda{
proj-~Δ-is-inner-anodyne : is-inner-anodyne proj-~Δ
proj-~Δ-is-inner-anodyne h orth
  = left-orthogonal-right-cancel
      (left-orthogonal-pushout₁-left {f = ι₂} (Λ[2,1]-incl , ~refl) ! h orth)
      (equiv⊥
        (is-equiv←~
          (pushout-rec-unique _ _ ~refl ~refl (λ _ → carrier-is-set _ _ _ _))
          (is-pushout←up-cocartesian _ right-unit-horn-is-pushout)) h)

proj-~Δ-is-segal-equiv : is-segal-equiv proj-~Δ
proj-~Δ-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne proj-~Δ-is-inner-anodyne

tgt-~Δ-is-segal-equiv : is-segal-equiv tgt-~Δ
tgt-~Δ-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-~Δ-is-segal-equiv Q-is-segal) id-is-equiv

src-~Δ-is-segal-equiv : is-segal-equiv src-~Δ
src-~Δ-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-~Δ-is-segal-equiv Q-is-segal) id-is-equiv
}
}

\subtree[stt-00CI]{
\title{Homotopies are an identity system for morphisms}
\taxon{Theorem}

\p{
When #{A} is Segal, both left and right homotopies are torsorial and thus form
identity systems for morphisms in #{A}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} {a b : A} (𝐴 : is-segal A) where

  opaque
    ~▵-is-torsorial : (f : Hom A a b) → is-torsorial (f ~▵_)
    ~▵-is-torsorial f
      = is-single←equiv
          (Λ[2,1]-incl-ext≃composite f (idH _))
          (segal-unique-composite 𝐴 f (idH _))

    ▵~-is-torsorial : (f : Hom A a b) → is-torsorial (f ▵~_)
    ▵~-is-torsorial f
      = is-single←equiv
          (Λ[2,1]-incl-ext≃composite (idH _) f)
          (segal-unique-composite 𝐴 (idH _) f)

  Hom-~▵-IdS : Identity-system (Hom A a b) (𝓤 ⊔ 𝓘)
  Hom-~▵-IdS .Identity-system.IdS = _~▵_
  Hom-~▵-IdS .Identity-system.IdS←Id = ~▵←＝
  Hom-~▵-IdS .Identity-system.IdS←Id-is-equiv f
    = fundamental-Id _ (~▵-is-torsorial f) _

  Hom-▵~-IdS : Identity-system (Hom A a b) (𝓤 ⊔ 𝓘)
  Hom-▵~-IdS .Identity-system.IdS = _▵~_
  Hom-▵~-IdS .Identity-system.IdS←Id = ▵~←＝
  Hom-▵~-IdS .Identity-system.IdS←Id-is-equiv f
    = fundamental-Id _ (▵~-is-torsorial f) _

  _ : is-equiv (λ (f : Hom A a b) → (f , f , refl~▵ f))
  _ = is-equiv⁻¹ (singleton-fst-is-equiv (SingS-is-single ⦃ Hom-~▵-IdS ⦄))

  _ : is-equiv (λ (f : Hom A a b) → (f , f , refl▵~ f))
  _ = is-equiv⁻¹ (singleton-fst-is-equiv (SingS-is-single ⦃ Hom-▵~-IdS ⦄))

  ~▵≃▵~ : {f g : Hom A a b} → (f ~▵ g) ≃ (f ▵~ g)
  ~▵≃▵~ {f} {g}
    = mk≃
        (Identity-system.IdS←Id Hom-▵~-IdS
        ∘ Identity-system.Id←IdS Hom-~▵-IdS)
        (is-equiv-∘
          (Identity-system.IdS←Id-is-equiv Hom-▵~-IdS f g)
          (is-equiv⁻¹ (Identity-system.IdS←Id-is-equiv Hom-~▵-IdS f g)))

  ▵~≃~▵ : {f g : Hom A a b} → (f ▵~ g) ≃ (f ~▵ g)
  ▵~≃~▵ = ~▵≃▵~ e⁻¹
}
}
