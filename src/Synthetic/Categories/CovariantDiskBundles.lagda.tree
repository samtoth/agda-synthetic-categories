\subtree[bak-C23E]{
\title{Covariant disks}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be any map, then for any diagram #{b \colon J \to B}
we may form the type of \em{covariant disks} under #{p} into #{b}, given by
#{\CovDisk_p(b)\defeq ʃ(p \downarrow b)} where #{p \downarrow b} is the
[comma type](stt-00C3) and #{ʃ} is nullification at #{Δ¹}.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) where

  Cov-disk : ∀ {𝓙} {J : Type 𝓙} → (J → B) → Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk b = Δ¹Disc.○ (p ↓ b)

  Cov-disk: : ∀ {𝓙} (J : Type 𝓙) → (J → B) → Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk: J = Cov-disk

  Cov-disk-π : ∀ {𝓙} {J : Type 𝓙} → Σ (J → B) Cov-disk → (J → B)
  Cov-disk-π = fst: Cov-disk

  Cov-disk-π: : ∀ {𝓙} (J : Type 𝓙) → Σ (J → B) Cov-disk → (J → B)
  Cov-disk-π: J = Cov-disk-π
}
}

\subtree[bak-CA79]{
\title{Transport in covariant disks}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Given a map #{p \colon E \to B} into a [Segal type](stt-00AI) #{B} and a pair of
diagrams in #{B}, #{x \colon J' \to B} and #{y \colon J \to B}, then every reindexing
map #{j₀ \colon J' \to J} equipped with a natural transformation of morphisms
#{{\Hom(x, yj₀)}} gives a transport map of comma types:
##{(p \downarrow x) \to (p \downarrow y)\nsp{,}}
and this transport map descends to covariant disks
##{\CovDisk_p(x) \to \CovDisk_p(y)\nsp{.}}
}

\p{
Moreover, this action is unital in the sense that it restricts to the identity
function when #{x} is {y}, the reindexing is the identity, and the natural
transformation is given by the identity transformation. Hence, by the
[unital transport criterion](stt-00VJ) #{\CovDisk_p} defines a covariant family.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-comma
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → p ↓ x → p ↓ y
  transport-comma j₀ f (e , i , α) = (e , j₀ i , f i ∘[ 𝐵 ] α)

  transport-Cov-disk
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → Cov-disk p x → Cov-disk p y
  transport-Cov-disk j₀ f = Δ¹Disc.○₁ (transport-comma j₀ f)

  transport-comma-unital
    : ∀ {𝓙} {J : Type 𝓙} {b : J → B}
      → transport-comma id (idH ∘ b) ~ id
  transport-comma-unital x
    = Σ-path→ (refl , (Σ-path→ (refl , ∘[ 𝐵 ]-right-unit)))

  transport-Cov-disk-unital
    : ∀ {𝓙} {J : Type 𝓙} (b : J → B)
      → transport-Cov-disk id (idH ∘ b) ~ id
  transport-Cov-disk-unital _
    = Δ¹Disc.○-~ transport-comma-unital ∙h Δ¹Disc.○₁-id

  unital-transport-Cov-disk
    : ∀ {𝓙} {J : Type 𝓙} → Covariant-unital-transport (Cov-disk: p J)
  unital-transport-Cov-disk
    = (transport-Cov-disk id ∘ Nat←Hom , transport-Cov-disk-unital)

  Cov-disk-is-covariant
    : ∀ {𝓙} {J : Type 𝓙} → is-covariant (Cov-disk p {J = J})
  Cov-disk-is-covariant
    = is-covariant←cov-unital-transport
        (λ b → Δ¹Disc.○∈S {A = p ↓ b})
        (unital-transport-Cov-disk)

  Cov-disk-π-is-left-fibration
    : ∀ {𝓙} {J : Type 𝓙} → is-left-fibration (Cov-disk-π p {J = J})
  Cov-disk-π-is-left-fibration
    = is-left-fibration←is-covariant (Cov-disk p) Cov-disk-is-covariant
}
}

\subtree[bak-E834]{
\title{Base change of covariant disks}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map into a [Segal type](stt-00AI) #{B}, and let
#{b : \Pi1{a : A}{J(a) \to B}} be a family of diagrams. If #{J} admits
[covariant lifts](bak-FEFF), then the type family #{\CovDisk_p\circ b} is covariant.
}

\proof{
\p{
TODO
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  lift-comma-along
    : (h : Δ¹ → A) (e : E) {j : J (h i0)}
    → (Σ[ j' ∶ J (h i1) ] Homᵈ (J ∘ h) j j')
    → (α : Hom B (p e) (b (h i0) j))
    → Σ[ c ∶ (p ↓ b (h i1)) ] Homᵈ (λ i → (p ↓ b (h i))) (e , j , α) c
  lift-comma-along h e (j' , mk-hom k refl refl) α
    = let (β , β-lift) = hom-fam-cov 𝐵 (p e) (λ i → b (h i) (k i)) α .centre
      in ((e , j' , β) , ap-hom (λ {i} γ → (e , k i , γ)) β-lift)

  lift-comma-base-change
    : Covariant-lifts J → Covariant-lifts (λ a → (p ↓ b a))
  lift-comma-base-change lift-J h (e , j , α)
    = lift-comma-along h e (lift-J h j) α

  transport-comma-base-change
    : Covariant-lifts J → Covariant-transport (λ a → (p ↓ b a))
  transport-comma-base-change lift-J
    = cov-transport←lifts {B = (λ a → (p ↓ b a))} (lift-comma-base-change lift-J)

  Cov-disk-base-change-is-covariant
    : Covariant-lifts J → is-covariant (Cov-disk p ∘ b)
  Cov-disk-base-change-is-covariant lift-J
    = ʃ∘-is-covariant←lifts {P = (λ a → (p ↓ b a))} (lift-comma-base-change lift-J)
}
}

\subtree[bak-E9FE]{
\title{The covariant disk bundle}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map, and #{b : \Pi1{a : A}{J(a) \to B}} a family of
diagrams in #{B}. Their total space #{\Sigma1{a : A}{\CovDisk_p(b(a))}} is the
\em{covariant disk bundle} under #{p} into #{b}. This type comes equipped with a unit
map #{\Sigma1{a : A}{p \downarrow b(a)} \to \Sigma1{a : A}{\CovDisk_p(b(a))}} which
is left anodyne, in fact it is #{Δ¹}-connected. Moreover, when #{B} is Segal and #{J}
admits covariant lifts, the bundle projection map
#{\Sigma1{a : A}{\CovDisk_p(b(a))} \to A} is a [left fibration](stt-00AV).
}

\proof{
\p{
TODO
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  Cov-disk-bundle : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓙)
  Cov-disk-bundle = Σ[ a ∶ A ] Cov-disk p (b a)

  Cov-disk-bundle-π : Cov-disk-bundle → A
  Cov-disk-bundle-π = fst

  Cov-disk-bundle-η : (Σ[ a ∶ A ] (p ↓ b a)) → Cov-disk-bundle
  Cov-disk-bundle-η = total-map (λ _ → Δ¹Disc.η)

  precomp-Cov-disk-bundle-η≃
    : ∀ {𝓧 𝓜} {X : Type 𝓧} (Y : X → Type 𝓜)
      → ((x : X) → is-Δ¹-discrete (Y x))
      → (g : Cov-disk-bundle → X)
      → Π Cov-disk-bundle (Y ∘ g)
      ≃ Π (Σ[ a ∶ A ] (p ↓ b a)) (Y ∘ g ∘ Cov-disk-bundle-η)
  precomp-Cov-disk-bundle-η≃ Y Y-is-discrete g
    =  curry≃
    ∙e postcomp-Π-≃ (λ a
        → Δ¹Disc.○-UPᵈ≃ {P = Y ∘ g ∘ (a ,_)} (Y-is-discrete ∘ g ∘ (a ,_)))
    ∙e uncurry≃

  Cov-disk-bundle-η-is-connected
    : is-connected-map Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
  Cov-disk-bundle-η-is-connected
    = is-connected-map←up-connected-map Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
        ( λ {U = Y} Y-is-discrete
          → precomp-Cov-disk-bundle-η≃ Y Y-is-discrete id ._≃_.fwd-is-equiv)

  Cov-disk-bundle-η-is-left-anodyne
    : is-left-anodyne Cov-disk-bundle-η
  Cov-disk-bundle-η-is-left-anodyne f f-is-left
    = connected⊥modal Δ¹DiscreteType-gRSubU Cov-disk-bundle-η-is-connected
        (is-Δ¹-discrete-family←is-covariant
          (is-covariant←is-left-family (fibre f)
            (are-orthogonal-fibre←are-orthogonal f-is-left)))

  ʃCov-disk-bundle≃
    : Δ¹Disc.○ (Σ[ a ∶ A ] (p ↓ b a)) ≃ Δ¹Disc.○ Cov-disk-bundle
  ʃCov-disk-bundle≃ = Σ○≃ Δ¹DiscreteType-gRSubU (λ a → p ↓ b a)

module _
  {𝓤 𝓥 𝓦 𝓙} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) (𝐵 : is-segal B) {A : Type 𝓦}
  where

  Cov-disk-bundle-π-is-left-fibration
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → Covariant-lifts J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration b lift-J
    = is-left-fibration←is-covariant
        (Cov-disk p ∘ b)
        (Cov-disk-base-change-is-covariant 𝐵 p b lift-J)

  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → is-covariant J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant b J-is-covariant
    = Cov-disk-bundle-π-is-left-fibration b
        (λ h j → J-is-covariant h j .centre)

  Cov-disk-bundle-π-at-const-fam-is-left-fibration
    : {J : Type 𝓙} (b : A → J → B)
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-at-const-fam-is-left-fibration b
    = Cov-disk-bundle-π-is-left-fibration b (λ _ j → (j , idH j))
}
}
