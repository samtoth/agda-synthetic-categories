\date{2026-08-30}
\title{Injective maps}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Foundations.InjectiveMaps where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Sigma
open import Foundations.Sets
open import Foundations.Embeddings
open import Foundations.PropExt
}
}

\subtree[fre-9001]{
\title{Injective maps}
\taxon{Definition}

\p{
A map #{f : A \to B} is \em{injective} if from #{f(x) = f(y)} it follows that
#{x = y} for any #{x\ y : A}.
}

\remark{
We usually reserve the \code{is-} prefix for propositions, but the predicate
\code{is-injective} is not in general a property for maps between non-sets.
}

\agda{
is-injective
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B) → Type (𝓤 ⊔ 𝓥)
is-injective {A = A} f = {x y : A} → f x ＝ f y → x ＝ y

injective-map
  : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓤 ⊔ 𝓥)
injective-map A B = Σ (A → B) is-injective
}
}

\subtree[fre-9002]{
\title{Embeddings are injective}
\taxon{Lemma}

\agda{
is-injective←is-embedding
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-embedding f → is-injective f
is-injective←is-embedding = unap
}
}

\subtree[fre-9003]{
\title{Sets are closed under injections and embeddings}
\taxon{Lemma}

\agda{
is-set←is-injective
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-injective f → is-set B → is-set A
is-set←is-injective {f = f} f-is-injective B-is-set
  = is-set←prop-in-Id
      (λ x y → B-is-set (f x) (f y))
      (λ _ → refl)
      (f-is-injective)

is-set←is-embedding
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-embedding f → is-set B → is-set A
is-set←is-embedding f-is-embedding
  = is-set←is-injective (is-injective←is-embedding f-is-embedding)
}
}

\subtree[fre-9004]{
\title{Injections into sets are embeddings}
\taxon{Lemma}

\agda{
is-embedding←is-injective
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-set B → is-injective f → is-embedding f
is-embedding←is-injective {f = f} B-is-set f-is-injective {x} {y}
  = is-equiv←inverse
      (is-set←is-injective f-is-injective B-is-set x y)
      (B-is-set (f x) (f y))
      (f-is-injective)
}
}
