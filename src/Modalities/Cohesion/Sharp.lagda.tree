\subtree[stt-00JF]{
\title{The Sharp modal operator}
\taxon{Definition}

\p{We define the sharp type operator to be the codata type cogenerated by the
single destructor:}

\ul{\li{#{{-}_{\sharp} : (x :^{\flat} \modsharp{A}) \to A}}}

\p{Notice that, unusually, the domain of this destructor takes a crisp element of
#{\modsharp{A}}. This can be thought of analogously to higher-inductive types
where the codomain of a constructor isn't the inductive type itself, but a
path in the type. As such, this type can be described as a modal coinductive
type.}

\p{In prose, given a crisp element #{a :^{\flat} \modsharp{A}}, we write
#{a_{\sharp}} for the destructor. We are also able to define
elements of #{\modsharp{A}} by copattern matching, where all the variables
before the copattern match on #{{-}_{\sharp}} become crisp.}

\agda{
record ⟨♯|_⟩ {𝓤} (@♯ A : Type 𝓤) : Type 𝓤 where
  constructor mod♯
  field
    @♯ counit♯ : A

open ⟨♯|_⟩ public

unit-♯ : ∀ {𝓤} {A : Type 𝓤} → A → ⟨♯| A ⟩
unit-♯ a .counit♯ = a
}
}

\subtree[stt-00JB]{
\title{Functoriality of sharp}
\taxon{Lemma}

\agda{
♯-map
  : ∀ {𝓤 𝓥} {@♯ A : Type 𝓤} {@♯ B : Type 𝓥}
    → (@♯ f : A → B) → ⟨♯| A ⟩ → ⟨♯| B ⟩
♯-map f x .counit♯ = f (x .counit♯)

♯-map-∘
  : ∀ {𝓤 𝓥 𝓦} {@♯ A : Type 𝓤} {@♯ B : Type 𝓥} {@♯ C : Type 𝓦}
      {@♯ f : B → C} {@♯ g : A → B}
    → ♯-map f ∘ ♯-map g ~ ♯-map (f ∘ g)
♯-map-∘ = ~refl

ap♯
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {a b : A} (f : @♯ A → B)
    → a ＝ b → f a ＝ f b
ap♯ f refl = refl
}
}

\subtree[stt-00J2]{
\title{Sharp types forms a reflective subuniverse}
\taxon{Lemma}

\p{We call a type codiscrete if #{\eta : A \to \modsharp{A}} is an
equivalence. The #{\sharp}-codiscrete types form a modality
(a #{\Sigma}-closed reflective subuniverse), where the reflector is given
by the #{\modsharp{{-}}} operator.}

\agda{
is-♯-codiscrete : ∀ {𝓤} → Type 𝓤 → Type 𝓤
is-♯-codiscrete A = is-equiv (unit-♯ {A = A})

unmod♯ : ∀ {𝓤} {A : Type 𝓤} → is-♯-codiscrete A → ⟨♯| A ⟩ → A
unmod♯ e = is-equiv.bwd e

⟨♯|-⟩-is-♯-codiscrete : ∀ {𝓤} {@♯ A : Type 𝓤} → is-♯-codiscrete ⟨♯| A ⟩
⟨♯|-⟩-is-♯-codiscrete = is-equiv←qinv
  ( (λ where x .counit♯ → x .counit♯ .counit♯)
  , ~refl
  , ~refl)

♯-induction
  : ∀ {𝓤} {A : Type 𝓤} (P : ⟨♯| A ⟩ → Type 𝓤) → ((a : A) → ⟨♯| P (unit-♯ a) ⟩)
    → (x : ⟨♯| A ⟩) → ⟨♯| P x ⟩
♯-induction P sec x .counit♯ = counit♯ (sec (x .counit♯))


♯-pres-Σ
  : ∀ {𝓤 𝓥} {@♯ A : Type 𝓤} {@♯ B : A → Type 𝓥}
    → ⟨♯| Σ[ a ∶ _ ] B a ⟩
    ≃ (Σ[ b ∶ ⟨♯| _ ⟩ ] ⟨♯| B (b .counit♯) ⟩)
♯-pres-Σ ._≃_.fwd x = (mod♯ (x .counit♯ .fst) , mod♯ (x .counit♯ .snd))
♯-pres-Σ ._≃_.fwd-is-equiv = is-equiv←qinv
  ( (λ x → mod♯ (x .fst .counit♯ , x .snd .counit♯))
  , ~refl
  , ~refl)


♯-SubU : ∀ {𝓤} → SubU 𝓤 𝓤
♯-SubU .Subtype.family = is-♯-codiscrete
♯-SubU .Subtype.family-is-subtype _ = is-equiv-is-prop

♯-reflectors
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → is-♯-codiscrete B
    → is-equiv (precomp B (unit-♯ {A = A}))
♯-reflectors Qdisc = is-equiv←qinv
  ( (λ f x → unmod♯ Qdisc (mod♯ (f (x .counit♯))))
  , (λ f → funext→ (λ a → is-equiv.η Qdisc (f a)))
  , (λ f → funext→ (λ a → is-equiv.η Qdisc (f a)))
  )

♯-is-reflective : ∀ {𝓤} → is-reflective (♯-SubU {𝓤})
♯-is-reflective .is-reflective.○ A = ⟨♯| A ⟩
♯-is-reflective .is-reflective.η = unit-♯
♯-is-reflective .is-reflective.η-is-reflector .is-reflector.○∈S
  = ⟨♯|-⟩-is-♯-codiscrete
♯-is-reflective .is-reflective.η-is-reflector .is-reflector.reflects
  = ♯-reflectors

＝-is-♯-codiscrete
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} → is-♯-codiscrete A → is-♯-codiscrete (a ＝ b)
＝-is-♯-codiscrete = ＝-is-modal ♯-is-reflective

♯-map-is-equiv
  : ∀ {𝓤 𝓥} {@♯ A : Type 𝓤} {@♯ B : Type 𝓥} {@♯ f : A → B}
    → @♯ is-equiv f → is-equiv (♯-map f)
♯-map-is-equiv {A = A} {B} {f} fe = is-equiv←qinv
  ( ♯-map bwd
  , ( λ where (mod♯ x) → unmod♯ (＝-is-♯-codiscrete ⟨♯|-⟩-is-♯-codiscrete)
                                (mod♯ (ap♯ mod♯ (η x))))
  ,  λ where (mod♯ x) → unmod♯ (＝-is-♯-codiscrete ⟨♯|-⟩-is-♯-codiscrete)
                               (mod♯ (ap♯ mod♯ (ε x)))) where
  @♯ bwd : B → A
  bwd = is-equiv.bwd fe

  @♯ η : (a : A) → bwd (f a) ＝ a
  η = is-equiv.η fe

  @♯ ε : (a : B) → f (bwd a) ＝ a
  ε = is-equiv.ε fe

is-♯-codiscrete←is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} → is-equiv f
    → is-♯-codiscrete A → is-♯-codiscrete B
is-♯-codiscrete←is-equiv {f = f} fe ad
  = 3-for-2'
      fe
      (is-equiv-∘ (♯-map-is-equiv fe) ad)


♯-gSubU : gSubU (λ 𝓤 → 𝓤)
♯-gSubU .gSubU.S .Subtype.family = is-♯-codiscrete
♯-gSubU .gSubU.S .Subtype.family-is-subtype _ = is-equiv-is-prop
♯-gSubU .gSubU.∈S←equiv e = is-♯-codiscrete←is-equiv (e ._≃_.fwd-is-equiv)

♯-is-globally-reflective : is-globally-reflective ♯-gSubU
♯-is-globally-reflective .is-globally-reflective.○ A = ⟨♯| A ⟩
♯-is-globally-reflective .is-globally-reflective.η = unit-♯
♯-is-globally-reflective .is-globally-reflective.η-is-reflector {_} {A}
  = grf where
  open is-global-reflector
  grf : is-global-reflector ♯-gSubU A ⟨♯| A ⟩ unit-♯
  grf .○∈S = ⟨♯|-⟩-is-♯-codiscrete
  grf .reflects = ♯-reflectors

♯-gRSubU : gRSubU (λ 𝓤 → 𝓤)
♯-gRSubU .gRSubU.GS = ♯-gSubU
♯-gRSubU .gRSubU.GS-is-globally-reflective = ♯-is-globally-reflective

open gSubU ♯-gSubU public using () renaming
  ( ∈S←equiv to is-♯-codiscrete←equiv)
open gReflectiveClosure ♯-gRSubU public using () renaming
  ( Π∈S to Π-is-♯-codiscrete
  ; ULift∈S to ULift-is-♯-codiscrete
  ; 𝟙∈S to 𝟙-is-♯-codiscrete
  ; ∈S←is-singleton to is-♯-codiscrete←is-singleton
  ; ∈S←retract to is-♯-codiscrete←retract
  ; ~∈S to ~-is-♯-codiscrete
  ; Pullback∈S to Pullback-is-♯-codiscrete
  ; fibre∈S to fibre-is-♯-codiscrete
  ; Ext∈S to Ext-is-♯-codiscrete
  ; ×∈S to ×-is-♯-codiscrete
  ; retract∈S to retract-is-♯-codiscrete
  ; biinv∈S to biinv-is-♯-codiscrete
  ; ≃∈S to ≃-is-♯-codiscrete
  ; Equaliser∈S to Equaliser-is-♯-codiscrete
  ; Seq-lim∈S to Seq-lim-is-♯-codiscrete
  ; preidempotent-map∈S to preidempotent-map-is-♯-codiscrete
  ; qidempotent-map∈S to qidempotent-map-is-♯-codiscrete
  ; idempotent-map∈S to idempotent-map-is-♯-codiscrete
  ; Retracts∈S to Retracts-is-♯-codiscrete)

opaque
  Σ-♯-codiscrete : is-globally-Σ-closed ♯-gSubU
  Σ-♯-codiscrete {A = A} {B} a b
    = is-equiv-∘ (bwd-is-equiv ♯-pres-Σ) (map-Σ-is-equiv a b) where
    _ : _≃_.bwd ♯-pres-Σ ∘ map-Σ unit-♯ (λ a → unit-♯) ~ unit-♯ {A = Σ A B}
    _ = ~refl

module ♯ where
  open gRSubU ♯-gRSubU public
  open gReflectiveClosure ♯-gRSubU public
  open gReflectiveReasoning ♯-gRSubU public
  open gRSubUInduction ♯-gRSubU Σ-♯-codiscrete public
}
}


\subtree[stt-00JT]{
\title{Characterising equality in Sharp types}
\taxon{Lemma}

\p{We define an identity system for types #{\modsharp{A}}, where for
#{a,b : \modsharp{A}},
  ##{a =^{\sharp} b := \modsharp{a_\sharp = b_\sharp}}
}

\p{Notice that we can apply #{{-}_{\sharp}} to #{a} since inside of the
#{\sharp} modal operator, all types in context become crisp.}

\proof{
\p{Using the notion of torsorial families gives us a very concise proof of this
fact. We have already established that #{\sharp} is a #{\Sigma}-closed-reflective
subuniverse, and hence preserves singletons. So:
##{
\Sigma_{b : \modsharp{A}} \modsharp{a_{\sharp} = b_{\sharp}}
\simeq \modsharp{\Sigma_{b} a_{\sharp} = b} \simeq 1
}
}
}

\p{This lemma states precisely that #{\sharp} is a [lex modality](stt-00JU).}

\agda{
_＝♯_ : ∀ {𝓤} {@♯ A : Type 𝓤} (a b : ⟨♯| A ⟩) → Type 𝓤
a ＝♯ b = ⟨♯| a .counit♯ ＝ b .counit♯ ⟩

refl♯ : ∀ {𝓤} {@♯ A : Type 𝓤} {a : ⟨♯| A ⟩} → a ＝♯ a
refl♯ .counit♯ = refl

♯-𝟙 : is-singleton ⟨♯| 𝟙 ⟩
♯-𝟙 .centre = _
♯-𝟙 .central = ~refl

♯-is-singleton
  : ∀ {𝓤} {@♯ A : Type 𝓤} → @♯ is-singleton A → is-singleton ⟨♯| A ⟩
♯-is-singleton {A = A} as
  = is-single←equiv-to-single
      (mk≃ _ (♯-map-is-equiv (bwd-is-equiv (sing≃𝟙 as))))
      ♯-𝟙

opaque
  ＝♯-is-torsorial
    : ∀ {𝓤 𝓥} {@♯ A : Type 𝓤} ⦃ @♯ _ : Identity-system A 𝓥 ⦄
      → (a : ⟨♯| A ⟩)
      → is-torsorial (λ b → ⟨♯| IdS (a .counit♯) (b .counit♯) ⟩)
  ＝♯-is-torsorial a
    = is-single←equiv-to-single
        ♯-pres-Σ
        (♯-is-singleton (SingS-is-single (a .counit♯)))

mapply♯ : ∀ {𝓤} {@♯ A : Type 𝓤} {a b : ⟨♯| A ⟩} → a ＝ b → a ＝♯ b
mapply♯ refl = refl♯

instance
  IdS-♯
    : ∀ {𝓤 𝓥} {@♯ A : Type 𝓤} ⦃ @♯ _ : Identity-system A 𝓥 ⦄
      → Identity-system ⟨♯| A ⟩ 𝓥
  IdS-♯ .Identity-system.IdS a b = ⟨♯| IdS (a .counit♯) (b .counit♯) ⟩
  IdS-♯ ⦃ A ⦄ .Identity-system.IdS←Id refl .counit♯ = IdS₀ ⦃ A ⦄
  IdS-♯ .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (＝♯-is-torsorial a) _

modext♯ : ∀ {𝓤} {@♯ A : Type 𝓤} {a b : ⟨♯| A ⟩} → a ＝♯ b → a ＝ b
modext♯ = ext!

modext♯-is-equiv
  : ∀ {𝓤} {@♯ A : Type 𝓤} {a b : ⟨♯| A ⟩} → is-equiv (modext♯ {a = a} {b})
modext♯-is-equiv = ext!-is-equiv

♯-is-lex : is-lex ♯-gRSubU Σ-♯-codiscrete modext♯
♯-is-lex {A = A} = ext!-is-equiv

module ♯Lex where
  open Lex ♯-gRSubU Σ-♯-codiscrete modext♯ ♯-is-lex public
}
}

\subtree[stt-00U6]{
\title{Sharp preserves propositions}
\author{emilyriehl}
\taxon{Lemma}

\p{The modality #{\sharp} preserves propositions.}

\agda{
♯-is-prop : ∀ {𝓤} {@♯ A : Type 𝓤} → @♯ is-prop A → is-prop ⟨♯| A ⟩
♯-is-prop f x y = modext♯ (mod♯ (f (x .counit♯) (y .counit♯)))
}
}

\subtree[stt-00JK]{
\title{Sharp is right adjoint to flat}
\taxon{Lemma}


\agda{
♭⊣ᵈ♯-transpose
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
  → ⟨♯| ((a' : ⟨♭| A ⟩) → B (ε♭ a')) ⟩ → ((a : A) → ⟨♯| B a ⟩)
♭⊣ᵈ♯-transpose f a .counit♯ = f .counit♯ (mod♭ a)

♭⊣ᵈ♯-transpose-bwd
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {@♯ B : ⟨♭| A ⟩ → Type 𝓥}
  → ((a : A) → ⟨♯| B (mod♭ a) ⟩) → ⟨♯| ((a♭ : ⟨♭| A ⟩) → B a♭) ⟩
♭⊣ᵈ♯-transpose-bwd f .counit♯ (mod♭ a) = f a .counit♯

♭⊣♯-transpose
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
  → ⟨♯| (⟨♭| A ⟩ → B) ⟩ → (A → ⟨♯| B ⟩)
♭⊣♯-transpose = ♭⊣ᵈ♯-transpose

♭⊣♯-transpose-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → is-equiv (♭⊣♯-transpose {A = A} {B = B})
♭⊣♯-transpose-is-equiv {A = A} {B} = is-equiv←qinv qinv where
  bwd : (A → ⟨♯| B ⟩) → ⟨♯| (⟨♭| A ⟩ → B) ⟩
  bwd f .counit♯ a = f (ε♭ a) .counit♯

  qinv : quasi-inv _
  qinv .fst =  bwd
  qinv .snd .fst x = ext! (mod♯ (λ where (mod♭ a) → refl))
  qinv .snd .snd x = refl

♭⊣♯ : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → ⟨♯| (⟨♭| A ⟩ → B)⟩ ≃ (A → ⟨♯| B ⟩)
♭⊣♯ = mk≃ ♭⊣♯-transpose ♭⊣♯-transpose-is-equiv

global-transpose
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| (⟨♭| A ⟩ → B)⟩ → ⟨♭| (A → ⟨♯| B ⟩)⟩
global-transpose (mod♭ f) = mod♭ (λ x → mod♯ (f (mod♭ x)))

transpose-♭←♯ : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| (A → ⟨♯| B ⟩)⟩ → ⟨♭| (⟨♭| A ⟩ → B)⟩
transpose-♭←♯ = ♭-rec (λ f → mod♭ (♭-rec λ x → (f x) .counit♯))

global-transpose-is-equiv
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → is-equiv (global-transpose {A = A} {B})
global-transpose-is-equiv = is-equiv←qinv
  ( transpose-♭←♯
  , ♭-ind (λ x → mapply♭ (mod♭ (funext→ (♭-ind (λ _ → refl)))))
  , ♭-ind λ f → refl
  )
}
}

\subtree[stt-00J4]{
\title{Sharp codiscrete and sharp connected maps}
\taxon{Definition}

\p{A map #{f : A \to B} is #{\sharp}-codiscrete if all of its fibres are.}

\agda{
is-♯-codiscrete-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓤 ⊔ 𝓥)
is-♯-codiscrete-map f = is-modal-map' ♯-SubU f
}

\p{A map is #{\sharp}-connected if all of it's fibres are #{\sharp}-connected.}

\agda{
is-♯-connected-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓤 ⊔ 𝓥)
is-♯-connected-map = is-connected-map ♯-gRSubU
}
}

\subtree{
\title{Sharp equivalences}
\taxon{Definition}

\p{A map #{f : A \to B} is a #{\sharp}-equivalence if the induced map
#{\sharp f : \mod{\sharp}{A} \to \mod{\sharp}{B}} is an equivalence.}

\agda{
is-♯-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓤 ⊔ 𝓥)
is-♯-equiv f = is-equiv (♯-map f)

is-modal-equiv←is-♯-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → {f : A → B}
    → is-♯-equiv f → is-modal-equiv ♯-gRSubU f
is-modal-equiv←is-♯-equiv {f = f}
  = is-equiv←~⁻¹
      {f = ♯-map f}
      {g = ♯.○₁ f}
      (λ x → modext♯ (λ where .counit♯ → helper {f = f} x))
  where
  helper
    : ∀ {@♭ 𝓤} {@♭ 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
        (@♭ x : ⟨♯| A ⟩)
      → f (x .counit♯)
      ＝ ♯.○₁ f x .counit♯
  helper {f = f} (mod♯ x)
    = ap♭ counit♯ (sym (♯.○₁-β f x))
}

\p{For any crisp type, the counit #{\modflat{A} \to A} is a sharp equivalence.}

\agda{
ε-is-♯-equiv : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-♯-equiv (ε♭: A)
ε-is-♯-equiv = is-equiv←qinv
  ( (λ x → mod♯ (mod♭ (x .counit♯)))
  , (λ x → modext♯ (mod♯ (helper x)))
  , ~refl) where
  helper
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} (@♭ x : ⟨♯| ⟨♭| A ⟩ ⟩)
      → mod♭ (♯-map ε♭ x .counit♯) ＝ x .counit♯
  helper (mod♯ (mod♭ x)) = refl
}
}

\subtree{
\title{Sharp connected maps are sharp equivalences}

\agda{
is-♯-connected←is-♯-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-♯-equiv f → is-♯-connected-map f
is-♯-connected←is-♯-equiv fs
  = ♯Lex.is-connected←is-modal-equiv (is-modal-equiv←is-♯-equiv fs)
}
}
