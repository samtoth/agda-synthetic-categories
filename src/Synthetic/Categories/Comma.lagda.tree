\subtree[stt-00C1]{
\title{Directed cones over a cospan}
\taxon{Definition}

\p{Given a [cospan diagram](stt-0039) #{S}, we consider the directed cones over #{S}.
This is analogous to the type of [cones over #{S}](stt-003A) but with the filler now
being a morphism, not a path.}

\agda{
record directed-cone {𝓤 𝓥 𝓦} (S : Cospan 𝓤 𝓥 𝓦) {𝓛} (Carrier : Type 𝓛)
  : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓛) where
  constructor mk-directed-cone
  open Cospan S
  field
    p : Carrier → Left
    q : Carrier → Right
    filler : ∀ (a : Carrier) → Hom Centre (left (p a)) (right (q a))
}
}

\subtree[stt-00C2]{
\title{The universal property of comma cones}
\taxon{Definition}

\p{Again analogously to undirected pullbacks, for any lax cone #{C} over a cospan
#{S}, we can define a canonical map #{(Q \to C) \to \mathrm{Cone}_S(Q)}.  We call say
that #{C} has the universal property of a comma cone when this map is an
equivalence.}

\agda{
module _ {𝓤 𝓥 𝓦} {S : Cospan 𝓤 𝓥 𝓦} {𝓛} {Carrier : Type 𝓛} where
  directed-cone-map
    : directed-cone S Carrier
    → ∀ {𝓠} {Q : Type 𝓠} → (Q → Carrier) → directed-cone S Q
  directed-cone-map cone f = mk-directed-cone (p ∘ f) (q ∘ f) (filler ∘ f) where
    open directed-cone cone

  up-comma : directed-cone S Carrier → Typeω
  up-comma cone
    = ∀ {𝓠} {Q : Type 𝓠} → is-equiv (directed-cone-map cone {𝓠} {Q})
}
}

\subtree[stt-00C3]{
\title{Canonical comma types}
\taxon{Construction}

\p{The comma type of a [cospan diagram](stt-0039) is written
#{f \downarrow g}. It can be constructed as the type:

##{\Sigma2{a : A}{c : C}{\Hom_B(f(a), g(c))}}
}


\agda{
module _ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} where

  _↓_ : (f : A → B) (g : C → B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
  f ↓ g = Σ[ a ∶ A ] Σ[ c ∶ C ] Hom B (f a) (g c)

  ↓-cone : (f : A → B) (g : C → B) → directed-cone (mk-cospan _ f g) (f ↓ g)
  ↓-cone f g = mk-directed-cone fst (fst ∘ snd) (snd ∘ snd)

  ↓-up-comma
    : {f : A → B} {g : C → B}
    → up-comma (↓-cone f g)
  ↓-up-comma = mk-eqv qinv ~refl where
    open directed-cone
    qinv : quasi-inv (directed-cone-map (↓-cone _ _))
    qinv .fst cone x = (cone .p x , cone .q x , cone .filler x)
    qinv .snd .fst = ~refl
    qinv .snd .snd = ~refl
}
}

\subtree[tot-05YD]{
\title{Comma cones}
\taxon{Definition}
\date{2026-09-29}
\author{samueltoth}

\p{For any [directed cone]() #{X} on a cospan #{C} there is a canonical map from the apex
of the cone to the comma type on #{C}, this map is called the directed gap map. We
say #{X} is a comma cone if the directed gap map is an equivalence. A directed cone
is a comma cone iff it has [the universal property of a comma cone]().}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓧} {C : Cospan 𝓤 𝓥 𝓦} {A : Type 𝓧}
  (open Cospan C)
  where

  directed-gap-map : directed-cone C A → (A → left ↓ right)
  directed-gap-map = is-equiv.bwd ↓-up-comma

  is-comma : directed-cone C A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓧)
  is-comma X = is-equiv (directed-gap-map X)

module _
  {𝓤 𝓥 𝓦 𝓧} {C : Cospan 𝓤 𝓥 𝓦} {A : Type 𝓧}
  (open Cospan C)
  where

  up-comma←is-comma
    : ∀ {X : directed-cone C A} → is-comma X → up-comma X
  up-comma←is-comma {X} X-↓ {Q = Q}
    = is-equiv-∘ ↓-up-comma (postcomp-equiv X-↓)

  is-comma←up-comma
    : ∀ {X : directed-cone C A} → up-comma X → is-comma X
  is-comma←up-comma {X} X-up-↓
    = is-equiv←postcomp (directed-gap-map X) (3-for-2 ↓-up-comma X-up-↓)
}
}

\subtree[stt-00CG]{
\title{Paths in comma types}

\agda{
Comma-path
  : ∀ {𝓤 𝓥 𝓦} {a : Type 𝓤} {b : Type 𝓥} {c : Type 𝓦}
      {f : a → b} {g : c → b}
    → (x y : f ↓ g) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓘)
Comma-path {f = F} {g = G} (a , b , f) (a' , b' , f')
  = Σ[ p ∶ a ＝ a' ] Σ[ q ∶ b ＝ b' ] Hom-pathᵈ (ap F p) (ap G q) f f'

Comma-path-refl
  : ∀ {𝓤 𝓥 𝓦} {a : Type 𝓤} {b : Type 𝓥} {c : Type 𝓦}
      {f : a → b} {g : c → b}
    → {x : f ↓ g} → Comma-path x x
Comma-path-refl = (refl , refl , Hom-pathᵈ-refl)

opaque
  Comma-path-is-torsorial
    : ∀ {𝓤 𝓥 𝓦} {a : Type 𝓤} {b : Type 𝓥} {c : Type 𝓦}
        {f : a → b} {g : c → b}
      → {x : f ↓ g} → is-torsorial (Comma-path x)
  Comma-path-is-torsorial
    = is-singleton-structure←parts
        Sing-is-singleton
        (_ , refl)
        (is-singleton-structure←parts
          Sing-is-singleton
          (_ , refl)
          Hom-pathᵈ-is-torsorial)

instance
  IdS-Comma
    : ∀ {𝓤 𝓥 𝓦} {a : Type 𝓤} {b : Type 𝓥} {c : Type 𝓦}
        {F : a → b} {G : c → b} → Identity-system (F ↓ G) (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
  IdS-Comma .Identity-system.IdS = Comma-path
  IdS-Comma .Identity-system.IdS←Id refl = Comma-path-refl
  IdS-Comma .Identity-system.IdS←Id-is-equiv x
    = fundamental-Id _ Comma-path-is-torsorial _
}
}

\subtree[stt-00CF]{
\title{Comma types are functorial in their cospan}
\taxon{Construction}


\agda{
Comma₀ : ∀ {𝓤 𝓥 𝓦} → Cospan 𝓤 𝓥 𝓦 → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓘)
Comma₀ C = left ↓ right where open Cospan C

Comma₁
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Cospan 𝓤 𝓥 𝓦} {T : Cospan 𝓤' 𝓥' 𝓦'}
    → Cospan-map S T → Comma₀ S → Comma₀ T
Comma₁ F (x , y , h)
  = (h₁ x , h₃ y , adjust-hom (H x) (K y) (ap-hom h₂ h))
  where open Cospan-map F

Comma-id
  : ∀ {𝓤 𝓥 𝓦} {S : Cospan 𝓤 𝓥 𝓦}
    → Comma₁ (id-cospan-map {S = S}) ~ id
Comma-id (x , y , f) = ext!
  (refl , refl
  , (~refl
    , Square-degen-vert _ _ (∙-reflr _ ∙ ap-id _)
    , Square-degen-vert _ _ (∙-reflr _ ∙ ap-id _)))

Comma-∘
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓤'' 𝓥'' 𝓦''}
      {A : Cospan 𝓤 𝓥 𝓦} {B : Cospan 𝓤' 𝓥' 𝓦'} {C : Cospan 𝓤'' 𝓥'' 𝓦''}
      (F : Cospan-map B C) (G : Cospan-map A B)
    → Comma₁ (cospan-map-compose F G) ~ Comma₁ F ∘ Comma₁ G
Comma-∘ F G (x , y , f) = ext!
  (refl , refl
  , ( ~refl
    , (Square-degen-vert _ _
        (∙.pullr _
          {a = ap (F .h₂) (G .H x)}
          {b = ap (F .h₂ ∘ G .h₂) (f .hom0)}
          {c = ap (F .h₂) _}
          (ap (_∙ ap (F .h₂) (G .H x)) (ap-∘ (F .h₂) (G .h₂) (f .hom0))
          ∙ sym (ap-∙ (F .h₂) _ (G .H x)))))
    , Square-degen-vert _ _
        (∙.pullr _
          {a = ap (h₂ F) (G .K y)}
          {b = ap (F .h₂ ∘ G .h₂) (f .hom1)}
          {c = ap (F .h₂) (ap (G .h₂) _ ∙ G .K y)}
          ((ap (_∙ ap (F .h₂) (G .K y)) (ap-∘ (F .h₂) (G .h₂) (f .hom1))
          ∙ sym (ap-∙ (F .h₂) _ (G .K y)))))))
  where
  open Cospan-map
  open Homᵈ
}
}

\subtree[stt-00CJ]{
\title{Functoriality of the slice construction}
\taxon{Corollary}

\p{The functoriality of the (co)slice construction is somewhat
more subtle to express. The operation #{-_{/-}} can be considered a functor
#{(\Sigma1{A : \UU}{(\UU_{/A})^{\op}}) \to \UU}. In the first argument, we can express
functoriality as follows: given a map #{f \colon A \to B}, there is a function
#{f_{/p} \colon A_{/p} \to B_{/fp}}. In the second argument, we fix a type #{A},
and consider a pair of arrows into #{A}, #{p} and #{q}. Now a
[map in the slice](Core.Slices) #{t \colon p \to q} determines a function #{A_{/q} \to A_{/p}}
(note the contravariance). We also provide a bespoke function for the trivial
slice map, for any #{t \colon K \to L}, we have #{(pt \xrightarrow{t} p) \mapsto
#{A_{/p} \to A_{/pt}}}, we also
refer to this as (co)slice postcomposition.}

\agda{
-- postcompose-slice
--   : ∀ {𝓤 𝓥 𝓚} {A : Type 𝓤} {K : Type 𝓚} (p : K → A)
--       {B : Type 𝓥} (f : A → B)
--     → Slice A p → Slice B (f ∘ p)
-- postcompose-slice p f (a , h) = (f a , ap-hom f ∘ h)

-- postcompose-coslice
--   : ∀ {𝓤 𝓥 𝓚} {A : Type 𝓤} {K : Type 𝓚} (p : K → A)
--       {B : Type 𝓥} (f : A → B)
--     → Coslice A p → Coslice B (f ∘ p)
-- postcompose-coslice p f (a , h) = (f a , ap-hom f ∘ h)

-- slice-map-slice
--   : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
--       {K : Type 𝓚} (p : K → A)
--       {K' : Type 𝓚'} (q : K' → A)
--       (t : Slice-map p q)
--     → Slice A q → Slice A p
-- slice-map-slice p q (t , H) (a , h) = (a , adjust-hom refl (H _) ∘ h ∘ t)

-- precompose-slice
--   : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
--       {K : Type 𝓚} (p : K → A)
--       {K' : Type 𝓚'} (t : K' → K)
--     → Slice A p → Slice A (p ∘ t)
-- precompose-slice p t (a , h) = (a , h ∘ t)

-- coslice-map-slice
--   : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
--       {K : Type 𝓚} (p : K → A)
--       {K' : Type 𝓚'} (q : K' → A)
--       (t : Slice-map q p)
--     → Coslice A p → Coslice A q
-- coslice-map-slice p q (t , H) (a , h) = (a , adjust-hom (H _) refl ∘ h ∘ t)

-- precompose-coslice
--   : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
--       {K : Type 𝓚} (p : K → A)
--       {K' : Type 𝓚'} (t : K' → K)
--     → Coslice A p → Coslice A (p ∘ t)
-- precompose-coslice p t (a , h) = (a , h ∘ t)
}
}
