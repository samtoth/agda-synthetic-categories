\title{Bottom elements of posets}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-22}
\import{stt-macros}

\agda{
module Algebra.Order.BottomElements where

open import Axioms.FunExt
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Algebra.Poset
}
}

\subtree[bak-FCC3]{
\title{Bottom elements}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
A \em{bottom element} of a [poset](stt-00TJ) is an element #{b} such that
#{b \le x} for every element #{x}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  is-bottom-element : A → Type (𝓤 ⊔ 𝓥)
  is-bottom-element b = (x : A) → b ≤ x

  bottom-element : Type (𝓤 ⊔ 𝓥)
  bottom-element = Σ[ b ∶ A ] is-bottom-element b
}
}

\subtree[bak-0B1C]{
\title{Being a bottom element is a property}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  is-bottom-element-is-prop : {b : A} → is-prop (is-bottom-element P b)
  is-bottom-element-is-prop = Π-is-prop (λ _ → ≤-is-prop)
}
}

\subtree[bak-35EB]{
\title{Bottom elements are unique}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
Any two [bottom elements](bak-FCC3) are equal by antisymmetry. Since being a
bottom element is a property, the type of bottom elements is a proposition.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  bottom-element-unique
    : {b c : A} → is-bottom-element P b → is-bottom-element P c → b ＝ c
  bottom-element-unique b-is-bottom c-is-bottom
    = ≤-antisym (b-is-bottom _) (c-is-bottom _)

  bottom-element-is-prop : is-prop (bottom-element P)
  bottom-element-is-prop (b , b-is-bottom) (c , c-is-bottom)
    = Subtype.subtype-path
        (mk-subtype (λ _ → is-bottom-element-is-prop P))
        (bottom-element-unique b-is-bottom c-is-bottom)
}
}
