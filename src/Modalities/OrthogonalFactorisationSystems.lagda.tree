\subtree[stt-004V]{
\title{Orthogonal factorisation systems}
\contributor{fredrikbakke}
\taxon{Definition}

\agda{
record OFS 𝓤 𝓥 : Type (lsuc (𝓤 ⊔ 𝓥)) where
  field
    Ll Rr : WideSubcatType 𝓤 𝓥
  open WideSubcatType Ll public using () renaming
    ( K to L; ≃∈K to ≃∈L; id∈K to id∈L; _∘∈K_ to _∘∈L_)
  open WideSubcatType Rr public using () renaming
    ( K to R; ≃∈K to ≃∈R; id∈K to id∈R; _∘∈K_ to _∘∈R_)

  field
    factorisation-is-singleton
      : {A B : Type 𝓤} (f : A → B)
      → is-singleton (Factorisation Ll Rr f)

  factorisation
    : {A B : Type 𝓤} (f : A → B) → Factorisation Ll Rr f
  factorisation f = factorisation-is-singleton f .centre
}
}
