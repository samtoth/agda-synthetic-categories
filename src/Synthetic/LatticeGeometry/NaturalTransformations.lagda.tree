\title{Natural Transformations}
\date{2025-12-09}
\taxon{Module}
\author{samueltoth}

\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.LatticeGeometry.NaturalTransformations
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Ergonomics.Extensionality

open import Synthetic.Hom Δ¹ i0 i1
}
}

\subtree[stt-00D0]{
\title{Natural transformations}
\taxon{Definition}

\p{Given a pair of (dependent) functions #{f, g : \Pi1{a : A}{B(a)}}, the
type of natural transformations is nothing but the fibrewise morphisms
#{\Pi1{a : A}{\Hom_{B(a)}(f(a), g(a))}}.}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} where

  infixr 5 _⇒_
  _⇒_ : (f g : Π A B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  f ⇒ g = (a : A) → 𝐇om (B a) (f a) (g a)
}
}

\subtree[stt-00QQ]{
\title{Displayed natural transformations over natural transformations}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-05-07}

\agda{
𝐍at-over
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {f g : Π A B}
    → (C : (a : A) → B a → Type 𝓦)
    → f ⇒ g
    → ((a : A) → C a (f a))
    → ((a : A) → C a (g a))
    → Type (𝓘 ⊔ 𝓤 ⊔ 𝓦)
𝐍at-over C H f' g' = ∀ a → 𝐇om-over {B = C a} (H a) (f' a) (g' a)
}
}

\subtree[stt-00PE]{
\title{Natural transformations over constant families}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-07}

\p{
For a constant family of target types, dependent natural transformations over a
base transformation are equivalent to ordinary natural transformations in the
constant fibre.
}

\agda{
module _
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥} {C : Type 𝓦} {f g : Π A B} {f' g' : A → C}
  where

  𝐍at-over-const≃𝐍at
    : (H : f ⇒ g) → 𝐍at-over (λ _ _ → C) H f' g' ≃ (f' ⇒ g')
  𝐍at-over-const≃𝐍at H = Π-fam-≃ (λ a → 𝐇om-over-const≃𝐇om (H a))

  𝐍at←𝐍at-over-const
    : (H : f ⇒ g) → 𝐍at-over (λ _ _ → C) H f' g' → f' ⇒ g'
  𝐍at←𝐍at-over-const H α a = 𝐇om←𝐇om-over-const (H a) (α a)
}
}

\subtree[stt-00PC]{
\title{Equality of natural transformations}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-07}

\p{
Equality between natural transformations is determined by a pointwise equality of
morphisms.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} {f g : Π A B} where

  𝐍at-path
    : (α β : f ⇒ g) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  𝐍at-path α β = ∀ a → 𝐇om-path (α a) (β a)

  𝐍at-path-refl
    : {α : f ⇒ g} → 𝐍at-path α α
  𝐍at-path-refl a = 𝐇om-path-refl

  𝐍at-path-is-torsorial
    : (α : f ⇒ g) → is-singleton (Σ[ β ∶ f ⇒ g ] 𝐍at-path α β)
  𝐍at-path-is-torsorial α
    = is-single←equiv
        (Σ-Π-swap≃ (λ a → 𝐇om (B a) (f a) (g a)) (λ a → 𝐇om-path (α a)))
        (Π-is-single λ a → 𝐇om-path-is-torsorial (α a))

  instance
    IdS-𝐍at
      : Identity-system (f ⇒ g) (𝓘 ⊔ 𝓤 ⊔ 𝓥)
    IdS-𝐍at .Identity-system.IdS = 𝐍at-path
    IdS-𝐍at .Identity-system.IdS←Id refl = 𝐍at-path-refl
    IdS-𝐍at .Identity-system.IdS←Id-is-equiv α
      = fundamental-Id (𝐍at-path α) (𝐍at-path-is-torsorial α) _

  𝐍at-ext→
    : {α β : f ⇒ g} → 𝐍at-path α β → α ＝ β
  𝐍at-ext→ = ext!
}
}

\subtree[stt-00PB]{
\title{Horizontal composition}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-05-07}

\p{
Given natural transformations #{H \colon f \Rightarrow g} and #{H' \colon f' \Rightarrow g'}
where #{f,g \colon A \to B} and #{f',g' \colon B \to C}, then there is a
\em{horizontal composite}
#{H' \mathbin{\square} H \colon f' \circ f \Rightarrow g' \circ g}.
}

\agda{
_◻𝐍at_
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f g : A → B} {f' g' : B → C}
  → f' ⇒ g' → f ⇒ g → (f' ∘ f) ⇒ (g' ∘ g)
_◻𝐍at_ H' H a .𝐡om i
  = H' (H a .𝐡om i) .𝐡om i
_◻𝐍at_ {f' = f'} H' H a .𝐡om0
  = H' (H a .𝐡om i0) .𝐡om0
  ∙ ap f' (H a .𝐡om0)
_◻𝐍at_ {g' = g'} H' H a .𝐡om1
  = H' (H a .𝐡om i1) .𝐡om1
  ∙ ap g' (H a .𝐡om1)

_◻𝐍atᵈ_
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {C : (a : A) → B a → Type 𝓦}
      {f g : Π A B} {f' g' : (a : A) → Π (B a) (C a)}
    → ((a : A) → _⇒_ {B = C a} (f' a) (g' a))
    → (H : f ⇒ g)
    → 𝐍at-over C H (λ a → f' a (f a)) (λ a → g' a (g a))
_◻𝐍atᵈ_ H' H a .𝐡om i
  = H' a (H a .𝐡om i) .𝐡om i
_◻𝐍atᵈ_ {f' = f'} H' H a .𝐡om0
  = H' a (H a .𝐡om i0) .𝐡om0
  ∙ apᶠ-sym (f' a) (H a .𝐡om0)
_◻𝐍atᵈ_ {g' = g'} H' H a .𝐡om1
  = H' a (H a .𝐡om i1) .𝐡om1
  ∙ apᶠ-sym (g' a) (H a .𝐡om1)

◻𝐍at＝◻𝐍atᵈ-const
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f g : A → B} {f' g' : B → C}
    → (H' : f' ⇒ g') (H : f ⇒ g)
    → H' ◻𝐍at H
    ＝ 𝐍at←𝐍at-over-const H ((λ _ → H') ◻𝐍atᵈ H)
◻𝐍at＝◻𝐍atᵈ-const  {B = B} {C = C} {f' = f'} {g' = g'} H' H
  = 𝐍at-ext→ λ a →
    ( ~refl
    , lemma f'
        (H' (H a .𝐡om i0) .𝐡om0)
        (H a .𝐡om0)
    , lemma g'
        (H' (H a .𝐡om i1) .𝐡om1)
        (H a .𝐡om1))
    where
      lemma
        : (F : B → C) {x y : B} {z : C}
        → (q : z ＝ F x) (p : x ＝ y)
        → (q ∙ apᶠ-sym F p) ∙ tr-constant (sym p) (F y)
        ＝ q ∙ ap F p
      lemma F refl refl = refl
}
}

\subtree[stt-00C6]{
\title{Homs in #{Π}-types are natural transformations}
\taxon{Theorem}

\p{This is function extensionality for hom types, except unlike for Identity
types, since Hom types are corepresented by an interval, this is a trivial theorem
and not an axiom.}

\agda{
𝐇om←𝐍at
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} {f g : Π A B}
    → f ⇒ g → 𝐇om (Π A B) f g
𝐇om←𝐍at α .𝐡om i a = α a .𝐡om i
𝐇om←𝐍at α .𝐡om0 = funext→ (λ a → α a .𝐡om0)
𝐇om←𝐍at α .𝐡om1 = funext→ (λ a → α a .𝐡om1)

𝐍at←𝐇om
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} {f g : Π A B}
    → 𝐇om (Π A B) f g
    → f ⇒ g
𝐍at←𝐇om α a .𝐡om i = α .𝐡om i a
𝐍at←𝐇om α a .𝐡om0 = happly (α .𝐡om0) a
𝐍at←𝐇om α a .𝐡om1 = happly (α .𝐡om1) a

𝐍at≃𝐇om
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      {f g : Π A B}
    → 𝐇om (Π A B) f g ≃ (f ⇒ g)
𝐍at≃𝐇om = mk≃ 𝐍at←𝐇om (is-equiv←qinv qinv) where
  qinv : quasi-inv 𝐍at←𝐇om
  qinv .fst = 𝐇om←𝐍at
  qinv .snd .fst (mk-𝐡om hom hom0 hom1)
    = 𝐇om-ext→ (~refl , sym (funext.η hom0) , sym (funext.η hom1))
  qinv .snd .snd α = funext→ λ a → 𝐇om-ext→
    ( ~refl
    , sym (happly funext-redex a)
    , sym (happly funext-redex a))
}
}
