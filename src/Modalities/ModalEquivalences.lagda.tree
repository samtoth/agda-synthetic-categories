\date{2026-03-19}
\title{Modal equivalences}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Modalities.ModalEquivalences where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Modalities.ReflectiveSubuniverses
open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.ModalMaps
open import Core.Arrows
open import Core.ArrowRetracts
open import Core.Orthogonal
open import Core.ArrowEquiv
}
}

\subtree[stt-00MS]{
\taxon{Definition}
\title{Universal property of modal equivalences}
\author{fredrikbakke}

\p{
Given a global subuniverse #{K} and a map #{f : A \to B}, then #{f} is a
#{K}-\em{equivalence} if for every type #{U} in #{K},
the precomposition map #{U^f} is an equivalence.
}

\p{We use the abbreviation \code{up} for "universal property".}

\agda{
up-modal-equiv
  : ∀ {α 𝓤 𝓥} (K : gSubU α)
    → {A : Type 𝓤} {B : Type 𝓥}
    → (A → B)
    → Typeω
up-modal-equiv K f
  = ∀ {𝓚} {U : Type 𝓚}
  → U ∈ gSubU.S K
  → is-equiv (precomp U f)

is-modal-equiv
  : ∀ {α 𝓤 𝓥} (K : gRSubU α) → {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓤 ⊔ 𝓥)
is-modal-equiv K f = is-equiv (gReflectiveReasoning.○₁ K f)
}
}

\subtree{
\date{2026-03-19}
\author{fredrikbakke}
\taxon{Lemma}
\title{3-for-2 for modal equivalences}

\p{
#{K}-equivalences satisfy the 3-for-2 property. Given a commuting triangle of
#{K}-equivalences, if two of the three maps are #{K}-equivalences then so is the
third.
}

\agda{
up-modal-equiv-∘
  : ∀ {α 𝓤 𝓥 𝓦}
      (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      (f : A → B) (g : B → C)
    → up-modal-equiv K f
    → up-modal-equiv K g
    → up-modal-equiv K (g ∘ f)
up-modal-equiv-∘ K f g fe ge U∈K
  = is-equiv-∘ (fe U∈K) (ge U∈K)

up-modal-equiv-right-cancel
  : ∀ {α 𝓤 𝓥 𝓦}
      (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      (f : A → B) (g : B → C)
    → up-modal-equiv K f
    → up-modal-equiv K (g ∘ f)
    → up-modal-equiv K g
up-modal-equiv-right-cancel K f g fe gfe U∈K
  = 3-for-2 (fe U∈K) (gfe U∈K)

up-modal-equiv-left-cancel
  : ∀ {α 𝓤 𝓥 𝓦}
      (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      (f : A → B) (g : B → C)
    → up-modal-equiv K g
    → up-modal-equiv K (g ∘ f)
    → up-modal-equiv K f
up-modal-equiv-left-cancel K f g ge gfe U∈K
  = 3-for-2' (ge U∈K) (gfe U∈K)
}
}

\subtree{
\date{2026-03-19}
\author{fredrikbakke}
\taxon{Lemma}
\title{#{K}-equivalences are closed under retracts of arrows}

\p{
If #{f} is a retract of #{g} as an arrow, and #{g} is a #{K}-equivalence,
then so is #{f}.
}

\agda{
up-modal-equiv←Arrow-incoherent-retract
  : ∀ {α 𝓤 𝓥 𝓦 𝓛}
      (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      {X : Type 𝓦} {Y : Type 𝓛} {g : X → Y}
    → Arrow-incoherent-retract f g
    → up-modal-equiv K g
    → up-modal-equiv K f
up-modal-equiv←Arrow-incoherent-retract K R ge U∈K
  = is-equiv←Arrow-incoherent-retract
      (precomp-Arrow-incoherent-retract R _)
      (ge U∈K)

up-modal-equiv←Arrow-retract
  : ∀ {α 𝓤 𝓥 𝓦 𝓛}
      (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      {X : Type 𝓦} {Y : Type 𝓛} {g : X → Y}
    → Arrow-retract f g
    → up-modal-equiv K g
    → up-modal-equiv K f
up-modal-equiv←Arrow-retract K R
  = up-modal-equiv←Arrow-incoherent-retract K (incoherent←Arrow-retract R)
}
}

\subtree{
\date{2026-03-19}
\author{fredrikbakke}
\taxon{Lemma}
\title{Modal equivalences with local domain and codomain}

\p{
If a #{K}-equivalence has both domain and codomain in #{K}, then it is an actual
equivalence.
}

\agda{
is-equiv←up-modal-equiv-domain-codomain
  : ∀ {α 𝓤 𝓥} (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B)
    → A ∈ gSubU.S K
    → B ∈ gSubU.S K
    → up-modal-equiv K f
    → is-equiv f
is-equiv←up-modal-equiv-domain-codomain K f A∈K B∈K feq
  = is-equiv←equiv-precomp-dom-cod (feq A∈K) (feq B∈K)
}
}

\subtree{
\date{2026-03-19}
\author{fredrikbakke}
\contributor{samueltoth}
\taxon{Module}
\title{Modal equivalences, given reflections of domains}

\p{
If #{f : A \to B} is a map between types with #{K}-reflections, then we say #{f} is
a #{K}-equivalence if its reflection is an equivalence.
}

\agda{
module gReflectorModalEquivalences
  {α 𝓤 𝓥} {GS : gSubU α}
  {A : Type 𝓤} {B : Type 𝓥}
  (RA : gReflector GS A)
  (RB : gReflector GS B)
  (open gSubU GS)
  (let module A = gReflector RA)
  (let module B = gReflector RB)
  (let module F = gReflectorMap RA RB)
  where

  is-modal-equiv-reflectors
    : (A → B) → Type (𝓤 ⊔ 𝓥)
  is-modal-equiv-reflectors f = is-equiv (F.○₁ f)

  precomp-○₁-arrow-equiv
    : (f : A → B) → ∀ {𝓚} {U : Type 𝓚}
    → U ∈ S → Arrow-equiv (precomp U (F.○₁ f)) (precomp U f)
  precomp-○₁-arrow-equiv f {U = U} U∈S
    = ( mk-amap (precomp U B.η) (precomp U A.η)
          (λ h → funext→ λ a → ap h (F.○₁-β f a))
      , B.reflects U∈S , A.reflects U∈S)

  precomp-○₁-is-equiv←up-modal-equiv
    : (f : A → B)
    → up-modal-equiv GS f
    → ∀ {𝓚} {U : Type 𝓚}
    → U ∈ S
    → is-equiv (precomp U (F.○₁ f))
  precomp-○₁-is-equiv←up-modal-equiv f feq U∈S
    = src-is-equiv←Arrow-equiv (precomp-○₁-arrow-equiv f U∈S) (feq U∈S)

  is-modal-equiv-reflectors←up-modal-equiv
    : (f : A → B)
    → up-modal-equiv GS f
    → is-modal-equiv-reflectors f
  is-modal-equiv-reflectors←up-modal-equiv f feq
    = is-equiv←equiv-precomp-dom-cod
        (precomp-○₁-is-equiv←up-modal-equiv f feq A.○∈S)
        (precomp-○₁-is-equiv←up-modal-equiv f feq B.○∈S)

  up-modal-equiv←is-modal-equiv-reflectors
    : (f : A → B)
    → is-modal-equiv-reflectors f
    → up-modal-equiv GS f
  up-modal-equiv←is-modal-equiv-reflectors f feq U∈S
    = tgt-is-equiv←Arrow-equiv (precomp-○₁-arrow-equiv f U∈S) (precomp-equiv feq)

module _ {α} (RS : gRSubU α) where

  is-modal-equiv←up-modal-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      → up-modal-equiv (gRSubU.GS RS) f
      → is-modal-equiv RS f
  is-modal-equiv←up-modal-equiv {A = A} {B = B} {f = f}
    = gReflectorModalEquivalences.is-modal-equiv-reflectors←up-modal-equiv
        (gReflector←gRSubU RS A)
        (gReflector←gRSubU RS B)
        f

  up-modal-equiv←is-modal-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      → is-modal-equiv RS f
      → up-modal-equiv (gRSubU.GS RS) f
  up-modal-equiv←is-modal-equiv {A = A} {B = B} {f = f}
    = gReflectorModalEquivalences.up-modal-equiv←is-modal-equiv-reflectors
        (gReflector←gRSubU RS A)
        (gReflector←gRSubU RS B)
        f
}
}

\subtree[bak-D6B9]{
\title{Closure properties of modal equivalences}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-12}

\p{
Modal equivalences contain equivalences and modal units, and are closed under
3-for-2.
}

\agda{
module _
  {α} (RS : gRSubU α)
  (open gRSubU RS)
  (open gReflectiveReasoning RS)
  where

  is-modal-equiv←is-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-equiv f → is-modal-equiv RS f
  is-modal-equiv←is-equiv = is-equiv-○₁

  η-is-modal-equiv
    : ∀ {𝓤} {A : Type 𝓤} → is-modal-equiv RS (η: A)
  η-is-modal-equiv = is-modal-equiv←up-modal-equiv RS reflects

  is-modal-equiv-∘
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : A → B} {g : B → C}
    → is-modal-equiv RS f → is-modal-equiv RS g → is-modal-equiv RS (g ∘ f)
  is-modal-equiv-∘ {f = f} {g} fe ge = is-equiv-~∘ (○₁-∘ g f) ge fe

  is-modal-equiv-left-cancel
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : A → B} {g : B → C}
    → is-modal-equiv RS g → is-modal-equiv RS (g ∘ f) → is-modal-equiv RS f
  is-modal-equiv-left-cancel {f = f} {g} = 3-for-2~ (○₁-∘ g f)

  is-modal-equiv-right-cancel
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : A → B} {g : B → C}
    → is-modal-equiv RS f → is-modal-equiv RS (g ∘ f) → is-modal-equiv RS g
  is-modal-equiv-right-cancel {f = f} {g} = 3-for-2~' (○₁-∘ g f)
}
}
