\subtree[tot-A0CE]{
\title{Cocone types}
\taxon{Definition}
\date{2026-09-25}

\p{Given a diagram #{\phi \colon \mathcal{K} \to A}, the type of #{D}-shaped \em{cocones}
at some element #{a : A} is given by a natural transformation #{D \Rightarrow \const_a}.
We write #{A_{\phi / }} for the type consisting of a point and a cocone under that point.
 This type comes with a canonical projection to #{A} which
we call the \em{nadir} map.}

\remark{
\p{In code we write \code{𝑪ocone ϕ} for #{A_{ϕ / }} with a \strong{M}ath
\strong{I}talic bold \strong{𝑪} (agda-input: \code{MIC}) to differentiate it from
the ordinary notion of a [cocone of types under a span](stt-0016).}
}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  𝑪ocone-under : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝑪ocone-under a = Hom (K → A) ϕ (const a)

  𝑪ocone-under' : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝑪ocone-under' a = ∀ (k : K) → Hom A (ϕ k) a

  𝑪ocone : Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝑪ocone = Σ A 𝑪ocone-under

  𝑪ocone' : Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝑪ocone' = Σ A 𝑪ocone-under'

  𝑪ocone-at≃ : ∀ a → 𝑪ocone-under a ≃ 𝑪ocone-under' a
  𝑪ocone-at≃ a = Nat≃Hom

  𝑪ocone≃ : 𝑪ocone ≃ 𝑪ocone'
  𝑪ocone≃ = Σ-snd-≃ 𝑪ocone-at≃

  nadir←𝑪ocone : 𝑪ocone → A
  nadir←𝑪ocone = fst
}
}

\subtree[tot-9923]{
\title{The nadir map as a base change}
\taxon{Lemma}
\date{2026-09-25}

\p{The nadir map #{A_{ϕ/} \to A} is a base change of the slice map
#{(A^\mathcal{K})_{ϕ/} \to A^{\mathcal{K}}} by the diagonal map
#{A \to A^{\mathcal{K}}}.}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  Coslice-proj←nadir : Arrow-map (nadir←𝑪ocone ϕ) (Coslice-proj: ϕ)
  Coslice-proj←nadir .Arrow-Π.top (a , h) = (h .Homᵈ.hom , h .Homᵈ.hom0)
  Coslice-proj←nadir .Arrow-Π.bot = const
  Coslice-proj←nadir .Arrow-Π.comm (a , h) = sym (h .Homᵈ.hom1)

  opaque
    nadir-base-change-of-Coslice-proj : is-cartesian Coslice-proj←nadir
    nadir-base-change-of-Coslice-proj a
      = is-equiv←~
          (λ where (_ , refl) → fibre-path→ (refl , sym sym-sym ∙ sym (∙-reflr _)))
          (eqv ._≃_.fwd-is-equiv)
      where

      eqv : fibre (nadir←𝑪ocone ϕ) a ≃ fibre (Coslice-proj: ϕ) (const a)
      eqv ._≃_.fwd ((a , h) , refl) = ((h .Homᵈ.hom , h .Homᵈ.hom0) , h .Homᵈ.hom1)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .fst ((f , p) , q) = ((a , mk-hom f p q) , refl)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .fst (_ , refl) = refl
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .snd = ~refl
      eqv ._≃_.fwd-is-equiv .is-equiv.coherent (_ , refl) = refl
}
}

\subtree[tot-18CI]{
\taxon{Lemma}
\title{Cocones as comma types}
\date{2026-09-25}

\p{For any map #{\phi \colon K \to A}, the cocone #{A_{ \phi / }} is equivalent to the
comma type of the span #{\{ \phi \} \to A^K \leftarrow A}.}

\agda{
𝑪ocone-directed-cone
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {K : Type 𝓥}
      (ϕ : K → A)
    → directed-cone (mk-cospan (K → A) (point ϕ) (const: A K)) (𝑪ocone ϕ)
𝑪ocone-directed-cone F .directed-cone.p = !
𝑪ocone-directed-cone F .directed-cone.q (a , _) = a
𝑪ocone-directed-cone F .directed-cone.filler (_ , α) = α

𝑪ocone-has-up-comma
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} (F : I → C)
    → up-comma (𝑪ocone-directed-cone F)
𝑪ocone-has-up-comma F .is-equiv.qinv .fst cone x = (cone .directed-cone.q x , cone .directed-cone.filler x)
𝑪ocone-has-up-comma F .is-equiv.qinv .snd .fst = ~refl
𝑪ocone-has-up-comma F .is-equiv.qinv .snd .snd = ~refl
𝑪ocone-has-up-comma F .is-equiv.coherent = ~refl
}
}

\subtree[tot-AYC1]{
\title{Identity types of cocones}
\taxon{Lemma}
\date{2026-09-25}

\agda{
𝑪ocone-Id
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → 𝑪ocone F → 𝑪ocone F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
𝑪ocone-Id a b
  = Σ[ p ∶ (a .fst ＝ b .fst) ]
       (Hom-pathᵈ refl (ap const p) (a .snd) (b .snd))

𝑪ocone'-Id
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → 𝑪ocone' F → 𝑪ocone' F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
𝑪ocone'-Id a b
  = Σ[ p ∶ (a .fst ＝ b .fst) ]
       (∀ i → Hom-pathᵈ refl p (a .snd i) (b .snd i))

𝑪ocone-Id-refl
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → (p : 𝑪ocone F) → 𝑪ocone-Id p p
𝑪ocone-Id-refl a = (refl , Hom-pathᵈ-refl)

𝑪ocone'-Id-refl
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → (p : 𝑪ocone' F) → 𝑪ocone'-Id p p
𝑪ocone'-Id-refl a = (refl , λ _ → Hom-pathᵈ-refl)

opaque
  𝑪ocone-Id-is-torsorial
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → (F : 𝑪ocone F) → is-torsorial (𝑪ocone-Id F)
  𝑪ocone-Id-is-torsorial F
    = is-singleton-structure←parts
        Sing-is-singleton
        (_ , refl)
        (SingS-is-single ⦃ Hom-IdSᵈ ⦄ _)

opaque
  𝑪ocone'-Id-is-torsorial
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → (F : 𝑪ocone' F) → is-torsorial (𝑪ocone'-Id F)
  𝑪ocone'-Id-is-torsorial F
    = is-singleton-structure←parts
        Sing-is-singleton
        (_ , refl)
        (SingS-is-single ⦃ IdS-Π ⦃ Hom-IdSᵈ ⦄ ⦄ _)

instance
  𝑪ocone-IdS
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → Identity-system (𝑪ocone F) (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  𝑪ocone-IdS .Identity-system.IdS = 𝑪ocone-Id
  𝑪ocone-IdS .Identity-system.IdS←Id refl = 𝑪ocone-Id-refl _
  𝑪ocone-IdS .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (𝑪ocone-Id-is-torsorial a) _

instance
  𝑪ocone'-IdS
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → Identity-system (𝑪ocone' F) (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  𝑪ocone'-IdS .Identity-system.IdS = 𝑪ocone'-Id
  𝑪ocone'-IdS .Identity-system.IdS←Id refl = 𝑪ocone'-Id-refl _
  𝑪ocone'-IdS .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (𝑪ocone'-Id-is-torsorial a) _

opaque
  𝑪ocone-Id→
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝑪ocone F}
      → 𝑪ocone-Id x y → x ＝ y
  𝑪ocone-Id→ = Id←IdS ⦃ 𝑪ocone-IdS ⦄

  𝑪ocone-Id-is-equiv
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝑪ocone F}
      → is-equiv (𝑪ocone-Id→ {x = x} {y})
  𝑪ocone-Id-is-equiv
    = is-equiv⁻¹ (𝑪ocone-IdS .Identity-system.IdS←Id-is-equiv _ _)

  𝑪ocone-Id-ap-fst
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C} {a b : 𝑪ocone F}
      → (p : 𝑪ocone-Id a b) → ap fst (𝑪ocone-Id→ p) ＝ fst p
  𝑪ocone-Id-ap-fst
    = IdSJ ⦃ 𝑪ocone-IdS ⦄ (λ x → ap fst (Id←IdS (x .snd)) ＝ fst (x .snd))
           (ap (ap fst) (Id←IdS←Id refl))

  𝑪ocone'-Id→
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝑪ocone' F}
      → 𝑪ocone'-Id x y → x ＝ y
  𝑪ocone'-Id→ = Id←IdS ⦃ 𝑪ocone'-IdS ⦄

  𝑪ocone'-Id-is-equiv
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝑪ocone' F}
      → is-equiv (𝑪ocone'-Id→ {x = x} {y})
  𝑪ocone'-Id-is-equiv
    = is-equiv⁻¹ (𝑪ocone'-IdS .Identity-system.IdS←Id-is-equiv _ _)

  𝑪ocone'-Id-ap-fst
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C} {a b : 𝑪ocone' F}
      → (p : 𝑪ocone'-Id a b) → ap fst (𝑪ocone'-Id→ p) ＝ fst p
  𝑪ocone'-Id-ap-fst
    = IdSJ ⦃ 𝑪ocone'-IdS ⦄ (λ x → ap fst (Id←IdS (x .snd)) ＝ fst (x .snd))
           (ap (ap fst) (Id←IdS←Id refl))
}
}

\subtree[tot-000C]{
\title{Cocone and coslice types}
\taxon{Lemma}
\date{2026-09-25}

\p{The cocone of a point #{C_{c/}} is equivalent to the coslice #{C_{c/}}.}

\agda{
𝑪ocone'-point≃Coslice
  : ∀ {𝓤} {A : Type 𝓤} (a : A)
    → 𝑪ocone' (point a) ≃ Coslice a
𝑪ocone'-point≃Coslice a = Σ-snd-≃ (λ b → unit-UP≃) ∙e Coslice-hom-repr≃ a
}
}

\subtree[tot-0001]{
\title{Functoriality of cocones under a fixed type}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-26}

\p{Fixing a type #{A}, taking cocones under #{A} determines a functor from
#{\Type_{/A} \to \Type}.}

\agda{
𝑪ocone₁
  : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
      {K : Type 𝓚} {p : K → A}
      {K' : Type 𝓚'} {q : K' → A}
      (t : Slice-map q p)
    → 𝑪ocone' p → 𝑪ocone' q
𝑪ocone₁ {p = p} {q = q} (f , H)
  = total-map
      λ a
      → postcomp-Π (λ k' → adjust-hom (H k') refl)
      ∘ precomp-Π (λ k → Hom _ (p k) a) f
}
}
