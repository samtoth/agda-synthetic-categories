\date{2025-04-18}
\taxon{Module}
\title{Equivalences of pre(post)-composed functions}
\author{samueltoth}
\import{stt-macros}


\agda{
open import Foundations.FunExt

module Foundations.CompositionEquiv (FE : FunExt-global) where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
open import Foundations.Singletons
open import Foundations.Functions
open import Foundations.Sigma
open import Foundations.Identity
open import Foundations.Homotopy
open import Foundations.FunctionInverses
open import Foundations.SingletonFibres
open import Foundations.EquivHomotopy
open import Foundations.3for2
open import Foundations.DependentIdentity
open import Foundations.Embeddings
open import Foundations.Unit
open import Foundations.UnitUP
}
}

\subtree[stt-000O]{
\taxon{Lemma}

% HoTT 4.2.8 \citet{4.2.8}{HoTT}

\p{
If #{f} has a quasi-inverse, then so do
##{f \circ {-} : (A \to B) \to (A \to C)}
and
##{{-} \circ f : (B \to C) \to (A \to C).}
}

\proof{
\agda{
postcomp-ret
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {C : Type 𝓦}
    → retraction f → retraction (postcomp C f)
postcomp-ret (g , r) = (g ∘_ , λ h → WithFunExtω.funext→ FE (r ▹h h))

postcomp-qinv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {C : Type 𝓦}
    → quasi-inv f → quasi-inv {B = C → B} (f ∘_)
postcomp-qinv {f = f} (g , ret , sec) = (g ∘_) , ret∘ , sec∘ where
  sec∘ : section-witness (_∘_ f) (g ∘_)
  sec∘ h  = WithFunExtω.funext→ FE (sec ▹h h)

  ret∘ : retraction-witness (_∘_ f) (g ∘_)
  ret∘ h = WithFunExtω.funext→ FE (ret ▹h h)

postcomp-equiv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      {f : A → B} {C : Type 𝓦}
    → is-equiv f → is-equiv {B = C → B} (f ∘_)
postcomp-equiv eq = is-equiv←qinv (postcomp-qinv (qinv←is-equiv eq))

postcomp-≃
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} (e : A ≃ B) {X : Type 𝓦}
    → (X → A) ≃ (X → B)
postcomp-≃ (mk≃ f e) = mk≃ (f ∘_) (postcomp-equiv e)

postcomp-Π-qinv
  : ∀ {𝓤 𝓥 𝓦} {C : Type 𝓦}
      {A : C → Type 𝓤} {B : C → Type 𝓥}
      {f : ∀ {c} → A c → B c}
    → (∀ {q} → quasi-inv (f {q}))
    → quasi-inv {A = ∀ c → A c} {B = ∀ c → B c} (f ∘_)
postcomp-Π-qinv {f = f} eq = (λ g c → eq .fst (g c)) , ret , sec where
   ret : retraction-witness (λ g a → f (g a)) (λ g c → eq .fst (g c))
   ret f = WithFunExtω.funext→ FE (λ c → eq .snd .fst (f c))

   sec : section-witness  (λ g a → f (g a)) (λ g c → eq .fst (g c))
   sec g = WithFunExtω.funext→ FE (λ c → eq .snd .snd (g c))

postcomp-Π-equiv
  : ∀ {𝓤 𝓥 𝓦} {C : Type 𝓦}
      {A : C → Type 𝓤} {B : C → Type 𝓥}
      {f : ∀ {c} → A c → B c}
    → (∀ {q} → is-equiv (f {q}))
    → is-equiv {A = ∀ c → A c} {B = ∀ c → B c} (f ∘_)
postcomp-Π-equiv eq = is-equiv←qinv (postcomp-Π-qinv (qinv←is-equiv eq))

postcomp-Π-≃
  : ∀ {𝓤 𝓥 𝓦} {C : Type 𝓦}
      {A : C → Type 𝓤} {B : C → Type 𝓥}
    → (∀ c → A c ≃ B c)
    → Π C A ≃ Π C B
postcomp-Π-≃ peq = mk≃ _ (postcomp-Π-equiv λ {a} → peq a ._≃_.fwd-is-equiv)

postcomp-Π-↔
  : ∀ {𝓤 𝓥 𝓦} {C : Type 𝓦}
      {A : C → Type 𝓤} {B : C → Type 𝓥}
    → (∀ c → A c ↔ B c)
    → Π C A ↔ Π C B
postcomp-Π-↔ f .fst = postcomp-Π (fst ∘ f)
postcomp-Π-↔ f .snd = postcomp-Π (snd ∘ f)

precomp-qinv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {C : Type 𝓦}
    → quasi-inv f → quasi-inv {B = A → C} (_∘ f)
precomp-qinv {f = f} (g , η , ε) = (_∘ g) , η∘ , ε∘ where
  η∘ : retraction-witness (_∘ f) (_∘ g)
  η∘ h = WithFunExtω.funext→ FE (h ◃h ε)

  ε∘ : section-witness (_∘ f) (_∘ g)
  ε∘ h = WithFunExtω.funext→ FE (h ◃h η)

precomp-equiv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {C : Type 𝓦}
    → is-equiv f → is-equiv {B = A → C} (_∘ f)
precomp-equiv eq = is-equiv←qinv (precomp-qinv (qinv←is-equiv eq))


precomp-≃
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} (e : A ≃ B) {C : Type 𝓦}
    → (B → C) ≃ (A → C)
precomp-≃ (mk≃ f e) = mk≃ (_∘ f) (precomp-equiv e)

precomp-Π-qinv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : B → Type 𝓦}
      {f : A → B}
    → is-equiv f
    → quasi-inv (precomp-Π C f)
precomp-Π-qinv {C = C} {f} (mk-eqv (g , η , ε) coh)
  = ((λ h b → tr C (ε b) (h (g b)))
  , (λ h → WithFunExtω.funext→ FE λ b → apᶠ h (ε b))
  , λ h → WithFunExtω.funext→ FE λ a → ap (λ x → tr C x (h (g (f a)))) (sym (coh a))
                                     ∙ sym ( tr∘ C f (η a) {h (g (f a))})
                                     ∙ apᶠ h (η a))

precomp-Π-is-equiv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : B → Type 𝓦}
      {f : A → B}
    → is-equiv f
    → is-equiv (precomp-Π C f)
precomp-Π-is-equiv = is-equiv←qinv ∘ precomp-Π-qinv

precomp-Π-≃
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} (C : B → Type 𝓦)
    → (e : A ≃ B)
    → Π B C ≃ (Π A (C ∘ e ._≃_.fwd))
precomp-Π-≃ C (mk≃ f e) = mk≃ (precomp-Π C f) (precomp-Π-is-equiv e)

precomp-Π-retraction←section
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      {f : A → B} {U : B → Type 𝓦}
    → section f
    → retraction (precomp-Π U f)
precomp-Π-retraction←section {f = f} {U = U} (s , sec)
  = r , ret where
  r : Π _ (U ∘ f) → Π _ U
  r h b = tr U (sec b) (h (s b))

  ret : r ∘ precomp-Π U f ~ id
  ret h = WithFunExtω.funext→ FE λ b → apᶠ h (sec b)

fibred-const
  : ∀ {𝓤 𝓥 𝓦}
      {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B)
      (U : Type 𝓦)
    → (B → U)
    → Π B (λ b → fibre f b → U)
fibred-const f U h b _ = h b

fibred-const-retraction←section
  : ∀ {𝓤 𝓥 𝓦}
      {A : Type 𝓤} {B : Type 𝓥}
      {f : A → B}
      (U : Type 𝓦)
    → section f
    → retraction (fibred-const f U)
fibred-const-retraction←section {B = B} {f = f} U (s , sec)
  = r , ~refl where
  r : Π _ (λ b → fibre f b → U) → B → U
  r k b = k b (s b , sec b)

is-equiv-const←precomp-!
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {U : Type 𝓥}
    → is-equiv (precomp U (!: A))
    → is-equiv (const: U A)
is-equiv-const←precomp-! peq
  = is-equiv-∘ peq point-is-equiv

is-equiv-precomp-!←const
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {U : Type 𝓥}
    → is-equiv (const: U A)
    → is-equiv (precomp U (!: A))
is-equiv-precomp-!←const = 3-for-2' point-is-equiv

is-equiv-const↔precomp-!
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {U : Type 𝓥}
    → is-equiv (const: U A)
    ↔ is-equiv (precomp U (!: A))
is-equiv-const↔precomp-! = (is-equiv-precomp-!←const , is-equiv-const←precomp-!)
}
}
}

\subtree[stt-003N]{
\taxon{Theorem}
\title{Equivalences from composition equivalences}

\p{We can extend this to show that the following are equivalent:}

\ul{
\li{#{f : A \to B} is an equivalence}
\li{#{{-} \circ f} is an equivalence}
\li{#{f \circ {-}} is an equivalence}
}

\agda{
is-equiv←precomp
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    → (H : ∀ {𝓦} {X : Type 𝓦} → is-equiv {B = A → X} (_∘ f))
    → is-equiv f
is-equiv←precomp f H = is-equiv←qinv qinv where
  module e {𝓦} {X : Type 𝓦} = is-equiv (H {𝓦} {X})

  qinv : quasi-inv f
  qinv .fst = e.bwd id
  qinv .snd .fst = happly (e.ε id)
  qinv .snd .snd = happly
    (ap fst (is-prop←is-single (has-singleton-fibres←is-equiv H f)
      (f ∘ e.bwd id , ap (f ∘_) (e.ε id)) (id , refl)))


is-equiv←postcomp
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (f : A → B)
    → (H : ∀ {𝓦} {X : Type 𝓦} → is-equiv {B = X → B} (f ∘_))
    → is-equiv f
is-equiv←postcomp f H = is-equiv←qinv qinv where
  module e {𝓦} {X : Type 𝓦} = is-equiv (H {𝓦} {X})

  qinv : quasi-inv f
  qinv .fst = e.bwd id
  qinv .snd .fst = happly
    (ap fst
      (is-prop←is-single (has-singleton-fibres←is-equiv H f)
                         (e.bwd id ∘ f , ap (_∘ f) (e.ε id))
                         (id , refl)))
  qinv .snd .snd = happly (e.ε id)
}
}

\subtree[stt-00IN]{
\date{2026-03-10}
\author{fredrikbakke}
\title{Equivalences from precomposition at the domain and codomain}
\taxon{Theorem}

\p{
We can deduce that a map #{f : A \to B} is an [equivalence](stt-001U) from conditions
on its precomposition maps at its domain and codomain:

\ul{
\li{If #{A^f} and #{B^f} are equivalences then #{f} is an equivalence.}
}
More generally,
\ul{
\li{If #{A^f} has a section and #{B^f} is an embedding then #{f} is an equivalence.}
}
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  retraction←section-precomp-dom
    : section (precomp A f)
    → retraction f
  retraction←section-precomp-dom sec
    = (sec .fst id , happly (sec .snd id))

  retraction←is-equiv-precomp-dom
    : is-equiv (precomp A f)
    → retraction f
  retraction←is-equiv-precomp-dom eq
    = retraction←section-precomp-dom (is-equiv.section-fwd eq)

  is-equiv←embedding-precomp-cod←retraction
    : retraction f
    → is-embedding (precomp B f)
    → is-equiv f
  is-equiv←embedding-precomp-cod←retraction (r , ret) pre
    = is-equiv←qinv (r , ret , happly (unap pre (WithFunExtω.funext→ FE (f ◃h ret))))

  is-equiv←embedding-precomp-cod←section-precomp-dom
    : section (precomp A f)
    → is-embedding (precomp B f)
    → is-equiv f
  is-equiv←embedding-precomp-cod←section-precomp-dom sec
    = is-equiv←embedding-precomp-cod←retraction
        (retraction←section-precomp-dom sec)

  is-equiv←equiv-precomp-dom-cod
    : is-equiv (precomp A f)
    → is-equiv (precomp B f)
    → is-equiv f
  is-equiv←equiv-precomp-dom-cod feq geq
    = is-equiv←embedding-precomp-cod←section-precomp-dom
        (is-equiv.section-fwd feq)
        (is-embedding←is-equiv geq)
}
}
