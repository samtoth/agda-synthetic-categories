\title{Modal maps}
\author{samueltoth}
\date{2025-05-10}
\taxon{Module}

\import{stt-macros}

\agda{
module Modalities.ModalMaps  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Modalities.ReflectiveSubuniverses
open import Modalities.GlobalReflectiveSubuniverses
}
}

\subtree[stt-0045]{
\taxon{Definition}

\p{Given a [subuniverse](stt-003Z) #{S}, we say that a map of
functions is in #{S} when all its fibres are in #{S}.}

\agda{
is-modal-map'
  : ∀ {𝓤 𝓥 𝓜} {A : Type 𝓤} {B : Type 𝓥}
      (S : SubU (𝓤 ⊔ 𝓥) 𝓜)
    → (A → B) → Type (𝓥 ⊔ 𝓜)
is-modal-map' S f = ∀ b → fibre f b ∈ S

is-modal-map
  : ∀ {α 𝓤 𝓥} (K : gSubU α)
      {A : Type 𝓤} {B : Type 𝓥}
    → (A → B) → Type (α (𝓤 ⊔ 𝓥) ⊔ 𝓥)
is-modal-map K = is-modal-map' (gSubU.S K)

is-modal←is-modal-!
  : ∀ {𝓤 𝓜} {A : Type 𝓤}
      (S : SubU 𝓤 𝓜)
    → is-modal-map' S (!: A) → A ∈ S
is-modal←is-modal-! S f
  = tr (_∈ S)
       (ua (Σ-singleton (λ _ → ＝-is-single←is-prop (λ _ _ → refl) tt tt)))
       (f tt)
}
}

\subtree[stt-00ZK]{
\title{Equivalences are modal}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-12}

\agda{
module _
  {𝓤 𝓥 𝓜} {S : SubU (𝓤 ⊔ 𝓥) 𝓜}
  (RS : is-reflective S) (open is-reflective RS)
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  where

  is-modal-map'←is-equiv : is-equiv f → is-modal-map' S f
  is-modal-map'←is-equiv fe b
    = in-SubU←η-retraction (reflector _)
        (retraction←singleton-dom (has-singleton-fibres←is-equiv fe b) η)

is-modal-map←is-equiv
  : ∀ {α 𝓤 𝓥} (RS : gRSubU α) {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  → is-equiv f → is-modal-map (gRSubU.GS RS) f
is-modal-map←is-equiv RS = is-modal-map'←is-equiv (is-reflective←gRSubU RS)
}
}

\subtree[stt-00ZL]{
\title{Composition of modal maps in #{Σ}-closed subuniverses}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-12}

\agda{
module _
  {𝓤 𝓜} {S : SubU 𝓤 𝓜} (SΣ : is-Σ-closed S)
  {A B C : Type 𝓤} {f : A → B} {g : B → C}
  where

  is-modal-map'-∘
    : is-modal-map' S f → is-modal-map' S g → is-modal-map' S (g ∘ f)
  is-modal-map'-∘ fm gm c
    = tr (_∈ S) (ua (fibre-∘ c e⁻¹)) (SΣ (gm c) (fm ∘ fst))

module _
  {α} {GS : gSubU α} (SΣ : is-globally-Σ-closed GS)
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
  {f : A → B} {g : B → C}
  where

  is-modal-map-∘
    : is-modal-map GS f → is-modal-map GS g → is-modal-map GS (g ∘ f)
  is-modal-map-∘ fm gm c
    = gSubU.∈S←equiv GS (fibre-∘ c e⁻¹) (SΣ (gm c) (fm ∘ fst))
}
}
