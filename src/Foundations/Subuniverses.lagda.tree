\title{Subuniverses}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-08}
\import{stt-macros}

\agda{
module Foundations.Subuniverses where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Subtypes
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.FunctionInverses
open import Foundations.Equivalences
}
}

\subtree[stt-003Z]{
\taxon{Definition}
\title{Subuniverse}
\author{samueltoth}

\p{A subuniverse is a subtype of some universe.}

\agda{
SubU : ∀ (𝓤 𝓥 : Level) → Type (lsuc (𝓤 ⊔ 𝓥))
SubU 𝓤 𝓥 = Subtype (Type 𝓤) 𝓥
}
}

\subtree[stt-004U]{
\date{2025-06-04}
\taxon{Definition}
\title{#{Σ}-closed subuniverses}
\author{samueltoth}

\p{
A subuniverse \SS is \em{#{Σ}-closed} when given
#{A : \UU} and #{B : A \to \UU} such that #{A \in \SS} and #{B(a) \in \SS}
for all #{a : A}, the type #{\Sigma_{(a : A)}B(a)} is in \SS.
}

\agda{
is-Σ-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-Σ-closed {𝓤} S
  = {A : Type 𝓤} {B : A → Type 𝓤}
  → A ∈ S → ((a : A) → B a ∈ S)
  → (Σ[ a ∶ A ] B a) ∈ S
}
}

\subtree[stt-00XQ]{
\title{Indexed product closed subuniverses}
\taxon{Definition}
\author{fredrikbakke}

\p{
A subuniverse is \em{indexed product closed} if it is closed under any indexed
product. This is different from #{\Pi}-closure, which would only ask that the
subuniverse is closed under indexed products over types in the subuniverse.
}

\agda{
is-indexed-product-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-indexed-product-closed {𝓤} S
  = {A : Type 𝓤} {B : A → Type 𝓤}
  → ((a : A) → B a ∈ S)
  → Π A B ∈ S
}
}


\subtree[stt-00Y6]{
\title{Retract closed subuniverses}
\taxon{Definition}
\author{fredrikbakke}

\agda{
is-retract-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-retract-closed {𝓤} S
  = {A B : Type 𝓤} → A ∈ S → (i : B → A) → retraction i → B ∈ S
}
}

\subtree[stt-00Y0]{
\title{Equivalence closed subuniverses}
\taxon{Definition}
\author{fredrikbakke}

\agda{
is-equiv-closed : ∀ {𝓤 𝓥} (S : SubU 𝓤 𝓥) → Type (lsuc 𝓤 ⊔ 𝓥)
is-equiv-closed {𝓤} S = {B C : Type 𝓤} → B ≃ C → B ∈ S → C ∈ S
}
}
