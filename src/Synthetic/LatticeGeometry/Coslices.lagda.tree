}
}

\subtree[tot-10Q6]{
\title{Functoriality of the coslice construction}
\taxon{Construction}
\date{2026-09-22}
\author{samueltoth}

\p{The coslice construction determines a functor #{\Type_* \to \Type}.}

\agda{
module _ (open Type∗) (open map∗) where

  𝐂oslice₀ : ∀ {𝓤} → Type∗ 𝓤 → Type (𝓘 ⊔ 𝓤)
  𝐂oslice₀ A = 𝐂oslice (A .Type∗.pt)

  𝐂oslice₁ : ∀ {𝓤 𝓥} {A : Type∗ 𝓤} {B : Type∗ 𝓥} → map∗ A B → 𝐂oslice₀ A → 𝐂oslice₀ B
  𝐂oslice₁ (mk-map∗ f p) = map-Σ (postcomp Δ¹ f) (λ g → (_∙ p) ∘ ap f)

  𝐂oslice-id : ∀ {𝓤} {A : Type∗ 𝓤} → 𝐂oslice₁ (id∗ A) ~ id: (𝐂oslice₀ A)
  𝐂oslice-id x = fibre-path→ (refl , (sym (∙-reflr _ ∙ ap-id _)))

  𝐂oslice-∘
    : ∀ {𝓤 𝓥 𝓦} {A : Type∗ 𝓤} {B : Type∗ 𝓥} {C : Type∗ 𝓦}
        {f : map∗ B C} {g : map∗ A B}
      → 𝐂oslice₁ (f ∘∗ g) ~ 𝐂oslice₁ f ∘ 𝐂oslice₁ g
  𝐂oslice-∘ {f = f} {g} h
    = fibre-path→
        ( refl
        , ap (_∙ f .pres-pt)
            ( ap-∙ (f .hom) _ (g .pres-pt)
            ∙ ap (_∙ ap (f .hom) (g .pres-pt)) (sym (ap-∘ (f .hom) (g .hom) (h .snd))))
        ∙ ∙-assoc (ap (f .hom ∘ g .hom) (h .snd)) (ap (f .hom) (g .pres-pt)) (f .pres-pt))
}
}
