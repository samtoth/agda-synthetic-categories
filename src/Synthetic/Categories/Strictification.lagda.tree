\title{Strictification of categories}
\date{2026-03-24}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.Strictification
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Categories.Precategories Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.LeftSegal Δ¹ I
open import Synthetic.Categories.CovariantHomFamilies Δ¹ I
open import Synthetic.Categories.AlgebraicLaws Δ¹ I
open import Synthetic.Categories.Yoneda Δ¹ I

open import Wild.Categories.Structure
open CompPrestructure using (Homʷ ; idʷ: ; compʷ:)
}
}

\subtree[stt-00SQ]{
\title{The covariant Yoneda [composition prestructure](stt-00SL)}
\taxon{Definition}
\author{fredrikbakke}

\p{
Given an arbitrary type #{A}, we define the covariant Yoneda
[homomorphism system](stt-00SK) on #{A} and the associated composition prestructure.
I.e., we equip every type with a binary "Hom"-family defined by
##{\Hom^\mathrm{y}_A(a,b) \defeq \Pi1{z : A}{\Hom_A(b,z) \to \Hom_A(a,z)}}
where #{\Hom_A} is the synthetic homomorphism family, an identity morphism family
given by the identity function and composition binary operator given by
postcomposition.
}

\agda{
module _ {𝓤 : Level} {A : Type 𝓤} where

  𝐇omʸ : A → A → Type (𝓘 ⊔ 𝓤)
  𝐇omʸ a b = (z : A) → 𝐇om A b z → 𝐇om A a z

  idHʸ : {a : A} → 𝐇omʸ a a
  idHʸ _ = id

  _∘ʸ_ : {a b c : A} → 𝐇omʸ b c → 𝐇omʸ a b → 𝐇omʸ a c
  (g ∘ʸ f) z h = f z (g z h)

  precompʸ
    : {a b : A} (c : A) (f : 𝐇omʸ a b)
    → 𝐇omʸ b c → 𝐇omʸ a c
  precompʸ c f = _∘ʸ f

  postcompʸ
    : {b c : A} (a : A) (h : 𝐇omʸ b c)
    → 𝐇omʸ a b → 𝐇omʸ a c
  postcompʸ a h = h ∘ʸ_

  ∘ʸ-left-unit
    : {a b : A} (f : 𝐇omʸ a b) → idHʸ ∘ʸ f ＝ f
  ∘ʸ-left-unit _ = refl

  ∘ʸ-right-unit
    : {a b : A} (f : 𝐇omʸ a b) → f ∘ʸ idHʸ ＝ f
  ∘ʸ-right-unit _ = refl

  ∘ʸ-assoc
    : {a b c d : A} (h : 𝐇omʸ c d) (g : 𝐇omʸ b c) (f : 𝐇omʸ a b)
    → (h ∘ʸ g) ∘ʸ f ＝ h ∘ʸ (g ∘ʸ f)
  ∘ʸ-assoc _ _ _ = refl

  ∘ʸ-pentagon
    : {a b c d e : A}
      (k : 𝐇omʸ d e) (h : 𝐇omʸ c d) (g : 𝐇omʸ b c) (f : 𝐇omʸ a b)
    → ap (_∘ʸ f) (∘ʸ-assoc k h g)
    ∙ ∘ʸ-assoc k (h ∘ʸ g) f
    ∙ ap (k ∘ʸ_) (∘ʸ-assoc h g f)
    ＝ ∘ʸ-assoc (k ∘ʸ h) g f
    ∙ ∘ʸ-assoc k h (g ∘ʸ f)
  ∘ʸ-pentagon _ _ _ _ = refl

  𝐇om←𝐇omʸ : {a b : A} → 𝐇omʸ a b → 𝐇om A a b
  𝐇om←𝐇omʸ {b = b} α = α b (idH b)

  idH←𝐇omʸ : {a : A} → 𝐇om←𝐇omʸ idHʸ ＝ idH a
  idH←𝐇omʸ = refl

  𝐇omʸ-comp-prestruct : CompPrestructure (𝓘 ⊔ 𝓤) A
  𝐇omʸ-comp-prestruct .Homʷ = 𝐇omʸ
  𝐇omʸ-comp-prestruct .idʷ: a = idHʸ
  𝐇omʸ-comp-prestruct .compʷ: _ _ _ = _∘ʸ_
}

\p{
Note that for not-necessarily-Segal types the Yoneda homomorphism system need not be
a homomorphism system in a formal sense, but we show in [[stt-00LL]] that it is in
fact formally a homomorphism system for Segal types.
}
}

\subtree[stt-00LL]{
\title{Characterising the action of the covariant Yoneda embedding on homomorphisms in Segal types}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-03-24}

\p{
Given a [Segal](stt-00AI) type #{A}, then using the [Yoneda lemma](stt-00LK) we
show that composition of morphisms in #{A} is [equivalent](stt-001U), in a coherent
way, to composition of families of functions
#{\Pi1{z : A}{\left(\Hom_A(b, z) \to \Hom_A(a, z)\right)}}, and composition of
families of functions is strictly associative and two-sided unital.
}

\agda{
module YonedaStrictify
  {𝓤 : Level} {A : Type 𝓤} (𝐴 : is-segal A)
  where

  𝐇omʸ←𝐇om : {a b : A} → 𝐇om A a b → 𝐇omʸ a b
  𝐇omʸ←𝐇om f z h = h ∘[ 𝐴 ] f

  𝐇om←𝐇omʸ-ret
    : {a b : A} (f : 𝐇om A a b) → 𝐇om←𝐇omʸ (𝐇omʸ←𝐇om f) ＝ f
  𝐇om←𝐇omʸ-ret f = ∘[ 𝐴 ]-right-unit {f}

  𝐇omʸ←𝐇om-is-equiv
    : {a b : A} → is-equiv (𝐇omʸ←𝐇om {a} {b})
  𝐇omʸ←𝐇om-is-equiv {a}
    = Yoneda-coe-is-equiv 𝐴
        (𝐇om A a)
        (hom-fam-cov 𝐴 a)
        (𝐇omʸ←𝐇om)
        (𝐇om←𝐇omʸ-ret)

  𝐇om≃𝐇omʸ : (a b : A) → 𝐇om A a b ≃ 𝐇omʸ a b
  𝐇om≃𝐇omʸ a b = mk≃ 𝐇omʸ←𝐇om 𝐇omʸ←𝐇om-is-equiv

  𝐇om←𝐇omʸ-sec
    : {a b : A} (α : 𝐇omʸ a b) → 𝐇omʸ←𝐇om (𝐇om←𝐇omʸ α) ＝ α
  𝐇om←𝐇omʸ-sec {a}
    = Yoneda-coe-η
        𝐴
        (𝐇om A a)
        (hom-fam-cov 𝐴 a)
        (𝐇omʸ←𝐇om)
        (𝐇om←𝐇omʸ-ret)

  𝐇omʸ←idH
    : {a : A} → 𝐇omʸ←𝐇om (idH a) ＝ idHʸ
  𝐇omʸ←idH {a} = funext→ λ z → funext→ λ h → ∘[ 𝐴 ]-left-unit {h}

  𝐇omʸ←∘
    : {a b c : A} (g : 𝐇om A b c) (f : 𝐇om A a b)
    → 𝐇omʸ←𝐇om (g ∘[ 𝐴 ] f) ＝ 𝐇omʸ←𝐇om g ∘ʸ 𝐇omʸ←𝐇om f
  𝐇omʸ←∘ g f = funext→ λ z → funext→ λ h → sym (∘-assoc 𝐴 h g f)

  ∘←𝐇omʸ
    : {a b c : A} (g : 𝐇omʸ b c) (f : 𝐇omʸ a b)
    → 𝐇om←𝐇omʸ g ∘[ 𝐴 ] 𝐇om←𝐇omʸ f ＝ 𝐇om←𝐇omʸ (g ∘ʸ f)
  ∘←𝐇omʸ {a} {b} {c} g f
    = ap (λ F → F c (𝐇om←𝐇omʸ g)) (𝐇om←𝐇omʸ-sec f)

  𝐇omʸ←∘-nat-right
    : {a b c : A} {g g' : 𝐇om A b c} (p : g ＝ g') (f : 𝐇om A a b)
    → 𝐇omʸ←∘ g f ∙ ap (λ j → j ∘ʸ 𝐇omʸ←𝐇om f) (ap 𝐇omʸ←𝐇om p)
    ＝ ap 𝐇omʸ←𝐇om (ap (_∘[ 𝐴 ] f) p) ∙ 𝐇omʸ←∘ g' f
  𝐇omʸ←∘-nat-right {g = g} {g'} p f
    = 𝐇omʸ←∘ g f ∙ ap (λ j → j ∘ʸ 𝐇omʸ←𝐇om f) (ap 𝐇omʸ←𝐇om p)
          ＝⟨ ap (𝐇omʸ←∘ g f ∙_) (sym (ap-∘ (λ j → j ∘ʸ 𝐇omʸ←𝐇om f) 𝐇omʸ←𝐇om p)) ⟩
      𝐇omʸ←∘ g f ∙ ap ((λ j → j ∘ʸ 𝐇omʸ←𝐇om f) ∘ 𝐇omʸ←𝐇om) p
          ＝⟨ homotopy-natural (λ j → 𝐇omʸ←∘ j f) p ⟩
      ap (𝐇omʸ←𝐇om ∘ (_∘[ 𝐴 ] f)) p ∙ 𝐇omʸ←∘ g' f
          ＝⟨ ap (_∙ 𝐇omʸ←∘ g' f) (ap-∘ 𝐇omʸ←𝐇om (_∘[ 𝐴 ] f) p) ⟩
      ap 𝐇omʸ←𝐇om (ap (_∘[ 𝐴 ] f) p) ∙ 𝐇omʸ←∘ g' f
          ∎

  𝐇omʸ←∘-nat-left
    : {a b c : A} (h : 𝐇om A b c) {f f' : 𝐇om A a b} (p : f ＝ f')
    → 𝐇omʸ←∘ h f ∙ ap (𝐇omʸ←𝐇om h ∘ʸ_) (ap 𝐇omʸ←𝐇om p)
    ＝ ap 𝐇omʸ←𝐇om (ap (h ∘[ 𝐴 ]_) p) ∙ 𝐇omʸ←∘ h f'
  𝐇omʸ←∘-nat-left h {f} {f'} p
    = 𝐇omʸ←∘ h f ∙ ap (𝐇omʸ←𝐇om h ∘ʸ_) (ap 𝐇omʸ←𝐇om p)
          ＝⟨ ap (𝐇omʸ←∘ h f ∙_) (sym (ap-∘ (𝐇omʸ←𝐇om h ∘ʸ_) 𝐇omʸ←𝐇om p)) ⟩
      𝐇omʸ←∘ h f ∙ ap ((𝐇omʸ←𝐇om h ∘ʸ_) ∘ 𝐇omʸ←𝐇om) p
          ＝⟨ homotopy-natural (𝐇omʸ←∘ h) p ⟩
      ap (𝐇omʸ←𝐇om ∘ (h ∘[ 𝐴 ]_)) p ∙ 𝐇omʸ←∘ h f'
          ＝⟨ ap (_∙ 𝐇omʸ←∘ h f') (ap-∘ 𝐇omʸ←𝐇om (h ∘[ 𝐴 ]_) p) ⟩
      ap 𝐇omʸ←𝐇om (ap (h ∘[ 𝐴 ]_) p) ∙ 𝐇omʸ←∘ h f' ∎

  ∘ʸ-unique
    : {a b c : A}
      (_∘'_ : 𝐇omʸ b c → 𝐇omʸ a b → 𝐇omʸ a c)
    → ((g : 𝐇omʸ b c) (f : 𝐇omʸ a b)
    → 𝐇om←𝐇omʸ (g ∘' f) ＝ 𝐇om←𝐇omʸ g ∘[ 𝐴 ] 𝐇om←𝐇omʸ f)
    → (g : 𝐇omʸ b c) (f : 𝐇omʸ a b)
    → g ∘' f ＝ g ∘ʸ f
  ∘ʸ-unique _∘'_ comp g f
    = g ∘' f
        ＝⟨ sym (𝐇om←𝐇omʸ-sec (g ∘' f)) ⟩
      𝐇omʸ←𝐇om (𝐇om←𝐇omʸ (g ∘' f))
        ＝⟨ ap 𝐇omʸ←𝐇om (comp g f) ⟩
      𝐇omʸ←𝐇om (𝐇om←𝐇omʸ g ∘[ 𝐴 ] 𝐇om←𝐇omʸ f)
        ＝⟨ 𝐇omʸ←∘ (𝐇om←𝐇omʸ g) (𝐇om←𝐇omʸ f) ⟩
      𝐇omʸ←𝐇om (𝐇om←𝐇omʸ g) ∘ʸ 𝐇omʸ←𝐇om (𝐇om←𝐇omʸ f)
        ＝⟨ ap₂ (_∘ʸ_) (𝐇om←𝐇omʸ-sec g) (𝐇om←𝐇omʸ-sec f) ⟩
      g ∘ʸ f ∎
}

\closedScope{
\subtree[stt-00SE]{
\title{Associativity using the action of the covariant Yoneda embedding on homomorphisms}
\taxon{Demonstration}
\author{fredrikbakke}
\date{2026-06-04}

\p{
We rederive associativity of composition in a [Segal](stt-00AI) type from the
strict associativity of composition in the [Yoneda strictification](stt-00LL).
Note that this proof is redundant since it depends on already having determined that
composition is associative. In [[stt-00SH]] we make meaningful progress on coherence
laws by constructing and applying the strictification operator proper.
}

\agda{
module AssocYonedaStrictifyLeftSegal
  {𝓤 : Level} {A : Type 𝓤} (𝐴 : is-segal A)
  (open YonedaStrictify 𝐴)
  where

  assocʸ-left
    : {a b c d : A}
      (h : 𝐇om A c d) (g : 𝐇om A b c) (f : 𝐇om A a b)
    → 𝐇omʸ←𝐇om ((h ∘[ 𝐴 ] g) ∘[ 𝐴 ] f)
    ＝ (𝐇omʸ←𝐇om h ∘ʸ 𝐇omʸ←𝐇om g) ∘ʸ 𝐇omʸ←𝐇om f
  assocʸ-left {a} {b} {c} {d} h g f
    = 𝐇omʸ←∘ (h ∘[ 𝐴 ] g) f
    ∙ ap (precompʸ d (𝐇omʸ←𝐇om f)) (𝐇omʸ←∘ h g)

  assocʸ-right
    : {a b c d : A}
      (h : 𝐇om A c d) (g : 𝐇om A b c) (f : 𝐇om A a b)
    → 𝐇omʸ←𝐇om (h ∘[ 𝐴 ] (g ∘[ 𝐴 ] f))
    ＝ 𝐇omʸ←𝐇om h ∘ʸ (𝐇omʸ←𝐇om g ∘ʸ 𝐇omʸ←𝐇om f)
  assocʸ-right {a} {b} {c} {d} h g f
    = 𝐇omʸ←∘ h (g ∘[ 𝐴 ] f)
    ∙ ap (postcompʸ a (𝐇omʸ←𝐇om h)) (𝐇omʸ←∘ g f)

  opaque
    assocʸ
      : {a b c d : A}
        (h : 𝐇om A c d) (g : 𝐇om A b c) (f : 𝐇om A a b)
      → 𝐇omʸ←𝐇om ((h ∘[ 𝐴 ] g) ∘[ 𝐴 ] f)
      ＝ 𝐇omʸ←𝐇om (h ∘[ 𝐴 ] (g ∘[ 𝐴 ] f))
    assocʸ h g f
      = assocʸ-left h g f
      ∙ ∘ʸ-assoc (𝐇omʸ←𝐇om h) (𝐇omʸ←𝐇om g) (𝐇omʸ←𝐇om f)
      ∙ sym (assocʸ-right h g f)

    assoc
      : {a b c d : A}
        (h : 𝐇om A c d) (g : 𝐇om A b c) (f : 𝐇om A a b)
      → (h ∘[ 𝐴 ] g) ∘[ 𝐴 ] f
      ＝ h ∘[ 𝐴 ] (g ∘[ 𝐴 ] f)
    assoc h g f
      = unap-equiv 𝐇omʸ←𝐇om-is-equiv (assocʸ h g f)

    assocʸ-coh
      : {a b c d : A}
        (h : 𝐇om A c d) (g : 𝐇om A b c) (f : 𝐇om A a b)
      → ap 𝐇omʸ←𝐇om (assoc h g f)
      ＝ assocʸ h g f
    assocʸ-coh h g f
      = ap-unap-equiv 𝐇omʸ←𝐇om-is-equiv (assocʸ h g f)
}
}
}
}

\subtree[stt-00SN]{
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-06-03}

\p{
The canonical homomorphism system and the covariant Yoneda homomorphism system
on a Segal type are equal.
}

\proof{

\agda{
module StrictifyLeftSegal
  {𝓤 : Level} {A : Type 𝓤}
  (𝐴 : is-segal A)
  (open YonedaStrictify 𝐴 using
    (𝐇om≃𝐇omʸ ; 𝐇omʸ←𝐇om ; 𝐇omʸ←idH ; 𝐇omʸ←∘ ; 𝐇om←𝐇omʸ-sec))
  where
}

\p{Equality of Hom families.}

\agda{
  𝐇om=𝐇omʸ : 𝐇om A ＝ 𝐇omʸ
  𝐇om=𝐇omʸ = funext→ λ a → funext→ λ b → ua (𝐇om≃𝐇omʸ a b)

  ua-𝐇om≃𝐇omʸ
    : (a b : A)
    → happly (happly 𝐇om=𝐇omʸ a) b ＝ ua (𝐇om≃𝐇omʸ a b)
  ua-𝐇om≃𝐇omʸ a b
    = ap (λ p → happly p b) (happly funext-redex a)
    ∙ happly funext-redex b

  coe-𝐇om=𝐇omʸ
    : (a b : A)
    → coe (happly (happly 𝐇om=𝐇omʸ a) b) ＝ 𝐇omʸ←𝐇om {a} {b}
  coe-𝐇om=𝐇omʸ a b =
    tr
      (λ p → coe p ＝ 𝐇omʸ←𝐇om {a} {b})
      (sym (ua-𝐇om≃𝐇omʸ a b))
      coe-ua

  coe-sym-𝐇om=𝐇omʸ
    : (a b : A)
    → coe (sym (happly (happly 𝐇om=𝐇omʸ a) b)) ＝ 𝐇om←𝐇omʸ
  coe-sym-𝐇om=𝐇omʸ a b =
    tr
      (λ p → coe (sym p) ＝ 𝐇om←𝐇omʸ)
      (sym (ua-𝐇om≃𝐇omʸ a b))
      (coe-sym-ua)
}

\p{Equality of identity families.}

\agda{
  ap-HasId
    : ∀ {𝓥} {H K : A → A → Type 𝓥}
        (p : H ＝ K)
      → ap (λ HΔ → (a : A) → HΔ a) (funext→ λ a → happly (happly p a) a)
      ＝ ap HasId p
  ap-HasId refl = ap (ap (λ HΔ → (a : A) → HΔ a)) funext-refl

  idH=idHʸ
    : 𝐇om-comp-prestruct 𝐴 .idʷ:
    ＝[ ap HasId 𝐇om=𝐇omʸ ]
      𝐇omʸ-comp-prestruct .idʷ:
  idH=idHʸ =
    tr
      (λ p → 𝐇om-comp-prestruct 𝐴 .idʷ: ＝[ p ] 𝐇omʸ-comp-prestruct .idʷ:)
      (ap-HasId 𝐇om=𝐇omʸ)
      (funextᵈ→ λ a → happly (coe-𝐇om=𝐇omʸ a a) (idH a) ∙ 𝐇omʸ←idH)
}

\p{Equality of composition binary operators.}

\agda{
  coe-ap-HasComp
    : ∀ {𝓥} {H K : A → A → Type 𝓥}
        (p : H ＝ K) (m : HasComp H)
      → coe (ap HasComp p) m
      ＝ ( λ a b c g f →
          coe (happly (happly p a) c)
            (m a b c
              (coe (sym (happly (happly p b) c)) g)
              (coe (sym (happly (happly p a) b)) f)))
  coe-ap-HasComp refl m = refl

  ∘=∘ʸ
    : 𝐇om-comp-prestruct 𝐴 .compʷ:
    ＝[ ap HasComp 𝐇om=𝐇omʸ ]
      𝐇omʸ-comp-prestruct .compʷ:
  ∘=∘ʸ =
    coe-ap-HasComp 𝐇om=𝐇omʸ (𝐇om-comp-prestruct 𝐴 .compʷ:)
    ∙ funext→ λ a → funext→ λ b → funext→ λ c → funext→ λ g → funext→ λ f →
      happly (coe-𝐇om=𝐇omʸ a c)
        (      (coe (sym (happly (happly 𝐇om=𝐇omʸ b) c)) g)
        ∘[ 𝐴 ] (coe (sym (happly (happly 𝐇om=𝐇omʸ a) b)) f))
      ∙ ap₂
          (λ g f → 𝐇omʸ←𝐇om (g ∘[ 𝐴 ] f))
          (happly (coe-sym-𝐇om=𝐇omʸ b c) g)
          (happly (coe-sym-𝐇om=𝐇omʸ a b) f)
      ∙ 𝐇omʸ←∘ (𝐇om←𝐇omʸ g) (𝐇om←𝐇omʸ f)
      ∙ ap₂ (_∘ʸ_) (𝐇om←𝐇omʸ-sec g) (𝐇om←𝐇omʸ-sec f)
}

\p{Equality of composition prestructures.}

\agda{
  𝐇om=𝐇omʸ-comp-prestruct : 𝐇om-comp-prestruct 𝐴 ＝ 𝐇omʸ-comp-prestruct
  𝐇om=𝐇omʸ-comp-prestruct = CompPrestructure-path→ 𝐇om=𝐇omʸ idH=idHʸ ∘=∘ʸ
}
}
}

\subtree[stt-00SO]{
\title{The strictification operator on Segal types}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-06-03}

\p{
Finally, we obtain the strictification operator \code{strictify}.
This is an adaptation of Rice's trick for groups \citek{rice-groups-uf}.
}

\agda{
  opaque
    strictify
      : {𝓥 : Level}
      → (P : CompPrestructure (𝓘 ⊔ 𝓤) A → Type 𝓥)
      → P 𝐇omʸ-comp-prestruct
      → P (𝐇om-comp-prestruct 𝐴)
    strictify P = tr P (sym 𝐇om=𝐇omʸ-comp-prestruct)
}

\p{
The strictification operator states the following: to prove a property on the
composition prestructure of a Segal type #{A}, i.e. the data consisting of its
#{\Hom} binary family, identity morphism family, and composition binary operator,
then it suffices to show it for the covariant Yoneda composition prestructure on
#{A}. This is a strictification since the latter composition prestructure is strictly
unital and associative.
}

\p{
Note that this trick makes essential use of the univalence axiom to transport
between #{\Hom} binary families.
}
}

\subtree[stt-00SH]{
\title{2-Coherence of composition in Segal types}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-06-03}

\p{
As an application of the [strictification operator](stt-00SO) we show that
composition of synthetic morphisms in a Segal type is 2-coherent. I.e.,
composition is unital and associative in a way that is coherent with the unit laws,
and the associator satisfies the pentagon law.
}

\agda{
  Σ2CoherenceLaws : CompPrestructure (𝓘 ⊔ 𝓤) A → Type (𝓘 ⊔ 𝓤)
  Σ2CoherenceLaws 𝒞 =
    Σ[ λʷ ∶ LeftUnitLaw 𝒞 ]
    Σ[ ρʷ ∶ RightUnitLaw 𝒞 ]
    Σ[ α ∶ AssociativeLaw 𝒞 ]
     ( InnerTriangleLaw 𝒞 λʷ ρʷ α
     × LeftTriangleLaw 𝒞 λʷ α
     × RightTriangleLaw 𝒞 ρʷ α
     × PentagonLaw 𝒞 α)

  opaque
    2-coherence : Σ2CoherenceLaws (𝐇om-comp-prestruct 𝐴)
    2-coherence =
      strictify Σ2CoherenceLaws
        ( ~refl
        , ~refl
        , (λ _ _ _ → refl)
        , (λ _ _ → refl)
        , (λ _ _ → refl)
        , (λ _ _ → refl)
        , (λ _ _ _ _ → refl))

    left-unit : LeftUnitLaw (𝐇om-comp-prestruct 𝐴)
    left-unit = 2-coherence .fst

    right-unit : RightUnitLaw (𝐇om-comp-prestruct 𝐴)
    right-unit = 2-coherence .snd .fst

    assoc : AssociativeLaw (𝐇om-comp-prestruct 𝐴)
    assoc = 2-coherence .snd .snd .fst

    inner-triangle
      : InnerTriangleLaw (𝐇om-comp-prestruct 𝐴) left-unit right-unit assoc
    inner-triangle = 2-coherence .snd .snd .snd .fst

    left-triangle
      : LeftTriangleLaw (𝐇om-comp-prestruct 𝐴) left-unit assoc
    left-triangle = 2-coherence .snd .snd .snd .snd .fst

    right-triangle
      : RightTriangleLaw (𝐇om-comp-prestruct 𝐴) right-unit assoc
    right-triangle = 2-coherence .snd .snd .snd .snd .snd .fst

    pentagon : PentagonLaw (𝐇om-comp-prestruct 𝐴) assoc
    pentagon = 2-coherence .snd .snd .snd .snd .snd .snd
}

\p{
Note that the left and right triangle laws are redundant as they follow from the
inner triangle law.
}

\p{
We could of course go further and define and prove 3-coherence should we please.
The proof will still be trivial, all it requires is the effort of actually defining
the coherence laws.
}
}
