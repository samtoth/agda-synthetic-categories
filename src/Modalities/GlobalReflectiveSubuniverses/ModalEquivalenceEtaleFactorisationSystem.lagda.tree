\subtree[bak-2689]{
\title{The modal-equivalence–étale orthogonal factorisation system}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-12}

\p{
The modal equivalences and étale maps of a #{Σ}-closed global reflective
subuniverse form an orthogonal factorisation system, following Cherubini–Rijke
\citek{CR21}.
}

% TODO: elaborate

\agda{
module ModalEquivEtalegOFS
  {α} (RS : gRSubU α)
  (open gRSubU RS)
  (SΣ : is-globally-Σ-closed GS)
  where

  Ll : gWideSubcatType (_⊔_)
  Ll .gWideSubcatType.K .Subtype.family = is-modal-equiv RS
  Ll .gWideSubcatType.K .Subtype.family-is-subtype _ = is-equiv-is-prop
  Ll .gWideSubcatType.≃∈K e = is-modal-equiv←is-equiv RS (e ._≃_.fwd-is-equiv)
  Ll .gWideSubcatType._∘∈K_ ge fe = is-modal-equiv-∘ RS fe ge

  Rr : gWideSubcatType (_⊔_)
  Rr .gWideSubcatType.K .Subtype.family = is-étale-map RS
  Rr .gWideSubcatType.K .Subtype.family-is-subtype _ = is-cartesian-is-prop
  Rr .gWideSubcatType.≃∈K e = is-étale-map←is-equiv RS (e ._≃_.fwd-is-equiv)
  Rr .gWideSubcatType._∘∈K_ ge fe = is-étale-map-∘ RS fe ge

  module _
    {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    (open ModalNaturalityFactorisation RS f)
    where

    factorisation : gFactorisation (_⊔_) Ll Rr f
    factorisation
      = mk-factorisation Im l (l-is-modal-equiv SΣ) r (r-is-étale SΣ) ~refl

  ofs : gOFS (_⊔_) (_⊔_) (_⊔_)
  ofs = gOFS←unique-lifts Ll Rr factorisation
          (λ fe → unique-lifts←are-orthogonal ∘ modal-equiv⊥etale RS fe)
}
}
