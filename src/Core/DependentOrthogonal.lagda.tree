\title{Dependently orthogonal maps}
\taxon{Module}
\author{fredrikbakke}
\date{2026-10-28}
\import{stt-macros}

\agda{
module Core.DependentOrthogonal where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowDependentMorphisms
open import Core.ArrowEquiv
