\date{2025-05-10}
\author{samueltoth}
\taxon{Module}
\import{stt-macros}

\title{Lifting squares}

\agda{
module Core.LiftingSquares where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Core.Arrows
open import Core.ArrowMorphisms
open import Core.DependentLiftingSquares public
open import Foundations.Prelude
}
}

\subtree[stt-0044]{
\title{Lifts of squares}
\contributor{fredrikbakke}

\p{Given a morphism of arrows, i.e., a square

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=1-1, to=3-3, phantom, "H"]
\end{tikzcd}
}
then a \em{lift} is a map from the bottom left to the top right,
#{\ell \colon B \to C}, such that both evident triangles commute \em{and} such that
the pasting of the triangles agrees with the full square. In other words, it is a
completion of the diagram

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=3-1, to=1-3, dashed, "\ell" description]
\arrow[from=1-1, to=3-3, phantom, "L" very near start, "K" very near end]
\end{tikzcd}
}
which coheres with the original homotopy of the square.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {f' : C → D}
  where

  SqLift : Arrow-map f f' → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  SqLift = SqLiftᵈ {f = f} {g = λ _ → f'}

  SqLift-repr≊
    : (G : Arrow-map f f')
    → SqLift G ≊
      (Σ[ l ∶ (B → C) ]
       Σ[ L ∶ l ∘ f ~ G .Arrow-map.top ]
       Σ[ K ∶ f' ∘ l ~ G .Arrow-map.bot ]
       (f' ◃h L ~ K ▹h f ∙h G .Arrow-map.comm))
  SqLift-repr≊ = SqLiftᵈ-repr≊ {f = f} {g = λ _ → f'}

  SqLift-repr≃
    : (G : Arrow-map f f')
    → SqLift G ≃
      (Σ[ l ∶ (B → C) ]
       Σ[ L ∶ l ∘ f ~ G .Arrow-map.top ]
       Σ[ K ∶ f' ∘ l ~ G .Arrow-map.bot ]
       (f' ◃h L ~ K ▹h f ∙h G .Arrow-map.comm))
  SqLift-repr≃ = SqLiftᵈ-repr≃ {f = f} {g = λ _ → f'}

module SqLift = SqLiftᵈ
}
}

\subtree[stt-0047]{
\title{Unique lifts of squares}
\taxon{Definition}
\author{samueltoth}

\p{We say a square has unique lifts if its type of lifts is a singleton.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {f' : C → D}
  where

  has-unique-sqlift : Arrow-map f f' → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  has-unique-sqlift = has-unique-sqliftᵈ {f = f} {g = λ _ → f'}
}
}

\subtree[stt-00ZJ]{
\title{If there is a lift of the identity square then the underlying map is an equivalence}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
is-equiv←self-sqlift
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  → SqLift (id-square: f) → is-equiv f
is-equiv←self-sqlift s
  = is-equiv←qinv (SqLift.lift s , SqLift.L s , SqLift.K s)
}
}

\subtree[stt-00YO]{
\title{The lifting square induced by a diagonal}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
  where

  diagonal-square : (B → C) → Arrow-map f g
  diagonal-square = diagonal-squareᵈ {f = f} {g = λ _ → g}

  diagonal-sqlift : (d : B → C) → SqLift (diagonal-square d)
  diagonal-sqlift = diagonal-sqliftᵈ {f = f} {g = λ _ → g}

  diagonal-square-htpy
    : {d e : B → C} → d ~ e
    → Arrow-map-path (diagonal-square d) (diagonal-square e)
  diagonal-square-htpy = diagonal-squareᵈ-htpy {f = f} {g = λ _ → g}
}

\p{
The function \code{diagonal-square} is more commonly known as the
\em{pullback power}, and is studied in [[Core.PullbackPowers]].
}
}

\subtree[stt-00YM]{
\title{Homotopies of lifts of squares}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
  {G : Arrow-map f g}
  where

  SqLift-htpy-boundary
    : (s : SqLift G)
    → Arrow-map-path (diagonal-square (SqLift.lift s)) G
  SqLift-htpy-boundary
    = SqLiftᵈ-htpy-boundary {f = f} {g = λ _ → g} {G = G}

  coherence-SqLift-htpy
    : (s t : SqLift G)
    → SqLift.lift s ~ SqLift.lift t
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  coherence-SqLift-htpy
    = coherence-SqLiftᵈ-htpy {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy : (s t : SqLift G) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  SqLift-htpy
    = SqLiftᵈ-htpy {f = f} {g = λ _ → g} {G = G}
}
}

\subtree[stt-00YR]{
\title{Characterising equality of lifts of a square}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-11}

\p{Homotopies of lifts characterise their equality.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
  {G : Arrow-map f g}
  where

  SqLift-htpy-refl : {s : SqLift G} → SqLift-htpy s s
  SqLift-htpy-refl
    = SqLiftᵈ-htpy-refl {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy←id : {s t : SqLift G} → s ＝ t → SqLift-htpy s t
  SqLift-htpy←id
    = SqLiftᵈ-htpy←id {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy-is-torsorial
    : (s : SqLift G) → is-torsorial (SqLift-htpy s)
  SqLift-htpy-is-torsorial
    = SqLiftᵈ-htpy-is-torsorial {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy←id-is-equiv
    : (s t : SqLift G) → is-equiv (SqLift-htpy←id {s} {t})
  SqLift-htpy←id-is-equiv = SqLiftᵈ-htpy←id-is-equiv {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy≃ : (s t : SqLift G) → (s ＝ t) ≃ SqLift-htpy s t
  SqLift-htpy≃ = SqLiftᵈ-htpy≃ {f = f} {g = λ _ → g} {G = G}

  SqLift-htpy→ : {s t : SqLift G} → SqLift-htpy s t → s ＝ t
  SqLift-htpy→ = SqLiftᵈ-htpy→ {f = f} {g = λ _ → g} {G = G}
}
}
