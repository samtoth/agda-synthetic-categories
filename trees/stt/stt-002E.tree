\date{2025-03-31}
\import{stt-macros}
\title{The type theoretic universal property}

\p{We can restate the universal property type theoretically:}

\subtree{
\title{Recursion principle}

  \p{There exists a map}
  ##{ \rm{rec} :
		     (\Sigma2{p \colon A \to Q}{q \colon B \to Q}{(pf = qg)})
		     \to
		     (A \amalg_C B \to Q)
  }

  \p{alongside the following computation rules:}

  \ul{
  \li{#{rec(p,q,h)(\iota_1(a)) = p(a)}}
  \li{#{rec(p,q,h)(\iota_2(b)) = q(b)}}
  \li{#{rec(p,q,h)(gl(c)) = \iota_2(g(c)) = h(c)}}
  }
}

\subtree{
  \title{Induction principle}

  \p{In general we can construct dependent maps #{\Pi1{a : A \amalg_C B}{Q(a)}}:}

  ##{ \rm{ind} : \Sigma2{p : \Pi1{a : A}{Q(\iota_1(a))}}{q : \Pi1{b : B}{Q(\iota_2(b))}}{\Pi1{c : C}{Q(gl(c))_*(p(f(c))) = q(g(c))}} \\
      \to \Pi1{p : A \amalg_C B}{Q(p)} }

  \p{again with the corresponding point computation principles:}

  \ul{
  \li{#{ \beta_1 \colon \rm{ind}(p,q,h)(\iota_1(a)) = p(a) }}
  \li{#{ \beta_2 \colon \rm{ind}(p,q,h)(\iota_2(b)) = q(b) }}
  }

  \p{The computation rule for the glue constructor is slightly more challenging to write down.
    Firstly we note that we want to classify the induction principle applied to the glue: #{\rm{ind}(p,q,h)(gl(c))}, but
    because ind is a dependent function type, we have to use the dependent version of path application.
    The type of this term is:
    ##{Q(gl(c))_*(\rm{ind}(p,q,h)(\iota_1(f(c)))) = \rm{ind}(p,q,h)(\iota_2(g(c)))}
    We want to state that induction at glue is just
    the identification #{h(c)}, but the type isn't quite correct.
  }
  ##{ \beta_{gl} \colon (Q(gl(c))_*(\beta_1(f(c))) = \beta_2(g(c)))_*(\rm{ind}(p,q,h)(gl(c))) = h(c)}

  \remark{
    \p{If we assume the rules #{\beta_1} and #{\beta_2} to hold by definition, the type of #{\beta_{gl}} simplifies
    	  to become just
       #{\rm{ind}(p,q,h)(gl(c)) = h(c)}
     }
  }
}
