\title{The amazing right adjoint asscociated to a tiny object is left exact}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
open import Foundations.Prelude
open import Synthetic.Tiny

module Synthetic.TinyLex
  {@♭ 𝓘} {@♭ I : Type 𝓘}
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ ε√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (I → √ A) → A)
  (@♭ √-is-tiny-str : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure I A (√ A) ε√)
  where

open Tiny I √ ε√ √-is-tiny-str
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.LiftingSquares
open import Modalities.Cohesion.Continuity

open import Ergonomics.Extensionality

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.CartesianSquares
open import Core.Cube
open import Core.Postwhisker
}
}

\subtree[tot-1238]{
\title{The amazing right adjoint preserves products}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-18}

\agda{
√-×-cone
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → √ (A × B) → √ A × √ B
√-×-cone f .fst = ε♭ (√₁ (mod♭ fst)) f
√-×-cone f .snd = ε♭ (√₁ (mod♭ snd)) f

×₁-tiny-str
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ B : Type 𝓦}
    → is-equiv {A = ⟨♭| (Γ → √ A) × (Γ → √ B) ⟩}
               (♭-map (untranspose ×₁ untranspose))
×₁-tiny-str
  = src-is-equiv←Arrow-equiv
      (mk-arr-equiv ♭-pres-× ♭-pres-× (♭-ind (λ _ → refl)))
      (×₁-is-equiv √-is-tiny-str √-is-tiny-str)

×₁-tiny≃
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ Γ : Type 𝓤} {@♭ A : Type 𝓥} {@♭ B : Type 𝓦}
    → ⟨♭| (Γ → √ A) × (Γ → √ B) ⟩ ≃ ⟨♭| ((I → Γ) → A) × ((I → Γ) → B) ⟩
×₁-tiny≃ = mk≃ (♭-map (untranspose ×₁ untranspose)) ×₁-tiny-str

√×-is-product
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → is-equiv (√-×-cone {A = A}{B})
√×-is-product {A = A} {B} = types-separate √-×-cone
  (src-is-equiv←Arrow-equiv
    (mk-arr-equiv √-tiny≃ (♭≃ (×-→-swap≃ _ _) ∙e ×₁-tiny≃)
      (♭-ind
        (λ x' → mapply♭ (mod♭
          (×-path→
            ( happly (untranspose-naturality (mod♭ fst)) x'
            , happly (untranspose-naturality (mod♭ snd)) x'))))))
    (is-♭-equiv←is-equiv (×-→-swap≃ A B ._≃_.fwd-is-equiv)))
}
}

\subtree[tot-0CY7]{

\agda{
opaque
  untranspose-arrow-lemma
    : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
        {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
        {@♭ C : Type 𝓦} {@♭ D : Type 𝓜} {@♭ g : C → D}
        (@♭ F : Arrow-map f g)
      → Arrow-map-path
          (F ∘Arr ε√-naturality-square' f)
          (ε√-naturality-square' g ∘Arr postcomp-square (√-arrow-map F) I)
  untranspose-arrow-lemma {f = f} {g = g} F
    = {!!}

  postcomp-arrow-naturality-lemma
    : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜 𝓝} (@♭ Γ : Type 𝓤)
        {@♭ A : Type 𝓥} {@♭ B : Type 𝓦}
        {@♭ C : Type 𝓜} {@♭ D : Type 𝓝}
      → (@♭ f : A → B) (@♭ g : C → D)
      → (@♭ F : Arrow-map g f)
      → Arrow-map-path
          (postcomp-arrow-naturality I f ∘Arr postcomp-square F Γ)
          (postcomp-square (postcomp-square F I) (I → Γ) ∘Arr postcomp-arrow-naturality I g)
  postcomp-arrow-naturality-lemma Γ f g F = ~refl , ~refl , ∙h-reflr _ ∙h ∙h-reflr _ ∙h λ h → {! !}


  untranspose-arrow-naturality
    : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜 𝓧}
        {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
        {@♭ C : Type 𝓦} {@♭ D : Type 𝓜} {@♭ g : C → D}
        {@♭ Γ : Type 𝓧}
        (@♭ F : Arrow-map f g)
      → Arrow-map-path
          (paste-squares (postcomp-square F (I → Γ)) (untranspose-arrow Γ f))
          (paste-squares (untranspose-arrow Γ g) (postcomp-square (√-arrow-map F) Γ))
  untranspose-arrow-naturality {f = f} {g = g} {Γ} F
    = (postcomp-square F (I → Γ)) ∘Arr (postcomp-square (ε√-naturality-square' f) (I → Γ) ∘Arr postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f))))
    ~Arr⟨ paste-squares-assoc (postcomp-square F (I → Γ)) (postcomp-square (ε√-naturality-square' f) (I → Γ)) (postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))) ⟩
      postcomp-square F (I → Γ) ∘Arr postcomp-square (ε√-naturality-square' f) (I → Γ) ∘Arr postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))
    ~Arr⟨ postcomp-square-∘ F (ε√-naturality-square' f) (I → Γ) ▹Arr postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f))) ⟩
      postcomp-square (F ∘Arr ε√-naturality-square' f) (I → Γ) ∘Arr  postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))
    ~Arr⟨ postcomp-Arrow-map-path (I → Γ) (untranspose-arrow-lemma F) ▹Arr  postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f))) ⟩
      postcomp-square (ε√-naturality-square' g ∘Arr postcomp-square (√-arrow-map F) I) (I → Γ) ∘Arr  postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))
    ~Arr⟨ sym-Arrow-map-path (postcomp-square-∘ (ε√-naturality-square' g) (postcomp-square (√-arrow-map F) I) (I → Γ)) ▹Arr  postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f))) ⟩
      postcomp-square (ε√-naturality-square' g) (I → Γ) ∘Arr postcomp-square (postcomp-square (√-arrow-map F) I) (I → Γ) ∘Arr  postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))
    ~Arr⟨ paste-squares-assoc (postcomp-square (ε√-naturality-square' g) (I → Γ)) (postcomp-square (postcomp-square (√-arrow-map F) I) (I → Γ)) (postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f)))) ⟩
      postcomp-square (ε√-naturality-square' g) (I → Γ) ∘Arr (postcomp-square (postcomp-square (√-arrow-map F) I) (I → Γ) ∘Arr postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ f))))
    ~Arr⟨ sym-Arrow-map-path (postcomp-square (ε√-naturality-square' g) (I → Γ) ◃Arr postcomp-arrow-naturality-lemma Γ (ε♭ (√₁ (mod♭ g))) (ε♭ (√₁ (mod♭ f))) (√-arrow-map F) ) ⟩
      postcomp-square (ε√-naturality-square' g) (I → Γ) ∘Arr ((postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ g)))) ∘Arr postcomp-square (√-arrow-map F) Γ)
    ~Arr⟨ paste-squares-assoc
            (postcomp-square (ε√-naturality-square' g) (I → Γ))
            (postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ g))))
            (postcomp-square (√-arrow-map F) Γ) ⟩
      (postcomp-square (ε√-naturality-square' g) (I → Γ) ∘Arr (postcomp-arrow-naturality I (ε♭ (√₁ (mod♭ g))))) ∘Arr postcomp-square (√-arrow-map F) Γ
    ~Arr⟨⟩
      untranspose-arrow Γ g ∘Arr postcomp-square (√-arrow-map F) Γ
    ~Arr∎

module _
  {@♭ 𝓤 𝓥 𝓦 𝓜}
  {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
  {@♭ C : Type 𝓦} {@♭ D : Type 𝓜} {@♭ g : C → D}
  (@♭ F : Arrow-map f g)
  {@♭ 𝓧} (@♭ Γ : Type 𝓧)
  where

  untranspose-cube
    : Cube (postcomp-square (√-arrow-map F) Γ) (postcomp-square F (I → Γ))
  untranspose-cube .Cube.left = untranspose-arrow Γ f
  untranspose-cube .Cube.right = untranspose-arrow Γ g
  untranspose-cube .Cube.comm = untranspose-arrow-naturality F

  is-tiny-str-cube
    : is-Cube-equiv (♭-cube untranspose-cube)
  is-tiny-str-cube .fst = is-tiny-str-arrow f
  is-tiny-str-cube .snd = is-tiny-str-arrow g
}
}
