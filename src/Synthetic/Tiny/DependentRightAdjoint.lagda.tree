\title{The dependent amazing right adjoint asscociated to a tiny object}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
open import Foundations.Prelude
open import Synthetic.Tiny

module Synthetic.Tiny.DependentRightAdjoint
  {@♭ 𝓘} {@♭ I : Type 𝓘}
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ ε√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (I → √ A) → A)
  (@♭ √-is-tiny-str : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure I A (√ A) ε√)
  where

open import Axioms.UF

open Tiny I √ ε√ √-is-tiny-str
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.LiftingSquares
open import Modalities.Cohesion.Continuity
open import Modalities.Instances.Truncation

open import Ergonomics.Extensionality

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.PiSection
open import Core.GlobalClassesMaps
open import Core.UniversalFibrations
open import Core.Small
open import Core.Postwhisker
}
}

\subtree[stt-00KA]{
\title{The dependent amazing right adjoint}
\taxon{Theorem}

\p{
For any tiny type #{I}, we may construct a dependent version of the amazing right
adjoint, written
#{\sqrt[I]{-} \colon \modflat{\Gamma^I \to \Type} \to \modflat{\Gamma \to \Type^+}}, where
#{\Type^+} is the successor universe. It satisfies the following universal property:

##{\modflat{\Pi_{\Gamma^I} P} \simeq \modflat{\Pi_{\Gamma} \sqrt[I]{P}}}
}


\proof{
\p{We use the theory of [universal fibrations](stt-00K4). There is a map
#{\pi_I \colon \UU^{\bullet}_I \to \UU_I} which is at least #{\UU^+}-small
, and so by the fact #{\pi \colon {\UU^+}^{\bullet} \to \UU^+} classifies #{\UU^+}-small
maps, we have a cartesian square from #{\pi_I} to #{\pi}, and
in particular that lifts of #{\pi_I} against some #{A \colon \Gamma \to \UU_I}
are equivalent to sections (#{\Pi}-types) of the induced map #{\Gamma \to \UU}.}

\p{Finally to finish the proof, we show that lifts of #{\pi} along
#{A \colon \Gamma^I \to \UU} can be transposed across the adjunction to give
lifts of #{\pi_I} along #{\bar{A} \colon \Gamma \to \UU_I}.}
}

\remark{
\p{Notice that this construction bumps the universe level. In \citek{GWB24}
the cubes separate axiom is used to show that the map #{\pi_I} is actually
#{\UU}-small. For the sake of generality we do not want to assume cubes separate
here. It would be interesting to investigate if it follows that this map is
#{\UU}-small without any further axioms, for example by making use of the similar
but weaker theorem that types separate.}
}

\agda{
√Type∗-π : ∀ {@♭ 𝓤} → ⟨♭| (√(Σ (Type 𝓤) id) → √(Type 𝓤)) ⟩
√Type∗-π = √₁ (mod♭ (Type-π _))

classify-√ : ∀ {@♭ 𝓤} → √(Type 𝓤) → Type (lsuc 𝓤)
classify-√
  = Type-is-universal.arrow-map
      {f = ε♭ (√Type∗-π)}
      (λ _ → self-is-small)
      .Arrow-map.bot

√ᵈ : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} → @♭ ((I → Γ) → Type 𝓥) → Γ → Type (lsuc 𝓥)
√ᵈ A = classify-√ ∘ ε♭ (transpose (mod♭ A))

{-# INLINE √ᵈ #-}

opaque
  transpose-lift♭
    : {@♭ 𝓤 𝓥 : Level} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
    → ⟨♭| LiftMap (Type-π 𝓥) A ⟩
    ≃ ⟨♭| LiftMap (ε♭ (√Type∗-π {𝓥})) (ε♭ (transpose (mod♭ A))) ⟩
  transpose-lift♭ {𝓤} {𝓥} {Γ} {A}
    =   ⟨♭| LiftMap (Type-π 𝓥) A ⟩
    ≃⟨ ♭-commΣ _ e⁻¹ ⟩
        (Σ[♭ l ∶ ((I → Γ) → Type∗' 𝓥) ] ⟨♭| fst ∘ l ＝ A  ⟩)
    ≃⟨ Σ-fst-≃-bwd⁻¹ exp⊣√ ⟩
       Σ ⟨♭| (Γ → √ (Type∗' 𝓥)) ⟩
        (♭-ind (λ (@♭ l) → ⟨♭| fst ∘ l ＝ A ⟩) ∘ ♭-map untranspose)
    ≃⟨ Σ-snd-≃ (λ {(mod♭ l) → id≃}) ⟩
        (Σ[♭ l ∶ (Γ → √ (Type∗' 𝓥)) ] ⟨♭| fst ∘ untranspose l ＝ A ⟩)
    ≃⟨ Σ-snd-≃ (λ {(mod♭ l) → mk≃ (f l) (feq l)}) ⟩
        (Σ[♭ l ∶ (Γ → √ (Type∗' 𝓥)) ]
           ⟨♭| (ε♭ √Type∗-π) ∘ l ＝ ε♭ (transpose (mod♭ A)) ⟩)
    ≃⟨ ♭-commΣ _ ⟩
        ⟨♭| LiftMap (ε♭ √Type∗-π) (ε♭ (transpose (mod♭ A))) ⟩
    ≃∎ where
    @♭ f : ∀ (@♭ l : Γ → √ (Type∗' 𝓥))
           → ⟨♭| fst ∘ untranspose l ＝ A ⟩
           → ⟨♭| ε♭ √Type∗-π ∘ l ＝ ε♭ (transpose (mod♭ A)) ⟩
    f l  = transpose-unique ∘ ♭-map ((happly (untranspose-naturality (mod♭ fst)) l ∙_))

    @♭ feq : ∀ (@♭ l) → is-equiv (f l)
    feq l = is-equiv-∘
      transpose-unique-is-equiv
      (is-♭-equiv←is-equiv (∙-is-equiv (happly (untranspose-naturality (mod♭ fst)) l)))

Π←lift
  : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
    → LiftMap (ε♭ (√Type∗-π {𝓥})) (ε♭ (transpose (mod♭ A)))
    → Π Γ (√ᵈ A)
Π←lift {A = A}
  = universal-section
      (ε♭ (transpose (mod♭ A)))
      (λ _ → self-is-small)

opaque
  rintro
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
      → ⟨♭| Π (I → Γ) A ⟩
      → ⟨♭| Π Γ (√ᵈ A) ⟩
  rintro {A = A}
    = ♭-map Π←lift ∘ transpose-lift♭ ._≃_.fwd ∘ ♭-map (LiftMap←Π A)

  rintro-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
      → is-equiv (rintro {A = A})
  rintro-is-equiv
    = is-equiv-∘
        (is-♭-equiv←is-equiv (universal-section-is-equiv _ (λ _ → self-is-small)))
        (is-equiv-∘
          (transpose-lift♭ ._≃_.fwd-is-equiv)
          (is-♭-equiv←is-equiv (LiftMap←Π-is-equiv _)))

relim
  : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
    → ⟨♭| Π Γ (√ᵈ A) ⟩
    → ⟨♭| Π (I → Γ) A ⟩
relim = is-equiv.bwd rintro-is-equiv

opaque
  relim-embedding
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} {@♭ A : (I → Γ) → Type 𝓥}
      → {@♭ X Y : Π Γ (√ᵈ A)}
      → ⟨♭| X ~ Y ⟩
      ≃ ⟨♭| ε♭ (relim (mod♭ X)) ~ ε♭ (relim (mod♭ Y)) ⟩
  relim-embedding {X = X} {Y = Y}
    = ⟨♭| X ~ Y ⟩
    ≃⟨ ♭≃ (funext≃ e⁻¹) ⟩
      ⟨♭| X ＝ Y ⟩
    ≃⟨ mapply♭≃ ⟩
      mod♭ X ＝ mod♭ Y
    ≃⟨ mk≃ (ap relim) (is-embedding←is-equiv (is-equiv⁻¹ rintro-is-equiv)) ⟩
      relim (mod♭ X) ＝ relim (mod♭ Y)
    ≃⟨ tr₂≃ (_＝_) (sym (mod♭ε♭ _)) (sym (mod♭ε♭ _)) ⟩
      mod♭ (ε♭ (relim (mod♭ X))) ＝ mod♭ (ε♭ (relim (mod♭ Y)))
    ≃⟨ mapply♭≃ e⁻¹ ⟩
      ⟨♭| ε♭ (relim (mod♭ X)) ＝ ε♭ (relim (mod♭ Y)) ⟩
    ≃⟨ ♭≃ funext≃ ⟩
      ⟨♭| ε♭ (relim (mod♭ X)) ~ ε♭ (relim (mod♭ Y)) ⟩
    ≃∎
}

\p{We also record the naturality laws that #{\sqrt[I]{-}} enjoys.}

\agda{
opaque
  √ᵈ-naturality→
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'}
        (@♭ A : (I → Γ) → Type 𝓥)
      → (@♭ σ : Δ → Γ)
      → ∀ x → (√ᵈ A ∘ σ) x → (√ᵈ (A ∘ postcomp I σ)) x
  √ᵈ-naturality→ A σ x = tr
    classify-√
    (sym (happly
      ( ap ε♭ (transpose-∘ (mod♭ A) σ)
      ∙ ε♭-natural (transpose (mod♭ A)))
      (x)))

  √ᵈ-naturality←
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'}
        (@♭ A : (I → Γ) → Type 𝓥)
      → (@♭ σ : Δ → Γ)
      → ∀ x → (√ᵈ (A ∘ postcomp I σ)) x → (√ᵈ A ∘ σ) x
  √ᵈ-naturality← A σ x
    = tr
        classify-√
        (happly
          ( ap ε♭ (transpose-∘ (mod♭ A) σ)
          ∙ ε♭-natural (transpose (mod♭ A)))
          (x))

  √ᵈ-naturality-path
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'}
        (@♭ A : (I → Γ) → Type 𝓥)
      → (@♭ σ : Δ → Γ)
      → √ᵈ (A ∘ postcomp I σ) ＝ (√ᵈ A ∘ σ)
  √ᵈ-naturality-path A σ
    = ap (classify-√ ∘_)
        ( ap ε♭ (transpose-∘ (mod♭ A) σ)
        ∙ ε♭-natural (transpose (mod♭ A)))

  √ᵈ-naturality-is-equiv'
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'} {@♭ A : (I → Γ) → Type 𝓥}
      → (@♭ σ : Δ → Γ)
      → is-fibrewise-equiv (√ᵈ-naturality← A σ)
  √ᵈ-naturality-is-equiv' σ a = tr-is-equiv _

  √ᵈ-naturality-is-equiv
    : ∀ {@♭ 𝓤 𝓤' 𝓥} {@♭ Γ : Type 𝓤} {@♭ Δ : Type 𝓤'} {@♭ A : (I → Γ) → Type 𝓥}
      → (@♭ σ : Δ → Γ)
      → is-fibrewise-equiv (√ᵈ-naturality→ A σ)
  √ᵈ-naturality-is-equiv σ a = tr-is-equiv _
}
}

\subtree[stt-00KS]{
\title{Amazingly fibrant types}
\taxon{Theorem}
\contributor{fredrikbakke}

\p{For any tiny type #{I} and #{\mathcal{F}}, a class of [#{I}-relative](stt-00K1)
maps, we may construct universes #{U_{\mathcal{F}}} which classifies
#{\UU}-small maps in #{\mathcal{F}}.
}

\proof{
We use the dependent form of the amazing right adjoint, so that #{U_{\mathcal{F}}}
is defined to be #{\Sigma_{\UU} \sqrt[I]{{-} \in \mathcal{F}}}. The universal
property of #{\sqrt[I]{}} gives us that the family #{U_{\mathcal{F}} \to \UU} is itself
fibrant, and since every family #{A \to U_{\mathcal{F}}} is a pullback of this
universal one it must also be fibrant. On the other hand any covariant family
#{P \colon A \to \UU} can be shown to factor through #{U_{\mathcal{F}}}.
}

\agda{
module AmazinglyFibrant
  {@♭ α : Level → Level → Level}
  (@♭ is-fib : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (α 𝓤 𝓥))
  (@♭ is-fib-is-prop : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → is-prop (is-fib B))
  (@♭ rel-fib : is-relative-fam I is-fib)
  where
  open Tiny I √ ε√ √-is-tiny-str public

  is-afib : ∀ {@♭ 𝓤} → Type 𝓤 → Type (lsuc (α 𝓘 𝓤))
  is-afib = √ᵈ is-fib

  record UFib (@♭ 𝓤) : Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤)) where
    constructor mk-ufib
    field
      Carrier : Type 𝓤
      Carrier-is-afib : is-afib Carrier

  UFib∙ : ∀ (@♭ 𝓤) → Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤))
  UFib∙ 𝓤 = Σ (UFib 𝓤) UFib.Carrier

  UFib-π : ∀ {@♭ 𝓤} → UFib∙ 𝓤 → UFib 𝓤
  UFib-π = fst

  UFib-π-is-fib : ∀ {@♭ 𝓤} → is-fib (UFib.Carrier {𝓤})
  UFib-π-is-fib = rel-fib _ .snd
    (ε♭ (relim (mod♭ (λ a → √ᵈ-naturality→ _ UFib.Carrier a (a .UFib.Carrier-is-afib)))))

  UFib-is-fib
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (P : A → UFib 𝓥)
      → is-fib (UFib.Carrier ∘ P)
  UFib-is-fib P
    = is-base-change-stable-fam←is-relative
        I is-fib rel-fib P UFib.Carrier
        UFib-π-is-fib

  liftFib
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ P : A → Type 𝓥}
      → ⟨♭| is-fib P ⟩ ↔ ⟨♭| (∀ a → is-afib (P a)) ⟩
  liftFib {A = A} {P = P} .fst fib
    = ♭-map (postcomp-Π (√ᵈ-naturality← _ _))
            (rintro (♭-map (rel-fib P .fst) fib))
  liftFib {A = A} {P = P} .snd
    = ♭-map (UFib-is-fib ∘ (λ af a → (mk-ufib (P a) (af a))))

  UFib-transport : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} → (A → UFib 𝓥) → Σ (A → Type 𝓥) is-fib
  UFib-transport f = (UFib.Carrier ∘ f , UFib-is-fib f)
}

\p{In order to show that being amazingly fibrant is a proposition, and therefore
that the universe we have constructed is univalent, we need that the tiny type
former preserves propositions. This is at the moment left for future work.}

\agda{
  module UIdS
    (@♭ √ᵈ-is-prop
      : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (I → Γ) → Type 𝓥)
        → @♭ ((γ : I → Γ) → is-prop (A γ)) → (γ : Γ) → is-prop (√ᵈ A γ))
    where

    is-afib-is-prop
      : ∀ {@♭ 𝓤} {A : Type 𝓤} → is-prop (is-afib A)
    is-afib-is-prop = √ᵈ-is-prop is-fib is-fib-is-prop _

    Carrier-is-prop-map : ∀ {@♭ 𝓤} → is-prop-map (UFib.Carrier {𝓤})
    Carrier-is-prop-map X = is-prop←retraction
      (λ where (a , refl) → a .UFib.Carrier-is-afib)
      ((λ a → (mk-ufib X a , refl)) , λ where (a , refl) → refl)
      (is-afib-is-prop {A = X})

    Carrier-is-emb : ∀ {@♭ 𝓤} → is-embedding (UFib.Carrier {𝓤})
    Carrier-is-emb = is-embedding←is-prop-map Carrier-is-prop-map

    UFib-path←
      : ∀ {@♭ 𝓤} (A B : UFib 𝓤)
        → UFib.Carrier A ≃ UFib.Carrier B
        → A ＝ B
    UFib-path← A B e = unap Carrier-is-emb (ua e)

    opaque
      UFib-path←-coe≃-ap
        : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
          → UFib-path← A B (coe≃ (ap UFib.Carrier p)) ＝ p
      UFib-path←-coe≃-ap p =
        ap (unap Carrier-is-emb) ua-coe≃ ∙ is-equiv.η Carrier-is-emb p

      UFib-path←-β
        : ∀ {@♭ 𝓤} (A B : UFib 𝓤) (e : UFib.Carrier A ≃ UFib.Carrier B)
          → coe≃ (ap UFib.Carrier (UFib-path← A B e)) ＝ e
      UFib-path←-β A B e =  ap coe≃ (is-equiv.ε Carrier-is-emb (ua e)) ∙ coe≃-ua

    instance
      UFib-IdS : ∀ {@♭ 𝓤} → Identity-system (UFib 𝓤) 𝓤
      UFib-IdS {𝓤} = IdS←Embedding {f = UFib.Carrier} Carrier-is-prop-map (IdS-ua {𝓤})

    UFib-tr
      : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
        → ext! (tr≃ UFib.Carrier p) ＝ p
    UFib-tr refl = Id←IdS←Id refl

    UP-UFib
      : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
        → is-♭-equiv (UFib-transport {𝓤} {𝓥} {A})
    UP-UFib = is-equiv←qinv
      ( ♭-ind (λ f
          → mod♭ λ a → mk-ufib (fst f a) (ε♭ (liftFib .fst (mod♭ (snd f))) a))
      , ♭-ind (λ f
          → mapply♭ (mod♭ (ext! (λ a → id≃))))
      , ♭-ind (λ f
          → mapply♭ (mod♭ (ext! ((λ _ → id≃) , is-fib-is-prop (f .fst) _ _)))))

    UP-UFib≃
      : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
        → ⟨♭| (A → UFib 𝓥) ⟩ ≃ ⟨♭| Σ (A → Type 𝓥) is-fib ⟩
    UP-UFib≃ {𝓤} {𝓥} {A}
      = mk≃ (♭-map (UFib-transport {𝓤} {𝓥} {A})) UP-UFib
}
}

\subtree[stt-012B]{
\title{Amazing fibrancy lifting}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Let #{I} be an inhabited tiny object, and let fibrations be #{I}-relative.
Given a crisp type family #{P \colon-flat A \to \UU}, if #{P} is a fibration then
its fibres are amazingly fibrant.
}

\proof{
\p{
Let #{Q(h,a) \defeq P(a) \colon-flat \textsf{is-fib}(P)\times A \to \UU}. We start by
showing that #{Q} is crisply a fibration. Since fibrations are #{I}-relative, it
suffices to show crisply that #{Q \circ \sigma} is a fibration for every
#{\sigma \colon I \to \textsf{is-fib}(P)\times A}. Since being a fibration is a
proposition, we may assume an element #{i :^♭ I}, and so #{\pi_1 \sigma(i)} is a
proof that #{P} is a fibration. The family #{Q \circ \sigma} is a base change of #{P}
and so it is also a fibration. Abstraction over #{\sigma} thus gives a crisp proof of
the relative fibrancy condition, so we obtain a crisp proof that #{Q} is a fibration.
}

\p{
Now, applying the amazing right adjoint to this crisp witness and using naturality,
we obtain that every #{Q(x)} is amazingly fibrant. Evaluating at #{(h,a)}, where #{h}
is our initial hypothesis that #{P} is fibrant, we conclude that #{P(a)} is amazingly
fibrant.
}
}

\agda{
  lift-fibrancy
    : @♭ ║ I ║₋₁
    → ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ P : A → Type 𝓥)
    → is-fib P → (a : A) → is-afib (P a)
  lift-fibrancy |i| {𝓤} {𝓥} {A} P P-is-fib a
    = ε♭ (liftFib .fst (mod♭ Q-is-fib)) (P-is-fib , a)
    where
    @♭ Q : is-fib P × A → Type 𝓥
    Q = P ∘ snd

    @♭ Q-is-fib : is-fib Q
    Q-is-fib
      = rel-fib Q .snd (λ σ → rel-fib P .fst
          (Trunc.○-rec (is-truncated←is-prop (is-fib-is-prop P)) (fst ∘ σ) |i|)
          (snd ∘ σ))
}
}
