\subtree[stt-00HZ]{
\date{2026-03-13}
\author{fredrikbakke}
\taxon{Theorem}
\title{Equality of smallness}

\p{
Equality on the type \code{is-small} is characterised by an [equivalence](stt-001U)
of carrier types such that the obvious triangle commutes. Consequently,
\code{is-small} is a [proposition](stt-0009). In fact, this is [equivalent](stt-001U)
to the [univalence axiom](Foundations.Univalence).
}

\agda{
open WithFunExt-global global-funext
module WUA = WithGlobalUnivalence UA

module _ {𝓤 𝓥} {A : Type 𝓤} where

  is-small-equiv-is-torsorial
    : (S : is-small 𝓥 A) → is-torsorial (is-small-equiv S)
  is-small-equiv-is-torsorial S
    = is-singleton-structure←parts
        (WUA.equiv-is-torsorial (S .fst))
        (_ , id≃)
        (is-single←equiv-to-single
          ( ( Σ-fst-≃ ≃-rep
            ∙e remove-singleton-structure
                  (htpy-is-torsorial global-funext (_≃_.fwd (S .snd ∙e id≃)))
                  (_≃_.fwd (S .snd ∙e id≃) , ~refl)) e⁻¹)
          (mk-singl
            ((S .snd ∙e id≃) ._≃_.fwd-is-equiv)
            (λ x → is-equiv-is-prop _ _)))

  small-equiv←Id-is-equiv
    : (S T : is-small 𝓥 A) → is-equiv (small-equiv←Id {S = S} {T = T})
  small-equiv←Id-is-equiv S
    = fundamental-Id
        (is-small-equiv S)
        (is-small-equiv-is-torsorial S)
        (λ _ → small-equiv←Id)

  Id≃is-small-equiv
    : (S T : is-small 𝓥 A) → (S ＝ T) ≃ is-small-equiv S T
  Id≃is-small-equiv S T = mk≃ small-equiv←Id (small-equiv←Id-is-equiv S T)

  Id←is-small-equiv
    : {S T : is-small 𝓥 A} → is-small-equiv S T → S ＝ T
  Id←is-small-equiv {S = S} {T = T} = _≃_.bwd (Id≃is-small-equiv S T)

  is-small-is-prop
    : is-prop (is-small 𝓥 A)
  is-small-is-prop S T = Id←is-small-equiv (any-is-small-equiv S T)

is-n-locally-small-is-prop
  : ∀ {𝓤 𝓥} {n : ℕ} {A : Type 𝓤}
  → is-prop (is-n-locally-small n 𝓥 A)
is-n-locally-small-is-prop {n = zero}
  = is-small-is-prop
is-n-locally-small-is-prop {n = suc n}
  = Π-is-prop λ _ → Π-is-prop λ _ → is-n-locally-small-is-prop {n = n}

is-locally-small-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
  → is-prop (is-locally-small 𝓥 A)
is-locally-small-is-prop = is-n-locally-small-is-prop {n = 1}
}
}

\subtree[stt-00HR]{
\date{2026-03-13}
\author{fredrikbakke}
\taxon{Lemma}
\title{Small types are closed under dependent products}

\agda{
Π-is-small
  : ∀ {𝓤 𝓤' 𝓥 𝓥'}
      {A : Type 𝓤} {B : A → Type 𝓥}
    → is-small 𝓤' A
    → ((a : A) → is-small 𝓥' (B a))
    → is-small (𝓤' ⊔ 𝓥') (Π A B)
Π-is-small {B = B} (A' , e) H
  = ( Π A' (λ a' → fst (H (_≃_.bwd e a')))
    , precomp-Π-≃ B (e e⁻¹)
    ∙e Π-fam-≃ (λ a' → snd (H (_≃_.bwd e a'))))
}
}

\subtree[stt-00HW]{
\date{2026-03-13}
\author{fredrikbakke}
\taxon{Theorem}
\title{Small types are closed under retracts}

\p{
Given a [small](stt-00HN) type #{A}, then any [retract](stt-00HE) of #{A} is again
small.
}

\p{
This appears as \citet{Thm 2.13}{dJE23}, and is a consequence of the
[splitting construction on quasiidempotent maps](stt-00HC).
}

\agda{
Splitting-type-is-small
  : ∀ {𝓤 𝓥} {X : Type 𝓤}
      (f : X → X)
    → is-small 𝓥 X
    → is-small 𝓥 (Splitting.type f)
Splitting-type-is-small {X = X} f Xsmall
  = Σ-is-small
      (Π-is-small self-is-small (λ _ → Xsmall))
      (λ a → Π-is-small self-is-small
        (λ n → ＝-is-small Xsmall (a n) (f (a (suc n)))))

is-small←retract
  : ∀ {𝓤 𝓥 𝓦}
      {A : Type 𝓤} {B : Type 𝓥}
    → retract A B
    → is-small 𝓦 B
    → is-small 𝓦 A
is-small←retract R Bsmall
  = is-small←equiv
      (SplitRetractWithFunExt.split-retract-equiv global-funext R)
      (Splitting-type-is-small (fst (qidempotent-map←retract R)) Bsmall)

is-n-locally-small←retract
  : ∀ {𝓤 𝓥 𝓦} (n : ℕ)
      {A : Type 𝓤} {B : Type 𝓥}
    → retract A B
    → is-n-locally-small n 𝓦 B
    → is-n-locally-small n 𝓦 A
is-n-locally-small←retract zero R H
  = is-small←retract R H
is-n-locally-small←retract (suc n) R H x y
  = is-n-locally-small←retract n
      (retract-＝ R)
      (H (R .fst x) (R .fst y))

is-locally-small←retract
  : ∀ {𝓤 𝓥 𝓦}
      {A : Type 𝓤} {B : Type 𝓥}
    → retract A B
    → is-locally-small 𝓦 B
    → is-locally-small 𝓦 A
is-locally-small←retract = is-n-locally-small←retract 1
}
}

\subtree[stt-00I8]{
\date{2026-03-18}
\author{fredrikbakke}
\taxon{Theorem}
\title{The universe of retracts of a small type is small}

\p{
For any #{\UV}-[small](stt-00HN) type #{A} and any universe #{\UW}, the
[universe of retracts](stt-00H5) of #{A} in #{\UV \sqcup \UW} is still
#{\UV}-small.
}

\p{
This is a consequence of [retract closure of small types](stt-00HW), using that the
universe of retracts [is a retract of the type of quasiidempotent maps](stt-00I7).
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} where

  preidempotence-is-small
    : (f : A → A)
    → is-small 𝓥 A
    → is-small 𝓥 (preidempotence f)
  preidempotence-is-small f Asmall
    = Π-is-small Asmall (λ a → ＝-is-small Asmall (f (f a)) (f a))

  qcoh-preidempotence-is-small
    : (f : A → A)
      (I : preidempotence f)
    → is-small 𝓥 A
    → is-small 𝓥 (qcoh-preidempotence f I)
  qcoh-preidempotence-is-small f I Asmall
    = Π-is-small Asmall
        (λ a → ＝-is-small
          (＝-is-small Asmall (f (f (f a))) (f (f a)))
          (ap f (I a))
          (I (f a)))

  qidempotence-is-small
    : (f : A → A)
    → is-small 𝓥 A
    → is-small 𝓥 (qidempotence f)
  qidempotence-is-small f Asmall
    = Σ-is-small
        (preidempotence-is-small f Asmall)
        (λ I → qcoh-preidempotence-is-small f I Asmall)

  qidempotent-map-is-small
    : is-small 𝓥 A
    → is-small 𝓥 (qidempotent-map A)
  qidempotent-map-is-small Asmall
    = Σ-is-small
        (Π-is-small Asmall (λ _ → Asmall))
        (λ f → qidempotence-is-small f Asmall)

Retracts-is-small
  : ∀ {𝓤 𝓥} 𝓦 {A : Type 𝓤}
    → is-small 𝓥 A
    → is-small 𝓥 (Retracts (𝓥 ⊔ 𝓦) A)
Retracts-is-small {𝓥 = 𝓥} 𝓦 (_ , e)
  = is-small←equiv
      (Retracts-≃ (𝓥 ⊔ 𝓦) (e ∙e lift≃) e⁻¹)
      (is-small←retract
        (retracts-qidempotent-map-retract)
        (qidempotent-map-is-small (ULift-is-small 𝓦)))
}
}

\subtree[stt-00HY]{
\date{2026-03-13}
\author{fredrikbakke}
\author{samueltoth}
\taxon{Theorem}
\title{Type theoretic replacement}

\p{
If the domain of a map is [small](stt-00HN) at level #{\UW} and the codomain is
[locally small](stt-00HS) at that level, then the [image](Core.Images) of the map is
[small](stt-00HN).
}

\p{
This theorem makes use of the [modified join construction](stt-008G) and is due to
[[egbertrijke]] \citet{Thm 4.6}{Rij17}.
}

\agda{
record has-small-image
  {𝓤 𝓥} 𝓦
  {A : Type 𝓤} {B : Type 𝓥}
  (f : A → B)
  : Typeω where
  field
    carrier : Type 𝓦
    incl : carrier → B
    incl-is-image : is-image f incl

replacement
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
    → (f : A → B)
    → is-small 𝓦 A
    → is-locally-small 𝓦 B
    → has-small-image 𝓦 f
replacement {𝓦 = 𝓦} {B = B} f (A' , e) Bls = result
  where

  module Img = Im' ⦃ identity-system←is-locally-small Bls ⦄ (f ∘ _≃_.bwd e)

  result : has-small-image 𝓦 f
  result .has-small-image.carrier = Img.Im'
  result .has-small-image.incl = Img.incl
  result .has-small-image.incl-is-image = is-image←equiv-domain e Img.Im-is-image

is-small←is-image
  : ∀ {𝓤 𝓥 𝓦 𝓘}
      {A : Type 𝓤} {B : Type 𝓥}
    → (f : A → B)
    → is-small 𝓦 A
    → is-locally-small 𝓦 B
    → {I : Type 𝓘} {i : I → B}
    → is-image f i
    → is-small 𝓦 I
is-small←is-image f Asmall Bls {I} {i} im
  = is-small←equiv
      (is-image-equiv f im
        (replacement f Asmall Bls .has-small-image.incl-is-image)
        e⁻¹)
      (self-is-small)

canonical-image-is-small
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B)
    → is-small 𝓦 A
    → is-locally-small 𝓦 B
    → is-small 𝓦 (canonical-image f)
canonical-image-is-small f Asmall Bls
  = is-small←is-image f Asmall Bls (canonical-image-is-image f)
}
}

\subtree[stt-00H0]{
\date{2026-03-13}
\author{fredrikbakke}
\taxon{Corollary}
\title{Images of small maps with small codomains are small}

\agda{
canonical-image-is-small←is-small-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
    → (f : A → B)
    → is-small 𝓦 B
    → is-small-map 𝓦 f
    → is-small 𝓦 (canonical-image f)
canonical-image-is-small←is-small-map f Bsmall fsmall
  = canonical-image-is-small f
      (is-small-domain←small-map Bsmall fsmall)
      (＝-is-small Bsmall)
}
}
