\subtree[tot-0001]{
\title{Functoriality of the under type at a fixed type}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-26}

\p{Fixing a type #{A}, the under type former determines a functor from
#{\Type_{/A} \to \Type}.}

\agda{
Under₁
  : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
      {K : Type 𝓚} {p : K → A}
      {K' : Type 𝓚'} {q : K' → A}
      (t : Slice-map q p)
    → Under' p → Under' q
Under₁ {p = p} {q = q} (f , H)
  = total-map
      λ a
      → postcomp-Π (λ k' → adjust-hom (H k') refl)
      ∘ precomp-Π (λ k → Hom _ (p k) a) f
}
}
