\subtree[stt-00G1]{
\title{Adjunctions}
\taxon{Definition}
\date{2026-02-11}
\author{samueltoth}
\contributor{fredrikbakke}

\p{
Given a pair of maps #{l \colon A \to B} and #{r \colon B \to A}, then #{l} is
\em{left adjoint} to #{r} and #{r} is \em{right adjoint} to #{l}, denoted
#{l \dashv r}, if there is a family of equivalences
##{\Hom(l(a), b) \simeq \Hom(a, r(b))}
for all #{a : A} and #{b : B}. An \em{adjunction} between the types #{A} and #{B} is
a pair of adjoint maps as above.
}

\p{
To disambiguate this condition from other equivalent conditions (under appropriate
assumptions), we may also refer to these as \em{transposing adjoints} following
Riehl–Shulman \citet[§11.1]{RS17}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} where

  _⊣_ : (A → B) → (B → A) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  l ⊣ r = (a : A) (b : B) → Hom B (l a) b ≃ Hom A a (r b)

  is-left-adjoint : (A → B) →  Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-left-adjoint l = Σ[ r ∶ (B → A)] (l ⊣ r)

  is-right-adjoint : (B → A) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-right-adjoint r = Σ[ l ∶ (A → B)] (l ⊣ r)

  right-adjoint : (A → B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  right-adjoint = is-left-adjoint

  left-adjoint : (B → A) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  left-adjoint = is-right-adjoint

lAdj : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
lAdj A B = Σ[ l ∶ (A → B)] is-left-adjoint l

rAdj : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
rAdj A B = Σ[ r ∶ (A → B)] is-right-adjoint r
}
}

\subtree[stt-00G2]{
\title{Equivalences are adjoints}
\taxon{Lemma}
\date{2026-02-11}
\date{2026-11-27}
\author{samueltoth}
\contributor{fredrikbakke}

\p{If #{f} is an equivalence then #{f \dashv f^{-1}} and #{f^{-1} \dashv f}.}

\agda{
left-transposing-equiv←is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → {f : A → B} → (fe : is-equiv f)
    → f ⊣ (is-equiv.bwd fe)
left-transposing-equiv←is-equiv {A = A} {B = B} {f = f} fe a b
  = Hom B (f a) b             ≃⟨ Hom-equiv←is-equiv (is-equiv⁻¹ fe) ⟩
    Hom A (bwd (f a)) (bwd b) ≃⟨ adjust-hom≃ (η a) refl ⟩
    Hom A a (bwd b) ≃∎
    where open is-equiv fe

right-transposing-equiv←is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → {f : A → B} → (fe : is-equiv f)
    → (is-equiv.bwd fe) ⊣  f
right-transposing-equiv←is-equiv
  = left-transposing-equiv←is-equiv ∘ is-equiv⁻¹

module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}  (fe : is-equiv f) where

  is-left-adjoint←is-equiv : is-left-adjoint f
  is-left-adjoint←is-equiv
    = (is-equiv.bwd fe , left-transposing-equiv←is-equiv fe)

  is-right-adjoint←is-equiv : is-right-adjoint f
  is-right-adjoint←is-equiv
    = (is-equiv.bwd fe , right-transposing-equiv←is-equiv fe)
}
}
