\title{Joins}
\taxon{Module}
\author{samueltoth}
\date{2025-04-18}

\import{stt-macros}

\agda{
module Core.Joins where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.CanonicalPushouts
open import Core.PushoutEquiv
}
}

\subtree[stt-002S]{
\title{Joins of types}
\taxon{Definition}

\p{The join of types #{A} and #{B}, written #{A * B} is
the pushout of the span
#{A \xleftarrow{\pi_1} A \times B \xrightarrow{\pi_2} B}}

\quiver{
\begin{tikzcd}
	{A \times B} && A \\
	\\
	B && {A * B}
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=3-1, to=3-3]
	\arrow["\lrcorner"{anchor=center, pos=0.125, rotate=180}, draw=none, from=3-3, to=1-1]
\end{tikzcd}
}

\agda{
infixl 15 _*_

_*_ : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓤 ⊔ 𝓥)
A * B = Pushout {A = A × B} fst snd
}
}

\subtree[stt-002V]{
\title{Singleton joins}

\p{The join of a singleton with any type is also a singleton}

\proof{
\p{This follows from the fact that [pushing an equivalence out gives
an equivalence](stt-0080).}
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} where

  *-comm : A * B ≃ B * A
  *-comm = pushout-comm ∙e Pushout-adjust-equiv ×-swap

  *-comm→ : A * B → B * A
  *-comm→ = *-comm ._≃_.fwd

  *-single' : is-singleton B → is-singleton (A * B)
  *-single' B-is-single
    = is-single←equiv
        (Pushout-equiv (singleton-fst-is-equiv (λ _ → B-is-single)) snd)
        (B-is-single)

*-single
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → is-singleton A → is-singleton (A * B)
*-single = is-single←equiv *-comm ∘ *-single'
}
}

\subtree[stt-002W]{
\title{Joins of propositions}
\taxon{Theorem}

\p{The universal property for joins of propositions says that
for propositions #{P} and #{Q}, to eliminate into a proposition #{R},
it suffices to supply #{P \to R}, and #{Q \to R}}

\p{As an easy corollary, we have that the join of two propositions
is again a proposition.}

\agda{
module _ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦} where

  *-prop-disj
    : is-prop A → is-prop B → is-prop Q
    → (A * B → Q) → (A → Q) × (B → Q)
  *-prop-disj A-is-prop B-is-prop Q-is-prop f = (f ∘ ι₁ , f ∘ ι₂)

  *-prop-disj≃ : is-prop Q → (A * B → Q) ≃ ((A → Q) × (B → Q))
  *-prop-disj≃ Q-is-prop
    = (A * B → Q)
        ≃⟨ Pushout-UP≃ ⟩
      Cocone (mk-span _ fst snd) Q
        ≃⟨ cocone-repr≃ ⟩
      Σ[ f ∶ (A → Q) ] Σ[ g ∶ (B → Q) ] (f ∘ fst ~ g ∘ snd)
        ≃⟨ Σ-snd-≃ (λ f → Σ-snd-≃ (λ g → curry≃)) ⟩
      Σ[ f ∶ (A → Q) ] Σ[ g ∶ (B → Q) ] ((a : A) (b : B) → f a ＝ g b)
        ≃⟨ Σ-snd-≃ (λ f → Σ-singleton (λ g → Π-is-single (λ a → Π-is-single (λ b
          → ＝-is-single←is-prop Q-is-prop (f a) (g b))))) ⟩
      ((A → Q) × (B → Q))
        ≃∎

  *-prop-UP
    : (A-is-prop : is-prop A) (B-is-prop : is-prop B) (Q-is-prop : is-prop Q)
    → is-equiv (*-prop-disj A-is-prop B-is-prop Q-is-prop)
  *-prop-UP A-is-prop B-is-prop Q-is-prop = *-prop-disj≃ Q-is-prop ._≃_.fwd-is-equiv

  opaque
    *-prop-rec : is-prop Q → (A → Q) → (B → Q) → A * B → Q
    *-prop-rec Q-is-prop f g = _≃_.bwd (*-prop-disj≃ Q-is-prop) (f , g)

*-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → is-prop A → is-prop B → is-prop (A * B)
*-is-prop A-is-prop B-is-prop
  = is-prop←is-single-if-inhabited
      (*-prop-rec is-single-is-prop
        (λ a → *-single (mk-singl a (A-is-prop a)))
        (λ b → *-single' (mk-singl b (B-is-prop b))))
}
}

\subtree[stt-009U]{
\title{Joins with the empty type}

\p{The join #{A * 0} for any type #{A} is equivalent to #{A}.}

\proof{The map #{A \times 0 \to 0} is an equivalence so by
\ref{stt-008O}, so must #{A \to A * 0}.}

\agda{
*-∅ : ∀ {𝓤} {A : Type 𝓤} → A ≃ ∅ * A
*-∅ = Pushout-equiv (×-∅ ._≃_.fwd-is-equiv) snd

*-∅' : ∀ {𝓤} {A : Type 𝓤} → A ≃ A * ∅
*-∅' = *-∅ ∙e *-comm
}
}

\subtree[stt-009L]{
\title{Functoriality of the join}
\taxon{Theorem}
\contributor{fredrikbakke}

\p{
The join operator on types defines a functor #{\SS \times \SS \to \SS}. We define the
action of #{*} on functions, and show that it preserves identity maps, composition
and homotopies, and hence also equivalences and retracts.
}

\agda{
_*₁_
  : ∀ {𝓤 𝓜 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓜}
      {B : Type 𝓥} {B' : Type 𝓦}
    → (A → A') → (B → B') → A * B → A' * B'
f *₁ g = pushout-rec (mk-cocone (ι₁ ∘ f) (ι₂ ∘ g) (glue ∘ (f ×₁ g)))

*₁-id : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → id ~ (id {A = A} *₁ id {A = B})
*₁-id
  = pushout-rec-unique pushout id ~refl ~refl
      (∙h-reflr _ ∙h (λ p → ap-id (glue p)))

*₁-∘
  : ∀ {𝓤 𝓜 𝓥 𝓦 𝓧 𝓨}
      {A : Type 𝓤} {A' : Type 𝓜} {A'' : Type 𝓧}
      {B : Type 𝓥} {B' : Type 𝓦} {B'' : Type 𝓨}
      (f : A' → A'') (g : B' → B'') (f' : A → A') (g' : B → B')
    → (f *₁ g) ∘ (f' *₁ g') ~ ((f ∘ f') *₁ (g ∘ g'))
*₁-∘ f g f' g'
  = cogap-unique _ (f *₁ g) _ ~refl ~refl
      (∙h-reflr _ ∙h (λ p → pushout-rec-apβ (f' (fst p) , g' (snd p))))

*₁-htpy
  : ∀ {𝓤 𝓜 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓜} {B : Type 𝓥} {B' : Type 𝓦}
      {f f' : A → A'} {g g' : B → B'}
    → f ~ f' → g ~ g' → (f *₁ g) ~ (f' *₁ g')
*₁-htpy H K = happly (ap₂ _*₁_ (funext→ H) (funext→ K))

join-map-section
  : ∀ {𝓤 𝓜 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓜} {B : Type 𝓥} {B' : Type 𝓦}
      (f : A → A') (g : B → B') (f' : A' → A) (g' : B' → B)
    → f ∘ f' ~ id → g ∘ g' ~ id → (f *₁ g) ∘ (f' *₁ g') ~ id
join-map-section f g f' g' H K
  = (f *₁ g) ∘ (f' *₁ g')
      ~⟨ *₁-∘ f g f' g' ⟩
    ((f ∘ f') *₁ (g ∘ g'))
      ~⟨ *₁-htpy H K ⟩
    (id *₁ id)
      ~⟨ *₁-id h⁻¹ ⟩
    id
      ~∎

module _
  {𝓤 𝓜 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓜} {B : Type 𝓥} {B' : Type 𝓦}
  {f : A → A'} {g : B → B'}
  (f-is-equiv : is-equiv f) (g-is-equiv : is-equiv g)
  (let module F = is-equiv f-is-equiv)
  (let module G = is-equiv g-is-equiv)
  where

  *₁-is-equiv : is-equiv (f *₁ g)
  *₁-is-equiv = is-equiv←qinv join-map-qinv where
    join-map-qinv : quasi-inv (f *₁ g)
    join-map-qinv
      = ( F.bwd *₁ G.bwd
        , join-map-section F.bwd G.bwd f g F.η G.η
        , join-map-section f g F.bwd G.bwd F.ε G.ε)

*-≃
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} {D : Type 𝓜}
    → A ≃ C → B ≃ D → A * B ≃ C * D
*-≃ (mk≃ l le) (mk≃ r re)
  = mk≃ (l *₁ r) (*₁-is-equiv le re)

*-retract
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} {D : Type 𝓜}
    → retract A C → retract B D → retract (A * B) (C * D)
*-retract (f , f' , H) (g , g' , K)
  = (f *₁ g , f' *₁ g' , join-map-section f' g' f g H K)
}
}

\subtree[stt-00FH]{
\title{Null-homotopies of maps out of a join}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-03-06}

\p{
Given a map #{q \colon A * B \to Q}, then each element #{a : A} determines a
[null-homotopy](stt-00F3) of the restriction #{q \circ \iota_2 \colon B \to Q}.
Moreover, null-homotopies of #{q} are equivalent to null-homotopies of this induced
family over #{A}.
}

\agda{
join-null-homotopy-at
  : {𝓤 𝓥 𝓦 : Level}
    {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
  → (q : A * B → Q)
  → A
  → null-homotopy (q ∘ ι₂)
join-null-homotopy-at q a .fst = q (ι₁ a)
join-null-homotopy-at q a .snd b = ap q (glue (a , b))

join-rec≃null-homotopies
  : {𝓤 𝓥 𝓦 : Level}
    {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
  → (A * B → Q)
  ≃ Σ[ r ∶ (B → Q) ] ((a : A) → null-homotopy r)
join-rec≃null-homotopies {A = A} {B} {Q}
  = (A * B → Q)
      ≃⟨ Pushout-UP≃ ⟩
    Cocone (mk-span _ fst snd) Q
      ≃⟨ cocone-repr≃ ⟩
    Σ[ l ∶ (A → Q) ] Σ[ r ∶ (B → Q) ] (l ∘ fst ~ r ∘ snd)
      ≃⟨ Σ-snd-≃ (λ l → Σ-snd-≃ (λ r → curry≃)) ⟩
    Σ[ l ∶ (A → Q) ] Σ[ r ∶ (B → Q) ] ((a : A) (b : B) → l a ＝ r b)
      ≃⟨ Σ-comm ⟩
    Σ[ r ∶ (B → Q) ] Σ[ l ∶ (A → Q) ] ((a : A) (b : B) → l a ＝ r b)
      ≃⟨ Σ-snd-≃ (λ r → Σ-→-swap≃ Q (λ q → (b : B) → q ＝ r b) e⁻¹) ⟩
    Σ[ r ∶ (B → Q) ] ((a : A) → Σ[ q ∶ Q ] ((b : B) → q ＝ r b))
      ≃⟨⟩
    Σ[ r ∶ (B → Q) ] ((a : A) → null-homotopy r)
      ≃∎

join-recᵈ≃null-homotopies
  : {𝓤1 𝓤2 𝓤3 𝓤4 𝓤5 : Level}
    {A : Type 𝓤1}
    {X : A → Type 𝓤2}
    {B : A → Type 𝓤3}
    {Y : (a : A) → X a → Type 𝓤4}
    {Q : (a : A) (x : X a) → Type 𝓤5}
  → ((a : A) (x : X a) → B a * Y a x → Q a x)
  ≃ Σ[ r ∶ ((a : A) (x : X a) → Y a x → Q a x) ]
     ((a : A) (b : B a) (x : X a) → null-homotopy (r a x))
join-recᵈ≃null-homotopies
  {A = A} {X} {B} {Y} {Q}
  = ((a : A) (x : X a) → B a * Y a x → Q a x)
      ≃⟨ Π-fam-≃ (λ a → Π-fam-≃ (λ _ → join-rec≃null-homotopies)) ⟩
    ((a : A) (x : X a) → Σ[ r ∶ (Y a x → Q a x) ] ((b : B a) → null-homotopy r))
      ≃⟨ Π-fam-≃
            ( λ a
              → Σ-Π-swap≃
                  (λ x → Y a x → Q a x)
                  (λ x r → (b : B a) → null-homotopy r)) ⟩
    ((a : A)
      → Σ[ r ∶ ((x : X a) → Y a x → Q a x) ]
          ((x : X a) → (b : B a) → null-homotopy (r x)))
      ≃⟨ Σ-Π-swap≃
            (λ a → (x : X a) → Y a x → Q a x)
            (λ a r → (x : X a) (b : B a) → null-homotopy (r x)) ⟩
    (Σ[ r ∶ ((a : A) (x : X a) → Y a x → Q a x) ]
      ((a : A) → (x : X a) (b : B a) → null-homotopy (r a x)))
      ≃⟨ Σ-snd-≃ (λ _ → Π-fam-≃ (λ _ → flip≃)) ⟩
    (Σ[ r ∶ ((a : A) (x : X a) → Y a x → Q a x) ]
      ((a : A) → (b : B a) (x : X a) → null-homotopy (r a x)))
      ≃∎

module _
  {𝓤 𝓥 𝓦 : Level}
  {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
  (q : A * B → Q)
  (l : Q)
  where

  join-path-from-left
    : (a : A)
    → const: Q B (q (ι₁ a)) ~ q ∘ ι₂
  join-path-from-left a b = ap q (glue (a , b))

  join-ind-paths≃null-homotopy-inner-over
    : (r : (b : B) → l ＝ q (ι₂ b))
    → (a : A)
    → Σ[ t ∶ l ＝ q (ι₁ a) ] ((b : B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) t (r b))
    ≃ ((l , r) ＝ join-null-homotopy-at q a)
  join-ind-paths≃null-homotopy-inner-over r a
    = (Σ[ t ∶ l ＝ q (ι₁ a) ]
        ((b : B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) t (r b)))
        ≃⟨ Σ-snd-≃ (λ t → Π-fam-≃ (λ b → Idᶠ-const-≃' q (glue (a , b)) t (r b))) ⟩
      (Σ[ t ∶ l ＝ q (ι₁ a) ]
        ((b : B) → t ∙ join-path-from-left a b ＝ r b))
        ≃⟨ null-homotopy-path≃ r (join-path-from-left a) e⁻¹ ⟩
      ((l , r) ＝ join-null-homotopy-at q a)
        ≃∎

  join-ind-paths≃null-homotopy-inner
    : (r : (b : B) → l ＝ q (ι₂ b))
    → (Σ[ t ∶ ((a : A) → l ＝ q (ι₁ a)) ]
        (((a , b) : A × B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) (t a) (r b)))
    ≃ ((a : A) → (l , r) ＝ join-null-homotopy-at q a)
  join-ind-paths≃null-homotopy-inner r
    = (Σ[ t ∶ ((a : A) → l ＝ q (ι₁ a)) ]
        (((a , b) : A × B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) (t a) (r b)))
        ≃⟨ Σ-snd-≃ (λ t → curry≃) ⟩
      (Σ[ t ∶ ((a : A) → l ＝ q (ι₁ a)) ]
        ((a : A) (b : B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) (t a) (r b)))
        ≃⟨ Σ-Π-swap≃
              (λ a → l ＝ q (ι₁ a))
              (λ a t → (b : B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) t (r b))
              e⁻¹ ⟩
      ((a : A)
        → Σ[ t ∶ l ＝ q (ι₁ a) ]
          ((b : B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) t (r b)))
        ≃⟨ Π-fam-≃ (join-ind-paths≃null-homotopy-inner-over r) ⟩
      ((a : A) → (l , r) ＝ join-null-homotopy-at q a)
        ≃∎

  join-ind-paths≃null-homotopy-at
    : (((j : A * B) → l ＝ q j))
    ≃ (Σ[ r ∶ ((b : B) → l ＝ q (ι₂ b)) ]
        ((a : A) → (l , r) ＝ join-null-homotopy-at q a))
  join-ind-paths≃null-homotopy-at
    = (((j : A * B) → l ＝ q j))
        ≃⟨ Pushout-UPᵈ≃ e⁻¹ ⟩
      Coconeᵈ (mk-span _ fst snd) pushout (λ j → l ＝ q j)
        ≃⟨ coconeD-repr≃ ⟩
      (Σ[ t ∶ ((a : A) → l ＝ q (ι₁ a)) ]
       Σ[ r ∶ ((b : B) → l ＝ q (ι₂ b)) ]
         (((a , b) : A × B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) (t a) (r b)))
        ≃⟨ Σ-comm ⟩
      (Σ[ r ∶ ((b : B) → l ＝ q (ι₂ b)) ]
       Σ[ t ∶ ((a : A) → l ＝ q (ι₁ a)) ]
         (((a , b) : A × B) → Idᶠ (λ j → l ＝ q j) (glue (a , b)) (t a) (r b)))
        ≃⟨ Σ-snd-≃ join-ind-paths≃null-homotopy-inner ⟩
      (Σ[ r ∶ ((b : B) → l ＝ q (ι₂ b)) ]
        ((a : A) → (l , r) ＝ join-null-homotopy-at q a))
        ≃∎

join-null-homotopies≃
  : {𝓤 𝓥 𝓦 : Level}
    {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
  → (q : A * B → Q)
  → null-homotopy q ≃ null-homotopy (join-null-homotopy-at q)
join-null-homotopies≃ {A = A} {B} {Q} q
  = null-homotopy q
      ≃⟨ Σ-snd-≃ (join-ind-paths≃null-homotopy-at q) ⟩
    (Σ[ l ∶ Q ]
     Σ[ r ∶ ((b : B) → l ＝ q (ι₂ b)) ]
       ((a : A) → (l , r) ＝ join-null-homotopy-at q a))
      ≃⟨ Σ-assoc e⁻¹ ⟩
    null-homotopy (join-null-homotopy-at q)
      ≃∎

join-null-homotopiesᵈ≃
  : {𝓤 𝓥 𝓦 𝓠 : Level}
    {X : Type 𝓤}
    {B : Type 𝓥}
    {Y : X → Type 𝓦}
    {Q : X → Type 𝓠}
  → (q : (x : X) → B * Y x → Q x)
  → ((x : X) → null-homotopy (q x))
  ≃ null-homotopy (λ b x → join-null-homotopy-at (q x) b)
join-null-homotopiesᵈ≃ {X = X} q
  = ((x : X) → null-homotopy (q x))
      ≃⟨ Π-fam-≃ (λ x → join-null-homotopies≃ (q x)) ⟩
    ((x : X) → null-homotopy (join-null-homotopy-at (q x)))
      ≃⟨ null-homotopy-curry≃ (join-null-homotopy-at ∘ q) ⟩
    null-homotopy (λ b x → join-null-homotopy-at (q x) b)
      ≃∎
}
}
