\title{Torsorial type families}
\date{2026-05-29}
\taxon{Module}
\import{stt-macros}

\agda{
module Foundations.TorsorialTypeFamilies where

open import Foundations.Universes
open import Foundations.Sigma
open import Foundations.SigmaIdentity
open import Foundations.SigmaProperties
open import Foundations.Identity
open import Foundations.Singletons
open import Foundations.SingletonClosure
open import Foundations.Equivalences
open import Foundations.FibrewiseEquivalences
open import Foundations.TotalEquiv
open import Foundations.EquivOfSingleton
open import Foundations.EquivSingleton
open import Foundations.SingletonFibres
}


\subtree[tot-0055]{
\title{Torsorial type families}
\taxon{Definition}

\agda{
is-torsorial
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (𝓤 ⊔ 𝓥)
is-torsorial {A = A} B = is-singleton (Σ A B)
}
}

\subtree[stt-00NR]{
\title{The fundamental theorem of identity types}
\taxon{Theorem}

\p{The fundamental theorem of identity types says that if a family #{R}
is torsorial, then for any basepoint #{a_0} and fibrewise map
#{\alpha_b : a_0 = b \to R_b}, #{\alpha_b} is an equivalence.}

\agda{
fundamental-Id
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {a₀}
    → (R : A → Type 𝓥)
    → is-torsorial R
    → (f : ∀ b → a₀ ＝ b → R b)
    → is-fibrewise-equiv f
fundamental-Id {a₀ = a₀} R Sing-sing f
  = is-fibrewise-equiv←is-total-equiv
      (is-equiv←single-to-prop
        Sing-is-singleton
        (is-prop←is-single Sing-sing)
        (total-map f))

fundamental-Id⁻¹
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {a₀}
      (R : A → Type 𝓥)
    → is-torsorial R
    → ((b : A) → a₀ ＝ b → R b)
    → {b : A} → R b → a₀ ＝ b
fundamental-Id⁻¹ R tor f {b} = is-equiv.bwd (fundamental-Id R tor f b)
}
}

\subtree[tot-0594]{
\taxon{Lemma}

\p{We give a very convenient way to show that type families are torsorial in a
compositional manner. If #{R_A} is a torsorial type family over #{A}, and #{R_B : \Pi_{a :
A} B(a) \to R_A(a) \to \Type} is a family which for some choice of elements #{(a,b) :
\Sigma_A R_A} is torsorial as a type family over #{B(a)}, then #{\Sigma_{R_A} R_B} is
torsorial as a type family over #{\Sigma_A B}. Whilst this seems like quite a mouthfull,
the basic idea is that #{A} and #{B} represent a structure, and #{R_A} and #{R_B} are
the identity types for each part of the structure. This theorem can be iterated to
conveniently characterise the identity types of larger/composite structures.}

\agda{
is-singleton-structure←parts
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : A → Type 𝓥}
      {Ra : A → Type 𝓦} {Rb : (a : A) → B a → Ra a → Type 𝓜}
    → is-singleton (Σ A Ra)
    → (t@(a , c) : Σ A Ra)
    → is-singleton (Σ[ b ∶ B a ] Rb a b c)
    → is-singleton (Σ[ t@(a , b) ∶ (Σ A B)] Σ (Ra a) (Rb a b))
is-singleton-structure←parts aR t@(a , c) bR
  = is-single←equiv-to-single Σ-interchange (Σ-is-single' aR t bR)
}
}

\agda{
remove-singleton-structure
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {Ra : A → Type 𝓦}
    → is-torsorial  Ra
    → ((a , _) : Σ A Ra)
    → (Σ[ (a , b) ∶ Σ A B ] Ra a) ≃ B a
remove-singleton-structure ars a
  = Σ-assoc
  ∙e Σ-snd-≃ (λ _ → ×-swap)
  ∙e Σ-assoc e⁻¹
  ∙e Σ-singl ars a
}
