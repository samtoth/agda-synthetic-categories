\subtree[tot-B1CE]{
\title{Cone types}
\taxon{Definition}
\author{samueltoth}
\date{2026-09-29}

\p{Given a diagram #{\phi \colon \mathcal{K} \to A}, the type of #{D}-shaped \em{cones}
at some element #{a : A} is given by a natural transformation #{\const_a \Rightarrow D}.
We write #{A_{/\phi}} for the type consisting of a point and a cone over that point.
This type comes with a canonical projection to #{A} which we call the \em{apex} map.}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  𝐂one-over : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝐂one-over a = ∀ (k : K) → Hom A a (ϕ k)

  𝐂one : Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  𝐂one = Σ A 𝐂one-over

  apex←𝐂one : 𝐂one → A
  apex←𝐂one = fst
}
}

\subtree[tot-AA23]{
\title{The apex map as a base change}
\taxon{Lemma}

\p{The apex map #{A_{/ϕ} \to A} is a base change of the slice map
#{(A^\mathcal{K})_{/ϕ} \to A^{\mathcal{K}}} along the diagonal map.}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  𝐒lice-proj←apex : Arrow-map (apex←𝐂one ϕ) (𝐒lice-proj: ϕ)
  𝐒lice-proj←apex .Arrow-Π.top
    = postcomp (𝐂one ϕ)
        (λ x → x .snd .Homᵈ.hom , x .snd .Homᵈ.hom1)
        (total-map (λ _ → Hom←Nat))
  𝐒lice-proj←apex .Arrow-Π.bot = const
  𝐒lice-proj←apex .Arrow-Π.comm (a , h) = sym (funext→ (Homᵈ.hom0 ∘ h))

  opaque
    apex-base-change-of-𝐒lice-proj : is-cartesian 𝐒lice-proj←apex
    apex-base-change-of-𝐒lice-proj a
      = is-equiv-∘~
          (λ where (_ , refl) → fibre-path→ (refl , ∙-reflr _ ∙ sym-sym))
          (eqv ._≃_.fwd-is-equiv)
          (fibre-is-equiv←Slice-equiv
            (mk-slice-equiv {q = fst} (Σ-snd-≃ λ _ → Nat≃Hom e⁻¹) ~refl)
            (a))
      where

      eqv : fibre (fst: λ a → Hom (K → A) (const a) ϕ) a ≃ fibre (𝐒lice-proj: ϕ) (const a)
      eqv ._≃_.fwd ((a , h) , refl) = ((h .Homᵈ.hom , h .Homᵈ.hom1) , h .Homᵈ.hom0)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .fst ((f , p) , q) = ((a , mk-hom f q p) , refl)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .fst (_ , refl) = refl
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .snd = ~refl
      eqv ._≃_.fwd-is-equiv .is-equiv.coherent (_ , refl) = refl
}
}

\subtree[tot-2A5I]{
\taxon{Lemma}
\title{Cone types as comma types}

\p{For any map #{\phi : K \to A}, the cone #{A_{/\phi}} is equivalent to the
comma type of the span #{A \to A^K \leftarrow \{\phi\}}.}

\agda{
𝐂one-directed-cone
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {K : Type 𝓥}
      (ϕ : K → A)
    → directed-cone (mk-cospan (K → A) (const: A K) (point ϕ)) (𝐂one ϕ)
𝐂one-directed-cone F .directed-cone.p (a , _) = a
𝐂one-directed-cone F .directed-cone.q = !
𝐂one-directed-cone F .directed-cone.filler (_ , α) = Hom←Nat α

𝐂one-has-up-comma
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} (F : I → C)
    → up-comma (𝐂one-directed-cone F)
𝐂one-has-up-comma F
  = is-equiv-∘
      eqv
      (postcomp-equiv
        (is-total-equiv←is-fibrewise-equiv (λ _ → bwd-is-equiv Nat≃Hom)))
  where

  eqv : is-equiv (directed-cone-map (mk-directed-cone fst ! snd))
  eqv .is-equiv.qinv .fst cone x = (cone .directed-cone.p x , cone .directed-cone.filler x)
  eqv .is-equiv.qinv .snd .fst = ~refl
  eqv .is-equiv.qinv .snd .snd = ~refl
  eqv .is-equiv.coherent = ~refl
}
}

\subtree[tot-BZC1]{
\title{Identity types of cones}

\agda{
𝐂one-Id
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → 𝐂one F → 𝐂one F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
𝐂one-Id a b
  = Σ[ p ∶ (a .fst ＝ b .fst) ]
       (∀ i → Hom-pathᵈ p refl (a .snd i) (b .snd i))

𝐂one-Id-refl
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → (p : 𝐂one F) → 𝐂one-Id p p
𝐂one-Id-refl a = (refl , λ _ → Hom-pathᵈ-refl)

opaque
  𝐂one-Id-is-torsorial
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → (F : 𝐂one F) → is-torsorial (𝐂one-Id F)
  𝐂one-Id-is-torsorial F
    = is-singleton-structure←parts
        Sing-is-singleton
        (_ , refl)
        (SingS-is-single ⦃ IdS-Π ⦃ Hom-IdSᵈ ⦄ ⦄ _)

instance
  𝐂one-IdS
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → Identity-system (𝐂one F) (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  𝐂one-IdS .Identity-system.IdS = 𝐂one-Id
  𝐂one-IdS .Identity-system.IdS←Id refl = 𝐂one-Id-refl _
  𝐂one-IdS .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (𝐂one-Id-is-torsorial a) _

opaque
  𝐂one-Id→
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝐂one F}
      → 𝐂one-Id x y → x ＝ y
  𝐂one-Id→ = Id←IdS ⦃ 𝐂one-IdS ⦄

  𝐂one-Id-is-equiv
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : 𝐂one F}
      → is-equiv (𝐂one-Id→ {x = x} {y})
  𝐂one-Id-is-equiv
    = is-equiv⁻¹ (𝐂one-IdS .Identity-system.IdS←Id-is-equiv _ _)

  𝐂one-Id-ap-fst
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C} {a b : 𝐂one F}
      → (p : 𝐂one-Id a b) → ap fst (𝐂one-Id→ p) ＝ fst p
  𝐂one-Id-ap-fst
    = IdSJ ⦃ 𝐂one-IdS ⦄ (λ x → ap fst (Id←IdS (x .snd)) ＝ fst (x .snd))
           (ap (ap fst) (Id←IdS←Id refl))
}
}

\subtree[tot-110C]{
\title{Cones and slice types}
\taxon{Lemma}

\p{The cone of a point #{C_{/c}} is equivalent to the slice #{C_{/c}}.}

\agda{
𝐂one-point≃𝐒lice
  : ∀ {𝓤} {A : Type 𝓤} (a : A)
    → 𝐂one (point a) ≃ 𝐒lice a
𝐂one-point≃𝐒lice a = Σ-snd-≃ (λ b → unit-UP≃) ∙e 𝐒lice-hom-repr≃ a
}
}

\subtree[tot-1101]{
\title{Functoriality of cones at a fixed type}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-26}

\p{Fixing a type #{A}, the under type former determines a functor from
#{\Type_{/A} \to \Type}.}

\agda{
𝐂one₁
  : ∀ {𝓤 𝓚 𝓚'} {A : Type 𝓤}
      {K : Type 𝓚} {p : K → A}
      {K' : Type 𝓚'} {q : K' → A}
      (t : Slice-map q p)
    → 𝐂one p → 𝐂one q
𝐂one₁ {p = p} {q = q} (f , H)
  = total-map λ a
      → postcomp-Π (λ k' → adjust-hom refl (H k'))
      ∘ precomp-Π (λ k → Hom _ a (p k)) f
}
}
