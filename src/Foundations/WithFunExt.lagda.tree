\title{Consequences of function extensionality}
\taxon{Module}
\date{2026-06-26}
\import{stt-macros}

\p{This module serves as an interface into the part of the \code{Foundations}
namespace which uses the axiom of [function
extensionality](Foundations.FunExt). Unlike in \ref{Axioms.FunExt} we do not
postulate function extensionality in this module, and instead we parameterise this
module over some proof of global function extensionality. This way we may reason with
function extensionality with other proofs, such as the one [derived from
univalence](Foundations.FunExtFromUnivalence) or [from the existence of pushouts with
definitional computation for point constructors](stt-00VG).}

\agda{
open import Foundations.FunExt

module Foundations.WithFunExt (global-funext : FunExt-global) where

open import Foundations.Prelude
open import Foundations.FunExt
open import Foundations.Retracts
open import Foundations.IdempotentMaps
}

\agda{
open WithFunExt-global global-funext public

import Foundations.CanonicalPullbacks
open Foundations.CanonicalPullbacks.CanonicalPullbacksWithFunExt global-funext public
open Foundations.CanonicalPullbacks.WithFunExt-gap global-funext public
import Foundations.PathSplit
open Foundations.PathSplit.PSWithFunExt global-funext public
open import Foundations.IsEquivIsProp global-funext public
open import Foundations.BiinvertibleMaps public
open Foundations.BiinvertibleMaps.BiinvWithFunExt global-funext public
open import Foundations.EmptyUP global-funext public
open import Foundations.SingletonClosure public hiding (Π-is-single)
open import Foundations.PropClosure public
  hiding (Π-is-prop; Πᵢ-is-prop; →-is-prop; ¬-is-prop)
import Foundations.Truncated
open Foundations.Truncated.TruncatedWithFunExt global-funext public
open Foundations.Truncated.InstancesWithFunExt global-funext public
import Foundations.Sets
open Foundations.Sets.SetsWithFunExt global-funext public
open import Foundations.SingletonProp global-funext public
open import Foundations.CompositionEquiv global-funext public
open import Foundations.CompositionFibres global-funext public
open import Foundations.NullHomotopy global-funext public
open Foundations.IdempotentMaps.IdemWithFunExt global-funext public
open Foundations.IdempotentMaps.QIdemWithFunExt global-funext public
open Foundations.IdempotentMaps.QIdemWithFunExt2 global-funext public
open Foundations.IdempotentMaps.CohIdemWithFunExt global-funext public
open RetractWithFunExt global-funext public
import Foundations.HomotopyEquiv
import Foundations.Spans

open import Foundations.WeakFunExt

module HE {𝓤} = Foundations.HomotopyEquiv {𝓤} global-funext
open HE public
}

\agda{
weak-funext
  : ∀ {𝓤 𝓥} → Weak-funext 𝓤 𝓥
weak-funext = weak-funext←funext global-funext

Π-is-single = weak-funext

Πᵢ-is-single
  : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : A → Type 𝓥}
  → ({a : A} → is-singleton (B a)) → is-singleton ({a : A} → B a)
Πᵢ-is-single = Πᵢ-is-single←weak-funext weak-funext

Π-is-prop
  : ∀ {𝓤 𝓥 : Level} {A : Type 𝓤} {B : A → Type 𝓥}
    → ((a : A) → is-prop (B a))
    → is-prop (Π A B)
Π-is-prop = Foundations.PropClosure.Π-is-prop global-funext

Πᵢ-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
    → (∀ {a} → is-prop (B a))
    → is-prop (∀ {a} → B a)
Πᵢ-is-prop = Foundations.PropClosure.Πᵢ-is-prop weak-funext

→-is-prop
  : ∀ {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥}
    → is-prop B
    → is-prop (A → B)
→-is-prop = Foundations.PropClosure.→-is-prop global-funext

¬-is-prop
  : ∀ {𝓤} {A : Type 𝓤}
    → is-prop (¬ A)
¬-is-prop = Foundations.PropClosure.¬-is-prop global-funext

funext-redex
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      {f g : (a : A) → B a } → {p : f ~ g}
    → happly (funext→ p) ＝ p
funext-redex {p = p} = is-equiv.ε global-funext p

Cocone-path→
  : ∀ {𝓤 𝓥 𝓦} {S : Span 𝓤 𝓥 𝓦} {𝓛} {X : Type 𝓛}
    → (c c' : Cocone S X)
    → (p : c .Cocone.p ＝ c' .Cocone.p)
    → (q : c .Cocone.q ＝ c' .Cocone.q)
    → (c .Cocone.filler ∙h happly q ▹h S .Span.right
         ~ happly p ▹h S .Span.left ∙h c' .Cocone.filler)
    → c ＝ c'
Cocone-path→ = Foundations.Spans.Cocone-path→ global-funext
}
