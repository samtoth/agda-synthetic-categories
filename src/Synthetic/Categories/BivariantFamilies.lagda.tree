\title{Bivariant type families}
\author{fredrikbakke}
\date{2026-09-19}
\taxon{Module}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.BivariantFamilies
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.GlobalClassesMaps
open import Core.Orthogonal
open import Core.OrthogonalClosure
open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.ContravariantFamilies Δ¹ I
}
}

\subtree[bak-8ED4]{
\title{Bivariant families}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-19}

\p{
A family is \em{bivariant} if it is both [covariant](stt-00AY) and
[contravariant](stt-00OD).
}

\agda{
fam-generators-bivariant : Bool → 𝟙 → Δ¹
fam-generators-bivariant false = point i0
fam-generators-bivariant true = point i1

module Bivariant = RightOrthogonalClassClosure fam-generators-bivariant

is-bivariant : ∀ {𝓤 𝓥} {A : Type 𝓤} → (A → Type 𝓥) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
is-bivariant P = Bivariant.∈R (fst: P)

is-bivariant-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) → is-prop (is-bivariant P)
is-bivariant-is-prop P = ∈-is-prop (gClass-maps.𝓕-fam Bivariant.R-gClass) P

module _ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) where

  is-covariant←is-bivariant : is-bivariant P → is-covariant P
  is-covariant←is-bivariant bi = is-covariant←is-left-fibration P (bi false)

  is-contravariant←is-bivariant : is-bivariant P → is-contravariant P
  is-contravariant←is-bivariant bi
    = is-contravariant←is-right-fibration P (bi true)

  is-bivariant↔covariant-and-contravariant
    : is-bivariant P ↔ (is-covariant P × is-contravariant P)
  is-bivariant↔covariant-and-contravariant .fst bi
    = ( is-covariant←is-bivariant bi
      , is-contravariant←is-bivariant bi)
  is-bivariant↔covariant-and-contravariant .snd (cov , contrav) false
    = is-left-fibration←is-covariant P cov
  is-bivariant↔covariant-and-contravariant .snd (cov , contrav) true
    = is-right-fibration←is-contravariant P contrav

is-bivariant-is-Δ¹-relative : is-relative-fam Δ¹ is-bivariant
is-bivariant-is-Δ¹-relative P .fst bi σ b
  = are-orthogonal-fst←are-orthogonal-fam
      (λ τ → are-orthogonal-fam←are-orthogonal-fst (bi b) (σ ∘ τ))
is-bivariant-is-Δ¹-relative P .snd bi b
  = are-orthogonal-fst←are-orthogonal-fam
      (λ σ → are-orthogonal-fam←are-orthogonal-fst (bi σ b) id)
}
}

\subtree[bak-99A2]{
\title{Bivariant transport is an equivalence}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Transport between fibres in a bivariant family gives equivalences.
}
\proof{
\p{
Let #{P \colon A \to \UV} be a bivariant family and let #{f : \Hom_A(x,y)}.
By covariance evaluation at #{0} gives an equivalence
#{P(x) \simeq \Pi_{\Delta^1}(P\circ f)}, and by contravariance evaluation at #{1}
gives an equivalence #{\Pi_{\Delta^1}(P\circ f) \simeq P(y)}.
}
}

\agda{
module _
  {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
  (bi : is-bivariant P)
  where

  tr≃←is-bivariant : (h : Δ¹ → A) → P (h i0) ≃ P (h i1)
  tr≃←is-bivariant h
    = P (h i0)
        ≃⟨ ev-i0≃←is-covariant {P = P} (is-covariant←is-bivariant P bi) h e⁻¹ ⟩
      Π Δ¹ (P ∘ h)
        ≃⟨ ev-i1≃←is-contravariant {P = P} (is-contravariant←is-bivariant P bi) h ⟩
      P (h i1)
        ≃∎

  tr-hom≃←is-bivariant : {x y : A} → Hom A x y → P x ≃ P y
  tr-hom≃←is-bivariant (mk-hom h refl refl) = tr≃←is-bivariant h
}
}
