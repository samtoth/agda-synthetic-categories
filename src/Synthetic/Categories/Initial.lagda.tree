\subtree[stt-00FO]{
\title{Initial objects}
\taxon{Definition}

\p{
We call an object #{a : A} \em{initial} if for every #{b : A}, the type #{\Hom(a,b)}
is a singleton.
}

\agda{
is-initial : ∀ {𝓤} {A : Type 𝓤} → A → Type (𝓘 ⊔ 𝓤)
is-initial {A = A} a = (b : A) → is-singleton (Hom A a b)

is-initial-is-prop : ∀ {𝓤} {A : Type 𝓤} {a : A} → is-prop (is-initial a)
is-initial-is-prop = Π-is-prop (λ _ → is-single-is-prop)

initial-obj : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
initial-obj A = Σ A is-initial

Type-With-Initial-Obj : (𝓤 : Level) → Type (𝓘 ⊔ lsuc 𝓤)
Type-With-Initial-Obj 𝓤 = Σ (Type 𝓤) initial-obj
}
}

\subtree[fre-0000]{
\title{Hom-section condition for initial objects}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-06}

\p{
Let #{A} be a [Segal type](stt-00AI), and let #{a : A}. Then #{a} is
[initial](stt-00FO) if and only if there is a morphim #{h_y : \Hom_A(a,y)} for every
#{y : A} such that #{h_a = \id_a}.
}

\proof{
\p{
The forward direction is obvious. For the converse, we note that naturality of #{h}
gives #{f \circ h(a) = h(b)} for every #{f : \Hom_A(a,b)}. Since #{h(a) = \id_a}, we
have #{f = h(b)}, so #{h(b)} is the centre of a contraction of #{\Hom_A(a,b)}.
}
}

\agda{
is-initial←hom-section
  : ∀ {𝓤} {A : Type 𝓤} (𝐴 : is-segal A) {a : A}
    → (h : (b : A) → Hom A a b)
    → h a ＝ idH a
    → is-initial a
is-initial←hom-section {A = A} 𝐴 {a} h ha b .centre
  = h b
is-initial←hom-section {A = A} 𝐴 {a} h ha b .central f
  = sym
    ( tr-cov-hom-unique (Hom A a) (hom-fam-cov 𝐴 a) f (h a) (h b) (ap-hom-over h f))
  ∙ ap (tr-cov-hom (hom-fam-cov 𝐴 a) f) ha
  ∙ CovariantActionPostcomp.tr-cov-hom-is-comp 𝐴 f (idH a)
  ∙ ∘[ 𝐴 ]-left-unit
}
}

\subtree[stt-00FP]{
\taxon{Lemma}

\p{An object #{a} is initial iff the codomain projection #{A_{a/} \to A} is
an equivalence.}

\proof{
\p{Follows by considering fibres.}
}

\agda{
is-initial←slice-proj-is-equiv
  : ∀ {𝓤} {A : Type 𝓤} a
    → is-equiv (λ ((f , _) : Σ[ f ∶ (Δ¹ → A)] (f i0 ＝ a)) → f i1)
    → is-initial a
is-initial←slice-proj-is-equiv a eq b
  = is-single←equiv-to-single
      (Σ-assoc ∙e Homᵈ-repr≃ e⁻¹)
      (has-singleton-fibres←is-equiv eq b)
}
}

\subtree[stt-00G0]{
\taxon{Lemma}
\title{Initial objects are preserved by left adjoints}

\p{
For a map #{l : A \to B}, if there is a map #{r} with #{l \dashv r},
#{l(a)} is an initial object of #{B} if #{a} is initial in #{A}.
}

\agda{
is-initial←ladj
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {a : A}
    → (l : A → B) (r : B → A)
    → (l ⊣ r)
    → is-initial a
    → is-initial (l a)
is-initial←ladj f g fg ai b
  = is-single←equiv-to-single (fg _ b e⁻¹) (ai (g b))
}

\p{
In particular, since [equivalences are left adjoints](stt-00G2), they also preserve
initial objects.
}

\agda{
opaque
  is-initial←is-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {a : A}
      → {F : A → B} → is-equiv F
      → is-initial a → is-initial (F a)
  is-initial←is-equiv {F = F}
    = is-initial←ladj F _  ∘ is-left-adjoint←is-equiv
}
}

\subtree[stt-00LJ]{
\title{Initiality in the coslice}
\taxon{Theorem}
\author{samueltoth}
\author{fredrikbakke}

\p{
If #{A} is a precategory, then #{(a , \id)} is an initial object in the representable
coslice #{\Sigma_{x : A}\Hom_A(a,x)}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} (𝐴 : is-segal A) where

  tr-cov-hom-idH
    : {a b : A} (f : Hom A a b)
    → tr-cov-hom (hom-fam-cov 𝐴 a) f (idH a) ＝ f
  tr-cov-hom-idH f
    = CovariantActionPostcomp.tr-cov-hom-is-comp 𝐴 f (idH _)
    ∙ ∘[ 𝐴 ]-left-unit

  Sing'-Hom≃Hom-repr-coslice
    : {a b : A} (f : Hom A a b)
    → Sing' (Hom A a b) f ≃ Hom (Σ A (Hom A a)) (a , idH a) (b , f)
  Sing'-Hom≃Hom-repr-coslice {a} f
    = Σ-snd-≃
        (λ g → ＝-postconcat-≃ (tr-cov-hom-idH g)
             ∙e Hom-cov'≃ (Hom A a) (hom-fam-cov 𝐴 a) g (idH a) f)
    ∙e Hom-Σ≃ e⁻¹

  coslice-init'
    : (a : A) → is-initial {A = Σ A (Hom A a)} (a , idH a)
  coslice-init' a (b , f)
    = is-single←equiv-to-single (Sing'-Hom≃Hom-repr-coslice f) Sing'-is-singleton
}

\p{
As a corollary, if #{A} is Segal then #{(a , \id)} is an initial object in #{A_{a/}}.
}

\agda{
coslice-init
  : {𝓤 : Level} {A : Type 𝓤} (𝐴 : is-segal A) (a : A)
  → is-initial (a , λ _ → idH a)
coslice-init 𝐴 a
  = is-initial←is-equiv
      (Σ-snd-≃ (λ _ → unit-UP≃ e⁻¹) ._≃_.fwd-is-equiv)
      (coslice-init' 𝐴 a)
}
}

\subtree[stt-00V6]{
\title{The point inclusion of an initial object is left anodyne}
\taxon{Lemma}
\author{fredrikbakke}
\author{samueltoth}
\date{2026-09-03}

\p{
The point inclusions of [initial objects](stt-00FO) are left anodyne.
}

\p{
We give a mild generalisation of \citet{Thm 9.7}{RS17}. Namely, we formalise the
result under the assumption of a family of morphisms
#{h_{(-)} : \Pi_{(b : A)} \Hom_A(a,b)} such that #{h_a = \id_a}. When the underlying
type is Segal, this condition is equivalent to initiality of #{a} and recovers
the cited theorem.
}

\agda{
module _
  {𝓤} {A : Type 𝓤}
  {a : A} (h : (b : A) → Hom A a b) (ha : h a ＝ idH a)
  {𝓥} {P : A → Type 𝓥} (P-is-covariant : is-covariant P)
  where

  ind-init' : P a → (x : A) → P x
  ind-init' p x = tr-cov-hom P-is-covariant (h x) p

  ind-init-β' : (p : P a) → ind-init' p a ＝ p
  ind-init-β' = tr-cov-idH~ P P-is-covariant _ ha

  ind-init-η' : (s : (x : A) → P x) → ind-init' (s a) ＝ s
  ind-init-η' s = funext→ λ b
    → tr-cov-hom-unique P P-is-covariant (h b) (s a) (s b) (ap-hom-over s (h b))

  ev-init-covariant-is-equiv' : is-equiv (evᵈ: P a)
  ev-init-covariant-is-equiv'
    = is-equiv←qinv (ind-init' , ind-init-η' , ind-init-β')

  ind-init-is-equiv' : is-equiv ind-init'
  ind-init-is-equiv' = is-equiv⁻¹ ev-init-covariant-is-equiv'

point-init-is-left-anodyne'
  : ∀ {𝓤} {A : Type 𝓤} {a : A}
      (h : (b : A) → Hom A a b)
    → h a ＝ idH a
    → is-left-anodyne (point a)
point-init-is-left-anodyne' h ha r r-is-left
  = are-orthogonal←are-orthogonal-fibre λ σ
    → 3-for-2
        (unit-ev-is-equiv)
        (ev-init-covariant-is-equiv' h ha
          (is-covariant←is-left-family
            (fibre r ∘ σ)
            (orthogonal-fam←base-change
              (point i0) σ (fibre r)
              (are-orthogonal-fibre←are-orthogonal r-is-left))))

point-init-is-left-anodyne
  : ∀ {𝓤} {A : Type 𝓤} {a : A} → is-initial a → is-left-anodyne (point a)
point-init-is-left-anodyne {a = a} a-is-initial
  = point-init-is-left-anodyne'
      (λ b → a-is-initial b .centre) (a-is-initial a .central (idH a))
module _
  {𝓤} {A : Type 𝓤} {a : A} (a-is-initial : is-initial a)
  {𝓥} {P : A → Type 𝓥} (P-is-covariant : is-covariant P)
  where

  ev-init-covariant-is-equiv : is-equiv (evᵈ: P a)
  ev-init-covariant-is-equiv
    = ev-init-covariant-is-equiv'
        (λ b → a-is-initial b .centre)
        (a-is-initial a .central (idH a))
        (P-is-covariant)

  opaque
    ind-init : P a → (x : A) → P x
    ind-init = is-equiv.bwd ev-init-covariant-is-equiv

    ind-init-is-equiv : is-equiv ind-init
    ind-init-is-equiv = is-equiv⁻¹ ev-init-covariant-is-equiv

    ind-init-β : (p : P a) → ind-init p a ＝ p
    ind-init-β = is-equiv.ε ev-init-covariant-is-equiv
}
}


\subtree[stt-00FS]{
\title{Sections of types with initial objects}
\taxon{Lemma}
\citet{Thm 9.7}{RS17}

\p{
If #{A} is a type with an [initial object](stt-00FO) #{a}, and #{P} a
[covariant family](stt-00AY) over #{A}, then the evaluation map at #{a} is an
[equivalence](stt-001U) #{(\Pi_{x}P(x)) \toeq P(a)}.
}

\proof{
\p{
We first give the inverse map. Given a partial section at #{a}, #{x : P(a)},
we use the covariance of #{P} and the fact #{a} is initial to transport #{x}
to a full section: #{(x : P(a)) \mapsto ¡_{b}^*(x) : P(b)}. This map is
an equivalence by virtue of the uniqueness of covariant transport.
}
}

}
