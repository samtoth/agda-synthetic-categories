\subtree[stt-00IY]{
\title{The action of Flat on squares}
\taxon{Construction}

\p{Since #{\flat} is a functor, we have an action on commuting squares.}


\agda{
♭Square
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} {@♭ f : A → B} {@♭ g : C → D}
      (@♭ F : Arrow-map f g)
    → Arrow-map (♭-map f) (♭-map g)
♭Square F .Arrow-map.top = ♭-map (F .Arrow-map.top)
♭Square F .Arrow-map.bot = ♭-map (F .Arrow-map.bot)
♭Square F .Arrow-map.comm (mod♭ x) = ap♭ mod♭ (F .Arrow-map.comm x)
}

\p{
This action preserves identity and composition.
}

\agda{
♭Square-∘
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜 𝓧 𝓨}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}  {@♭ f : A → B}
      {@♭ C : Type 𝓦} {@♭ D : Type 𝓜} {@♭ g : C → D}
      {@♭ X : Type 𝓧} {@♭ Y : Type 𝓨}  {@♭ h : X → Y}
      (@♭ F : Arrow-map f g)
      (@♭ G : Arrow-map g h)
    → Arrow-map-path
        (paste-squares (♭Square G) (♭Square F))
        (♭Square (paste-squares G F))
♭Square-∘ F G .fst = ♭-ind (λ x → refl)
♭Square-∘ F G .snd .fst = ♭-ind (λ x → refl)
♭Square-∘ F G .snd .snd = ♭-ind
  (λ x
   → ∙-reflr _
   ∙ ap
       (_∙ ap♭ mod♭ (G .Arrow-Π.comm (F .Arrow-Π.top x)))
       (ap-♭-map (G .Arrow-map.bot) (F .Arrow-map.comm x))
   ∙ sym (ap♭-∙ mod♭ _ (G .Arrow-map.comm (F .Arrow-map.top x))))

♭Square-id
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
    → Arrow-map-path (♭Square (id-square {f = f})) id-square
♭Square-id .fst = ♭-id
♭Square-id .snd .fst = ♭-id
♭Square-id .snd .snd = ♭-ind λ x → refl
}
}

\subtree[tot-0D5S]{
\taxon{Lemma}
\title{#{♭} preserves equivalences of arrows}

\agda{
♭-square-is-equiv
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} {@♭ f : A → B} {@♭ g : C → D}
      (@♭ F : Arrow-map f g)
    → @♭ is-Arrow-equiv F
    → is-Arrow-equiv (♭Square F)
♭-square-is-equiv F Fe .fst = is-♭-equiv←is-equiv (Fe .fst)
♭-square-is-equiv F Fe .snd = is-♭-equiv←is-equiv (Fe .snd)

♭-arrow-equiv
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} {@♭ f : A → B} {@♭ g : C → D}
      (@♭ F : Arrow-equiv f g)
    → Arrow-equiv (♭-map f) (♭-map g)
♭-arrow-equiv F .fst = ♭Square (F .fst)
♭-arrow-equiv F .snd = ♭-square-is-equiv (F .fst) (F .snd)
}
}

\subtree[tot-SLDP]{
\title{#{\flat} preserves cartesian squares}
\taxon{Lemma}

\p{In \ref{stt-0058}, we observed that the #{\flat} modality preserves pullbacks.
We can express this property in terms of cartesian squares:}

\agda{
♭-is-cartesian
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} {@♭ f : A → B} {@♭ g : C → D}
      (@♭ F : Arrow-map f g)
    → @♭ is-cartesian F
    → is-cartesian (♭Square F)
♭-is-cartesian F Fc
  = is-cartesian←is-pullback
      (♭Square F)
      (is-equiv-~∘ {f = _≃_.bwd (♭-pb-repr3 _ _)}
                  {g = ♭-pb' ∘ ♭-map (gap-map←square F)}
        (λ where (mod♭ x) → pullback-path→
                             ( refl
                             , refl
                             , strong-J♭
                                  (λ _ p → mapply♭ (mod♭ p) ＝ ap♭ mod♭ p ∙ refl)
                                  refl
                                  (Arrow-map.comm F x)))
        (bwd-is-equiv (♭-pb-repr3 _ _))
        (is-equiv-∘ (bwd-is-equiv ♭-pres-pb)
                    (is-♭-equiv←is-equiv (is-pullback←is-cartesian F Fc))))
}
}

\subtree[tot-5920]{
\title{The action of #{♭} on [arrow map homotopies]()}
\taxon{Construction}
\date{2026-09-09}

\agda{
♭Arrow-map-path
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}  {@♭ f : A → B}
      {@♭ C : Type 𝓦} {@♭ D : Type 𝓜} {@♭ g : C → D}
      (@♭ F G : Arrow-map f g)
    → @♭ Arrow-map-path F G
    → Arrow-map-path (♭Square F) (♭Square G)
♭Arrow-map-path F G p .fst = ♭-ind (λ x → mapply♭ (mod♭ (p .fst x)))
♭Arrow-map-path F G p .snd .fst = ♭-ind λ x → mapply♭ (mod♭ (p .snd .fst x))
♭Arrow-map-path {f = f} {g = g} F G p .snd .snd = ♭-ind λ x
  → ap (ap♭ mod♭ (F .Arrow-Π.comm x) ∙_) (ap-♭-map' g (p .fst x))
  ∙ sym (ap♭-∙ mod♭ (F .Arrow-map.comm x) _)
  ∙ ap♭ (ap♭ mod♭) (p .snd .snd x)
  ∙ ap♭-∙ mod♭ _ (G .Arrow-map.comm x)
  ∙ ap (_∙ ap♭ mod♭ (G .Arrow-map.comm x)) (mapply♭＝ap♭-mod♭ (p .snd .fst (f x)))
}
}

\subtree[tot-9692]{
\title{The action of #{\flat} on retracts of arrows}
\taxon{Construction}
\date{2026-09-10}

\agda{
♭-retraction-arrow-map
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
      {@♭ X : Type 𝓦} {@♭ Y : Type 𝓜} {@♭ g : X → Y}
      (@♭ F : Arrow-map f g)
    → @♭ retraction-arrow-map F
    → retraction-arrow-map (♭Square F)
♭-retraction-arrow-map F (G , r)
  = mk-retraction-arrow-map
      (♭Square F) (♭Square G)
      (Arrow-map-path-∙
        {G = paste-squares (♭Square G) (♭Square F)}
        {H = ♭Square (paste-squares G F)}
        {K = id-square}
        (♭Square-∘ _ _)
        (Arrow-map-path-∙
          (♭Arrow-map-path _ _ (retraction-arrow-map-is-retraction F (G , r)))
          ♭Square-id))

♭-Arrow-retract
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
      {@♭ X : Type 𝓦} {@♭ Y : Type 𝓜} {@♭ g : X → Y}
    → @♭ Arrow-retract f g
    → Arrow-retract (♭-map f) (♭-map g)
♭-Arrow-retract (F , Fr) = (♭Square F , ♭-retraction-arrow-map _ Fr)
}
}

\subtree[stt-00IX]{
\taxon{Definition}
\title{Cohesive orthogonality}

\p{Crisp maps #{f} and #{g} are called crisply orthogonal iff the
[crisp square](stt-00IY) of the [pullback power](stt-004D) is cartesian.
(Note that this is not the same as #{\flat f} being orthogonal
to #{\flat g}.)}

\agda{
are-♭-orthogonal
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} (@♭ f : A → B) (@♭ g : C → D)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
are-♭-orthogonal f g
  = is-cartesian (♭Square (power-hom f g))

is-♭-orthogonal-type
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      (@♭ f : A → B) (@♭ X : Type 𝓦)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
is-♭-orthogonal-type f X = is-♭-equiv (precomp X f)
}

\p{We also have that any crisp pair of maps are #{\flat}-orthogonal if they are
orthogonal. The converse may not hold in general.}

\agda{
are-♭-orthogonal←are-orthogonal
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
      {@♭ D : Type 𝓜} {@♭ f : A → B} {@♭ g : C → D}
    → @♭ are-orthogonal f g → are-♭-orthogonal f g
are-♭-orthogonal←are-orthogonal fg
  = ♭-is-cartesian _ (is-cartesian←are-orthogonal fg)
}
}

\subtree[stt-00JW]{
\title{Orthogonality at the terminal map}
\taxon{Lemma}

\p{We have #{f \perp X} iff #{f \perp !_X}}

\agda{
are-♭-orthogonal-!←is-orthogonal-type
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      {@♭ f : A → B} {@♭ X : Type 𝓦}
    → is-♭-orthogonal-type f X → are-♭-orthogonal f (!: X)
are-♭-orthogonal-!←is-orthogonal-type {f = f} {X} fo
  = is-cartesian←is-Arrow-equiv _
      ( fo
      , is-♭-equiv←is-equiv
          (is-equiv←single-to-prop
            (is-singleton←is-truncated trunc!)
            (is-prop←is-truncated trunc!)
            _)
      )
}
}
