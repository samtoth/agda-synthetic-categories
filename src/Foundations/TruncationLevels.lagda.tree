\date{2026-04-24}
\title{Truncation levels}
\author{fredrikbakke}
\taxon{Module}

\import{stt-macros}

\agda{
module Foundations.TruncationLevels where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Nat
open import Foundations.Identity
}
}

\subtree[stt-00NN]{
\date{2026-04-24}
\author{fredrikbakke}
\title{Truncation levels}
\taxon{Definition}

\agda{
data 𝕋 : Type where
  -2𝕋 : 𝕋
  suc-𝕋 : 𝕋 → 𝕋

-1𝕋 0𝕋 1𝕋 2𝕋 : 𝕋
-1𝕋 = suc-𝕋 -2𝕋
0𝕋  = suc-𝕋 -1𝕋
1𝕋  = suc-𝕋 0𝕋
2𝕋  = suc-𝕋 1𝕋

{-# DISPLAY suc-𝕋 -2𝕋 = -1𝕋 #-}
{-# DISPLAY suc-𝕋 -1𝕋 = 0𝕋 #-}
{-# DISPLAY suc-𝕋 0𝕋 = 1𝕋 #-}
{-# DISPLAY suc-𝕋 1𝕋 = 2𝕋 #-}

trunc-index : 𝕋 → ℕ
trunc-index -2𝕋 = 0
trunc-index (suc-𝕋 n) = suc (trunc-index n)

trunc-level : ℕ → 𝕋
trunc-level 0 = -2𝕋
trunc-level (suc n) = suc-𝕋 (trunc-level n)

sucit-𝕋 : 𝕋 → ℕ → 𝕋
sucit-𝕋 n zero = n
sucit-𝕋 n (suc k) = suc-𝕋 (sucit-𝕋 n k)
}

\p{
We give an unnatural definition for \code{itsuc-𝕋} to get a reduction behaviour that
appeases the instance resolution algorithm.
}

\agda{
itsuc-𝕋 : ℕ → 𝕋 → 𝕋
itsuc-𝕋 n -2𝕋 = trunc-level n
itsuc-𝕋 n (suc-𝕋 t) = suc-𝕋 (itsuc-𝕋 n t)

itsuc-𝕋-zero : ∀ k → itsuc-𝕋 0 k ＝ k
itsuc-𝕋-zero -2𝕋 = refl
itsuc-𝕋-zero (suc-𝕋 k) = ap suc-𝕋 (itsuc-𝕋-zero k)

itsuc-𝕋-sucl : ∀ n k → itsuc-𝕋 (suc n) k ＝ suc-𝕋 (itsuc-𝕋 n k)
itsuc-𝕋-sucl n -2𝕋 = refl
itsuc-𝕋-sucl n (suc-𝕋 k) = ap suc-𝕋 (itsuc-𝕋-sucl n k)

itsuc=sucit-𝕋 : ∀ {n k} → itsuc-𝕋 n k ＝ sucit-𝕋 k n
itsuc=sucit-𝕋 {zero} {k} = itsuc-𝕋-zero k
itsuc=sucit-𝕋 {suc n} {k} = itsuc-𝕋-sucl n k ∙ ap suc-𝕋 (itsuc=sucit-𝕋 {n} {k})

𝕋←ℕ : ℕ → 𝕋
𝕋←ℕ n = itsuc-𝕋 n 0𝕋

neg-𝕋 : ℕ → 𝕋
neg-𝕋 0 = 0𝕋
neg-𝕋 1 = -1𝕋
neg-𝕋 (suc (suc n)) = -2𝕋
}
}

\subtree[stt-011C]{
\date{2026-09-16}
\author{fredrikbakke}
\title{Truncation levels starting at #{-1}}
\taxon{Definition}

\agda{
data 𝕋₋₁ : Type where
  -1𝕋₋₁ : 𝕋₋₁
  suc-𝕋₋₁ : 𝕋₋₁ → 𝕋₋₁

0𝕋₋₁ 1𝕋₋₁ 2𝕋₋₁ : 𝕋₋₁
0𝕋₋₁ = suc-𝕋₋₁ -1𝕋₋₁
1𝕋₋₁ = suc-𝕋₋₁ 0𝕋₋₁
2𝕋₋₁ = suc-𝕋₋₁ 1𝕋₋₁

{-# DISPLAY suc-𝕋₋₁ -1𝕋₋₁ = 0𝕋₋₁ #-}
{-# DISPLAY suc-𝕋₋₁ 0𝕋₋₁ = 1𝕋₋₁ #-}
{-# DISPLAY suc-𝕋₋₁ 1𝕋₋₁ = 2𝕋₋₁ #-}

trunc-index₋₁ : 𝕋₋₁ → ℕ
trunc-index₋₁ -1𝕋₋₁ = 0
trunc-index₋₁ (suc-𝕋₋₁ n) = suc (trunc-index₋₁ n)

trunc-level₋₁ : ℕ → 𝕋₋₁
trunc-level₋₁ 0 = -1𝕋₋₁
trunc-level₋₁ (suc n) = suc-𝕋₋₁ (trunc-level₋₁ n)

𝕋←suc-𝕋₋₁ : 𝕋₋₁ → 𝕋
𝕋←suc-𝕋₋₁ -1𝕋₋₁ = -2𝕋
𝕋←suc-𝕋₋₁ (suc-𝕋₋₁ n) = suc-𝕋 (𝕋←suc-𝕋₋₁ n)

𝕋←𝕋₋₁ : 𝕋₋₁ → 𝕋
𝕋←𝕋₋₁ n = suc-𝕋 (𝕋←suc-𝕋₋₁ n)

suc-𝕋←suc-𝕋₋₁ : (n : 𝕋₋₁) → suc-𝕋 (𝕋←suc-𝕋₋₁ n) ＝ 𝕋←𝕋₋₁ n
suc-𝕋←suc-𝕋₋₁ n = refl

suc-𝕋₋₁←𝕋 : 𝕋 → 𝕋₋₁
suc-𝕋₋₁←𝕋 -2𝕋 = -1𝕋₋₁
suc-𝕋₋₁←𝕋 (suc-𝕋 n) = suc-𝕋₋₁ (suc-𝕋₋₁←𝕋 n)

sucit-𝕋₋₁ : 𝕋₋₁ → ℕ → 𝕋₋₁
sucit-𝕋₋₁ n zero = n
sucit-𝕋₋₁ n (suc k) = suc-𝕋₋₁ (sucit-𝕋₋₁ n k)

itsuc-𝕋₋₁ : ℕ → 𝕋₋₁ → 𝕋₋₁
itsuc-𝕋₋₁ n -1𝕋₋₁ = trunc-level₋₁ n
itsuc-𝕋₋₁ n (suc-𝕋₋₁ t) = suc-𝕋₋₁ (itsuc-𝕋₋₁ n t)

itsuc-𝕋₋₁-zero : ∀ k → itsuc-𝕋₋₁ 0 k ＝ k
itsuc-𝕋₋₁-zero -1𝕋₋₁ = refl
itsuc-𝕋₋₁-zero (suc-𝕋₋₁ k) = ap suc-𝕋₋₁ (itsuc-𝕋₋₁-zero k)

itsuc-𝕋₋₁-sucl : ∀ n k → itsuc-𝕋₋₁ (suc n) k ＝ suc-𝕋₋₁ (itsuc-𝕋₋₁ n k)
itsuc-𝕋₋₁-sucl n -1𝕋₋₁ = refl
itsuc-𝕋₋₁-sucl n (suc-𝕋₋₁ k) = ap suc-𝕋₋₁ (itsuc-𝕋₋₁-sucl n k)

itsuc=sucit-𝕋₋₁ : ∀ {n k} → itsuc-𝕋₋₁ n k ＝ sucit-𝕋₋₁ k n
itsuc=sucit-𝕋₋₁ {zero} {k} = itsuc-𝕋₋₁-zero k
itsuc=sucit-𝕋₋₁ {suc n} {k}
  = itsuc-𝕋₋₁-sucl n k ∙ ap suc-𝕋₋₁ (itsuc=sucit-𝕋₋₁ {n} {k})

𝕋₋₁←ℕ : ℕ → 𝕋₋₁
𝕋₋₁←ℕ n = itsuc-𝕋₋₁ n 0𝕋₋₁

neg-𝕋₋₁ : ℕ → 𝕋₋₁
neg-𝕋₋₁ 0 = 0𝕋₋₁
neg-𝕋₋₁ (suc n) = -1𝕋₋₁
}
}
