\date{2026-07-03}
\title{Cartesian morphisms of polynomial endofunctors on types}
\author{fredrikbakke}
\import{stt-macros}
\taxon{Module}

\agda{
module Wild.PolynomialEndofunctors.CartesianMorphisms where

open import Wild.PolynomialEndofunctors
open import Wild.PolynomialEndofunctors.Morphisms

open import Foundations.Universes
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
}

\subtree[fre-0000]{
\title{Cartesian morphisms of polynomial endofunctors}
\taxon{Definition}
\author{fredrikbakke}

\p{
Given two polynomial endofunctors #{P} and #{Q}, a
[morphism](Wild.PolynomialEndofunctors.Morphisms) from #{P} to #{Q} is \em{cartesian}
if its map on positions is a family of equivalences.
}

\agda{
record CartHom𝑃
  {𝓤1 𝓤2 𝓥1 𝓥2 : Level}
  (P : 𝑃 𝓤1 𝓤2)
  (Q : 𝑃 𝓥1 𝓥2)
  : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓥1 ⊔ 𝓥2)
  where
  constructor mk-CartHom𝑃
  field
    shp : P .fst → Q .fst
    pos≃ : (a : P .fst) → Q .snd (shp a) ≃ P .snd a

  pos : (a : P .fst) → Q .snd (shp a) → P .snd a
  pos a = pos≃ a ._≃_.fwd

  pos-is-equiv : (a : P .fst) → is-equiv (pos a)
  pos-is-equiv a = pos≃ a ._≃_.fwd-is-equiv

open CartHom𝑃

module _
  {𝓤1 𝓤2 𝓥1 𝓥2 : Level}
  {P@(A ◃ B) : 𝑃 𝓤1 𝓤2}
  {Q@(C ◃ D) : 𝑃 𝓥1 𝓥2}
  where

  is-cartesian-Hom𝑃
    : Hom𝑃 P Q → Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓥2)
  is-cartesian-Hom𝑃 F = (a : A) → is-equiv (F .Hom𝑃.pos a)

  CartHom𝑃←is-cartesian-Hom𝑃
    : (F : Hom𝑃 P Q)
    → is-cartesian-Hom𝑃 F
    → CartHom𝑃 P Q
  CartHom𝑃←is-cartesian-Hom𝑃 F cart
    = mk-CartHom𝑃
        (F .Hom𝑃.shp)
        (λ a → mk≃ (F .Hom𝑃.pos a) (cart a))

  hom←CartHom𝑃
    : CartHom𝑃 P Q → Hom𝑃 P Q
  hom←CartHom𝑃 F
    = mk-Hom𝑃 (F .CartHom𝑃.shp) (CartHom𝑃.pos F)

  hom←CartHom𝑃-is-cartesian
    : (F : CartHom𝑃 P Q)
    → is-cartesian-Hom𝑃 (hom←CartHom𝑃 F)
  hom←CartHom𝑃-is-cartesian F = CartHom𝑃.pos-is-equiv F
}
}

\subtree[fre-0001]{
\taxon{Definition}
\title{Composition of cartesian morphisms of polynomial endofunctors}
\author{fredrikbakke}

\agda{
id-CartHom𝑃
  : {𝓤1 𝓤2 : Level} (P : 𝑃 𝓤1 𝓤2) → CartHom𝑃 P P
id-CartHom𝑃 P = mk-CartHom𝑃 id (λ a → id≃)

module _
  {𝓤1 𝓤2 𝓥1 𝓥2 𝓦1 𝓦2 : Level}
  {P : 𝑃 𝓤1 𝓤2} {Q : 𝑃 𝓥1 𝓥2} {R : 𝑃 𝓦1 𝓦2}
  where

  infixr 40 _∘CartHom𝑃_

  _∘CartHom𝑃_
    : CartHom𝑃 Q R → CartHom𝑃 P Q → CartHom𝑃 P R
  G ∘CartHom𝑃 F
    = mk-CartHom𝑃
        (G .CartHom𝑃.shp ∘ F .CartHom𝑃.shp)
        (λ a → G .CartHom𝑃.pos≃ (F .CartHom𝑃.shp a) ∙e F .CartHom𝑃.pos≃ a)

  concat-CartHom𝑃
    : CartHom𝑃 P Q → CartHom𝑃 Q R → CartHom𝑃 P R
  concat-CartHom𝑃 F G = G ∘CartHom𝑃 F
}
}
