\title{Top elements of posets}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-22}
\import{stt-macros}

\agda{
module Algebra.Order.TopElements where

open import Axioms.FunExt
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Algebra.Poset
}
}

\subtree[stt-015D]{
\title{Top elements}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
A \em{top element} of a [poset](stt-00TJ) is an element #{t} such that
#{x \le t} for every element #{x}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  is-top-element : A → Type (𝓤 ⊔ 𝓥)
  is-top-element t = (x : A) → x ≤ t

  top-element : Type (𝓤 ⊔ 𝓥)
  top-element = Σ[ t ∶ A ] is-top-element t
}
}

\subtree[stt-015A]{
\title{Being a top element is a property}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  is-top-element-is-prop : {t : A} → is-prop (is-top-element P t)
  is-top-element-is-prop = Π-is-prop (λ _ → ≤-is-prop)
}
}

\subtree[stt-015H]{
\title{Top elements are unique}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
Any two [top elements](stt-015D) are equal by antisymmetry. Since being a
top element is a property, the type of top elements is a proposition.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (open Poset P) where

  top-element-unique
    : {t s : A} → is-top-element P t → is-top-element P s → t ＝ s
  top-element-unique t-is-top s-is-top = ≤-antisym (s-is-top _) (t-is-top _)

  top-element-is-prop : is-prop (top-element P)
  top-element-is-prop (t , t-is-top) (s , s-is-top)
    = Subtype.subtype-path
        (mk-subtype (λ _ → is-top-element-is-prop P))
        (top-element-unique t-is-top s-is-top)
}
}
