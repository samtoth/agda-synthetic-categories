\subtree[bak-6I8C]{
\title{Relative separation of a global subuniverse with respect to a family of maps}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-17}

\p{
Given a [global subuniverse](stt-007A) #{\mathcal{K}} and a family of maps
#{δ_{(-)} \colon \Pi1{i : I}{X(i) \to Y(i)}},
then a type #{A} is \em{relatively separated} with respect to #{δ}, or
\em{#{δ}-separated}, if every
[extension type](stt-00CL) into #{A} along #{δ_i} belongs to #{\mathcal{K}}.
}

\agda{
module _
  {𝓘 𝓤 𝓥} {I : Type 𝓘}
  {X : I → Type 𝓤} {Y : I → Type 𝓥}
  (δ : (i : I) → X i → Y i)
  {α} (K : gSubU α) (open gSubU K)
  where

  is-relatively-separated
    : ∀ {𝓦} → Type 𝓦 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓦 ⊔ α (𝓤 ⊔ 𝓥 ⊔ 𝓦))
  is-relatively-separated A
    = (i : I) (f : X i → A) → Ext (δ i) f ∈ S

  relatively-separated-gSubU
    : gSubU (λ 𝓦 → 𝓘 ⊔ 𝓤 ⊔ 𝓦 ⊔ α (𝓤 ⊔ 𝓥 ⊔ 𝓦))
  relatively-separated-gSubU .gSubU.S .Subtype.family
    = is-relatively-separated
  relatively-separated-gSubU .gSubU.S .Subtype.family-is-subtype A
    = Π-is-prop (λ i → Π-is-prop (λ f → ∈-is-prop S _))
  relatively-separated-gSubU .gSubU.∈S←equiv e sep i f
    = ∈S←equiv
        (Ext-codomain-≃ (δ i) (_≃_.bwd e ∘ f) f e (_≃_.ε e ▹h f))
        (sep i (_≃_.bwd e ∘ f))
}
}

\agda{
module _
  {α 𝓘 𝓤 𝓥} (K : gRSubU α)
  {I : Type 𝓘} {X : I → Type 𝓤} {Y : I → Type 𝓥}
  (δ : (i : I) → X i → Y i)
  (open gRSubU K)
  where
}

\subtree[bak-K99G]{
\title{Global reflective subuniverses contain their relative separations}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-17}

\agda{
  is-relatively-separated←in-subuniverse
    : ∀ {𝓦} {A : Type 𝓦}
      → A ∈ S → is-relatively-separated δ GS A
  is-relatively-separated←in-subuniverse A∈S i
    = gReflectiveClosure.Ext∈S K (δ i) (λ _ → A∈S)
}
}
