\title{The conjunctive property follows from quasicoherence and cubes detect continuity}
\author{reidbarton}
\contributor{fredrikbakke}
\date{2026-06-08}
\date{2026-06-09}

\agda{
open import Foundations.Universes
open import Foundations.Nat
open import Foundations.Unit
open import Foundations.Singletons
open import Foundations.Sigma

open import Algebra.Lattice

open import Modalities.Cohesion.Continuity

import Synthetic.Cubes

module Synthetic.ConjunctiveProperty
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (open Synthetic.Cubes Δ¹ i0 i1)
  (@♭ cubes-separate : family-separates □^_)
  (@♭ ♭Δ¹-ind
      : ∀ {𝓤} (P : @♭ Δ¹ → Prop 𝓤)
      → P i0 .fst → P i1 .fst → (@♭ x : Δ¹) → P x .fst)
  (@♭ Δ¹-is-directed : (f : Δ¹ → Δ¹) (i j : Δ¹) → i ≤ j → f i ≤ f j)
  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex

