\subtree[stt-00AY]{
\taxon{Definition}
\title{Covariant families}

\p{
We say that a type family #{P \colon A \to \UU} is covariant if for any arrow #{f} in
#{A}, and term #{x_0} at #{P_{f(0)}}, the type of homs over #{f} which extend #{x_0}
is a singleton.
}

\agda{
module _ {𝓤 𝓥} {A : Δ¹ → Type 𝓤} (B : {i : Δ¹} → A i → Type 𝓥) where

  is-covariant : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-covariant
    = (x : (i : Δ¹) → A i) (x₀ : B (x i0))
    → is-singleton (Σ[ x₁ ∶ B (x i1)] Homᵈ (B ∘ x) x₀ x₁)

  {-# INJECTIVE_FOR_INFERENCE is-covariant #-}

  is-covariant-is-prop : is-prop is-covariant
  is-covariant-is-prop
    = Π-is-prop (λ a → Π-is-prop (λ b → is-single-is-prop))

  is-covariant-hom
    : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-covariant-hom
    = {x : A i0} {y : A i1} (f : Homᵈ A x y) (x' : B x)
    → is-singleton (Σ[ y' ∶ B y ] Homᵈ-over {B = λ i → B {i}} f x' y')

  is-covariant-hom←is-covariant
    : is-covariant → is-covariant-hom
  is-covariant-hom←is-covariant cov (mk-hom f refl refl)
    = cov f

  is-covariant←is-covariant-hom
    : is-covariant-hom → is-covariant
  is-covariant←is-covariant-hom cov = cov ∘ λhom
}
}


\subtree[stt-00O8]{
\title{Covariant type families admit unital covariant transport}
\taxon{Lemma}
\contributor{fredrikbakke}

\agda{
module _
  {𝓤 𝓥} {A : Δ¹ → Type 𝓤} {P : {i : Δ¹} → A i → Type 𝓥} (cov : is-covariant P)
  where

  tr-cov
    : (h : (i : Δ¹) → A i) → P (h i0) → P (h i1)
  tr-cov h = fst ∘ centre ∘ cov h

  tr-cov-filler
    : (h : (i : Δ¹) → A i) → ∀ p → Homᵈ (P ∘ h) p (tr-cov h p)
  tr-cov-filler h = snd ∘ centre ∘ cov h

  tr-cov-unique
    : (h : (i : Δ¹) → A i) (f : P (h i0) → P (h i1))
      → ∀ p
      → Homᵈ (P ∘ h) p (f p)
      → tr-cov h p ＝ f p
  tr-cov-unique h f p x = ap fst (central (cov h p) (f p , x))

  opaque
    tr-cov-hom
      : Covariant-transport (λ {i} → P {i})
    tr-cov-hom h = fst ∘ centre ∘ is-covariant-hom←is-covariant P cov h

    tr-cov-over
      : ∀ {x y} (h : Homᵈ A x y) (x' : P x)
        → Homᵈ-over {B = λ i → P {i}} h x' (tr-cov-hom h x')
    tr-cov-over h = snd ∘ centre ∘ is-covariant-hom←is-covariant P cov h

    tr-cov-hom-unique
      : ∀ {x y} (f : Homᵈ A x y) x' y'
        → Homᵈ-over {B = λ i → P {i}} f x' y' → tr-cov-hom f x' ＝ y'
    tr-cov-hom-unique f x' y' p
      = ap fst
          (central
            (is-covariant-hom←is-covariant P cov f x')
            (y' , p))

    tr-cov-equal-hom
      : ∀ {x y} (h h' : Homᵈ A x y) (H : h ＝ h')
        → tr-cov-hom h ~ tr-cov-hom h'
    tr-cov-equal-hom h .h refl = ~refl

opaque
  tr-cov-id
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P) {x : A}
      → tr-cov {P = P} cov (λ _ → x) ~ id
  tr-cov-id P cov {x} x' = ap fst (cov (λ _ → x) x' .central (x' , idH x'))

opaque
  unfolding tr-cov-hom
  tr-cov-idH
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P) {x}
      → tr-cov-hom {P = P} cov (idH x) ~ id
  tr-cov-idH P cov = tr-cov-id P cov

  tr-cov-idH~
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P) {x}
        (f : Hom A x x)
      → f ＝ idH x
      → tr-cov-hom {P = P} cov f ~ id
  tr-cov-idH~ P cov _ refl = tr-cov-idH P cov

module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} where

  cov-unital-transport←is-covariant
    : is-covariant B → Covariant-unital-transport B
  cov-unital-transport←is-covariant B-is-cov
    = (tr-cov-hom B-is-cov , (λ _ → tr-cov-idH B B-is-cov))
}
}

\subtree[stt-015U]{
\title{Transport in covariant families lifts is co-strict}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-10-02}

\p{
[Transport in covariant families](stt-00O8) is [co-strict](stt-015V). if
#{0 = 1} it coincides with ordinary transport, which is an equivalence.
}

\agda{
module _
  {𝓤 𝓥} {A : Δ¹ → Type 𝓤} {P : {i : Δ¹} → A i → Type 𝓥}
  (P-is-covariant : is-covariant P)
  where

  opaque
    unfolding tr-cov-hom

    tr-cov-is-co-strict
      : (h : (i : Δ¹) → A i) → is-co-strict-map (tr-cov {P = P} P-is-covariant h)
    tr-cov-is-co-strict h
      = tr-covˢ←lifts {P = P} (λ h x → P-is-covariant h x .centre) h .snd

    tr-cov-hom-is-co-strict
      : {x : A i0} {y : A i1} (h : Homᵈ A x y)
      → is-co-strict-map (tr-cov-hom {P = P} P-is-covariant h)
    tr-cov-hom-is-co-strict (mk-hom h refl refl) = tr-cov-is-co-strict h

  tr-covˢ : (h : (i : Δ¹) → A i) → P (h i0) →ˢ P (h i1)
  tr-covˢ = tr-covˢ←lifts {P = P} (λ h x → P-is-covariant h x .centre)

  tr-cov-homˢ : {x : A i0} {y : A i1} → Homᵈ A x y → P x →ˢ P y
  tr-cov-homˢ h = (tr-cov-hom {P = P} P-is-covariant h , tr-cov-hom-is-co-strict h)
}
}

\subtree[stt-00O5]{
\title{Left families}
\taxon{Definition}

\p{
We say that a type family is a \em{left family} if, as a family, it is right
orthogonal to the left endpoint inclusion.
}

\agda{
is-left-family
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
is-left-family = are-orthogonal-fam (point i0)
}
}

\subtree[stt-00O6]{
\title{Left families are covariant}
\taxon{Lemma}

\proof{
\p{
Left families are equivalently those type families #{B} for which each
#{B_{\sigma(0)}} admits a unique extension along #{0 \to \Delta^1}.
We have already characterised orthogonal families as those who admit
unique extensions.
}
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) where

  cov-lift-is-extension
    : ∀ (σ : Δ¹ → A) (x₀ : B (σ i0))
      → Σ (B (σ i1)) (Homᵈ (B ∘ σ) x₀) ≃ Extᵈ (point i0) (B ∘ σ) (point x₀)
  cov-lift-is-extension σ x₀
    = cov-lift≃fibre-ev-i0 B σ x₀ ∙e Σ-snd-≃ (λ f → unit-UP≃ e⁻¹)

  opaque
    is-covariant←has-unique-extensions
      : has-unique-extensions (point i0) B → is-covariant B
    is-covariant←has-unique-extensions ext σ x₀
      = is-single←equiv⁻¹
          (cov-lift-is-extension σ x₀)
          (ext (mk-afmap σ (point x₀)))

    has-unique-extensions←is-covariant
      : is-covariant B → has-unique-extensions (point i0) B
    has-unique-extensions←is-covariant cov (mk-afmap σ f)
      = is-single←equiv (cov-lift-is-extension σ (f tt)) (cov σ (f tt))

  has-unique-extensions↔is-covariant
    : has-unique-extensions (point i0) B ↔ is-covariant B
  has-unique-extensions↔is-covariant
    = ( is-covariant←has-unique-extensions
      , has-unique-extensions←is-covariant)

  is-left-family↔is-covariant : is-left-family B ↔ is-covariant B
  is-left-family↔is-covariant
    = are-orthogonal-fam↔has-unique-extensions
    ∙iff has-unique-extensions↔is-covariant

  is-covariant←is-left-family : is-left-family B → is-covariant B
  is-covariant←is-left-family = is-left-family↔is-covariant .fst

  is-left-family←is-covariant : is-covariant B → is-left-family B
  is-left-family←is-covariant = is-left-family↔is-covariant .snd
}
}

\subtree[stt-016I]{
\title{Evaluation at the source in a covariant family}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-24}

\p{
Given a [covariant family](stt-00AY) #{P \colon A \to \UV} and an arrow
#{h \colon \Delta^1 \to A}, evaluation at #{0} gives an equivalence between
sections of #{P \circ h} and the fibre #{P(h(0))}.
}

\agda{
module _
  {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
  (P-is-covariant : is-covariant P) (h : Δ¹ → A)
  where

  ev-i0-is-equiv←is-covariant : is-equiv (evᵈ: (P ∘ h) i0)
  ev-i0-is-equiv←is-covariant
    = is-equiv-∘ unit-ev-is-equiv (is-left-family←is-covariant P P-is-covariant h)

  ev-i0≃←is-covariant : Π Δ¹ (P ∘ h) ≃ P (h i0)
  ev-i0≃←is-covariant = mk≃ (ev i0) ev-i0-is-equiv←is-covariant
}
}

\subtree[stt-00AV]{
\title{Left fibrations}
\taxon{Definition}

\p{A map is a left fibration if it is [right orthogonal](stt-0048) to the left
endpoint of #{\Delta^1}.}

\p{See [[stt-00OH]] for the dual notion.}

\agda{
is-left-fibration
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A → B)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓘)
is-left-fibration f = (point i0) ⊥ f

is-left-anodyne
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Typeω
is-left-anodyne f = is-anodyne f (point i0)
}
}


\subtree[stt-00AR]{
\title{Covariant families straighten to left fibrations}
\taxon{Corollary}

\p{We show that some family #{P \colon A \to \UU} is [covariant](stt-00AO) iff the map
#{\pi \colon \tilde{P} \to A} is a [left fibration](stt-00AV). Equivalently, a map
#{p \colon E \to B} is a left fibration iff its fibre family is covariant.}

\agda{
opaque
  is-covariant↔is-left-fibration
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥)
      → is-covariant B ↔ is-left-fibration (fst: B)
  is-covariant↔is-left-fibration {A = A} B
    = (is-left-family↔is-covariant B iff⁻¹) ∙iff are-orthogonal-fam↔are-orthogonal-fst

module _ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) where

  is-left-fibration←is-covariant
    : is-covariant P → is-left-fibration (fst: P)
  is-left-fibration←is-covariant = is-covariant↔is-left-fibration P .fst

  is-covariant←is-left-fibration
    : is-left-fibration (fst: P) → is-covariant P
  is-covariant←is-left-fibration = is-covariant↔is-left-fibration P .snd

module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} (p : E → B) where

  orthogonal-fibre-fam←is-left-fibration
    : is-left-fibration p → is-left-family (fibre p)
  orthogonal-fibre-fam←is-left-fibration
    = are-orthogonal-fibre←are-orthogonal

  is-left-fibration←orthogonal-fibre-fam
    : is-left-family (fibre p) → is-left-fibration p
  is-left-fibration←orthogonal-fibre-fam
    = are-orthogonal←are-orthogonal-fibre

  fibre-fam-is-covariant←is-left-fibration
    : is-left-fibration p → is-covariant (fibre p)
  fibre-fam-is-covariant←is-left-fibration
    = is-covariant←is-left-family (fibre p)
    ∘ orthogonal-fibre-fam←is-left-fibration

  is-left-fibration←fibre-fam-is-covariant
    : is-covariant (fibre p) → is-left-fibration p
  is-left-fibration←fibre-fam-is-covariant
    = is-left-fibration←orthogonal-fibre-fam
    ∘ is-left-family←is-covariant (fibre p)
}
}

\subtree[stt-00TN]{
\title{Left fibrations are maps which induce equivalences on coslices}
\taxon{Lemma}
\contributor{fredrikbakke}

\p{#{p \colon E \to B} is a left fibration iff for each #{e : E}, the induced map
#{E_{e/} \to B_{p(e)/}} is an equivalence.}

\agda{
module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} (p : E → B) where

  coslice-map-Ext-equiv
    : (e : E)
    → Arrow-equiv
        (postcompose-coslice (point e) p)
        (postcomp-Ext (point i0) p (point e))
  coslice-map-Ext-equiv e
    = mk-arr-equiv
        (Coslice-object-repr≃ e ∙e Σ-snd-≃ (λ _ → point≃))
        (Coslice-object-repr≃ (p e) ∙e Σ-snd-≃ (λ _ → point≃))
        ~refl

  coslice-map-is-equiv←is-left-fibration
    : is-left-fibration p → (∀ e → is-equiv (postcompose-coslice (point e) p))
  coslice-map-is-equiv←is-left-fibration fib e
    = src-is-equiv←Arrow-equiv (coslice-map-Ext-equiv e)
        (postcomp-Ext-is-equiv←orthogonal (point i0) p fib (point e))

  is-left-fibration←coslice-map-is-equiv
    : (∀ e → is-equiv (postcompose-coslice (point e) p)) → is-left-fibration p
  is-left-fibration←coslice-map-is-equiv eqv
    = orthogonal←postcomp-Ext-is-equiv (point i0) p
        (λ e → tgt-is-equiv←Arrow-equiv (coslice-map-Ext-equiv (e tt)) (eqv (e tt)))
}
}

\subtree[stt-00C7]{
\title{Left fibrations are inner}
\taxon{Lemma}

\proof{
\p{We use the fact that left orthogonal maps [are closed under pushout products
and embeddings](stt-00BV). In particular we take the pushout product:
#{\underset{\Delta^1}{\overset{\{0\}}{\downarrow}} \pushprod
\underset{\Delta^1}{\overset{\{1\}}{\downarrow}}}, which modulo some contracting
away singletons, is the [inner horn](stt-00AD) inclusion into the square. Now
the following retract square completes the proof:}
\transclude{stt-00LC}
}


\remark{
We may use the dual proof for [right fibrations](stt-00OJ)
(\ref{stt-00C7})
}

\agda{
is-inner←is-left-fibration
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → is-left-fibration f → is-inner f
is-inner←is-left-fibration {f = f} lf
  = left-orthogonal←Arrow-retract Λ[2,1]↪□-Arrow-retract _
      (left-orthogonal-pushout-product' (point i0) f lf (point i1))
}
}

\subtree[stt-00C8]{
\taxon{Corollary}

\p{The total type of a covariant family over a Segal type is itself Segal.}

\agda{
is-inner-family←is-covariant
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
    → is-covariant B → is-inner-family B
is-inner-family←is-covariant
  = is-inner←is-left-fibration ∘ is-left-fibration←is-covariant _

is-inner-family←is-covariant-hom
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
    → is-covariant-hom B → is-inner-family B
is-inner-family←is-covariant-hom
  = is-inner-family←is-covariant ∘ is-covariant←is-covariant-hom _

Σ-cov-is-segal
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
    → is-segal A → is-covariant B → is-segal (Σ A B)
Σ-cov-is-segal apc cov
  = Σ-is-segal apc
      (is-inner←is-left-fibration
        (is-left-fibration←is-covariant _ cov))
}
}

\subtree[stt-00DH]{
\title{Morphisms in Hom types}
\taxon{Lemma}

\p{We show that for a covariant family #{P}, given any #{f : \Hom_A(x,y)},
the type of dependent morphisms #{\Hom_{Pf}(x',y')} is equivalent to
#{f^*(x') = y'}.}

\proof{
\p{We first give a map #{f^*(x') = y'}, by identity induction, it suffices to give
a morphism #{\Hom_{Pf}(x', f^*(x'))} for each #{x'}, but this is just the
coherence you get from covariant transport.
Now since #{\Sigma1{y' : P(f(1))}{\Hom_{Pf}(x',y')}} is a singleton by the
definition of transport, the fundamental theorem of identity types gives us that
this map is an equivalence.}
}

\agda{
Hom-cov
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P)
      (f : Δ¹ → A) x' y'
    → tr-cov {P = P} cov f x' ＝ y' → Homᵈ (P ∘ f) x' y'
Hom-cov _ Pc f x' y' refl = Pc f x' .centre .snd

Hom-cov-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P)
      (f : Δ¹ → A) x' y'
    → is-equiv (Hom-cov P cov f x' y')
Hom-cov-is-equiv P Pc f x' = fundamental-Id _ (Pc f x') (Hom-cov P Pc f x')

opaque
  unfolding tr-cov-hom
  Hom-cov'
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P)
        {x y} (f : Hom A x y) x' y'
      → tr-cov-hom {P = P} cov f x' ＝ y' → Hom-over f x' y'
  Hom-cov' P cov f x' y' refl
    = is-covariant-hom←is-covariant _ cov f x' .centre .snd

Hom-cov'-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P)
      {x y} (f : Hom A x y) x' y'
    → is-equiv (Hom-cov' P cov f x' y')
Hom-cov'-is-equiv P Pc f x'
  = fundamental-Id
      _
      (is-covariant-hom←is-covariant _ Pc f x')
      (Hom-cov' P Pc f x')

Hom-cov'≃
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) (cov : is-covariant P)
      {x y} (f : Hom A x y) x' y'
    → (tr-cov-hom {P = P} cov f x' ＝ y') ≃ (Hom-over f x' y')
Hom-cov'≃  P Pc f x' y'
  = mk≃ (Hom-cov' P Pc f x' y') (Hom-cov'-is-equiv P Pc f x' y')
}
}

\subtree[stt-00DQ]{
\title{Transport in covariant families is functorial}
\taxon{Theorem}

\citet{8.16}{RS17}

\p{Given a covariant family #{P}, we show the transport operation is functorial,
in the sense that #{P(\id) \sim \id} and #{P(f \circ g) \sim P(f) \circ P(g)}.}

\agda{
opaque
  unfolding tr-cov-hom
  tr-cov-∘
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (Apc : is-segal A) (P : A → Type 𝓥)
        (cov : is-covariant P) {x y z} (g : Hom A y z) (f : Hom A x y)
        (x' : P x)
      → tr-cov-hom cov (g ∘[ Apc ] f) x'
      ＝ tr-cov-hom cov g (tr-cov-hom cov f x')
  tr-cov-∘ apc P cov g f x'
    = ap fst
        (is-covariant-hom←is-covariant _ cov (g ∘[ apc ] f) x' .central
          ( tr-cov-hom cov g (tr-cov-hom cov f x')
          , Compᵈ apc P (is-inner-family←is-covariant cov) g f
                  (tr-cov-over cov g _) (tr-cov-over cov f _)))
}
}

\subtree[bak-AAAD]{
\title{Covariant lift criterion for covariant families}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-11-04}

\p{
A type family #{B \colon A \to \Type} is covariant iff its fibres are #{Δ¹}-discrete
and it admits [covariant lifts](bak-FEFF). In other words, if its fibres are
#{Δ¹}-discrete, and for every arrow #{f \colon Δ¹ \to A}, evaluation at #{0} into
#{B \circ f} has a section.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} where

  is-Δ¹-discrete-family←is-covariant
    : is-covariant B → (x : A) → is-Δ¹-discrete (B x)
  is-Δ¹-discrete-family←is-covariant B-is-cov x
    = is-Δ¹-discrete←is-left (λ _
      → is-left-family←is-covariant B B-is-cov (const x))

  is-covariant←lifts
    : ((x : A) → is-Δ¹-discrete (B x))
    → Covariant-lifts B → is-covariant B
  is-covariant←lifts B-disc lift-B
    = is-covariant←is-left-family B (λ g
      → 3-for-2 unit-ev-is-equiv (is-equiv←section←injective
          (λ {s} {t} p → funext→ (λ i
            → sym (transport-section g s (0≤i i))
            ∙ ap (ρ (ap-hom g (0≤i i))) p
            ∙ transport-section g t (0≤i i)))
          (_≃_.fwd (Covariant-lifts≃sections-ev-i0 B) lift-B g)))
    where

    ρ : Covariant-transport B
    ρ = cov-transport←lifts lift-B

    transport-section
      : (f : Δ¹ → A) (s : Π Δ¹ (B ∘ f)) {i j : Δ¹} (h : Hom Δ¹ i j)
      → ρ (ap-hom f h) (s i) ＝ s j
    transport-section f s (mk-hom h refl refl)
      = sym (ap (λ k → ρ (ap-hom (f ∘ h) k) (s (h i0)))
          (Hom-ext→ {f = i≤1 i0} {g = 0≤1} ((λ _ → 0-bottom) , prop! , prop!)))
      ∙ weakly-constant←is-null (B-disc (f (h i1))) tt
          (λ i → ρ (ap-hom (f ∘ h) (i≤1 i)) (s (h i))) i0 i1
      ∙ ap (λ k → ρ (ap-hom (f ∘ h) k) (s (h i1))) i≤1-at-1
      ∙ sym (Id←Hom←is-Δ¹-discrete (B-disc (f (h i1)))
          (lift-B (const (f (h i1))) (s (h i1)) .snd))

  ev-i0-is-equiv←sections
    : ((x : A) → is-Δ¹-discrete (B x))
    → ((f : Δ¹ → A) → section (evᵈ: (B ∘ f) i0))
    → (f : Δ¹ → A) → is-equiv (evᵈ: (B ∘ f) i0)
  ev-i0-is-equiv←sections B-disc s
    = ev-i0-is-equiv←is-covariant {P = B}
        (is-covariant←lifts B-disc (_≃_.bwd (Covariant-lifts≃sections-ev-i0 B) s))

  ev-i0-sections-is-prop
    : ((x : A) → is-Δ¹-discrete (B x))
    → is-prop ((f : Δ¹ → A) → section (evᵈ: (B ∘ f) i0))
  ev-i0-sections-is-prop B-disc
    = is-prop←is-single-if-inhabited (λ s
      → Π-is-single (λ f
        → section-is-single←qinv
            (ev-i0-is-equiv←sections B-disc s f .is-equiv.qinv)))
}

\p{In particular, any constant family of #{Δ¹}-discrete types is covariant.}

\agda{
const-is-covariant←is-Δ¹-discrete
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → is-Δ¹-discrete B → is-covariant (const: (Type 𝓥) A B)
const-is-covariant←is-Δ¹-discrete B-disc
  = is-covariant←is-left-family _
      (λ _ → is-left←is-Δ¹-discrete B-disc tt)

!-is-left-fibration←is-Δ¹-discrete
  : ∀ {𝓤} {B : Type 𝓤}
    → is-Δ¹-discrete B → is-left-fibration (!: B)
!-is-left-fibration←is-Δ¹-discrete Bdisc
  = orthogonal-!←orthogonal-type (is-left←is-Δ¹-discrete Bdisc tt)
}
}

\subtree[stt-00VJ]{
\title{Unital transport criterion for covariant families}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-18}

\p{
A type family #{B \colon A \to \UU} is covariant iff it has #{Δ¹}-discrete fibres
and a transport map #{f_* \colon B(x) \to B(y)}, for every #{f : \Hom_A(x,y)}, such
that #{\id_* \sim \id}.
}

\p{This result is due to [[robschellingerhout]].}

\proof{
\p{
The forwards direction follows from [unitality of covariant transport](stt-00O8)
and [discreteness of the fibres](bak-AAAD). For the backwards direction we use
the [lifts constructed from unital transport](bak-2CC0), which, by the
[covariant lifts criterion](bak-AAAD), give an inverse to
\code{precomp-Π (B ∘ f) (point i0)}.
}

\p{
By the [covariant lifts criterion](bak-AAAD), this construction is an inverse to
evaluation at #{0}. One inverse law follows immediately from unitality. For the
other, the contraction of #{Δ¹_{/i}} from #{(0,0\leq i)} to #{(i,\id_i)} induces a
morphism in #{B(f(i))} from the #{f(0\leq i)_*(s(0))} to #{f(\id_i)_*(s(i))}.
Unitality then gives #{f(\id_i)_*(s(i)) = s(i)}, and #{Δ¹}-discreteness gives the
desired equality.
}
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} where

  is-covariant←cov-unital-transport
    : ((x : A) → is-Δ¹-discrete (B x))
    → Covariant-unital-transport B
    → is-covariant B
  is-covariant←cov-unital-transport B-disc ρ
    = is-covariant←lifts B-disc (lift-cov-unital-transport ρ)

  is-left-family←cov-unital-transport
    : ((x : A) → is-Δ¹-discrete (B x))
    → Covariant-unital-transport B
    → is-left-family B
  is-left-family←cov-unital-transport B-disc
    = is-left-family←is-covariant B
    ∘ is-covariant←cov-unital-transport B-disc

  is-covariant↔cov-unital-transport
    : is-covariant B
    ↔ ( Covariant-unital-transport B
      × ((x : A) → is-Δ¹-discrete (B x)))
  is-covariant↔cov-unital-transport .fst B-is-cov
    = ( cov-unital-transport←is-covariant B-is-cov
      , is-Δ¹-discrete-family←is-covariant B-is-cov)
  is-covariant↔cov-unital-transport .snd (ρ , B-disc)
    = is-covariant←cov-unital-transport B-disc ρ
}
}

\subtree[bak-6BAE]{
\title{The fibrewise #{Δ¹}-discretisation of families equipped with covariant lifts are covariant}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{P \colon A \to \Type} be a type family which admits [covariant lifts](bak-FEFF)
of every arrow, then #{{ʃ} \circ P} is a covariant family.
}

\p{
[[danielgratzer]] asked for an instance of this result on Mathstodon in
[this post](https://mathstodon.xyz/@danielgratzer/116482079443956409). Thanks to
[[robschellingerhout]]'s
[unital transport criterion of covariant families](stt-00VJ) we can easily answer
this question in the positive.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥} (lift-P : Covariant-lifts P) where

  ʃ∘-cov-transport←lifts : Covariant-transport (Δ¹Disc.○ ∘ P)
  ʃ∘-cov-transport←lifts f = Δ¹Disc.○₁ (cov-transport←lifts lift-P f)

  ʃ∘-cov-transport←lifts-unital
    : (a : A) → ʃ∘-cov-transport←lifts (idH a) ~ id
  ʃ∘-cov-transport←lifts-unital a
    = Δ¹Disc.▹η.bwd
        ( Δ¹Disc.○₁-β (fst ∘ lift-P (const a))
        ∙h ( λ x
             → sym
                (Id←Hom←is-Δ¹-discrete Δ¹Disc.○∈S
                  (ap-hom Δ¹Disc.η (lift-P (const a) x .snd)))))

  ʃ∘-cov-unital-transport←lifts
    : Covariant-unital-transport (Δ¹Disc.○ ∘ P)
  ʃ∘-cov-unital-transport←lifts
    = (ʃ∘-cov-transport←lifts , ʃ∘-cov-transport←lifts-unital)

  ʃ∘-is-covariant←lifts : is-covariant (Δ¹Disc.○ ∘ P)
  ʃ∘-is-covariant←lifts
    = is-covariant←cov-unital-transport
        (λ _ → Δ¹Disc.○∈S)
        (ʃ∘-cov-unital-transport←lifts)

module _
  {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥} (τ : Covariant-unital-transport P)
  where

  ʃ∘-cov-unital-transport
    : Covariant-unital-transport (Δ¹Disc.○ ∘ P)
  ʃ∘-cov-unital-transport
    = ʃ∘-cov-unital-transport←lifts (lift-cov-unital-transport τ)

  ʃ∘-is-covariant : is-covariant (Δ¹Disc.○ ∘ P)
  ʃ∘-is-covariant
    = ʃ∘-is-covariant←lifts {P = P} (lift-cov-unital-transport τ)
}
}

\subtree[stt-00K3]{
\title{Covariant transport along inequalities in #{Δ¹}}
\taxon{Lemma}
\contributor{fredrikbakke}

\p{Each #{i \le j} in #{\Delta^1} induces a morphism #{\Hom_{\Delta^1}(i,j)}.
consequently, for covariant families over #{\Delta^1}, we may coerce along
#{i \le j}. Since #{i \le j} is a proposition, we have the coercing along
#{i \le i} for any #{i} is the identity and coercing along #{0 \le 1} is the
same as covariant transport over the canonical morphisms from #{0} to #{1} given
by #{\id \colon \Delta^1 \to \Delta^1}.}

\agda{
module _ {𝓤} (B : Δ¹ → Type 𝓤) (bc : is-covariant B) where

  coe-cov : {i j : Δ¹} → i ≤ j → B i → B j
  coe-cov = coe-cov-transport B (tr-cov-hom bc)

  opaque
    unfolding tr-cov-hom
    coe-cov-id : {i : Δ¹} (p : i ≤ i) → coe-cov p ~ id
    coe-cov-id = coe-cov-transport-id B (cov-unital-transport←is-covariant bc)

    coe-cov-＝ : {i j : Δ¹} (p : i ＝ j) (q : i ≤ j) → coe-cov q ~ tr B p
    coe-cov-＝ = coe-cov-transport-＝ B (cov-unital-transport←is-covariant bc)

    coe-cov-0≤1 : (p : i0 ≤ i1) → coe-cov p ＝ tr-cov {P = B} bc id
    coe-cov-0≤1 = coe-cov-transport-0≤1 B (tr-cov-hom bc)
}
}

\subtree[stt-00FR]{
\title{Natural transformations are natural with respect to transport in covariant families}
\taxon{Lemma}

\citet{Proposition 8.17}{RS17}

\agda{
module _
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {F : A → Type 𝓥} {G : A → Type 𝓦}
  (Fc : is-covariant F)
  (Gc : is-covariant G)
  (α : ∀ a → F a → G a)
  where

  tr-cov-hom-naturality
    : ∀ {x y} (f : Hom A x y)
      → tr-cov-hom Gc f ∘ α x ~ α y ∘ tr-cov-hom Fc f
  tr-cov-hom-naturality f x'
    = tr-cov-hom-unique Gc f
        (α _ x')
        (α _ (tr-cov-hom Fc f x'))
        (filler f x') where
    filler
      : ∀ {x y} (f : Hom _ x y) x'
        → Hom-over f (α x x') (α y (tr-cov-hom Fc f x'))
    filler {x}{y} hh@(mk-hom h refl refl) x'
      = ap-hom (λ {i} → α (h i)) (tr-cov-over Fc hh x')

  adjust-tr-cov-hom
    : is-fibrewise-equiv α
    → ∀ {x}{y} (f : Hom A x y)
    → Arrow-equiv (tr-cov-hom {P = F} Fc f) (tr-cov-hom {P = G} Gc f)
  adjust-tr-cov-hom e f .fst .Arrow-Π.top = α _
  adjust-tr-cov-hom e f .fst .Arrow-Π.bot = α _
  adjust-tr-cov-hom e f .fst .Arrow-Π.comm = tr-cov-hom-naturality f h⁻¹
  adjust-tr-cov-hom e f .snd .fst = e _
  adjust-tr-cov-hom e f .snd .snd = e _

  opaque
    tr-cov-naturality
      : ∀ (f : Δ¹ → A)
        → tr-cov {P = G} Gc f ∘ α (f i0) ~ α (f i1) ∘ tr-cov {P = F} Fc f
    tr-cov-naturality f x'
      = ap fst (central (Gc f (α (f i0) x'))
           ( (α (f i1) (tr-cov {P = F} Fc f x'))
           , ap-hom (λ {i} → α (f i)) (tr-cov-filler {P = F} Fc f x')))

  adjust-tr-cov
    : is-fibrewise-equiv α
    → (f : Δ¹ → A)
    → Arrow-equiv (tr-cov {P = F} Fc f) (tr-cov {P = G} Gc f)
  adjust-tr-cov e f .fst .Arrow-Π.top = α (f i0)
  adjust-tr-cov e f .fst .Arrow-Π.bot = α (f i1)
  adjust-tr-cov e f .fst .Arrow-Π.comm = tr-cov-naturality f h⁻¹
  adjust-tr-cov e f .snd .fst = e (f i0)
  adjust-tr-cov e f .snd .snd = e (f i1)
}
}

\agda{
opaque
  tr-cov-hom-Idᵈ
    : ∀ {𝓤 𝓥} {A : Type 𝓤} (F : A → Type 𝓥) (Fc : is-covariant F)
        {x y x' y' : A} (p : x ＝ x') (q : y ＝ y')
        (f : Hom A x y) (g : Hom A x' y')
        (P : Hom-pathᵈ p q f g)
      → tr F q ∘ tr-cov-hom {P = F} Fc f
      ~ tr-cov-hom {P = F} Fc g ∘ tr F p
  tr-cov-hom-Idᵈ F Fc refl refl f g H
    = IdSJ ⦃ Hom-IdSᵈ ⦄
        (λ (g , _) → tr-cov-hom {P = F} Fc f ~ tr-cov-hom {P = F} Fc g)
        ~refl H
}

\subtree[stt-00FU]{
\title{Base change of covariant families}
\taxon{Lemma}
\author{samueltoth}

\agda{
covariant-base-change
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {P : B → Type 𝓦}
    → (f : A → B)
    → is-covariant P → is-covariant (P ∘ f)
covariant-base-change F Pc f x₀ = Pc (F ∘ f) x₀

is-covariant-is-Δ¹-relative
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
    → is-covariant P ↔ (∀ (f : Δ¹ → A) → is-covariant (P ∘ f))
is-covariant-is-Δ¹-relative {A = A} {P} .fst Pc f
  = covariant-base-change {P = P} f Pc
is-covariant-is-Δ¹-relative {A = A} {P} .snd Pfc h = Pfc h id
}
}

\subtree[stt-00WY]{
\title{Transporting over a base changed covariant family}
\taxon{Lemma}

\agda{
tr-cov-ap-hom
  : ∀ {𝓤 𝓥 𝓦} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
      (F : Y → Type 𝓦) (Fc : is-covariant F)
      (Ffc : is-covariant (F ∘ f))
    → (covariant-base-change {P = F} f Fc ＝ Ffc)
    → {a b : X}
      (h : Hom X a b)
      (g : Hom Y (f a) (f b))
    → (g ＝ ap-hom f h)
    → tr-cov-hom {P = F} Fc g
    ~ tr-cov-hom {P = F ∘ f} Ffc h
tr-cov-ap-hom f F Fc Ffc refl h _ refl x = tr-cov-hom-unique Fc (ap-hom f h) x
  (tr-cov-hom (covariant-base-change {P = F} f Fc) h x)
  (adjust-hom {A = F ∘ f ∘ h .Homᵈ.hom}
    (ap (λ p → coe p x) (ap-∘ F f _ ∙ ap (ap F) (ap-sym f (h .Homᵈ.hom0))))
    (ap (λ p → coe p _) (ap-∘ F f _ ∙ ap (ap F) (ap-sym f (h .Homᵈ.hom1))))
    (tr-cov-over (covariant-base-change {P = F} f Fc) h x) )
}
}
