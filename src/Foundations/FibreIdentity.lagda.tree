\date{2025-02-24}
\title{Characterising identity in fibre types}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
module Foundations.FibreIdentity where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Sigma
open import Foundations.SigmaIdentity
open import Foundations.FibrewiseEquivalences
open import Foundations.Functions
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
open import Foundations.Identity
open import Foundations.Homotopy
open import Foundations.DependentIdentity
}
}

\p{Although [fibres](stt-000M) are defined as sigma types - [who's path types can be characterised](Foundations.SigmaIdentity) - we can give a
particular special charecterisation of the path space of fibre types that will come in handy especially in proving that certain maps
have contractible or propositional fibres.
}

\subtree[stt-000N]{
\taxon{Theorem}


\p{Given two terms #{(x,p),(y,q)} of #{\fibre{f}{y}}, we characterise the path type as follows:}

##{
 ((x,p) = (y,q)) \simeq (\Sigma_{(\gamma : x = y)} f(\gamma) \cdot q = p)
}


\proof{
We reason in a chain of equivalences:

##{
\begin{align}
(x,p) = (y,q) &\simeq && \Sigma_{(\gamma : x = y)} \gamma^* p = q \\
      	      &\simeq && \Sigma_{(\gamma : x = y)} f(\gamma) \cdot q = p
\end{align}
}

\ol{
\li{is the characterisation of paths in sigma types}
\li{follows directly from path induction on #{\gamma} and the fact path inversion is an equivalence}
}

\agda{
fibre-path≃
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {b : B} → ∀ {x y : fibre f b}
    → (x ＝ y) ≃ (Σ (x .fst ＝ y .fst) λ γ → ap f γ ∙ y .snd ＝ x .snd)
fibre-path≃ {x = a@(x , p)} {b@(y , q)}
  = (a ＝ b)                              ≃⟨ Σ-path e⁻¹ ⟩
    Σ (x ＝ y) (λ γ → Idᶠ _ γ p q)   ≃⟨ Σ-snd-≃ lem ⟩
    Σ (x ＝ y) (λ γ → ap _ γ ∙ q ＝ p)    ≃∎ where

  lem2 : ∀ {𝓤} {A : Type 𝓤} {x y : A} (p : x ＝ y) (q : x ＝ y) → (p ＝ q) ≃ (q ＝ p)
  lem2 p q = equiv←qequiv (mk≊ sym (sym , (λ _ → sym-sym) , (λ _ → sym-sym)))

  lem : (γ : x ＝ y) → (Idᶠ _ γ p q) ≃ (ap _ γ ∙ q ＝ p)
  lem refl = lem2 p q

fibre-path→
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {b : B} → ∀ {x y : fibre f b}
    → (Σ (x .fst ＝ y .fst) λ γ → ap f γ ∙ y .snd ＝ x .snd) → (x ＝ y)
fibre-path→ = _≃_.bwd fibre-path≃

fibre-path←Id
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} {b : B} → ∀ {x y : fibre f b}
    → (x ＝ y) → (Σ (x .fst ＝ y .fst) λ γ → ap f γ ∙ y .snd ＝ x .snd)
fibre-path←Id = _≃_.fwd fibre-path≃
}
}
}

\subtree[stt-00WT]{
\taxon{Theorem}
\date{2026-03-19}
\author{fredrikbakke}
\title{Homotopic maps have equivalent fibres}

\agda{
fibre-homotopy≃
  : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥}
    {f g : A → B} {b : B}
  → f ~ g
  → fibre f b ≃ fibre g b
fibre-homotopy≃ {f = f} {g} {b} H = equiv←qequiv qiso where
  qiso : fibre f b ≊ fibre g b
  qiso ._≊_.fwd (a , p) = a , sym (H a) ∙ p
  qiso ._≊_.fwd-qinv .fst (a , p) = a , H a ∙ p
  qiso ._≊_.fwd-qinv .snd .fst (a , p) = fibre-path→ (refl , sym (sym∙ (H a) p))
  qiso ._≊_.fwd-qinv .snd .snd (a , p) = fibre-path→ (refl , sym (sym'∙ (H a) p))
}
}
