\date{2025-06-26}
\author{samueltoth}
\title{Pi types as sections}
\taxon{Module}
\import{stt-macros}


\agda{
module Core.PiSection where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
}
}


\subtree[stt-006J]{
\taxon{Theorem}
\title{Pi types are sections}

\p{We show that the type #{\Pi1{a : A}{B(a)}} is equivalent to
the type of sections of #{\pi \colon \Sigma1{a : A}{B(a)} \to A}.}


\agda{
section←Π
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → Π A B
    → section (fst: B)
section←Π {B = B} f = ((λ x → (x , f x)) , ~refl)

section←Π-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {p : A → B}
    → Π B (fibre p)
    → section p
section←Π-map {A = A} {p = p} =  Σ-Π-swap (const A) (λ x a → p a ＝ x)

section≃Π
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → section (fst: B)
    ≃ Π A B
section≃Π {A = A} {B}
  = section fst                                  ≃⟨ Σ-Π-swap≃ _ _ e⁻¹ ⟩
    (∀ (a : A) → Σ[ x ∶ Σ A B ] (fst x ＝ a))    ≃⟨ Π-fam-≃ (λ a → Σ-assoc) ⟩
    ((a : A) → Σ[ a' ∶ A ] ((B a') × (a' ＝ a))) ≃⟨ Π-fam-≃ (λ a
                                                    → Σ-snd-≃ (λ a' → ×-swap)) ⟩
    (((a : A) → Σ[ a' ∶ A ] ((a' ＝ a) × B a'))) ≃⟨ Π-fam-≃ (λ a → Σ-＝singl) ⟩
    Π A B ≃∎

Π←section
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → section (fst: B)
    → Π A B
Π←section {B = B} (f , s) a = tr B (s a) (snd (f a))

Π←section-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {p : A → B}
    → section p
    → Π B (fibre p)
Π←section-map {A = A} {p = p} = _≃_.bwd (Σ-Π-swap≃ (λ _ → A) (λ x a → p a ＝ x))
}
}
