\subtree[bak-C5E1]{
\title{The upper 2-Segal horn}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-21}

\p{
The upper 3-horn #{Λ^3_{1,3}} is the union of the faces #{013} and #{123} in #{Δ³},
glued along the edge #{13}. An \em{upper 2-Segal type} is a type that is local at
this horn inclusion.
}

\quiver{
\begin{tikzcd}[column sep=small, row sep=small]
  & 1 && 3 &&&& 1 && 3 \\
  &&&& {} & {} \\
  0 && 2 &&&& 0 && 2 \\
  & {\Lambda^3_{1,3}} &&&&&& {\Delta^3}
  \arrow[from=3-1, to=1-2]
  \arrow[from=1-2, to=1-4]
  \arrow[from=3-1, to=1-4]
  \arrow[from=3-3, to=1-4]
  \arrow[crossing over, from=1-2, to=3-3]
  \arrow[hook, from=2-5, to=2-6]
  \arrow[from=3-7, to=1-8]
  \arrow[from=1-8, to=1-10]
  \arrow[from=3-7, to=1-10]
  \arrow[from=3-7, to=3-9]
  \arrow[from=3-9, to=1-10]
  \arrow[crossing over, from=1-8, to=3-9]
\end{tikzcd}
}

\agda{
Λ[3,13]-cocone : Cocone (mk-span Δ¹ δ₀² δ₁²) Δ³
Λ[3,13]-cocone = mk-cocone δ₂³ δ₀³ (λ _ → Δ³-ext refl refl refl)

Λ[3,13] : Type 𝓘
Λ[3,13] = Pushout δ₀² δ₁²

Λ[3,13]-incl : Λ[3,13] → Δ³
Λ[3,13]-incl = cogap Λ[3,13]-cocone

is-upper-2-segal : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
is-upper-2-segal = orthogonal-type Λ[3,13]-incl

is-upper-2-inner-anodyne
  : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} → (X → Y) → Typeω
is-upper-2-inner-anodyne f = is-anodyne f Λ[3,13]-incl
}
}
