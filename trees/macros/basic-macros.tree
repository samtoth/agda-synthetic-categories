\def\latex-preamble{
 \startverb
 \usepackage{tikz, tikz-cd, mathtools, amssymb, stmaryrd}
 \usepackage{quiver}
 \stopverb
}

% No-space punctuation.
% Useful for adding punctuation to a diagram or equation without influencing alignment
\def\nsp[p]{\mathrlap{\text{\p}}}

\def\agda-imports[~body]{
\scope{
\put\transclude/expanded{false}
\subtree{
\taxon{Imports}
\body{}
}
}
}

\def\quiver[~body]{
  \figure{\tex{
  \startverb
	\usepackage{quiver}
	\usepackage{babel}
	\usepackage{mathtools, amssymb, amsmath}
	\usepackage{bbold}

        \usetikzlibrary{calc,babel}

        \newlength\squareheight
        \setlength\squareheight{6.75pt}
        \newcommand\squareslash{\tikz{\draw (0,0) rectangle (\squareheight,\squareheight);\draw(0,\squareheight) -- (\squareheight,0)}}
        \DeclareMathOperator\boxslash{\squareslash}


	 \tikzset{
	   curve/.style={
	     settings={#1},
	     to path={
	       (\tikztostart)
	       .. controls ($(\tikztostart)!\pv{pos}!(\tikztotarget)!\pv{height}!270:(\tikztotarget)$)
	       and ($(\tikztostart)!1-\pv{pos}!(\tikztotarget)!\pv{height}!270:(\tikztotarget)$)
	       .. (\tikztotarget)\tikztonodes
	     },
	   },
	   settings/.code={%
	     \tikzset{quiver/.cd,#1}%
	     \def\pv##1{\pgfkeysvalueof{/tikz/quiver/##1}}%
	   },
	   quiver/.cd,
	   pos/.initial=0.35,
	   height/.initial=0,
	 }
  \stopverb
  }{\body{}}}
}

% Proofs
\def\qed{#{\square}}

\def\proof[body]{
\scope{
\put\transclude/toc{false}
\subtree{
  \taxon{Proof}
  \body
  \qed
}}}

% Scope macros

\def\anon-subtree[tax][~body]{
\scope{
\put\transclude/toc{false}
\subtree{
\taxon{\tax}
\body{}
}}}

\def\remark[body]{
\scope{
\put\transclude/toc{false}
\subtree{
\taxon{Remark}
\body
}}}

\def\closedScope[~body]{
\scope{
\put\transclude/toc{false}
\put\transclude/expanded{false}
\body{}
}}

\def\todo[x]{
\scope{
\put\transclude/toc{false}
\subtree{
\taxon{Todo}
\<html:p>[style]{color: red;}{\x}
}}}

\def\details[x]{\<html:details>{\x}}

\def\hidden[x]{}

% Ordered list styles
\def\ol-alpha[body]{ % a)
\<html:style>{\startverb
.ol-alpha > li::marker { content: counter(list-item, lower-alpha) ") " }
\stopverb}
\<html:ol>[class]{ol-alpha}{\body}
}
\def\ol-Alpha[body]{ % A)
\<html:style>{\startverb
.ol-Alpha > li::marker { content: counter(list-item, upper-alpha) ") " }
\stopverb}
\<html:ol>[class]{ol-Alpha}{\body}
}
\def\ol-Alpha-dot[body]{ % A.
\<html:style>{\startverb
.ol-Alpha-dot > li::marker { content: counter(list-item, upper-alpha) ". " }
\stopverb}
\<html:ol>[class]{ol-Alpha-dot}{\body}
}
\def\ol-roman[body]{ % (i)
\<html:style>{\startverb
.ol-roman > li::marker { content: "(" counter(list-item, lower-roman) ") " }
\stopverb}
\<html:ol>[class]{ol-roman}[type]{i}{\body}
}
\def\ol-Roman[body]{ % (I)
\<html:style>{\startverb
.ol-Roman > li::marker { content: "(" counter(list-item, upper-roman) ") " }
\stopverb}
\<html:ol>[class]{ol-Roman}[type]{i}{\body}
}
\def\ol-Roman-dot[body]{ % I.
\<html:style>{\startverb
.ol-Roman-dot > li::marker { content: counter(list-item, upper-roman) ". " }
\stopverb}
\<html:ol>[class]{ol-Roman-dot}[type]{i}{\body}
}


% Citation
\def\citek[refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}{[\escape{[\refid]}](\refid)}}
\def\citet[tid][refid]{
\let\escape[x]{\x}\<html:span>[class]{link-reference}[tid]{\tid}[refid]{\refid}{[\escape{[\refid, \tid]}](\refid)}
}

% GitHub related
\def\PR[x]{[PR\startverb#\stopverb\x](https://github.com/samtoth/agda-synthetic-categories/pull/\x)}
\def\Issue[x]{[Issue\startverb#\stopverb\x](https://github.com/samtoth/agda-synthetic-categories/issues/\x)}
