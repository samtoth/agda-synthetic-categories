\date{2025-04-16}
\title{Spheres}
\author{samueltoth}
\taxon{Module}

\import{stt-macros}


\agda{
module Core.Spheres where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.Suspensions
}
}

\subtree[stt-002O]{
\title{#{n}-spheres}
\contributor{fredrikbakke}

\p{
The \em{spheres} #{\sphere{n}} are defined inductively. The #{-1}-sphere is the
[empty type](Foundations.Empty), and inductively the #{n+1}-sphere is the
[suspension](Core.Suspensions) of the #{n}-sphere.

\quiver{
\begin{tikzcd}
\sphere{n} && \b1 \\
\\
\b1 && \sphere{n+1}
\arrow[from=1-1, to=1-3]
\arrow[from=1-1, to=3-1]
\arrow[from=3-1, to=3-3]
\arrow[from=1-3, to=3-3]
\arrow[from=1-1, to=3-3, phantom, "\lrcorner" very near end]
\end{tikzcd}
}
}

\agda{
S : 𝕋₋₁ → Type
S -1𝕋₋₁ = ∅
S (suc-𝕋₋₁ n) = Susp (S n)

pt-S : ∀ {n} → S (suc-𝕋₋₁ n)
pt-S = North

S∗ : ℕ → Type∗ lzero
S∗ n = mk-type∗ (S (𝕋₋₁←ℕ n)) pt-S
}
}
