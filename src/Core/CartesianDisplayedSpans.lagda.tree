\date{2026-05-19}
\title{Cartesian displayed spans}
\taxon{Module}
\author{fredrikbakke}

\import{stt-macros}

\agda{
module Core.CartesianDisplayedSpans where

open import Foundations.Prelude
open import Axioms.UF
open import Core.Arrows
open import Core.ArrowEquiv
}

\subtree[stt-00WD]{
\title{Cartesian displayed spans}
\taxon{Definition}
\author{fredrikbakke}

\p{
Given a span #{S}, #{A \xleftarrow{f} X \xrightarrow{g} B}, a
\em{cartesian displayed span} over #{S} between a family #{L : A \to \Type} and a
family #{R : B \to \Type} is a family #{C : S \to \Type} together with families of
equivalences #{\Pi_{(s : S)}C(s) \simeq L(f(s))} and
#{\Pi_{(s : S)}C(s) \simeq R(g(s))}.
}

\agda{
record cartesian-spanᵈ
    {𝓤 𝓥 𝓦 𝓛 𝓜} (S : Span 𝓤 𝓥 𝓦) (𝓝 : Level)
    (Left : Span.Left S → Type 𝓛)
    (Right : Span.Right S → Type 𝓜)
  : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓛 ⊔ 𝓜 ⊔ lsuc 𝓝)
  where
  constructor mk-cartesian-spanᵈ
  field
    Centre : Span.Centre S → Type 𝓝
    Left≃  : (s : Span.Centre S) → Centre s ≃ Left (Span.left S s)
    Right≃ : (s : Span.Centre S) → Centre s ≃ Right (Span.right S s)
}

\agda{
  Left← : (s : Span.Centre S) → Centre s → Left (Span.left S s)
  Left← s = Left≃ s ._≃_.fwd

  Right← : (s : Span.Centre S) → Centre s → Right (Span.right S s)
  Right← s = Right≃ s ._≃_.fwd

  Left←-is-equiv : (s : Span.Centre S) → is-equiv (Left← s)
  Left←-is-equiv s = Left≃ s ._≃_.fwd-is-equiv

  Right←-is-equiv
    : (s : Span.Centre S) → is-equiv (Right← s)
  Right←-is-equiv s = Right≃ s ._≃_.fwd-is-equiv

  Left≃Right
    : (s : Span.Centre S) → Left (Span.left S s) ≃ Right (Span.right S s)
  Left≃Right s = Left≃ s e⁻¹ ∙e Right≃ s
}
}

\subtree[stt-00WG]{
\title{Cartesian displayed span diagrams}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-26}

\p{
A \em{cartesian displayed span diagram} over a span is the data of a
[cartesian displayed span](stt-00WD) together with its source and target families.
}

\agda{
record cartesian-span-diagramᵈ
    {𝓤 𝓥 𝓦} (S : Span 𝓤 𝓥 𝓦) (𝓛 𝓜 𝓝 : Level)
  : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ lsuc 𝓛 ⊔ lsuc 𝓜 ⊔ lsuc 𝓝)
  where
  constructor mk-cartesian-span-diagramᵈ'
  field
    Left  : Span.Left S → Type 𝓛
    Right : Span.Right S → Type 𝓜
    span  : cartesian-spanᵈ S 𝓝 Left Right

  open cartesian-spanᵈ span public

pattern mk-cartesian-span-diagramᵈ P-left P-right P-centre e-left e-right =
  mk-cartesian-span-diagramᵈ' P-left P-right
    ( mk-cartesian-spanᵈ P-centre e-left e-right)
}
}
