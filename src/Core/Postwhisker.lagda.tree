\title{(Pre)Postwhiskering}
\date{2025-06-26}
\author{samueltoth}
\taxon{Module}
\import{stt-macros}

\agda{
module Core.Postwhisker where

open import Axioms.FunExt
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.Arrows
open import Core.ArrowEquiv
}
}


\subtree[stt-006G]{
\title{Postwhiskering a homotopy}
\taxon{Definition}


\agda{
prewhisker
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      {X : Type 𝓦} (f : A → B)
      (g h : B → X)
    → g ~ h → g ∘ f ~ h ∘ f
prewhisker f g h = _▹h f

postwhisker
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      {X : Type 𝓦} (f : A → B)
      (g h : X → A)
    → g ~ h → f ∘ g ~ f ∘ h
postwhisker f g h = f ◃h_
}
}


\subtree[stt-006I]{
\title{FunExt for Postwhsikering}
\taxon{Theorem}

\p{Let #{f \colon A \to B}, and #{g,h \colon B \to C}, then
postwhiskering by #{f} is an equivalence iff #{\ap_{{-} \circ f}^{g,h}} is.}

\agda{
prewhisker←ap-compose
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      (f : A → B) (g h : B → C)
    → Arrow-map (ap (precomp C f) {g} {h}) (prewhisker f g h)
prewhisker←ap-compose _ _ _ .Arrow-map.top = happly
prewhisker←ap-compose _ _ _ .Arrow-map.bot = happly
prewhisker←ap-compose _ _ _ .Arrow-map.comm refl = refl

prewhisker-funext
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : A → B} {g h : B → C}
    → is-Arrow-equiv (prewhisker←ap-compose f g h)
prewhisker-funext .fst = global-funext
prewhisker-funext .snd = global-funext

prewhisker-is-equiv←ap-compose
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦}
      {f : A → B}
      {g h : B → C}
    → is-equiv (ap (precomp C f) {g} {h})
    → is-equiv (prewhisker f g h)
prewhisker-is-equiv←ap-compose
  = tgt-is-equiv←Arrow-equiv (prewhisker←ap-compose _ _ _ , prewhisker-funext)
}
}

\subtree[stt-00B4]{
\title{Precomposing commutes with funext}
\taxon{Lemma}

\agda{
commutes-prewhisker-funext
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
      {f : Q → A} {g h : A → B}
    → funext→ ∘ prewhisker f g h ~ ap (precomp B f) ∘ funext→
commutes-prewhisker-funext = funext-rec _ λ
  where refl → funext-refl ∙ sym (ap (ap _) funext-refl)

commutes-postwhisker-funext
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {Q : Type 𝓦}
      {f g : Q → A} {h : A → B}
    → funext→ ∘ postwhisker h f g ~ ap (postcomp Q h) ∘ funext→
commutes-postwhisker-funext = funext-rec _ λ
  where refl → funext-refl ∙ sym (ap (ap _) funext-refl)
}
}

\subtree[stt-006H]{
\title{Prewhiskering by an equivalence is an equivalence}
\taxon{Corollary}

\agda{
opaque
  prewhisker-equiv-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
        {f : A → B} → is-equiv f
      → ∀ {C : Type 𝓦} {g h : B → C}
      → is-equiv (prewhisker f g h)
  prewhisker-equiv-is-equiv e
    = prewhisker-is-equiv←ap-compose
       (is-embedding←is-equiv (precomp-equiv e))
}
}

-- TODO: Organise this
\agda{
postcomp-square-∘
  : ∀ {𝓤 𝓥 𝓦 𝓜 𝓧 𝓨}
      {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
      {X : Type 𝓧} {Y : Type 𝓨} {h : X → Y}
      (F : Arrow-map g h) (G : Arrow-map f g)
    → ∀ {𝓛} (C : Type 𝓛)
    → Arrow-map-path
        (paste-squares (postcomp-square F C) (postcomp-square G C))
        (postcomp-square (paste-squares F G) C)
postcomp-square-∘ F G C .fst = ~refl
postcomp-square-∘ F G C .snd .fst = ~refl
postcomp-square-∘ {f = f} {g = g} {h = h} F G C .snd .snd
  = paste-squares (postcomp-square F C) (postcomp-square G C) .Arrow-map.comm ∙h ~refl
 ~⟨ ∙h-reflr _ ⟩
    paste-squares (postcomp-square F C) (postcomp-square G C) .Arrow-map.comm
 ~⟨⟩
    (postcomp C (F .Arrow-map.bot) ◃h (postcomp-square G C) .Arrow-map.comm ∙h (postcomp-square F C) .Arrow-map.comm ▹h postcomp C (G .Arrow-map.top))
 ~⟨ (commutes-postwhisker-funext ∘ (G .Arrow-map.comm ∘_)) h⁻¹ ⟩∙h⟨ ~refl  ⟩
    (funext→ ∘ _) ∙h (postcomp-square F C .Arrow-Π.comm ▹h postcomp C (G .Arrow-map.top))
 ~⟨ (λ f → sym (funext-∙ (F .Arrow-map.bot ◃h (G .Arrow-map.comm ▹h f)) (F .Arrow-map.comm ▹h (G .Arrow-map.top ∘ f)))) ⟩
    funext→ ∘ ((F .Arrow-map.bot ◃h (G .Arrow-map.comm) ∙h F .Arrow-map.comm ▹h G .Arrow-map.top) ▹h_)
 ~⟨⟩
    funext→ ∘ (paste-squares F G .Arrow-map.comm ▹h_) ~∎
}
