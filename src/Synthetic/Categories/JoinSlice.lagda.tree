\subtree[stt-00D5]{
\title{The blunt join–slice adjunction}
\taxon{Theorem}

\p{We can view the partially applied [blunt join](stt-00CW) as a functor
#{({-}) \bjoin B \colon \Type \to \Type_{B/}} into the [coslice category of
types](Core.Coslices). It turns out this functor has a right adjoint given by taking
[cone types](stt-00C4), which defines a functor #{\Type_{B/} \to
\Type} that takes a map #{p \colon B \to C} to the type #{C_{/p}}.}

\proof{
\p{By a short calculation:}

##{
\begin{align*}

A \to C_{/p} &\simeq \Sigma1{f : C^A}{\Pi_{a,b} \Hom(f(a), p(b))} \\
             &\simeq \Sigma2{f : C^A}{g : C^B}{(\Pi_{a,b}\Hom(f(a),g(b))) \times (g \sim p)} \\
             &\simeq \Sigma1{f : C^{A \bjoin B}}{(f \iota_2 \sim p)} \\
             &\simeq A \bjoin B \to_{/B} p
\end{align*}
}
}

\agda{
bjoin←slice-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → (A → Over' p) → Coslice-map {X = A ◇ B} ↑-ι₂ p
bjoin←slice-map p f
  = (↑-rec (mk-directed-cocone (fst ∘ f) p (uncurry (snd ∘ f))) , ~refl)

slice←bjoin-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → Coslice-map {X = A ◇ B} ↑-ι₂ p → (A → Over' p)
slice←bjoin-map p F a
  = ( F .fst (↑-ι₁ a)
    , λ b → adjust-hom refl (F .snd b) (ap-hom (F .fst) (↑-hom (a , b))))

slice-bjoin-η
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → slice←bjoin-map {A = A} p ∘ bjoin←slice-map p ~ id
slice-bjoin-η p f = funext→ (λ
  a → Σ-path→ (refl , funext→ (λ
   b → Hom-ext→
         ( ~refl
         , (sym (∙-reflr _ ∙ pushout-rec-apβ _))
         , sym (∙-reflr _ ∙ pushout-rec-apβ _)))))

opaque
  bjoin⊣slice
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → (A → Over' p) ≃ Coslice-map {X = A ◇ B} ↑-ι₂ p
  bjoin⊣slice {A = A} {B} {C} p
    = (A → Over' p) ≃⟨ Σ-Π-swap≃ _ _ ⟩
      Σ[ f ∶ (A → C)] (∀ (a : A) (b : B) → Hom C (f a) (p b))
         ≃⟨ Σ-snd-≃ (λ f → uncurry≃) ⟩
      Σ[ f ∶ (A → C)] (∀ ((a , b) : A × B) → Hom C (f a) (p b))
         ≃⟨ Σ-fst-≃ {B = λ x → ∀ ab → Hom C (x .fst .fst (ab .fst)) (x .fst .snd (ab .snd))}
             (Σ-singleton (λ f → SingS-is-single' p) e⁻¹ ∙e Σ-assoc e⁻¹)
            ∙e (Σ-assoc ∙e (Σ-snd-≃ (λ _ → ×-swap) ∙e Σ-assoc e⁻¹
            ∙e (Σ-fst-≃ Σ-assoc))) ⟩
      Σ[ f ∶ (Σ[ f ∶ (A → C)] Σ[ g ∶ (B → C)] (∀ x → Hom C (f (fst x)) (g (snd x)))) ]
        (f .snd .fst ~ p) ≃⟨ Σ-fst-≃ (directed-cocone-repr≃ e⁻¹) ⟩
      Σ[ f ∶ directed-cocone (mk-span (A × B) fst snd) C ] (f .directed-cocone.j ~ p)
         ≃⟨ Σ-fst-≃ (↑-UP≃ e⁻¹) ⟩
      Σ[ f ∶ (A ◇ B → C)] (f ∘ ↑-ι₂ ~ p) ≃⟨⟩
      Coslice-map ↑-ι₂ p   ≃∎

  bjoin←slice-map-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → is-equiv (bjoin←slice-map {A = A} p)
  bjoin←slice-map-is-equiv p = bjoin⊣slice p ._≃_.fwd-is-equiv

  -- The inverse of adj≃ is not this map, but we can use 3-for-2
  slice←bjoin-map-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → is-equiv (slice←bjoin-map {A = A} p)
  slice←bjoin-map-is-equiv p
    = 3-for-2~' {f = slice←bjoin-map p}
       (slice-bjoin-η p h⁻¹)
       (bjoin←slice-map-is-equiv p)
       id-is-equiv

bjoin≃slice-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → (A → Over' p) ≃ Coslice-map {X = A ◇ B} ↑-ι₂ p
bjoin≃slice-map p = mk≃ (bjoin←slice-map p) (bjoin←slice-map-is-equiv p)
}

\p{Dually, we have a blunt join-cocone adjunction.}

\agda{
module _ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C) where

  bjoin←𝑪ocone-map
    : (A → 𝑪ocone p) → Coslice-map {X = B ◇ A} ↑-ι₁ p
  bjoin←𝑪ocone-map f
    = (↑-rec (mk-directed-cocone p (fst ∘ f) (uncurry (snd ∘ f) ∘ ×-swap→)) , ~refl)

  𝑪ocone←bjoin-map
    : Coslice-map {X = B ◇ A} ↑-ι₁ p → (A → 𝑪ocone p)
  𝑪ocone←bjoin-map f a
    = ( f .fst (↑-ι₂ a)
      , λ b → adjust-hom (f .snd b) refl (ap-hom (f .fst) (↑-hom (b , a))))

  bjoin⊣𝑪ocone-η
    : 𝑪ocone←bjoin-map ∘ bjoin←𝑪ocone-map ~ id
  bjoin⊣𝑪ocone-η f
    = funext→ λ a → Σ-path→ (refl , (funext→ (λ
        b → Hom-ext→
              (~refl
              , sym (∙-reflr _ ∙ pushout-rec-apβ _)
              , sym (∙-reflr _ ∙ pushout-rec-apβ _)))))

  bjoin⊣𝑪ocone-ε
    : bjoin←𝑪ocone-map ∘ 𝑪ocone←bjoin-map ~ id
  bjoin⊣𝑪ocone-ε f = ext!
    (sym ∘ ↑-rec-unique ( f .snd , ~refl , λ a → ~refl
                        , coe (Square-squeeze-topr (ap (f .fst) (glue (_ , a))))
                            (mk-square refl)
                        , Square-degen-vert _ _ (sym (∙-reflr _)))
    , ∙-sym' ∘ f .snd)

  bjoin⊣𝑪ocone
    : Coslice-map {X = B ◇ A} ↑-ι₁ p ≃ (A → 𝑪ocone p)
  bjoin⊣𝑪ocone = equiv←qequiv
    (mk≊ 𝑪ocone←bjoin-map (bjoin←𝑪ocone-map , bjoin⊣𝑪ocone-ε , bjoin⊣𝑪ocone-η))

  bjoin←𝑪ocone-map-is-equiv
    : is-equiv bjoin←𝑪ocone-map
  bjoin←𝑪ocone-map-is-equiv = bwd-is-equiv bjoin⊣𝑪ocone

  bjoin≃𝑪ocone-map
    : (A → 𝑪ocone p) ≃ Coslice-map {X = B ◇ A} ↑-ι₁ p
  bjoin≃𝑪ocone-map = mk≃ bjoin←𝑪ocone-map bjoin←𝑪ocone-map-is-equiv
}
}
