\date{2025-03-03}
\taxon{Module}
\title{Equivalences of (sub)singletons}

\import{stt-macros}


\agda{
module Foundations.EquivOfSingleton where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Singletons
open import Foundations.FunctionInverses
open import Foundations.Sigma
open import Foundations.Equivalences
}
}


\subtree[stt-001V]{
\taxon{Lemma}


\p{
Any map with a singleton domain has a retraction.
}

\agda{
retraction←singleton-dom
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      (a-sngl : is-singleton A) (f : A → B)
    → retraction f
retraction←singleton-dom sngl f .fst _ = sngl .centre
retraction←singleton-dom sngl f .snd a = sngl .central a
}
}


\subtree[stt-000W]{
\taxon{Theorem}


\p{Any map from a singleton to a prop is an equivalence}

\agda{
is-equiv←single-to-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (a-sngl : is-singleton A)
      {B : Type 𝓥} (b-prop : is-prop B)
    → (f : A → B) → is-equiv f
is-equiv←single-to-prop sa sb f
  = is-equiv←qinv ( ret .fst , ret .snd , λ _ → sb _ _) where
    ret = retraction←singleton-dom sa f
}
}
