\date{2025-06-27}
\title{Truncation modalities}
\author{samueltoth}
\contributor{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Modalities.Instances.Truncation where

open import Axioms.UF
}

\subtree[bak-A37C]{
\title{Idea}
\author{fredrikbakke}
\date{2026-09-16}

\p{
\em{Truncation} is the universal way to turn a type into a
[truncated type](Foundations.Truncated). Given a type #{A} and a
[truncation level](Foundations.TruncationLevels) #{k}, then the #{k}-truncation of
#{A} is a #{k}-truncated type #{║ A ║_k} together with a \em{unit} map
#{η \colon A \to ║ A ║_k} such that mapping from #{║ A ║_k} into any #{k}-truncated
type is equivalent to mapping out of #{A} via the restriction map along #{η}.
}
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Foundations.Truncated
open import Foundations.Sets
open import Core.Suspensions
open import Core.Spheres
open import Modalities.Instances.Localisation
open import Modalities.Instances.Nullification
open import Modalities.ReflectiveSubuniverses
open import Modalities.HigherModalities
open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.SeparatedTypes
open import Ergonomics.Universal
open import Ergonomics.PushoutUniv
open import Ergonomics.Extensionality
import Modalities.ModalMaps
}
}

\subtree[bak-AD17]{
\title{Truncated types as sphere-null types}
\taxon{Theorem}
\contributor{fredrikbakke}

\p{
A type is #{n}-truncated if and only if it is null with respect to the #{n+1}-sphere.
At level #{-2}, this says that a type is a singleton if and only if it is null
with respect to the empty type, the #{-1}-sphere. The rest follows inductively
from the [general theory](stt-007F) of separated types.
}

\agda{
is-S-null : ∀ {𝓤} → 𝕋₋₁ → Type 𝓤 → Type 𝓤
is-S-null n = is-null {I = 𝟙} (const (S n))

is-singleton←is-S⁻¹-null
  : ∀ {𝓤} {A : Type 𝓤}
    → is-S-null -1 A
    → is-singleton A
is-singleton←is-S⁻¹-null null
  = is-single←equiv⁻¹ (null≃ null tt) ∅-UP-sing

is-S⁻¹-null←is-singleton
  : ∀ {𝓤} {A : Type 𝓤}
    → is-singleton A
    → is-S-null -1 A
is-S⁻¹-null←is-singleton sing _
  = is-equiv←single-to-prop sing (is-prop←is-single ∅-UP-sing) (const: _ ∅)

opaque
  unfolding is-n-separated
  is-truncated←null
    : ∀ {𝓤} n {A : Type 𝓤}
      → is-S-null (suc-𝕋₋₁←𝕋 n) A
      → is-truncated n A
  is-truncated←null -2𝕋 = is-singleton←is-S⁻¹-null
  is-truncated←null (suc-𝕋 n) {A} null x y
    = is-truncated←null n (lem x y) where
    lem : is-separated (Null-SubU (point (S (suc-𝕋₋₁←𝕋 n))) _) A
    lem = is-separated←is-Σ-null (λ _ → S (suc-𝕋₋₁←𝕋 n)) null

  is-null←truncated
    : ∀ {𝓤} n {A : Type 𝓤}
      → is-truncated n A
      → is-S-null (suc-𝕋₋₁←𝕋 n) A
  is-null←truncated -2𝕋
    = is-S⁻¹-null←is-singleton
  is-null←truncated (suc-𝕋 n){A} tr
    = is-Σ-null←is-separated _ lem where
    lem : ∀ (x y : A) → is-S-null (suc-𝕋₋₁←𝕋 n) (x ＝ y)
    lem x y = is-null←truncated n (tr x y)
}
}

\subtree[stt-006Q]{
\title{Truncation is a [global reflective subuniverse](stt-00IF)}
\taxon{Corollary}

\agda{
Truncation-SubU
  : ∀ {𝓤} (n : 𝕋)
    → SubU 𝓤 𝓤
Truncation-SubU n .Subtype.family
  = is-truncated n
Truncation-SubU n .Subtype.family-is-subtype
  = is-truncated-is-prop n

TruncType : ∀ 𝓤 (n : 𝕋) → Type (lsuc 𝓤)
TruncType 𝓤 n = Subtype.Σ̃ (Truncation-SubU {𝓤} n)

singleton-SubU : ∀ {𝓤} → SubU 𝓤 𝓤
singleton-SubU .Subtype.family = is-singleton
singleton-SubU .Subtype.family-is-subtype _ = is-single-is-prop

singleton-gSubU : gSubU (λ 𝓤 → 𝓤)
singleton-gSubU .gSubU.S = singleton-SubU
singleton-gSubU .gSubU.∈S←equiv = is-single←equiv-to-single

Truncation-gSubU : 𝕋 → gSubU (λ 𝓤 → 𝓤)
Truncation-gSubU n .gSubU.S = Truncation-SubU n
Truncation-gSubU n .gSubU.∈S←equiv = is-truncated←equiv
opaque
  unfolding is-n-separated
  Trunc≃SNull-gSubU
    : ∀ {n}
      → gSubU-equiv (Null-gSubU (point (S (suc-𝕋₋₁←𝕋 n))))
          (Truncation-gSubU n)
  Trunc≃SNull-gSubU A = (is-truncated←null _ , is-null←truncated _)

singleton-gSubU-is-reflective : is-globally-reflective singleton-gSubU
singleton-gSubU-is-reflective .is-globally-reflective.○ A = ∅ → A
singleton-gSubU-is-reflective .is-globally-reflective.η a _ = a
singleton-gSubU-is-reflective .is-globally-reflective.η-is-reflector
  {𝓤} {A} = gr where
  open is-global-reflector
  gr : is-global-reflector singleton-gSubU A (∅ → A) (const: A ∅)
  gr .○∈S = ∅-UP-sing
  gr .reflects Qs
    = is-equiv←single-to-prop
        (Π-is-single (λ _ → Qs))
        (is-prop←is-single (Π-is-single (λ _ → Qs)))
        (precomp _ (const: A ∅))

singleton-gRSubU : gRSubU (λ 𝓤 → 𝓤)
singleton-gRSubU .gRSubU.GS = singleton-gSubU
singleton-gRSubU .gRSubU.GS-is-globally-reflective = singleton-gSubU-is-reflective

opaque
  unfolding is-n-separated

  Truncation-grefl : ∀ {n} → is-globally-reflective (Truncation-gSubU n)
  Truncation-grefl {n = -2𝕋}
    = mk-gReflectors ○ η (mk-grfltor ○∈S reflects)
    where open is-globally-reflective singleton-gSubU-is-reflective
  Truncation-grefl {suc-𝕋 n} = is-globally-reflective-subtype-equiv
                              (Trunc≃SNull-gSubU {suc-𝕋 n})
                              (Null∙-global-reflectors (λ _ → pt-S))

  Truncation-refl : ∀ {𝓤} n → is-reflective (Truncation-SubU {𝓤} n)
  Truncation-refl n = is-reflective←global (Truncation-grefl)

  Truncation-Σ-closed : ∀ {n} → is-globally-Σ-closed (Truncation-gSubU n)
  Truncation-Σ-closed = Σ-is-truncated

Truncation-gRSubU : (n : 𝕋) → gRSubU (λ 𝓤 → 𝓤)
Truncation-gRSubU n .gRSubU.GS = Truncation-gSubU n
Truncation-gRSubU n .gRSubU.GS-is-globally-reflective = Truncation-grefl {n}

module Trunc {n} where
  open gReflectiveReasoning (Truncation-gRSubU n) public
  open gRSubUInduction (Truncation-gRSubU n) Truncation-Σ-closed public
  open gSubU (Truncation-gSubU n) public
  open gReflectiveClosure (Truncation-gRSubU n) public
  open is-globally-reflective (Truncation-grefl {n}) public

  untrunc : ∀ {𝓤} {A : Type 𝓤} → is-truncated n A → ○ A → A
  untrunc = unmod (reflector _)

module _ {n} where
  open gReflectiveClosure (Truncation-gRSubU n) public using () renaming
    ( retract∈S to retract-is-truncated
    ; biinv∈S to biinv-is-truncated
    ; ≃∈S to ≃-is-truncated
    ; Seq-lim∈S to Seq-lim-is-truncated
    ; preidempotent-map∈S to preidempotent-map-is-truncated
    ; TotalId∈S to TotalId-is-truncated
    ; quasicoherence-boundary∈S to quasicoherence-boundary-is-truncated
    ; quasicoherence-data∈S to quasicoherence-data-is-truncated
    ; qidempotent-map∈S to qidempotent-map-is-truncated
    ; Retracts∈S to Retracts-is-truncated
    ; idempotent-map∈S to idempotent-map-is-truncated)

opaque
  Trunc-U-is-truncated
    : ∀ n {𝓤} → is-truncated (suc-𝕋 n) (Trunc-U n 𝓤)
  Trunc-U-is-truncated n (X , Xtr) (Y , Ytr)
    = is-truncated←equiv
        (Σ-path)
        (Σ-is-truncated
          (is-truncated←equiv (mk≃ _ (is-equiv⁻¹ UA)) (≃-is-truncated Xtr Ytr))
          (λ where
            refl → is-truncated←is-single
              (＝-is-single←is-prop (is-truncated-is-prop n X) Xtr Ytr)))

Trunc : ∀ {𝓤} n → Type 𝓤 → Type 𝓤
Trunc n = Trunc.○ {n}

║_║₋₁ : ∀ {𝓤} → Type 𝓤 → Type 𝓤
║_║₋₁ = Trunc -1
{-# NOINLINE ║_║₋₁ #-}

║-║₋₁-is-prop : ∀ {𝓤} {A : Type 𝓤} → is-prop ║ A ║₋₁
║-║₋₁-is-prop = is-prop←is-truncated Trunc.○∈S

║_║₀ : ∀ {𝓤} → Type 𝓤 → Type 𝓤
║_║₀ = Trunc 0
{-# NOINLINE ║_║₀ #-}

║-║₀-is-set : ∀ {𝓤} {A : Type 𝓤} → is-set ║ A ║₀
║-║₀-is-set = is-set←is-truncated Trunc.○∈S

{-# DISPLAY Trunc.○ {n} A = Trunc n A #-}
}
}

\subtree{
\title{Suspension raises nullity}
\taxon{Theorem}

\p{If a type is null with respect to a family, then it is null with
respect to the pointwise suspension of that family.}

\agda{
suc-is-null
  : ∀ {𝓘 𝓤 𝓥}
      {I : Type 𝓘}
      {X : I → Type 𝓥}
      {A : Type 𝓤}
    → is-null X A
    → is-null (Susp ∘ X) A
suc-is-null {X = X} {A} A-null i = eqv where opaque
  module eqv = is-equiv (A-null i)
  Ideq : {x y : A} → (x ＝ y) ≃ (X i → x ＝ y)
  Ideq {x} {y} = (mk≃ _ (＝-is-null X A-null {x} {y} i))

  module Ideq x y = _≃_ (Ideq {x} {y})

  map1 : A → Σ[ a b ∶ A ] (X i → a ＝ b)
  map1 a = (a , a , ~refl)

  map1-eqv : A ≃ (Σ[ a b ∶ A ] (X i → a ＝ b))
  map1-eqv
    = A                             ≃⟨ Σ-singleton (λ _ → Sing-is-singleton) e⁻¹ ⟩
      ((Σ[ a ∶ A ] Sing A a))       ≃⟨ Σ-snd-≃ (λ a → Σ-snd-≃ (λ b → Ideq)) ⟩
      (Σ[ a b ∶ A ] (X i → a ＝ b)) ≃∎

  map1-is-equiv : is-equiv map1
  map1-is-equiv = map1-eqv ._≃_.fwd-is-equiv

  homtpy : const: A (Susp (X i)) ~ Susp-UP→ ∘ map1
  homtpy a
    = funext→
        (pushout-ind _
          (mk-coconeᵈ ~refl ~refl λ x
            → Idᵈ-func←Square (glue x) _ _
                (mk-square
                  (∙-reflr _ ∙ sym (pushout-rec-apβ x ∙ sym (ap-const _))))))

  eqv : is-equiv (const: A (Susp (X i)))
  eqv = is-equiv-~∘ homtpy
                   (_≃_.fwd-is-equiv (Susp-UP≃ e⁻¹))
                   map1-is-equiv
}
}

\subtree{
\date{2025-06-29}
\title{Truncations are truncated}

\agda{
instance
  Trunc-trunc
    : ∀ {𝓤} {A : Type 𝓤}
        {n k}
      → Is-truncated (itsuc-𝕋 k n) (Trunc n A)
  Trunc-trunc {n = n} {k} = truncation-instance n (Trunc.○∈S) {k}
  {-# INCOHERENT Trunc-trunc #-}

module _ {𝓤} {A : Type 𝓤} ⦃ _ : ∀ {k} → Is-truncated (suc-𝕋 (suc-𝕋 k)) A ⦄ where
  _ : is-truncated 1 A
  _ = trunc!

  _ : ∀ {x y : A} → is-truncated -1 (x ＝ y)
  _ = trunc!

  _ : is-truncated 0 (A → A)
  _ = trunc!

  _ : ∀ {f g : S 5 → A} → is-truncated -1 (f ~ g)
  _ = trunc!

  _ : is-truncated -1 (A → Trunc -1 (S 5))
  _ = trunc!
}
}
