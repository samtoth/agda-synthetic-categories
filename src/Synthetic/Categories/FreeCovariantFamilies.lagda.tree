\subtree[bak-C23E]{
\title{Covariant disks}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be any map, then for any diagram #{b \colon J \to B}
we may form the type of \em{covariant disks} under #{p} into #{b}, given by
#{\CovDisk_p(b)\defeq ʃ(p \downarrow b)} where #{p \downarrow b} is the
[comma type](stt-00C3) and #{ʃ} is nullification at #{Δ¹}.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) where

  Cov-disk : ∀ {𝓙} {J : Type 𝓙} → (J → B) → Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk b = Δ¹Disc.○ (p ↓ b)

  Cov-disk-π : ∀ {𝓙} {J : Type 𝓙} → Σ (J → B) Cov-disk → (J → B)
  Cov-disk-π = fst: Cov-disk
}
}

\subtree[stt-014W]{
\title{The free covariant family}
\author{samueltoth}
\date{2026-09-24}
\taxon{Definition}

\p{Let #{p \colon E \to B} be any map, then the \em{free covariant family}
on #{p}, written #{\FreeCov(p)}, is the type family that sends #{b : B} to the type
#{ʃ(p \downarrow b)}, where #{\downarrow} is the [comma type](stt-00C3) and #{ʃ} is
nullification at #{Δ¹}. Some authors write #{p \downarrow b} as #{p_{/b}}. By abuse
of notation, we also write #{\FreeCov(p)} for the free left fibration, which is the
unstraightening of the free covariant family.
}

\p{For any type #{B} there is a forgetful functor from left fibrations over #{B} and
maps over #{B}. In this module we show that when #{B} is a [Segal type](stt-00AI),
#{\FreeCov(-)} is the left adjoint to this forgetful functor.}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) where

  Free-cov-fam : B → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  Free-cov-fam b = Cov-disk p (point b)

  Free-left-fibration : Σ B Free-cov-fam → B
  Free-left-fibration = fst: Free-cov-fam
}
}

\subtree[bak-CA79]{
\title{Transport in covariant disks}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Given a map #{p \colon E \to B} into a [Segal type](stt-00AI) #{B} and a pair of
diagrams in #{B}, #{x \colon J' \to B} and #{y \colon J \to B}, then every reindexing
map #{j₀ \colon J' \to J} equipped with a natural transformation of morphisms
#{{\Hom(x, yj₀)}} gives a transport map of comma types:
##{(p \downarrow x) \to (p \downarrow y)\nsp{,}}
and this transport map descends to covariant disks
##{\CovDisk_p(x) \to \CovDisk_p(y)\nsp{.}}
}

\p{
Moreover, this action is unital in the sense that it restricts to the identity
function when #{x} is {y}, the reindexing is the identity, and the natural
transformation is given by the identity transformation. Hence, by the
[unital transport criterion](stt-00VJ) #{\CovDisk_p} defines a covariant family.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-comma
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → p ↓ x → p ↓ y
  transport-comma j₀ f (e , i , α) = (e , j₀ i , f i ∘[ 𝐵 ] α)

  transport-Cov-disk
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → Cov-disk p x → Cov-disk p y
  transport-Cov-disk j₀ f = Δ¹Disc.○₁ (transport-comma j₀ f)

  transport-comma-unital
    : ∀ {𝓙} {J : Type 𝓙} {y : J → B}
      → transport-comma id (idH ∘ y) ~ id
  transport-comma-unital x
    = Σ-path→ (refl , (Σ-path→ (refl , ∘[ 𝐵 ]-right-unit)))

  transport-Cov-disk-unital
    : ∀ {𝓙} {J : Type 𝓙} (b : J → B)
      → transport-Cov-disk id (idH ∘ b) ~ id
  transport-Cov-disk-unital _
    = Δ¹Disc.○-~ transport-comma-unital ∙h Δ¹Disc.○₁-id

  Cov-disk-is-covariant
    : ∀ {𝓙} {J : Type 𝓙} → is-covariant (Cov-disk p {J = J})
  Cov-disk-is-covariant
    = is-covariant←cov-unital-transport
        ( λ b → Δ¹Disc.○∈S {A = p ↓ b})
        ( (transport-Cov-disk id ∘ Nat←Hom)
        , transport-Cov-disk-unital)

  Cov-disk-π-is-left-fibration
    : ∀ {𝓙} {J : Type 𝓙} → is-left-fibration (Cov-disk-π p {J = J})
  Cov-disk-π-is-left-fibration
    = is-left-fibration←is-covariant (Cov-disk p) Cov-disk-is-covariant
}
}

\subtree[stt-014Y]{
\title{The free covariant family over a Segal type is covariant}
\taxon{Corollary}
\author{samueltoth}
\contributor{fredrikbakke}
\date{2026-09-24}

\p{If #{B} is a [Segal](stt-00AI) type, then the free covariant family on any map
#{p \colon E \to B} is a [covariant type family](stt-00AY).}

\proof{
\p{
The free covariant family is the [base change](stt-00FU) of the
[covariant disk family](bak-CA79) along #{{\point} \colon B \to (\b1 \to B)}.
}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-under
    : {a b : B} → Hom B a b → p ↓ point a → p ↓ point b
  transport-under f = transport-comma 𝐵 p id (λ _ → f)

  transport-Free-cov-fam
    : {a b : B} → Hom B a b → Free-cov-fam p a → Free-cov-fam p b
  transport-Free-cov-fam f = transport-Cov-disk 𝐵 p id (λ _ → f)

  transport-under-unital
    : {b : B} → transport-under (idH b) ~ id
  transport-under-unital = transport-comma-unital 𝐵 p

  transport-Free-cov-fam-unital
    : (b : B) → transport-Free-cov-fam (idH b) ~ id
  transport-Free-cov-fam-unital = transport-Cov-disk-unital 𝐵 p ∘ point

  Free-cov-fam-is-covariant : is-covariant (Free-cov-fam p)
  Free-cov-fam-is-covariant
    = covariant-base-change {P = Cov-disk p} point (Cov-disk-is-covariant 𝐵 p)

  Free-left-fibration-is-left-fibration
    : is-left-fibration (Free-left-fibration p)
  Free-left-fibration-is-left-fibration
    = is-left-fibration←is-covariant (Free-cov-fam p) Free-cov-fam-is-covariant
}
}

\subtree[bak-E834]{
\title{Base change of covariant disks}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map into a [Segal type](stt-00AI) #{B}, and let
#{b : \Pi1{a : A}{J(a) \to B}} be a family of diagrams. If #{J} admits
[covariant lifts](bak-4CAE), then the type family #{\CovDisk_p\circ b} is covariant.
}

\proof{
\p{
TODO
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  lift-comma-along
    : (h : Δ¹ → A) (e : E) {j : J (h i0)}
    → (Σ[ j' ∶ J (h i1) ] Homᵈ (J ∘ h) j j')
    → (α : Hom B (p e) (b (h i0) j))
    → Σ[ c ∶ (p ↓ b (h i1)) ] Homᵈ (λ i → (p ↓ b (h i))) (e , j , α) c
  lift-comma-along h e (j' , mk-hom k refl refl) α
    = let (β , β-lift) = hom-fam-cov 𝐵 (p e) (λ i → b (h i) (k i)) α .centre
      in ((e , j' , β) , ap-hom (λ {i} γ → (e , k i , γ)) β-lift)

  lift-comma-base-change
    : Covariant-lifts J → Covariant-lifts (λ a → (p ↓ b a))
  lift-comma-base-change lift-J h (e , j , α)
    = lift-comma-along h e (lift-J h j) α

  Cov-disk-base-change-is-covariant
    : Covariant-lifts J → is-covariant (Cov-disk p ∘ b)
  Cov-disk-base-change-is-covariant lift-J
    = ʃ∘-is-covariant←lifts {P = (λ a → (p ↓ b a))} (lift-comma-base-change lift-J)
}
}

\subtree[bak-E9FE]{
\title{The covariant disk bundle}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map, and #{b : \Pi1{a : A}{J(a) \to B}} a family of
diagrams in #{B}. Their total space #{\Sigma1{a : A}{\CovDisk_p(b(a))}} is the
\em{covariant disk bundle} under #{p} into #{b}. This type comes equipped with a unit
map #{\Sigma1{a : A}{p \downarrow b(a)} \to \Sigma1{a : A}{\CovDisk_p(b(a))}} which
is left anodyne, in fact it is #{Δ¹}-anodyne. Moreover, when #{B} is Segal and #{J}
admits covariant lifts, the bundle projection map
#{\Sigma1{a : A}{\CovDisk_p(b(a))} \to A} is a [left fibration](bak-B06D).
}

\proof{
\p{
TODO
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  Cov-disk-bundle : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓙)
  Cov-disk-bundle = Σ[ a ∶ A ] Cov-disk p (b a)

  Cov-disk-bundle-π : Cov-disk-bundle → A
  Cov-disk-bundle-π = fst

  Cov-disk-bundle-η : (Σ[ a ∶ A ] (p ↓ b a)) → Cov-disk-bundle
  Cov-disk-bundle-η = total-map (λ _ → Δ¹Disc.η)

  precomp-Cov-disk-bundle-η≃
    : ∀ {𝓧 𝓜} {X : Type 𝓧} (Y : X → Type 𝓜)
      → ((x : X) → is-Δ¹-discrete (Y x))
      → (g : Cov-disk-bundle → X)
      → Π Cov-disk-bundle (Y ∘ g)
      ≃ Π (Σ[ a ∶ A ] (p ↓ b a)) (Y ∘ g ∘ Cov-disk-bundle-η)
  precomp-Cov-disk-bundle-η≃ Y Y-is-discrete g
    =  curry≃
    ∙e postcomp-Π-≃ (λ a
        → Δ¹Disc.○-UPᵈ≃ {P = Y ∘ g ∘ (a ,_)} (Y-is-discrete ∘ g ∘ (a ,_)))
    ∙e uncurry≃

  Cov-disk-bundle-η-is-connected
    : is-connected-map Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
  Cov-disk-bundle-η-is-connected
    = is-connected-map←up-connected-map Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
        (λ {U = Y} Y-is-discrete
          → precomp-Cov-disk-bundle-η≃ Y Y-is-discrete id ._≃_.fwd-is-equiv)

  Cov-disk-bundle-η-is-left-anodyne
    : is-left-anodyne Cov-disk-bundle-η
  Cov-disk-bundle-η-is-left-anodyne f f-is-left
    = connected⊥modal Δ¹DiscreteType-gRSubU Cov-disk-bundle-η-is-connected
        (is-Δ¹-discrete-family←is-covariant
          (is-covariant←is-left-family (fibre f)
            (are-orthogonal-fibre←are-orthogonal f-is-left)))

module _
  {𝓤 𝓥 𝓦 𝓙} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) (𝐵 : is-segal B) {A : Type 𝓦}
  where

  Cov-disk-bundle-π-is-left-fibration
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → Covariant-lifts J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration b lift-J
    = is-left-fibration←is-covariant
        (Cov-disk p ∘ b)
        (Cov-disk-base-change-is-covariant 𝐵 p b lift-J)

  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → is-covariant J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant b J-is-covariant
    = Cov-disk-bundle-π-is-left-fibration b
        (λ h j → J-is-covariant h j .centre)

  Cov-disk-bundle-π-is-left-fibration'
    : {J : Type 𝓙} (b : A → J → B)
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration' b
    = Cov-disk-bundle-π-is-left-fibration b (λ _ j → (j , idH j))
}
}

\subtree[stt-014S]{
\title{The free covariant family gives a left anodyne/left fibration factorisation}
\taxon{Corollary}
\author{samueltoth}
\contributor{fredrikbakke}
\date{2026-09-24}

\p{If #{B} is a [Segal type](stt-00AI) and #{p} is any map #{E \to B}, then the
canonical lift of #{ʃ(p \downarrow {-})} along #{p} given at #{e} by the identity
morphism at #{p(e)} is a left anodyne map, and induces
a factorisation of #{p} into a left anodyne map followed by a left fibration.}

\proof{
\p{Let #{\eta \colon E \to \FreeCov(p)} be the aforementioned lift. It suffices to
show that for any covariant family #{Y \colon X \to \Type} and any map
#{g \colon \FreeCov(p) \to X}, the induced map
#{(\Pi_{\FreeCov(p)} Yg) \to (\Pi_{E} Yg\eta)} is an equivalence.}

\p{To this end we construct an equivalence of arrows:

\quiver{
\begin{tikzcd}
	{\Pi_{\FreeCov(p)} Yg} && {\Pi_E Yg\eta^l} \\
	{\Pi_{(b : B)}\Pi_{(x : p \downarrow b)} Yg(b,\vert x \vert)} \\
	{\Pi_{(e : E)}\Pi_{(x : B_{p(e)/})} Yg(x_1, \vert(e,x_2)\vert)}
  && {\Pi_{(e:E)} Yg(p(e),\vert(e,\id_{p(e)})\vert)}\nsp{,}
	\arrow[from=1-1, to=1-3]
	\arrow["\simeq"', from=1-1, to=2-1]
	\arrow[equals, from=1-3, to=3-3]
	\arrow["\simeq"', from=2-1, to=3-1]
	\arrow["{\Pi_E \ev_{\id}}"', from=3-1, to=3-3]
\end{tikzcd}
}

where the first left equivalence follows from \ref{bak-E9FE}. It is given by the
universal property of nullification at #{Δ¹} since #{Yg} is covariant and so in
particular a #{Δ¹}-discrete family; the second is simply a rearranging the arguments.
Finally the bottom map is an equivalence by the [Yoneda lemma](stt-00LK).
}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) where

  Free-cov-fam-η : (e : E) → Free-cov-fam p (p e)
  Free-cov-fam-η e = Δ¹Disc.η (e , (_ , idH (p e)))

  Free-cov-fam-η-fibred : ∀ b → (e : fibre p b) → Free-cov-fam p b
  Free-cov-fam-η-fibred b (e , p) = Δ¹Disc.η (e , (tt , (Hom←Id p)))

  Free-left-fib-η : E → Σ B (Free-cov-fam p)
  Free-left-fib-η e = (p e , Free-cov-fam-η e)

module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  Free-left-fib-η-is-left-anodyne : is-left-anodyne (Free-left-fib-η p)
  Free-left-fib-η-is-left-anodyne
    = is-anodyne-∘ (point i0)
        (Cov-disk-bundle-η-is-left-anodyne p point)
        (is-anodyne←equiv _ _
          (mk-arr-equiv
            (Σ-singleton (λ _ → 𝟙-is-singleton))
            (total-coslice≃total-comma-point p)
            (~refl))
          (point i0)
          (λ g g-left → left-orthogonal-Σ _ g (λ e
            → point-init-is-left-anodyne (coslice-init 𝐵 (p e)) g g-left)))
}
}

\subtree[stt-014U]{
\title{The universal property of the free covariant family}
\taxon{Corollary}
\author{samueltoth}
\date{2026-09-27}
\taxon{Lemma}

\p{If #{B} is a [Segal type](stt-00AI) and #{p} is any map #{E \to B}, then the
unit map #{\eta \colon E \to \Sigma \FreeCov(p)} defined in \ref{stt-014S} is the
unit of the adjunction between covariant families and type families over
#{B}. Concretely, we show that for any covariant family #{X} over #{B}, precomposing
by #{\eta} induces an equivalence
##{(\Pi_b (\FreeCov(p,b) \to X(b))) \to (\Pi_b(\fibre{p}{E} \to X(b)))\nsp{.}}}

\proof{
\p{This is a special case of the fact that #{\eta} is a left anodyne map. The
universal property can be equivalently stated as requiring the following square to
have unique lifts:

\quiver{
\begin{tikzcd}
  E \arrow[r] \arrow[d] & X \arrow[d] \\
  {\FreeCov(p)} \arrow[r] & B\nsp{,}
\end{tikzcd}
}

and since the right map is a left fibration, \ref{stt-014S} tells us that these lifts
exist uniquely, as required.
}
}

\agda{
module _
  {𝓤 𝓥 𝓦} {B : Type 𝓤} (𝐵 : is-segal B)
  {E : Type 𝓥} (p : E → B)
  (X : B → Type 𝓦)
  (X-cov : is-covariant X)
  where

  Free-cov-fam-UP
    : is-equiv (postcomp-Π (λ b → precomp (X b) (Free-cov-fam-η-fibred p b)))
  Free-cov-fam-UP
    = src-is-equiv←Arrow-equiv
        (mk-arr-equiv uncurry≃ (precomp-Π-over-fibres≃ X p e⁻¹) ~refl)
        (are-orthogonal-fam←are-orthogonal-fst
          (Free-left-fib-η-is-left-anodyne 𝐵 p (fst: X)
            (is-left-fibration←is-covariant X X-cov))
          (Free-left-fibration p))
}
}

\subtree[stt-014T]{
\title{A map into a Segal type is left anodyne iff the free left fibration is an equivalence}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  opaque
    Free-left-fib-is-equiv←is-left-anodyne
      : is-left-anodyne p → is-equiv (fst: Free-cov-fam p)
    Free-left-fib-is-equiv←is-left-anodyne pl
      = is-equiv←self-orthogonal
          (is-anodyne-right-cancel (point i0)
            pl
            (Free-left-fib-η-is-left-anodyne 𝐵 p)
            fst
            (is-left-fibration←is-covariant (Free-cov-fam p) (Free-cov-fam-is-covariant 𝐵 p)))

    is-left-anodyne←Free-left-fib-is-equiv
      : is-equiv (fst: Free-cov-fam p) → is-left-anodyne p
    is-left-anodyne←Free-left-fib-is-equiv fe
      = is-anodyne-∘ {f = fst} (point i0)
          (λ g _ → equiv⊥ fe g)
          (Free-left-fib-η-is-left-anodyne 𝐵 p)
}
}


\subtree[bak-3CC0]{
\title{The unit of the free left fibration is an equivalence on realisations}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-03}

\p{
Let #{p \colon E \to B} be a map into a [Segal type](stt-00AI) #{B}. Then
the unit #{E \to \FreeCov(p)} induces an equivalence on realisations
##{ʃE \simeq ʃ\FreeCov(p) \nsp{.}}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  Free-left-fib-η-has-up-modal-equiv
    : up-modal-equiv Δ¹DiscreteType-gSubU (Free-left-fib-η p)
  Free-left-fib-η-has-up-modal-equiv Q-is-discrete
    = orthogonal-type←orthogonal-!
        (Free-left-fib-η-is-left-anodyne 𝐵 p !
          (!-is-left-fibration←is-Δ¹-discrete Q-is-discrete))

  Free-left-fib-η-is-modal-equiv
    : is-modal-equiv Δ¹DiscreteType-gRSubU (Free-left-fib-η p)
  Free-left-fib-η-is-modal-equiv
    = is-modal-equiv←up-modal-equiv
        (Δ¹DiscreteType-gRSubU)
        (Free-left-fib-η-has-up-modal-equiv)

  ʃFree-left-fib≃ : Δ¹Disc.○ E ≃ Δ¹Disc.○ (Σ B (Free-cov-fam p))
  ʃFree-left-fib≃
    = mk≃ (Δ¹Disc.○₁ (Free-left-fib-η p)) Free-left-fib-η-is-modal-equiv
}
}
