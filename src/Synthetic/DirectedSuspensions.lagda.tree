\title{Directed suspensions}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-19}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.DirectedSuspensions
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.Orthogonal
open import Core.RelativeSuspensions
open import Core.RelativeSuspensionsFunctoriality
open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.GlobalRelativeSeparations
