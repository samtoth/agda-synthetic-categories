\subtree[stt-0112]{
\title{The point inclusion of #{0} into a cube is left anodyne}
\taxon{Proposition}
\author{samueltoth}
\contributor{fredrikbakke}

\p{
For a cube #{A \to Δ¹}, the constantly #{0} element is an initial object and
consequently its point inclusion is left anodyne.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  cube-hom-from-0
    : (f : A → Δ¹) → Hom (A → Δ¹) (const i0) f
  cube-hom-from-0 f .Homᵈ.hom t a = t ∧ f a
  cube-hom-from-0 f .Homᵈ.hom0 = funext→ (λ _ → 0-init)
  cube-hom-from-0 f .Homᵈ.hom1 = funext→ (λ _ → 1-top')

  cube-hom-from-0-at-0
    : cube-hom-from-0 (const: Δ¹ A i0) ＝ idH (const i0)
  cube-hom-from-0-at-0
    = Hom-ext→ ((λ _ → funext→ λ _ → 0-init') , prop! , prop!)

  cube-0-is-initial
    : is-segal Δ¹ → is-initial (const: Δ¹ A i0)
  cube-0-is-initial Δ¹-is-segal
    = is-initial←hom-section (→-is-segal Δ¹-is-segal)
        cube-hom-from-0 cube-hom-from-0-at-0

  ev-cube-0-covariant-is-equiv
    : ∀ {𝓥} {P : (A → Δ¹) → Type 𝓥}
      → is-covariant P
      → is-equiv (evᵈ: P (const i0))
  ev-cube-0-covariant-is-equiv {P = P} Pc
    = ev-init-covariant-is-equiv'
        cube-hom-from-0 cube-hom-from-0-at-0 Pc

  cube-0-is-left-anodyne
    : is-left-anodyne (point (const: Δ¹ A i0))
  cube-0-is-left-anodyne
    = point-init-is-left-anodyne'
        cube-hom-from-0 cube-hom-from-0-at-0
}

\p{
As a special case, the point inclusion of #{0} into a finite cube is left anodyne.
However, the proof below is a direct inductive proof.
}

\agda{
□-0-is-left-anodyne : {m : ℕ} → is-left-anodyne (point (□-0 {m}))
□-0-is-left-anodyne {zero} r _ = equiv⊥ mk-lift-is-equiv r
□-0-is-left-anodyne {suc zero} r 0r = 0r
□-0-is-left-anodyne {suc (suc m)}
  = is-anodyne←equiv
      (point □-0 ×₁ point i0) (point □-0)
      (mk-arr-equiv (sing≃𝟙 single!) id≃ ~refl)
      (point i0)
      (λ r 0r
       → left-orthogonal-× (point □-0) (point i0) r
          (□-0-is-left-anodyne {suc m} r 0r)
          0r)
}
}

\subtree[stt-0113]{
\title{Separation by cubes and types with initial objects}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-06}

\p{
Types with initial objects separate if cubes separate, and cubes separate if finite
cubes separate.
}

\agda{
cubes-separate←finite-cubes-separate
  : family-separates □^_
  → large-family-separates (λ 𝓤 → Type 𝓤) (λ A → A → Δ¹)
cubes-separate←finite-cubes-separate sep fa fe eq
  = sep fa fe (λ { {n} →
      tgt-is-equiv←Arrow-equiv
        (♭-arrow-equiv
          (mk-arr-equiv (precomp-≃ (□≃cube n)) (precomp-≃ (□≃cube n)) ~refl))
        (eq {i = Fin n})})

types-with-initial-object-separate'←cubes-separate
  : large-family-separates (λ 𝓤 → Type 𝓤) (λ A → A → Δ¹)
  → large-family-separates (λ 𝓤 → Type-With-Initial-Obj' 𝓤) fst
types-with-initial-object-separate'←cubes-separate sep fa fe eq
  = sep fa fe
      (λ {i = A}
       → eq {i = ((A → Δ¹) , const i0 , cube-hom-from-0 , cube-hom-from-0-at-0)})

types-with-initial-object-separate'←finite-cubes-separate
  : family-separates □^_
  → large-family-separates (λ 𝓤 → Type-With-Initial-Obj' 𝓤) fst
types-with-initial-object-separate'←finite-cubes-separate sep
  = types-with-initial-object-separate'←cubes-separate
      (cubes-separate←finite-cubes-separate sep)
}
}

\subtree[stt-0105]{
\title{Global points of #{Δ²}}
\taxon{Lemma}
\date{2026-09-09}
\author{samueltoth}

\p{If the inclusion #{∂Δ¹ \to \Delta^1} is [#{\flat}-connected](stt-0103), then
so is the inclusion of points #{3 \to \Delta^2}.}

\proof{
We exhibit the map #{3 \to \Delta^2} as a retract of the product of two copies
of #{∂Δ¹ \to Δ¹}.
}

\agda{
Fin-3-retract-∂Δ¹×∂Δ¹ : retract (Fin 3) (∂Δ¹ × ∂Δ¹)
Fin-3-retract-∂Δ¹×∂Δ¹ .fst fzero = (∂Δ¹-0 , ∂Δ¹-0)
Fin-3-retract-∂Δ¹×∂Δ¹ .fst (fsuc fzero) = (∂Δ¹-1 , ∂Δ¹-0)
Fin-3-retract-∂Δ¹×∂Δ¹ .fst (fsuc (fsuc fzero)) = (∂Δ¹-1 , ∂Δ¹-1)
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .fst (∂Δ¹-1 , ∂Δ¹-1) = 2
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .fst (∂Δ¹-1 , ∂Δ¹-0) = 1
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .fst (∂Δ¹-0 , ∂Δ¹-1) = 2
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .fst (∂Δ¹-0 , ∂Δ¹-0) = 0
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .snd fzero = refl
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .snd (fsuc fzero) = refl
Fin-3-retract-∂Δ¹×∂Δ¹ .snd .snd (fsuc (fsuc fzero)) = refl

retract-Δ²-points-∂Δ¹×∂Δ¹
  : Arrow-retract (Δ²-point-incl) (∂Δ¹-incl ×₁ ∂Δ¹-incl)
retract-Δ²-points-∂Δ¹×∂Δ¹ = mk-arr-retract
  Fin-3-retract-∂Δ¹×∂Δ¹ Δ²-retract-Δ¹×Δ¹
  (λ { fzero → refl
     ; (fsuc fzero) → refl
     ; (fsuc (fsuc fzero)) → refl })
  (λ { (∂Δ¹-1 , ∂Δ¹-1) → Δ²-ext (1-coinit  , refl)
     ; (∂Δ¹-1 , ∂Δ¹-0) → Δ²-ext (1-coinit' , refl)
     ; (∂Δ¹-0 , ∂Δ¹-1) → Δ²-ext (1-coinit  , refl)
     ; (∂Δ¹-0 , ∂Δ¹-0) → Δ²-ext (0-bottom  , refl) })
  (λ _ → Δ²-is-set _ _ _ _)

Δ²-points-♭-connected
  : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl
  → is-♭-connected (Truncation-gRSubU -1) Δ²-point-incl
Δ²-points-♭-connected ∂Δ¹-♭-connected
  = is-♭-connected←retraction-arrow-map (Truncation-gRSubU -1)
      retract-Δ²-points-∂Δ¹×∂Δ¹
      (×₁-is-♭-connected (Truncation-gRSubU -1)
        ∂Δ¹-♭-connected ∂Δ¹-♭-connected)
}

\p{
For convenience, we record the propositional induction principle of the simplices
when the boundary inclusion of #{Δ¹} is #{♭}-connected.
}

\agda{
module ♭Δ-Induction
  (@♭ ∂Δ¹-♭-connected : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl)
  (open gRSubUConnectedCharacterisation (Truncation-gRSubU -1))
  where

  ♭Δ¹-ind
    : ∀ {𝓤} (P : @♭ Δ¹ → Prop 𝓤)
      → P i0 .fst → P i1 .fst → (@♭ x : Δ¹) → P x .fst
  ♭Δ¹-ind P p0 p1
    = up-♭-surjection←up-♭-connected-map
        (up-connected-map←is-connected-map _ ∂Δ¹-♭-connected)
        P
        (λ { ∂Δ¹-0 → p0 ; ∂Δ¹-1 → p1 })

  ♭Δ²-ind
    : ∀ {𝓤} (P : @♭ Δ² → Prop 𝓤)
      → (∀ (@♭ x : Fin 3) → P (Δ²-point-incl x) .fst)
      → (@♭ x : Δ²) → P x .fst
  ♭Δ²-ind
    = up-♭-surjection←up-♭-connected-map
        (up-connected-map←is-connected-map _
          (Δ²-points-♭-connected ∂Δ¹-♭-connected))
}
}

\subtree[stt-00UT]{
\title{Characterising global points of the interval}
\taxon{Corollary}
\author{samueltoth}
\contributor{fredrikbakke}

\p{As a special case of \ref{stt-00V7}, we note the following.
If types equipped with an [initial object](stt-00FO) [separate](stt-00J7)
and crisp elements of #{\Delta^1} are covered by the booleans,
then a crisp transformation between covariant crisp type families #{F, G} over
#{B \times \Delta^1} is a fibrewise equivalence iff it is a flat equivalence at
#{(b , 0)} and #{(b, 1)} for crisp elements #{b : B}.}

\agda{
module _
  (@♭ types-with-initial-object-separate'
    : large-family-separates (λ 𝓤 → Type-With-Initial-Obj' 𝓤) fst)
  (@♭ ∂Δ¹-♭-connected : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl)
  (open ♭Δ-Induction ∂Δ¹-♭-connected)
  where

  ∂Δ¹-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ¹ → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : ∂Δ¹) → is-♭-equiv (α (b , ∂Δ¹-incl x)))
      → is-fibrewise-equiv α
  ∂Δ¹-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-large-family-separates
        (point i0)
        types-with-initial-object-separate'
        (λ A → A .snd .fst)
        (λ A → point-init-is-left-anodyne' (A .snd .snd .fst) (A .snd .snd .snd))
        (F .fst , is-left-family←is-covariant (F .fst) (F .snd))
        (G .fst , is-left-family←is-covariant (G .fst) (G .snd))
        α
        (λ {(b , i)
         → ♭Δ¹-ind
             (λ x → is-♭-equiv (α (b , x)) , is-equiv-is-prop)
             (αeq b ∂Δ¹-0)
             (αeq b ∂Δ¹-1)
             i})
}

\p{We may also consider the analogous result for the 2-simplex, using
\ref{stt-0105} to show that the 3 element type covers the crisp elements of #{Δ²}.}

\agda{
  points-Δ²-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ² → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : Fin 3) → is-♭-equiv (α (b , Δ²-point-incl x)))
      → is-fibrewise-equiv α
  points-Δ²-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-large-family-separates
        (point i0)
        types-with-initial-object-separate'
        (λ A → A .snd .fst)
        (λ A → point-init-is-left-anodyne' (A .snd .snd .fst) (A .snd .snd .snd))
        (F .fst , is-left-family←is-covariant (F .fst) (F .snd))
        (G .fst , is-left-family←is-covariant (G .fst) (G .snd))
        α
        (λ {(b , i)
         → ♭Δ²-ind (λ x → is-♭-equiv (α (b , x)) , is-equiv-is-prop) (αeq b) i})
}
}
