\date{2026-09-17}
\title{Functoriality of relative suspensions}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Core.RelativeSuspensionsFunctoriality where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.CanonicalPushouts
open import Core.FunctorialityPushouts
open import Core.SpanMaps
open import Core.ArrowEquiv
open import Core.Orthogonal
open import Core.RelativeSuspensions
}
