\date{2025-02-26}
\taxon{Module}
\author{samueltoth}
\title{Types equivalent to (sub)singleton types are (sub)singleton}

\import{stt-macros}


\agda{
module Foundations.EquivSingleton where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Functions
open import Foundations.Sigma
open import Foundations.Unit
open import Foundations.FunctionInverses
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
open import Foundations.Singletons
}
}

\proof{
\p{Suppose we have an equivalence #{f : A \toeq B}, and #{A} is a
singleton, then we need to show for any two terms #{x,y : B}, we need
an identification #{x = y}. But because #{f} is an equivalence, it
suffices to consider two terms #{a,b : A}, and find an identification
#{f(a) = f(b)}.}

\agda{
is-single←retraction
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  → retraction f → is-singleton B → is-singleton A
is-single←retraction f (r , ret) sb .centre
  = r (sb .centre)
is-single←retraction f (r , ret) sb .central a
  = ap r (sb .central (f a)) ∙ ret a

is-single←equiv-to-single
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A ≃ B) → is-singleton A → is-singleton B
is-single←equiv-to-single (mk≃ f e)
  = is-single←retraction (is-equiv.bwd e) (f , is-equiv.ε e)

is-single←equiv⁻¹
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A ≃ B) → is-singleton B → is-singleton A
is-single←equiv⁻¹ (mk≃ f e)
  = is-single←retraction f (is-equiv.bwd e , is-equiv.η e)

is-prop←retraction
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  → retraction f → is-prop B → is-prop A
is-prop←retraction f (r , ret) Bpr x y
  = sym (ret x) ∙ ap r (Bpr (f x) (f y)) ∙ ret y

is-prop←equiv-to-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A ≃ B) → is-prop A → is-prop B
is-prop←equiv-to-prop (mk≃ f e)
  = is-prop←retraction (is-equiv.bwd e) (f , is-equiv.ε e)

singleton≃𝟙 : ∀ {𝓤} {A : Type 𝓤} → is-singleton A → A ≃ 𝟙
singleton≃𝟙 {A = A} sa = mk≃ (λ _ → tt) (mk-eqv qinv coh) where
  qinv : quasi-inv (λ (_ : A) → tt)
  qinv .fst _ = sa .centre
  qinv .snd .fst a = sa .central a
  qinv .snd .snd _ = refl

  coh : qinv-coh qinv
  coh a = ap-const (sa .central a)
}
}
