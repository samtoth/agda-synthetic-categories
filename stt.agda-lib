name: stt
include: src/
flags:
  --without-K
  --guardedness
  --exact-split
  --flat-split
  --rewriting
  --local-confluence-check
  --auto-inline
  --level-universe
  --no-import-sorts
  --postfix-projections
  --no-qualified-instances
  --no-require-unique-meta-solutions
  --no-infer-absurd-clauses
  -WnoWithoutKFlagPrimEraseEquality
