\date{2025-04-17}
\taxon{Module}
\title{Universal property of the [unit type](Foundations.Unit)}
\import{stt-macros}

\agda{
module Foundations.UnitUP where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Unit
open import Foundations.UniverseLifts
open import Foundations.Identity
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
open import Foundations.Sigma
open import Foundations.SigmaProperties
open import Foundations.Functions
open import Foundations.FunctionInverses
open import Foundations.Homotopy
open import Foundations.Singletons
open import Foundations.DependentIdentity
open import Foundations.FunExt
}
}

\subtree[stt-002Q]{
\taxon{Theorem}

\agda{
unit-ev-is-equiv : ∀ {𝓤} {A : 𝟙 → Type 𝓤} → is-equiv (evᵈ: A tt)
unit-ev-is-equiv = mk-eqv qinv coh where
  qinv : quasi-inv (ev tt)
  qinv .fst a _ = a
  qinv .snd .fst _ = refl
  qinv .snd .snd _ = refl

  coh : qinv-coh qinv
  coh _ = refl

unit-UP≃ : ∀ {𝓤} {A : 𝟙 → Type 𝓤} → ((a : 𝟙) → A a) ≃ A tt
unit-UP≃ = mk≃ (ev tt) unit-ev-is-equiv

point-is-equiv : ∀ {𝓤} {A : Type 𝓤} → is-equiv (point: A)
point-is-equiv = is-equiv⁻¹ unit-ev-is-equiv

point≃ : ∀ {𝓤} {A : Type 𝓤} → A ≃ (𝟙 → A)
point≃ = mk≃ point point-is-equiv

fibre-point≃
  : ∀ {𝓤} {A : Type 𝓤}
  → (a b : A)
  → fibre (point a) b ≃ (a ＝ b)
fibre-point≃ a b = Σ-singl 𝟙-is-singleton tt
}
}

\subtree[stt-00D8]{
\taxon{Remark}

\p{The fact that unit has definitional eta allows us to do without
  funext in the above theorem. When generalising to arbitrary singletons
  (or if we were to disable unit-eta) we require funext.
}
}

\subtree[bak-HSMB]{
\title{Singleton types and the unit type}
\taxon{Lemma}
\author{samueltoth}
\author{fredrikbakke}

\agda{
const-𝟙ᴸ-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} → is-equiv (const: A (𝟙ᴸ: 𝓥))
const-𝟙ᴸ-is-equiv
  = mk-eqv (ev ttᴸ , (λ _ → refl) , (λ _ → refl)) (λ _ → refl)

sing-!-is-equiv : ∀ {𝓤} {A : Type 𝓤} → is-singleton A → is-equiv (!: A)
sing-!-is-equiv as .is-equiv.qinv .fst = const (as .centre)
sing-!-is-equiv as .is-equiv.qinv .snd .fst = as .central
sing-!-is-equiv as .is-equiv.qinv .snd .snd _ = refl
sing-!-is-equiv as .is-equiv.coherent x
  = is-prop←is-single (＝-singleton←is-single (𝟙-is-singleton) _ _) _  _

sing≃𝟙 : ∀ {𝓤} {A : Type 𝓤} → is-singleton A → A ≃ 𝟙
sing≃𝟙 as ._≃_.fwd = !
sing≃𝟙 as ._≃_.fwd-is-equiv = sing-!-is-equiv as
}
}

\subtree[bak-GP33]{
\title{Induction over a singleton}
\taxon{Construction}
\author{fredrikbakke}

\agda{
module _
  {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} (s : is-singleton A)
  where

  sing-ind : B (centre s) → Π A B
  sing-ind b a = tr B (central s a) b

  sing-ind-β : ev (centre s) ∘ sing-ind ~ id
  sing-ind-β b
    = ap (λ q → tr B q b)
        (is-set←is-single s (centre s) (centre s) (central s (centre s)) refl)

  sing-ind-η : (f : Π A B) → sing-ind (f (centre s)) ~ f
  sing-ind-η f = apᶠ f ∘ central s
}
}

\subtree[bak-TU8K]{
\title{Dependent evaluation over a singleton has a section}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-17}

\p{
[Singleton induction](bak-GP33) gives a [section](stt-000H) of dependent evaluation
and hence a [retraction](stt-000I) of the induction map.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} (s : is-singleton A) where

  sing-evᵈ-section : section (evᵈ: B (centre s))
  sing-evᵈ-section = (sing-ind s , sing-ind-β s)

  sing-ind-retraction : retraction (sing-ind s)
  sing-ind-retraction = (ev (centre s) , sing-evᵈ-section .snd)
}
}

\agda{
module UnitUPWithFunExt (FE : FunExt-global) (open WithFunExt-global FE) where
}

\subtree[stt-006S]{
\date{2025-06-27}
\author{samueltoth}
\date{2025-03-09}
\author{fredrikbakke}
\title{Universal property for singleton types}
\taxon{Theorem}

\agda{
  sing-evᵈ-is-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      → (s : is-singleton A)
      → is-equiv (evᵈ: B (centre s))
  sing-evᵈ-is-equiv {B = B} s = is-equiv←qinv qinv where
    qinv : quasi-inv (evᵈ: B (centre s))
    qinv .fst = sing-ind s
    qinv .snd .fst f = funext→ (sing-ind-η s f)
    qinv .snd .snd = sing-evᵈ-section s .snd

  sing-ev-is-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → (s : is-singleton A)
      → is-equiv (ev: B (centre s))
  sing-ev-is-equiv s = is-equiv←qinv qinv where
    qinv : quasi-inv (ev (centre s))
    qinv .fst = ev-section (centre s) .fst
    qinv .snd .fst f = funext→ (ap f ∘ central s)
    qinv .snd .snd = ev-section (centre s) .snd

  sing-UP≃
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → (s : is-singleton A)
      → (A → B) ≃ B
  sing-UP≃ sing = mk≃ (ev (sing .centre)) (sing-ev-is-equiv sing)

  sing-const-is-equiv
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → (s : is-singleton A)
      → is-equiv (const: B A)
  sing-const-is-equiv s = is-equiv⁻¹ (sing-ev-is-equiv s)

  sing-const≃
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → is-singleton A → B ≃ (A → B)
  sing-const≃ c = mk≃ const (sing-const-is-equiv c)
}
}
