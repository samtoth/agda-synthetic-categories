\subtree[stt-004X]{
\title{Factorisations}
\taxon{Definition}
\contributor{fredikbakke}

\p{
A \em{factorisation} of a map #{f \colon A \to B} into two function classes
#{\mathcal{L}} and  #{\mathcal{R}} is an \em{image} type #{X} together with a
function #{l \colon A \to X} in #{\mathcal{L}}  and a function #{r \colon X \to B} in
#{\mathcal{R}} such that the following triangle commutes

\quiver{
\begin{tikzcd}[column sep=small]
& X \\
A && B \nsp{.}
\arrow["f", from=2-1, to=2-3]
\arrow["l", from=2-1, to=1-2]
\arrow["r", from=1-2, to=2-3]
\end{tikzcd}
}
}

\agda{
record Factorisation
    {𝓤 𝓥 𝓛 𝓡} 𝓘 {A : Type 𝓤} {B : Type 𝓥}
    (LL : {I : Type 𝓘} → Subtype (A → I) 𝓛)
    (RR : {I : Type 𝓘} → Subtype (I → B) 𝓡)
    (f : A → B) : Type (𝓤 ⊔ 𝓥 ⊔ lsuc 𝓘 ⊔ 𝓛 ⊔ 𝓡)
  where
  constructor mk-factorisation
  field
    Im : Type 𝓘
    l : A → Im
    l∈L : l ∈ LL
    r : Im → B
    r∈R : r ∈ RR
    comm : r ∘ l ~ f

unquoteDecl Factorisation-repr≊ Factorisation-repr≃
  = make-record-repr Factorisation-repr≊ Factorisation-repr≃ (quote Factorisation)
}
}

\subtree[stt-00YU]{
\title{Factorisations into global wide subcategories of types}
\taxon{Definition}
\author{fredrikbakke}

\agda{
gFactorisation
  : {α β : Level → Level → Level} (γ : Level → Level → Level)
  → (LL : gWideSubcatType α) (RR : gWideSubcatType β)
  → ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  → Type (𝓤 ⊔ 𝓥 ⊔ lsuc (γ 𝓤 𝓥) ⊔ α 𝓤 (γ 𝓤 𝓥) ⊔ β (γ 𝓤 𝓥) 𝓥)
gFactorisation γ LL RR {𝓤} {𝓥}
  = Factorisation (γ 𝓤 𝓥) (gWideSubcatType.K LL) (gWideSubcatType.K RR)
}
}

\subtree[bak-6399]{
\title{Morphisms of factorisations}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\p{
Given two factorisations of a map #{f \colon A \to B}
\quiver{
\begin{tikzcd}[column sep=small]
& X &&&& Y \\
A && B && A && B\nsp{,}
\arrow["f", from=2-1, to=2-3]
\arrow["f", from=2-5, to=2-7]
\arrow[from=2-1, to=1-2]
\arrow[from=1-2, to=2-3]
\arrow[from=2-5, to=1-6]
\arrow[from=1-6, to=2-7]
\end{tikzcd}
}
then a \em{morphism} between them is a function between their images
#{e \colon X \to Y} such that the obvious simplex is coherent:

\quiver{
\begin{tikzcd}[column sep=small]
& X &&& Y \\
A &&&&& B\nsp{.}
\arrow["e", from=1-2, to=1-5]
\arrow["f", from=2-1, to=2-6]
\arrow[from=2-1, to=1-5]
\arrow[from=1-5, to=2-6]
\arrow[from=2-1, to=1-2, crossing over]
\arrow[from=1-2, to=2-6, crossing over]
\end{tikzcd}
}
}

\agda{
module _
  {𝓤 𝓥 𝓘 𝓛 𝓡} {A : Type 𝓤} {B : Type 𝓥}
  {LL : {I : Type 𝓘} → Subtype (A → I) 𝓛}
  {RR : {I : Type 𝓘} → Subtype (I → B) 𝓡}
  {f : A → B}
  where

  coherence-Factorisation-map
    : (F G : Factorisation 𝓘 LL RR f)
    → (h : Factorisation.Im F → Factorisation.Im G)
    → h ∘ Factorisation.l F ~ Factorisation.l G
    → Factorisation.r F ~ Factorisation.r G ∘ h
    → Type (𝓤 ⊔ 𝓥)
  coherence-Factorisation-map F G h L R
    = R ▹h Factorisation.l F
    ∙h Factorisation.r G ◃h L
    ∙h Factorisation.comm G
    ~ Factorisation.comm F

  Factorisation-map : (F G : Factorisation 𝓘 LL RR f) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓘)
  Factorisation-map F G
    = Σ[ h ∶ (Factorisation.Im F → Factorisation.Im G) ]
      Σ[ L ∶ h ∘ Factorisation.l F ~ Factorisation.l G ]
      Σ[ R ∶ Factorisation.r F ~ Factorisation.r G ∘ h ]
        coherence-Factorisation-map F G h L R

  Factorisation-id-map : {F : Factorisation 𝓘 LL RR f} → Factorisation-map F F
  Factorisation-id-map = (id , ~refl , ~refl , ~refl)
}
}

\subtree[stt-00YP]{
\title{Equivalences of factorisations}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\p{
An \em{equivalence} of factorisations is a [morphism](bak-6399) such that the
underlying map in images is an equivalence of types.
}

\agda{
module _
  {𝓤 𝓥 𝓘 𝓛 𝓡} {A : Type 𝓤} {B : Type 𝓥}
  {LL : {I : Type 𝓘} → Subtype (A → I) 𝓛}
  {RR : {I : Type 𝓘} → Subtype (I → B) 𝓡}
  {f : A → B}
  where

  Factorisation-equiv : (F G : Factorisation 𝓘 LL RR f) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓘)
  Factorisation-equiv F G
    = Σ[ e ∶ Factorisation.Im F ≃ Factorisation.Im G ]
      Σ[ L ∶ e ._≃_.fwd ∘ Factorisation.l F ~ Factorisation.l G ]
      Σ[ R ∶ Factorisation.r F ~ Factorisation.r G ∘ e ._≃_.fwd ]
        coherence-Factorisation-map F G (e ._≃_.fwd) L R

  Factorisation-id-equiv
    : {F : Factorisation 𝓘 LL RR f} → Factorisation-equiv F F
  Factorisation-id-equiv = (id≃ , ~refl , ~refl , ~refl)

  Factorisation-map←equiv
    : {F G : Factorisation 𝓘 LL RR f} → Factorisation-equiv F G → Factorisation-map F G
  Factorisation-map←equiv (e , L , R , C) = (e ._≃_.fwd , L , R , C)

  Factorisation-equiv←map
    : {F G : Factorisation 𝓘 LL RR f} (m : Factorisation-map F G)
    → is-equiv (m .fst) → Factorisation-equiv F G
  Factorisation-equiv←map (h , L , R , C) e = (mk≃ h e , L , R , C)
}
}

\subtree[stt-00YQ]{
\title{Characterising equality of factorisations}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-11}

\p{Equivalences of factorisations characterise equality.}

\agda{
  Factorisation-equiv←id
    : {F G : Factorisation 𝓘 LL RR f} → F ＝ G → Factorisation-equiv F G
  Factorisation-equiv←id {F} refl = Factorisation-id-equiv {F = F}

  opaque
    Factorisation-equiv-is-torsorial
      : (F : Factorisation 𝓘 LL RR f) → is-torsorial (Factorisation-equiv F)
    Factorisation-equiv-is-torsorial (mk-factorisation I l lL r rR H)
      = is-single←equiv-to-single
          (Σ-fst-≃ (Factorisation-repr≃ e⁻¹))
          (is-singleton-structure←parts
            (equiv-is-torsorial I) (I , id≃)
            (is-singleton-structure←parts
              (SingS-is-single l) (l , ~refl)
              (is-single←equiv⁻¹
                (Σ-fst-≃-bwd⁻¹ (Σ-singl (mk-singl lL (∈-is-prop LL _ _)) lL))
                (is-singleton-structure←parts
                  (SingS-is-single r) (r , ~refl)
                  (is-single←equiv⁻¹
                    (Σ-fst-≃-bwd⁻¹ (Σ-singl (mk-singl rR (∈-is-prop RR _ _)) rR))
                    (SingS-is-single' H))))))

    Factorisation-equiv←id-is-equiv
      : (F G : Factorisation 𝓘 LL RR f)
      → is-equiv (Factorisation-equiv←id {F} {G})
    Factorisation-equiv←id-is-equiv F G
      = fundamental-Id _
          (Factorisation-equiv-is-torsorial F)
          (λ _ → Factorisation-equiv←id) G

    Factorisation-equiv≃
      : (F G : Factorisation 𝓘 LL RR f) → (F ＝ G) ≃ Factorisation-equiv F G
    Factorisation-equiv≃ F G
      = mk≃ Factorisation-equiv←id (Factorisation-equiv←id-is-equiv F G)

    Factorisation-equiv→id
      : {F G : Factorisation 𝓘 LL RR f} → Factorisation-equiv F G → F ＝ G
    Factorisation-equiv→id = _≃_.bwd (Factorisation-equiv≃ _ _)
}
}


\subtree[bak-0598]{
\title{Comparing factorisations via lifting}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-11}

\p{
Given two factorisations of a map #{f \colon A \to B},

\quiver{
\begin{tikzcd}[column sep=small]
& X &&&& Y \\
A && B && A && B\nsp{,}
\arrow["f", from=2-1, to=2-3]
\arrow["f", from=2-5, to=2-7]
\arrow[from=2-1, to=1-2, "l"]
\arrow[from=1-2, to=2-3, "r"]
\arrow[from=2-5, to=1-6, "l'"]
\arrow[from=1-6, to=2-7, "r'"]
\end{tikzcd}
}

then we may form a morphism of arrows from #{l} to #{r'} via the following pasting

\quiver{
\begin{tikzcd}
A && Y \\
\\
X && B\nsp{.}
\arrow["l"', from=1-1, to=3-1]
\arrow["r'", from=1-3, to=3-3]
\arrow["l'", from=1-1, to=1-3]
\arrow["r"', from=3-1, to=3-3]
\arrow["f" description, from=1-1, to=3-3]
\end{tikzcd}
}
If this square has a lifting #{\ell \colon X \to Y}, then that is a morphism of
factorisations.
}

\agda{
  module _
    (F G : Factorisation 𝓘 LL RR f)
    (let module F = Factorisation F)
    (let module G = Factorisation G)
    where

    factorisation-comparison-square : Arrow-map F.l G.r
    factorisation-comparison-square = mk-amap G.l F.r (F.comm ∙h (G.comm h⁻¹))

    module _
      (t : Lift factorisation-comparison-square)
      (let module t = Lift t)
      where

      coherence-Factorisation-map←lift
        : coherence-Factorisation-map F G t.lift t.L (t.K h⁻¹)
      coherence-Factorisation-map←lift
        = (∙h-assoc (t.K h⁻¹ ▹h F.l) (G.r ◃h t.L) G.comm h⁻¹)
        ∙h right-transpose-∙h⁻¹ {R = G.comm}
          (left-transpose-∙h {P = t.K ▹h F.l} (t.pastes h⁻¹) h⁻¹)

      Factorisation-map←lift : Factorisation-map F G
      Factorisation-map←lift
        = (t.lift , t.L , t.K h⁻¹ , coherence-Factorisation-map←lift)
}
}

\subtree[bak-6374]{
\title{Factorisations are fibres of composition}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓘 𝓛 𝓡} {A : Type 𝓤} {B : Type 𝓥}
  {L : {I : Type 𝓘} → Subtype (A → I) 𝓛}
  {R : {I : Type 𝓘} → Subtype (I → B) 𝓡}
  where

  Factors' : Type (𝓤 ⊔ 𝓥 ⊔ lsuc 𝓘 ⊔ 𝓛 ⊔ 𝓡)
  Factors' =
   Σ[ I ∶ Type 𝓘 ] (Σ[ a ∶ (A → I) ] (a ∈ L) × Σ[ b ∶ (I → B) ] (b ∈ R))

  compose-Factors' : Factors' → (A → B)
  compose-Factors' (I , (a , aL) , b , bR) = (b ∘ a)

  htpy-fibre-compose-Factors'≃
    : (f : A → B)
    → (Σ[ F ∶ Factors' ] (compose-Factors' F ~ f)) ≃ Factorisation 𝓘 L R f
  htpy-fibre-compose-Factors'≃ f
    = Σ-assoc ∙e Σ-snd-≃ (λ _
    → Σ-assoc ∙e Σ-assoc ∙e Σ-snd-≃ (λ _ → Σ-snd-≃ (λ _ → Σ-assoc)))
    ∙e (Factorisation-repr≃ e⁻¹)

  fibre-compose-Factors'≃
    : (f : A → B)
    → fibre compose-Factors' f ≃ Factorisation 𝓘 L R f
  fibre-compose-Factors'≃ f
    = Σ-snd-≃ (λ _ → funext≃) ∙e htpy-fibre-compose-Factors'≃ f

  compose-Factors'-is-equiv←unique-factorisations
    : ((f : A → B) → is-singleton (Factorisation 𝓘 L R f))
    → is-equiv compose-Factors'
  compose-Factors'-is-equiv←unique-factorisations H
    = is-equiv←has-singleton-fibres λ f
    → is-single←equiv⁻¹ (fibre-compose-Factors'≃ f) (H f)

  compose-Factors'≃←unique-factorisations
    : ((f : A → B) → is-singleton (Factorisation 𝓘 L R f))
    → Factors' ≃ (A → B)
  compose-Factors'≃←unique-factorisations H
    = mk≃ compose-Factors' (compose-Factors'-is-equiv←unique-factorisations H)
}
}
