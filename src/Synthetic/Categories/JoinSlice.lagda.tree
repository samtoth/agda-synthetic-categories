\subtree[stt-00D5]{
\title{The join slice adjunction}
\taxon{Theorem}

\p{We can view the partially applied [directed join](stt-00CW) as a functor
#{({-}) \bjoin B : \Type \to \Type_{B/}} into the [coslice category of
types](Core.Coslices). It turns out this functor has a right adjoint given by the
[slice construction](stt-00C4), where we define a functor #{\Type_{B/} \to
\Type} which takes a map #{p : B \to C} to the type #{C_{/p}}.}

\proof{
\p{By a short calculation:}

##{
\begin{align*}

A \to C_{/p} &\simeq \Sigma_{f : C^A} \Pi_{a,b} \Hom(f(a), p(b)) \\
             &\simeq \Sigma_{f : C^A} \Sigma_{g : C^B}
                       (\Pi_{a,b}\Hom(f(a),g(b))) \times g \sim p \\
             &\simeq \Sigma_{f : C^{A \bjoin B}} f \iota_2 \sim p \\
             &\simeq A \bjoin B \to_{/B} p
\end{align*}
}
}

\agda{
join←slice-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → (A → Slice C p) → Coslice-map {X = A ◇ B} ↑-ι₂ p
join←slice-map p f = ( ↑-rec (mk-directed-cocone (fst ∘ f) p (uncurry (snd ∘ f)))
           , ~refl)

slice←join-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → Coslice-map {X = A ◇ B} ↑-ι₂ p → (A → Slice C p)
slice←join-map p F a
  = ( F .fst (↑-ι₁ a)
    , λ b → adjust-hom refl (F .snd b) (ap-hom (F .fst) (↑-hom (a , b))))

slice-join-η
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → slice←join-map {A = A} p ∘ join←slice-map p ~ id
slice-join-η p f = funext→ (λ
  a → Σ-path→ (refl , funext→ (λ
   b → Hom-ext→
         ( ~refl
         , (sym (∙-reflr _ ∙ pushout-rec-apβ _))
         , sym (∙-reflr _ ∙ pushout-rec-apβ _)))))


opaque
  join⊣slice
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → (A → Slice C p) ≃ Coslice-map {X = A ◇ B} ↑-ι₂ p
  join⊣slice {A = A} {B} {C} p
    = (A → Slice C p) ≃⟨ Σ-Π-swap≃ _ _ ⟩
      Σ[ f ∶ (A → C)] (∀ (a : A) (b : B) → Hom C (f a) (p b))
         ≃⟨ Σ-snd-≃ (λ f → uncurry≃) ⟩
      Σ[ f ∶ (A → C)] (∀ ((a , b) : A × B) → Hom C (f a) (p b))
         ≃⟨ Σ-fst-≃ {B = λ x → ∀ ab → Hom C (x .fst .fst (ab .fst)) (x .fst .snd (ab .snd))}
             (Σ-singleton (λ f → SingS-is-single' p) e⁻¹ ∙e Σ-assoc e⁻¹)
            ∙e (Σ-assoc ∙e (Σ-snd-≃ (λ _ → ×-swap) ∙e Σ-assoc e⁻¹
            ∙e (Σ-fst-≃ Σ-assoc))) ⟩
      Σ[ f ∶ (Σ[ f ∶ (A → C)] Σ[ g ∶ (B → C)] (∀ x → Hom C (f (fst x)) (g (snd x)))) ]
        (f .snd .fst ~ p) ≃⟨ Σ-fst-≃ (directed-cocone-repr≃ e⁻¹) ⟩
      Σ[ f ∶ directed-cocone (mk-span (A × B) fst snd) C ] (f .directed-cocone.j ~ p)
         ≃⟨ Σ-fst-≃ (↑-UP≃ e⁻¹) ⟩
      Σ[ f ∶ (A ◇ B → C)] (f ∘ ↑-ι₂ ~ p) ≃⟨⟩
      Coslice-map ↑-ι₂ p   ≃∎

  join←slice-map-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → is-equiv (join←slice-map {A = A} p)
  join←slice-map-is-equiv p = join⊣slice p ._≃_.fwd-is-equiv

  -- The inverse of adj≃ is not this map, but we can use 3-for-2
  slice←join-map-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
      → is-equiv (slice←join-map {A = A} p)
  slice←join-map-is-equiv p
    = 3-for-2~' {f = slice←join-map p}
       (slice-join-η p h⁻¹)
       (join←slice-map-is-equiv p)
       id-is-equiv

join≃slice-map
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C)
    → (A → Slice C p) ≃ Coslice-map {X = A ◇ B} ↑-ι₂ p
join≃slice-map p = mk≃ (join←slice-map p) (join←slice-map-is-equiv p)
}

\p{Dually, we have a join-coslice adjunction.}

\agda{
module _ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} (p : B → C) where

  join←coslice-map
    : (A → Coslice C p) → Coslice-map {X = B ◇ A} ↑-ι₁ p
  join←coslice-map f
    = (↑-rec (mk-directed-cocone p (fst ∘ f) (uncurry (snd ∘ f) ∘ ×-swap→)) , ~refl)

  coslice←join-map
    : Coslice-map {X = B ◇ A} ↑-ι₁ p → (A → Coslice C p)
  coslice←join-map f a
    = ( f .fst (↑-ι₂ a)
      , λ b → adjust-hom (f .snd b) refl (ap-hom (f .fst) (↑-hom (b , a))))

  join⊣coslice-η
    : coslice←join-map ∘ join←coslice-map ~ id
  join⊣coslice-η f
    = funext→ λ a → Σ-path→ (refl , (funext→ (λ
        b → Hom-ext→
              (~refl
              , sym (∙-reflr _ ∙ pushout-rec-apβ _)
              , sym (∙-reflr _ ∙ pushout-rec-apβ _)))))

  join⊣coslice-ε
    : join←coslice-map ∘ coslice←join-map ~ id
  join⊣coslice-ε f = ext!
    (sym ∘ ↑-rec-unique ( f .snd , ~refl , λ a → ~refl
                        , coe (Square-squeeze-topr (ap (f .fst) (glue (_ , a))))
                            (mk-square refl)
                        , Square-degen-vert _ _ (sym (∙-reflr _)))
    , ∙-sym' ∘ f .snd)

  join⊣coslice
    : Coslice-map {X = B ◇ A} ↑-ι₁ p ≃ (A → Coslice C p)
  join⊣coslice = equiv←qequiv
    (mk≊ coslice←join-map (join←coslice-map , join⊣coslice-ε , join⊣coslice-η))

  coslice←join-map-is-equiv
    : is-equiv coslice←join-map
  coslice←join-map-is-equiv = _≃_.fwd-is-equiv join⊣coslice

  join←coslice-map-is-equiv
    : is-equiv join←coslice-map
  join←coslice-map-is-equiv = bwd-is-equiv join⊣coslice

  join≃coslice-map
    : (A → Coslice C p) ≃ Coslice-map {X = B ◇ A} ↑-ι₁ p
  join≃coslice-map = mk≃ join←coslice-map join←coslice-map-is-equiv
}
}

\subtree[tot-7492]{
\title{Coslices preserve limits}
\taxon{Corollary}

\p{As right adjoints, bot the slice and coslice constructions preserve limits.}

