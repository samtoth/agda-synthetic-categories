\subtree[bak-A393]{
\title{The walking left homotopy projection is inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-22}

\p{
The projection of the walking left homotopy #{\Delta_{\sim} \to \Delta^1} is inner
anodyne.
}

\proof{
\p{The pushout square

\quiver{
\begin{tikzcd}
{\Delta^1} && {\Lambda^2_1} \\
\\
{\b1} && {\Delta^1}\nsp{.}
\arrow["{\iota_1}", from=1-1, to=1-3]
\arrow["!"', from=1-1, to=3-1]
\arrow["{\mathrm{projection}}", from=1-3, to=3-3]
\arrow["\point 0"', from=3-1, to=3-3]
\arrow["\ulcorner" very near end, phantom, from=1-1, to=3-3]
\end{tikzcd}
}

exhibits #{\Delta^1} as the cofibre of #{\iota_1 \colon \Delta^1 \to \Lambda^2_1}.
By functoriality of cofibres, the inner horn inclusion induces a map from this
cofibre to #{\Delta_{\sim}}, so by cobase change stability the inclusion
#{\Delta^1 \hookrightarrow \Delta_{\sim}} is inner anodyne. Finally, by the right
cancellation property the projection #{\Delta_{\sim} \to \Delta^1} is inner anodyne
as well.
}
}

\agda{
tgt-Δ~-is-inner-anodyne : is-inner-anodyne tgt-Δ~
tgt-Δ~-is-inner-anodyne h orth
  = left-orthogonal-∘ _ (ι₁ ∘ Λ[2,1]-right-leg-incl) h
      (left-orthogonal-pushout₁-left (Λ[2,1]-incl , ~refl) ! h orth)
      (equiv⊥ (3-for-2
        (is-pushout←up-cocartesian _ left-unit-horn-is-pushout) id-is-equiv) h)

proj-Δ~-is-inner-anodyne : is-inner-anodyne proj-Δ~
proj-Δ~-is-inner-anodyne h orth
  = left-orthogonal-right-cancel (tgt-Δ~-is-inner-anodyne h orth) (id⊥ h)

proj-Δ~-is-segal-equiv : is-segal-equiv proj-Δ~
proj-Δ~-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne proj-Δ~-is-inner-anodyne

tgt-Δ~-is-segal-equiv : is-segal-equiv tgt-Δ~
tgt-Δ~-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne tgt-Δ~-is-inner-anodyne

src-Δ~-is-segal-equiv : is-segal-equiv src-Δ~
src-Δ~-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-Δ~-is-segal-equiv Q-is-segal) id-is-equiv
}
}

\subtree[bak-63FB]{
\title{The walking right homotopy projection is inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-23}

\p{
The projection of the walking right homotopy #{{}_{\sim}\Delta \to \Delta^1} is inner
anodyne.
}

\proof{
\p{Dual to \ref{bak-A393}.}
}

\agda{
tgt-~Δ-is-inner-anodyne : is-inner-anodyne tgt-~Δ
tgt-~Δ-is-inner-anodyne h orth
  = left-orthogonal-∘ _ (ι₁ ∘ Λ[2,1]-left-leg-incl) h
      (left-orthogonal-pushout₁-left (Λ[2,1]-incl , ~refl) ! h orth)
      (equiv⊥ (3-for-2
        (is-pushout←up-cocartesian _ right-unit-horn-is-pushout) id-is-equiv) h)

proj-~Δ-is-inner-anodyne : is-inner-anodyne proj-~Δ
proj-~Δ-is-inner-anodyne h orth
  = left-orthogonal-right-cancel (tgt-~Δ-is-inner-anodyne h orth) (id⊥ h)

proj-~Δ-is-segal-equiv : is-segal-equiv proj-~Δ
proj-~Δ-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne proj-~Δ-is-inner-anodyne

tgt-~Δ-is-segal-equiv : is-segal-equiv tgt-~Δ
tgt-~Δ-is-segal-equiv
  = is-segal-equiv←is-inner-anodyne tgt-~Δ-is-inner-anodyne

src-~Δ-is-segal-equiv : is-segal-equiv src-~Δ
src-~Δ-is-segal-equiv Q-is-segal
  = 3-for-2' (proj-~Δ-is-segal-equiv Q-is-segal) id-is-equiv
}
}

\subtree[stt-00CI]{
\title{Homotopies are an identity system for morphisms}
\taxon{Theorem}

\p{
When #{A} is Segal, both left and right homotopies are torsorial and thus form
identity systems for morphisms in #{A}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} {a b : A} (𝐴 : is-segal A) where

  opaque
    ~▵-is-torsorial : (f : Hom A a b) → is-torsorial (f ~▵_)
    ~▵-is-torsorial f = Hom2-is-torsorial←is-segal 𝐴 f (idH _)

    ▵~-is-torsorial : (f : Hom A a b) → is-torsorial (f ▵~_)
    ▵~-is-torsorial f = Hom2-is-torsorial←is-segal 𝐴 (idH _) f

  Hom-~▵-IdS : Identity-system (Hom A a b) (𝓤 ⊔ 𝓘)
  Hom-~▵-IdS .Identity-system.IdS = _~▵_
  Hom-~▵-IdS .Identity-system.IdS←Id = ~▵←＝
  Hom-~▵-IdS .Identity-system.IdS←Id-is-equiv f
    = fundamental-Id _ (~▵-is-torsorial f) _

  Hom-▵~-IdS : Identity-system (Hom A a b) (𝓤 ⊔ 𝓘)
  Hom-▵~-IdS .Identity-system.IdS = _▵~_
  Hom-▵~-IdS .Identity-system.IdS←Id = ▵~←＝
  Hom-▵~-IdS .Identity-system.IdS←Id-is-equiv f
    = fundamental-Id _ (▵~-is-torsorial f) _

  _ : is-equiv (λ (f : Hom A a b) → (f , f , refl~▵ f))
  _ = is-equiv⁻¹ (singleton-fst-is-equiv (SingS-is-single ⦃ Hom-~▵-IdS ⦄))

  _ : is-equiv (λ (f : Hom A a b) → (f , f , refl▵~ f))
  _ = is-equiv⁻¹ (singleton-fst-is-equiv (SingS-is-single ⦃ Hom-▵~-IdS ⦄))

  ~▵≃▵~ : {f g : Hom A a b} → (f ~▵ g) ≃ (f ▵~ g)
  ~▵≃▵~ {f} {g}
    = mk≃
        (Identity-system.IdS←Id Hom-▵~-IdS
        ∘ Identity-system.Id←IdS Hom-~▵-IdS)
        (is-equiv-∘
          (Identity-system.IdS←Id-is-equiv Hom-▵~-IdS f g)
          (is-equiv⁻¹ (Identity-system.IdS←Id-is-equiv Hom-~▵-IdS f g)))

  ▵~≃~▵ : {f g : Hom A a b} → (f ▵~ g) ≃ (f ~▵ g)
  ▵~≃~▵ = ~▵≃▵~ e⁻¹
}
}
