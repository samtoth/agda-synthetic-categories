\subtree[stt-0048]{
\title{Orthogonal maps}
\taxon{Definition}

\p{Given maps #{f : A \to B} and #{g : C \to D}, we say #{f} is \em{left
orthogonal} to #{g} when the [pullback power](stt-004D) #{\pullpow{f}{g}} is an
equivalence.}

\agda{
module _ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤}
       {B : Type 𝓥} {C : Type 𝓦}
       {D : Type 𝓛} where
  are-orthogonal : ∀ (f : A → B) (g : C → D) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓛)
  are-orthogonal f g = is-equiv (pullback-power f g)
}
}

\subtree[stt-00NZ]{
\title{Orthogonal maps admit unique lifting solutions}
\taxon{Lemma}

\p{#{f} and #{g} are orthogonal iff any [square](stt-003U) from #{f} to #{g}
has a unique [lift](stt-0044).}

\proof{
\p{The fibre of the pullback power at a square is equivalent to the data of a lifting of that square.}
}

\agda{
module _ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤}
       {B : Type 𝓥} {C : Type 𝓦}
       {D : Type 𝓛} where
  admit-unique-lifts : ∀ (f : A → B) (g : C → D) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓛)
  admit-unique-lifts f g = ∀ (F : Arrow-map f g) → unique-lifts F

  are-orthogonal←unique-lifts
     : ∀ {f : A → B} {g : C → D}
       → admit-unique-lifts f g
       → are-orthogonal f g
  are-orthogonal←unique-lifts {f} {g} lifts
    = is-equiv←has-singleton-fibres λ where
      G@(mk-amap t b H) → is-single←equiv-to-single
                            (pb-power-fibre≃lifts f g G e⁻¹)
                            (lifts G)

  unique-lifts←are-orthogonal
    : ∀ {f : A → B} {g : C → D}
      → are-orthogonal f g
      → admit-unique-lifts f g
  unique-lifts←are-orthogonal {f} {g} orth problem
    = is-single←equiv-to-single
        (pb-power-fibre≃lifts f g problem)
        (has-singleton-fibres←is-equiv orth problem)

  unique-lifts↔are-orthogonal
    : ∀ {f : A → B} {g : C → D}
      → admit-unique-lifts f g
      ↔ are-orthogonal f g
  unique-lifts↔are-orthogonal
    = (are-orthogonal←unique-lifts , unique-lifts←are-orthogonal)
}
}

\subtree[stt-00NX]{
\title{Orthogonality of a map with a family}
\taxon{Definition}

\p{Given a map #{f : X \to Y}, and a family #{P : A \to \Type}, we say that
#{f} is orthogonal to #{P} when for each #{g : Y \to A}, the map
#{f^* : \mathsf{\Pi} Pg \to \mathsf{\Pi} Pgf} is an equivalence.}

\agda{
are-orthogonal-fam
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} (f : A → B)
      (P : C → Type 𝓜)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
are-orthogonal-fam f P = is-fibrewise-equiv λ g → precomp-Π (P ∘ g) f

are-orthogonal-fam←equiv
  : ∀ {𝓤 𝓥 𝓦 𝓜 𝓝} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {f : A → B}
      {P : C → Type 𝓜} {P' : C → Type 𝓝}
      (e : ∀ c → P c ≃ P' c)
    → are-orthogonal-fam f P → are-orthogonal-fam f P'
are-orthogonal-fam←equiv {f = f} {P} {P'} e o h
  = tgt-is-equiv←Arrow-equiv
      ( amap
      , postcomp-Π-equiv (e.fwd-is-equiv _)
      , postcomp-Π-equiv (e.fwd-is-equiv _))
      (o h) where
  module e c = _≃_ (e c)
  amap : Arrow-map (precomp-Π (P ∘ h) f) (precomp-Π (P' ∘ h) f)
  amap .Arrow-Π.top = postcomp-Π (e.fwd ∘ h)
  amap .Arrow-Π.bot = postcomp-Π (e.fwd ∘ h ∘ f)
  amap .Arrow-Π.comm = ~refl
}
}

\subtree[stt-00NY]{
\title{Unique extensions from orthogonality}
\taxon{Lemma}

\p{Given a map #{f : A \to B} and a family #{P : C \to \Type},
together with a [morhpism](stt-00OB) from #{f} to #{P}, consisting of
#{g : B \to C} and #{h : \mathsf{\Pi} Pgf}, we define the type of
lifting solutions to be [extensions](stt-00CL) of #{h} along
#{f}. #{f} and #{P} are orthogonal iff such extensions are unique.}

\proof{
\p{
The fibres of the dependent precomposition map at a lifting problem are exactly
the desired extensions.
}
}

\agda{
has-unique-extensions
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} (f : A → B)
      (P : C → Type 𝓜)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
has-unique-extensions f P
  = ∀ (F : ArrFam-map f P)
    → is-singleton (Extᵈ f (P ∘ F .ArrFam-map.bot) (F .ArrFam-map.top))

Extᵈ-Subtype-is-prop
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} (f : A → B)
      (P : Subtype C 𝓜)
      (F : ArrFam-map f (P .Subtype.family))
    → is-prop (Extᵈ f (P .Subtype.family ∘ F .ArrFam-map.bot) (F .ArrFam-map.top))
Extᵈ-Subtype-is-prop f P F
  = Σ-is-prop
      (Π-is-prop (P .Subtype.family-is-subtype ∘ F .ArrFam-map.bot))
      (λ a → Π-is-prop
        (λ a' → ＝-is-prop
                  (((P .Subtype.family-is-subtype ∘ F .ArrFam-map.bot) ∘ f) a') _ _))


module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
  {C : Type 𝓦} {f : A → B}
  {P : C → Type 𝓜}
  where

  unique-extensions←are-orthogonal-fam
    : are-orthogonal-fam f P
    → has-unique-extensions f P
  unique-extensions←are-orthogonal-fam orth F
    = is-single←equiv-to-single
        (fibre-precomp-Π≃Ext (P ∘ F .ArrFam-map.bot) f (F .ArrFam-map.top))
        (has-singleton-fibres←is-equiv
          (orth (F .ArrFam-map.bot))
          (F .ArrFam-map.top))

  are-orthogonal-fam←unique-extensions
    : has-unique-extensions f P
    → are-orthogonal-fam f P
  are-orthogonal-fam←unique-extensions ext g
    = is-equiv←has-singleton-fibres
        λ h → is-single←equiv-to-single
                (fibre-precomp-Π≃Ext _ f _ e⁻¹)
                (ext (mk-afmap g h))

  are-orthogonal-fam↔has-unique-extensions
    : are-orthogonal-fam f P ↔ has-unique-extensions f P
  are-orthogonal-fam↔has-unique-extensions
    = ( unique-extensions←are-orthogonal-fam
      , are-orthogonal-fam←unique-extensions)
}
}

\subtree[stt-00O2]{
\title{(Un)straightening orthogonality at type families}
\taxon{Lemma}

\p{For a maps #{f} and #{g}, we have #{f \perp g} iff #{f \perp \fibre-fam{g}}.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
  {C : Type 𝓦} {D : Type 𝓛}
  {f : A → B} {g : C → D}
  where

  power-hom-arr-fibre
    : ∀ h
      → Arrow-map
          (arrow-fibre (power-hom f g) h)
          (precomp-Π (fibre g ∘ h) f)
  power-hom-arr-fibre h .Arrow-map.top = _≃_.fwd (fibre-postcomp≃ g h)
  power-hom-arr-fibre h .Arrow-map.bot = _≃_.fwd (fibre-postcomp≃ g (h ∘ f))
  power-hom-arr-fibre h .Arrow-map.comm (_ , refl) = refl

  power-hom-arr-fibre-is-equiv : ∀ h → is-Arrow-equiv (power-hom-arr-fibre h)
  power-hom-arr-fibre-is-equiv h
    = ( fibre-postcomp≃ g h ._≃_.fwd-is-equiv
      , fibre-postcomp≃ g (h ∘ f) ._≃_.fwd-is-equiv
      )

  are-orthogonal-fibre←is-cartesian
    : is-cartesian (power-hom f g)
    → are-orthogonal-fam f (fibre g)
  are-orthogonal-fibre←is-cartesian pb h
    = tgt-is-equiv←Arrow-equiv
        (power-hom-arr-fibre h , power-hom-arr-fibre-is-equiv h)
        (pb h)

  is-cartesian←are-orthogonal-fibre
    : are-orthogonal-fam f (fibre g)
    → is-cartesian (power-hom f g)
  is-cartesian←are-orthogonal-fibre eq h
    = src-is-equiv←Arrow-equiv
        (power-hom-arr-fibre h , power-hom-arr-fibre-is-equiv h)
        (eq h)

  are-orthogonal-fibre←are-orthogonal
      : are-orthogonal f g
      → are-orthogonal-fam f (fibre g)
  are-orthogonal-fibre←are-orthogonal orth h
    = are-orthogonal-fibre←is-cartesian
        (power-hom-cartesian←pullback-power f g orth)
        h

  are-orthogonal←are-orthogonal-fibre
    : are-orthogonal-fam f (fibre g)
    → are-orthogonal f g
  are-orthogonal←are-orthogonal-fibre orth
    = pullback-power←power-hom-cartesian f g
        (is-cartesian←are-orthogonal-fibre orth)

  are-orthogonal↔are-orthogonal-fibre
    : are-orthogonal f g ↔ are-orthogonal-fam f (fibre g)
  are-orthogonal↔are-orthogonal-fibre
    = (are-orthogonal-fibre←are-orthogonal , are-orthogonal←are-orthogonal-fibre)
}

\p{Similarly we have #{f \perp P} iff #{f \perp \pi_P}.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
  {C : Type 𝓦}
  {f : A → B} {P : C → Type 𝓛}
  where
  are-orthogonal-fst←are-orthogonal-fam
    : are-orthogonal-fam f P → are-orthogonal f (fst: P)
  are-orthogonal-fst←are-orthogonal-fam orth
    = are-orthogonal←are-orthogonal-fibre
        (are-orthogonal-fam←equiv
          {P = P} {fibre (fst: P)}
          (_e⁻¹ ∘ fibre-straighten P)
          orth)

  are-orthogonal-fam←are-orthogonal-fst
    : are-orthogonal f (fst: P) → are-orthogonal-fam f P
  are-orthogonal-fam←are-orthogonal-fst orth
    = are-orthogonal-fam←equiv
          (fibre-straighten P)
          (are-orthogonal-fibre←are-orthogonal orth)

  are-orthogonal-fam↔are-orthogonal-fst
    : are-orthogonal-fam f P ↔ are-orthogonal f (fst: P)
  are-orthogonal-fam↔are-orthogonal-fst
    = ( are-orthogonal-fst←are-orthogonal-fam
      , are-orthogonal-fam←are-orthogonal-fst)
}
}

\subtree[stt-004A]{
\title{Classification of orthogonal maps}
\taxon{Theorem}

\p{We summarise the main results of this module.
For maps #{f : A \to B} and #{g : C \to D}, we have that the following
are equivalent:}

\ol{
  \li{#{f \perp g} - the pullback power #{\pullpow{f}{g}} is an equivalence.}
  \li{The square defined in \ref{stt-004C} is a pullback square}
  \li{There are unique lifts for any square from #{f} to #{g}}
  \li{#{f \perp \fibre-fam{g}} – i.e the [dependent postcomposition](stt-004M)
        by #{f} at the fibre of #{g} is an equivalence.}
}

\proof{
\p{We have already shown (1) iff (2) as a [corollary](stt-004L) of the fact
that the pullback power [is homotopic to the gap map](stt-004C).
\ref{stt-00NZ} gives us (1) iff (3). Finally, \ref{stt-00O2} proves (2) iff (4).}
}


\p{We record the remaining composite implications in Agda:}

\closedScope{
\subtree{
\title{Details}
\agda{
unique-lifts←are-orthogonal-fam
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → are-orthogonal-fam f (fibre g)
    → admit-unique-lifts f g
unique-lifts←are-orthogonal-fam {f = f} {g} eqv F
  = is-single←equiv-to-single (pb-power-fibre≃lifts _ _ F)
     (has-singleton-fibres←is-equiv
       (pullback-power←power-hom-cartesian _ _
         (is-cartesian←are-orthogonal-fibre eqv))
        F)

unique-lifts←is-cartesian
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → is-cartesian (power-hom f g)
    → admit-unique-lifts f g
unique-lifts←is-cartesian cart
  = unique-lifts←are-orthogonal-fam (are-orthogonal-fibre←is-cartesian cart)

is-cartesian←are-orthogonal
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → are-orthogonal f g
    → is-cartesian (power-hom f g)
is-cartesian←are-orthogonal = power-hom-cartesian←pullback-power _ _

are-orthogonal←is-cartesian
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → is-cartesian (power-hom f g)
    → are-orthogonal f g
are-orthogonal←is-cartesian = pullback-power←power-hom-cartesian _ _
}
}
}
}


\subtree[stt-004N]{
\date{2025-05-24}
\taxon{Remark}
\title{Orthogonality at types}
\p{We say that a type #{A} is orthogonal to a map when the unique map #{A \to 1}
   is.}
}


\subtree[stt-004O]{
\date{2025-05-24}
\taxon{Theorem}
\title{Orthogonality via composition}

\p{A type #{A} is [orthogonal](stt-004N) to a map #{X \to Y} iff postcomposition
by f is an equivalence.}

\p{We postpone this proof until later, but for now in the formalisation we
   define orthogonality to be the types satisfying the above property.}

\agda{
orthogonal-type
  : ∀ {𝓤 𝓥 𝓦} {X : Type 𝓤} {Y : Type 𝓥}
      (f : X → Y) (A : Type 𝓦)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
orthogonal-type f A = is-equiv (precomp A f)
}
}


\subtree[stt-004B]{
\taxon{Notation}

\p{When #{f} and #{g} are orthogonal, we write #{f \perp g}. Likewise
if #{A} is a type, then we can write #{f \perp A} to mean #{!_A} is orthogonal to
#{f}. Finally, if #{P} is a type family, then we write #{f \perp P} to mean
#{P} is orthogonal \em{as a type family} to #{f}.}

\remark{Note that for a type family #{P}, it is not in general true that
#{(\forall x. f \perp P(x))} iff #{f \perp P}.}

\agda{
module notation where
  instance
    orth-maps
      : ∀ {𝓤 𝓥 𝓦 𝓛}
          {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} {D : Type 𝓛}
        → Orthogonality (A → B) (C → D)
    orth-maps .Orthogonality._⊥_ = are-orthogonal

  {-# OVERLAPPABLE orth-maps #-}

  instance
    orth-map-typ
      : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
        → Orthogonality (A → B) (Type 𝓦)
    orth-map-typ .Orthogonality._⊥_ = orthogonal-type

  instance
    orth-map-fam
      : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
        → Orthogonality (A → B) (C → Type 𝓛)
    orth-map-fam .Orthogonality._⊥_ = are-orthogonal-fam

  {-# OVERLAPPING orth-map-fam #-}

open notation
}
}

\subtree[stt-004Q]{
\taxon{Proof}
\title{Proof of \ref{stt-004O}}

\p{
We want to show #{A \to \b1} is orthogonal to #{f : X \to Y}, which by
the [[stt-004A]], it suffices to show that for all #{h : Y \to 1}, the map
#{{-} \circ f : ((y : Y) \to \fibre{!}{h(y)}) \to ((x : X) \to \fibre{!}{h(f(x))})}
is an equivalence. But the fibre of #{A \to 1} is just A. Formally, we can
use the 3-for-2 property on the following diagram:
}

\quiver{
\begin{tikzcd}
	{\fibre{!}{-}^Y} &&& {\fibre{!}{-}^X} \\
	\\
	& {A^Y} & {A^X}
	\arrow[from=1-1, to=1-4]
	\arrow["\sim"', from=1-1, to=3-2]
	\arrow["{A^f}"', from=3-2, to=3-3]
	\arrow["\sim"', from=3-3, to=1-4]
\end{tikzcd}
}

\agda{
is-orthogonal↔orthogonal-!
  : ∀ {𝓤 𝓥 𝓦} {X : Type 𝓤} {Y : Type 𝓥}
      {f : X → Y} {A : Type 𝓦}
    → (f ⊥ (!: A))
    ↔ (f ⊥ A)
is-orthogonal↔orthogonal-! {X = X} {Y} {f} {A}
  = ((λ orth → tgt-is-equiv←Arrow-equiv (sq , sq-is-equiv)
                 (are-orthogonal-fibre←are-orthogonal orth !))
    , λ orth →  are-orthogonal←are-orthogonal-fibre
                 (λ _ → src-is-equiv←Arrow-equiv (sq , sq-is-equiv) orth)) where
  fst⁻¹ : A → fibre {A = A} ! _
  fst⁻¹ a = a , refl

  fst-is-equiv : is-equiv {A = fibre {A = A} ! tt} fst
  fst-is-equiv = is-equiv←qinv (fst⁻¹
                               , (λ where (a , refl) → refl)
                               , ~refl)

  H :   (fst ∘_) ∘ precomp-Π (fibre ! ∘ (λ _ → tt)) f
      ~ precomp A f ∘ (fst ∘_)
  H f' = funext→ ~refl

  sq : Arrow-map (precomp-Π (fibre {A = A} ! ∘ !) f) (precomp A f)
  sq .Arrow-map.top = fst ∘_
  sq .Arrow-map.bot = fst ∘_
  sq .Arrow-map.comm = H

  sq-is-equiv  : is-Arrow-equiv sq
  sq-is-equiv .fst = postcomp-equiv fst-is-equiv
  sq-is-equiv .snd = postcomp-equiv fst-is-equiv
}
}

\subtree[stt-00EB]{
\title{Anodyne maps}
\taxon{Definition}

\p{We say a map #{f} is #{k}-anodyne if any map orthogonal to #{k} is also
orthogonal to #{f}.}

\agda{
is-anodyne
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {X : Type 𝓦} {Y : Type 𝓜}
    → (A → B) → (X → Y) → Typeω
is-anodyne f k
  = ∀ {𝓤' 𝓥'} {U : Type 𝓤'} {V : Type 𝓥'} (g : U → V)
   → k ⊥ g → f ⊥ g
}
}

\subtree[stt-00L3]{
\title{Orthogonality at a point}


\p{We can give a more simple representation of the type of lifting
problems as a pullback when the left map is an inclusion of a point.}

\agda{
module _ {𝓘 𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
         {I : Type 𝓘} (p : I) where
  private
    m : Cospan-map
          (mk-cospan (𝟙 → B) (postcomp _ f) (precomp _ (point p)))
          (mk-cospan B f (ev p))
    m .Cospan-map.h₁ = ev tt
    m .Cospan-map.h₂ = ev tt
    m .Cospan-map.h₃ = id
    m .Cospan-map.H = ~refl
    m .Cospan-map.K = ~refl

    m-is-equiv : is-cospan-equiv m
    m-is-equiv .fst = unit-ev-is-equiv
    m-is-equiv .snd .fst = unit-ev-is-equiv
    m-is-equiv .snd .snd = id-is-equiv

  orthogonal-point-gap-map : (I → A) → Pullback f (ev p)
  orthogonal-point-gap-map = Pullback₁ m
                           ∘ pullback←arrow
                           ∘ pullback-power (point p) f

  orthogonal-point-pullback-condition
    : point p ⊥ f → is-equiv orthogonal-point-gap-map
  orthogonal-point-pullback-condition orth
    = is-equiv-∘
        (Pullback₁-is-equiv m m-is-equiv)
        (is-equiv-∘
          (Arrow-map≃pullback ._≃_.fwd-is-equiv)
          (pullback-power←power-hom-cartesian
            (point p) f (is-cartesian←are-orthogonal orth)))
}

\p{If a family is orthogonal to a point inclusion, then evaluation at
that point is an equivalence}

\agda{
eval-anodyne-point-is-equiv
  : ∀ {𝓤 𝓥} {B : Type 𝓤}
      (b₀ : B) (E : B → Type 𝓥)
    → point b₀ ⊥ E
    → is-equiv {A = Π B E} (ev b₀)
eval-anodyne-point-is-equiv b E bE
  = is-equiv-∘
      {f = ev tt}
      unit-ev-is-equiv
      (bE id)
}
}

\subtree[tot-BLAH]{
\title{Precomposing the cogap map is equivalent to the gap map of the precomposition square}
\taxon{Lemma}
\date{2026-09-02}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓧 𝓜}
  (S : Span 𝓤 𝓥 𝓦)
  {X : Type 𝓧}
  (C : Cocone S X)
  (A : Type 𝓜)
  where

  gap-precomp←precomp-cogap
    : Arrow-map (gap (precomp-cone' C A)) (precomp A (cogap C))
  gap-precomp←precomp-cogap .Arrow-Π.top = id
  gap-precomp←precomp-cogap .Arrow-Π.bot = pushout-pullback-map
  gap-precomp←precomp-cogap .Arrow-Π.comm f = funext→
    (pushout-rec-unique
      ((_≃_.bwd precomp-cocone≃pb') (gap (precomp-cone' C A) f))
      _
      ~refl ~refl
      (λ a
       → ∙-reflr _ ∙ ap-∘ f _ (glue a) ∙ ap (ap f) (pushout-rec-apβ a)
       ∙ sym (ap sym (happly funext-redex a ∙ ap-sym _ _) ∙ sym-sym)) h⁻¹)

  gap-precomp≃precomp-cogap
    : Arrow-equiv (gap (precomp-cone' C A)) (precomp A (cogap C))
  gap-precomp≃precomp-cogap .fst = gap-precomp←precomp-cogap
  gap-precomp≃precomp-cogap .snd .fst = id-is-equiv
  gap-precomp≃precomp-cogap .snd .snd = pushout-pullback-map-is-equiv
}
}


\subtree[tot-AIRY]{
\title{Orthogonality at a [cogap map](stt-004G)}
\author{samueltoth}
\date{2026-09-02}

\p{We give a usefull criteria for when a [type is orthogonal to a map](stt-004O)
defined as the cogap map of a square. In particular, given the following square:

\quiver{
\begin{tikzcd}
	A &&& B \\
	\\
	&& \bullet \\
	C &&& D
	\arrow[from=1-1, to=1-4]
	\arrow[from=1-1, to=4-1]
	\arrow[from=1-4, to=4-4]
	\arrow["\lrcorner"{anchor=center, pos=0.125, rotate=180}, draw=none, from=3-3, to=1-1]
	\arrow[from=3-3, to=1-4]
	\arrow[from=3-3, to=4-1]
	\arrow[dashed, from=3-3, to=4-4]
	\arrow[from=4-1, to=4-4]
\end{tikzcd}
}

a type #{X} is orthogonal to the cogap map iff the [square given by precomposition](stt-003P)
at #{X} is [cartesian](stt-003V).
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓧 𝓜}
  (S : Span 𝓤 𝓥 𝓦)
  {X : Type 𝓧}
  (C : Cocone S X)
  (A : Type 𝓜)
  where

  is-orthogonal-cogap←precomp-cartesian
    : is-pullback (precomp-cone' C A) → orthogonal-type (cogap C) A
  is-orthogonal-cogap←precomp-cartesian
    = tgt-is-equiv←Arrow-equiv (gap-precomp≃precomp-cogap S C A)

  precomp-cartesian←is-orthogonal-cogap
    : orthogonal-type (cogap C) A → is-pullback (precomp-cone' C A)
  precomp-cartesian←is-orthogonal-cogap
    = src-is-equiv←Arrow-equiv (gap-precomp≃precomp-cogap S C A)

  precomp-cartesian↔is-orthogonal-cogap
    : orthogonal-type (cogap C) A ↔ is-pullback (precomp-cone' C A)
  precomp-cartesian↔is-orthogonal-cogap
    = (precomp-cartesian←is-orthogonal-cogap , is-orthogonal-cogap←precomp-cartesian)
}
}

\subtree[stt-00PI]{
\title{Right classes of coproducts of families of maps}
\taxon{Lemma}

\p{
A map is right orthogonal to the coproduct of two families of maps exactly when it is
right orthogonal to both families.
}

\agda{
right-orthogonal-⨄₁ᶠ
  : ∀ {𝓘 𝓙 𝓤 𝓥 𝓠 𝓡}
      {I : Type 𝓘} {J : Type 𝓙}
      {A : I → Type 𝓤} {B : I → Type 𝓥}
      {C : J → Type 𝓤} {D : J → Type 𝓥}
      {X : Type 𝓠} {Y : Type 𝓡}
      {f : (i : I) → A i → B i}
      {g : (j : J) → C j → D j}
      {h : X → Y}
    → ((k : I ⊎ J) → are-orthogonal ((f ⨄₁ᶠ g) k) h)
    ↔ (((i : I) → are-orthogonal (f i) h)
      × ((j : J) → are-orthogonal (g j) h))
right-orthogonal-⨄₁ᶠ .fst orth
  = (λ i → orth (inl i)) , (λ j → orth (inr j))
right-orthogonal-⨄₁ᶠ .snd (forth , gorth) (inl i) = forth i
right-orthogonal-⨄₁ᶠ .snd (forth , gorth) (inr j) = gorth j
}
}
