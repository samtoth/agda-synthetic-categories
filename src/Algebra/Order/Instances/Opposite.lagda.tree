\title{Opposite orders}
\date{2026-06-11}
\taxon{Module}
\author{fredrikbakke}
\import{stt-macros}

\agda{
module Algebra.Order.Instances.Opposite where
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Joins

open import Algebra.Poset
open import Algebra.BoundedPoset
open import Algebra.Order.BottomElements
open import Algebra.Order.TopElements
open import Algebra.TotalOrder
}
}

\subtree[stt-00TH]{
\title{The opposite poset}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-06-11}

\p{
The \em{opposite} of a poset is the poset with the order reversed.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) (let module P = Poset P) where

  op-is-poset : is-poset (P._≥_)
  op-is-poset .is-poset.≤-is-prop = P.≤-is-prop
  op-is-poset .is-poset.≤-refl = P.≤-refl
  op-is-poset .is-poset.≤-trans p q = P.≤-trans q p
  op-is-poset .is-poset.≤-antisym p q = P.≤-antisym q p

  Poset-op : Poset 𝓥 A
  Poset-op .Poset._≤_ = P._≥_
  Poset-op .Poset.≤-is-poset = op-is-poset
}

\p{
If we had had η-equality for the \code{is-poset} predicate then this construction
would be a judgmental involution on posets.
}
}

\subtree[bak-B6EE]{
\title{Bottom elements become top elements in the opposite poset}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
A [bottom element](bak-FCC3) of a poset is a [top element](bak-5B1C) of its
[opposite](stt-00TH), since reversing the order turns #{b \le x} into #{x \le b}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) where

  op-is-top-element
    : {b : A} → is-bottom-element P b → is-top-element (Poset-op P) b
  op-is-top-element b-is-bottom = b-is-bottom

  top-element-op : bottom-element P → top-element (Poset-op P)
  top-element-op (b , b-is-bottom) = (b , op-is-top-element b-is-bottom)
}
}

\subtree[bak-8059]{
\title{Top elements become bottom elements in the opposite poset}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
A [top element](bak-5B1C) of a poset is a [bottom element](bak-FCC3) of its
[opposite](stt-00TH).
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) where

  op-is-bottom-element
    : {t : A} → is-top-element P t → is-bottom-element (Poset-op P) t
  op-is-bottom-element t-is-top = t-is-top

  bottom-element-op : top-element P → bottom-element (Poset-op P)
  bottom-element-op (t , t-is-top) = (t , op-is-bottom-element t-is-top)
}
}

\subtree[bak-0A44]{
\title{The opposite bounded poset}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
The \em{opposite bounded poset} of a [bounded poset](bak-A907) is its
[opposite poset](stt-00TH) with the bottom and top elements interchanged.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} where

  op-is-bounded-poset
    : (P : Poset 𝓥 A) → is-bounded-poset P → is-bounded-poset (Poset-op P)
  op-is-bounded-poset P (b , t) = (bottom-element-op P t , top-element-op P b)

  BoundedPoset-op : BoundedPoset 𝓥 A → BoundedPoset 𝓥 A
  BoundedPoset-op P .BoundedPoset.poset = Poset-op (P .BoundedPoset.poset)
  BoundedPoset-op P .BoundedPoset.poset-is-bounded
    = op-is-bounded-poset (P .BoundedPoset.poset) (P .BoundedPoset.poset-is-bounded)
}
}

\subtree[stt-00TK]{
\title{The opposite of a total order is total}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-06-11}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} where

  op-is-total : (P : Poset 𝓥 A) → is-total-poset P → is-total-poset (Poset-op P)
  op-is-total P P-is-total i j = *-comm→ (P-is-total i j)

  TotalOrder-op : TotalOrder 𝓥 A → TotalOrder 𝓥 A
  TotalOrder-op (mk-total-order P P-is-total)
    = mk-total-order (Poset-op P) (op-is-total P P-is-total)
}
}
