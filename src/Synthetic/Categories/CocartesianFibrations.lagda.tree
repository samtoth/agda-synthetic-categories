\subtree[tot-0003]{
\title{Cocartesian lifts}
\taxon{Definition}

\agda{
module _
  {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥}
  (p : E → B)
  where

  lift-is-cocartesian
    : (F : Arrow-map (point i0) p) → Lift F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  lift-is-cocartesian F L = is-cocartesian-morphism p (Lift.lift L)

  cocartesian-lift
    : (F : Arrow-map (point i0) p) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  cocartesian-lift F = Σ (Lift F) (lift-is-cocartesian F)
}
}

\subtree[tot-0004]{
\title{Cocartesian fibrations}
\taxon{Definition}

\agda{
module _
  {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥}
  (p : E → B)
  where

  power-hom-cocartesian
    : Arrow-map (postcomp Δ¹ p ∘ (fst: is-cocartesian-morphism p)) p
  power-hom-cocartesian .Arrow-Π.top = ev i0 ∘ fst
  power-hom-cocartesian .Arrow-Π.bot = ev i0
  power-hom-cocartesian .Arrow-Π.comm = ~refl

  is-cocartesian-fibration
    : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-cocartesian-fibration
    = is-equiv (⟨ point i0 , p ⟩ ∘ (fst: is-cocartesian-morphism p))

  has-unique-cocartesian-lifts
    : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  has-unique-cocartesian-lifts
    = ∀ (f : Arrow-map (point i0) p)
      → is-singleton (Σ[ l ∶ Lift f ] is-cocartesian-morphism p (l .Lift.lift))

  has-initial-cocartesian-lifts
    : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  has-initial-cocartesian-lifts
    = ∀ (f : Arrow-map (point i0) p)
      → is-initial
          (Σ[ l ∶ Lift f ] is-cocartesian-morphism p (l .Lift.lift))

module _
  {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥}
  (p : E → B)
  where

  base-change-has-unique-cocartesian-lifts
    : ∀ {𝓦} {A : Type 𝓦} (σ : A → B)
      → has-unique-cocartesian-lifts p
      → has-unique-cocartesian-lifts (base-change-arrow p σ)
  base-change-has-unique-cocartesian-lifts σ pf f
    = {!!}


module _
  {𝓤 𝓥} {B : Type 𝓤} (E : B → Type 𝓥)
  where

  -- TODO think about cocartesian dependent morhpisms or something
  has-unique-cocartesian-extensions : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  has-unique-cocartesian-extensions
    = ∀ (f : ArrFam-map (point i0) E)
      → is-singleton
          (Σ[ l ∶ Extᵈ (point i0) (E ∘ f .ArrFam-map.bot) (f .ArrFam-map.top) ]
            is-cocartesian-morphism (fst: E) λ i → f .ArrFam-map.bot i , l .fst i)

  has-unique-locally-cocartesian-extensions
    : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  has-unique-locally-cocartesian-extensions
    = ∀ (f : ArrFam-map (point i0) E)
      → is-singleton
          (Σ[ l ∶ Extᵈ (point i0) (E ∘ f .ArrFam-map.bot) (f .ArrFam-map.top) ]
            is-locally-cocartesian-morphism
              (fst: E)
              (λ i → f .ArrFam-map.bot i , l .fst i))

  has-initial-extensions : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  has-initial-extensions
    = ∀ (f : ArrFam-map (point i0) E)
      → Σ (Extᵈ (point i0) (E ∘ f .ArrFam-map.bot) (f .ArrFam-map.top))
          is-initial


  has-unique-locally-cocartesian-extensions←has-initial-extensions
    : has-initial-extensions ≃ has-unique-locally-cocartesian-extensions
  has-unique-locally-cocartesian-extensions←has-initial-extensions
    = postcomp-Π-≃ (λ f
      → Σ (Extᵈ (point i0) (E ∘ f .ArrFam-map.bot) (f .ArrFam-map.top))
         is-initial
      ≃⟨ Σ-snd-≃ (λ a → {!!}) ⟩
        Σ[ l ∶ Extᵈ (point i0) (E ∘ (f .ArrFam-map.bot)) (f .ArrFam-map.top) ]
          (is-locally-cocartesian-morphism
            (fst: E)
            (λ i → f .ArrFam-map.bot i , l .fst i))
      ≃⟨ {!!} ⟩
        is-singleton
         (Σ
          (Extᵈ (λ _ → i0) (λ a → E (f .ArrFam-map.bot a))
           (f .ArrFam-map.top))
          (λ l →
             is-locally-cocartesian-morphism (fst: _)
             (λ i → f .ArrFam-map.bot i , l .fst i)))
      ≃∎)

has-unique-cocartesian-lifts-is-Δ¹-relative
  : ∀ {𝓤 𝓥} {B : Type 𝓤} (E : B → Type 𝓥)
    → (∀ (σ : Δ¹ → B) → has-unique-cocartesian-extensions (E ∘ σ))
    → has-unique-cocartesian-extensions E
has-unique-cocartesian-lifts-is-Δ¹-relative E cce (mk-afmap σ x₀)
  = is-single←equiv-to-single
      (Σ-snd-≃ (λ where (l , p) → {!!}))
                    -- equiv←logical is-cartesian-is-prop is-cartesian-is-prop
                    --   ( {!!}
                    --   , {!!})))
      (cce σ (mk-afmap id x₀))
}
}

\subtree[tot-0005]{
\taxon{Lemma}

\p{A cocartesian fibration is left fibration iff every morphism is
cocartesian.}

\agda{
module _
  {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥}
  (p : E → B)
  (p-cc : is-cocartesian-fibration p)
  where

  is-left-fibration←all-morphisms-cocartesian
    : (∀ f → is-cocartesian-morphism p f) → is-left-fibration p
  is-left-fibration←all-morphisms-cocartesian ccp
    = 3-for-2'
        (singleton-fst-is-equiv
          (λ f → mk-singl (ccp f) (is-cartesian-is-prop (ccp f))))
        p-cc

  all-morphisms-cocartesian←is-left-fibration
    : is-left-fibration p → (∀ f → is-cocartesian-morphism p f)
  all-morphisms-cocartesian←is-left-fibration plf f
    = centre {A = is-cocartesian-morphism p f}
        (is-single←equiv-to-single
          (fibre-straighten (is-cocartesian-morphism p) f)
          (has-singleton-fibres←is-equiv
            (3-for-2 plf p-cc)
            f))

  is-left-fibration⇔all-morphisms-cocartesian
    : (∀ f → is-cocartesian-morphism p f) ↔ is-left-fibration p
  is-left-fibration⇔all-morphisms-cocartesian
    = ( is-left-fibration←all-morphisms-cocartesian
      , all-morphisms-cocartesian←is-left-fibration)
}
}
