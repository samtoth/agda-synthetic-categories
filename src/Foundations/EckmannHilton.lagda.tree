\date{2026-08-27}
\title{The Eckmann–Hilton argument}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\def\hconcat{\mathbin{◾}}
\def\vconcat{\mathbin{◽}}

\agda{
{-# OPTIONS --lossy-unification #-}

module Foundations.EckmannHilton where
}

\agda-imports{
\agda{
open import Foundations.Functions
open import Foundations.Homotopy
open import Foundations.Identity
open import Foundations.IdentityHorizontalConcatenation
open import Foundations.LoopSpaces
open import Foundations.Squares
open import Foundations.Universes
}
