\title{Closure of connected maps}
\taxon{Module}
\author{fredrikbakke}
\date{2026-10-28}
\import{stt-macros}

\agda{
module Modalities.ConnectedClosure where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.DependentOrthogonal
open import Core.PullbackPowers
open import Core.PushoutSums
open import Core.LeibnizAdjunction
open import Modalities.ConnectedMaps
open import Modalities.ModalMaps
}
}

\subtree[bak-08E1]{
\title{The dependent precomposition condition for connected pushout sums}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-10-28}

\p{
Let #{R} and #{K} be global subuniverses, let #{f \colon A \to B} satisfy the
[universal property of #{R}-connected maps](stt-00MQ), and consider a family
#{g \colon \Pi1{b : B}{X(b) \to Y(b)}}. Suppose that dependent precomposition along
every #{g(b)} at every #{K}-valued family is #{R}-modal. Then the
[pushout sum](stt-00EX) #{\pushsum_f g} satisfies the universal property of
#{K}-connected maps.
}

\proof{
\p{
Since #{f} is #{R}-connected, and [connected maps are dependently left orthogonal to
families of modal maps](bak-AB51), we have that #{f \perp^\rm{d} Π_{g(b)} U} for
every #{K}-valued family #{U} over #{X(b)}. [Dependent precomposition is equivalent
to the pullback power at the terminal projection family of #{U}](bak-C1A5), so we may
transpose along the [dependent Leibniz adjunction](bak-43FE), and obtain that
#{\pushsum_f g \perp^\rm{d} {!_U}}, hence #{\pushsum_f g} is #{K}-connected.
}
}

\agda{
module _
  {α β} (R : gSubU α) (K : gSubU β)
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  {X : B → Type 𝓦} {Y : B → Type 𝓜} (g : (b : B) → X b → Y b)
  where

  Σ̂-up-connected←precomp-Π-is-modal
    : up-connected-map R f
    → ( (b : B)
      → {𝓚 : Level} (U : Y b → Type 𝓚)
      → ((y : Y b) → U y ∈ gSubU.S K)
      → is-modal-map R (precomp-Π U (g b)))
    → up-connected-map K (Σ̂ f g)
  Σ̂-up-connected←precomp-Π-is-modal f-up-conn modal-precomp-g {U = U} U∈K
    = dependent-orthogonal-terminal↔precomp-Π (Σ̂ f g) U .fst
        (Σ̂⊥ᵈ↔⊥ᵈΠ̂ f g (λ b y → !: U (b , y)) .snd
          (up-connected⊥ᵈmodal R f f-up-conn
            ( λ b → Π̂ (g b) (λ y → !: U (b , y)))
            ( λ b
              → source-is-modal-map←Arrow-equiv R
                  (Π̂-at-singleton-codomain≃precomp-Π (g b) (λ y → !: U (b , y))
                    (λ _ → 𝟙-is-singleton))
                  (modal-precomp-g b (λ y → U (b , y)) (λ y → U∈K (b , y))))))
}

\agda{
module _
  {α β} (R : gSubU α) (K : gSubU β)
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  {X : Type 𝓦} {Y : Type 𝓜} (g : X → Y)
  where

  □-up-connected←precomp-Π-is-modal
    : up-connected-map R f
    → ( {𝓚 : Level} (U : Y → Type 𝓚)
      → ((y : Y) → U y ∈ gSubU.S K)
      → is-modal-map R (precomp-Π U g))
    → up-connected-map K (f □ g)
  □-up-connected←precomp-Π-is-modal f-up-conn modal-precomp-g
    = Σ̂-up-connected←precomp-Π-is-modal R K f (λ _ → g)
        (f-up-conn)
        (λ _ → modal-precomp-g)
}
}
