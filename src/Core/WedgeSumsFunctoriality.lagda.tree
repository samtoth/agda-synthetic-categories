\subtree[stt-00RN]{
\title{The functorial action of wedge sums on pointed maps}
\taxon{Definition}
\date{2026-05-21}
\author{fredrikbakke}

\agda{
module _ {𝓤 𝓥 𝓦 𝓣} {A : Type∗ 𝓤} {B : Type∗ 𝓥} {A' : Type∗ 𝓦} {B' : Type∗ 𝓣} where

  Wedge-map
    : map∗ A A'
    → map∗ B B'
    → Wedge (Type∗.pt A) (Type∗.pt B)
    → Wedge (Type∗.pt A') (Type∗.pt B')
  Wedge-map F G =
    Pushout₁
      (mk-span-map
        (map∗.hom F) id (map∗.hom G)
        (λ _ → map∗.pres-pt F)
        (λ _ → map∗.pres-pt G))

  Wedge₁∗ : map∗ A A' → map∗ B B' → map∗ (Wedge∗ A B) (Wedge∗ A' B')
  Wedge₁∗ F G .map∗.hom = Wedge-map F G
  Wedge₁∗ F G .map∗.pres-pt = ap ι₁ (map∗.pres-pt F)
}
}

\subtree[stt-00RU]{
\title{The functorial action preserves anodyne maps}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-21}
\author{samueltoth}
\date{2026-01-24}

\agda{
module _ {𝓧 𝓨} {X : Type 𝓧} {Y : Type 𝓨} (h : X → Y) where

  Wedge-map-is-anodyne
    : ∀ {𝓤 𝓥 𝓦 𝓣}
        {A : Type∗ 𝓤} {B : Type∗ 𝓥} {A' : Type∗ 𝓦} {B' : Type∗ 𝓣}
      → (F : map∗ A A') (G : map∗ B B')
      → is-anodyne (map∗.hom F) h
      → is-anodyne (map∗.hom G) h
      → is-anodyne (Wedge-map F G) h
  Wedge-map-is-anodyne F G fia gia k hk
    = left-orthogonal-pushout₁
        (map∗.hom F , λ _ → map∗.pres-pt F)
        (map∗.hom G , λ _ → map∗.pres-pt G)
        k
        (fia k hk)
        (gia k hk)

  Wedge-map-right-is-anodyne
    : ∀ {𝓤 𝓥 𝓦} {B : Type∗ 𝓥} {B' : Type∗ 𝓦}
        (A : Type∗ 𝓤) (G : map∗ B B')
      → is-anodyne (map∗.hom G) h
      → is-anodyne (Wedge-map (id∗ A) G) h
  Wedge-map-right-is-anodyne A G =
    Wedge-map-is-anodyne (id∗ A) G (λ k _ → id⊥ k)

  Wedge-map-left-is-anodyne
    : ∀ {𝓤 𝓥 𝓦} {A : Type∗ 𝓥} {A' : Type∗ 𝓦}
        (G : map∗ A A') (B : Type∗ 𝓤)
      → is-anodyne (map∗.hom G) h
      → is-anodyne (Wedge-map G (id∗ B)) h
  Wedge-map-left-is-anodyne G A g =
    Wedge-map-is-anodyne G (id∗ A) g (λ k _ → id⊥ k)
}
}

\subtree[stt-00RO]{
\title{The functorial action preserves equivalences}
\taxon{Proposition}
\date{2026-05-21}
\author{fredrikbakke}

\agda{
module _ {𝓤 𝓥 𝓦 𝓣} {A : Type∗ 𝓤} {B : Type∗ 𝓥} {A' : Type∗ 𝓦} {B' : Type∗ 𝓣} where

  Wedge-map-is-equiv
    : (F : map∗ A A') (G : map∗ B B')
    → is-equiv (map∗.hom F)
    → is-equiv (map∗.hom G)
    → is-equiv (Wedge-map F G)
  Wedge-map-is-equiv F G Feq Geq =
    is-equiv←precomp (Wedge-map F G) λ {X = X}
      → is-equiv-∘
          (arrow-map-to-top-is-equiv)
          (Wedge-map-is-anodyne
            (id: 𝟙) F G
            (λ k _ → equiv⊥ Feq k)
            (λ k _ → equiv⊥ Geq k)
            (!: X)
            (id⊥ (!: X)))
}
}
