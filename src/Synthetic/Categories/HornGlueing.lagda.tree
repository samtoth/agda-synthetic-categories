Δ²-is-segal : is-segal Δ²
Δ²-is-segal = is-segal←retract Δ²-retract-Δ¹×Δ¹ (×-is-segal Δ¹-is-segal Δ¹-is-segal)
}

\subtree[stt-00X4]{
\title{The data of a covariant fibration over #{Δ²}}
\taxon{Definition}

\p{For some base type #{B}, we define covariant #{Δ²}-bundles over #{B} to be the
data consisting of:

\ul{
\li{Covariant families of types #{X,Y,Z} over #{B}}
\li{Fibrewise maps #{\alpha_b \colon X_b \to Y_b} and #{\beta_b \colon Y_b \to Z_b}}
}
}

\agda{
Cov-Δ²-bundle
  : ∀ {𝓤} 𝓥0 𝓥1 𝓥2 → Type 𝓤
    → Type (𝓘 ⊔ 𝓤 ⊔ lsuc (𝓥0 ⊔ 𝓥1 ⊔ 𝓥2))
Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B
  = Σ[ X ∶ CovBundle 𝓥0 B ] Σ[ Y ∶ CovBundle 𝓥1 B ] Σ[ Z ∶ CovBundle 𝓥2 B ]
    ((fibrewise-map (Y .fst) (Z .fst)) × (fibrewise-map (X .fst) (Y .fst)))
}

\p{We also provide an alternative definition which consists of a pair of
[Δ¹-bundles](stt-00V3) over #{B} together with a fibrewise equivalence between the target
of the first and the source of the second. This definition closely matches the
definition of the [inner horn](stt-00AD) #{\Lambda^2_1} as a pushout.}

\agda{
Cov-Δ²-bundle'
  : ∀ {𝓤} 𝓥0 𝓥1 𝓥1' 𝓥2 → Type 𝓤
    → Type (𝓘 ⊔ 𝓤 ⊔ lsuc (𝓥0 ⊔ 𝓥1 ⊔ 𝓥1' ⊔ 𝓥2))
Cov-Δ²-bundle' 𝓥0 𝓥1 𝓥1' 𝓥2 B
  = Σ[ X ∶ CovBundle 𝓥0 B ] Σ[ Y ∶ CovBundle 𝓥1 B ]
    Σ[ Y' ∶ CovBundle 𝓥1' B ] Σ[ Z ∶ CovBundle 𝓥2 B ]
    Σ[ e ∶ (∀ b → Y .fst b ≃ Y' .fst b) ]
    ((fibrewise-map (Y' .fst) (Z .fst)) × (fibrewise-map (X .fst) (Y .fst)))
}

\p{We provide functions for translating between these definitions.}

\agda{
Cov-Δ²-bundle-coh
  : ∀ {𝓤 𝓥0 𝓥1 𝓥1' 𝓥2} {B : Type 𝓤}
    → Cov-Δ²-bundle' 𝓥0 𝓥1 𝓥1' 𝓥2 B → Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B
Cov-Δ²-bundle-coh (X , Y , Y' , Z , e , f , g)
  = ( X , Y , Z , (λ b → f b ∘ e b ._≃_.fwd) , g)

Cov-Δ²-bundle-decoh
  : ∀ {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤}
    → Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B → Cov-Δ²-bundle' 𝓥0 𝓥1 𝓥1 𝓥2 B
Cov-Δ²-bundle-decoh (A , B , C , f , g)
  = ( A , B , B , C , (λ _ → id≃) , f , g)
}
}

\subtree[stt-00X3]{
\title{Characterising the identity type of a covariant bundle over #{Δ^2}}
\taxon{Lemma}

\agda{
cov-Δ²-bundle-Id
  : ∀ {𝓤 𝓥0 𝓥1 𝓥2 𝓦0 𝓦1 𝓦2} {B : Type 𝓤}
    → Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B → Cov-Δ²-bundle 𝓦0 𝓦1 𝓦2 B
    → Type (𝓤 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥2 ⊔ 𝓦0 ⊔ 𝓦1 ⊔ 𝓦2)
cov-Δ²-bundle-Id
  ((A , _) , (B , _) , (C , _) , f , g)
  ((X , _) , (Y , _) , (Z , _) , α , β)
  = Σ[ e ∶ (∀ a → A a ≃ X a)] Σ[ j ∶ (∀ b → B b ≃ Y b)] Σ[ k ∶ (∀ c → C c ≃ Z c)]
     ( (∀ x → k x ._≃_.fwd ∘ f x ~ α x ∘ j x ._≃_.fwd)
     × (∀ x → j x ._≃_.fwd ∘ g x ~ β x ∘ e x ._≃_.fwd))

cov-Δ²-bundle'-Id
  : ∀ {𝓤 𝓥0 𝓥1 𝓥1' 𝓥2 𝓦0 𝓦1 𝓦1' 𝓦2} {B : Type 𝓤}
    → Cov-Δ²-bundle' 𝓥0 𝓥1 𝓥1' 𝓥2 B → Cov-Δ²-bundle' 𝓦0 𝓦1 𝓦1' 𝓦2 B
    → Type (𝓤 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥1' ⊔ 𝓥2 ⊔ 𝓦0 ⊔ 𝓦1 ⊔ 𝓦1' ⊔ 𝓦2)
cov-Δ²-bundle'-Id
  ((A , _) , (B , _) , (B' , _) , (C , _) , H , f , g)
  ((X , _) , (Y , _) , (Y' , _) , (Z , _) , K , α , β)
  = Σ[ e ∶ (∀ a → A a ≃ X a)]
    Σ[ j ∶ (∀ b → B b ≃ Y b)]
    Σ[ l ∶ (∀ b → B' b ≃ Y' b) ]
    Σ[ k ∶ (∀ c → C c ≃ Z c)]
     ( (∀ x → l x ._≃_.fwd ∘ H x ._≃_.fwd ~ K x ._≃_.fwd ∘ j x ._≃_.fwd)
     × (∀ x → k x ._≃_.fwd ∘ f x ~ α x ∘ l x ._≃_.fwd)
     × (∀ x → j x ._≃_.fwd ∘ g x ~ β x ∘ e x ._≃_.fwd))

cov-Δ²-bundle-Id-refl
  : ∀ {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤} (x : Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B)
    → cov-Δ²-bundle-Id x x
cov-Δ²-bundle-Id-refl x
  = ( (λ _ → id≃)
    , (λ _ → id≃)
    , (λ _ → id≃)
    , (λ _ → ~refl)
    , (λ _ → ~refl))

opaque
  cov-Δ²-bundle-Id-is-torsorial
    : ∀ {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤} (x : Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B)
      → is-singleton (Σ (Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B) (cov-Δ²-bundle-Id x))
  cov-Δ²-bundle-Id-is-torsorial (A , B , C , f , g)
    = is-singleton-structure←parts
        (SingS-is-single A)
        (A , (λ _ → id≃))
        (is-singleton-structure←parts
          (SingS-is-single B)
          (B , (λ _ → id≃))
          (is-singleton-structure←parts
            (SingS-is-single C)
            (C , (λ _ → id≃))
            (is-singleton-structure←parts
              (SingS-is-single f)
              (f , (λ _ → ~refl))
              (SingS-is-single g))))

cov-Δ²-bundle-Id←Arrow-equivs
  : ∀ {𝓤 𝓥0 𝓥1 𝓥2 𝓦0 𝓦1 𝓦2} {B : Type 𝓤}
      (x : Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B) (y : Cov-Δ²-bundle 𝓦0 𝓦1 𝓦2 B)
      (F : ∀ b → Arrow-equiv (x .snd .snd .snd .fst b) (y .snd .snd .snd .fst b))
      (G : ∀ b → Arrow-equiv (x .snd .snd .snd .snd b) (y .snd .snd .snd .snd b))
    → (∀ b → F b .fst .Arrow-map.top ~ G b .fst .Arrow-map.bot)
    → cov-Δ²-bundle-Id x y
cov-Δ²-bundle-Id←Arrow-equivs x y F G H .fst b
  = mk≃ (G b .fst .Arrow-map.top) (G b .snd .fst)
cov-Δ²-bundle-Id←Arrow-equivs x y F G H .snd .fst b
  = mk≃ (G b .fst .Arrow-map.bot) (G b .snd .snd)
cov-Δ²-bundle-Id←Arrow-equivs x y F G H .snd .snd .fst b
  = mk≃ (F b .fst .Arrow-map.bot) (F b .snd .snd)
cov-Δ²-bundle-Id←Arrow-equivs x y F G H .snd .snd .snd .fst b
  = F b .fst .Arrow-map.comm ∙h (y .snd .snd .snd .fst b ◃h H b)
cov-Δ²-bundle-Id←Arrow-equivs x y F G H .snd .snd .snd .snd b
  = G b .fst .Arrow-map.comm

instance
  cov-Δ²-bundle-IdS
    : ∀ {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤}
      → Identity-system (Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B) (𝓤 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥2)
  cov-Δ²-bundle-IdS .Identity-system.IdS = cov-Δ²-bundle-Id
  cov-Δ²-bundle-IdS .Identity-system.IdS←Id {x} refl = cov-Δ²-bundle-Id-refl x
  cov-Δ²-bundle-IdS .Identity-system.IdS←Id-is-equiv x
    = fundamental-Id _ (cov-Δ²-bundle-Id-is-torsorial x) _
}
}

\subtree[stt-00XD]{
\title{The induced transport of a covariant family over #{Δ²}}
\taxon{Construction}

\p{Given a covariant type family over #{\Delta^2 \times B}, we can construct a
[covariant #{Δ²}-bundle over #{B}](stt-00X4) via covariant transport.}

\agda{
total-tr²-cov
  : ∀ {𝓤 𝓥} {B : Type 𝓤}
    → CovBundle 𝓥 (Δ² × B)
    → Cov-Δ²-bundle 𝓥 𝓥 𝓥 B
total-tr²-cov (F , Fcov)
  = ( (F ∘ (0 ,_) , covariant-base-change {P = F} (0 ,_) Fcov)
    , (F ∘ (1 ,_) , covariant-base-change {P = F} (1 ,_) Fcov)
    , (F ∘ (2 ,_) , covariant-base-change {P = F} (2 ,_) Fcov)
    , ( λ b → tr-cov-hom {P = F ∘ (_, b)}
        (covariant-base-change {P = F} (_, b) Fcov) Δ²-1≤2)
    , ( λ b → tr-cov-hom {P = F ∘ (_, b)}
        (covariant-base-change {P = F} (_, b) Fcov) Δ²-0≤1))
}
}

\subtree[stt-00X8]{
\taxon{Lemma}

\p{Given a covariant family #{F \colon \Delta^2 \to \Type}, we give equivalences of maps
between the action of covariant transport over homs in #{Δ²} and the action given
by first base changing the covariant family by a suitable restriction #{Δ¹ \to Δ²}
and then transporting over the morphism #{0 \le 1} in #{Δ¹}.}

\agda{
tr-Δ²-0≤1-lemma
  : ∀ {𝓤} (F : Δ² → Type 𝓤) (Fc : is-covariant F)
    → Arrow-equiv
        (tr-cov-hom {P = F} Fc Δ²-0≤1)
        (tr-cov-hom {P = (F ∘ δ₂²)}
          (covariant-base-change {P = F} δ₂² Fc)
          0≤1)
tr-Δ²-0≤1-lemma F Fc .fst .Arrow-Π.top = id
tr-Δ²-0≤1-lemma F Fc .fst .Arrow-Π.bot = id
tr-Δ²-0≤1-lemma F Fc .fst .Arrow-Π.comm a
  = tr-cov-hom-unique
      Fc Δ²-0≤1 a
      (tr-cov-hom {P = F ∘ δ₂²} (covariant-base-change {P = F} δ₂² Fc) 0≤1 a)
      (tr-cov-over {P = F ∘ δ₂²} (covariant-base-change {P = F} δ₂² Fc) 0≤1 a)
tr-Δ²-0≤1-lemma F Fc .snd = (id-is-equiv , id-is-equiv)

tr-Δ²-1≤2-lemma
  : ∀ {𝓤} (F : Δ² → Type 𝓤) (Fc : is-covariant F)
    → Arrow-equiv
        (tr-cov-hom {P = F} Fc Δ²-1≤2)
        (tr-cov-hom {P = (F ∘ δ₀²)}
          (covariant-base-change {P = F} δ₀² Fc)
          0≤1)
tr-Δ²-1≤2-lemma F Fc .fst .Arrow-Π.top = tr F Δ²-refl
tr-Δ²-1≤2-lemma F Fc .fst .Arrow-Π.bot = tr F Δ²-refl
tr-Δ²-1≤2-lemma F Fc .fst .Arrow-Π.comm a
  = sym
     (tr-cov-hom-unique
       (covariant-base-change {P = F} δ₀² Fc)
       0≤1
       (tr F Δ²-refl a)
       (tr F Δ²-refl (tr-cov-hom {P = F} Fc Δ²-1≤2 a))
       (adjust-hom {A = F ∘ δ₀²}
         (ap (λ p → tr F p a) (Δ²-is-set _ _ _  _))
         (ap (λ p → tr F p (tr-cov-hom {P = F} Fc Δ²-1≤2 a)) (Δ²-is-set _ _ _ _))
         (tr-cov-over {P = F} Fc Δ²-1≤2 a)))
tr-Δ²-1≤2-lemma F Fc .snd = (tr-is-equiv Δ²-refl , tr-is-equiv Δ²-refl)
}
}

\subtree[stt-00XB]{
\title{The glueing of a composable pair of maps}
\taxon{Construction}

\p{We give a putative inverse to the map defined in \ref{stt-00XD}. I.e.
given a pair of composable fibrewise maps between covariant type families over
some base #{B}, we give a covariant family over #{\Delta^2 \times B}. Following
\citek{GWB26} we define such a covariant via a kind of 'iteration' of the
[glue construction](stt-00UY) used to prove [directed univalence](stt-00V2).}

\p{Concretely, given #{X,Y,Z \colon B \to \Type} and #{\alpha \colon X \to Y} and
#{\beta \colon Y \to Z}, we may construct a type family
#{\Gl(\alpha) \colon \Delta^1 \times B \to \Type}, as well as a fibrewise map to
#{Z} viewed as a type family over #{Δ¹ \times B} with a trivial dependence on
#{\Delta^1}. Since we have a pair of covariant families and a fibrewise map between
them, we may use glueing again to to obtain a covariant family over
#{\Delta^1 \times (\Delta^1 \times B) \simeq \II^2 \times B}. Finally, we may
restrict to obtain a covariant family over #{Δ² \times B} which we denote
#{\Gl^2(\alpha, \beta).}
}

\agda{
module HornGlueing
  {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤}
  {X : B → Type 𝓥0} {Y : B → Type 𝓥1} {Z : B → Type 𝓥2}
  (β : ∀ b → Y b → Z b) (α : ∀ b → X b → Y b)
  where

  fibre-map : ∀ i → fibrewise-map (Gl X Y α ∘ (i ,_)) Z
  fibre-map i b = β b ∘ fst

  fibre-map-at-1 : ∀ b → Arrow-equiv (fibre-map i1 b) (β b)
  fibre-map-at-1 b = mk-arr-equiv (Gl-1≃ X Y α b) id≃ ~refl

  fibre-map-at-0 : ∀ b → Arrow-equiv (fibre-map i0 b) (β b ∘ α b)
  fibre-map-at-0 b
    = mk-arr-equiv (Gl-0≃ X Y α b) id≃ (λ (y , p) → ap (β b) (sym (p refl .snd)))

  Gl² : Δ² × B → Type (𝓘 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥2)
  Gl² ((i , j) , b) = Gl (λ b' → Gl X Y α (i , b')) Z (fibre-map i) (j , b)

  Gl²' : (Δ¹ × Δ¹) × B → Type (𝓘 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥2)
  Gl²' ((i , j) , b) = Gl (Gl X Y α) (Z ∘ snd) (uncurry fibre-map) (j , (i , b))

  Gl²-as-base-change : Gl² ~ Gl²' ∘ (□←Δ²-upper ×₁ id)
  Gl²-as-base-change = ~refl
}

\p{We verify that #{\Gl^2(\alpha, \beta)(0) \simeq X}, #{\Gl^2(\alpha, \beta)(1) \simeq Y}
and #{\Gl^2(\alpha, \beta)(2) \simeq Z}}

\agda{
  Gl²-0 : fibrewise-map (Gl² ∘ (δ₂² i0 ,_)) X
  Gl²-0 b = Gl-0 X Y α b ∘ Gl-0 _ Z (fibre-map i0) b

  Gl²-0-is-equiv
    : is-fibrewise-equiv Gl²-0
  Gl²-0-is-equiv b
    = is-equiv-∘ (Gl-0-is-equiv X Y α b) (Gl-0-is-equiv _ Z (fibre-map i0) b)

  Gl²-1 : fibrewise-map (Gl² ∘ (δ₂² i1 ,_)) Y
  Gl²-1 b =  Gl-1 X Y α b ∘ Gl-0 _ Z (fibre-map i1) b

  Gl²-1-is-equiv
    : is-fibrewise-equiv Gl²-1
  Gl²-1-is-equiv b
    = is-equiv-∘ (Gl-1-is-equiv X Y α b) (Gl-0-is-equiv _ Z (fibre-map i1) b)

  Gl²-1' : fibrewise-map (Gl² ∘ (δ₀² i0 ,_)) Y
  Gl²-1' = Gl²-1

  Gl²-2 : fibrewise-map (Gl² ∘ (δ₀² i1 ,_)) Z
  Gl²-2 = Gl-1 _ Z _

  Gl²-2-is-equiv : is-fibrewise-equiv Gl²-2
  Gl²-2-is-equiv = Gl-1-is-equiv _ Z _

  tr-Gl²-refl
    : ∀ {i j} {p q : j ≤ i} b → tr (Gl² ∘ (_, b)) (Δ²-refl {p = p}{q}) ~ id
  tr-Gl²-refl b x
    = tr∘ (Gl²' ∘ (_, b)) □←Δ²-upper Δ²-refl
    ∙ sym (tr-refl _ x prop!)
}
}

\subtree[stt-00XC]{
\title{Covariance of [directed horn glueing](stt-00XB)}
\taxon{Lemma}

\proof{
The directed horn glueing family arises as a base-change of a directed glueing of
covariant families, which by \ref{stt-00UZ} is covariant.
}

\agda{
module Gl²-cov
  {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤}
  {X : B → Type 𝓥0} {Y : B → Type 𝓥1} {Z : B → Type 𝓥2}
  (β : ∀ b → Y b → Z b) (α : ∀ b → X b → Y b)
  (open HornGlueing β α)
  where

  Gl²'-is-covariant
    : is-covariant X → is-covariant Y → is-covariant Z
    → is-covariant Gl²'
  Gl²'-is-covariant Xc Yc Zc
    = Gl∘-is-covariant
        (λ ((i , j) , b) → (j , (i , b)))
        (Gl X Y α)
        (Z ∘ snd)
        (uncurry fibre-map)
        (Gl-is-covariant X Y α Xc Yc)
        (covariant-base-change {P = Z} snd Zc)

  Gl²-is-covariant
    : is-covariant X → is-covariant Y → is-covariant Z
    → is-covariant Gl²
  Gl²-is-covariant Xc Yc Zc
    = covariant-base-change
        {P = Gl²'}
        (□←Δ²-upper ×₁ id)
        (Gl²'-is-covariant Xc Yc Zc)

  Gl²∘-is-covariant
    : is-covariant X → is-covariant Y → is-covariant Z
    → ∀ {𝓧} {A : Type 𝓧} (f : A → Δ² × B)
      → is-covariant (Gl² ∘ f)
  Gl²∘-is-covariant Xc Yc Zc f
    = covariant-base-change {P = Gl²} f (Gl²-is-covariant Xc Yc Zc)
}
}


\subtree[stt-00XA]{
\title{Directed #{\Delta^2} univalence for covariant families}
\taxon{Theorem}

\p{The map defined in \ref{stt-00XD} induces an equivalence between covariant
families over #{\Delta^2 \times B} and the type consisting of a triple of covariant
families over #{B} and fibrewise maps between them.}

\agda{
module _ {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤} (open Gl²-cov {𝓤} {𝓥0} {𝓥1} {𝓥2}) where

  tr²Σ-inv
    : Cov-Δ²-bundle 𝓥0 𝓥1 𝓥2 B
    → CovBundle (𝓘 ⊔ 𝓥0 ⊔ 𝓥1 ⊔ 𝓥2) (Δ² × B)
  tr²Σ-inv ((A , Ac) , (B , Bc) , (C , Cc) , β , α)
    = (HornGlueing.Gl² β α , Gl²-is-covariant β α Ac Bc Cc)
}

\p{Without any further assumptions, glueing gives a left inverse of
covariant transport.}

\proof{
\p{If #{\alpha \colon X \to Y} and #{\beta \colon Y \to Z} is a covariant
#{\Delta^2}-bundle, we must show that the induced covariant transport of the
[iterated glueing construction](stt-00XB) is equivalent to the one we started with. }

\p{We use the second characterisation of covariant #{Δ²}-bundles as a pair of
[covariant #{\Delta^1}-bundles](stt-00V3) with an equivalence between their central
families so that we may construct a suitably compatible pair of equivalences
#{\Gl^2(α,β)(0\le 1) \simeq α} and #{\Gl^2(α,β)(1\le 2) \simeq β}.}

\p{
##{
\begin{align}
\Gl^2(α,β)(0 \le_{Δ²} 1) &\simeq (\Gl^2(α,β) \circ \delta_2^2)(0 \le_{Δ¹} 1) \\
&\simeq \Gl(\alpha)(0 \le 1) \\
&\simeq \alpha
\end{align}
}

##{
\begin{align}
\Gl^2(α,β)(1 \le 2) &\simeq (\Gl^2(α,β) \circ \delta_0^2)(0 \le_{Δ¹} 1)\tag{1} \\
&\simeq \Gl(\Gl(α)(1), Z, \phi(1))(0 \le 1) \\
&\simeq \phi(1) \\
&\simeq β
\end{align}
}

\ol{
\li{Follows from \ref{stt-00X8}}
\li{Since #{\Gl^2(α,β) \delta_2^2} is equivalent as a map to #{\Gl(\alpha)}}
\li{By the [transport lemma for 'ordinary' directed glueing](stt-00V4)}
\li{By \ref{stt-00X8}}
\li{By computing #{\Gl^2(α,β) \delta_0^2} (where #{\phi} is the fibrewise map from \ref{stt-00XB})}
\li{Again by the [transport lemma for 'ordinary' directed glueing](stt-00V4)}
\li{Since #{\phi(1)} is equivalent as a map to #{β}}
}
}
}

\agda{
module _
  {𝓤 𝓥0 𝓥1 𝓥2} {B : Type 𝓤}
  (c@((X , Xc) , (Y , Yc) , (Z , Zc) , f , g)
    : Cov-Δ²-bundle (𝓘 ⊔ 𝓥0) (𝓘 ⊔ 𝓥1) (𝓘 ⊔ 𝓥2) B)
  (open HornGlueing f g)
  (open Gl²-cov f g)
  where

  tr-Gl²-0≤1
    : ∀ b
      → Arrow-equiv
        (tr-cov-hom
          {P = Gl² ∘ (_, b)}
          (Gl²∘-is-covariant Xc Yc Zc (_, b))
          Δ²-0≤1)
        (g b)
  tr-Gl²-0≤1 b
    = tr-cov-hom (Gl²∘-is-covariant Xc Yc Zc (_, b)) Δ²-0≤1

    ≃Arr⟨ tr-Δ²-0≤1-lemma (Gl² ∘ (_, b)) (Gl²∘-is-covariant Xc Yc Zc (_, b)) ⟩

     tr-cov-hom (Gl²∘-is-covariant Xc Yc Zc (λ i → (δ₂² i , b))) 0≤1

    ≃Arr⟨ adjust-tr-cov-hom
           (Gl²∘-is-covariant Xc Yc Zc (λ i → (δ₂² i , b)))
           (Gl∘-is-covariant (_, b) X Y g Xc Yc)
           (Gl-0 (Gl X Y g ∘ (_, b)) (const (Z b)) (λ i → fibre-map i b))
           (Gl-0-is-equiv (Gl X Y g ∘ (_, b)) (const (Z b)) (λ i → fibre-map i b))
           0≤1 ⟩

     tr-cov-hom (Gl∘-is-covariant (_, b) X Y g Xc Yc) 0≤1

   ≃Arr⟨ tr-Gl-0≤1H {𝓤} {𝓥0} {𝓥1} g Xc Yc b ⟩

     g b ≃Arr∎


  opaque
    unfolding tr-cov-hom
    tr-Gl²-1≤2
      : ∀ b
        → Arrow-equiv
            (tr-cov-hom
                {P = Gl² ∘ (_, b)}
                (Gl²∘-is-covariant Xc Yc Zc (_, b))
                Δ²-1≤2)
            (f b)
    tr-Gl²-1≤2 b
      = tr-cov-hom (Gl²∘-is-covariant Xc Yc Zc (_, b)) Δ²-1≤2

      ≃Arr⟨ tr-Δ²-1≤2-lemma (Gl² ∘ (_, b)) (Gl²∘-is-covariant Xc Yc Zc (_, b)) ⟩

        tr-cov-hom {P = Gl² ∘ (λ i → (δ₀² i , b))}
          (Gl²∘-is-covariant Xc Yc Zc (λ i → (δ₀² i , b))) 0≤1

      ≃Arr⟨ adjust-tr-cov-hom
              {F = Gl² ∘ (λ i → (δ₀² i , b))}
              (Gl²∘-is-covariant Xc Yc Zc (λ i → (δ₀² i , b)))
              (Gl∘-is-covariant (_, b) (Gl X Y g ∘ (i1 ,_)) Z (fibre-map i1)
                (Gl∘-is-covariant (i1 ,_) X Y g Xc Yc) Zc)
              (λ _ → id) (λ _ → id-is-equiv) 0≤1 ⟩

        tr-cov-hom
          {P = Gl (Gl X Y g ∘ (i1 ,_)) Z (fibre-map i1) ∘ (_, b)}
          (Gl∘-is-covariant (_, b) (Gl X Y g ∘ (i1 ,_)) Z (fibre-map i1)
            (Gl∘-is-covariant (i1 ,_) X Y g Xc Yc) Zc)
          0≤1

      ≃Arr⟨ tr-Gl-0≤1H {𝓤} {𝓥0 ⊔ 𝓥1} {𝓥2}
              (fibre-map i1)
              (Gl∘-is-covariant (i1 ,_) X Y g Xc Yc) Zc b  ⟩

        f b ∘ Gl-1 X Y g b

      ≃Arr⟨ fibre-map-at-1 b ⟩

        f b ≃Arr∎

    tr-Gl²-1~
      : ∀ b → tr-Gl²-1≤2 b .fst .Arrow-map.top ~ tr-Gl²-0≤1 b .fst .Arrow-map.bot
    tr-Gl²-1~ b = Gl²-1 b ◃h tr-Gl²-refl b

    tr²Σ-section
      : cov-Δ²-bundle-Id (total-tr²-cov (tr²Σ-inv c)) c
    tr²Σ-section
      = cov-Δ²-bundle-Id←Arrow-equivs
          (total-tr²-cov (tr²Σ-inv c))
          c
          tr-Gl²-1≤2
          tr-Gl²-0≤1
          tr-Gl²-1~
}

\p{We now show that this map defines a right inverse. For a covariant family
#{F} over #{\Delta^2 \times B}, we need that #{F(i,b)} is equal to
#{\Gl^2(b \mapsto F(({-},0),b)_*, b \mapsto F((1,{-}),b)_*)(i,b)}. By univalence
we may give a fibrewise map and show it is an equivalence.
}

\p{In order to show that such a fibrewise map is indeed an equivalence we assume an
additional axiom; namely that for a crisp fibrewise map #{\alpha} between crisp
covariant families over #{\Delta^2 \times B}, to check it is an equivalence it
suffices to check that for all #{b},
#{\alpha_{(0,b)}}, #{\alpha_{(1,b)}} and #{\alpha_{(2,b)}} are equivalences.}

\remark{
This axiom follows for example from the pair of axioms that types with an
[initial object](stt-00FO) [separate](stt-00J7) and the 3-element type covers the
global points of #{\Delta^2}.
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤}
  (FF@(F , Fc) : CovBundle (𝓥 ⊔ 𝓘) (Δ² × B))
  (let Fbc b = covariant-base-change {P = F} (_, b) Fc)
  (open HornGlueing {B = B}
    {F ∘ (0 ,_)} {F ∘ (1 ,_)} {F ∘ (2 ,_)}
    (λ b → tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-1≤2)
    (λ b → tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-0≤1))
  where

  opaque
    unfolding tr-cov-hom
    Gl²←cov-fam
      : ∀ (b : Δ² × B)
        → F b → Gl² b
    Gl²←cov-fam (ij , b) x .fst
      = tr-cov-hom {P = F ∘ (_, b)} (Fbc b) (Δ²-top ij) x
    Gl²←cov-fam ((i , i0) , b) x .snd refl .fst
      = Gl←cov-fam {𝓤} {𝓥}
          ( (λ (i , b) → F ((i , i0) , b))
          , covariant-base-change {P = F} (λ (i , b) → ((i , i0) , b)) Fc)
          (i , b)
          (tr F (ap (_, b) Δ²-refl) x)
    Gl²←cov-fam (ii@((i , i0) ⦃ p ⦄) , b) x .snd refl .snd
      = lemma b i p prop! x where
      lemma
        : ∀ b i (p : i0 ≤ i) (QQ : p ＝ ≤-bot) (x : FF .fst ((i , i0) ⦃ p ⦄ , b))
          →  tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-1≤2
                (tr-cov-hom {P = F ∘ (λ i → ((i , i0) , b))}
                  (λ f → FF .snd (λ a → ((f a , i0) , b)))
                    (Δ¹-hom←≤ 1-top) (tr F (ap (_, b) Δ²-refl) x))
          ＝ tr-cov-hom {P = F ∘ (_, b)}(Fbc b) (Δ²-top ((i , i0) ⦃ p ⦄)) x
      lemma b i ._ refl x
        = (tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-1≤2
               (tr-cov-hom {P = F ∘ (λ i → ((i , i0) , b))}
                  (covariant-base-change {P = F} (λ i → ((i , i0) , b)) Fc)
                  (Δ¹-hom←≤ 1-top)
                  (tr F (ap (_, b) Δ²-refl) x)))
        ＝⟨ ap (tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-1≤2)
               (sym (tr-cov-ap-hom δ₂² (F ∘ (_, b)) (Fbc b)
                       (covariant-base-change {P = F ∘ (_, b)} δ₂² (Fbc b))
                       refl
                       (Δ¹-hom←≤ 1-top)
                       (Δ²-hom←≤ I-distr (i , i0) 1 (Δ²-ext (1-top , ≤-refl)))
                       (Hom-ext→
                         ( (λ j
                            → Δ²-ext
                                ( (ap (_∧ (i ∨ i1)) ∨-comm)
                                , (∧-comm ∙  ap (_∧ (i0 ∨ j)) 0-bottom  ∙ 0-init)))
                         , (Δ²-is-set _ _ _ _ , Δ²-is-set _ _ _ _)))
                       (tr F (ap (_, b) Δ²-refl) x)
                       )) ⟩

          (tr-cov-hom {P = F ∘ (_, b)} (Fbc b) Δ²-1≤2
             (tr-cov-hom {P = F ∘ (_, b)}
                (Fbc b)
                (Δ²-hom←≤ I-distr (δ₂² i) 1 (Δ²-ext (1-top , ≤-refl)))
                (tr F (ap (_, b) Δ²-refl) x)))

        ＝⟨ sym ( tr-cov-∘ Δ²-is-segal (F ∘ (_, b)) (Fbc b)
                    Δ²-1≤2 (Δ²-hom←≤ I-distr (i , i0) 1 (Δ²-ext (1-top , ≤-refl)))
                    (tr F (ap (_, b) Δ²-refl) x)) ⟩

          tr-cov-hom {P = F ∘ (_, b)} (Fbc b)
            (  Δ²-1≤2
            ∘[ Δ²-is-segal ]
              (Δ²-hom←≤ I-distr (i , i0) 1 (Δ²-ext (1-top , ≤-refl))))
            (tr F (ap (_, b) Δ²-refl) x)

        ＝⟨ tr-cov-equal-hom {P = F ∘ (_, b)} (Fbc b)
              (  Δ²-1≤2
              ∘[ Δ²-is-segal ]
                (Δ²-hom←≤ I-distr (i , i0) 1 (Δ²-ext (1-top , ≤-refl))))
              (Δ²-top (i , i0))
              (Hom-Δ²-is-prop _ _)
              (tr F (ap (_, b) Δ²-refl) x) ⟩

          (tr-cov-hom {P = F ∘ (_, b)} (Fbc b) (Δ²-top (i , i0))
                  (tr F (ap (_, b) Δ²-refl) x))
        ＝⟨ ap (tr-cov-hom {P = F ∘ (_, b)} (Fbc b) (Δ²-top (i , i0)))
               (sym (tr-refl (ap (_, b) Δ²-refl) x
                 (ap (ap (_, b)) (Δ²-is-set _ _ _ _)))) ⟩
            Gl²←cov-fam ((i , i0) , b) x .fst
        ∎

    Gl²←cov-fam-is-equiv-at-0
      : ∀ b → is-equiv (Gl²←cov-fam (0 , b))
    Gl²←cov-fam-is-equiv-at-0 b
      = 3-for-2
          (Gl²-0-is-equiv b)
          (tr-is-equiv (ap (_, b) (Δ²-ext (refl , refl))))

    Gl²←cov-fam-is-equiv-at-1
      : ∀ b → is-equiv (Gl²←cov-fam (1 , b))
    Gl²←cov-fam-is-equiv-at-1 b
      = 3-for-2~
          (λ x
           → sym
              ( tr-cov-idH~
                 (F ∘ (λ a → ((a , i0) , b)))
                 (λ f → Fc (λ a → ((f a , i0) , b)))
                 (Δ¹-hom←≤ 1-top)
                 (Δ¹-hom-≤-refl 1-top)
                 (x) )
              ∙ ap (tr-cov-hom (λ f → Fc (λ a → ((f a , i0) , b))) (Δ¹-hom←≤ 1-top))
                   (tr-refl
                     (ap (_, b) (Δ²-ext (refl , refl)))
                     x
                     (ap (ap (_, b)) (Δ²-is-set _ _ _ _))))
          (Gl²-1-is-equiv b)
          id-is-equiv

    Gl²←cov-fam-is-equiv-at-2
      : ∀ b → is-equiv (Gl²←cov-fam (2 , b))
    Gl²←cov-fam-is-equiv-at-2 b
      = 3-for-2~
          (tr-cov-idH~
            (F ∘ (_, b)) (Fbc b)
            (Δ²-top 2)
            (Δ²-top-is-id ≤-refl) h⁻¹)
          (Gl²-2-is-equiv b)
          id-is-equiv

module _
  {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
  (@♭ crisp-cov-Nat-is-equiv
        : ∀ {@♭ 𝓤} (@♭ F G : CovBundle 𝓤 (Δ² × B))
            (@♭ α : ∀ i → F .fst i → G .fst i)
          → @♭ (∀ (@♭ b : B) (@♭ x : Fin (suc (suc (suc zero))))
                → is-♭-equiv (α (Δ²-point-incl x , b)))
          → is-fibrewise-equiv α)
  where

  Gl²←cov-fam-is-equiv
    : ∀ (@♭ F : CovBundle (𝓥 ⊔ 𝓘) (Δ² × B))
      → is-fibrewise-equiv (Gl²←cov-fam {𝓤} {𝓥} F)
  Gl²←cov-fam-is-equiv F = crisp-cov-Nat-is-equiv
    F
    (tr²Σ-inv (total-tr²-cov F))
    (Gl²←cov-fam F)
    (λ b → ♭Fin-ind₃ _
      (is-♭-equiv←is-equiv (Gl²←cov-fam-is-equiv-at-0 F b))
      (is-♭-equiv←is-equiv (Gl²←cov-fam-is-equiv-at-1 F b))
      (is-♭-equiv←is-equiv (Gl²←cov-fam-is-equiv-at-2 F b)))
    where

    ♭Fin-ind₃
      : ∀ {@♭ 𝓤} (@♭ P : (@♭ x : Fin 3) → Type 𝓤)
        → @♭ P 0 → @♭ P 1 → @♭ P 2 → ∀ (@♭ x) → P x
    ♭Fin-ind₃ P p0 p1 p2 x = (♭⊣ᵈ♯-transpose-bwd {B = ♭-ind P}
      (λ where
        0ᶠ .counit♯ → p0
        1ᶠ .counit♯ → p1
        2ᶠ .counit♯ → p2
        (fsuc (fsuc (fsuc ()))) .counit♯)
      .counit♯) (mod♭ x)

  opaque
    total-tr²-cov-is-♭-equiv
      : is-♭-equiv (total-tr²-cov {𝓤} {𝓘 ⊔ 𝓥} {B})
    total-tr²-cov-is-♭-equiv
      = is-equiv←qinv
          ( (♭-map (tr²Σ-inv {𝓤} {𝓘 ⊔ 𝓥} {𝓘 ⊔ 𝓥} {𝓘 ⊔ 𝓥}))
          , ♭-ind
              (λ F
               → mapply♭ (mod♭ (ext! λ a
               → mk≃ (Gl²←cov-fam {𝓤} {𝓥} F a) (Gl²←cov-fam-is-equiv F a) e⁻¹)))
          , ♭-ind (λ a → mapply♭ (mod♭ (ext! (tr²Σ-section {𝓤} {𝓥} {𝓥} {𝓥} a)))))
}

\remark{
Notice that we have to explicitly transport across the [flat-sharp
adjunction](stt-00JK) to define the crisp induction principle for the 3 element type
(\code{♭Fin-ind₃}).  Because we have flat-split enabled, one would expect to just be
able to pattern match on crisp elements of \code{Fin 3}; but for some reason Agda
doesn't accept this.  In any case, using the adjunction is the 'principled' way to
derive crisp induction principles and is how it is done in Shulman's original work on
cohesive type theory \citek{Shu17a}.
}
}
