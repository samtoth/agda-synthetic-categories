\date{2026-08-30}
\title{Truncated types}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Foundations.Truncated where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Nat
open import Foundations.Functions
open import Foundations.FunctionInverses
open import Foundations.Homotopy
open import Foundations.Identity
open import Foundations.Sigma
open import Foundations.SigmaIdentity
open import Foundations.Equivalences
open import Foundations.Embeddings
open import Foundations.EquivSingleton
open import Foundations.Singletons
open import Foundations.SingletonClosure
open import Foundations.PropClosure
open import Foundations.UniverseLifts
open import Foundations.Unit
open import Foundations.Empty
open import Foundations.TruncationLevels
open import Foundations.FunExt
open import Foundations.Currying
open import Foundations.Retracts
open import Foundations.CanonicalEqualisers
open import Foundations.CanonicalPullbacks
import Foundations.SingletonProp
}
