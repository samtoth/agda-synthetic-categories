\title{Binary joins in posets}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-22}
\import{stt-macros}

\agda{
open import Foundations.Prelude
open import Algebra.Poset

module Algebra.Order.BinaryJoins {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) where
}

\agda-imports{
\agda{
open import Algebra.Order.Instances.Opposite
import Algebra.Order.BinaryMeets
}
}

\agda{
open Algebra.Order.BinaryMeets (Poset-op P) public
  using ()
  renaming
    ( is-binary-meet to is-binary-join
    ; binary-meet to binary-join
    ; has-binary-meets to has-binary-joins
    ; is-binary-meet-is-prop to is-binary-join-is-prop
    ; binary-meet-unique to binary-join-unique
    ; binary-meet-is-prop to binary-join-is-prop
    ; has-binary-meets-is-prop to has-binary-joins-is-prop
    ; ∧-idem to ∨-idem
    ; ∧-comm to ∨-comm
    ; ∧-assoc to ∨-assoc
    ; ∧-bottom-right to ∨-top-right
    ; ∧-bottom-left to ∨-top-left
    ; ∧-top-right to ∨-bottom-right
    ; ∧-top-left to ∨-bottom-left)

module HasBinaryJoins (joins : has-binary-joins) where
  open Algebra.Order.BinaryMeets.HasBinaryMeets (Poset-op P) joins public
    renaming
      ( _∧_ to _∨_
      ; ∧-is-meet to ∨-is-join
      ; ∧-≤-left to ≤-∨-left
      ; ∧-≤-right to ≤-∨-right
      ; ∧-UP to ∨-UP)
}
