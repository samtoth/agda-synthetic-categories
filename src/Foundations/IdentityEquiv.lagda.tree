\title{Equivalences of identity types}
\taxon{Module}
\author{samueltoth}
\contributor{fredrikbakke}

\import{stt-macros}

\agda{
module Foundations.IdentityEquiv where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.QuasiEquivalences
open import Foundations.Equivalences
open import Foundations.Homotopy
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.DependentIdentity
open import Foundations.FibrewiseEquivalences
open import Foundations.Embeddings
open import Foundations.EquivHomotopy
open import Foundations.FunExt
}
}

\agda{
sym-qinv : ∀ {𝓤} {A : Type 𝓤} {a b : A} → quasi-inv (sym {x = a} {b})
sym-qinv .fst = sym
sym-qinv .snd .fst refl = refl
sym-qinv .snd .snd refl = refl

sym-is-equiv : ∀ {𝓤} {A : Type 𝓤} {a b : A} → is-equiv (sym {x = a} {b})
sym-is-equiv .is-equiv.qinv = sym-qinv
sym-is-equiv .is-equiv.coherent refl = refl

sym≃ : ∀ {𝓤} {A : Type 𝓤} {a b : A} → (a ＝ b) ≃ (b ＝ a)
sym≃ = mk≃ sym sym-is-equiv

＝-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → {a b : A}
    → (e : A ≃ B) → (a ＝ b) ≃ (e ._≃_.fwd a ＝ e ._≃_.fwd b)
＝-equiv (mk≃ fwd fwd-is-equiv) = mk≃ (ap fwd) (is-embedding←is-equiv fwd-is-equiv)

∙-is-equiv
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A} (p : a ＝ b)
    → is-equiv (λ (q : b ＝ c) → p ∙ q)
∙-is-equiv refl = id-is-equiv

∙-is-equiv'
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A} (p : b ＝ c)
    → is-equiv (λ (q : a ＝ b) → q ∙ p)
∙-is-equiv' refl = is-equiv←~ (λ where refl → refl) id-is-equiv

＝-postconcat-≃
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A} (p : a ＝ b)
    → (b ＝ c) ≃ (a ＝ c)
＝-postconcat-≃ p = mk≃ (p ∙_) (∙-is-equiv p)

＝-preconcat-≃
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A} (p : b ＝ c)
    → (a ＝ b) ≃ (a ＝ c)
＝-preconcat-≃ p = mk≃ (_∙ p) (∙-is-equiv' p)


Idᶠ-const-≃
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B)
      {x y : A} (p : x ＝ y)
      {l : B}
      (t : f x ＝ l)
      (r : f y ＝ l)
    → Idᶠ (λ z → f z ＝ l) p t r ≃ (ap f (sym p) ∙ t ＝ r)
Idᶠ-const-≃ f p t r = ＝-postconcat-≃ (sym (Idᵈ-const-coe f p t))

Idᶠ-const-≃'
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B)
      {x y : A} (p : x ＝ y)
      {l : B}
      (t : l ＝ f x)
      (r : l ＝ f y)
    → Idᶠ (λ z → l ＝ f z) p t r ≃ (t ∙ ap f p ＝ r)
Idᶠ-const-≃' f refl t r = ＝-postconcat-≃ (∙-reflr t)

tr-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      {a b : A} (p : a ＝ b)
    → is-equiv (tr B p)
tr-is-equiv {B = B} p = coe-is-equiv (ap B p)

fibre'≃fibre
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B) (b : B)
    → fibre' f b ≃ fibre f b
fibre'≃fibre f b = Σ-snd-≃ λ _ → sym≃
}

\subtree[stt-00YA]{
\title{The induced action on identifications of an embedding into a dependent product is an equivalence}
\taxon{Proposition}
\author{fredrikbakke}

\p{
Given an embedding into a dependent product #{f \colon Y \hookrightarrw \Pi_I B},
then the induced action on identifications
#{(x = y) \to \Pi_{(i : I)} f(x)(i) = f(y)(i)} is an equivalence.
}

\agda{
module _
  {𝓤 𝓥 𝓦} {Y : Type 𝓤} {I : Type 𝓥} {B : I → Type 𝓦}
  (FE : FunExt 𝓥 𝓦) (open WithFunExt FE)
  where

  ap-Π-is-equiv
    : {f : Y → Π I B} → is-embedding f
    → {x y : Y} → is-equiv (ap-Π f {x} {y})
  ap-Π-is-equiv {f = f} emb
    = is-equiv←~
      (λ p → funext→ (λ t → ap-∘ (ev t) f p))
      (is-equiv-∘ FE emb)

  ap-Π-equiv
    : (e : Y ↪ Π I B) → {x y : Y} → (x ＝ y) ≃ (e .fst x ~ e .fst y)
  ap-Π-equiv e = mk≃ (ap-Π (e .fst)) (ap-Π-is-equiv (e .snd))
}
}
