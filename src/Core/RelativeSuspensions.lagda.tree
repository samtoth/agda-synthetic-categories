\subtree[stt-012G]{
\title{Relative suspensions}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-17}

\p{
Given a map #{δ \colon X \to Y} and a type #{C}, then the \em{#{\delta}-suspension}
of #{C}, denoted #{\suspension_δ C}, is the pushout #{(Y × C) \amalg_{X × C} X}.
\quiver{
\begin{tikzcd}
X \times C && X \\
\\
Y \times C && \suspension_\delta C
\arrow[from=1-1, to=1-3]
\arrow[from=1-1, to=3-1]
\arrow[from=3-1, to=3-3]
\arrow[from=1-3, to=3-3]
\arrow[from=1-1, to=3-3, phantom, "\ulcorner" very near end]
\end{tikzcd}
}
Equivalently, it is the [pushout product](stt-00BS) of #{δ} and #{!_C}.
}

\agda{
module _ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} (δ : X → Y) where

  relative-suspension-span : ∀ {𝓦} → Type 𝓦 → Span (𝓤 ⊔ 𝓦) (𝓥 ⊔ 𝓦) 𝓤
  relative-suspension-span C = mk-span (X × C) (δ ×₁ id) fst

  RelativeSusp : ∀ {𝓦} → Type 𝓦 → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
  RelativeSusp C = Pushout₀ (relative-suspension-span C)
}
}

\subtree[stt-012V]{
\title{The dependent mapping out property of relative suspensions}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-17}

\p{
Given a type family #{P \colon \suspension_δ C \to \UU}, a section of
#{P} amounts to choosing a section #{q} over #{X} and, for each #{c : C},
a section #{p_c} over #{Y} together with coherence that these sections agree along
#{δ} after transport along the suspension glue:
##{\operatorname{transport}_{P}(\glue(x,c),p_c(δ(x))) = q(x).}
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓩} {X : Type 𝓤} {Y : Type 𝓥}
  (δ : X → Y) {C : Type 𝓦} (P : RelativeSusp δ C → Type 𝓩)
  where

  RelativeSusp-section-data : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓩)
  RelativeSusp-section-data
    = Σ[ q ∶ ((x : X) → P (ι₂ x)) ]
       ( (c : C)
       → Σ[ p ∶ ((y : Y) → P (ι₁ (y , c))) ]
          ( (x : X) → Idᵈ (ap P (glue (x , c))) (p (δ x)) (q x)))

  relative-suspension-coconeᵈ≃
    : Coconeᵈ (relative-suspension-span δ C) pushout P
    ≃ RelativeSusp-section-data
  relative-suspension-coconeᵈ≃ = mk≃
    (λ (mk-coconeᵈ p q H) → (q , (λ c → (p ∘ (_, c) , H ∘ (_, c)))))
    (mk-eqv (from , ~refl , ~refl) ~refl)
    where
    from : RelativeSusp-section-data → _
    from (q , F)
      = mk-coconeᵈ (λ (y , c) → F c .fst y) q (λ (x , c) → F c .snd x)

  RelativeSusp-UPᵈ≃
    : ((z : RelativeSusp δ C) → P z) ≃ RelativeSusp-section-data
  RelativeSusp-UPᵈ≃ = Pushout-UPᵈ≃ e⁻¹ ∙e relative-suspension-coconeᵈ≃

  RelativeSusp-restrictᵈ
    : ((z : RelativeSusp δ C) → P z) → RelativeSusp-section-data
  RelativeSusp-restrictᵈ f .fst = f ∘ ι₂
  RelativeSusp-restrictᵈ f .snd c .fst = f ∘ ι₁ ∘ (_, c)
  RelativeSusp-restrictᵈ f .snd c .snd = apᶠ f ∘ glue ∘ (_, c)

  RelativeSusp-UPᵈ : is-equiv RelativeSusp-restrictᵈ
  RelativeSusp-UPᵈ = RelativeSusp-UPᵈ≃ ._≃_.fwd-is-equiv

  RelativeSusp-ind
    : RelativeSusp-section-data → (z : RelativeSusp δ C) → P z
  RelativeSusp-ind = _≃_.bwd RelativeSusp-UPᵈ≃
}
}

\subtree[stt-012L]{
\title{The mapping out property of relative suspensions}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-17}

\p{
Mapping out of the relative suspension #{\suspension_δ C} into a type #{A} amounts
to choosing a map #{f \colon X \to A} and a #{C}-indexed family of
[extensions](stt-00CL) of #{f} along #{δ}. We derive this as a special case of the
dependent mapping out property.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓩} {X : Type 𝓤} {Y : Type 𝓥}
  (δ : X → Y) {C : Type 𝓦} {A : Type 𝓩}
  where

  RelativeSusp-section-data-const≃
    : RelativeSusp-section-data δ (λ _ → A)
    ≃ (Σ[ f ∶ (X → A) ] (C → Ext δ f))
  RelativeSusp-section-data-const≃
    = Σ-snd-≃ (λ f → Π-fam-≃ (λ c → Σ-snd-≃ (λ p → Π-fam-≃ (λ x
      → coe≃ (tr-constant (glue (x , c)) (p (δ x)) ∙-)))))

  RelativeSusp-UP≃
    : (RelativeSusp δ C → A) ≃ (Σ[ f ∶ (X → A) ] (C → Ext δ f))
  RelativeSusp-UP≃
    = RelativeSusp-UPᵈ≃ δ (λ _ → A) ∙e RelativeSusp-section-data-const≃

  RelativeSusp-restrict
    : (RelativeSusp δ C → A) → Σ[ f ∶ (X → A) ] (C → Ext δ f)
  RelativeSusp-restrict h
    = ( h ∘ ι₂
      , (λ c → (h ∘ ι₁ ∘ (_, c) , (h ◃h glue) ∘ (_, c))))

  RelativeSusp-UP : is-equiv RelativeSusp-restrict
  RelativeSusp-UP = is-equiv←~⁻¹ H (RelativeSusp-UP≃ ._≃_.fwd-is-equiv)
    where
    H : _≃_.fwd RelativeSusp-UP≃ ~ RelativeSusp-restrict
    H h
      = ap ((h ∘ ι₂) ,_)
          (funext→ (λ c → Id←Ext-htpy (~refl , (λ x → apᶠ-is-ap))))

  RelativeSusp-rec
    : (Σ[ f ∶ (X → A) ] (C → Ext δ f)) → RelativeSusp δ C → A
  RelativeSusp-rec = _≃_.bwd RelativeSusp-UP≃
}
}

\subtree[stt-012W]{
\title{Relative suspension at the booleans is suspension}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-17}

\p{
The relative suspension at #{{!} \colon \sphere{0} \to \b1} agrees with [ordinary
suspension](stt-002M):
##{\suspension_{\sphere{0}}(C) \simeq \suspension C.}
}

\proof{
\p{
This follows readily from the [folding property of pushouts](stt-012O), using that
#{\sphere{0}} are the booleans.
}
}

\agda{
module _ {𝓤} (C : Type 𝓤) where

  relative-suspension-Bool-fold-span-equiv
    : Span-equiv'
        (mk-span (Bool × C) fst (λ (b , c) → (tt , c)))
        (fold-span (!: C) (!: C))
  relative-suspension-Bool-fold-span-equiv
    = ( Σ-Bool≃⊎
      , (Σ-𝟙 e⁻¹ ∙e ×-swap ∙e Σ-Bool≃⊎)
      , (λ where
          (true , c) → refl
          (false , c) → refl)
      , Σ-𝟙
      , (λ where
          (true , c) → refl
          (false , c) → refl))

  RelativeSusp-Bool≃Susp : RelativeSusp (!: Bool) C ≃ Susp C
  RelativeSusp-Bool≃Susp
    = pushout-comm
    ∙e Pushout≃←Span-equiv' relative-suspension-Bool-fold-span-equiv
    ∙e fold-pushout≃ (!: C) (!: C)
}
}

\subtree[tot-AYCE]{
\title{The relative suspension at a point}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-23}

\p{The relative suspion of a type #{C} at a point #{\unitobj \to X} is
given by the cofibre of the induced map #{C \to C \times X}.}

\agda{
module _ {𝓤 𝓥} {X : Type 𝓤} (x : X) (C : Type 𝓥) where
  RelativeSusp≃Cofibre : RelativeSusp (point x) C ≃ Cofibre {A = C} (x ,_)
  RelativeSusp≃Cofibre = Pushout-adjust-equiv Σ-𝟙
}
}

\subtree[tot-AYBC]{
\title{The coslice mapping out property}
\author{samueltoth}
\taxon{Lemma}
\date{2026-09-24}

\agda{
module _
  {𝓤 𝓥 𝓦} {X : Type 𝓤} {Y : Type 𝓥}
  (δ : X → Y) {C : Type 𝓦}
  where

  RelativeSusp-ι : X → RelativeSusp δ C
  RelativeSusp-ι = ι₂

  RelativeSusp-proj
    : ∀ {𝓜} {A : Type 𝓜}
      → (RelativeSusp δ C → A)
      → (X → A)
  RelativeSusp-proj {A = A} = precomp A RelativeSusp-ι

  Slice-map-RelativeSusp-restrict
    : ∀ {𝓜} {A : Type 𝓜}
      → Slice-map (RelativeSusp-proj {A = A}) (fst: λ f → C → Ext δ f)
  Slice-map-RelativeSusp-restrict .fst = RelativeSusp-restrict δ
  Slice-map-RelativeSusp-restrict .snd = ~refl

  RelativeSusp-Slice-UP
    : ∀ {𝓜} {A : Type 𝓜}
      → Slice-equiv (RelativeSusp-proj {A = A}) (fst: λ f → C → Ext δ f)
  RelativeSusp-Slice-UP = (Slice-map-RelativeSusp-restrict , RelativeSusp-UP δ)

  fibre-RelativeSusp-underlying
    : ∀ {𝓜} {A : Type 𝓜} (i : X → A)
    → fibre (precomp A (RelativeSusp-ι)) i
    ≃ Coslice-map (RelativeSusp-ι) i
  fibre-RelativeSusp-underlying i = Σ-snd-≃ (λ a → funext≃)

module _
  {𝓤 𝓥 𝓦 𝓜} {X : Type 𝓤} {Y : Type 𝓥}
  (δ : X → Y) {C : Type 𝓦}
  {A : Type 𝓜}
  where

  RelativeSusp-Coslice-UP→
    : (i : X → A) → Coslice-map (RelativeSusp-ι δ {C}) i → (C → Ext δ i)
  RelativeSusp-Coslice-UP→ i (f , p) c
    = ( f ∘ ι₁ ∘ (_, c)
      , (f ◃h glue ▹h (_, c)) ∙h p)

  RelativeSusp-Coslice-UP
    : is-fibrewise-equiv RelativeSusp-Coslice-UP→
  RelativeSusp-Coslice-UP i
    = is-equiv←~
        H
        (eqv i ._≃_.fwd-is-equiv)
    where

    eqv : (i : X → A) → (Coslice-map (RelativeSusp-ι δ) i) ≃ (C → Ext δ i)
    eqv i
      = fibre-straighten (λ f → C → Ext δ f) i
      ∘e Slice-fibre≃ (RelativeSusp-Slice-UP δ) i
      ∘e (fibre-RelativeSusp-underlying δ i) e⁻¹

    opaque
      H : RelativeSusp-Coslice-UP→ i ~ eqv i ._≃_.fwd
      H (f , p)
        = funext-J
            (λ i' p' → RelativeSusp-Coslice-UP→ i' (f , p') ＝ eqv i' ._≃_.fwd (f , p'))
            (sym
              ( ap
                  (λ p → tr (λ f' → C → Ext δ f') p (RelativeSusp-restrict δ f .snd))
                  funext-refl
              ∙ funext→ (λ c → Id←Ext-htpy (~refl , (∙h-reflr _ h⁻¹)))))
            i p

  RelativeSusp-Coslice-UP≃
    : (i : X → A) → Coslice-map (RelativeSusp-ι δ {C}) i ≃ (C → Ext δ i)
  RelativeSusp-Coslice-UP≃ i
    = mk≃ (RelativeSusp-Coslice-UP→ i) (RelativeSusp-Coslice-UP i)
}
}

\subtree[tot-96CQ]{
\title{The pointed universal property of relative suspension at a point}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-23}

\p{For pointed types #{X} and #{Y}, a pointed map #{\Susp_x C \to Y} is equivalent
to a map #{C \times X \to Y} which restricts to the constant map at #{y} on #{x}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} (x : X) where
  RelativeSusp∙ : ∀ {𝓥} (C : Type 𝓥) → RelativeSusp (point x) C
  RelativeSusp∙ _ = ι₂ tt

  RelativeSusp∗ : ∀ {𝓥} → Type 𝓥 → Type∗ (𝓤 ⊔ 𝓥)
  RelativeSusp∗ C .Type∗.carrier = RelativeSusp (point x) C
  RelativeSusp∗ C .Type∗.pt = RelativeSusp∙ C

  Ext-point : ∀ {𝓥} → Type∗ 𝓥 → Type (𝓤 ⊔ 𝓥)
  Ext-point (mk-type∗ C c) = Ext (point x) (point c)

  Ext-point₁
    : ∀ {𝓤 𝓥} {A : Type∗ 𝓤} {B : Type∗ 𝓥}
      → map∗ A B
      → (Ext-point A → Ext-point B)
  Ext-point₁ f
    = map-Σ
        (postcomp X (f .map∗.hom))
        (λ g → postcomp-Π (λ _ → (_∙ f .map∗.pres-pt) ∘ ap (f .map∗.hom)))

  Susp⊣Ext-ε : ∀ {𝓥} {C : Type∗ 𝓥} → map∗ (RelativeSusp∗ (Ext-point C)) C
  Susp⊣Ext-ε {C = C} .map∗.hom
    = RelativeSusp-rec (point x) (point (C .Type∗.pt) , id)
  Susp⊣Ext-ε .map∗.pres-pt = refl

  Susp⊣Ext-η : ∀ {𝓥} {C : Type 𝓥} → C → Ext-point (RelativeSusp∗ C)
  Susp⊣Ext-η c .fst x = ι₁ (x , c)
  Susp⊣Ext-η c .snd t = glue (t , c)

  RelativeSusp∗₁
    : ∀ {𝓥 𝓦} {C : Type 𝓥} {D : Type 𝓦}
      → (C → D)
      → map∗ (RelativeSusp∗ C) (RelativeSusp∗ D)
  RelativeSusp∗₁ f .map∗.hom
    = RelativeSusp-rec (point x) (point (RelativeSusp∙ _) , Susp⊣Ext-η ∘ f)
  RelativeSusp∗₁ f .map∗.pres-pt = refl

  Susp⊣Ext→
    : ∀ {𝓥 𝓦} {C : Type 𝓥} {Q : Type∗ 𝓦}
      → map∗ (RelativeSusp∗ C) Q → (C → Ext-point Q)
  Susp⊣Ext→ {C = C} {Q} = precomp _ (Susp⊣Ext-η {C = C}) ∘ Ext-point₁ {B = Q}

  private
    lemma
      : ∀ {𝓥 𝓦} {C : Type 𝓥} {Q : Type∗ 𝓦}
        → Susp⊣Ext→ {C = C} {Q}
        ~ RelativeSusp-Coslice-UP→ (point x) (point (Q .Type∗.pt)) ∘ Coslice-map←map∗
    lemma = ~refl

  Susp⊣Ext
    : ∀ {𝓥 𝓦} {C : Type 𝓥} {Q : Type∗ 𝓦}
      → map∗ (RelativeSusp∗ C) Q ≃ (C → Ext-point Q)
  Susp⊣Ext {Q = Q}
    = RelativeSusp-Coslice-UP≃ (point x) (point (Q .Type∗.pt))
    ∘e Coslice-map≃map∗ e⁻¹
}
}

