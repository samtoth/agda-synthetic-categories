\subtree[bak-19CB]{
\title{Covariant transport}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-11-04}

\p{
We say a type family #{P \colon A \to \UU} admits \em{covariant transport} if there
is a transport function #{(\blank)_* \colon \hom_A(x,y) \to P(x) \to P(y)} for all
#{x} and #{y} in #{A}. If this transport function satisfies #{\id_* \sim \id}, then
we say the transport is \em{unital}.
}

\agda{
Covariant-transport
  : ∀ {𝓤 𝓥} {A : Δ¹ → Type 𝓤} (B : {i : Δ¹} → A i → Type 𝓥) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
Covariant-transport {A = A} B = {x : A i0} {y : A i1} → Homᵈ A x y → B x → B y

Covariant-unital-transport
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
Covariant-unital-transport {A = A} B
  = Σ[ ρ ∶ Covariant-transport B ] ((x : A) → ρ (idH x) ~ id)
}
}

\subtree[bak-FEFF]{
\title{Covariant lifts}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-11-05}

\p{
Let #{P \colon A \to \UV} be a type family, then #{P} has \em{covariant lifts} if for
every arrow #{h \colon Δ¹ \to A} and #{x : P(h(0))} there is an arrow in #{P} over
#{h} with left endpoint #{x}.
}

\agda{
Covariant-lifts
  : ∀ {𝓤 𝓥} {A : Δ¹ → Type 𝓤} (P : {i : Δ¹} → A i → Type 𝓥) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
Covariant-lifts {A = A} P
  = (h : (i : Δ¹) → A i) (x : P (h i0))
  → Σ[ y ∶ P (h i1) ] Homᵈ (P ∘ h) x y
}
}

\subtree[bak-F367]{
\title{Covariant lifts gives covariant transport}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-05}

\agda{
module _ {𝓤 𝓥} {A : Δ¹ → Type 𝓤} {B : {i : Δ¹} → A i → Type 𝓥} where

  cov-transport←lifts : Covariant-lifts (λ {i} → B {i}) → Covariant-transport B
  cov-transport←lifts lift-B (mk-hom h refl refl) = fst ∘ lift-B h
}
}

\subtree[bak-4CAE]{
\title{Fibres of evaluation at #{0} as covariant lifts}
\taxon{Lemma}
\author{fredrikbakke}
\contributor{samueltoth}
\date{2026-11-04}

\p{
Let #{P \colon A \to \UV} be a type family, #{h \colon Δ¹ \to A} an arrow, and
#{x : P(h(0))}. Then the type of lifts of #{h} with left endpoint #{x} is equivalent
to the fibre over #{x} of evaluation at #{0}.
}

\agda{
module _ {𝓤 𝓥} {A : Δ¹ → Type 𝓤} (P : {i : Δ¹} → A i → Type 𝓥) where

  cov-lift≃fibre-ev-i0
    : (h : (i : Δ¹) → A i) (x : P (h i0))
    → (Σ[ y ∶ P (h i1) ] Homᵈ (P ∘ h) x y) ≃ fibre (evᵈ: (P ∘ h) i0) x
  cov-lift≃fibre-ev-i0 h x
    =  (Σ[ y ∶ P (h i1) ] Homᵈ (P ∘ h) x y)
    ≃⟨ Σ-snd-≃ (λ y → Homᵈ-repr≃) ⟩
       (Σ[ y ∶ P (h i1) ] Σ[ f ∶ Π Δ¹ (P ∘ h) ] ((f i0 ＝ x) × (f i1 ＝ y)))
    ≃⟨ Σ-comm ∙e Σ-snd-≃ (λ f → Σ-comm) ⟩
       (Σ[ f ∶ Π Δ¹ (P ∘ h) ] ((f i0 ＝ x) × Σ[ y ∶ P (h i1) ] (f i1 ＝ y)))
    ≃⟨ Σ-snd-≃ (λ f → Σ-singleton (λ _ → Sing-is-singleton)) ⟩
       fibre (evᵈ: (P ∘ h) i0) x
    ≃∎

  Covariant-lifts≃sections-ev-i0
    : Covariant-lifts P ≃ ((h : (i : Δ¹) → A i) → section (evᵈ: (P ∘ h) i0))
  Covariant-lifts≃sections-ev-i0
    = postcomp-Π-≃ (λ h
        →  postcomp-Π-≃ (cov-lift≃fibre-ev-i0 h)
        ∙e section≃fibres (ev i0))
}
}

\subtree[fre-015U]{
\title{Transport from covariant lifts is co-strict}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Transport obtained from [covariant lifts](bak-4CAE) is [co-strict](stt-015V). If
#{0 = 1} it coincides with ordinary transport, which is an equivalence.
}

\agda{
module _
  {𝓤 𝓥} {A : Δ¹ → Type 𝓤} {P : {i : Δ¹} → A i → Type 𝓥} (lift-P : Covariant-lifts P)
  where

  opaque -- TODO: also add tr-covˢ and tr-cov-homˢ version of this one
    cov-transport-is-co-strict←lifts
      : {x : A i0} {y : A i1} (h : Homᵈ A x y)
      → is-co-strict-map (cov-transport←lifts {B = P} lift-P h)
    cov-transport-is-co-strict←lifts (mk-hom h refl refl)
      = is-co-strict-map←is-equiv-under-0＝1 (λ p
        → is-equiv←~⁻¹
            ( λ x
              → let lift = lift-P h x .snd
                in ap (tr (P ∘ h) p) (sym (lift .Homᵈ.hom0))
                 ∙ apᶠ (lift .Homᵈ.hom) p
                 ∙ lift .Homᵈ.hom1)
            ( tr-is-equiv p))
}
}

\subtree[bak-00K3]{ % TODO: generalise to covariant transport/lifts
\title{Covariant transport along inequalities in #{Δ¹}}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-05}

\p{Each #{i \le j} in #{\Delta^1} induces a morphism #{\Hom_{\Delta^1}(i,j)}.
consequently, for covariant families over #{\Delta^1}, we may coerce along
#{i \le j}. Since #{i \le j} is a proposition, we have the coercing along
#{i \le i} for any #{i} is the identity and coercing along #{0 \le 1} is the
same as covariant transport over the canonical morphisms from #{0} to #{1} given
by #{\id \colon \Delta^1 \to \Delta^1}.}

\agda{
