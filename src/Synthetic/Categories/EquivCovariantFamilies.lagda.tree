\title{Detecting equivalences between covariant type families}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

import Synthetic.Cubes

module Synthetic.Categories.EquivCovariantFamilies
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (open Synthetic.Cubes Δ¹ i0 i1)
  where

import Algebra.Lattice.Instances.Polynomial as Poly
open Poly hiding (Δ²)
private Δ² = Poly.Δ² I
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.Connectivity
open import Modalities.Cohesion.Continuity
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.LiftingSquares

open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.Instances.Truncation
open import Modalities.ConnectedMaps

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.ArrowRetracts
open import Core.Orthogonal
open import Core.OrthogonalClosure

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Horns Δ¹ I
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Triangles Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
}
}

\subtree[stt-00V6]{
\title{The point inclusion of #{0} into the #{n}-cube is left anodyne}
\taxon{Lemma}

\agda{
□-0-is-left-anodyne : ∀ {m : ℕ} → is-left-anodyne (point (□-0 {m}))
□-0-is-left-anodyne {zero} r _ = equiv⊥ lift-is-equiv r
□-0-is-left-anodyne {suc zero} r 0r = 0r
□-0-is-left-anodyne {suc (suc m)}
  = is-anodyne←equiv
      (point □-0 ×₁ point i0) (point □-0)
      (mk-arr-equiv (sing≃𝟙 single!) id≃ ~refl)
      (point i0)
      (λ r 0r → left-orthogonal-× (point □-0) (point i0) r
        (□-0-is-left-anodyne {suc m} r 0r) 0r)
}
}

\agda{
retract-sq
  : Arrow-map (Δ²-point-incl) (∂Δ¹-incl ×₁ ∂Δ¹-incl)
retract-sq .Arrow-Π.top fzero = (∂Δ¹-0 , ∂Δ¹-0)
retract-sq .Arrow-Π.top (fsuc fzero) = (∂Δ¹-1 , ∂Δ¹-0)
retract-sq .Arrow-Π.top (fsuc (fsuc fzero)) = (∂Δ¹-1 , ∂Δ¹-1)
retract-sq .Arrow-Π.bot = Δ²-retract-Δ¹×Δ¹ .fst
retract-sq .Arrow-Π.comm fzero = refl
retract-sq .Arrow-Π.comm (fsuc fzero) = refl
retract-sq .Arrow-Π.comm (fsuc (fsuc fzero)) = refl

retract-sq-is-retr
  : retraction-arrow-map retract-sq
retract-sq-is-retr .fst .Arrow-Π.top (∂Δ¹-1 , ∂Δ¹-1) = 2
retract-sq-is-retr .fst .Arrow-Π.top (∂Δ¹-1 , ∂Δ¹-0) = 1
retract-sq-is-retr .fst .Arrow-Π.top (∂Δ¹-0 , ∂Δ¹-1) = 2
retract-sq-is-retr .fst .Arrow-Π.top (∂Δ¹-0 , ∂Δ¹-0) = 0
retract-sq-is-retr .fst .Arrow-Π.bot = Δ²-retract-Δ¹×Δ¹ .snd .fst
retract-sq-is-retr .fst .Arrow-Π.comm (∂Δ¹-1 , ∂Δ¹-1) = Δ²-ext (1-coinit  , refl)
retract-sq-is-retr .fst .Arrow-Π.comm (∂Δ¹-1 , ∂Δ¹-0) = Δ²-ext (1-coinit' , refl)
retract-sq-is-retr .fst .Arrow-Π.comm (∂Δ¹-0 , ∂Δ¹-1) = Δ²-ext (1-coinit  , refl)
retract-sq-is-retr .fst .Arrow-Π.comm (∂Δ¹-0 , ∂Δ¹-0) = Δ²-ext (0-bottom  , refl)
retract-sq-is-retr .snd .fst fzero = refl
retract-sq-is-retr .snd .fst (fsuc fzero) = refl
retract-sq-is-retr .snd .fst (fsuc (fsuc fzero)) = refl
retract-sq-is-retr .snd .snd .fst = Δ²-retract-Δ¹×Δ¹ .snd .snd
retract-sq-is-retr .snd .snd .snd _ = Δ²-is-set _ _ _ _

♭-retraction-witness
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      {@♭ f : A → B} {@♭ g : B → A}
    → @♭ (retraction-witness g f)
    → retraction-witness (♭-map g) (♭-map f)
♭-retraction-witness ret (mod♭ x) = mapply♭ (mod♭ (ret x))

♭-retraction-arrow-map
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
      {@♭ X : Type 𝓦} {@♭ Y : Type 𝓜} {@♭ g : X → Y}
      (@♭ F : Arrow-map f g)
    → @♭ retraction-arrow-map F
    → retraction-arrow-map (♭Square F)
♭-retraction-arrow-map F (G , r) .fst = ♭Square G
♭-retraction-arrow-map F (G , r) .snd .fst = ♭-retraction-witness (r .fst)
♭-retraction-arrow-map F (G , r) .snd .snd .fst
  = ♭-retraction-witness (r .snd .fst)
♭-retraction-arrow-map F (G , r) .snd .snd .snd (mod♭ x)
  = {!!} ∙ ap♭ (λ x → mapply♭ (mod♭ x)) (r .snd .snd x)

is-♭-connected
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} (@♭ f : A → B) → Type (𝓤 ⊔ 𝓥)
is-♭-connected f = is-connected-map (Truncation-gRSubU -1) (♭-map f)

is-♭-connected←retraction-arrow-map
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      {@♭ C : Type 𝓦} {@♭ D : Type 𝓜}
      {@♭ f : A → B} {@♭ g : C → D}
    → (@♭ F : Arrow-map f g)
    → @♭ retraction-arrow-map F
    → is-♭-connected g
    → is-♭-connected f
is-♭-connected←retraction-arrow-map F Fr gc
  = is-connected-map←up-connected-map _
      (up-connected-map←retraction-arrow-map
        (Truncation-gSubU -1)
        (♭Square F)
        (♭-retraction-arrow-map F Fr)
        (up-connected-map←is-connected-map _ gc))
  where
  open gRSubUConnectedCharacterisation (Truncation-gRSubU -1)

×₁-is-♭-connected
  : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
      {@♭ X : Type 𝓦} {@♭ Y : Type 𝓜} {@♭ g : X → Y}
    → is-♭-connected f → is-♭-connected g
    → is-♭-connected (f ×₁ g)
×₁-is-♭-connected {f = f} {g = g} fc gc
  = is-connected-map←is-arrow-equiv⁻¹
      (Truncation-gRSubU -1) Truncation-Σ-closed
      (♭-×₁ f g .fst) (♭-×₁ f g .snd)
      (is-connected-map←up-connected-map (♭-map f ×₁ ♭-map g)
        (×₁-up-connected-map (Truncation-gSubU -1)
          (up-connected-map←is-connected-map (♭-map f) fc)
          (up-connected-map←is-connected-map (♭-map g) gc)))
  where
  open gRSubUConnectedCharacterisation (Truncation-gRSubU -1)

♭-up-connected-map
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} (@♭ f : A → B) → Typeω
♭-up-connected-map {A = A} {B} f
  = ∀ {𝓤} (P : @♭ B → Prop 𝓤)
    → (∀ (@♭ x : A) → P (f x) .fst)
    → (∀ (@♭ x : B) → P x .fst)

♭-up-connected-map←up-♭-connected-map
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
    → up-connected-map (Truncation-gSubU -1) (♭-map f)
    → ♭-up-connected-map f
♭-up-connected-map←up-♭-connected-map up P pf x
  = is-equiv.bwd
      (up
        {U = ♭-ind λ x → P x .fst}
        (♭-ind λ x → is-truncated←is-prop ((P x) .snd)))
        (♭-ind pf)
        (mod♭ x)
}

\subtree[stt-00UT]{
\taxon{Corollary}

\p{As a special case of \ref{stt-00V7}, we note the following.
If [cubes separate](stt-00J7) and crisp elements of #{\Delta^1} are covered by the booleans,
then a crisp transformation between covariant crisp type families #{F, G} over
#{B \times \Delta} is a fibrewise equivalence iff it is a flat equivalence at
#{(b , 0)} and #{(b, 1)} for crisp elements #{b : B}.}

\agda{
module _
  (@♭ cubes-separate : family-separates □^_)
  (@♭ ∂Δ¹-♭-connected : is-♭-connected ∂Δ¹-incl)
  (open gRSubUConnectedCharacterisation (Truncation-gRSubU -1))
  where
  ∂Δ¹-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ¹ → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : ∂Δ¹) → is-♭-equiv (α (b , ∂Δ¹-incl x)))
      → is-fibrewise-equiv α
  ∂Δ¹-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-family-separates
        (point i0)
        □^_
        (cubes-separate) □-0 □-0-is-left-anodyne
        (F .fst , is-left-family←is-covariant (F .fst) (F .snd))
        (G .fst , is-left-family←is-covariant (G .fst) (G .snd))
        α
        (λ {(b , i)
         → ♭-up-connected-map←up-♭-connected-map
             (up-connected-map←is-connected-map _ ∂Δ¹-♭-connected)
             ((λ x
               → ( is-♭-equiv (α (b , x)))
                 , is-equiv-is-prop))
             (αeq b)
             i})
}

\p{We may also consider the analogous result for the 2-simplex, but this time
assuming that the 3 element type covers the crisp elements of #{Δ²} as well as that
cubes separate. Note that this assumption should follow from the covering of the 1-simplex,
however this is yet to be formalised
([issue #258](https://github.com/samtoth/agda-synthetic-categories/issues/258)).}

\agda{
module _
  (@♭ cubes-separate : family-separates □^_)
  (@♭ ∂Δ¹-♭-connected : is-♭-connected ∂Δ¹-incl)
  (let @♭ Δ²-points-♭-connected
            = is-♭-connected←retraction-arrow-map
                retract-sq
                retract-sq-is-retr
                (×₁-is-♭-connected ∂Δ¹-♭-connected ∂Δ¹-♭-connected))
  (open gRSubUConnectedCharacterisation (Truncation-gRSubU -1))
  where

  points-Δ²-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ² → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : Fin 3) → is-♭-equiv (α (b , Δ²-point-incl x)))
      → is-fibrewise-equiv α
  points-Δ²-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-family-separates
        (point i0)
        □^_
        (cubes-separate) □-0 □-0-is-left-anodyne
        (F .fst , is-left-family↔is-covariant (F .fst) .snd (F .snd))
        (G .fst , is-left-family↔is-covariant (G .fst) .snd (G .snd))
        α
        (λ {(b , i)
         → ♭-up-connected-map←up-♭-connected-map
             (up-connected-map←is-connected-map _ Δ²-points-♭-connected)
             (λ x → (is-♭-equiv (α (b , x)) , is-equiv-is-prop))
             (αeq b)
             i})
}
}
