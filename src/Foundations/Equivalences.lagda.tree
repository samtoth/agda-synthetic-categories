\date{2025-02-22}
\title{Coherent Equivalences}
\taxon{Module}

\import{stt-macros}

\agda{
module Foundations.Equivalences where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.QuasiEquivalences
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.FunctionInverses
open import Foundations.Homotopy
open import Foundations.Identity
open import Foundations.IdentityReasoning
}
}

\p{
We can upgrade a [quasi-equivalence](Foundations.QuasiEquivalences) into a
homotopy-correct equivalence by adding an extra coherence condition, that makes being
an equivalence into a proposition.
}

\subtree[stt-000K]{
\taxon{Remark}
\title{Half-adjoint equivalence}

\p{The definition of a quasi-equivalence involves:}

\ul{
\li{#{f : A \to B}}
\li{#{g : B \to A}}
\li{#{\eta : f \circ g = \id}}
\li{#{\varepsilon : \id = g \circ f}}
}

\p{The names #{\eta} and #{\varepsilon} remind us that this looks like the data of an adjunction. But we are missing the laws, often called the zig-zag laws. One of which state that the following 2-cell contracts to the identity:
}

\quiver{
% https://q.uiver.app/#
\begin{tikzcd}
	A &&&& A \\
	\\
	&& B &&&& B
	\arrow[""{name=0, anchor=center, inner sep=0}, no head, from=1-1, to=1-5]
	\arrow["\id", shift left, no head, from=1-1, to=1-5]
	\arrow["f"', from=1-1, to=3-3]
	\arrow["f"', from=1-5, to=3-7]
	\arrow["g"', from=3-3, to=1-5]
	\arrow[""{name=1, anchor=center, inner sep=0}, "\id"', no head, from=3-3, to=3-7]
	\arrow[shift left, no head, from=3-3, to=3-7]
	\arrow["\varepsilon", shorten <=7pt, shorten >=11pt, Rightarrow, from=0, to=3-3]
	\arrow["\eta", shorten <=7pt, shorten >=7pt, Rightarrow, from=1-5, to=1]
\end{tikzcd}
}

\p{In symbols, this is: #{f \cdot \varepsilon \circ \eta \cdot f = \id}, where
#{\cdot} denotes horizontal composition and #{\circ} denotes vertical composition.}
}

\p{Note that in our formalisation #{\varepsilon} is a 2-cell in the opposite direction, but since all 2-cells are invertible, this makes no difference to the definition and makes the formalisation slightly smoother.}

\subtree[stt-001R]{
\taxon{Definition}
\title{Coherence data for [quasi-equivalences](Foundations.QuasiEquivalences)}

\agda{
qinv-coh : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} → quasi-inv f → Type (𝓤 ⊔ 𝓥)
qinv-coh {f = f} (g , ε , η) = f ◂h ε ~ η ▸h f
}
}

\subtree[stt-001U]{
\taxon{Definition}
\title{Equivalences}


\p{Of the many equivalent notions of equivalences in HoTT, we will single out coherent equivalences as the default one in the library.}

\agda{
record is-equiv {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B) : Type (𝓤 ⊔ 𝓥) where
  constructor mk-eqv
  field
    qinv     : quasi-inv f
    coherent : qinv-coh qinv

  qeqv : A ≊ B
  qeqv = mk≊ f qinv

  open _≊_ qeqv public hiding (fwd)

  ε : f ∘ bwd ~ id
  ε x = section-fwd .snd x

  ε⁻¹ : id ~ f ∘ bwd
  ε⁻¹ = ε h⁻¹

  η : bwd ∘ f ~ id
  η x = retraction-fwd .snd x

  η⁻¹ : id ~ bwd ∘ f
  η⁻¹ = η h⁻¹

  coh⁻¹ :  (f ◂h η⁻¹) ~ (ε⁻¹ ▸h f)
  coh⁻¹ a = ap-sym f (η a) ∙ ap sym (coherent a)

  swizzle-bwd
    : ∀ {𝓦} {C : Type 𝓦}
        (g : C → B) (h : C → A)
      → g ~ f ∘ h → bwd ∘ g ~ h
  swizzle-bwd g h K = bwd ◂h K ∙h η ▸h h
}

\p{We also define the packaged version of an equivalence together with the proof of it being an equivalence}

\agda{
infix 6 _≃_
record _≃_ {𝓤 𝓥} (A : Type 𝓤) (B : Type 𝓥) : Type (𝓤 ⊔ 𝓥) where
  constructor mk≃
  field
    fwd : A → B
    fwd-is-equiv : is-equiv fwd

  open is-equiv fwd-is-equiv public

qinv←is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} → is-equiv f → quasi-inv f
qinv←is-equiv = is-equiv.qinv

qeqv←equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → A ≃ B → A ≊ B
qeqv←equiv (mk≃ _ fwd-is-equiv) = qeqv where open is-equiv fwd-is-equiv
}
}


\subtree[stt-000J]{
\taxon{Theorem}
\title{Quasi-equivalences can be made coherent}
% HoTT book. 4.2.3

\p{Every quasi-equivalence can be upgraded to a coherent equivalence.}

\proof{
\p{Since we (are soon to) know that being an equivalence is a proposition, and that quasi-equivalences aren't equivalent to equivalences,
we know that whatever the map is, it cannot be a section of the obvious map #{\textrm{is-equiv}(f) \to \textrm{quasi-inv}(f)}, and so as a
result we know we will have to be a bit clever about how we choose the 2-cells of our coherent equivalence.}

\p{The proof goes through by cooking up a 2-cell #{\varepsilon} that makes the coherence go through trivially.
Working backwards, we need an #{\varepsilon '} such that #{\varepsilon' f = \eta f}. }


\quiver{
% https://q.uiver.app/#
\begin{tikzcd}
	fgf &&&&&& f \\
	&&&& fgf \\
	& fgfgf \\
	&&&&& fgf
	\arrow["{f\eta}", from=1-1, to=1-7]
	\arrow[""{name=0, anchor=center, inner sep=0}, equals, from=1-1, to=2-5]
	\arrow["{\varepsilon^{-1} fgf}"', from=1-1, to=3-2]
	\arrow["{f\eta}"', from=2-5, to=1-7]
	\arrow["{\varepsilon fgf}", from=3-2, to=2-5]
	\arrow[""{name=1, anchor=center, inner sep=0}, "{fgf \eta}", from=3-2, to=4-6]
	\arrow[""{name=2, anchor=center, inner sep=0}, "{f\eta gf}"', bend right,from=3-2, to=4-6]
	\arrow["{\varepsilon f}"', bend right, from=4-6, to=1-7]
	\arrow["2", shorten <=11pt, shorten >=8pt, Rightarrow, from=4-6, to=2-5]
	\arrow["1"', shorten <=11pt, shorten >=11pt, Rightarrow, from=3-2, to=0]
	\arrow["3"', shorten <=2pt, shorten >=2pt, Rightarrow, from=2, to=1]
\end{tikzcd}
}


\p{
Consider the above diagram, and in particular note that the lower boundary is given by morphisms of the form #{\alpha f} for some alpha.
By taking the horizontal composition of these #{\alpha}'s gives us our desired #{\epsilon' := \varepsilon^{-1} fg \cdot f \eta g \cdot \varepsilon}. It satisfies the necessary equations by the vertical composite of the cells:
}

\ol{
\li{Trivially follows from paths forming groupoids.}
\li{The naturality of homotopies.}
\li{\citet{2.4.3}{HoTT} [[stt-001O]]}
}

\agda{
is-equiv←qinv : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} → quasi-inv f → is-equiv f
is-equiv←qinv {f = f} (g , η , ε) = mk-eqv (g , η , ε') coh where opaque
  ε' : f ∘ g ~ id
  ε' = (ε h⁻¹) ▸h f ▸h g ∙h
      f ◂h η ▸h g       ∙h
      ε

  lem3 : g ◂h f ◂h η ~ η ▸h g ▸h f
  lem3 x = sym (ap-∘ g f (η x)) ∙ n where
    n : ((g ∘ f) ◂h η) x ＝ (η ▸h g ▸h f) x
    n = sym (homotopy-inverse (g ∘ f) η x)

  lem2 : ε ▸h f ▸h g ▸h f ∙h f ◂h η ~ f ◂h g ◂h f ◂h η ∙h ε ▸h f
  lem2 x = I ∙ ap (_∙ (ε (f x))) (ap-∘ f g (ap f (η x))) where
    I : ε (f (g (f x))) ∙ (ap f (η x)) ＝
         ap (λ z → (f ∘ g) z) (ap f (η x)) ∙ ε (f x)
    I = ap (ε (f (g (f x))) ∙_) (sym (ap-id (ap f (η x)))) ∙
        homotopy-natural ε {f (g (f x))} (ap f (η x))

  lem1 : f ◂h η ~
           (((ε ▸h f ▸h g ▸h f) h⁻¹) ∙h ε ▸h f ▸h g ▸h f ∙h f ◂h η)
  lem1 a = ∙.insertr _ {h = ε (f (g (f a)))} {i = sym (ε (f (g (f a))))} (∙-sym' (ε (f (g (f a))))) {_} {ap f (η a)}

  coh : qinv-coh (g , η , ε')
  coh
    = (f ◂h η)
        ~⟨ lem1 ⟩
      ((ε ▸h f ▸h g ▸h f) h⁻¹) ∙h ε ▸h f ▸h g ▸h f ∙h f ◂h η
        ~⟨ ~refl: ((ε ▸h f ▸h g ▸h f) h⁻¹) ⟩∙h⟨ lem2 ⟩
      ((ε ▸h f ▸h g ▸h f) h⁻¹) ∙h (f ◂h g ◂h f ◂h η) ∙h ε ▸h f
        ~⟨ (~refl: ((ε ▸h f ▸h g ▸h f) h⁻¹)) ⟩∙h⟨ (f ⟩◂h⟨ lem3) ⟩∙h⟨ ~refl: (ε ▸h f) ⟩
      ((ε ▸h f ▸h g ▸h f) h⁻¹) ∙h f ◂h (η ▸h g ▸h f) ∙h ε ▸h f
        ~⟨⟩
        ε' ▸h f
        ~∎

equiv←qequiv : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → A ≊ B → A ≃ B
equiv←qequiv (mk≊ fwd fwd-qinv) = mk≃ fwd (is-equiv←qinv fwd-qinv)

≃-rep≊  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A ≃ B) ≊ Σ (A → B) is-equiv
≃-rep≊ ._≊_.fwd (mk≃ f e) = f , e
≃-rep≊ ._≊_.fwd-qinv .fst (f , e) = mk≃ f e
≃-rep≊ ._≊_.fwd-qinv .snd .fst _ = refl
≃-rep≊ ._≊_.fwd-qinv .snd .snd _ = refl

≃-rep : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → (A ≃ B) ≃ Σ (A → B) is-equiv
≃-rep = equiv←qequiv ≃-rep≊
}
}
}

\subtree[stt-005T]{
\date{2025-06-19}
\title{Assuming the codomain to construct an equivalence}
\taxon{Proposition}
  \p{To show that a function is an equivalence,
  it suffices show that it is an equivalence assuming a point
  in the codomain.}

\agda{
is-equiv←is-equiv-if-cod
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : Type 𝓥}
      {f : A → B}
    → (B → is-equiv f)
    → is-equiv f
is-equiv←is-equiv-if-cod {f = f} feqb
  = is-equiv←qinv
      ( (λ b → bwd (feqb b) b)
      , (λ a → η (feqb (f a)) a)
      , λ b → ε (feqb b) b)
    where open is-equiv
}
}

\subtree[stt-00R6]{
\date{2026-05-27}
\title{Injective maps with sections are equivalences}
\taxon{Proposition}
\author{fredrikbakke}

\agda{
is-equiv←section←injective
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → ({x y : A} → f x ＝ f y → x ＝ y)
    → section f
    → is-equiv f
is-equiv←section←injective {f = f} I (g , ε)
  = is-equiv←qinv (g , I ∘ ε ∘ f , ε)
}
}

\subtree[stt-001T]{
\title{Equivalences form an #{∞}-groupoid over types}
\author{samueltoth}
\author{fredrikbakke}
\date{2026-04-23}

\p{
We show that equivalence forms a reflexive, transitive and symmetric relation on
types. More concretely, we show the identity map is an equivalence, that equivalences
compose, and that equivalences may be inverted. We construct each explicitly to
maintain control over the section and retraction homotopies.
}

\agda{
id-is-equiv : ∀ {𝓤} {A : Type 𝓤} → is-equiv (id: A)
id-is-equiv = mk-eqv (id , ~refl , ~refl) ~refl

id≃ : ∀ {𝓤} {A : Type 𝓤} → A ≃ A
id≃ = mk≃ id id-is-equiv

id≃: : ∀ {𝓤} (A : Type 𝓤) → A ≃ A
id≃: A = id≃
}

\agda{
is-equiv-∘-qinv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : B → C} {g : A → B}
    → is-equiv f → is-equiv g
    → quasi-inv (f ∘ g)
is-equiv-∘-qinv {f = f} {g} fe ge .fst
  = is-equiv.bwd ge ∘ is-equiv.bwd fe
is-equiv-∘-qinv {f = f} {g} fe ge .snd .fst
  = is-equiv.bwd ge ◂h is-equiv.η fe ▸h g ∙h is-equiv.η ge
is-equiv-∘-qinv {f = f} {g} fe ge .snd .snd
  = f ◂h is-equiv.ε ge ▸h is-equiv.bwd fe ∙h is-equiv.ε fe

opaque
  is-equiv-∘-coh
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
        {f : B → C} {g : A → B}
        (fe : is-equiv f) (ge : is-equiv g)
      → qinv-coh (is-equiv-∘-qinv fe ge)
  is-equiv-∘-coh {f = f} {g} fe ge = coh where
    module ef = is-equiv fe
    module eg = is-equiv ge

    ret : eg.bwd ∘ ef.bwd ∘ f ∘ g ~ id
    ret = is-equiv-∘-qinv fe ge .snd .fst

    sec : f ∘ g ∘ eg.bwd ∘ ef.bwd ~ id
    sec = is-equiv-∘-qinv fe ge .snd .snd

    coh₁
      : ∀ a
        → ap (f ∘ g) (ret a)
        ＝ ap f (ap (g ∘ eg.bwd) (ef.η (g a)) ∙ eg.ε (g a))
    coh₁ a
      = ap (f ∘ g) (ret a)
          ＝⟨ ap-∙ (f ∘ g) (ap eg.bwd (ef.η (g a))) (eg.η a) ⟩
        ap (f ∘ g) (ap eg.bwd (ef.η (g a))) ∙ ap (f ∘ g) (eg.η a)
          ＝⟨ ap (_∙ ap (f ∘ g) (eg.η a)) (ap-∘ f g (ap eg.bwd (ef.η (g a)))) ⟩
        ap f (ap g (ap eg.bwd (ef.η (g a)))) ∙ ap (f ∘ g) (eg.η a)
          ＝⟨ ap (_∙ ap (f ∘ g) (eg.η a)) (ap (ap f) (sym (ap-∘ g eg.bwd (ef.η (g a))))) ⟩
        ap f (ap (g ∘ eg.bwd) (ef.η (g a))) ∙ ap (f ∘ g) (eg.η a)
          ＝⟨ ap (ap f (ap (g ∘ eg.bwd) (ef.η (g a))) ∙_) (ap-∘ f g (eg.η a)) ⟩
        ap f (ap (g ∘ eg.bwd) (ef.η (g a))) ∙ ap f (ap g (eg.η a))
          ＝⟨ ap (ap f (ap (g ∘ eg.bwd) (ef.η (g a))) ∙_) (ap (ap f) (eg.coherent a)) ⟩
        ap f (ap (g ∘ eg.bwd) (ef.η (g a))) ∙ ap f (eg.ε (g a))
          ＝⟨ sym (ap-∙ f (ap (g ∘ eg.bwd) (ef.η (g a))) (eg.ε (g a))) ⟩
        ap f (ap (g ∘ eg.bwd) (ef.η (g a)) ∙ eg.ε (g a))
          ∎

    coh₂
      : ∀ a
        → ap f (ap (g ∘ eg.bwd) (ef.η (g a)) ∙ eg.ε (g a))
        ＝ ap f (eg.ε (ef.bwd (f (g a)))) ∙ ap f (ef.η (g a))
    coh₂ a
      = ap f (ap (g ∘ eg.bwd) (ef.η (g a)) ∙ eg.ε (g a))
          ＝⟨ ap (ap f)
               ( sym (homotopy-natural eg.ε (ef.η (g a)))
               ∙ ap (eg.ε (ef.bwd (f (g a))) ∙_) (ap-id (ef.η (g a)))) ⟩
        ap f (eg.ε (ef.bwd (f (g a))) ∙ ef.η (g a))
          ＝⟨ ap-∙ f (eg.ε (ef.bwd (f (g a)))) (ef.η (g a)) ⟩
        ap f (eg.ε (ef.bwd (f (g a)))) ∙ ap f (ef.η (g a))
          ∎

    coh₃
      : ∀ a
        → ap f (eg.ε (ef.bwd (f (g a)))) ∙ ap f (ef.η (g a))
        ＝ sec (f (g a))
    coh₃ a
      = ap f (eg.ε (ef.bwd (f (g a)))) ∙ ap f (ef.η (g a))
          ＝⟨ ap (ap f (eg.ε (ef.bwd (f (g a)))) ∙_) (ef.coherent (g a)) ⟩
        ap f (eg.ε (ef.bwd (f (g a)))) ∙ ef.ε (f (g a))
          ＝⟨⟩
        sec (f (g a))
          ∎

    coh : qinv-coh (is-equiv-∘-qinv fe ge)
    coh a = coh₁ a ∙ coh₂ a ∙ coh₃ a

is-equiv-∘
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
      {f : B → C} {g : A → B}
    → is-equiv f → is-equiv g
    → is-equiv (f ∘ g)
is-equiv-∘ fe ge = mk-eqv (is-equiv-∘-qinv fe ge) (is-equiv-∘-coh fe ge)

equiv-comp
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
    → A ≃ B → B ≃ C → A ≃ C
equiv-comp (mk≃ f e) (mk≃ g e') = mk≃ (g ∘ f) (is-equiv-∘ e' e)
}

\agda{
is-equiv⁻¹-qinv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → (e : is-equiv f)
    → quasi-inv (is-equiv.bwd e)
is-equiv⁻¹-qinv e = bwd-qinv (qinv←is-equiv e)

opaque
  is-equiv⁻¹-coh
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
      → (e : is-equiv f)
      → qinv-coh (is-equiv⁻¹-qinv e)
  is-equiv⁻¹-coh {A = A} {B = B} {f = f} e = coh where
    open is-equiv e using (bwd; η; ε; coherent)

    qinv : quasi-inv bwd
    qinv = is-equiv⁻¹-qinv e

    unap-ap-f
      : ∀ {x y : A} {p q : x ＝ y}
        → ap f p ＝ ap f q
        → p ＝ q

    unap-ap-f {x} {y}
      = unap←retraction-witness
          (unap←retraction-witness bwd η {x} {y})
          (ap-retraction-witness bwd η {x} {y})

    coh₁
      : ∀ b
        → ap (f ∘ bwd) (ε b) ＝ ε (f (bwd b))
    coh₁ b
      = ap (f ∘ bwd) (ε b)
          ＝⟨ sym (∙-reflr (ap (f ∘ bwd) (ε b))) ⟩
        ap (f ∘ bwd) (ε b) ∙ refl
          ＝⟨ ap (ap (f ∘ bwd) (ε b) ∙_) (sym (∙-sym (ε b))) ⟩
        ap (f ∘ bwd) (ε b) ∙ (ε b ∙ sym (ε b))
          ＝⟨ sym (∙-assoc (ap (f ∘ bwd) (ε b)) (ε b) (sym (ε b))) ⟩
        (ap (f ∘ bwd) (ε b) ∙ ε b) ∙ sym (ε b)
          ＝⟨ ap ((ap (f ∘ bwd) (ε b) ∙ ε b) ∙_) (sym (ap sym (ap-id (ε b)))) ⟩
        (ap (f ∘ bwd) (ε b) ∙ ε b) ∙ sym (ap id (ε b))
          ＝⟨ homotopy-cancel ε (ε b) ⟩
        ε (f (bwd b))
          ∎

    coh₂ : (b : B) → ap f (ap bwd (ε b)) ＝ ε (f (bwd b))
    coh₂ b = sym (ap-∘ f bwd (ε b)) ∙ coh₁ b

    coh₃ : (b : B) → ε (f (bwd b)) ＝ ap f (η (bwd b))
    coh₃ b = sym (coherent (bwd b))

    coh : qinv-coh qinv
    coh b = unap-ap-f (coh₂ b ∙ coh₃ b)

is-equiv⁻¹
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → (e : is-equiv f) → is-equiv (is-equiv.bwd e)
is-equiv⁻¹ e = mk-eqv (is-equiv⁻¹-qinv e) (is-equiv⁻¹-coh e)

bwd-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (e : A ≃ B)
    → is-equiv (_≃_.bwd e)
bwd-is-equiv e = is-equiv⁻¹ (_≃_.fwd-is-equiv e)
}

\agda{
coe-is-equiv
  : ∀ {𝓤} {A B : Type 𝓤} (p : A ＝ B)
    → is-equiv (coe p)
coe-is-equiv refl = id-is-equiv

coe≃ : ∀ {𝓤} {A B : Type 𝓤} → A ＝ B → A ≃ B
coe≃ p = mk≃ (coe p) (coe-is-equiv p)

tr≃ : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥) → ∀ {a b} → a ＝ b → P a ≃ P b
tr≃ P p = coe≃ (ap P p)
{-# NOINLINE tr≃ #-}

equiv←Id : ∀ {𝓤} {A B : Type 𝓤} → A ＝ B → A ≃ B
equiv←Id = coe≃
{-# NOINLINE equiv←Id #-}

fwd-equiv←Id
  : ∀ {𝓤} {A B : Type 𝓤} (p : A ＝ B)
    → _≃_.fwd (equiv←Id p) ＝ coe p
fwd-equiv←Id = ~refl
}
}

\subtree[stt-001S]{
\taxon{Notation}

\title{Reasoning combinators for equivalences}

\agda{
_∙e_
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
    → A ≃ B → B ≃ C → A ≃ C
_∙e_ = equiv-comp

infixl 15 _∙e_

_e⁻¹ : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → A ≃ B → B ≃ A
(mk≃ f e)  e⁻¹ = mk≃ (is-equiv.bwd e) (is-equiv⁻¹ e)

≃⟨⟩-syntax
  : ∀ {𝓤 𝓥 𝓦} (A : Type 𝓤) {B : Type 𝓥} {C : Type 𝓦}
    → B ≃ C → A ≃ B → A ≃ C
≃⟨⟩-syntax A g f = equiv-comp f g


_≃⟨⟩_ : ∀ {𝓤 𝓥} (A : Type 𝓤) {B : Type 𝓥} → A ≃ B → A ≃ B
x ≃⟨⟩ x≃y = x≃y

_≃∎ : ∀ {ℓ} (A : Type ℓ) → A ≃ A
x ≃∎ = id≃

infix 25 _e⁻¹

infixr 0 ≃⟨⟩-syntax _≃⟨⟩_
infix  1 _≃∎

syntax ≃⟨⟩-syntax x q p = x ≃⟨ p ⟩ q
}
}
