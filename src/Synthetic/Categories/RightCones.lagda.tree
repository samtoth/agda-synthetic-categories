\subtree[tot-1051]{
\title{The right cone on a type}
\taxon{Definition}
\date{2026-09-26}
\author{samueltoth}

\p{Given a type #{A} we may construct a type called the right cone on #{A} which can be
seen as adjoining a new point together with a morphisms from every point in #{A} to
the cone point. We can construct this type as the [relative suspension](stt-012G)
of #{A} by #{\{1\} \to Δ¹}. The right cone on #{A} is written #{A^{▻}}, and is
equivalent to the [blunt joint](stt-00CW) #{A \bjoin \b1}.}

\agda{
_▻ : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
_▻ = RelativeSusp (point i1)

module _ {𝓤} {A : Type 𝓤} where
  ▻-ι : A → A ▻
  ▻-ι = ι₁ ∘ (i0 ,_)

  ▻-cone-point : A ▻
  ▻-cone-point = RelativeSusp∙ i1 A

  ▻-hom : ∀ (a : A) → Hom (A ▻) (▻-ι a) ▻-cone-point
  ▻-hom a .Homᵈ.hom  i = ι₁ (i , a)
  ▻-hom a .Homᵈ.hom0 = refl
  ▻-hom a .Homᵈ.hom1 = glue (tt , a)
}
}

\subtree[tot-6051]{
\title{Functoriality of the right cone operation}
\taxon{Construction}
\date{2026-09-26}
\author{samueltoth}

\p{The right cone operation determines a functor from types to pointed types.}

\agda{
RightCone₀ : ∀ {𝓤} → Type 𝓤 → Type∗ (𝓤 ⊔ 𝓘)
RightCone₀ A = RelativeSusp∗ i1 A

RightCone₁
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B)
    → map∗ (RightCone₀ A) (RightCone₀ B)
RightCone₁ f = RelativeSusp∗₁ i1 f
}
}

\subtree[tot-7594]{
\title{The right cone is a left adjoint}
\taxon{Lemma}
\date{2026-09-26}
\author{samueltoth}

\p{Taking right cones is left adjoint to taking coslices, when seen as an operation
on pointed types (\ref{tot-10Q6}).}

\agda{
RightCone⊣Slice
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type∗ 𝓥}
    → (map∗ (RightCone₀ A) B) ≃ (A → Slice₀ B)
RightCone⊣Slice = postcomp-≃ (Ext-point≃fibre-ev i1 _) ∘e Susp⊣Ext i1
}
}
