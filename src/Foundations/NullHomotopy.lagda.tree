\subtree[stt-00F3]{
\title{Null-homotopies}
\taxon{Definition}

\p{
Given a map #{f \colon A \to B} then its type of \em{null-homotopies} is the
collection of elements #{b} of #{B} such that for all #{a} in #{A} we have
#{b = f(a)}.
##{\nullhtpy{f} \defeq \Sigma1{b : B}{(\Pi1{a : A}{b = f(a)})}.}
}

\agda{
module _ {𝓤1 𝓤2} {A : Type 𝓤1} {B : Type 𝓤2} where

  fam-null-homotopy : (A → B) → B → Type (𝓤1 ⊔ 𝓤2)
  fam-null-homotopy f b = (a : A) → b ＝ f a

  null-homotopy : (A → B) → Type (𝓤1 ⊔ 𝓤2)
  null-homotopy f = Σ[ b ∶ B ] (fam-null-homotopy f b)

  fam-null-homotopy' : (A → B) → B → Type (𝓤1 ⊔ 𝓤2)
  fam-null-homotopy' f b = (a : A) → f a ＝ b

  null-homotopy' : (A → B) → Type (𝓤1 ⊔ 𝓤2)
  null-homotopy' f = Σ[ b ∶ B ] (fam-null-homotopy' f b)
}
}

\subtree[stt-010K]{
\title{Null-homotopic functions are weakly constant}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-15}

\p{
A null-homotopy of #{f} gives an identification #{f(x) = f(y)} for every pair
of points #{x,y} in its domain.
}

\agda{
weakly-constant←null-homotopy
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    → null-homotopy f
    → (x y : A) → f x ＝ f y
weakly-constant←null-homotopy (b , H) x y
  = sym (H x) ∙ H y
}
}

\subtree[stt-00F4]{
\title{The action on identifications of null-homotopic maps is null-homotopic}
\taxon{Proposition}
\contributor{fredrikbakke}

\p{
If #{f \colon A \to B} is null-homotopic, then for any #{x,y : A}, the induced map on
identifications #{\ap f \colon (x = y) \to (f(x) = f(y))} is null-homotopic. In fact,
it suffices that #{f} is weakly constant.
}

\p{This appears in the proof of \citet{Auxiliary Lemma 4.3}{KECA17}.}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  ap-null-homotopy←weakly-constant
    : ((x y : A) → f x ＝ f y)
    → (x y : A) → null-homotopy (ap f {x} {y})
  ap-null-homotopy←weakly-constant c x y
    = (sym (c x x) ∙ c x y , (λ where refl → ∙-sym' (c x x)))

  ap-null-homotopy
    : null-homotopy f
    → (x y : A) → null-homotopy (ap f {x} {y})
  ap-null-homotopy h
    = ap-null-homotopy←weakly-constant (weakly-constant←null-homotopy h)
}
}

\subtree{
\title{Null-homotopic maps into fibres}
\taxon{Definition}

\p{
Given a map #{g : X \to Y} and a type #{A}, we consider the type null-homotopic
functions #{j : A \to \fibre{g}{y}} for some element #{y : Y}.
}

\agda{
module _ {𝓤 𝓥 𝓦} (A : Type 𝓤) {X : Type 𝓥} {Y : Type 𝓦} (g : X → Y) where

  null-homotopic-map-into-fibre : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
  null-homotopic-map-into-fibre
    = Σ[ y ∶ Y ] Σ[ j ∶ (A → fibre g y) ] null-homotopy j

  null-homotopic-map-into-fibre←domain : X → null-homotopic-map-into-fibre
  null-homotopic-map-into-fibre←domain x
    = (g x , const: (fibre g (g x)) A (x , refl) , (x , refl) , ~refl)

  domain←null-homotopic-map-into-fibre : null-homotopic-map-into-fibre → X
  domain←null-homotopic-map-into-fibre (_ , _ , y , _) = fst y
}
}

\p{The remainder of this module assumes function extensionality.}

\agda{
module NullHomotopyWithFunExt (FE : FunExt-global) where
  open WithFunExt-global FE
  open import Foundations.CompositionEquiv FE
  open import Foundations.CompositionFibres FE
  open import Foundations.IsEquivIsProp FE
}

\subtree[stt-013O]{
\title{Reversing null-homotopies}
\taxon{Equivalence}
\author{fredrikbakke}
\date{2026-09-17}

\agda{
  null-homotopy-sym≃
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
      → null-homotopy f ≃ null-homotopy' f
  null-homotopy-sym≃ f = Σ-snd-≃ (λ _ → Π-fam-≃ (λ _ → sym≃))
}
}

\subtree{
\title{Identifications of null-homotopies}
\taxon{Lemma}

\p{
Given a map #{f : A \to B} and two null-homotopies #{(y,H)} and #{(y',H')}  of #{f},
then an identification of the two null-homotopies is the same as an identification
#{p : y = y'} such that #{H(x) \concat p = H'(x)} for all #{x}.
}

\agda{
  module _ {𝓤1 𝓤2} {A : Type 𝓤1} {B : Type 𝓤2} where

    null-homotopy-path-Idᶠ≃pointwise
      : {f : A → B}
        {c l : B}
        (h : fam-null-homotopy f c)
        (r : fam-null-homotopy f l)
        (t : c ＝ l)
      → Idᶠ (fam-null-homotopy f) t h r ≃ ((a : A) → t ∙ r a ＝ h a)
    null-homotopy-path-Idᶠ≃pointwise h r refl
      = funext≃ ∙e Π-fam-≃ (λ _ → sym≃)

    null-homotopy-path≃
      : {f : A → B}
        {c l : B}
        (h : const: B A c ~ f)
        (r : const: B A l ~ f)
      → ((c , h) ＝ (l , r))
      ≃ (Σ[ t ∶ c ＝ l ] ((a : A) → t ∙ r a ＝ h a))
    null-homotopy-path≃ {f = f} {c} {l} h r
      = ((c , h) ＝ (l , r))
          ≃⟨ Σ-path e⁻¹ ⟩
        (Σ[ t ∶ c ＝ l ] Idᶠ (fam-null-homotopy f) t h r)
          ≃⟨ Σ-snd-≃ (null-homotopy-path-Idᶠ≃pointwise h r) ⟩
        (Σ[ t ∶ c ＝ l ] ((a : A) → t ∙ r a ＝ h a))
          ≃∎
}
}

\subtree[stt-00F5]{
\title{A null-homotopy presentation of domains of maps}
\taxon{Construction}

\p{
Given a map #{g \colon X \to Y} and any type #{A}, then #{X} is equivalent to the
data consisting of a point #{y : Y}, a map #{j \colon A \to \fibre{g}{y}}, and a
null-homotopy of #{j}.
##{X \;\simeq\; \Sigma2{y : Y}{j \colon A \to \fibre{g}{y}}{\nullhtpy(j)}}
}

\agda{
  module _ {𝓤 𝓥 𝓦} (A : Type 𝓤) {X : Type 𝓥} {Y : Type 𝓦} (g : X → Y) where

    domain←null-homotopic-map-into-fibre-qinv
      : quasi-inv (domain←null-homotopic-map-into-fibre A g)
    domain←null-homotopic-map-into-fibre-qinv .fst
      = null-homotopic-map-into-fibre←domain A g
    domain←null-homotopic-map-into-fibre-qinv .snd .fst (.(g x) , j , (x , refl) , H)
      = funext-rec
          ( λ H'
            → null-homotopic-map-into-fibre←domain A g x
            ＝ (g x , j , (x , refl) , H'))
          (λ where refl → refl)
          H
    domain←null-homotopic-map-into-fibre-qinv .snd .snd x = refl

    null-homotopic-map-into-fibre≃domain : null-homotopic-map-into-fibre A g ≃ X
    null-homotopic-map-into-fibre≃domain
      = mk≃ (domain←null-homotopic-map-into-fibre A g)
            (is-equiv←qinv domain←null-homotopic-map-into-fibre-qinv)
}
}

\subtree[stt-00F6]{
\title{Precomposition preserves null-homotopies}
\taxon{Proposition}

\agda{
  module _
    {𝓤1 𝓤2 𝓤3} {A : Type 𝓤1} {B : Type 𝓤2} {C : Type 𝓤3} (e : B ≃ A) (j : A → C)
    where

    homotopy-const-precomp-≃
      : (y : C) → (const: C A y ~ j) ≃ (const: C B y ~ (precomp-≃ e ._≃_.fwd j))
    homotopy-const-precomp-≃ y = precomp-Π-≃ (λ a → y ＝ j a) e

    null-homotopy-precomp-≃
      : null-homotopy j ≃ null-homotopy (precomp-≃ e ._≃_.fwd j)
    null-homotopy-precomp-≃ = Σ-snd-≃ homotopy-const-precomp-≃
}
}

\subtree[stt-00MV]{
\title{Null-homotopies as fibres of the constant map}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-03-19}

\agda{
  module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (h : A → B) where

    fibre-const≃null-homotopy : fibre (const: B A) h ≃ null-homotopy h
    fibre-const≃null-homotopy = Σ-snd-≃ (λ _ → funext≃)
}
}

\subtree[stt-00MW]{
\title{Fibres of dependent precomposition via fibrewise null-homotopies}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-03-19}

\agda{
  module _
    {𝓤 𝓥 𝓦}
    {A : Type 𝓤} {B : Type 𝓥}
    (U : B → Type 𝓦)
    (f : A → B)
    (h : Π A (U ∘ f))
    where

    Ext-precomp-Π-null-homotopy≃
      : Extᵈ f U h
      ≃ Π B (λ b → null-homotopy (precomp-Π-over-fibres U f h b))
    Ext-precomp-Π-null-homotopy≃
      = Extᵈ f U h
          ≃⟨ Σ-snd-≃
                ( λ g
                  → Π-fam-≃ (λ a → ＝-preconcat-≃ (tr-refl {P = U} refl (h a) refl))
                  ∙e ((precomp-Π-≃
                        ( λ z
                          → g (z .fst)
                          ＝ precomp-Π-over-fibres U f h (z .fst) (z .snd))
                        ((total≃total-fibre f) e⁻¹)) e⁻¹)
                  ∙e curry≃) ⟩
        (Σ[ g ∶ Π B U ]
          ((b : B) → (x : fibre f b) → g b ＝ precomp-Π-over-fibres U f h b x))
          ≃⟨ Σ-Π-swap≃ U
                (λ b g → (x : fibre f b) → g ＝ precomp-Π-over-fibres U f h b x)
                e⁻¹ ⟩
        (Π B (λ b → null-homotopy (precomp-Π-over-fibres U f h b)))
          ≃∎

    fibre-precomp-Π-null-homotopy≃
      : fibre (precomp-Π U f) h
      ≃ Π B (λ b → null-homotopy (precomp-Π-over-fibres U f h b))
    fibre-precomp-Π-null-homotopy≃
      = Σ-snd-≃ (λ _ → funext≃)
      ∙e Ext-precomp-Π-null-homotopy≃

    fibre-precomp-Π≃Ext : fibre (precomp-Π U f) h ≃ Extᵈ f U h
    fibre-precomp-Π≃Ext = Σ-snd-≃ (λ _ → funext≃)
}
}

\subtree[stt-00F7]{
\title{Equivalences on codomains preserve null-homotopies}
\taxon{Proposition}

\agda{
  module _
    {𝓤1 𝓤2 𝓤3} {A : Type 𝓤1} {B : Type 𝓤2} {C : Type 𝓤3} (e : B ≃ C) (j : A → B)
    where

    null-homotopy-map-codomain-≃
      : null-homotopy j ≃ null-homotopy (e ._≃_.fwd ∘ j)
    null-homotopy-map-codomain-≃
      = null-homotopy j
          ≃⟨ Σ-snd-≃ (λ y → Π-fam-≃ (λ a → ＝-equiv e)) ⟩
        (Σ[ y ∶ B ] ((a : A) → e ._≃_.fwd y ＝ e ._≃_.fwd (j a)))
          ≃⟨ Σ-fst-≃ e ⟩
        null-homotopy (e ._≃_.fwd ∘ j)
          ≃∎
}
}

\subtree[stt-00FI]{
\title{Currying null-homotopies}
\taxon{Proposition}

\agda{
  module _
    {𝓤1 𝓤2 𝓤3}
    {A : Type 𝓤1} {X : Type 𝓤2} {Y : X → Type 𝓤3}
    (f : (x : X) → A → Y x)
    where

    null-homotopy-curry≃
      : ((x : X) → null-homotopy (f x))
      ≃ null-homotopy (λ a x → f x a)
    null-homotopy-curry≃
      = ((x : X) → null-homotopy (f x))
          ≃⟨ Σ-Π-swap≃ Y (λ x y → (a : A) → y ＝ f x a) ⟩
        (Σ[ y ∶ ((x : X) → Y x) ] ((x : X) → (a : A) → y x ＝ f x a))
          ≃⟨ Σ-snd-≃ (λ _ → flip≃) ⟩
        (Σ[ y ∶ ((x : X) → Y x) ] ((a : A) (x : X) → y x ＝ f x a))
          ≃⟨ Σ-snd-≃ (λ _ → Π-fam-≃ (λ _ → funext≃ e⁻¹)) ⟩
        null-homotopy (λ a x → f x a)
          ≃∎
}
}

\subtree[stt-013P]{
\title{Null-homotopies into dependent sums}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-17}

\p{
For #{f \colon X \to \Sigma1{a : A}{P(a)}}, a [null-homotopy](stt-00F3) consists
of a null-homotopy in the base and a null-homotopy in the fibre over its centre.
}

\agda{
  module _
    {𝓤 𝓥 𝓦} {X : Type 𝓤} {A : Type 𝓥} {P : A → Type 𝓦}
    (f : X → Σ A P)
    where

    null-homotopy-Σ≃
      : null-homotopy f
      ≃ ( Σ[ (a , H) ∶ null-homotopy' (fst ∘ f) ]
           null-homotopy (λ x → tr P (H x) (f x .snd)))
    null-homotopy-Σ≃
      = null-homotopy-sym≃ f
      ∙e Σ-snd-≃ (λ _ → Π-fam-≃ (λ _ → Σ-path e⁻¹) ∙e Σ-Π-swap≃ _ _)
      ∙e Σ-interchange
      ∙e Σ-snd-≃ (λ _ → null-homotopy-sym≃ _ e⁻¹)
}
}
