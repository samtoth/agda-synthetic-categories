\subtree[stt-00H6]{
\date{2026-03-11}
\author{fredrikbakke}
\taxon{Definition}
\title{The canonical equaliser}

\p{
Given a pair of parallel maps #{f\ g \colon A \to B}, the canonical equaliser is the
type of elements #{a : A} equipped with a path #{f(a) = g(a)}.
}

\agda{
Equaliser
  : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥}
  → (f g : A → B)
  → Type (𝓤 ⊔ 𝓥)
Equaliser {A = A} f g = Σ[ a ∶ A ] (f a ＝ g a)

module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f g : A → B) where

  Equaliser-fork : Fork f g (Equaliser f g)
  Equaliser-fork = fst , snd

  Equaliser-gap
    : {𝓠 : Level} {Q : Type 𝓠}
    → Fork f g Q
    → Q → Equaliser f g
  Equaliser-gap (e , H) q = (e q , H q)
}
}

\subtree[stt-00H7]{
\date{2026-03-18}
\author{fredrikbakke}
\taxon{Theorem}
\title{The canonical equaliser is an equaliser}

\agda{
module _
  {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥}
  (f g : A → B)
  where

  Equaliser-has-up-equaliser
    : up-equaliser f g (Equaliser-fork f g)
  Equaliser-has-up-equaliser = mk-eqv (Equaliser-gap f g , ~refl , ~refl) ~refl
}
}

\subtree[stt-00H8]{
\date{2026-03-11}
\author{fredrikbakke}
\taxon{Theorem}
\title{Canonical equalisers as pullbacks}

\p{
The equaliser of a pair of parallel maps #{f\ g \colon A \to B} can be presented as the
pullback

\quiver{
\begin{tikzcd}
	\rm{Eq}(f,g) && A  \\
	\\
	B && B \times B
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow["{(f,g)}", from=1-3, to=3-3]
	\arrow["\Delta", from=3-1, to=3-3]
	\arrow["\lrcorner" very near start, phantom, from=1-1, to=3-3]
\end{tikzcd}
}
}

\agda{
module _
  {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥} {f g : A → B}
  where

  Equaliser-diagonal-cone
    : Cone
        (mk-cospan (B × B) (λ b → (b , b)) (λ a → (f a , g a)))
        (Equaliser f g)
  Equaliser-diagonal-cone
    = mk-cone
        (f ∘ fst)
        (fst)
        (λ (_ , p) → ×-path→ (refl , p))

  Pullback←Equaliser
    : Equaliser f g
    → Pullback (λ b → (b , b)) (λ a → (f a , g a))
  Pullback←Equaliser = gap Equaliser-diagonal-cone

  Pullback←Equaliser-is-equiv
    : is-equiv Pullback←Equaliser
  Pullback←Equaliser-is-equiv = is-equiv←qinv qinv where
    bwd : Pullback (λ b → (b , b)) (λ a → (f a , g a)) → Equaliser f g
    bwd (b , a , p) = (a , sym (ap fst p) ∙ ap snd p)

    qinv : quasi-inv Pullback←Equaliser
    qinv .fst = bwd
    qinv .snd .fst (a , p) = Σ-path→ (refl , retp) where
      retp
        : sym (ap fst (×-path→ (refl , p))) ∙ ap snd (×-path→ (refl , p))
        ＝ p
      retp
        = ap (λ q → sym q ∙ ap snd (×-path→ (refl , p))) ×-path-ap-fst
        ∙ ×-path-ap-snd
    qinv .snd .snd (b , a , p)
      = pullback-path→ (sym (ap fst p) , refl , sq p ∙ sym (∙-reflr _)) where
      sq
        : {b' : B} {a' : A}
          (p' : (b' , b') ＝ (f a' , g a'))
        → ap (λ c → (c , c)) (sym (ap fst p')) ∙ p'
        ＝ ×-path→ (refl , sym (ap fst p') ∙ ap snd p')
      sq = J ( λ y p'
             → ap (λ c → (c , c)) (sym (ap fst p')) ∙ p'
             ＝ ×-path→ (refl , sym (ap fst p') ∙ ap snd p'))
        ( refl)

  Equaliser≃Pullback-diagonal
    : Equaliser f g
    ≃ Pullback (λ b → (b , b)) (λ a → (f a , g a))
  Equaliser≃Pullback-diagonal
    = mk≃ Pullback←Equaliser Pullback←Equaliser-is-equiv
}
}

\subtree{
\date{2026-03-11}
\author{fredrikbakke}
\taxon{Lemma}
\title{Identity types as equalisers}

\p{
The identity type #{x = y} can be presented as the equaliser of the two maps
#{\point(x),\point(y) \colon \b1 \to A}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} (x y : A) where

  ＝-fork
    : Fork (point x) (point y) (x ＝ y)
  ＝-fork = (! , id)

  ＝-Equaliser-point-gap
    : x ＝ y
    → Equaliser (point x) (point y)
  ＝-Equaliser-point-gap
    = Equaliser-gap (point x) (point y) (＝-fork)

  ＝-Equaliser-point-gap-is-equiv
    : is-equiv ＝-Equaliser-point-gap
  ＝-Equaliser-point-gap-is-equiv
    = mk-eqv (snd , ~refl , ~refl) (~refl)

  ＝≃Equaliser-point
    : (x ＝ y)
    ≃ Equaliser (point x) (point y)
  ＝≃Equaliser-point
    = mk≃ ＝-Equaliser-point-gap ＝-Equaliser-point-gap-is-equiv
}
}

\subtree{
\date{2026-03-17}
\author{fredrikbakke}
\taxon{Lemma}
\title{The total identity type}

\p{
The total identity type of a type #{X} is the total space of the identity family on
#{X}. It can equally be presented as the equaliser of the two projections
#{\fst,\snd \colon X \times X \to X}.
}

\agda{
TotalId
  : {𝓤 : Level} → Type 𝓤 → Type 𝓤
TotalId X = Equaliser (fst {B = λ _ → X}) snd

module _ {𝓤} {X : Type 𝓤} where

  TotalId-point
    : TotalId X → X
  TotalId-point ((x , _) , _) = x

  point-TotalId : X → TotalId X
  point-TotalId x = ((x , x) , refl)

  point-TotalId-is-equiv : is-equiv point-TotalId
  point-TotalId-is-equiv
    = mk-eqv (TotalId-point , ~refl , λ where ((x , .x) , refl) → refl) ~refl

  TotalId-point-is-equiv : is-equiv TotalId-point
  TotalId-point-is-equiv
    = mk-eqv
        (point-TotalId , (λ where ((x , .x) , refl) → refl) , ~refl)
        (λ where ((x , .x) , refl) → refl)

  TotalId≃ : TotalId X ≃ X
  TotalId≃ = mk≃ TotalId-point TotalId-point-is-equiv
}
}
