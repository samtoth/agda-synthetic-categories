\date{2026-03-28}
\title{Pointed types}
\taxon{Module}
\author{fredrikbakke}
\import{stt-macros}

\agda{
module Foundations.Pointed where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Sigma
open import Foundations.Functions
open import Foundations.Homotopy
open import Foundations.Equivalences
}
}

\subtree[stt-00LZ]{
\date{2026-03-28}
\author{fredrikbakke}
\taxon{Definition}
\title{Pointed types}

\p{
A \em{pointed type} is a type #{X} together with a chosen element #{x : X}.
}

\agda{
record Type∗ (𝓤 : Level) : Type (lsuc 𝓤) where
  constructor mk-type∗
  field
    carrier : Type 𝓤
    pt : carrier

open Type∗
}
}

\subtree[stt-00M0]{
\date{2026-03-28}
\author{fredrikbakke}
\taxon{Definition}
\title{Pointed maps}

\p{
A \em{pointed map} between [pointed types](stt-00LZ) #{\Hom_*((X,x), (Y,y))} is a
function #{f : X \to Y} together with a proof that it preserves the base point:
#{f(x) = y}.
}

\agda{
record map∗ {𝓤 𝓥} (A : Type∗ 𝓤) (B : Type∗ 𝓥) : Type (𝓤 ⊔ 𝓥) where
  constructor mk-map∗
  field
    hom : carrier A → carrier B
    pres-pt : hom (pt A) ＝ pt B

open map∗

id∗ : {𝓤 : Level} (A : Type∗ 𝓤) → map∗ A A
id∗ A = mk-map∗ id refl

const∗ : {𝓤 𝓥 : Level} (A : Type∗ 𝓤) (B : Type∗ 𝓥) → map∗ A B
const∗ A B = mk-map∗ (λ _ → pt B) refl

infixr 5 _→∗_
_→∗_ : {𝓤 𝓥 : Level} → Type∗ 𝓤 → Type∗ 𝓥 → Type∗ (𝓤 ⊔ 𝓥)
A →∗ B = mk-type∗ (map∗ A B) (const∗ A B)
}
}

\subtree[stt-00M3]{
\date{2026-03-28}
\author{fredrikbakke}
\taxon{Lemma}
\title{Pointed maps as fibres of the evaluation map}

\p{
For a pair of pointed types #{(X, x)} and #{(Y, y)}, pointed maps from #{X} to {Y}
are equivalent to the fibre over #{y} of the evaluation map at #{x}.
}

\agda{
map∗≃fibre-ev
  : {𝓤 𝓥 : Level}
    (X∗ : Type∗ 𝓤)
    {Y : Type 𝓥}
    (y : Y)
  → map∗ X∗ (mk-type∗ Y y) ≃ fibre (ev (pt X∗)) y
map∗≃fibre-ev X∗ y
  = mk≃ to (mk-eqv (from , ~refl , ~refl) ~refl) where

  to : map∗ X∗ (mk-type∗ _ y) → fibre (ev (pt X∗)) y
  to F = (map∗.hom F , map∗.pres-pt F)

  from : fibre (ev (pt X∗)) y → map∗ X∗ (mk-type∗ _ y)
  from (f , p) = mk-map∗ f p
}
}
