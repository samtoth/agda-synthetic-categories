\subtree[fre-5001]{
\title{Rebasing identitys}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-26}

\p{
We define the general operation of \em{rebasing} identities. Given a path
#{p : a = b}, and equalities #{α : a = a'} and #{β : b = b'}, we may "rebase" #{p} to
obtain a path #{p' : a' = b'}. This operation is the same as concatenating
#{α^{-1} ∙ p ∙ β}, or transporting #{p} along #{α} and #{β} in the binary family
#{x\ y \mapsto (x = y)}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  rebase＝
    : {a a' b b' : A} → a ＝ a' → b ＝ b' → a ＝ b → a' ＝ b'
  rebase＝ refl refl p = p

  rebase＝-refl
    : {a a' : A} (α : a ＝ a')
    → rebase＝ α α refl ＝ refl
  rebase＝-refl refl = refl

  rebase＝-∘
    : {a a' a'' b b' b'' : A}
      (α : a ＝ a') (β : b ＝ b')
      (α' : a' ＝ a'') (β' : b' ＝ b'')
      (p : a ＝ b)
    → rebase＝ α' β' (rebase＝ α β p)
    ＝ rebase＝ (α ∙ α') (β ∙ β') p
  rebase＝-∘ refl refl refl refl p = refl

  rebase＝-∙
    : {a a' b b' c c' : A}
    → (α : a ＝ a') (β : b ＝ b') (γ : c ＝ c')
    → (p : a ＝ b) (q : b ＝ c)
    → rebase＝ α γ (p ∙ q)
    ＝ rebase＝ α β p ∙ rebase＝ β γ q
  rebase＝-∙ refl refl refl refl refl = refl

  rebase＝-tr₂
    : {a a' b b' : A} (α : a ＝ a') (β : b ＝ b') (p : a ＝ b)
    → rebase＝ α β p ＝ tr₂ (_＝_) α β p
  rebase＝-tr₂ refl refl p = refl

  rebase＝-square
    : {a a' b b' : A} (p : a ＝ b) (α : a ＝ a') (β : b ＝ b')
    → α ∙ rebase＝ α β p ＝ p ∙ β
  rebase＝-square refl refl refl = refl
}
}

\subtree[fre-5002]{
\title{Conjugation of loops}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-26}

\p{
Given a loop #{p : a = a}, then we may conjugate it by an equality #{α : a = b}
to obtain a loop #{p' : b = b}. We define conjugation via [path rebasing](fre-5001),
and show this is equal to the concatenation  #{α^{-1} ∙ p ∙ β}, or
transporting #{p} along #{α} in the family #{x \mapsto (x = x)}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  conjΩ
    : {a b : A} → a ＝ b → (a ＝ a) → (b ＝ b)
  conjΩ p = rebase＝ p p

  conjΩ-refl
    : {a b : A} (p : a ＝ b) → conjΩ p refl ＝ refl
  conjΩ-refl p = rebase＝-refl p

  conjΩ-∙
    : {a b c : A} (α : a ＝ b) (β : b ＝ c) (p : a ＝ a)
    → conjΩ β (conjΩ α p) ＝ conjΩ (α ∙ β) p
  conjΩ-∙ α β p = rebase＝-∘ α α β β p

  conjΩ-tr
    : {a b : A} (p : a ＝ b) (q : a ＝ a)
    → conjΩ p q ＝ tr (λ x → x ＝ x) p q
  conjΩ-tr refl q = rebase＝-tr₂ refl refl q

  conjΩ-conjΩ
    : {a b : A} (ι : a ＝ b) (γ p : a ＝ a)
    → conjΩ ι (conjΩ γ p) ＝ conjΩ (conjΩ ι γ) (conjΩ ι p)
  conjΩ-conjΩ refl γ p = refl
}
}

\subtree[fre-5003]{
\title{Functoriality of identity rebasing}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-26}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} where

  ap-rebase＝
    : (f : A → B) {a a' b b' : A}
    → (α : a ＝ a') (β : b ＝ b') (p : a ＝ b)
    → ap f (rebase＝ α β p)
    ＝ rebase＝ (ap f α) (ap f β) (ap f p)
  ap-rebase＝ f refl refl p = refl

  ap-conjΩ
    : (f : A → B) {a b : A} (α : a ＝ b) (p : a ＝ a)
    → ap f (conjΩ α p) ＝ conjΩ (ap f α) (ap f p)
  ap-conjΩ f α p = ap-rebase＝ f α α p

  homotopy-rebase＝
    : {f g : A → B} (H : f ~ g) {x y : A} (p : x ＝ y)
    → rebase＝ (H x) (H y) (ap f p) ＝ ap g p
  homotopy-rebase＝ H refl = conjΩ-refl (H _)

  homotopy-conjΩ
    : {f g : A → B} (H : f ~ g) {x : A} (p : x ＝ x)
    → conjΩ (H x) (ap f p) ＝ ap g p
  homotopy-conjΩ H p = homotopy-rebase＝ H p
}
}

\subtree[fre-5004]{
\title{Conjugation in commutative loop spaces}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-26}

\p{In commutative loop spaces the action of conjugation is trivial.}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  conjΩ-id←∙-comm'
    : {a : A} {β p : a ＝ a}
    → p ∙ β ＝ β ∙ p
    → conjΩ β p ＝ p
  conjΩ-id←∙-comm' {β = β} {p = p} comm
    = left-cancel-∙ β (rebase＝-square p β β ∙ comm)

  conjΩ-id←∙-comm
    : {a : A}
    → ((p q : a ＝ a) → p ∙ q ＝ q ∙ p)
    → (β p : a ＝ a)
    → conjΩ β p ＝ p
  conjΩ-id←∙-comm ∙-comm β p
    = conjΩ-id←∙-comm' (∙-comm p β)

  conjΩ-coh←∙-comm'
    : {x₀ y z : A}
      (h : y ＝ z) (β : y ＝ x₀) (γ : z ＝ x₀)
      {p : y ＝ y} {q : z ＝ z}
    → conjΩ h p ＝ q
    → conjΩ (h ∙ γ) p ∙ rebase＝ (h ∙ γ) refl β
    ＝ rebase＝ (h ∙ γ) refl β ∙ conjΩ (h ∙ γ) p
    → conjΩ β p ＝ conjΩ γ q
  conjΩ-coh←∙-comm' refl β refl e comm
    = conjΩ-id←∙-comm' comm ∙ e

  conjΩ-coh←∙-comm
    : {x₀ y z : A}
    → ((r s : x₀ ＝ x₀) → r ∙ s ＝ s ∙ r)
    → (h : y ＝ z) (β : y ＝ x₀) (γ : z ＝ x₀)
      {p : y ＝ y} {q : z ＝ z}
    → conjΩ h p ＝ q
    → conjΩ β p ＝ conjΩ γ q
  conjΩ-coh←∙-comm ∙-comm h β γ {p} e
    = conjΩ-coh←∙-comm' h β γ e
        ( ∙-comm (conjΩ (h ∙ γ) p) (rebase＝ (h ∙ γ) refl β))
}
}
