\date{2026-08-27}
\title{The Eckmann–Hilton argument}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
{-# OPTIONS --lossy-unification #-}

module Foundations.EckmannHilton where
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Wild.Categories.Structure
open CompPrestructure
}
}

\subtree[fre-2B35]{
\title{Interchange laws}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  InterchangeLaw
    : (X → X → X) → (X → X → X) → Type 𝓤
  InterchangeLaw _◾_ _◽_
    = (a b c d : X)
    → (a ◾ b) ◽ (c ◾ d) ＝ (a ◽ c) ◾ (b ◽ d)

  OuterInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  OuterInterchangeLaw _◾_ _◽_ e
    = (a d : X)
    → (a ◾ e) ◽ (e ◾ d) ＝ (a ◽ e) ◾ (e ◽ d)

  InnerInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  InnerInterchangeLaw _◾_ _◽_ e
    = (b c : X)
    → (e ◾ b) ◽ (c ◾ e) ＝ (e ◽ c) ◾ (b ◽ e)
}
}

\subtree[fre-DAF1]{
\title{Outer interchange at the unit gives equal operations}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{outer interchange law} for all #{a\ d : X}:
##{(a \mathbin{◾} e) \mathbin{◽} (e \mathbin{◾} d) = (a \mathbin{◽} e) \mathbin{◾} (e \mathbin{◽} d)}
then the two binary operations are equal.
}

\agda{
equal-ops←outer-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → OuterInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ x ◾ y
equal-ops←outer-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ outer-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (r◾ x) (l◾ y)) ⟩
    (x ◾ e) ◽ (e ◾ y)
      ＝⟨ outer-◾-◽-interchange x y ⟩
    (x ◽ e) ◾ (e ◽ y)
      ＝⟨ ap₂ (_◾_) (r◽ x) (l◽ y) ⟩
    x ◾ y ∎
}
}

\subtree[fre-11E4]{
\title{Inner interchange at the unit gives opposite operations}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{inner interchange law} for all #{b\ c : X}:
##{(e \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} e) = (e \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} e)}
then the two binary operations are opposites: #{{b}\mathbin{◾}{c} = {c}\mathbin{◽}{b}}
}

\agda{
opposite-ops←inner-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InnerInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ y ◾ x
opposite-ops←inner-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ inner-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (l◾ x) (r◾ y)) ⟩
    (e ◾ x) ◽ (y ◾ e)
      ＝⟨ inner-◾-◽-interchange x y ⟩
    (e ◽ y) ◾ (x ◽ e)
      ＝⟨ ap₂ (_◾_) (l◽ y) (r◽ x) ⟩
    y ◾ x ∎
}
}

\subtree[fre-D0CE]{
\title{The algebraic Eckmann–Hilton argument}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{interchange law} for all #{a\ b\ c\ d : X}:
##{(a \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} d) = (a \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} d)}
then the two binary operations are equal and symmetric.
}

\proof{
We have seen that outer interchange gives #{x \mathbin{◾} y = x \mathbin{◽} y},
and that inner interchange gives #{x \mathbin{◾} y = y \mathbin{◽} x}, hence
#{x \mathbin{◽} y = y \mathbin{◽} x}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  comm←interchange'
    : (_◽_ : X → X → X) (L R : X → X)
    → L ~ id → R ~ id
    → ((x y : X) → L x ◽ R y ＝ R y ◽ L x)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
  comm←interchange' _◽_ L R l r L◽R-commute x y
    = sym (ap₂ (_◽_) (l x) (r y)) ∙ L◽R-commute x y ∙ ap₂ (_◽_) (r y) (l x)

  comm←interchange
    : (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InterchangeLaw (_◾_) (_◽_)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
  comm←interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ interchange x y
    = equal-ops←outer-interchange
        (_◾_) (_◽_) e l◾ r◾ l◽ r◽ (λ a d → interchange a e e d) x y
    ∙ sym
        ( opposite-ops←inner-interchange
          (_◾_) (_◽_) e l◾ r◾ l◽ r◽ (λ b c → interchange e b c e) y x)
}
}
