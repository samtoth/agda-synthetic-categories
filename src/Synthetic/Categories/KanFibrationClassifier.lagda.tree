\title{The Kan fibration classifier}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-24}
\import{stt-macros}

\p{
We construct and study the Kan fibration classifier, which is the universal object
classifying [Kan fibrations](bak-8ED4).
}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.KanFibrationClassifier
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Modalities.Instances.Truncation
open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.Connectivity
open import Synthetic.Tiny
open import Synthetic.Categories.Groupoids Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.ContravariantFamilies Δ¹ I
open import Synthetic.Categories.KanFibrations Δ¹ I
}
}

\agda{
module TinyInterval
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ √ε : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (Δ¹ → √ A) → A)
  (@♭ √-is-tiny-str
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure Δ¹ A (√ A) √ε)
  (open Dependent√ Δ¹ √ √ε √-is-tiny-str using (√ᵈ))
  (@♭ √ᵈ-is-prop
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
      → @♭ ((γ : Δ¹ → Γ) → is-prop (A γ)) → (γ : Γ) → is-prop (√ᵈ A γ))
  where
}

\subtree[bak-1FB1]{
\title{The universal Kan fibration}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-24}

\p{
The [amazing fibrancy construction](stt-00KS) gives a universal Kan fibration
#{\mathrm{Kan}_* \to \mathrm{Kan}}.
}

\agda{
  open AmazinglyFibrant
    Δ¹ √ √ε √-is-tiny-str
    is-kan is-kan-is-prop is-kan-is-Δ¹-relative public
    using ()
    renaming
      ( is-afib to is-akan
      ; UFib to Kan
      ; mk-ufib to mk-kan
      ; UFib∙ to Kan∗
      ; UFib-π to Kan-π
      ; UFib-π-is-fib to Kan-π-is-kan
      ; UFib-is-fib to Kan-family-is-kan
      ; UFib-transport to Kan-family
      ; liftFib to liftKan
      ; lift-fibrancy to lift-kan-fibrancy
      ; module UIdS to KanIdS)

  open KanIdS √ᵈ-is-prop public
    using ()
    renaming
      ( is-afib-is-prop to is-akan-is-prop
      ; Carrier-is-prop-map to Kan-Carrier-is-prop-map
      ; Carrier-is-emb to Kan-Carrier-is-emb
      ; UFib-path← to Kan-path←
      ; UFib-path←-coe≃-ap to Kan-path←-coe≃-ap
      ; UFib-path←-β to Kan-path←-β
      ; UFib-IdS to Kan-IdS
      ; UFib-tr to Kan-tr
      ; UP-UFib to UP-Kan
      ; UP-UFib≃ to UP-Kan≃)

  open Kan public
}
}

\subtree[bak-0D64]{
\title{The Kan fibration classifier is #{Δ¹}-discrete}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{The Kan fibration classifier is #{Δ¹}-discrete.}

\proof{
\p{
Any synthetic arrow in the Kan fibration classifier gives an equivalence by
transport and hence an identification, and we know a family of maps
#{\Hom(x,y)\to (x = y)}
[implies that the underlying type is #{Δ¹}-discrete](stt-00L4).
}
}

\agda{
  Kan-is-Δ¹-discrete
    : ∀ {@♭ 𝓤} → is-Δ¹-discrete (Kan 𝓤)
  Kan-is-Δ¹-discrete
    = is-Δ¹-discrete←Id←Hom
        (λ {a} {b} → Kan-path← a b ∘ tr-hom≃←is-kan Kan-π-is-kan)

  Kan-π-fibres-are-Δ¹-discrete
    : ∀ {@♭ 𝓤} (a : Kan 𝓤) → is-Δ¹-discrete (Carrier a)
  Kan-π-fibres-are-Δ¹-discrete
    = is-Δ¹-discrete-family←is-covariant
        (is-covariant←is-kan Carrier Kan-π-is-kan)
}
}

\subtree[bak-4828]{
\title{Crisp #{Δ¹}-discrete types are amazingly Kan fibrant}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-24}

\p{Crisp #{Δ¹}-discrete types are amazingly Kan fibrant.}

\proof{
\p{
Any [#{Δ¹}-discrete type](stt-00B6) is Kan fibrant, so by amazing fibrancy lifting
a crisp #{Δ¹}-discrete type is amazingly Kan fibrant.
}
}

\agda{
  opaque
    is-akan←is-Δ¹-discrete
      : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-Δ¹-discrete A → is-akan A
    is-akan←is-Δ¹-discrete {A = A} A-disc
      = lift-kan-fibrancy (Trunc.η i0) (point A)
          (is-kan↔covariant-and-contravariant _ .snd
            ( const-is-covariant←is-Δ¹-discrete A-disc
            , const-is-contravariant←is-Δ¹-discrete A-disc)) tt
}
}

\subtree[bak-1C87]{
\title{Kan is the core of Space}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-24}

\p{
The forgetful map from the [Kan fibration classifier](bak-1FB1) to #{\mathcal{S}} is
a #{\flat}-equivalence, so if the interval [detects connectivity](stt-00J0)
the Kan fibration classifier is the core #{\modflat{\mathcal{S}}}.
}

\agda{
  module _
    (let module S
          = AmazinglyFibrant Δ¹ √ √ε √-is-tiny-str
              is-covariant is-covariant-is-prop
              (λ _ → is-covariant-is-Δ¹-relative))
    (open S using () renaming (UFib to Space))
    (let module SU = S.UIdS √ᵈ-is-prop)
    {@♭ 𝓤}
    where

    Space←Kan : Kan 𝓤 → Space 𝓤
    Space←Kan A .Space.Carrier = Carrier A
    Space←Kan A .Space.Carrier-is-afib
      = S.lift-fibrancy (Trunc.η i0) Carrier
          (is-covariant←is-kan Carrier Kan-π-is-kan) A

    Kan←Space : @♭ Space 𝓤 → Kan 𝓤
    Kan←Space A .Carrier = Space.Carrier A
    Kan←Space A .Carrier-is-afib
      = is-akan←is-Δ¹-discrete
          (is-Δ¹-discrete-family←is-covariant S.UFib-π-is-fib A)

    opaque
      Space←Kan-is-♭-equiv : is-♭-equiv Space←Kan
      Space←Kan-is-♭-equiv = is-equiv←section←injective
        ( ♭-map-is-injective (unap Kan-Carrier-is-emb ∘ ap Space.Carrier))
        ( (λ where (mod♭ A) → mod♭ (Kan←Space A))
        , ( λ where
              (mod♭ A) → mapply♭
                (mod♭ (SU.UFib-path← (Space←Kan (Kan←Space A)) A id≃))))

    ♭Kan≃♭Space : ⟨♭| Kan 𝓤 ⟩ ≃ ⟨♭| Space 𝓤 ⟩
    ♭Kan≃♭Space = mk≃ (♭-map Space←Kan) Space←Kan-is-♭-equiv

    module _ (@♭ Δ¹-detects-connectivity : detects-connectivity (point Δ¹)) where

      Kan-is-♭-discrete : is-♭-discrete (Kan 𝓤)
      Kan-is-♭-discrete = Δ¹-detects-connectivity .fst Kan-is-Δ¹-discrete

      ♭Kan≃Kan : ⟨♭| Kan 𝓤 ⟩ ≃ Kan 𝓤
      ♭Kan≃Kan = mk≃ ε♭ Kan-is-♭-discrete

      Kan≃♭Space : Kan 𝓤 ≃ ⟨♭| Space 𝓤 ⟩
      Kan≃♭Space = ♭Kan≃Kan e⁻¹ ∙e ♭Kan≃♭Space

      compute-Kan-core-inclusion : ε♭ ∘ _≃_.fwd Kan≃♭Space ~ Space←Kan
      compute-Kan-core-inclusion
        = (ε♭-natural {f = Space←Kan} ▹h is-equiv.bwd Kan-is-♭-discrete)
        ∙h (Space←Kan ◃h is-equiv.ε Kan-is-♭-discrete)
}
}
