\subtree[stt-00IZ]{
\title{Flat discrete types}
\taxon{Definition}

\p{We call crisp types #{\flat}-discrete if the map #{\modflat{A} \to A} is an
equivalence.}

\agda{
is-♭-discrete : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤
is-♭-discrete A = is-equiv (ε♭: A)

♭-is-♭-discrete : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-♭-discrete ⟨♭| A ⟩
♭-is-♭-discrete = is-equiv⁻¹ comult-is-equiv
}
}

\subtree[stt-00OU]{
\title{Flat discrete types are closed under crisp retracts}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-05-16}

\agda{
module _ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} where

  ε♭-retraction-arrow-map
    : (@♭ R : retract A B)
    → retraction-arrow-map (ε♭-Arrow-map (R .fst))
  ε♭-retraction-arrow-map (i , r , ret)
    = ε♭-Arrow-map {A = B} {B = A} r
    , (λ where (mod♭ a) → mapply♭ (mod♭ (ret a)))
    , ret
    , (λ where (mod♭ a) → ε♭-mapply♭ (mod♭ (ret a)))

  is-♭-discrete←retract
    : @♭ retract A B → is-♭-discrete B → is-♭-discrete A
  is-♭-discrete←retract R
    = is-equiv←retraction-equiv
        (ε♭-Arrow-map (R .fst))
        (ε♭-retraction-arrow-map R)
}
}

\subtree[stt-00OY]{
\title{Flat discrete types are closed under crisp equivalences}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
module _ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} where

  ε♭-Arrow-equiv←equiv
    : @♭ A ≃ B → Arrow-equiv (ε♭: A) (ε♭: B)
  ε♭-Arrow-equiv←equiv e
    = ε♭-Arrow-map (e ._≃_.fwd)
    , is-♭-equiv←is-equiv (e ._≃_.fwd-is-equiv)
    , e ._≃_.fwd-is-equiv

  is-♭-discrete←equiv
    : @♭ A ≃ B → is-♭-discrete A → is-♭-discrete B
  is-♭-discrete←equiv e = tgt-is-equiv←Arrow-equiv (ε♭-Arrow-equiv←equiv e)
}
}

\subtree[stt-00P2]{
\title{Flat discrete types are closed under universe lifts}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
ULift-is-♭-discrete
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
    → is-♭-discrete A → is-♭-discrete (ULift 𝓥 A)
ULift-is-♭-discrete = is-♭-discrete←equiv lift≃
}
}


\subtree[stt-00ON]{
\title{Empty types, singletons, booleans and the natural numbers are flat discrete}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
∅-is-♭-discrete : is-♭-discrete ∅
∅-is-♭-discrete .is-equiv.qinv .fst = ¡
∅-is-♭-discrete .is-equiv.qinv .snd .fst (mod♭ ())
∅-is-♭-discrete .is-equiv.qinv .snd .snd ()
∅-is-♭-discrete .is-equiv.coherent (mod♭ ())

𝟙-is-♭-discrete : is-♭-discrete 𝟙
𝟙-is-♭-discrete .is-equiv.qinv .fst = point (mod♭ tt)
𝟙-is-♭-discrete .is-equiv.qinv .snd .fst (mod♭ _) = refl
𝟙-is-♭-discrete .is-equiv.qinv .snd .snd _ = refl
𝟙-is-♭-discrete .is-equiv.coherent (mod♭ _) = refl

is-♭-discrete←is-singleton
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
    → @♭ is-singleton A → is-♭-discrete A
is-♭-discrete←is-singleton as
  = is-♭-discrete←equiv (singleton≃𝟙 as e⁻¹) 𝟙-is-♭-discrete

Bool-is-♭-discrete : is-♭-discrete Bool
Bool-is-♭-discrete .is-equiv.qinv .fst true = mod♭ true
Bool-is-♭-discrete .is-equiv.qinv .fst false = mod♭ false
Bool-is-♭-discrete .is-equiv.qinv .snd .fst (mod♭ true) = refl
Bool-is-♭-discrete .is-equiv.qinv .snd .fst (mod♭ false) = refl
Bool-is-♭-discrete .is-equiv.qinv .snd .snd true = refl
Bool-is-♭-discrete .is-equiv.qinv .snd .snd false = refl
Bool-is-♭-discrete .is-equiv.coherent (mod♭ true) = refl
Bool-is-♭-discrete .is-equiv.coherent (mod♭ false) = refl

ℕ-is-♭-discrete : is-♭-discrete ℕ
ℕ-is-♭-discrete = mk-eqv qinv coh where
  bwd : ℕ → ⟨♭| ℕ ⟩
  bwd zero = mod♭ zero
  bwd (suc n) = ♭-map suc (bwd n)

  bwd-ε : ε♭ ∘ bwd ~ id
  bwd-ε zero = refl
  bwd-ε (suc n) = ε♭-natural (bwd n) ∙ ap suc (bwd-ε n)

  bwd-η : ∀ (@♭ n : ℕ) → bwd n ＝ mod♭ n
  bwd-η zero = refl
  bwd-η (suc n) = ap (♭-map suc) (bwd-η n)

  qinv : quasi-inv (ε♭: ℕ)
  qinv .fst = bwd
  qinv .snd .fst (mod♭ n) = bwd-η n
  qinv .snd .snd = bwd-ε

  opaque
    coh : qinv-coh qinv
    coh (mod♭ zero) = refl
    coh (mod♭ (suc n))
      = sym (ap-∘ ε♭ (♭-map suc) (bwd-η n))
      ∙ sym (∙-reflr (ap (ε♭ ∘ ♭-map suc) (bwd-η n)))
      ∙ sym (homotopy-natural ε♭-natural (bwd-η n))
      ∙ ap (ε♭-natural (bwd n) ∙_)
           (ap-∘ suc ε♭ (bwd-η n) ∙ ap (ap suc) (coh (mod♭ n)))
}
}

\subtree[stt-00OV]{
\title{Coproducts of flat discrete types are flat discrete}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
module _ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} where

  ⊎-ε♭-is-equiv
    : is-♭-discrete A
    → is-♭-discrete B
    → is-equiv ((ε♭: A) ⨄₁ (ε♭: B))
  ⊎-ε♭-is-equiv ad bd = is-equiv←qinv
    ( is-equiv.bwd ad ⨄₁ is-equiv.bwd bd
    , ⨄₁-∘ (is-equiv.bwd ad) (is-equiv.bwd bd) ε♭ ε♭
      ∙h ⊎₁~ (is-equiv.η ad) (is-equiv.η bd)
      ∙h ⨄₁-id
    , ⨄₁-∘ ε♭ ε♭ (is-equiv.bwd ad) (is-equiv.bwd bd)
      ∙h ⊎₁~ (is-equiv.ε ad) (is-equiv.ε bd)
      ∙h ⨄₁-id)

  ⊎-is-♭-discrete
    : is-♭-discrete A
    → is-♭-discrete B
    → is-♭-discrete (A ⊎ B)
  ⊎-is-♭-discrete ad bd
    = is-equiv-~∘ H (⊎-ε♭-is-equiv ad bd) ♭-⊎-is-equiv
    where
    H : ε♭: (A ⊎ B) ~ ((ε♭: A) ⨄₁ (ε♭: B)) ∘ ♭-⊎
    H (mod♭ (inl a)) = refl
    H (mod♭ (inr b)) = refl
}
}

\subtree[stt-00OO]{
\title{Identity types of flat discrete types are flat discrete}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
＝-is-♭-discrete
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
    → is-♭-discrete A
    → is-♭-discrete (a ＝ b)
＝-is-♭-discrete ad
  = is-equiv-~∘ (ε♭-mapply♭ h⁻¹) (is-embedding←is-equiv ad) mapply♭-is-equiv
}
}

\subtree[stt-00OS]{
\title{Dependent sums of flat discrete types are flat discrete}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
module _ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : A → Type 𝓥} where

  Σ♭-ε-is-equiv
    : is-♭-discrete A
    → ((@♭ a : A) → is-♭-discrete (B a))
    → is-equiv (Σ♭-ε B)
  Σ♭-ε-is-equiv ad bd
    = is-equiv←~
        (Σ♭-ε~map-ε♭ B)
        (map-Σ-is-equiv ad (ε♭ᶠ-is-fibrewise-equiv bd))

  Σ-is-♭-discrete
    : is-♭-discrete A
    → ((@♭ a : A) → is-♭-discrete (B a))
    → is-♭-discrete (Σ A B)
  Σ-is-♭-discrete ad bd
    = is-equiv-~∘ H
          (Σ♭-ε-is-equiv ad bd)
          (is-equiv⁻¹ (♭-commΣ B ._≃_.fwd-is-equiv))
    where
    H : ε♭ ~ Σ♭-ε B ∘ ♭-Σ' B
    H (mod♭ ab) = refl
}
}

\subtree[stt-00OQ]{
\title{Cartesian products of flat discrete types are flat discrete}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
×-is-♭-discrete
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → is-♭-discrete A
    → is-♭-discrete B
    → is-♭-discrete (A × B)
×-is-♭-discrete ad bd = Σ-is-♭-discrete ad (λ _ → bd)
}
}

\subtree[stt-00JH]{
\taxon{Lemma}

\p{Given a crisp #{\flat}-discrete type #{A}, and any other crisp type #{B}, the
canonical map #{\modflat{A \to \modflat{B}} \to \modflat{A \to B}} is an
equivalence.}

\agda{
♭-discrete-UP
  : ∀ {@♭ 𝓤 𝓥}  {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → @♭ is-♭-discrete A
    → is-equiv {A = ⟨♭| (A → ⟨♭| B ⟩) ⟩} (♭-map (postcomp _ ε♭))
♭-discrete-UP ad = is-equiv←qinv
  ( (λ where (mod♭ f) → mod♭ λ a → ♭-map f (is-equiv.bwd ad a))
  , (λ where (mod♭ f) → mapply♭ (mod♭ (funext→ (λ a
                           → ♭-∘ ε♭ f _
                           ∙ ♭-map-ε♭ _
                           ∙ ε♭-natural (is-equiv.bwd ad a)
                           ∙ ap f (is-equiv.ε ad a)))))
  , (λ where (mod♭ f) → mapply♭ (mod♭ (funext→ (λ a
                           → ε♭-natural {f = f} (is-equiv.bwd ad a)
                           ∙ ap f (is-equiv.ε ad a))))))
}
}
