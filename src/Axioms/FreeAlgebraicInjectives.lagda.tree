\date{2025-06-17}
\title{The Free Algebraically Injective HIT}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
module Axioms.FreeAlgebraicInjectives where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.Arrows
open import Core.LiftingSquares
open import Core.PullbackPowers
}
}

\subtree[stt-005L]{
\taxon{Definition}
\title{Lifting operations between maps}

\quiver{
\begin{tikzcd}
	A && X \\
	\\
	B && Y
	\arrow[from=1-1, to=1-3]
	\arrow["f"', from=1-1, to=3-1]
	\arrow["g", from=1-3, to=3-3]
	\arrow[dashed, from=3-1, to=1-3]
	\arrow[from=3-1, to=3-3]
\end{tikzcd}
}

\p{
[Orthogonal maps](stt-004A) require uniqueness of
lifting solution to lifting problems as above. When this
uniqueness requirement is lifted we can speak of the type
of \em{lifting operations} between a pair of maps, which give a chosen
lift for each lifting problem. When this type is only merely
inhabited we say that #{g} \em{merely lifts} against #{f}, and that
#{g} has the \em{lifting property} with respect to #{f}.
}

\p{
Due to dependency order, we cannot define the notion of lifting property in
this module.
}

\agda{
module _ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}  {X : Type 𝓦} {Y : Type 𝓛} where

  lifting-operation
    : (f : A → B) (g : X → Y) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓛)
  lifting-operation f g = (H : Arrow-map f g) → Lift H
}
}

\subtree[stt-005N]{
\taxon{Theorem}
\title{Lifting operations give a section of the pullback power}

\p{The type of lifting operations between #{f} and #{g}
is equivalent to type of sections of the [pullback power](stt-004D)
 #{\pullpow{f}{g}}.}

\agda{
sec-pb-power←lifting-operation
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → lifting-operation f g
    → section (pullback-power f g)
sec-pb-power←lifting-operation {f = f} {g} lift
  = section←fibres _ fib where
  fib : ∀ (H : Arrow-map f g) → fibre (pullback-power f g) H
  fib H =  _≃_.bwd (pb-power-fibre≃lifts _ _ _) (lift H)

sec-pb-power≃lifting-operation
  : ∀ {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
      {C : Type 𝓦} {D : Type 𝓛}
      {f : A → B} {g : C → D}
    → lifting-operation f g
    ≃ section (pullback-power f g)
sec-pb-power≃lifting-operation {f = f} {g}
  = Π (Arrow-map f g) Lift
      ≃⟨ postcomp-Π-≃ (λ c → pb-power-fibre≃lifts _ _ c e⁻¹) ⟩
    Π (Arrow-map f g) (fibre (pullback-power f g))
      ≃⟨ section≃fibres _ ⟩
    section (pullback-power f g) ≃∎
}
}

\subtree[stt-005O]{
\title{Lifting operations for types}
\taxon{Definition}

\p{
A lifting operation for a type mirrors the definitions
for the stronger notion of [orthogonality at types](stt-004O).
We require not that the precomposition by #{f} is an equivalence,
but instead talk about the \em{type} of sections to postcomposition by #{f}.
}

\p{
A \em{lifting operation} for the type #{X} with respect to a map #{f \colon A \to B}
is a section of #{X^f \colon (B \to X) \to (A \to X)}.
}

\agda{
lifting-operation-for-type
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
      (f : A → B) (X : Type 𝓦)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
lifting-operation-for-type f X = section (precomp X f)
}
}

\subtree[stt-005P]{
\taxon{Theorem}

\p{
Mirroring the [corresponding theorem](stt-004Q) for orthogonality,
we can say that the type of lifting operations for the type #{X} against #{f}
is equivalent to the type of lifting operations for the map #{! \colon A \to 1}
against #{f}.
}

\todo{Proof!}
}

\subtree[stt-005J]{
\taxon{Definition}
\title{Algebraically injective types}

\p{
Given a family of maps #{f_i \colon A_i \to B_i}, we say that the type
of \em{algebraic} #{f\rm{-injectives}} for #{X} is, for any map
#{a \colon A_i \to X}, a choice of extension for #{a} along #{f_i}. That
is, the following diagram commutes for all #{i}:
}

\quiver{
\begin{tikzcd}
	{A_i} && X \\
	\\
	{B_i}
	\arrow["{a_i}", from=1-1, to=1-3]
	\arrow["{f_i}"', from=1-1, to=3-1]
	\arrow[dashed, from=3-1, to=1-3]
\end{tikzcd}
}

\p{We observe that this definition is equivalent to asking for
a chosen [lifting operation](stt-005O) for #{X} against each #{f_i}.}

\agda{
Algebraic-injective
  : ∀ {𝓘 𝓤 𝓥 𝓦} {I : Type 𝓘}
      {A : I → Type 𝓤} {B : I → Type 𝓥}
      (f : (i : I) → A i → B i)
      (X : Type 𝓦)
    → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
Algebraic-injective f X = ∀ i → lifting-operation-for-type (f i) X

lift-alg-inj
  : ∀ {𝓘 𝓤 𝓥 𝓦} {I : Type 𝓘}
      {A : I → Type 𝓤} {B : I → Type 𝓥}
      {f : (i : I) → A i → B i}
      {X : Type 𝓦}
    → Algebraic-injective f X
    → (i : I) (p : A i → X)
    → B i → X
lift-alg-inj alg i = alg i .fst
}
}

\subtree[ub-00E0]{
\date{2026-10-21}
\taxon{Definition}
\title{Indexed free algebraically injective families}
\author{ulrikbuchholtz}

\p{
We shall derive the free algebraically injective type on a type
from a more general indexed version. So fix a family of maps
#{f_i \colon A_i \to B_i}, an index type #{G}, and labelings
#{\tau_i \colon B_i \to G}, from which we get source labelings
#{\tau_i \circ f_i}. For a family #{X \colon G \to \UU}, the free
algebraically injective family #{\mathcal{J}_{f,\tau}(X) \colon G \to \UU}
is the indexed higher inductive type with constructors:
}

\ul{
\li{#{\eta \colon X(g) \to \mathcal{J}_{f,\tau}(X)(g)}}
\li{#{\rm{ext}_i \colon (\Pi_{a : A_i} \mathcal{J}_{f,\tau}(X)(\tau_i(f_i(a))))
  \to \Pi_{b : B_i} \mathcal{J}_{f,\tau}(X)(\tau_i(b))}}
\li{#{\rm{isext}_i \colon \Pi2{t}{a : A_i}{\rm{ext}_i(t,f_i(a)) = t(a)}}}
}

\p{
We postulate the type, its constructors, the eliminator and
its computation rules. The computation rule for #{\rm{ext}_i} computes the
eliminator on #{\rm{ext}_i(t, b)} using the eliminator itself on #{t}.
}

\agda{
module _ {𝓖 𝓘 𝓤 𝓥 𝓦} {G : Type 𝓖} {I : Type 𝓘}
  {A : I → Type 𝓤} {B : I → Type 𝓥} where

  postulate
    IndexedFreeInj
      : (f : (i : I) → A i → B i) (τ : (i : I) → B i → G)
      → (G → Type 𝓦) → G → Type (𝓖 ⊔ 𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)

  module IndexedFreeInj
    {f : (i : I) → A i → B i} {τ : (i : I) → B i → G}
    {X : G → Type 𝓦} where

    private
      𝒥 = IndexedFreeInj f τ X

    postulate
      inc : {g : G} → X g → 𝒥 g
      ext
        : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
        → (b : B i) → 𝒥 (τ i b)
      is-ext
        : {i : I}
          (t : (a : A i) → 𝒥 (τ i (f i a)))
          (a : A i)
        → ext t (f i a) ＝ t a

      ind
        : ∀ {𝓜} (P : (g : G) → 𝒥 g → Type 𝓜)
            (N : {g : G} (x : X g) → P g (inc x))
            (R : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
               → (b : B i) → P (τ i b) (ext t b))
            (S : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
                 (a : A i)
               → tr (P (τ i (f i a))) (is-ext t a) (R t h (f i a)) ＝ h a)
          → (g : G) (x : 𝒥 g) → P g x

      ind-inc
        : ∀ {𝓜} {P : (g : G) → 𝒥 g → Type 𝓜}
            {N : {g : G} (x : X g) → P g (inc x)}
            {R : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
               → (b : B i) → P (τ i b) (ext t b)}
            {S : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
                 (a : A i)
               → tr (P (τ i (f i a))) (is-ext t a) (R t h (f i a)) ＝ h a}
          → {g : G} (x : X g) → ind P N R S g (inc x) ＝ N x

      ind-ext
        : ∀ {𝓜} {P : (g : G) → 𝒥 g → Type 𝓜}
            {N : {g : G} (x : X g) → P g (inc x)}
            {R : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
               → (b : B i) → P (τ i b) (ext t b)}
            {S : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
                 (a : A i)
               → tr (P (τ i (f i a))) (is-ext t a) (R t h (f i a)) ＝ h a}
          → {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
          → (b : B i)
          → ind P N R S (τ i b) (ext t b)
          ＝ R t (λ a → ind P N R S (τ i (f i a)) (t a)) b

    {-# REWRITE ind-inc ind-ext #-}

    postulate
      ind-is-ext
        : ∀ {𝓜} {P : (g : G) → 𝒥 g → Type 𝓜}
            {N : {g : G} (x : X g) → P g (inc x)}
            {R : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
               → (b : B i) → P (τ i b) (ext t b)}
            {S : {i : I} (t : (a : A i) → 𝒥 (τ i (f i a)))
                 (h : (a : A i) → P (τ i (f i a)) (t a))
                 (a : A i)
               → tr (P (τ i (f i a))) (is-ext t a) (R t h (f i a)) ＝ h a}
          → {i : I} (t : (a : A i) → 𝒥 (τ i (f i a))) (a : A i)
          → apᶠ (ind P N R S (τ i (f i a))) (is-ext t a)
          ＝ S t (λ a' → ind P N R S (τ i (f i a')) (t a')) a
}
}

\subtree[stt-005I]{
\taxon{Definition}
\title{Free algebraically injective types}
\citek{RSS20}

\p{
Given a family of maps #{f_i \colon A_i \to B_i} and a type #{X}, we have
the free algebraically #{f\rm{-injective}} type on #{X}, called
#{\mathcal{J}_{f}(X)}, as the following higher inductive type:
}

\ul{
\li{#{\eta \colon X \to \mathcal{J}_{f}(X)}}
\li{#{\rm{ext}_i \colon (A_i \to \mathcal{J}_{f}(X)) \to (B_i \to \mathcal{J}_{f}(X))}}
\li{#{\rm{isext}_i \colon \Pi2{g : A_i \to \mathcal{J}_{f}(X)}{a : A_i}{\rm{ext}_i(g,f(a)) = g(a)}}}
}

\p{
This is the [indexed free algebraically injective family](ub-00E0) over the
unit type. Its constructors, eliminator and computation rules are those of
the indexed type, and the computation rules for #{\eta} and #{\rm{ext}_i}
hold definitionally.
}

\agda{
module _ {𝓘 𝓤 𝓥 𝓦} {I : Type 𝓘} {A : I → Type 𝓤} {B : I → Type 𝓥} where

  FreeInj
    : (f : (i : I) → A i → B i) → Type 𝓦 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
  FreeInj f X = IndexedFreeInj f (λ _ _ → tt) (λ _ → X) tt

  module FreeInj {f : (i : I) → A i → B i} {X : Type 𝓦} where

    private
      module 𝒥 = IndexedFreeInj {f = f} {τ = λ _ _ → tt} {X = λ _ → X}

    inc : X → FreeInj f X
    inc = 𝒥.inc

    ext : {i : I} (g : A i → FreeInj f X) → B i → FreeInj f X
    ext = 𝒥.ext

    is-ext
      : {i : I}
        (g : A i → FreeInj f X)
        (a : A i)
      → ext g (f i a) ＝ g a
    is-ext = 𝒥.is-ext

    ind
      : ∀ {𝓜} (P : FreeInj f X → Type 𝓜)
          (N : (x : X) → P (inc x))
          (R : {i : I} (g : A i → FreeInj f X)
               (h : (a : A i) → P (g a))
             → (b : B i) → P (ext g b))
          (S : {i : I} (g : A i → FreeInj f X)
               (h : (a : A i) → P (g a))
               (a : A i)
             → tr P (is-ext g a) (R g h (f i a)) ＝ h a)
        → (x : FreeInj f X) → P x
    ind P N R S = 𝒥.ind (λ _ → P) N R S tt

    module _ {𝓜} {P : FreeInj f X → Type 𝓜}
      {N : (x : X) → P (inc x)}
      {R : {i : I} (g : A i → FreeInj f X)
           (h : (a : A i) → P (g a))
         → (b : B i) → P (ext g b)}
      {S : {i : I} (g : A i → FreeInj f X)
           (h : (a : A i) → P (g a))
           (a : A i)
         → tr P (is-ext g a) (R g h (f i a)) ＝ h a}
      where

      ind-inc : (x : X) → ind P N R S (inc x) ＝ N x
      ind-inc x = refl

      ind-ext
        : {i : I} (g : A i → FreeInj f X) (b : B i)
        → ind P N R S (ext g b) ＝ R g (ind P N R S ∘ g) b
      ind-ext g b = refl

      ind-is-ext
        : {i : I} (g : A i → FreeInj f X) (a : A i)
        → apᶠ (ind P N R S) (is-ext g a)
        ＝ S g (ind P N R S ∘ g) a
      ind-is-ext g a = 𝒥.ind-is-ext g a
}
}

\subtree[ub-00E1]{
\date{2026-10-21}
\taxon{Definition}
\title{Free dependent lifting families}
\author{ulrikbuchholtz}

\p{
As in \citet{§2.4}{RSS20}, given a family of maps #{F_a \colon B_a \to C_a}
and a family #{X \colon Y \to \UU}, we can also define the indexed higher
inductive type #{J^Y_F(X) \colon Y \to \UU} with the following constructors:
}

\ul{
\li{#{\beta \colon X(y) \to J^Y_F(X)(y)}}
\li{#{\rm{lift} \colon \Pi1{g : C_a \to Y}{(\Pi_{b : B_a} J^Y_F(X)(g(F_a(b))))
  \to \Pi_{c : C_a} J^Y_F(X)(g(c))}}}
\li{#{\rm{islift} \colon \Pi2{g, f}{b : B_a}{\rm{lift}(g, f, F_a(b)) = f(b)}}}
}

\p{
These give a specified dependent filler for every square from #{F_a} to
#{\Sigma1{y : Y}{J^Y_F(X)(y)} \to Y}. It reduces to the
[indexed free algebraically injective family](ub-00E0) whose cells are the
pairs #{(a, g)} with #{g \colon C_a \to Y}, each labelled by #{g} itself. The
indexed family is more general, because each cell gets a fixed label.
}

\agda{
module _
  {𝓨 𝓐 𝓑 𝓒 𝓧} {Y : Type 𝓨} {A : Type 𝓐}
  {B : A → Type 𝓑} {C : A → Type 𝓒}
  where

  FreeLift
    : (F : (a : A) → B a → C a)
    → (Y → Type 𝓧) → Y → Type (𝓨 ⊔ 𝓐 ⊔ 𝓑 ⊔ 𝓒 ⊔ 𝓧)
  FreeLift F X
    = IndexedFreeInj {I = Σ A (λ a → C a → Y)} {A = B ∘ fst} {B = C ∘ fst}
        (λ i → F (fst i)) snd X

  module FreeLift {F : (a : A) → B a → C a} {X : Y → Type 𝓧} where

    private
      module 𝒥 = IndexedFreeInj
        {I = Σ A (λ a → C a → Y)} {A = B ∘ fst} {B = C ∘ fst}
        {f = λ i → F (fst i)} {τ = snd} {X = X}

    β : {y : Y} → X y → FreeLift F X y
    β = 𝒥.inc

    lift
      : {a : A} (g : C a → Y) (f : (b : B a) → FreeLift F X (g (F a b)))
      → (c : C a) → FreeLift F X (g c)
    lift g = 𝒥.ext {i = (_ , g)}

    is-lift
      : {a : A} (g : C a → Y) (f : (b : B a) → FreeLift F X (g (F a b)))
        (b : B a)
      → lift g f (F a b) ＝ f b
    is-lift g = 𝒥.is-ext {i = (_ , g)}

    ind
      : ∀ {𝓜} (P : (y : Y) → FreeLift F X y → Type 𝓜)
          (N : {y : Y} (x : X y) → P y (β x))
          (R : {a : A} (g : C a → Y)
               (f : (b : B a) → FreeLift F X (g (F a b)))
               (h : (b : B a) → P (g (F a b)) (f b))
             → (c : C a) → P (g c) (lift g f c))
          (S : {a : A} (g : C a → Y)
               (f : (b : B a) → FreeLift F X (g (F a b)))
               (h : (b : B a) → P (g (F a b)) (f b))
               (b : B a)
             → tr (P (g (F a b))) (is-lift g f b) (R g f h (F a b)) ＝ h b)
        → (y : Y) (w : FreeLift F X y) → P y w
    ind P N R S = 𝒥.ind P N (λ {i} → R (snd i)) (λ {i} → S (snd i))

    module _ {𝓜} {P : (y : Y) → FreeLift F X y → Type 𝓜}
      {N : {y : Y} (x : X y) → P y (β x)}
      {R : {a : A} (g : C a → Y)
           (f : (b : B a) → FreeLift F X (g (F a b)))
           (h : (b : B a) → P (g (F a b)) (f b))
         → (c : C a) → P (g c) (lift g f c)}
      {S : {a : A} (g : C a → Y)
           (f : (b : B a) → FreeLift F X (g (F a b)))
           (h : (b : B a) → P (g (F a b)) (f b))
           (b : B a)
         → tr (P (g (F a b))) (is-lift g f b) (R g f h (F a b)) ＝ h b}
      where

      ind-β : {y : Y} (x : X y) → ind P N R S y (β x) ＝ N x
      ind-β x = refl

      ind-lift
        : {a : A} (g : C a → Y) (f : (b : B a) → FreeLift F X (g (F a b)))
          (c : C a)
        → ind P N R S (g c) (lift g f c)
        ＝ R g f (λ b → ind P N R S (g (F a b)) (f b)) c
      ind-lift g f c = refl

      ind-is-lift
        : {a : A} (g : C a → Y) (f : (b : B a) → FreeLift F X (g (F a b)))
          (b : B a)
        → apᶠ (ind P N R S (g (F a b))) (is-lift g f b)
        ＝ S g f (λ b' → ind P N R S (g (F a b')) (f b')) b
      ind-is-lift g f b = 𝒥.ind-is-ext {i = (_ , g)} f b
}
}

\subtree[stt-005W]{
\date{2025-06-18}
\title{Free algebraically injective types are algebraically injective}
\taxon{Theorem}

\agda{
module _ {𝓘 𝓤 𝓥 𝓦} {I : Type 𝓘} {A : I → Type 𝓤} {B : I → Type 𝓥} where

  injector-FreeInj
    : {f : (i : I) → A i → B i}
      {X : Type 𝓦}
    → Algebraic-injective f (FreeInj f X)
  injector-FreeInj i .fst = FreeInj.ext
  injector-FreeInj i .snd α
    = funext→ (FreeInj.is-ext α)
}
}

\subtree[stt-0068]{
\title{Morphisms of algebraic injectives}
\date{2025-06-21}

\p{
Given a pair of algebraic injectives #{(X,x)} and #{(Y,y)} over
the same family of maps, #{f_i}, we define the type of morphisms
of algebraic injectives: #{\Hom((X,x), (Y,y))} to be the
type of maps which commute coherently with the given extensions.
}

\quiver{
\begin{tikzcd}
	& X \\
	{A_i} && Y \\
	\\
	{B_i}
	\arrow["\alpha", from=1-2, to=2-3]
	\arrow["{p_x}", from=2-1, to=1-2]
	\arrow["{\alpha p_x}"{description}, from=2-1, to=2-3]
	\arrow["{f_i}"', from=2-1, to=4-1]
	\arrow[dashed, from=4-1, to=1-2]
	\arrow[dashed, from=4-1, to=2-3]
\end{tikzcd}
}

\agda{
record Algebraic-injective-map
    {𝓘 𝓤 𝓥 𝓦 𝓜} {I : Type 𝓘}
    {A : I → Type 𝓤} {B : I → Type 𝓥}
    {f : (i : I) → A i → B i}
    {X : Type 𝓦} (X-alg : Algebraic-injective f X)
    {Y : Type 𝓜} (Y-alg : Algebraic-injective f Y)
    (α : X → Y)
  : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜) where
  field

    ext-comm
      : ∀ i p
        → (α ∘ lift-alg-inj X-alg i p)
        ~ lift-alg-inj Y-alg i (α ∘ p)
    ext-comm-coh
      : ∀ i
        → (postcomp (A i) α ◃h X-alg i .snd)
        ~ (λ a → funext→ (ext-comm i a ∘ f i)) ∙h Y-alg i .snd ▹h postcomp (A i) α
}
}

\subtree[stt-0067]{
\date{2025-06-21}
\title{The universal property for free algebraic injectives}
\taxon{Theorem}

\p{
We show that any map into an algebraically injective type
factors through the free algebraically injective type. In other
words, given types #{X} and #{Y}, where #{X} is an algebraically
injective type, the map #{{-} \circ \eta \colon (\mathcal{J}_{f}(X) \to Y) \to
(X \to Y)} is an equivalence.
}

\todo{Proof}
}
