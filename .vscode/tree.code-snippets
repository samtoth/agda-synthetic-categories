{
  "date": {
    "prefix": "\\date{",
    "body": "\\date{${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}}",
    "include": ["**/*.tree", "**/*.lagda.tree"],
  },
  "Agda block": {
    "prefix": "\\agda{",
    "body": ["\\agda{", "$1", "}"],
    "include": ["**/*.tree", "**/*.lagda.tree"],
  },
  "Quiver": {
    "prefix": "\\quiver{",
    "body": [
      "\\quiver{",
      "\\begin{tikzcd}",
      "$0",
      "\\arrow[from=?-?, to=?-?]",
      "\\end{tikzcd}",
      "}",
    ],
  },
  "Cube quiver": {
    "prefix": ["cube quiver"],
    "body": [
      "\\quiver{",
      "\\begin{tikzcd}",
      "? && ? \\\\\\",
      "& ? && ? \\\\\\",
      "? && ? \\\\\\",
      "& ? && ?",
      "% horizontal",
      "\\arrow[from=1-1, to=1-3]",
      "\\arrow[from=2-2, to=2-4]",
      "\\arrow[from=3-1, to=3-3]",
      "\\arrow[from=4-2, to=4-4]",
      "% vertical",
      "\\arrow[from=1-1, to=3-1]",
      "\\arrow[from=1-3, to=3-3]",
      "\\arrow[from=2-2, to=4-2, crossing over]",
      "\\arrow[from=2-4, to=4-4, crossing over]",
      "% diagonal",
      "\\arrow[from=1-1, to=2-2]",
      "\\arrow[from=1-3, to=2-4]",
      "\\arrow[from=3-1, to=4-2]",
      "\\arrow[from=3-3, to=4-4]",
      "\\end{tikzcd}",
      "}",
    ],
  },

  "esh (ʃ)": {
    "prefix": "esh",
    "body": "ʃ",
  },
  "Equational reasoning": {
    "prefix": "equational reasoning",
    "body": "({! $1 !} ＝⟨ {! $2 !} ⟩ {! $3 !} ∎)",
  },
}
