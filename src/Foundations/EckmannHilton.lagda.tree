\subtree[fre-2B35]{
\title{The interchange law}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\p{
Two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type #{X}
satisfy \em{the interchange law} if, for all #{a\ b\ c\ d : X}, the following
equation holds
##{(a \hconcat b) \vconcat (c \hconcat d) = (a \vconcat b) \hconcat (c \vconcat d).}
}

\p{
We say the two binary operations satisfy \em{outer interchange} at an element
#{e : X} if
##{(a \hconcat e) \vconcat (e \hconcat d) = (a \vconcat e) \hconcat (e \vconcat d)}
holds for all #{a\ d : X}, and we say the two binary operations satisfy
\em{inner interchange} at an element #{e : X} if
##{(e \hconcat b) \vconcat (c \hconcat e) = (e \vconcat b) \hconcat (c \vconcat e)}
holds for all #{b\ c : X}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  InterchangeLaw
    : (X → X → X) → (X → X → X) → Type 𝓤
  InterchangeLaw _◾_ _◽_
    = (a b c d : X)
    → (a ◾ b) ◽ (c ◾ d) ＝ (a ◽ c) ◾ (b ◽ d)

  OuterInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  OuterInterchangeLaw _◾_ _◽_ e
    = (a d : X)
    → (a ◾ e) ◽ (e ◾ d) ＝ (a ◽ e) ◾ (e ◽ d)

  InnerInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  InnerInterchangeLaw _◾_ _◽_ e
    = (b c : X)
    → (e ◾ b) ◽ (c ◾ e) ＝ (e ◽ c) ◾ (b ◽ e)
}
}

\subtree[fre-DAF1]{
\title{Outer interchange at the unit implies operations are equal}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{outer interchange law}, for all #{a\ d : X}:
##{(a \hconcat e) \vconcat (e \hconcat d) = (a \vconcat e) \hconcat (e \vconcat d)}
then the two binary operations are equal.
}

\agda{
equal-ops←outer-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → OuterInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ x ◾ y
equal-ops←outer-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ outer-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (r◾ x) (l◾ y)) ⟩
    (x ◾ e) ◽ (e ◾ y)
      ＝⟨ outer-◾-◽-interchange x y ⟩
    (x ◽ e) ◾ (e ◽ y)
      ＝⟨ ap₂ (_◾_) (r◽ x) (l◽ y) ⟩
    x ◾ y ∎
}
}

\subtree[fre-11E4]{
\title{Inner interchange at the unit implies operations are opposites}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{inner interchange law}, for all #{b\ c : X}:
##{(e \hconcat b) \vconcat (c \hconcat e) = (e \vconcat b) \hconcat (c \vconcat e)}
then the two binary operations are opposites: #{b \hconcat c = c \vconcat b}.
}

\agda{
opposite-ops←inner-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InnerInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ y ◾ x
opposite-ops←inner-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ inner-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (l◾ x) (r◾ y)) ⟩
    (e ◾ x) ◽ (y ◾ e)
      ＝⟨ inner-◾-◽-interchange x y ⟩
    (e ◽ y) ◾ (x ◽ e)
      ＝⟨ ap₂ (_◾_) (l◽ y) (r◽ x) ⟩
    y ◾ x ∎
}
}

\subtree[fre-D0CE]{
\title{The algebraic Eckmann–Hilton argument}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{interchange law} for all #{a\ b\ c\ d : X}:
##{(a \hconcat b) \vconcat (c \hconcat d) = (a \vconcat b) \hconcat (c \vconcat d)}
then the two binary operations are equal and commutative.
}

\proof{
We have seen that outer interchange gives #{x \hconcat y = x \vconcat y},
and that inner interchange gives #{x \hconcat y = y \vconcat x}, hence
#{x \vconcat y = y \vconcat x}.
}

\agda{
comm←interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InterchangeLaw (_◾_) (_◽_)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
comm←interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ ◾-◽-interchange x y
  = equal-ops←outer-interchange
      (_◾_) (_◽_) e l◾ r◾ l◽ r◽
      (λ a d → ◾-◽-interchange a e e d)
      (x)
      (y)
  ∙ sym
      ( opposite-ops←inner-interchange
        (_◾_) (_◽_) e l◾ r◾ l◽ r◽
        (λ b c → ◾-◽-interchange e b c e)
        (y)
        (x))
}
}

\subtree[fre-98A0]{
\title{The Eckmann–Hilton argument for double loop spaces}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-28}

\p{The concatenation operation on double loop spaces is commutative.}


\p{
For concatenation of double loop spaces, a more direct construction of the symmetry
exists which avoids going via horizontal concatenation.
}

\agda{
comm←interchange'
  : ∀ {𝓤} {X : Type 𝓤} (_◽_ : X → X → X) (L R : X → X)
    → L ~ id → R ~ id
    → ((x y : X) → L x ◽ R y ＝ R y ◽ L x)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
comm←interchange' _◽_ L R l r L◽R-commute x y
  = sym (ap₂ (_◽_) (l x) (r y)) ∙ L◽R-commute x y ∙ ap₂ (_◽_) (r y) (l x)

∙Ω²-comm
  : ∀ {𝓤} {X : Type 𝓤} {a : X} (p q : Ω² a) → p ∙ q ＝ q ∙ p
∙Ω²-comm
  = comm←interchange' (_∙_) (refl ◂_) (_▸ refl)
      (◂-left-unit)
      (▸-right-unit')
      (λ p q → ◂▸-∙-interchange q p)
}
}
