\date{2025-02-19}
\author{samueltoth}
\tag{macro}

\export{basic-macros}
\export{agda-macros}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\citek[refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}{[\escape{[\refid]}](\refid)}}

\def\citet[tid][refid]{
\let\escape[x]{\x}\<html:span>[class]{link-reference}[tid]{\tid}[refid]{\refid}{[\escape{[\refid, \tid]}](\refid)}
}

\def\PR[x]{[PR\startverb#\stopverb\x](https://github.com/samtoth/agda-synthetic-categories/pull/\x)}

\def\embed[src]{
  \<html:embed>[type]{text/html}[src]{\src}{}
}

\def\hidden[x]{}

\def\rm[x]{\textrm{\x}}

\def\tot[x]{{\startverb \~\stopverb{\x}}}

\def\refl{\mathrm{refl}}
\def\true{\mathrm{true}}
\def\false{\mathrm{false}}
\def\Bool{\mathrm{Bool}}

\def\Fin{\operatorname{Fin}}

\def\Type{\mathsf{Type}}
\def\Prop{\mathsf{Prop}}
\def\Empty{\mathsf{Empty}}

\def\b1{\mathbb{1}}
\def\b2{\mathbb{2}}
\def\bR{\mathbb{R}}
\def\bQ{\mathbb{Q}}
\def\bZ{\mathbb{Z}}
\def\bN{\mathbb{N}}


\def\UU{\mathcal{U}}
\def\UV{\mathcal{V}}
\def\UW{\mathcal{W}}

\def\CC{\mathcal{C}}
\def\CD{\mathcal{D}}
\def\CE{\mathcal{E}}
\def\SS{#{\mathcal{S}}}

\def\fibre-noarg{\operatorname{\mathrm{fib}}}
\def\fibre-fam[f]{\fibre-noarg_{\f}}
\def\fibre[f][a]{\fibre-fam{\f}(\a)}

\def\cofibre-noarg{\operatorname{\mathrm{cofib}}}
\def\cofibre[f]{\cofibre-noarg_{\f}}

\def\op{\mathfrak{op}}

\def\id{\operatorname{id}}
\def\ap{\operatorname{ap}}
\def\fst{\operatorname{fst}}
\def\snd{\operatorname{snd}}
\def\glue{\operatorname{glue}}
\def\point{\operatorname{point}}

\def\depid[p]{=_{\p}}

\def\lhtpy{\sim_{\Delta}}
\def\rhtpy{\mathrel{{}_{\Delta}{\sim}}}


\def\II{\mathbb{I}}
\def\Spec{\operatorname{Spec}}
\def\Alg{\mathrm{Alg}}
\def\Obs{\operatorname{\mathcal{O}}}

\def\Hom{\operatorname{Hom}}
\def\Iso{\operatorname{Iso}}
\def\Hom2{\Hom^2}

\def\Arr{\operatorname{Arr}}

\def\modflat[x]{\langle \flat | \x \rangle}
\def\modsharp[x]{\langle \sharp | \x \rangle}
\def\mod{\textsf{mod}}

\def\toeq{\xrightarrow{\sim}}

\def\qed{#{\square}}

\def\proof[body]{
\scope{
  \put\transclude/toc{false}
  \subtree{
    \taxon{Proof}
    \body
    \qed
  }
}
}

\def\ttt{#{\boxslash}}

\def\const{\operatorname{const}}
\def\ev{\operatorname{ev}}
\def\nullhtpy{\operatorname{\textrm{null{-}htpy}}}

\def\pulldpow{\operatorname{\hat{\mathsf{\Pi}}}}
\def\pullpow[f][g]{{\left\langle{\f},{\g}\right\rangle}}
\def\pushsum{\operatorname{\hat{\mathsf{\Sigma}}}}
\def\pushprod{\mathbin{\square}}

\def\bjoin{\mathbin{\diamond}}


\def\remark[body]{
\scope{
  \put\transclude/toc{false}
\subtree{
  \taxon{Remark}
  \body
}
}
}

\def\closedScope[~body]{
\scope{
  \put\transclude/toc{false}
  \put\transclude/expanded{false}
  \body{}
}
}

\def\todo[x]{
\scope{
   \put\transclude/toc{false}
\subtree{
   \taxon{Todo}
   \<html:p>[style]{color: red;}{\x}
}
}
}

\def\details[x]{
 \<html:details>{\x}
}


% Ordered list styles


\def\ol-alpha[body]{ % a)
\<html:style>{\startverb
.ol-alpha > li::marker { content: counter(list-item, lower-alpha) ") " }
\stopverb}
\<html:ol>[class]{ol-alpha}{\body}
}

\def\ol-Alpha[body]{ % A)
\<html:style>{\startverb
.ol-Alpha > li::marker { content: counter(list-item, upper-alpha) ") " }
\stopverb}
\<html:ol>[class]{ol-Alpha}{\body}
}

\def\ol-Alpha-dot[body]{ % A.
\<html:style>{\startverb
.ol-Alpha-dot > li::marker { content: counter(list-item, upper-alpha) ". " }
\stopverb}
\<html:ol>[class]{ol-Alpha-dot}{\body}
}

\def\ol-roman[body]{ % (i)
\<html:style>{\startverb
.ol-roman > li::marker { content: "(" counter(list-item, lower-roman) ") " }
\stopverb}
\<html:ol>[class]{ol-roman}[type]{i}{\body}
}

\def\ol-Roman[body]{ % (I)
\<html:style>{\startverb
.ol-Roman > li::marker { content: "(" counter(list-item, upper-roman) ") " }
\stopverb}
\<html:ol>[class]{ol-Roman}[type]{i}{\body}
}


\def\ol-Roman-dot[body]{ % I.
\<html:style>{\startverb
.ol-Roman-dot > li::marker { content: counter(list-item, upper-roman) ". " }
\stopverb}
\<html:ol>[class]{ol-Roman-dot}[type]{i}{\body}
}
