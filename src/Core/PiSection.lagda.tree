\date{2025-06-26}
\author{samueltoth}
\title{Pi types as sections}
\taxon{Module}
\import{stt-macros}


\agda{
module Core.PiSection where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
}
}


\subtree[stt-006J]{
\taxon{Theorem}
\title{Pi types are sections}

\p{We show that the type #{\Pi_{(a : A)} B(a)} is equivalent to
the type of sections of #{\pi : \Sigma_{(a : A)} B(a)}.}


\agda{
section←Π
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → Π _ B
    → section (fst {B = B})
section←Π {B = B} f = ((λ x → (x , f x)) , ~refl)

section←Π-fibre
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {p : A → B}
    → Π _ (fibre p)
    → section p
section←Π-fibre {A = A} {p = p} = Σ-Π-swap (const A) (λ x a → p a ＝ x)

section←Π-fibre-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {p : A → B}
    → is-equiv (section←Π-fibre {p = p})
section←Π-fibre-is-equiv {A = A} {p = p} = Σ-Π-swap-is-equiv

section≃Π
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → section (fst {B = B})
    ≃ Π _ B
section≃Π {A = A} {B}
  = section fst                                  ≃⟨ Σ-Π-swap≃ _ _ e⁻¹ ⟩
    (∀ (a : A) → Σ[ x ∶ Σ A B ] (fst x ＝ a))    ≃⟨ Π-fam-≃ (λ a → Σ-assoc) ⟩
    ((a : A) → Σ[ a' ∶ A ] ((B a') × (a' ＝ a))) ≃⟨ Π-fam-≃ (λ a
                                                    → Σ-snd-≃ (λ a' → ×-swap)) ⟩
    (((a : A) → Σ[ a' ∶ A ] ((a' ＝ a) × B a'))) ≃⟨ Π-fam-≃ (λ a → Σ-＝singl) ⟩
    Π A B ≃∎

Π←section
  : ∀ {𝓤 𝓥} {A : Type 𝓤}
      {B : A → Type 𝓥}
    → section (fst {B = B})
    → Π _ B
Π←section {B = B} (f , s) a = tr B (s a) (snd (f a))

Π←section-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {p : A → B}
    → section p
    → Π _ (fibre p)
Π←section-map {A = A} {p = p} = _≃_.bwd (Σ-Π-swap≃ (λ _ → A) (λ x a → p a ＝ x))
}
}

\subtree[stt-00KZ]{
\title{Lifts as pi-types}

\p{More generally, given a diagram as follows, which we call a lift
of #{f} along #{\pi}:}

\quiver{
\begin{tikzcd}[cramped]
	&& {\Sigma_BA} \\
	\\
	X && A
	\arrow["\pi"', from=1-3, to=3-3]
	\arrow["{\bar{f}}", from=3-1, to=1-3]
	\arrow["f"', from=3-1, to=3-3]
	\arrow[curve={height=12pt}, dashed, from=3-3, to=1-3]
\end{tikzcd}
}

\p{We show that there is an equivalence between maps that extend #{f} along
#{\pi} and dependent functions #{\Pi_{x : X} B(f(x))}.}

\agda{
LiftMap
  : ∀ {𝓤 𝓥 𝓦} {Γ : Type 𝓤} {E : Type 𝓥} {B : Type 𝓦}
      (p : E → B) (A : Γ → B)
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
LiftMap p A = fibre (postcomp _ p) A

LiftMap←Π
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {X : Type 𝓦} (f : X → A)
    → Π X (B ∘ f) → LiftMap (fst: B) f
LiftMap←Π f g = ((λ x → f x , g x) , refl)

LiftMap≃Π
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {X : Type 𝓦} (f : X → A)
    → LiftMap (fst: B) f ≃ Π X (B ∘ f)
LiftMap≃Π f = fibre-postcomp≃ fst f ∙e postcomp-Π-≃ (fibre-straighten _ ∘ f)

LiftMap←Π-is-equiv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥}
      {X : Type 𝓦} (f : X → A)
    → is-equiv (LiftMap←Π {B = B} f)
LiftMap←Π-is-equiv f
  = is-equiv←~⁻¹
      (λ a → Σ-path→ (refl , funext-refl))
      (bwd-is-equiv (LiftMap≃Π f))
}
}
