\date{2026-08-27}
\title{The Eckmann–Hilton argument}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\def\hconcat{\mathbin{◾}}
\def\vconcat{\mathbin{◽}}
\def\hpaste{\mathbin{◫}}
\def\vpaste{\mathbin{⊟}}
\def\EH{\operatorname{\mathsf{EH}}}
\def\squeeze{\operatorname{\mathsf{squeeze}}}

\agda{
{-# OPTIONS --lossy-unification #-}

module Foundations.EckmannHilton where
}

\agda-imports{
\agda{
open import Foundations.Functions
open import Foundations.Homotopy
open import Foundations.Identity
open import Foundations.IdentityHorizontalConcatenation
open import Foundations.LoopSpaces
open import Foundations.Squares
open import Foundations.Universes
}

\subtree[fre-2B35]{
\title{The interchange law}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\p{
Two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type #{X}
satisfy \em{the interchange law} if, for all #{a\ b\ c\ d : X}, the following
equation holds
##{(a \hconcat b) \vconcat (c \hconcat d) = (a \vconcat b) \hconcat (c \vconcat d).}
}

\p{
We say the two binary operations satisfy \em{outer interchange} at an element
#{e : X} if
##{(a \hconcat e) \vconcat (e \hconcat d) = (a \vconcat e) \hconcat (e \vconcat d)}
holds for all #{a\ d : X}, and we say the two binary operations satisfy
\em{inner interchange} at an element #{e : X} if
##{(e \hconcat b) \vconcat (c \hconcat e) = (e \vconcat b) \hconcat (c \vconcat e)}
holds for all #{b\ c : X}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  InterchangeLaw
    : (X → X → X) → (X → X → X) → Type 𝓤
  InterchangeLaw _◾_ _◽_
    = (a b c d : X)
    → (a ◾ b) ◽ (c ◾ d) ＝ (a ◽ c) ◾ (b ◽ d)

  OuterInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  OuterInterchangeLaw _◾_ _◽_ e
    = (a d : X)
    → (a ◾ e) ◽ (e ◾ d) ＝ (a ◽ e) ◾ (e ◽ d)

  InnerInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  InnerInterchangeLaw _◾_ _◽_ e
    = (b c : X)
    → (e ◾ b) ◽ (c ◾ e) ＝ (e ◽ c) ◾ (b ◽ e)
}
}

\subtree[fre-DAF1]{
\title{Outer interchange at the unit implies operations are equal}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{outer interchange law}, for all #{a\ d : X}:
##{(a \hconcat e) \vconcat (e \hconcat d) = (a \vconcat e) \hconcat (e \vconcat d)}
then the two binary operations are equal.
}

\agda{
equal-ops←outer-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → OuterInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ x ◾ y
equal-ops←outer-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ outer-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (r◾ x) (l◾ y)) ⟩
    (x ◾ e) ◽ (e ◾ y)
      ＝⟨ outer-◾-◽-interchange x y ⟩
    (x ◽ e) ◾ (e ◽ y)
      ＝⟨ ap₂ (_◾_) (r◽ x) (l◽ y) ⟩
    x ◾ y ∎
}
}

\subtree[fre-11E4]{
\title{Inner interchange at the unit implies operations are opposites}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{inner interchange law}, for all #{b\ c : X}:
##{(e \hconcat b) \vconcat (c \hconcat e) = (e \vconcat b) \hconcat (c \vconcat e)}
then the two binary operations are opposites: #{b \hconcat c = c \vconcat b}.
}

\agda{
opposite-ops←inner-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InnerInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ y ◾ x
opposite-ops←inner-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ inner-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (l◾ x) (r◾ y)) ⟩
    (e ◾ x) ◽ (y ◾ e)
      ＝⟨ inner-◾-◽-interchange x y ⟩
    (e ◽ y) ◾ (x ◽ e)
      ＝⟨ ap₂ (_◾_) (l◽ y) (r◽ x) ⟩
    y ◾ x ∎
}
}

\subtree[fre-D0CE]{
\title{The algebraic Eckmann–Hilton argument}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\hconcat{-}} and #{{-}\vconcat{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{interchange law} for all #{a\ b\ c\ d : X}:
##{(a \hconcat b) \vconcat (c \hconcat d) = (a \vconcat b) \hconcat (c \vconcat d)}
then the two binary operations are equal and symmetric.
}

\proof{
We have seen that outer interchange gives #{x \hconcat y = x \vconcat y},
and that inner interchange gives #{x \hconcat y = y \vconcat x}, hence
#{x \vconcat y = y \vconcat x}.
}

\agda{
comm←interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InterchangeLaw (_◾_) (_◽_)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
comm←interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ ◾-◽-interchange x y
  = equal-ops←outer-interchange
      (_◾_) (_◽_) e l◾ r◾ l◽ r◽
      (λ a d → ◾-◽-interchange a e e d)
      (x)
      (y)
  ∙ sym
      ( opposite-ops←inner-interchange
        (_◾_) (_◽_) e l◾ r◾ l◽ r◽
        (λ b c → ◾-◽-interchange e b c e)
        (y)
        (x))
}
}

\subtree[fre-98A0]{
\title{The Eckmann–Hilton argument for double loop spaces}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-28}

\p{The concatenation operation on double loop spaces is symmetric.}


\p{
For concatenation of double loop spaces, a more direct construction of the symmetry
exists, which avoids going via horizontal concatenation.
}

\agda{
comm←interchange'
  : ∀ {𝓤} {X : Type 𝓤} (_◽_ : X → X → X) (L R : X → X)
    → L ~ id → R ~ id
    → ((x y : X) → L x ◽ R y ＝ R y ◽ L x)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
comm←interchange' _◽_ L R l r L◽R-commute x y
  = sym (ap₂ (_◽_) (l x) (r y)) ∙ L◽R-commute x y ∙ ap₂ (_◽_) (r y) (l x)

∙Ω²-comm
  : ∀ {𝓤} {X : Type 𝓤} {a : X} (p q : Ω² X a) → p ∙ q ＝ q ∙ p
∙Ω²-comm
  = comm←interchange' (_∙_) (refl ◂_) (_▸ refl)
      (◂-left-unit)
      (▸-right-unit')
      (λ p q → ◂▸-∙-interchange q p)
}
}

\subtree[fre-1982]{
\title{Syllepsis}
\taxon{Section}
\author{fredrikbakke}
\date{2026-08-27}
\date{2026-08-28}
\date{2026-08-29}

\p{
The Eckmann–Hilton symmetry #{\EH} is its own inverse on 3-loops. I.e.,
given two 3-loops #{p} and #{q}, then
#{\EH(p,q) = \EH(q,p)^{-1}}.
}

\p{Our proof and formalisation follows Sojakova–Kavvos \citek{SK22}.}

\subtree[fre-BB2E]{
\title{Naturality of the Eckmann–Hilton symmetry}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
The Eckmann–Hilton symmetry is natural with respect to whiskering.
}

\agda{
module SyllepsisProof {𝓤} {X : Type 𝓤} where

  ∙Ω²-comm-refl-left-coh
    : {a b c : X} {p q : a ＝ b} {r : b ＝ c}
      {α : p ＝ q} {s : p ∙ r ＝ q ∙ r}
    → (θ : α ▸ r ＝ s)
    → (sym (refl ◾ θ) ∙ ◂▸-∙-interchange α refl ∙ (θ ◾ refl)) ∙ ∙-reflr s
    ＝ ∙-refll s
  ∙Ω²-comm-refl-left-coh {α = refl} refl = refl

  ∙Ω²-comm-refl-left
    : {a : X} (p : Ω² X a)
    → ∙Ω²-comm refl p ∙ ∙-reflr p ＝ ∙-refll p
  ∙Ω²-comm-refl-left p = ∙Ω²-comm-refl-left-coh (▸-right-unit' p)

  ∙Ω²-comm-refl-right-coh
    : {a b c : X} {p : a ＝ b} {q r : b ＝ c}
      {α : q ＝ r} {s : p ∙ q ＝ p ∙ r}
    → (θ : p ◂ α ＝ s)
    → (sym (θ ◾ refl) ∙ ◂▸-∙-interchange refl α ∙ (refl ◾ θ)) ∙ ∙-refll s
    ＝ ∙-reflr s
  ∙Ω²-comm-refl-right-coh {α = refl} refl = refl

  ∙Ω²-comm-refl-right
    : {a : X} (p : Ω² X a)
    → ∙Ω²-comm p refl ∙ ∙-refll p ＝ ∙-reflr p
  ∙Ω²-comm-refl-right p = ∙Ω²-comm-refl-right-coh (◂-left-unit p)

  ∙Ω²-comm-nat-left
    : {a : X} {p q : Ω² X a} (r : Ω² X a) (α : p ＝ q)
    → (α ▸ r) ∙ ∙Ω²-comm q r ＝ ∙Ω²-comm p r ∙ (r ◂ α)
  ∙Ω²-comm-nat-left r α = sym (homotopy-natural (λ p → ∙Ω²-comm p r) α)

  ∙Ω²-comm-nat-right
    : {a : X} {p q : Ω² X a} (r : Ω² X a) (α : p ＝ q)
    → (r ◂ α) ∙ ∙Ω²-comm r q ＝ ∙Ω²-comm r p ∙ (α ▸ r)
  ∙Ω²-comm-nat-right r α = sym (homotopy-natural (λ p → ∙Ω²-comm r p) α)

  ∙Ω²-comm-nat-right-coh
    : {a : X} {p : Ω² X a} (α : refl ＝ p)
    → ∙Ω²-comm-nat-right refl α ◫ ▸-right-unit-nat α
    ＝ ((refl ◂ α) ◂ ∙Ω²-comm-refl-left p) ∙ ◂-left-unit-nat α
  ∙Ω²-comm-nat-right-coh refl = refl

  ∙Ω²-comm-nat-left-coh
    : {a : X} {p : Ω² X a} (α : refl ＝ p)
    → ∙Ω²-comm-nat-left refl α ◫ ◂-left-unit-nat α
    ＝ ((α ▸ refl) ◂ ∙Ω²-comm-refl-right p) ∙ ▸-right-unit-nat α
  ∙Ω²-comm-nat-left-coh refl = refl

  ∙Ω²-comm-double-nat
    : {a : X} {p q r s : Ω² X a}
      (α : p ＝ q) (β : r ＝ s)
    → ( ◂▸-∙-interchange α β ▸ ∙Ω²-comm q s)
    ∙ ( ∙Ω²-comm-nat-left r α ⊟ ∙Ω²-comm-nat-right q β)
    ＝ ( ∙Ω²-comm-nat-right p β ⊟ ∙Ω²-comm-nat-left s α)
    ∙ sym (∙Ω²-comm p r ◂ ◂▸-∙-interchange β α)
  ∙Ω²-comm-double-nat refl refl = ∙-reflr' _
}
}

\subtree[fre-A2E5]{
\title{Triangle squeeze}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Suppose we are given two vertically composable commuting squares of
identifications

\quiver{
\begin{tikzcd}
a && a \\
b && b \\
c && c
\arrow["\refl", equals, from=1-1, to=1-3]
\arrow["\refl", equals, from=2-1, to=2-3, description]
\arrow["\refl"', equals, from=3-1, to=3-3]
\arrow["p"', equals, from=1-1, to=2-1]
\arrow["r", equals, from=1-3, to=2-3]
\arrow["p'"', equals, from=2-1, to=3-1]
\arrow["r'", equals, from=2-3, to=3-3]
\arrow["\varphi", phantom, from=1-1, to=2-3]
\arrow["\theta", phantom, from=2-1, to=3-3]
\end{tikzcd}
}

together with horizontal factorisations

\quiver{
\begin{tikzcd}
a & a & a \\
b & b & b \\
c & c & c
\arrow["\refl", equals, from=1-1, to=1-2]
\arrow["\refl", equals, from=1-2, to=1-3]
\arrow["\refl", equals, from=2-1, to=2-2, description]
\arrow["\refl", equals, from=2-2, to=2-3, description]
\arrow["\refl"', equals, from=3-1, to=3-2]
\arrow["\refl"', equals, from=3-2, to=3-3]
\arrow["p"', equals, from=1-1, to=2-1]
\arrow["q", description, equals, from=1-2, to=2-2]
\arrow["r", equals, from=1-3, to=2-3]
\arrow["p'"', equals, from=2-1, to=3-1]
\arrow["q'", description, equals, from=2-2, to=3-2]
\arrow["r'", equals, from=2-3, to=3-3]
\arrow["\alpha", phantom, from=1-1, to=2-2]
\arrow["\beta", phantom, from=1-2, to=2-3]
\arrow["\gamma", phantom, from=2-1, to=3-2]
\arrow["\delta", phantom, from=2-2, to=3-3]
\end{tikzcd}
}

such that #{\alpha \hpaste \beta = \varphi} and
#{\gamma \hpaste \delta = \theta}. Then
##{
\squeeze{(\alpha \vpaste \gamma)} \concat (\squeeze{(\beta)} \hconcat \squeeze{(\delta)})
=
\squeeze{(\varphi)} \hconcat \squeeze{(\theta)}.
}
}

\p{This is \citet{Lemma 7.2}{SK22}.}

\agda{
  squeeze-triangle
    : {a b c : X} {p q r : a ＝ b} {p' q' r' : b ＝ c}
      {upper-left  : p  ∙ refl ＝ refl ∙ q }
      {upper-right : q  ∙ refl ＝ refl ∙ r }
      {lower-left  : p' ∙ refl ＝ refl ∙ q'}
      {lower-right : q' ∙ refl ＝ refl ∙ r'}
      {upper       : p  ∙ refl ＝ refl ∙ r }
      {lower       : p' ∙ refl ＝ refl ∙ r'}
    → upper-left ◫ upper-right ＝ upper
    → lower-left ◫ lower-right ＝ lower
    → squeeze (upper-left ⊟ lower-left)
    ∙ (squeeze upper-right ◾ squeeze lower-right)
    ＝ squeeze upper ◾ squeeze lower
  squeeze-triangle
    {p = refl} {p' = refl}
    {upper-left = refl} {upper-right = refl}
    {lower-left = refl} {lower-right = refl}
    refl refl
    = refl
}
}

\subtree[fre-A2E6]{
\title{Hexagon pasting}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Consider a hexagon of equalities in the identity type #{a = b},

\quiver{
\begin{tikzcd}
& \textsf{top} \\
\textsf{upper-left} && \textsf{upper-right} \\
\textsf{lower-left} && \textsf{lower-right} \\
& \text{bottom}\nsp{.}
\arrow["\textsf{top-left}", equals, from=2-1, to=1-2]
\arrow["\textsf{top-right}"', equals, from=2-3, to=1-2]
\arrow["\textsf{middle-left}"', equals, from=2-1, to=3-1]
\arrow["\textsf{middle-right}", equals, from=2-3, to=3-3]
\arrow["\textsf{bottom-left}"', equals, from=3-1, to=4-2]
\arrow["\textsf{bottom-right}", equals, from=3-3, to=4-2]
\end{tikzcd}
}

Suppose the interior is subdivided into two triangles and a central square as shown
below.

\quiver{
\begin{tikzcd}
& \textsf{top} \\
\textsf{upper-left} && \textsf{upper-right} \\
\textsf{lower-left} && \textsf{lower-right} \\
& \text{bottom}
\arrow["\textsf{top-left}", equals, from=2-1, to=1-2]
\arrow["\textsf{top-right}"', equals, from=2-3, to=1-2]
\arrow["\textsf{middle-left}"', equals, from=2-1, to=3-1]
\arrow["\textsf{middle-right}", equals, from=2-3, to=3-3]
\arrow["\textsf{bottom-left}"', equals, from=3-1, to=4-2]
\arrow["\textsf{bottom-right}", equals, from=3-3, to=4-2]
\arrow["\squeeze(\textsf{upper-square})", description, equals, dashed, from=2-1, to=2-3]
\arrow["\textsf{upper-triangle}", phantom, shift left=2, from=2-1, to=2-3]
\arrow["\textsf{square}", phantom, from=2-1, to=3-3]
\arrow["\squeeze(\textsf{lower-square})", description, equals, dashed, from=3-1, to=3-3]
\arrow["\textsf{lower-triangle}"', phantom, shift right=2, from=3-1, to=3-3]
\end{tikzcd}
}

The dashed arrows are obtained by squeezing the degenerate squares
#{\textsf{upper-square}} and #{\textsf{lower-square}}. Assume that the central square
commutes before squeezing, and that the upper and lower triangles commute after
squeezing (as displayed). Then the outer hexagon commutes.
}

\p{This is \citet{Lemma 7.3}{SK22}.}

\agda{
  syllepsis-hexagon-pasting
    : {a b : X}
      {top upper-left upper-right lower-left lower-right bottom : a ＝ b}
      {top-left     : upper-left  ＝ top}
      {top-right    : upper-right ＝ top}
      {middle-left  : upper-left  ＝ lower-left}
      {middle-right : lower-right ＝ upper-right}
      {bottom-left  : lower-left  ＝ bottom}
      {bottom-right : lower-right ＝ bottom}
      {upper-square : upper-left ∙ refl ＝ refl ∙ upper-right}
      {lower-square : lower-left ∙ refl ＝ refl ∙ lower-right}
    → (middle-left ▸ refl) ∙ lower-square
    ＝ upper-square ∙ sym (refl ◂ middle-right)
    → squeeze upper-square ∙ top-right ＝ top-left
    → squeeze lower-square ∙ bottom-right ＝ bottom-left
    → (sym top-left ∙ (middle-left ∙ bottom-left))
    ∙ (sym bottom-right ∙ (middle-right ∙ top-right))
    ＝ refl
  syllepsis-hexagon-pasting
    {top-left = refl} {middle-left = refl}
    {middle-right = refl} {bottom-right = refl}
    square upper-triangle lower-triangle
    = (sym lower-triangle ∙ ∙-reflr _ ∙ (∙-reflr' _ ◂ (square ∙ ∙-reflr _))) ▸ _
    ∙ upper-triangle
}
}

\subtree[fre-1982]{
\title{Syllepsis}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-29}

\proof{
\p{
Recall that the Eckmann–Hilton symmetry was constructed as the ternary concatenation
\code{sym (◂-left-unit p ◾ ▸-right-unit' q) ∙ ◂▸-∙-interchange q p ∙ (▸-right-unit' q ◾ ◂-left-unit p)}.
Thus, by the hexagon pasting lemma above
(with hexagon whose concatenated boundary is #{\EH(p,q) \concat \EH(q,p)}), it
suffices to give the following
three equalities:
\ol{
\li{
the central double-naturality square \code{∙Ω²-comm-double-nat q p},
}
\li{
the upper triangle
\code{squeeze-triangle (∙Ω²-comm-nat-right-coh p) (∙Ω²-comm-nat-left-coh q)}, and
}
\li{
the lower triangle
\code{squeeze-triangle (∙Ω²-comm-nat-left-coh q) (∙Ω²-comm-nat-right-coh p)}.
}
}
}
}

\agda{
module _ {𝓤} {A : Type 𝓤} {a : A} where

  ∙Ω³-comm : (p q : Ω³ A a) → p ∙ q ＝ q ∙ p
  ∙Ω³-comm = ∙Ω²-comm

  ∙Ω³-syllepsis
    : (p q : Ω³ A a)
    → ∙Ω³-comm p q ∙ ∙Ω³-comm q p ＝ refl
  ∙Ω³-syllepsis p q
    = let open SyllepsisProof
    in syllepsis-hexagon-pasting
        (∙Ω²-comm-double-nat q p)
        (squeeze-triangle (∙Ω²-comm-nat-right-coh p) (∙Ω²-comm-nat-left-coh q))
        (squeeze-triangle (∙Ω²-comm-nat-left-coh q) (∙Ω²-comm-nat-right-coh p))
}
}
}
}
