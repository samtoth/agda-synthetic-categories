\title{#{Δ¹}-Étale maps}
\author{fredrikbakke}
\date{2026-09-19}
\taxon{Module}
\import{stt-macros}

\p{
Assume a [tiny](stt-00JY) interval. Then a crisp map is [étale](bak-922B) for
[#{Δ¹}-discrete types](stt-00B6) exactly when its fibre family is both
[covariant](stt-00AY) and [contravariant](stt-00OD).
}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.Δ¹EtaleMaps
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.GlobalClassesMaps
open import Core.Orthogonal
open import Modalities.EtaleMaps
open import Modalities.GlobalReflectiveSubuniverses.DescentEtale
open import Modalities.ModalEquivalences
open import Modalities.Instances.Nullification
open import Modalities.Instances.Truncation
open import Synthetic.Tiny
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.ContravariantFamilies Δ¹ I
open import Synthetic.Categories.BivariantFamilies Δ¹ I
}
}

\subtree[bak-12BF]{
\title{#{Δ¹}-Étale maps are left and right fibrations}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Point inclusions of the interval are #{Δ¹}-equivalences, so
every #{Δ¹}-étale map is both a left and a right fibration.
}

\agda{
opaque
  point-is-Δ¹-modal-equiv
    : (i : Δ¹) → is-modal-equiv Δ¹DiscreteType-gRSubU (point i)
  point-is-Δ¹-modal-equiv i
    = section-is-modal-equiv Δ¹DiscreteType-gRSubU (point i) ! ~refl
        (is-modal-equiv←up-modal-equiv Δ¹DiscreteType-gRSubU
          (λ disc → is-local←is-null disc tt))

module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} {f : E → B} where

  point-lifting←is-Δ¹-étale
    : (i : Δ¹) → is-étale-map Δ¹DiscreteType-gRSubU f
    → are-orthogonal (point i) f
  point-lifting←is-Δ¹-étale i
    = modal-equiv⊥etale Δ¹DiscreteType-gRSubU (point-is-Δ¹-modal-equiv i)

  is-left-and-right-fibration←is-Δ¹-étale
    : is-étale-map Δ¹DiscreteType-gRSubU f
    → is-left-fibration f × is-right-fibration f
  is-left-and-right-fibration←is-Δ¹-étale et
    = (point-lifting←is-Δ¹-étale i0 et , point-lifting←is-Δ¹-étale i1 et)
}
}

\agda{
module TinyInterval
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ √ε : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (Δ¹ → √ A) → A)
  (@♭ √-is-tiny-str
    : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure Δ¹ A (√ A) √ε)
  (open Dependent√ Δ¹ √ √ε √-is-tiny-str using (√ᵈ))
  (@♭ √ᵈ-is-prop
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
      → @♭ ((γ : Δ¹ → Γ) → is-prop (A γ)) → (γ : Γ) → is-prop (√ᵈ A γ))
  (let module Classifier = AmazinglyFibrant Δ¹ √ √ε √-is-tiny-str
         is-bivariant is-bivariant-is-prop is-bivariant-is-Δ¹-relative)
  (open Classifier)
  (open Classifier.UIdS √ᵈ-is-prop)
  (open UFib)
  where
}

\subtree[bak-0D64]{
\title{The bivariant family classifier is #{Δ¹}-discrete}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Any synthetic arrow in the bivariant family classifier gives an equivalence by
bivariant transport, and hence an identification, and we know a family of maps
#{\Hom(x,y)\to (x = y)}
[implies that the underlying type is #{Δ¹}-discrete](stt-00L4).
}

\agda{
  bivariant-classifier-is-Δ¹-discrete
    : ∀ {@♭ 𝓤} → is-Δ¹-discrete (UFib 𝓤)
  bivariant-classifier-is-Δ¹-discrete
    = is-Δ¹-discrete←Id←Hom
        (λ {a} {b} → UFib-path← a b ∘ tr-hom≃←is-bivariant UFib-π-is-fib)

  bivariant-classifier-fibres-are-Δ¹-discrete
    : ∀ {@♭ 𝓤} (a : UFib 𝓤) → is-Δ¹-discrete (Carrier a)
  bivariant-classifier-fibres-are-Δ¹-discrete
    = is-Δ¹-discrete-family←is-covariant
        (is-covariant←is-bivariant Carrier UFib-π-is-fib)
}
}

\subtree[bak-99D7]{
\title{Characterisation of #{Δ¹}-étale maps}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
A crisp map #{f \colon-flat E \to B} is #{\Delta^1}-étale if and only if it has
unique lifts against both endpoint inclusions of the interval.
}

\proof{
\p{
The forwards direction was demonstrated in [[bak-12BF]]. For the converse, let #{f}
be a crisp map whose fibre family is bivariant. The universal bivariant family has
#{Δ¹}-discrete base and fibres, and every crisp bivariant family is classified by it,
so the [classification by a modal family criterion](bak-4877) gives that #{f} is
étale.
}
}

\agda{
  module _ {@♭ 𝓤 𝓥} {@♭ E : Type 𝓤} {@♭ B : Type 𝓥} (@♭ f : E → B) where

    is-Δ¹-étale←fibres-are-bivariant
      : is-bivariant (fibre f) → is-étale-map Δ¹DiscreteType-gRSubU f
    is-Δ¹-étale←fibres-are-bivariant bi
      = is-étale-map←classified-by-modal-family
          Δ¹DiscreteType-gRSubU
          Σ-is-Δ¹-discrete Carrier
          (λ b → mk-ufib (fibre f b) (lift-fibrancy (Trunc.η i0) (fibre f) bi b))
          bivariant-classifier-is-Δ¹-discrete
          bivariant-classifier-fibres-are-Δ¹-discrete
          (λ _ → id≃)

    is-Δ¹-étale↔fibres-are-bivariant
      : is-étale-map Δ¹DiscreteType-gRSubU f ↔ is-bivariant (fibre f)
    is-Δ¹-étale↔fibres-are-bivariant .fst et
      = Bivariant.target∈R←Arrow-equiv
          (unstraightening-arrow-map f)
          (λ b → point-lifting←is-Δ¹-étale (fam-generators-bivariant b tt) et)
    is-Δ¹-étale↔fibres-are-bivariant .snd
      = is-Δ¹-étale←fibres-are-bivariant

    is-Δ¹-étale↔is-left-and-right-fibration
      : is-étale-map Δ¹DiscreteType-gRSubU f
      ↔ is-left-fibration f × is-right-fibration f
    is-Δ¹-étale↔is-left-and-right-fibration
      = ( is-left-and-right-fibration←is-Δ¹-étale
        , ( λ (left , right)
            → is-Δ¹-étale←fibres-are-bivariant
                (Bivariant.target∈R←Arrow-equiv
                  (unstraightening-arrow-map f)
                  (λ where false → left; true → right))))
}
}

\subtree[bak-980E]{
\title{Crisp left and right fibrations lift against every point of Δ¹}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-24}

\p{
If the interval is tiny, then any crisp map #{f \colon-flat A \to B} that is both a
left and a right fibration lift against every point inclusion of the interval. In
particular, we do not need to assume the end points cover the global points, or any
of the other axioms of Triangulated Type Theory.
}

\agda{
  module _ {@♭ 𝓤 𝓥} {@♭ E : Type 𝓤} {@♭ B : Type 𝓥} (@♭ f : E → B) where

    point-lifting←is-left-and-right-fibration
      : is-left-fibration f × is-right-fibration f
      → (i : Δ¹) → are-orthogonal (point i) f
    point-lifting←is-left-and-right-fibration lr i
      = point-lifting←is-Δ¹-étale i
          (is-Δ¹-étale↔is-left-and-right-fibration f .snd lr)
}
}
