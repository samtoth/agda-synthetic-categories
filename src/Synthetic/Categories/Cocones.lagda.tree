\subtree[tot-A0CE]{
\title{Cocone types}
\taxon{Definition}

\p{Given a diagram #{\phi \colon \mathcal{K} \to A}, the type of #{D}-shaped \em{cones}
at some element #{a : A} is given by a natural transformation #{D \Rightarrow \const_a}.
The type consisting of a point and a cone at that point, we write #{A_{/\phi}}, called
\code{Under ϕ} in code. This type comes with a canonical projection to #{A} which
we call the \em{nadir} map.}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  Cocone-at : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  Cocone-at a = Hom (K → A) ϕ (const a)

  Cocone-at' : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  Cocone-at' a = ∀ (k : K) → Hom A (ϕ k) a

  Under : Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  Under = Σ A Cocone-at

  Under' : Type (𝓘 ⊔ 𝓤 ⊔ 𝓚)
  Under' = Σ A Cocone-at'

  Cocone-at≃ : ∀ a → Cocone-at a ≃ Cocone-at' a
  Cocone-at≃ a = Nat≃Hom

  Under≃ : Under ≃ Under'
  Under≃ = Σ-snd-≃ Cocone-at≃

  nadir : Under → A
  nadir = fst
}
}

\subtree[tot-9923]{
\title{The nadir map as a base change}
\taxon{Lemma}

\p{The nadir map #{A_{ϕ/} \to A} is a base change of the slice map
#{(A^\mathcal{K})_{ϕ/} \to A^{\mathcal{K}}}.}

\agda{
module _ {𝓤 𝓚} {A : Type 𝓤} {K : Type 𝓚} (ϕ : K → A) where

  Coslice-proj←nadir : Arrow-map (nadir ϕ) (Coslice-proj: ϕ)
  Coslice-proj←nadir .Arrow-Π.top (a , h) = (h .Homᵈ.hom , h .Homᵈ.hom0)
  Coslice-proj←nadir .Arrow-Π.bot = const
  Coslice-proj←nadir .Arrow-Π.comm (a , h) = sym (h .Homᵈ.hom1)

  opaque
    nadir-base-change-of-Coslice-proj : is-cartesian Coslice-proj←nadir
    nadir-base-change-of-Coslice-proj a
      = is-equiv←~
          (λ where (_ , refl) → fibre-path→ (refl , sym sym-sym ∙ sym (∙-reflr _)))
          (eqv ._≃_.fwd-is-equiv)
      where

      eqv : fibre (nadir ϕ) a ≃ fibre (Coslice-proj: ϕ) (const a)
      eqv ._≃_.fwd ((a , h) , refl) = ((h .Homᵈ.hom , h .Homᵈ.hom0) , h .Homᵈ.hom1)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .fst ((f , p) , q) = ((a , mk-hom f p q) , refl)
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .fst (_ , refl) = refl
      eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd .snd = ~refl
      eqv ._≃_.fwd-is-equiv .is-equiv.coherent (_ , refl) = refl
}
}

\subtree[tot-195I]{
\taxon{Lemma}
\title{Under types as comma types}

\p{For any map #{\phi : K \to A}, the overcategory #{A_{\phi/}} is equivalent to the
comma type of the span #{\{\phi\} \to A^K \leftarrow A}.}

\agda{
Under-directed-cone
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {K : Type 𝓥}
      (ϕ : K → A)
    → directed-cone (mk-cospan (K → A) (point ϕ) (const: A K)) (Under ϕ)
Under-directed-cone F .directed-cone.p = !
Under-directed-cone F .directed-cone.q (a , _) = a
Under-directed-cone F .directed-cone.filler (_ , α) = α

Under-is-comma
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} (F : I → C)
    → up-comma (Under-directed-cone F)
Under-is-comma F .is-equiv.qinv .fst cone x = (cone .directed-cone.q x , cone .directed-cone.filler x)
Under-is-comma F .is-equiv.qinv .snd .fst = ~refl
Under-is-comma F .is-equiv.qinv .snd .snd = ~refl
Under-is-comma F .is-equiv.coherent = ~refl
}
}

\subtree[tot-AYC1]{
\title{Identity types of undertypes}

\agda{
Under-Id
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → Under F → Under F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
Under-Id a b
  = Σ[ p ∶ (a .fst ＝ b .fst) ]
       (Hom-pathᵈ refl (ap const p) (a .snd) (b .snd))

Under-Id-refl
  : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
    → (p : Under F) → Under-Id p p
Under-Id-refl a = (refl , Hom-pathᵈ-refl)

opaque
  Under-Id-is-torsorial
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → (F : Under F) → is-torsorial (Under-Id F)
  Under-Id-is-torsorial F
    = is-singleton-structure←parts
        Sing-is-singleton
        (_ , refl)
        (SingS-is-single ⦃ Hom-IdSᵈ ⦄ _)

instance
  Under-IdS
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → Identity-system (Under F) (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  Under-IdS .Identity-system.IdS = Under-Id
  Under-IdS .Identity-system.IdS←Id refl = Under-Id-refl _
  Under-IdS .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ (Under-Id-is-torsorial a) _

opaque
  Under-Id→
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : Under F}
      → Under-Id x y → x ＝ y
  Under-Id→ = Id←IdS ⦃ Under-IdS ⦄

  Under-Id-is-equiv
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C}
      → {x y : Under F}
      → is-equiv (Under-Id→ {x = x} {y})
  Under-Id-is-equiv
    = is-equiv⁻¹ (Under-IdS .Identity-system.IdS←Id-is-equiv _ _)

  Under-Id-ap-fst
    : ∀ {𝓤 𝓥} {C : Type 𝓤} {I : Type 𝓥} {F : I → C} {a b : Under F}
      → (p : Under-Id a b) → ap fst (Under-Id→ p) ＝ fst p
  Under-Id-ap-fst
    = IdSJ ⦃ Under-IdS ⦄ (λ x → ap fst (Id←IdS (x .snd)) ＝ fst (x .snd))
           (ap (ap fst) (Id←IdS←Id refl))
}
}

