\date{2025-05-27}
\title{Standard finite types}
\author{fredrikbakke}
\taxon{Module}

\import{stt-macros}

\agda{
module Foundations.Fin where

open import Foundations.Universes
open import Foundations.Empty
open import Foundations.Nat
open import Foundations.Singletons
open import Foundations.Identity
open import Foundations.Functions
open import Foundations.Sigma
open import Foundations.Equivalences
open import Foundations.FunExt
}


\subtree[stt-00S0]{
\title{Fin}
\taxon{Definition}
\author{fredrikbakke}
\contributor{samueltoth}

\p{
The \em{standard finite type} of order #{n}, #{\Fin n}, is an inductive type with
precisely #{n} elements.
}

\agda{
data Fin : ℕ → Type where
  fzero : {n : ℕ} → Fin (suc n)
  fsuc : {n : ℕ} → Fin n → Fin (suc n)
}

\p{
The elements of the #{\Fin n} are canonically identified with the first #{n} elements
of the natural numbers.
}

\agda{
Fin←ℕ : (m n : ℕ) → m <ℕ n → Fin n
Fin←ℕ m 0 ()
Fin←ℕ 0 (suc n) _ = fzero
Fin←ℕ (suc m) (suc n) p = fsuc (Fin←ℕ m n p)

ℕ←Fin : {n : ℕ} → Fin n → ℕ
ℕ←Fin fzero = zero
ℕ←Fin (fsuc x) = suc (ℕ←Fin x)
}

\p{
We also show that #{\Fin 0} is empty and #{\Fin 1} is a singleton.
}

\agda{
Fin-0-is-empty : ¬ Fin 0
Fin-0-is-empty ()

Fin-1-is-single : is-singleton (Fin 1)
Fin-1-is-single = mk-singl fzero λ where
  fzero → refl
  (fsuc ())
}
}

\subtree[ub-0049]{
\title{Functions out of standard finite types}
\taxon{Lemma}
\author{ulrikbuchholtz}
\date{2026-09-04}

\p{A function out of #{\Fin 0} is unique, and a function out of
#{\Fin (n+1)} is a value at \code{fzero} together with a function out of
#{\Fin n}. Both use function extensionality.}

\agda{
module FinWithFunExt (fe : FunExt-global) where
  open WithFunExt-global fe

  Fin-0-fun-is-single : ∀ {𝓤} {C : Type 𝓤} → is-singleton (Fin 0 → C)
  Fin-0-fun-is-single = mk-singl (λ ()) (λ f → funext→ λ ())

  Fin-suc-fun : ∀ {𝓤} {C : Type 𝓤} {n : ℕ} → C × (Fin n → C) → (Fin (suc n) → C)
  Fin-suc-fun (c , u) fzero = c
  Fin-suc-fun (c , u) (fsuc i) = u i

  Fin-suc-fun-is-equiv
    : ∀ {𝓤} {C : Type 𝓤} {n : ℕ} → is-equiv (Fin-suc-fun {C = C} {n})
  Fin-suc-fun-is-equiv
    = is-equiv←qinv
        ( (λ f → (f fzero , f ∘ fsuc))
        , (λ _ → refl)
        , λ f → funext→ λ where
            fzero → refl
            (fsuc i) → refl)
}
}
