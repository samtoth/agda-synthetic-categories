\taxon{Module}
\import{stt-macros}
\title{Wide subcategories of types}

\agda{
module Modalities.WideSubcategoriesTypes where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Ergonomics.Representation
open import Ergonomics.Extensionality

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.LiftingSquares
open import Core.Orthogonal
}
}

\subtree[stt-004W]{
\title{Wide subcategories of the category of types}
\contributor{fredrikbakke}
\taxon{Definition}

\p{
We define the type of wide subcategories of #{\UU} - that is - subtypes
of all arrows which are closed under composition and that contains the equivalences.
}

\agda{
record WideSubcatType 𝓤 𝓥 : Type (lsuc (𝓤 ⊔ 𝓥)) where
  field
    K : {A B : Type 𝓤} → Subtype (A → B) 𝓥
    ≃∈K : {A B : Type 𝓤} (e : A ≃ B) → (_≃_.fwd e) ∈ K
    _∘∈K_
      : {A B C : Type 𝓤} {g : B → C} {f : A → B}
      → g ∈ K → f ∈ K → g ∘ f ∈ K

  id∈K : ∀ {A : Type 𝓤} → (id: A) ∈ K
  id∈K = ≃∈K id≃

  stable-equiv
    : {A B X Y : Type 𝓤} {f : A → B} {g : X → Y}
    → Arrow-equiv f g → g ∈ K → f ∈ K
  stable-equiv {f = f} (mk-amap top bot H , teq , beq) gK
    = tr (_∈ K)
        (funext→ (is-equiv.bwd beq ◃h (H h⁻¹) ∙h is-equiv.η beq ▹h f))
        (≃∈K ((mk≃ bot beq) e⁻¹) ∘∈K (gK ∘∈K ≃∈K (mk≃ top teq)))

unquoteDecl WideSubcatType-repr≊ WideSubcatType-repr≃
  = make-record-repr WideSubcatType-repr≊ WideSubcatType-repr≃ (quote WideSubcatType)
}
}

\subtree[bak-2196]{
\title{Wide subcategories are determined by their function class}
\taxon{Lemma}
\author{fredrikbakke}

\p{If the function classes are equal then the wide subcategories of types are equal.}

\agda{
WideSubcatType-eq-class→eq
  : ∀ {𝓤 𝓥} {W W' : WideSubcatType 𝓤 𝓥}
    → ( {A B : Type 𝓤}
      → WideSubcatType.K W {A} {B} ＝ WideSubcatType.K W' {A} {B})
    → W ＝ W'
WideSubcatType-eq-class→eq {W' = W'} p
  = ap
      ( _≃_.bwd WideSubcatType-repr≃)
      ( Σ-path→
        ( ext! (λ {A} {B} → p {A} {B})
        , ×-path→
          ( ext! (λ {A} {B} e
            → ∈-is-prop (WideSubcatType.K W') _ _ _)
          , ext! (λ {A} {B} {C} {g} {f} gK fK
            → ∈-is-prop (WideSubcatType.K W') _ _ _))))
}
}

\subtree[stt-00YV]{
\title{Global wide subcategories of types}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\p{
We define global wide subcategories of types - that is - subtypes
of all arrows at each universe level, which are closed under composition and that
contains the equivalences.
}

\agda{
record gWideSubcatType (α : Level → Level → Level) : Typeω where
  field
    K : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → Subtype (A → B) (α 𝓤 𝓥)
    ≃∈K
      : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
        → (e : A ≃ B) → e ._≃_.fwd ∈ K
    _∘∈K_
      : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
          {g : B → C} {f : A → B}
        → g ∈ K → f ∈ K → g ∘ f ∈ K

  id∈K : ∀ {𝓤} {A : Type 𝓤} → (id: A) ∈ K
  id∈K = ≃∈K id≃

  stable-equiv
    : ∀ {𝓤 𝓥 𝓦 𝓜}
        {A : Type 𝓤} {B : Type 𝓥} {X : Type 𝓦} {Y : Type 𝓜}
        {f : A → B} {g : X → Y}
      → Arrow-equiv f g → g ∈ K → f ∈ K
  stable-equiv {f = f} (mk-amap top bot H , teq , beq) gK
    = tr (_∈ K)
        (funext→ (is-equiv.bwd beq ◃h (H h⁻¹) ∙h is-equiv.η beq ▹h f))
        (≃∈K ((mk≃ bot beq) e⁻¹) ∘∈K (gK ∘∈K ≃∈K (mk≃ top teq)))
}
}

\subtree[stt-00YS]{
\title{Restricting global wide subcategories of types to a universe}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
small←gWideSubcatType
  : ∀ {α} → gWideSubcatType α → (𝓤 : Level) → WideSubcatType 𝓤 (α 𝓤 𝓤)
small←gWideSubcatType W 𝓤 .WideSubcatType.K = gWideSubcatType.K W
small←gWideSubcatType W 𝓤 .WideSubcatType.≃∈K = gWideSubcatType.≃∈K W
small←gWideSubcatType W 𝓤 .WideSubcatType._∘∈K_ = gWideSubcatType._∘∈K_ W
}
}

\subtree[bak-2207]{
\title{Raising the universe of a wide subcategory of types}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-11}

\p{
A #{\UV}-small wide subcategory of #{\UU}, is #{\UV \sqcup \UW}-small for any #{\UW}.
}

\agda{
module _
  {𝓤 𝓥} (𝓦 : Level) (C : WideSubcatType 𝓤 𝓥)
  (let module C = WideSubcatType C)
  where

  ULift-WideSubcatType : WideSubcatType 𝓤 (𝓥 ⊔ 𝓦)
  ULift-WideSubcatType .WideSubcatType.K = ULift-subtype 𝓦 C.K
  ULift-WideSubcatType .WideSubcatType.≃∈K e = mk-lift (C.≃∈K e)
  ULift-WideSubcatType .WideSubcatType._∘∈K_ gK fK
    = mk-lift (C._∘∈K_ (unlift gK) (unlift fK))
}
}
