\date{2025-06-06}
\title{The Flat Modality}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
module Modalities.Cohesion.Flat where
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowEquiv
}
}

\subtree[stt-004Z]{
\title{The Flat type operator}
\taxon{Definition}

\p{Given a crisp type #{A}, we can form the type #{\modflat{A}}. In agda flat
we can encode this with an inductive datatype generated by a crisp elements
of #{A}. We also note the corresponding induction principle for the inductive
type.}

\agda{
data ⟨♭|_⟩ {@♭ 𝓤} (@♭ A : Type 𝓤) : Type 𝓤 where
  mod♭ : @♭ A → ⟨♭| A ⟩

♭-ind: : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} (B : ⟨♭| A ⟩ → Type 𝓥)
       → ((@♭ x : A) → B (mod♭ x))
      → (x : ⟨♭| A ⟩) → B x
♭-ind: B f (mod♭ x) = f x

♭-ind
  : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} {B : ⟨♭| A ⟩ → Type 𝓥}
    → ((@♭ x : A) → B (mod♭ x))
    → (x : ⟨♭| A ⟩) → B x
♭-ind = ♭-ind: _

♭-rec
  : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} {B : Type 𝓥}
    → (@♭ A → B) → ⟨♭| A ⟩ → B
♭-rec = ♭-ind

♭ᶠ : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥) → ⟨♭| A ⟩ → Type 𝓥
♭ᶠ B = ♭-rec (λ a → ⟨♭| B a ⟩)
}
}

\subtree[stt-0051]{
\taxon{Theorem}
\title{Flat is a Functor}

\p{Using the rules of [modal type theory](stt-0050) and #{\flat}-induction,
we can define operations making #{\modflat{-}} into a comonad.}

\p{To get a feel for how to reason informally about modal type theory, we
give the definition making #{\modflat{-}} into a functor informally
(in pain-staking detail), and compare it to the agda definition:}

\p{Given crisp types #{A :^\flat \UU} and #{B :^\flat \UV}, and a function
#{f :^\flat A \to B}, we can define a function #{\modflat{A} \to \modflat{B}}.
By crisp induction, it suffices to define a function
#{(a :^\flat A) \to \modflat{B}}. Then by #{\flat}-intro, we can assume a
crisp #{a :^\flat A} and give a crisp term of type #{B}, but now both #{f} and
#{a} were assumed crisp and so #{f(a) :^\flat B}, and we are done.
 }

\agda{
♭-map
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → (@♭ f : A → B) → ⟨♭| A ⟩ → ⟨♭| B ⟩
♭-map f (mod♭ x) = mod♭ (f x)

♭ᶠ-map
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : A → Type 𝓥} {@♭ C : A → Type 𝓦}
    → @♭ ((a : A) → B a → C a) → (a : ⟨♭| A ⟩) → ♭ᶠ B a → ♭ᶠ C a
♭ᶠ-map f = ♭-ind (λ a → ♭-map (f a))

♭-id
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
    → ♭-map {A = A} id ~ id
♭-id (mod♭ x) = refl

♭-∘
  : ∀ {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ C : Type 𝓦}
    → (@♭ f : B → C) (@♭ g : A → B)
    → ♭-map (f ∘ g) ~ ♭-map f ∘ ♭-map g
♭-∘ f g (mod♭ x) = refl
}
}

\subtree[stt-0052]{
\taxon{Theorem}
\title{Flat is a comonad}

\p{Similarly, we can define the counit and comultiplication functions that
make #{\modflat{-}} into a comonad.}

\agda{
ε♭ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → ⟨♭| A ⟩ → A
ε♭ (mod♭ x) = x

ε♭:_ : ∀ {@♭ 𝓤} (@♭ A : Type 𝓤) → ⟨♭| A ⟩ → A
ε♭: A = ε♭

ε♭-natural
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
    → ε♭ ∘ ♭-map f ~ f ∘ ε♭
ε♭-natural (mod♭ x) = refl

⟨♭♭|_⟩ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤
⟨♭♭| A ⟩ = ⟨♭| ⟨♭| A ⟩ ⟩

comult : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → ⟨♭| A ⟩ → ⟨♭♭| A ⟩
comult (mod♭ x) = mod♭ (mod♭ x)

module _ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} where

  ε♭-Arrow-map
    : (@♭ f : A → B) → Arrow-map (ε♭: A) (ε♭: B)
  ε♭-Arrow-map f = mk-amap (♭-map f) f (ε♭-natural h⁻¹)
}
}

\subtree[stt-0054]{
\title{Flat is an idempotent comonad}
\taxon{Theorem}

\p{We show that \code{comult} is an equivalence.}

\agda{
μ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
    → ⟨♭♭| A ⟩ → ⟨♭| A ⟩
μ = ε♭

♭-map-ε♭ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → ♭-map ε♭ ~ ε♭: ⟨♭| A ⟩
♭-map-ε♭ (mod♭ (mod♭ x)) = refl

comult-is-equiv : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-equiv (comult {A = A})
comult-is-equiv .is-equiv.qinv .fst = μ
comult-is-equiv .is-equiv.qinv .snd .fst (mod♭ _) = refl
comult-is-equiv .is-equiv.qinv .snd .snd (mod♭ (mod♭ x)) = refl
comult-is-equiv .is-equiv.coherent (mod♭ x) = refl

♭-idem
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
    → ⟨♭♭| A ⟩ ≃ ⟨♭| A ⟩
♭-idem = mk≃ μ (is-equiv⁻¹ comult-is-equiv)
}
}

\subtree[stt-0057]{
\taxon{Definition}
\title{Crisp Identity Induction}
\date{2025-06-10}

\p{We can define an induction principle for crisp identity types, defined for
families #{P : \Pi_{(a :^{\flat} A)} (a = b) \to \UU}}

\agda{
J♭
  : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} {@♭ a : A}
      (P : (@♭ b : A) → (p : a ＝ b) → Type 𝓥)
    → P a refl
    → {@♭ b : A} → (@♭ p : a ＝ b)
    → P b p
J♭ P pr refl = pr

_ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
    → mod♭ a ＝ mod♭ b
    → ⟨♭| a ＝ b ⟩
_ = λ p → J (λ where (mod♭ x) p' → ⟨♭| _ ＝ x ⟩) (mod♭ refl) p
}

\p{This can be used to define the functoriality of functions with respect to
crisp-identity types.}

\agda{
ap♭
  : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} {B : Type 𝓥}
      (f : @♭ A → B) → {@♭ x y : A} → @♭ x ＝ y
    → f x ＝ f y
ap♭ f refl = refl

ap♭'
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      (@♭ f : @♭ A → B) → {@♭ x y : A}
    → ⟨♭| x ＝ y ⟩
    → ⟨♭| f x ＝ f y ⟩
ap♭' f (mod♭ p) = mod♭ (ap♭ f p)


_ : ∀ {@♭ 𝓤} {𝓥} {@♭ A : Type 𝓤} {B : Type 𝓥}
      (f : @♭ A → B) → {@♭ x y : A} → @♭ x ＝ y
    → f x ＝ f y
_ = λ f → J♭ (λ b _ → f _ ＝ f b) refl
}

\p{We sometimes call the above construction the weak crisp induction principle
in contrast with the following stronger induction principle:
}
\agda{
J-crisp-ind : ∀ (@♭ 𝓤 𝓥 : Level) → Type (lsuc (𝓤 ⊔ 𝓥))
J-crisp-ind 𝓤 𝓥 = ∀ {@♭ A : Type 𝓤} {@♭ a : A}
                     (@♭ P : (@♭ b : A) → (@♭ p : a ＝ b) → Type 𝓥)
                    → @♭ P a refl
                    → {@♭ b : A} → (@♭ p : a ＝ b)
                    → P b p
}

\p{With just the flat modality, the full crisp induction principle is
not derivable in base MTT. \citek{DG21} However, as we show in \ref{stt-00J1},
we can use the #{\sharp} modality, and its adjointness with #{\flat} to derive
this stronger crisp induction principle.}
}


\subtree[stt-0055]{
\taxon{Construction}

\p{Using induction on #{\flat} and this (weak) crisp identity induction
principle, we can define a map
#{\modflat{a = b} \to \mod_{\flat}(a) ＝ \mod_{\flat}(b)}. In analogy to function
types, we call this map #{\textsf{mapply}_\flat}.}

\agda{
mapply♭
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
    → ⟨♭| a ＝ b ⟩
    → mod♭ a ＝ mod♭ b
mapply♭ (mod♭ refl) = refl

mapply♭:
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} (@♭ a b : A)
    → ⟨♭| a ＝ b ⟩
    → mod♭ a ＝ mod♭ b
mapply♭: a b = mapply♭

_ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} {@♭ a b : A}
    → ⟨♭| a ＝ b ⟩
    → mod♭ a ＝ mod♭ b
_ = ♭-rec (ap♭ mod♭)
}
}

\subtree[stt-00JR]{
\taxon{Lemma}
\title{Flat preserves equivalences}

\p{Equivalences #{f : A \toeq B} induce equivalences
#{\flat f : \modflat{A} \toeq \modflat{B}}.}

\agda{
♭-map-is-equiv
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
    → @♭ is-equiv f → is-equiv (♭-map f)
♭-map-is-equiv fe = is-equiv←qinv
  ( ♭-map (bwd fe)
  , (λ where (mod♭ x) → ap♭ mod♭ (η fe x))
  , (λ where (mod♭ x) → ap♭ mod♭ (ε fe x)))
  where open is-equiv

♭≃ : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} (@♭ e : A ≃ B)
     → ⟨♭| A ⟩ ≃ ⟨♭| B ⟩
♭≃ e = mk≃ (♭-map (e ._≃_.fwd)) (♭-map-is-equiv (e ._≃_.fwd-is-equiv))
}
}

\subtree[stt-00P1]{
\title{Flat preserves retracts}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-04-29}

\agda{
♭-retract
  : ∀ {@♭ 𝓤 𝓥}
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → (@♭ R : retract A B)
    → retract ⟨♭| A ⟩ ⟨♭| B ⟩
♭-retract (i , r , H)
  = ♭-map i
  , ♭-map r
  , λ where (mod♭ a) → ap♭ mod♭ (H a)
}
}

\subtree[stt-0053]{
\title{Flat commutes with  #{1}, #{Σ}, and #{×}}
\taxon{Theorem}

\p{First we show that #{\flat} commutes with #{1}, or in other words
#{\modflat{1}} is a [singleton](stt-0006). Similarly we can show that
#{\modflat{-}} preserves all singletons.}

\agda{
♭𝟙-is-single : is-singleton ⟨♭| 𝟙 ⟩
♭𝟙-is-single = mk-singl (mod♭ tt) λ where (mod♭ tt) → refl

♭-is-single
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
    → @♭ is-singleton A → is-singleton ⟨♭| A ⟩
♭-is-single (mk-singl c p) = mk-singl (mod♭ c) λ where
  (mod♭ x) → mapply♭ (mod♭ (p x))
}

\agda{
♭-×
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A × B ⟩ → ⟨♭| A ⟩ × ⟨♭| B ⟩
♭-× (mod♭ (a , b)) = (mod♭ a , mod♭ b)

♭-×⁻¹
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A ⟩ × ⟨♭| B ⟩ → ⟨♭| A × B ⟩
♭-×⁻¹ (mod♭ a , mod♭ b) = (mod♭ (a , b))

♭-×-is-equiv
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → is-equiv (♭-× {A = A} {B})
♭-×-is-equiv = mk-eqv
  ( ♭-×⁻¹
  , ( λ where (mod♭ (a , b)) → refl)
  , ( λ where(mod♭ a , mod♭ b) → refl))
  ( λ where (mod♭ x) → refl)

♭-pres-×
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A × B ⟩ ≃ ⟨♭| A ⟩ × ⟨♭| B ⟩
♭-pres-× = mk≃ ♭-× ♭-×-is-equiv
}

\p{Given a crisp type #{A},
and a family of types #{B} crisply over #{A}, we can define the
dependent flat-sum, written #{\Sigma_{a :^\flat A} B(a)}. Defined
as #{\Sigma_{x : \modflat{A}}\flat\textrm{-rec}(\_,B,x)}.}

\agda{
Σ♭
  : ∀ {@♭ 𝓤 𝓥} (@♭ A : Type 𝓤) (B : @♭ A → Type 𝓥)
    → Type (𝓤 ⊔ 𝓥)
Σ♭ A B = Σ ⟨♭| A ⟩ (♭-rec B)

syntax Σ♭ A (λ x → B) = Σ[♭ x ∶ A ] B

snd♭
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {B : @♭ A → Type 𝓥}
    → (x : Σ♭ A B) → ♭-rec B (x .fst)
snd♭ = snd

Σ♭-ε
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → Σ[♭ x ∶ A ] ⟨♭| B x ⟩ → Σ A B
Σ♭-ε B (mod♭ a , mod♭ b) = (a , b)

ε♭ᶠ
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : A → Type 𝓥}
    → (x : ⟨♭| A ⟩) → ♭ᶠ B x → B (ε♭ x)
ε♭ᶠ {B = B} (mod♭ a) = ε♭ {A = B a}

ε♭ᶠ:
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → (x : ⟨♭| A ⟩) → ♭ᶠ B x → B (ε♭ x)
ε♭ᶠ: B = ε♭ᶠ

Σ♭-ε~map-ε♭
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → Σ♭-ε B ~ map-Σ ε♭ (ε♭ᶠ: B)
Σ♭-ε~map-ε♭ B (mod♭ a , mod♭ b) = refl

ε♭ᶠ-is-fibrewise-equiv
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : A → Type 𝓥}
    → ((@♭ a : A) → is-equiv (ε♭: B a))
    → is-fibrewise-equiv (ε♭ᶠ: B)
ε♭ᶠ-is-fibrewise-equiv bd (mod♭ a) = bd a
}

\p{
We also introduce Agda syntax for the shorthand style #{\Sigma_{x,y : A} B(x)} for
multivariable dependent flat-sums.
}

\agda{
module _ {@♭ 𝓤 𝓥} where

  Σ♭₂ : (@♭ A : Type 𝓤) (B : @♭ A → @♭ A → Type 𝓥) → Type (𝓤 ⊔ 𝓥)
  Σ♭₂ A B = Σ♭ A (λ x → Σ♭ A (B x))

  Σ♭₃ : (@♭ A : Type 𝓤) (B : @♭ A → @♭ A → @♭ A → Type 𝓥) → Type (𝓤 ⊔ 𝓥)
  Σ♭₃ A B = Σ♭ A (λ x → Σ♭₂ A (B x))

  Σ♭₄ : (@♭ A : Type 𝓤) (B : @♭ A → @♭ A → @♭ A → @♭ A → Type 𝓥) → Type (𝓤 ⊔ 𝓥)
  Σ♭₄ A B = Σ♭ A (λ x → Σ♭₃ A (B x))

  {-# INLINE Σ♭₂ #-}
  {-# INLINE Σ♭₃ #-}
  {-# INLINE Σ♭₄ #-}

  syntax Σ♭₂ A (λ x y → B) = Σ[♭ x y ∶ A ] B
  syntax Σ♭₃ A (λ x y z → B) = Σ[♭ x y z ∶ A ] B
  syntax Σ♭₄ A (λ x y z w → B) = Σ[♭ x y z w ∶ A ] B
}

\p{We now show #{\flat} commutes with #{\Sigma} in the sense that
#{\Sigma_{a :^\flat A} \modflat{B(a)}} is equivalent to
#{\modflat{\Sigma_{a : A}B(a)}}}

\agda{
♭-Σ
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → Σ[♭ x ∶ A ] ⟨♭| B x ⟩
    → ⟨♭| Σ A B ⟩
♭-Σ B (mod♭ a , mod♭ b) = mod♭ (a , b)

♭-Σ'
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → ⟨♭| Σ A B ⟩
    → Σ[♭ x ∶ A ] ⟨♭| B x ⟩
♭-Σ' B (mod♭ (a , b)) = (mod♭ a , mod♭ b)

♭-commΣ
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ B : A → Type 𝓥)
    → (Σ[♭ x ∶ A ] ⟨♭| B x ⟩) ≃ ⟨♭| Σ A B ⟩
♭-commΣ P ._≃_.fwd = ♭-Σ P
♭-commΣ P ._≃_.fwd-is-equiv .is-equiv.qinv .fst = ♭-Σ' P
♭-commΣ P ._≃_.fwd-is-equiv .is-equiv.qinv .snd .fst (mod♭ a , mod♭ b) = refl
♭-commΣ P ._≃_.fwd-is-equiv .is-equiv.qinv .snd .snd (mod♭ (a , b)) = refl
♭-commΣ P ._≃_.fwd-is-equiv .is-equiv.coherent (mod♭ a , mod♭ b) = refl
}
}

\subtree[stt-00P0]{
\title{Flat preserves coproducts}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-15}

\agda{
♭-⊎
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A ⊎ B ⟩ → ⟨♭| A ⟩ ⊎ ⟨♭| B ⟩
♭-⊎ (mod♭ (inl a)) = inl (mod♭ a)
♭-⊎ (mod♭ (inr b)) = inr (mod♭ b)

♭-⊎⁻¹
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A ⟩ ⊎ ⟨♭| B ⟩ → ⟨♭| A ⊎ B ⟩
♭-⊎⁻¹ (inl (mod♭ a)) = mod♭ (inl a)
♭-⊎⁻¹ (inr (mod♭ b)) = mod♭ (inr b)

♭-⊎-is-equiv
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → is-equiv (♭-⊎ {A = A} {B})
♭-⊎-is-equiv = mk-eqv
  ( ♭-⊎⁻¹
  , ( λ where
      (mod♭ (inl a)) → refl
      (mod♭ (inr b)) → refl)
  , ( λ where
      (inl (mod♭ a)) → refl
      (inr (mod♭ b)) → refl))
  ( λ where
      (mod♭ (inl a)) → refl
      (mod♭ (inr b)) → refl)

♭-pres-⊎
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
    → ⟨♭| A ⊎ B ⟩ ≃ (⟨♭| A ⟩ ⊎ ⟨♭| B ⟩)
♭-pres-⊎ = mk≃ ♭-⊎ ♭-⊎-is-equiv
}
}


\subtree[stt-00K9]{
\taxon{Lemma}

\agda{
module _
  {@♭ 𝓤 𝓥 𝓦} {@♭ A : Type 𝓤} {@♭ B : A → Type 𝓥} {@♭ C : A → Type 𝓦}
  (@♭ f : (a : A) → B a → C a)
  where

  ♭-map-total-Arrow-equiv : Arrow-equiv (total-map (♭ᶠ-map f)) (♭-map (total-map f))
  ♭-map-total-Arrow-equiv
    = mk-arr-equiv (♭-commΣ _) (♭-commΣ _) (λ where (mod♭ a , mod♭ b) → refl)

  opaque
    ♭-map-total-is-equiv
      : is-equiv (total-map (♭ᶠ-map f))
      → is-equiv (♭-map (total-map f))
    ♭-map-total-is-equiv = tgt-is-equiv←Arrow-equiv (♭-map-total-Arrow-equiv)
}
}
