\date{2026-09-04}
\title{Free lattice algebras on finitely many generators}
\author{ulrikbuchholtz}
\taxon{Module}
\import{stt-macros}

\p{Iterating the [one-variable free algebra](stt-009W) gives the free
#{L}-algebra #{L[x_1, \ldots, x_n]} on #{n} generators. This is the shape a
[finite presentation](ub-001M) starts from, and hence what
[the duality axiom](ub-001P) quantifies over.}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Algebra.Lattice.Instances.Free.Multivariate
  {𝓤} {A : Type 𝓤} (L : Lattice A) (distr : is-distributive L)
  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Foundations.Fin

open import Algebra.Lattice.Instances.Polynomial

open import Ergonomics.Auto
open import Ergonomics.Extensionality
}
}

\subtree[ub-001K]{
\taxon{Definition}
\title{The free algebra on #{n} generators}

\p{#{L[x_1, \ldots, x_n]} is #{L} with the one-variable construction applied
#{n} times, which is possible because #{L[x]} is again distributive
(\ref{ub-001J}), each time over the algebra built so far. Its carrier is an #{n}-fold
iterate of [#{\Delta^2}](stt-009X): an element is a family of coefficients
indexed by the vertices of the #{n}-cube, monotone in the cube's order.}

\p{That it is the free algebra on #{n} generators is
\ref{ub-001U}, by #{n} applications of the [one-generator universal
property](stt-00A7). This is what identifies the construction with the
#{\II[x_1, \ldots, x_n]} that [the duality axiom](ub-001P) is stated over in
\citek{GWB26}.}

\agda{
Polynomials : ℕ → Type 𝓤
Polynomial-Lattice : (n : ℕ) → Lattice (Polynomials n)
Polynomial-distr : (n : ℕ) → is-distributive (Polynomial-Lattice n)

Polynomials zero = A
Polynomials (suc n) = Δ² (Polynomial-Lattice n)

Polynomial-Lattice zero = L
Polynomial-Lattice (suc n)
  = Free-Lattice (Polynomial-Lattice n) (Polynomial-distr n)

Polynomial-distr zero = distr
Polynomial-distr (suc n)
  = Polynomial-is-distributive (Polynomial-Lattice n) (Polynomial-distr n)

Polynomial-ι : (n : ℕ) → A → Polynomials n
Polynomial-ι zero = id
Polynomial-ι (suc n) = ι-const {L = Polynomial-Lattice n} ∘ Polynomial-ι n

Polynomial-ι-alg
  : (n : ℕ) → is-lattice-hom L (Polynomial-Lattice n) (Polynomial-ι n)
Polynomial-ι-alg zero = initial-lattice-algebra L
Polynomial-ι-alg (suc n)
  = is-lattice-hom-∘
      (Free-Lattice-is-lattice-algebra (Polynomial-Lattice n)
                                       (Polynomial-distr n))
      (Polynomial-ι-alg n)

Polynomial-Algebra : (n : ℕ) → Algebra L (Polynomials n)
Polynomial-Algebra n .Algebra.str-Lattice = Polynomial-Lattice n
Polynomial-Algebra n .Algebra.ι = Polynomial-ι n
Polynomial-Algebra n .Algebra.ι-alg = Polynomial-ι-alg n

Polynomial-Algebra-is-distributive
  : (n : ℕ) → is-distributive-algebra (Polynomial-Algebra n)
Polynomial-Algebra-is-distributive n = Polynomial-distr n
}

\p{The last variable adjoined is #{x = 1x \lor 0}, and the variables adjoined
earlier are carried along by the coefficient inclusion #{a \mapsto ax \lor a}.}

\agda{
Polynomial-var : (n : ℕ) → Polynomials (suc n)
Polynomial-var n
  = ( Lattice.1l (Polynomial-Lattice n)
    , Lattice.0l (Polynomial-Lattice n)) ⦃ Lattice.≤-bot (Polynomial-Lattice n) ⦄

Polynomial-incl : (n : ℕ) → Polynomials n → Polynomials (suc n)
Polynomial-incl n = ι-const {L = Polynomial-Lattice n}

Polynomial-gen : ∀ {n} → Fin n → Polynomials n
Polynomial-gen {suc n} fzero = Polynomial-var n
Polynomial-gen {suc n} (fsuc i) = Polynomial-incl n (Polynomial-gen i)
}
}

\subtree[ub-001T]{
\taxon{Definition}
\title{Free algebras on a set of generators}

\p{An #{L}-algebra #{A} equipped with a map #{S \to A} is \em{free on #{S}}
when every distributive #{L}-algebra sees it that way: an algebra map out of
#{A} is exactly a choice of image for each generator. Freeness is a property of
the pair #{(A, \mathrm{gen})}, not extra structure, and it determines #{A} up
to a unique isomorphism of algebras.}

\p{Distributivity of the target is asked for because it is asked for already in
the [one-generator case](stt-00A7): the evaluation map is a homomorphism only
when the target is distributive.}

\agda{
is-free-algebra-on
  : ∀ {𝓥 𝓥'} (S : Type 𝓥) {B : Type 𝓥'} (Alg : Algebra L B) (gen : S → B)
  → Typeω
is-free-algebra-on S Alg gen
  = ∀ {𝓦} {C : Type 𝓦} (M : Algebra L C) → is-distributive-algebra M
  → is-equiv (λ (f : LatticeAlgHom Alg M) → f .fst .fst ∘ gen)
}
}

\subtree[ub-001U]{
\taxon{Theorem}
\title{The #{n}-fold iterate is free on #{n} generators}

\p{#{L[x_1, \ldots, x_n]} is free on #{\mathrm{Fin}\,n}. The induction is the
composite of #{n} one-variable universal properties: an algebra map out of
#{M[x]} is an algebra map out of #{M} together with an image for the new
variable, and the coefficient inclusion #{M \to M[x]} is what restricts along.}

\agda{
Polynomial-incl-hom
  : (n : ℕ) → LatticeAlgHom (Polynomial-Algebra n) (Polynomial-Algebra (suc n))
Polynomial-incl-hom n .fst .fst = ι-const {L = Polynomial-Lattice n}
Polynomial-incl-hom n .fst .snd a = refl
Polynomial-incl-hom n .snd
  = mk-is-lattice-alg-hom
      (Free-Lattice-is-lattice-algebra
        (Polynomial-Lattice n) (Polynomial-distr n))

module _
  {𝓦} {C : Type 𝓦} (M : Algebra L C) (Md : is-distributive-algebra M)
  where

  private
    module M = Algebra M

    coefficients : (n : ℕ)
      → LatticeAlgHom (Polynomial-Algebra n) M
      → Algebra (Polynomial-Lattice n) C
    coefficients n g .Algebra.str-Lattice = M.str-Lattice
    coefficients n g .Algebra.ι = g .fst .fst
    coefficients n g .Algebra.ι-alg = un-is-lattice-alg-hom (g .snd)

  Polynomial-restrict : (n : ℕ)
    → LatticeAlgHom (Polynomial-Algebra (suc n)) M
    → C × LatticeAlgHom (Polynomial-Algebra n) M
  Polynomial-restrict n h
    = (h .fst .fst (Polynomial-var n) , LatticeAlgHom-∘ h (Polynomial-incl-hom n))

  Polynomial-adjoin : (n : ℕ)
    → C × LatticeAlgHom (Polynomial-Algebra n) M
    → LatticeAlgHom (Polynomial-Algebra (suc n)) M
  Polynomial-adjoin n (b , g) .fst .fst
    = eval-polynomial (Polynomial-Lattice n) (Polynomial-distr n)
        (coefficients n g) b .fst
  Polynomial-adjoin n (b , g) .fst .snd a
    = eval-polynomial (Polynomial-Lattice n) (Polynomial-distr n)
        (coefficients n g) b .snd (Polynomial-ι n a)
    ∙ g .fst .snd a
  Polynomial-adjoin n (b , g) .snd
    = mk-is-lattice-alg-hom
        (un-is-lattice-alg-hom
          (eval-polynomial-is-alg-hom
            (Polynomial-Lattice n) (Polynomial-distr n)
            (coefficients n g) Md b))

  private
    restrict-adjoin
      : (n : ℕ) (u : C × LatticeAlgHom (Polynomial-Algebra n) M)
      → Polynomial-restrict n (Polynomial-adjoin n u) ＝ u
    restrict-adjoin n (b , g)
      = ×-path→
          ( ap₂ M._∨_ (ap (M._∧ b) (ghom .is-lattice-hom.pres-1))
                      (ghom .is-lattice-hom.pres-0)
          ∙ ap (M._∨ M.0l) M.1-top'
          ∙ M.0-bottom
          , ext! (eval-polynomial (Polynomial-Lattice n) (Polynomial-distr n)
                    (coefficients n g) b .snd))
      where
        ghom = un-is-lattice-alg-hom (g .snd)

    adjoin-restrict
      : (n : ℕ) (h : LatticeAlgHom (Polynomial-Algebra (suc n)) M)
      → Polynomial-adjoin n (Polynomial-restrict n h) ＝ h
    adjoin-restrict n h = ext! H
      where
        module Pn = Lattice (Polynomial-Lattice n)
        open Pn using (≤-bot ; ≤-refl-inst ; ≤-top ; ≤-∧ ; ≤-∨)
        open is-lattice-hom

        hh : Polynomials (suc n) → C
        hh = h .fst .fst

        hhom : is-lattice-hom (Polynomial-Lattice (suc n)) M.str-Lattice hh
        hhom = un-is-lattice-alg-hom (h .snd)

        H : (z : Polynomials (suc n))
          → Polynomial-adjoin n (Polynomial-restrict n h) .fst .fst z ＝ hh z
        H ((a₀ , a₁) ⦃ p ⦄)
          = ap (M._∨ hh (a₁ , a₁)) (sym (hhom .pres-∧))
          ∙ ap (λ z → hh z M.∨ hh (a₁ , a₁))
               (Δ²-ext {b = (a₀ , Pn.0l) ⦃ ≤-bot ⦄} (Pn.1-top , Pn.0-init'))
          ∙ sym (hhom .pres-∨)
          ∙ ap hh (Δ²-ext (Pn.∨-comm ∙ Pn.≤-max p , Pn.0-bottom'))

  Polynomial-restrict-is-equiv : (n : ℕ) → is-equiv (Polynomial-restrict n)
  Polynomial-restrict-is-equiv n
    = is-equiv←qinv
        (Polynomial-adjoin n , adjoin-restrict n , restrict-adjoin n)

  Polynomial-adjoin-is-equiv : (n : ℕ) → is-equiv (Polynomial-adjoin n)
  Polynomial-adjoin-is-equiv n
    = is-equiv←qinv
        (Polynomial-restrict n , restrict-adjoin n , adjoin-restrict n)

  private

    initial←Polynomial-Algebra-0
      : LatticeAlgHom (Polynomial-Algebra 0) (initial-Algebra L)
    initial←Polynomial-Algebra-0
      = Algebra-id-hom ~refl (initial-lattice-algebra L)

    hom-0-is-single : is-singleton (LatticeAlgHom (Polynomial-Algebra 0) M)
    hom-0-is-single
      = is-single←equiv
          (LatticeAlgHom-precomp≃ initial←Polynomial-Algebra-0 id-is-equiv)
          (initial-Algebra-is-initial L M)

  Polynomial-ev
    : (n : ℕ) → LatticeAlgHom (Polynomial-Algebra n) M → (Fin n → C)
  Polynomial-ev n f = f .fst .fst ∘ Polynomial-gen

  Polynomial-ev-is-equiv : (n : ℕ) → is-equiv (Polynomial-ev n)
  Polynomial-ev-is-equiv zero
    = is-equiv←single-to-prop
        hom-0-is-single (is-prop←is-single Fin-0-fun-is-single) _
  Polynomial-ev-is-equiv (suc n)
    = is-equiv←~ H
        (is-equiv-∘ Fin-suc-fun-is-equiv
          (is-equiv-∘
            (×₁-is-equiv id-is-equiv (Polynomial-ev-is-equiv n))
            (Polynomial-restrict-is-equiv n)))
    where
      H : Polynomial-ev (suc n)
        ~ Fin-suc-fun ∘ (id ×₁ Polynomial-ev n) ∘ Polynomial-restrict n
      H h = funext→ λ where
              fzero → refl
              (fsuc i) → refl

Polynomial-Algebra-is-free
  : (n : ℕ) → is-free-algebra-on (Fin n) (Polynomial-Algebra n) Polynomial-gen
Polynomial-Algebra-is-free n M Md = Polynomial-ev-is-equiv M Md n
}
}

\subtree[ub-001V]{
\taxon{Corollary}
\title{Free algebras are unique}

\p{Two algebras free on the same set of generators are canonically isomorphic:
each is the image of the other's generators, and the two composites fix the
generators, so they are the identity. Hence \em{the} free algebra on a finite
set is the iterate above, and #{L[x_1, \ldots, x_n]} is unambiguous.}

\agda{
module _
  {𝓥 𝓥₁ 𝓥₂} {S : Type 𝓥}
  {B : Type 𝓥₁} {A : Algebra L B} (Ad : is-distributive-algebra A)
  {gen : S → B} (free : is-free-algebra-on S A gen)
  {B' : Type 𝓥₂} {A' : Algebra L B'} (Ad' : is-distributive-algebra A')
  {gen' : S → B'} (free' : is-free-algebra-on S A' gen')
  where

  private
    φ : LatticeAlgHom A A'
    φ = is-equiv.bwd (free A' Ad') gen'

    ψ : LatticeAlgHom A' A
    ψ = is-equiv.bwd (free' A Ad) gen

    φ-gen : φ .fst .fst ∘ gen ＝ gen'
    φ-gen = is-equiv.ε (free A' Ad') gen'

    ψ-gen : ψ .fst .fst ∘ gen' ＝ gen
    ψ-gen = is-equiv.ε (free' A Ad) gen

    ψφ : LatticeAlgHom-∘ ψ φ ＝ LatticeAlgHom-id A
    ψφ = unap-equiv (free A Ad) (ap (ψ .fst .fst ∘_) φ-gen ∙ ψ-gen)

    φψ : LatticeAlgHom-∘ φ ψ ＝ LatticeAlgHom-id A'
    φψ = unap-equiv (free' A' Ad') (ap (φ .fst .fst ∘_) ψ-gen ∙ φ-gen)

  free-algebra-compare : LatticeAlgHom A A'
  free-algebra-compare = φ

  free-algebra-compare-is-equiv
    : is-LatticeAlgHom-equiv free-algebra-compare
  free-algebra-compare-is-equiv
    = is-equiv←qinv
        ( ψ .fst .fst
        , LatticeAlgHom-~＝ _ _ ψφ
        , LatticeAlgHom-~＝ _ _ φψ)
}
}
