\subtree[tot-0001]{
\title{Cartesian morphisms}
\taxon{Definition}

\p{Given a map #{p : E \to B}, and a morphism #{f : \Delta^1 \to E},
we say that }

\agda{
module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} (p : E → B) where
  is-cocartesian-morphism
    : (Δ¹ → E) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-cocartesian-morphism f
    = is-cartesian (coslice-square p {q = f} (point i0 , ~refl))

module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} (p : E → B) where
  base-change-is-cocartesian-morphism
    : ∀ (f : Δ¹ → E)
      → is-cocartesian-morphism p f
      → is-cocartesian-morphism (base-change-arrow (p ∘ f) p) (gap (mk-cone id f ~refl))
  base-change-is-cocartesian-morphism f fcc
    = {!!}

module _ {𝓤 𝓥} {E : Type 𝓤} {B : Type 𝓥} (p : E → B) where
  is-locally-cocartesian-morphism
    : (Δ¹ → E) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-locally-cocartesian-morphism f
    = is-cocartesian-morphism (base-change-arrow (p ∘ f) p) (gap (mk-cone id f ~refl))

module _ {𝓤 𝓥} {B : Type 𝓤} (E : B → Type 𝓥) where
  is-cocartesian-morphismᶠ
    : ∀ {f : Δ¹ → B} (f' : (i : Δ¹) → E (f i)) → Type {!!}
  is-cocartesian-morphismᶠ {f} f'
    = {!is-equiv!} -- coslice fam map is cartesian

}
}

