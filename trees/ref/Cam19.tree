\title{A counterexample in quasi-category theory}
\author{Alexander Campbell}
\meta{doi}{10.1090/proc/14692}

\subtree{
\taxon{Abstract}
\p{
We give an example of a morphism of simplicial sets which is a monomorphism,
bijective on 0-simplices, and a weak categorical equivalence, but which is not inner
anodyne. This answers an open question of Joyal. Furthermore, we use this morphism to
refute a plausible description of the class of fibrations in Joyal's model structure
for quasi-categories.
}
}

