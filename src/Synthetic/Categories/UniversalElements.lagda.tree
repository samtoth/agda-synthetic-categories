\subtree[stt-00FX]{
\title{Universal elements}
\taxon{Definition}
\contributor{fredrikbakke}

\p{Given a covariant family #{F \colon A \to \UU}, we call the category #{\Sigma_A F}
the category of elements. Sometimes the integral notation is used (#{\int F}).
We remark that the morphisms in the category of elements are just morphisms in
#{A} such which 'respect' covariant transport.}

##{\Hom_{\int F}((a, x), (b, y)) \simeq \Sigma1{f : \Hom(a, b)}{(f^*(x) = y)}}

\p{
Note that the symbol #{∫} (agda-input: \code{int}) used here is the mathematical
integral operator, not the phonetic letter "esh" #{ʃ} (agda-input: \code{esh}) as
used for the [shape modality](stt-00LO).
}

\agda{
Hom-∫
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} (Bc : is-covariant B)
      {x} (x' : B x) {y} (y' : B y)
    → Hom (Σ A B) (x , x') (y , y')
    ≃ Σ[ f ∶ Hom A x y ]
       (tr-cov-hom Bc f x' ＝ y')
Hom-∫ {B = B} Bc x' y'
  = Hom-Σ≃ ∙e Σ-snd-≃ (λ a → Hom-cov'≃ B Bc a x' y' e⁻¹)
}

\p{Now fixing a family #{F}, we say that an element #{(a , x)} of #{F} is
universal if the map #{\Pi_b \Hom(a,b) \to F(b)} induced by covariant
transport at #{x : F(a)} is a fibrewise equivalence.}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {F : A → Type 𝓥} where

  yo : is-covariant F → (b : A) (x : F b) (a : A) → Hom A b a → F a
  yo Fc b x a f = tr-cov-hom Fc f x

  is-universal
    : is-covariant F → Σ A F → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-universal Fcov (a , x) = is-fibrewise-equiv (yo Fcov a x)

  universal-rec
    : (Fc : is-covariant F)
    → {x : Σ A F}
    → is-universal Fc x
    → {b : A}
    → F b
    → Hom A (x .fst) b
  universal-rec Fc un = is-equiv.bwd (un _)
}
}

\subtree[stt-014Q]{
\title{Fibrewise equivalences preserve universal elements}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-25}

\p{
Fibrewise equivalences between [covariant families](stt-00AY) preserve and reflect
[universal elements](stt-00FX).
}

\agda{
opaque
  is-universal-equiv↔
    : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {P : A → Type 𝓥} {Q : A → Type 𝓦}
      → (P-is-cov : is-covariant P) (Q-is-cov : is-covariant Q)
      → (e : (a : A) → P a ≃ Q a) {a : A} (x : P a)
      → is-universal P-is-cov (a , x) ↔ is-universal Q-is-cov (a , e a ._≃_.fwd x)
  is-universal-equiv↔ P-is-cov Q-is-cov e x
    = postcomp-Π-↔ (λ b
      → let H f = tr-cov-hom-naturality P-is-cov Q-is-cov (_≃_.fwd ∘ e) f x
            eb = e b ._≃_.fwd-is-equiv
        in (is-equiv-~∘ H eb , 3-for-2~ H eb))
}
}

\subtree[stt-00FY]{
\title{Universal elements are universal}
\taxon{Lemma}

\p{We show that an element is universal iff it is initial in the category of
elements.}

\proof{
\p{First, suppose that we have an initial element #{(a,x)} of #{F}. We want to show
that the map induced by covariant transport #{\phi \colon \Pi_b \Hom(a,b) \to F(b)} is a
fibrewise equivalence. Consider the fibre of #{\phi_b} at some #{x' : F(b)}:
##{
\begin{align*}
\fibre{\phi_b}{x'} &\simeq \Sigma1{f : \Hom(a,b)}{(f^*(x) = x')} \\
                  &\simeq \Hom((a,x), (b, x'))
\end{align*}
}}

\p{Then this fibre is contractible precisely because #{(a,x)} is initial.}


\p{In the converse direction suppose that the transport map #{\Pi_b \Hom(a,b) \to F(b)}
is a fibrewise equivalence. Then we have that the total map which we will denote
#{\bar\phi} is an equivalence
#{A_{a/} = \Sigma_b \Hom(a,b) \simeq \Sigma_b F(b)}. First we remark that #{\bar\phi}
takes #{(a, \id)} to #{(a,x)} since [covariant transport over the
identity is the identity](stt-00DQ). Then by \ref{stt-00G0} we know that, because
#{\bar\phi} is an equivalence and #{(a, \id)} is [initial in the coslice category](stt-00LJ),
#{\bar\phi(a, \id) = (a , x)} is also an initial object.
}
}

\agda{
universal←initial
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {F : A → Type 𝓥}
    → (Fc : is-covariant F)
    → {x : Σ A F}
    → is-initial x
    → is-universal Fc x
universal←initial {F = F} Fc {x} init a
  = is-equiv←has-singleton-fibres λ b
    → is-single←equiv (Hom-∫ Fc (x .snd) b) (init (a , b))

initial←universal
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {F : A → Type 𝓥}
    → (𝐴 : is-segal A)
    → (Fc : is-covariant F)
    → {x : Σ A F}
    → is-universal Fc x
    → is-initial x
initial←universal {A = A} {F} 𝐴 Fc {x , x'} univ
  = tr is-initial
       lem-id
       (is-initial←ladj (total-map (yo Fc x x')) _
         (is-left-adjoint←is-equiv (is-total-equiv←is-fibrewise-equiv univ))
         (coslice-init' 𝐴 x)) where
  lem : Σ[ z ∶ A ] (Hom A x z) ≃ Σ A F
  lem = mk≃ _ (is-total-equiv←is-fibrewise-equiv univ)

  lem-id : total-map (yo Fc x x') (x , idH _) ＝ (x , x')
  lem-id = Σ-path→ (refl , tr-cov-idH F Fc x')
}
}

\subtree[stt-00FW]{
\title{Colimits}
\taxon{Example}

\p{Given a pair of objects #{X, Y : A}, coproducts of #{X} and #{Y} in a category
are defined as universal objects of the covariant family
#{\Hom(X,{-}) \times \Hom(Y,{-})}.}

\agda{
Coproduct-cocone : ∀ {𝓤} {A : Type 𝓤} → A → A → A → Type (𝓘 ⊔ 𝓤)
Coproduct-cocone {A = A} X Y X+Y = (Hom A X X+Y) × (Hom A Y X+Y)

module Coproduct {𝓤} {A : Type 𝓤} (𝐴 : is-segal A) (X Y : A) where

  Coproduct-cocone-is-covariant : is-covariant (Coproduct-cocone X Y)
  Coproduct-cocone-is-covariant
    = ×-is-covariant {P = Hom A X} {Hom A Y} (hom-fam-cov 𝐴 X) (hom-fam-cov 𝐴 Y)

  is-coproduct : ∀ X+Y (cc : Coproduct-cocone X Y X+Y) → Type (𝓘 ⊔ 𝓤)
  is-coproduct X+Y cc
    = is-universal Coproduct-cocone-is-covariant (X+Y , cc)

  module _ X+Y (cc : Coproduct-cocone X Y X+Y) (X+Y-is-cp : is-coproduct X+Y cc)
    where
    [_] : ∀ {Z} → Hom A X Z × Hom A Y Z → Hom A X+Y Z
    [_] = is-equiv.bwd (X+Y-is-cp _)
}

\p{
More generally, given a diagram #{D \colon \mathcal{K} \to A}, colimits of #{D} are
defined to be universal objects of the covariant family #{\Hom(D,\Delta_{-})}.
}

\agda{
Colimit-cocone
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {𝒦 : Type 𝓥} → (𝒦 → A) → A → Type (𝓤 ⊔ 𝓥 ⊔ 𝓘)
Colimit-cocone {A = A} {𝒦} D apex = Hom (𝒦 → A) D (const apex)

module Colimit {𝓤 𝓥} {A : Type 𝓤} (𝐴 : is-segal A) {𝒦 : Type 𝓥} (D : 𝒦 → A) where

  opaque
    Colimit-cocone-is-covariant : is-covariant (Colimit-cocone D)
    Colimit-cocone-is-covariant
      = covariant-base-change
        {P = Hom (𝒦 → A) D}
        (const: A 𝒦)
        (hom-fam-cov (→-is-segal 𝐴) D)

  is-colimit : ∀ colimD (cc : Colimit-cocone D colimD) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  is-colimit colimD cc
    = is-universal Colimit-cocone-is-covariant (colimD , cc)
}
}

\subtree[stt-014P]{
\title{Colimits under restrictions of diagrams}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-25}

\p{
Let #{A} be a [Segal type](stt-00AI) and let #{j \colon K \to L} be such that
precomposition at #{A} is fully faithful #{(L \to A) \hookrightarrow (K \to A)}. Then
restriction along #{j} induces equivalences of [cocones](stt-00FW), and preserves and
reflects colimits.
}

\proof{
\p{
Full faithfulness yields a fibrewise equivalence of the covariant
families of cocones, and such equivalences [preserve and reflect universal
elements](stt-014Q), and hence colimits.
}
}

\agda{
module _
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {K : Type 𝓥} {L : Type 𝓦}
  (j : K → L) (D : L → A)
  where

  restrict-Colimit-cocone
    : {a : A} → Colimit-cocone D a → Colimit-cocone (D ∘ j) a
  restrict-Colimit-cocone = ap-hom (precomp A j)

  module _ (precomp-is-ff : is-ff (precomp A j)) where

    Colimit-cocone-restrict≃
      : (a : A) → Colimit-cocone D a ≃ Colimit-cocone (D ∘ j) a
    Colimit-cocone-restrict≃ a
      = mk≃ restrict-Colimit-cocone (is-ff'←is-ff precomp-is-ff)

    module _
      (𝐴 : is-segal A)
      (let module C = Colimit 𝐴 D)
      (let module C|j = Colimit 𝐴 (D ∘ j))
      where

      opaque
        is-colimit-restrict↔
          : {a : A} (cc : Colimit-cocone D a)
          → C.is-colimit a cc
          ↔ C|j.is-colimit a (restrict-Colimit-cocone cc)
        is-colimit-restrict↔
          = is-universal-equiv↔ C.Colimit-cocone-is-covariant
              C|j.Colimit-cocone-is-covariant Colimit-cocone-restrict≃

      colimits-restrict≃
        : (a : A)
        → (Σ[ cc ∶ Colimit-cocone D a ] C.is-colimit a cc)
        ≃ (Σ[ cc ∶ Colimit-cocone (D ∘ j) a ] C|j.is-colimit a cc)
      colimits-restrict≃ a
        = Σ-≃ (Colimit-cocone-restrict≃ a) (λ cc
          → equiv←logical
            (Π-is-prop (λ _ → is-equiv-is-prop))
            (Π-is-prop (λ _ → is-equiv-is-prop))
            (is-colimit-restrict↔ cc))
}
}
