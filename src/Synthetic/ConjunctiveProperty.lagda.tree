\subtree[bar-1525]{
\title{The pointwise order and interpolation on cubes}
\taxon{Construction}
\author{reidbarton}
\date{2026-06-08}

\agda{
_≤□_ : {n : ℕ} → □^ n → □^ n → Type 𝓘
_≤□_ {zero} _ _ = 𝟙ᴸ
_≤□_ {suc zero} i j = i ≤ j
_≤□_ {suc (suc n)} (i , i') (j , j') = (i ≤□ j) × (i' ≤ j')

module _ (i j : Δ¹) where

  interp1 : (t : Δ¹) → Δ¹
  interp1 t = i ∨ (t ∧ j)

  interp1-0 : i ≤ j → interp1 i0 ＝ i
  interp1-0 _ = ap (i ∨_) 0-init ∙ 0-bottom

  interp1-1 : i ≤ j → interp1 i1 ＝ j
  interp1-1 h = ap (i ∨_) (∧-comm ∙ 1-top) ∙ ≤-max h

interp : {n : ℕ} (i j : □^ n) → (t : Δ¹) → □^ n
interp {zero} i j t = ttᴸ
interp {suc zero} i j t = interp1 i j t
interp {suc (suc n)} (i' , i) (j' , j) t .fst = interp i' j' t
interp {suc (suc n)} (i' , i) (j' , j) t .snd = interp1 i j t

interp-0 : {n : ℕ} (i j : □^ n) (h : i ≤□ j) → interp i j i0 ＝ i
interp-0 {zero} i j h = refl
interp-0 {suc zero} i j h = interp1-0 i j h
interp-0 {suc (suc n)} (i' , i) (j' , j) (h' , h)
  = ×-path→ (interp-0 i' j' h' , interp1-0 i j h)

interp-1 : {n : ℕ} (i j : □^ n) (h : i ≤□ j) → interp i j i1 ＝ j
interp-1 {zero} i j h = refl
interp-1 {suc zero} i j h = interp1-1 i j h
interp-1 {suc (suc n)} (i' , i) (j' , j) (h' , h)
  = ×-path→ (interp-1 i' j' h' , interp1-1 i j h)

□-1-top : {n : ℕ} → {k : □^ n} → k ≤□ □-1
□-1-top {zero} = ttᴸ
□-1-top {suc zero} = 1-top
□-1-top {suc (suc n)} = □-1-top , 1-top
}
}

\subtree[bar-C67A]{
\title{Maps between cubes are monotone when the interval is directed}
\taxon{Lemma}
\author{reidbarton}

\agda{
Δ¹←□^-is-mono : {n : ℕ} (f : □^ n → Δ¹) (i j : □^ n) (h : i ≤□ j) → f i ≤ f j
Δ¹←□^-is-mono f i j h
  = tr₂ (λ x y → f x ≤ f y) (interp-0 i j h) (interp-1 i j h)
        (Δ¹-is-directed (f ∘ interp i j) i0 i1 1-top)

□^←□^-is-mono : {n m : ℕ} (f : □^ n → □^ m) (i j : □^ n) → i ≤□ j → f i ≤□ f j
□^←□^-is-mono {n} {zero} f i j h
  = ttᴸ
□^←□^-is-mono {n} {suc zero} f i j h
  = Δ¹←□^-is-mono f i j h
□^←□^-is-mono {n} {suc (suc m)} f i j h
  = (□^←□^-is-mono (fst ∘ f) i j h , Δ¹←□^-is-mono (snd ∘ f) i j h)

□^-order-ind
  : ∀ {𝓤} {n m : ℕ} → (f : □^ n → □^ m) → (P : □^ m → Type 𝓤)
  → (∀ {i j} → i ≤□ j → P j → P i) → P (f □-1) → (k : □^ n) → P (f k)
□^-order-ind f P hP hf k = hP (□^←□^-is-mono f k □-1 □-1-top) hf
}
}

\subtree[bar-0C79]{
\taxon{Theorem}
\author{reidbarton}
\contributor{fredrikbakke}

\agda{
fam-conjunctive-is-anti
  : {i j : □^ 2} → i ≤□ j → fam-conjunctive j → fam-conjunctive i
fam-conjunctive-is-anti {i1 , i2} {j1 , j2} (h1 , h2) =
  *-prop-rec fam-conjunctive-is-prop
    (λ H1 → ι₁ (＝0←≤0 (tr (i1 ≤_) H1 h1)))
    (λ H2 → ι₂ (＝0←≤0 (tr (i2 ≤_) H2 h2)))

vert' : (@♭ i j : Δ¹) → ∧=0 (i , j) → fam-conjunctive (i , j)
vert' i j = ♭Δ¹-ind
  ( λ i
    → (∧=0 (i , j) → fam-conjunctive (i , j))
    , Π-is-prop (λ _ → fam-conjunctive-is-prop))
  (λ _ → ι₁ refl)
  (♭Δ¹-ind
    ( λ j
      → (∧=0 (i1 , j) → fam-conjunctive (i1 , j))
      , Π-is-prop (λ _ → fam-conjunctive-is-prop))
    (λ _ → ι₂ refl)
    (λ h → ι₁ (sym 1-top ∙ h))
    j)
  i

vert : (@♭ ij : □^ 2) → ∧=0 ij → fam-conjunctive ij
vert (i , j) = vert' i j

vert-f
  : {@♭ n : ℕ} → (@♭ f : □^ n → □^ 2)
  → (∀ k → ∧=0 (f k)) → (∀ k → fam-conjunctive (f k))
vert-f f hf = □^-order-ind f fam-conjunctive
  fam-conjunctive-is-anti (vert (f □-1) (hf □-1))

♭-postcomp-Λ[2,0]-incl-section
  : {@♭ n : ℕ} → section (♭-map (postcomp (□^ n) Λ[2,0]-incl))
♭-postcomp-Λ[2,0]-incl-section .fst (mod♭ f)
  = mod♭ (λ p → f p .fst , vert-f (fst ∘ f) (snd ∘ f) p)
♭-postcomp-Λ[2,0]-incl-section .snd (mod♭ f)
  = mapply♭ (mod♭ (funext→ (λ p → Σ-path→ (refl , ∧=0-is-prop _ _))))

Λ[2,0]-incl-is-equiv : is-equiv Λ[2,0]-incl
Λ[2,0]-incl-is-equiv
  = family-separates-with-𝟙 □^_ cubes-separate {is = 0} single!
      (mk-arrow Λ[2,0]-incl)
      (is-equiv←section←injective
        (♭-map-is-injective (λ h → funext→ (Λ[2,0]-incl-is-embedding ◂emb happly h)))
        ♭-postcomp-Λ[2,0]-incl-section)

conjunctive-property : (i j : Δ¹) → i ∧ j ＝ i0 → (i ＝ i0) * (j ＝ i0)
conjunctive-property i j h
  = tr fam-conjunctive (ap fst (is-equiv.ε Λ[2,0]-incl-is-equiv ((i , j) , h)))
      (is-equiv.bwd Λ[2,0]-incl-is-equiv ((i , j) , h) .snd)
}
}
