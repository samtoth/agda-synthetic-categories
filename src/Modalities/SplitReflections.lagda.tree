\title{Split-reflections into reflective subuniverses}
\taxon{Module}
\author{fredrikbakke}
\import{stt-macros}

\agda{
open import Modalities.GlobalReflectiveSubuniverses

module Modalities.SplitReflections {α} (K : gRSubU α) where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Foundations.SplitReflections
open import Core.SurjectiveMaps
open import Modalities.ConnectedTypes
open import Modalities.ConnectedMaps
open import Modalities.Instances.Truncation
}
}

\agda{
open gRSubU K
open gReflectiveClosure K
module Split {𝓤} {A : Type 𝓤} = SplitReflection global-funext GS A
}

\subtree[bak-2C2B]{
\title{Comparison from the reflection to the split-reflection}
\taxon{Construction}
\author{fredrikbakke}

\p{
There's a comparison map from the reflection of #{A} to the split-reflection of #{A}
which factors the split-reflector.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  split←reflection : ○ A → Split.type
  split←reflection = ○-rec (Split.∈S Π∈S) Split.η

  split←reflection-β : split←reflection ∘ η ~ Split.η
  split←reflection-β = ○-rec-β (Split.∈S Π∈S) Split.η
}
}

\subtree[bak-B15B]{
\title{Retractions of the reflection from the split-reflection}
\taxon{Theorem}
\author{fredrikbakke}

\p{
If #{○ A} is a retract of #{A} then #{○ A} is a retract of the split-reflection of
#{A}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  reverse-split←reflection : section (η: A) → Split.type → ○ A
  reverse-split←reflection σ = Split.elim ○∈S (σ .fst , η , σ .snd)

  reverse-split←reflection-β
    : (σ : section (η: A)) → reverse-split←reflection σ ∘ Split.η ~ η
  reverse-split←reflection-β σ = Split.elim-β ○∈S (σ .fst , η , σ .snd)

  split←reflection-retraction
    : section (η: A) → retraction split←reflection
  split←reflection-retraction σ
    = ( reverse-split←reflection σ
      , ∈S▸η.bwd ○∈S
        ( reverse-split←reflection σ ◃h split←reflection-β
        ∙h reverse-split←reflection-β σ))

  reflection-retract-split-reflection
    : section (η: A) → retract (○ A) Split.type
  reflection-retract-split-reflection σ
    = (split←reflection , split←reflection-retraction σ)
}
}

\subtree[bak-701B]{
\title{Connectedness and contractibility of the split-reflection}
\taxon{Theorem}
\author{fredrikbakke}

\p{
If #{A} is #{K}-connected then the split-reflection is a singleton. Conversely,
if the split-reflection is a singleton and the #{K}-reflection of #{A} has a section
then #{A} is #{K}-connected.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  split-reflection-is-single←is-connected
    : is-connected K A → is-singleton Split.type
  split-reflection-is-single←is-connected c
    = Split.is-single←null-homotopy-η
        ( split←reflection (c .centre)
        , (λ a → ap split←reflection (c .central (η a)) ∙ split←reflection-β a))

  is-connected←split-reflection-is-single
    : section (η: A) → is-singleton Split.type → is-connected K A
  is-connected←split-reflection-is-single σ
    = is-single←retraction split←reflection (split←reflection-retraction σ)
}
}
