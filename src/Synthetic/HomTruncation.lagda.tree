\subtree[bak-B254]{
\title{The hom truncation generator}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-19}

\p{
The \em{hom #{k}-truncation generator} is the
[directed suspension](bak-D451) of #{\sphere{k+1} \to \b1}.
A \em{hom #{k}-truncated type} is a type that is local at this map.
}

\p{
For #{k=0}, the generator projects a circle of arrows with common
endpoints down to a single arrow, as the following diagram depicts.
}

\quiver{
\usetikzlibrary{arrows.meta,decorations.markings}
\definecolor{agda-fg}{HTML}{2B3137}
\definecolor{agda-muted}{HTML}{7F9098}
\definecolor{agda-steel}{HTML}{35617D}
\definecolor{agda-steel-bright}{HTML}{2F6F99}
\begin{tikzpicture}[
  color=agda-fg, line cap=round, line join=round, >=Stealth,
  directed/.style={
    postaction={decorate},
    decoration={markings, mark=at position 0.57 with {\arrow{Stealth}}}
  },
  endpoint/.style={circle, fill, inner sep=1.6pt}
]
  \fill[agda-steel!5]
    (0,0) .. controls (1.1,1.5) and (2.5,1.5) .. (3.6,0)
    .. controls (2.5,-1.5) and (1.1,-1.5) .. (0,0);
  \draw[agda-muted, dashed, directed]
    (0,0) .. controls (1.1,0.48) and (2.5,0.48) .. (3.6,0);
  \draw[agda-muted, dashed]
    (1.8,1.125) arc[start angle=90, end angle=270,
      x radius=0.3, y radius=1.125];
  \draw[agda-steel, semithick, directed]
    (0,0) .. controls (1.1,1.5) and (2.5,1.5) .. (3.6,0);
  \draw[agda-steel, semithick, directed]
    (0,0) .. controls (1.1,-1.5) and (2.5,-1.5) .. (3.6,0);
  \draw[agda-steel, semithick, directed]
    (0,0) .. controls (1.1,-0.48) and (2.5,-0.48) .. (3.6,0);
  \draw[agda-steel-bright, semithick]
    (1.8,-1.125) arc[start angle=-90, end angle=90,
      x radius=0.3, y radius=1.125];
  \node[agda-steel-bright, above right] at (1.9,1.125) {$\sphere{1}$};
  \node[endpoint, label=below left:{$0$}] at (0,0) {};
  \node[endpoint, label=below right:{$1$}] at (3.6,0) {};
  \node at (1.8,-1.7) {$\suspension_{\iota_{\partial\Delta^1}}\sphere{1}$};

  \draw[|->, thick] (4.3,0) -- (6.1,0);

  \draw[agda-steel, semithick, directed] (6.9,0) -- (9.5,0);
  \node[endpoint, label=below:{$0$}] at (6.9,0) {};
  \node[endpoint, label=below:{$1$}] at (9.5,0) {};
  \node at (8.2,-1.7) {$\suspension_{\iota_{\partial\Delta^1}}\b1 \simeq \Delta^1$};
\end{tikzpicture}
}

\p{
Being local at this particular map [characterises](bak-173E) types with set-valued
homs.
}

\agda{
hom-truncation-generator
  : (k : 𝕋) → DirectedSusp (S (suc-𝕋₋₁←𝕋 k)) → DirectedSusp 𝟙
hom-truncation-generator k
  = DirectedSusp-map (!: S (suc-𝕋₋₁←𝕋 k))

generator-fam-hom-truncation : (k : 𝕋) → fibrewise-map _ _
generator-fam-hom-truncation k = point (hom-truncation-generator k)

is-hom-truncated : ∀ {𝓤} → 𝕋 → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
is-hom-truncated k = is-local (generator-fam-hom-truncation k)

HomTruncation-gRSubU : 𝕋 → gRSubU (𝓘 ⊔_)
HomTruncation-gRSubU k = Local-gRSubU (generator-fam-hom-truncation k)
}
}

\subtree[bak-173E]{
\title{Hom truncation characterises truncated hom types}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
A type is hom #{k}-truncated if and only if each of its hom types is #{k}-truncated.
Thus hom truncation is the [hom separation](bak-2678) of the
[#{k}-truncation subuniverse](stt-006Q).
}

\agda{
module _ (k : 𝕋) where

  module _ {𝓤} {A : Type 𝓤} where

    Hom-is-truncated←is-hom-truncated
      : is-hom-truncated k A → (a b : A) → is-truncated k (Hom A a b)
    Hom-is-truncated←is-hom-truncated loc a b
      = is-truncated←null k (is-null←is-local
          (λ _ → Hom-is-local←is-DirectedSusp-local
            (!: S (suc-𝕋₋₁←𝕋 k)) (loc tt) a b))

    is-hom-truncated←Hom-is-truncated
      : ((a b : A) → is-truncated k (Hom A a b)) → is-hom-truncated k A
    is-hom-truncated←Hom-is-truncated h _
      = is-DirectedSusp-local←Hom-is-local (!: S (suc-𝕋₋₁←𝕋 k))
          (λ a b → is-local←is-null (is-null←truncated k (h a b)) tt)

    is-hom-truncated↔Hom-is-truncated
      : is-hom-truncated k A ↔ ((a b : A) → is-truncated k (Hom A a b))
    is-hom-truncated↔Hom-is-truncated
      = ( Hom-is-truncated←is-hom-truncated
        , is-hom-truncated←Hom-is-truncated)

  HomTruncation≃hom-separated-gSubU
    : gSubU-equiv
        (gRSubU.GS (HomTruncation-gRSubU k))
        (HomSeparated-gSubU (Truncation-gSubU k))
  HomTruncation≃hom-separated-gSubU A
    = ( is-hom-separated←Hom∈S (Truncation-gSubU k)
      ∘ Hom-is-truncated←is-hom-truncated
      , is-hom-truncated←Hom-is-truncated
      ∘ Hom∈S←is-hom-separated (Truncation-gSubU k))
}
}

\subtree[bak-8C75]{
\title{The hom truncation reflector}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-19}

\p{
The hom #{k}-truncation of a type is its reflection into types with #{k}-truncated
homs.
}

\agda{
module HomTruncation (k : 𝕋) where
  open gRSubU (HomTruncation-gRSubU k) public
  open gReflectiveReasoning (HomTruncation-gRSubU k) public
  open gReflectiveClosure (HomTruncation-gRSubU k) public

  hom-is-truncated
    : ∀ {𝓤} {A : Type 𝓤} (a b : ○ A) → is-truncated k (Hom (○ A) a b)
  hom-is-truncated = Hom-is-truncated←is-hom-truncated k ○∈S

  reflects-truncated-homs
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → ((a b : B) → is-truncated k (Hom B a b))
      → is-equiv (precomp B (η: A))
  reflects-truncated-homs h
    = reflects (is-hom-truncated←Hom-is-truncated k h)
}
}
