\subtree[stt-00C4]{
\title{Slice types}
\taxon{Definition}

\p{Given a type #{C} and an element #{c} of #{C}, we define a type
#{C_{c/}} whose elements consists of morphisms in #{C} with codomain #{c}.
Equivalently, this is the fibre of the evaluation at #{1} map, #{C^{\Delta^1} \to C}.
}

\agda{
module _ {𝓤} {C : Type 𝓤} where
  Slice : C → Type (𝓘 ⊔ 𝓤)
  Slice = fibre (ev: C i1)

  infix 25 Slice-proj:_ Slice-const:_

  Slice-proj:_ : ∀ (c : C) → Slice c → C
  Slice-proj:_ c = ev i0 ∘ fst

  Slice-proj : ∀ {c : C} → Slice c → C
  Slice-proj = Slice-proj: _

  Hom←Slice : {c : C} → (x : Slice c) → Hom C (Slice-proj x) c
  Hom←Slice x .Homᵈ.hom = x .fst
  Hom←Slice x .Homᵈ.hom0 = refl
  Hom←Slice x .Homᵈ.hom1 = x .snd

  Slice←Hom : {a b : C} → Hom C a b → Slice b
  Slice←Hom f = (f .Homᵈ.hom , f .Homᵈ.hom1)

  Slice-const:_ : (c : C) → Slice c
  Slice-const:_ c = (const c , refl)
}
}

\subtree[tot-CYR1]{
\title{Slice projection as a base-change of the endpoint evaluation map}
\taxon{Lemma}
\date{2026-09-22}
\author{samueltoth}

\p{The domain projection #{C_{c/} \to C} is a base-change of
#{C^{\Delta^1} \to C \times C} by #{C \xrightarrow{(_, c)} C \times C}.}

\agda{
module _ {𝓤} {C : Type 𝓤} (c : C) where

  src×tgt←slice-proj : Arrow-map (Slice-proj: c) (src×tgt: C)
  src×tgt←slice-proj .Arrow-Π.top = fst
  src×tgt←slice-proj .Arrow-Π.bot = (_, c)
  src×tgt←slice-proj .Arrow-Π.comm (f , p) = ×-path→ (refl , sym p)

  opaque
    slice-proj-base-change-of-src×tgt : is-cartesian src×tgt←slice-proj
    slice-proj-base-change-of-src×tgt a
      = is-equiv←~
          (λ where ((f , refl) , refl) → refl)
          (eqv a ._≃_.fwd-is-equiv)
      where

      eqv : ∀ a → fibre (Slice-proj: c) a ≃ fibre (src×tgt: C) (a , c)
      eqv a = Σ-assoc ∙e Σ-snd-≃ (λ f → ×-swap ∙e ×-path)
}
}

\subtree[tot-7YCZ]{
\title{The fibres of the slice projection}
\taxon{Lemma}

\p{For any #{x : C}, the fibre of the map #{C_{/c} \to C} at #{x} is equivalent to
the type of morphisms #{\Hom(x,c)}.}

\agda{
module _ {𝓤} {C : Type 𝓤} (c : C) where

  Slice-fibre≃ : ∀ (b : C) → Hom C b c ≃ fibre (Slice-proj: c) b
  Slice-fibre≃ d = Homᵈ-repr≃ {A = const C} ∙e Σ-snd-≃ (λ f → ×-swap) ∙e Σ-assoc e⁻¹

  Slice-hom-repr≃ : (Σ[ b ∶ C ] Hom C b c) ≃ Slice c
  Slice-hom-repr≃ = Σ-snd-≃ Slice-fibre≃ ∙e total≃total-fibre Slice-proj
}
}

\subtree[tot-1A4I]{
\title{Slices are comma types}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-29}

\p{For any map #{a : A}, the slice #{A_{/a}} is equivalent to the
comma type of the cospan #{A \to A \leftarrow \{a\}}.}

\agda{
Slice-directed-cone
  : ∀ {𝓤} {A : Type 𝓤}
      (a : A)
    → directed-cone (mk-cospan A id (point a)) (Slice a)
Slice-directed-cone F .directed-cone.p = Slice-proj
Slice-directed-cone F .directed-cone.q = !
Slice-directed-cone F .directed-cone.filler = Hom←Slice

Slice≃Comma
  : ∀ {𝓤} {A : Type 𝓤} (a : A)
    → id ↓ point a ≃ Slice a
Slice≃Comma a = Slice-hom-repr≃ a ∘e Σ-snd-≃ (λ _ → Σ-𝟙)

Slice-is-comma
  : ∀ {𝓤} {A : Type 𝓤} (a : A)
    → is-comma (Slice-directed-cone a)
Slice-is-comma a = bwd-is-equiv (Slice≃Comma a)

Slice-up-comma
  : ∀ {𝓤} {A : Type 𝓤} (a : A)
    → up-comma (Slice-directed-cone a)
Slice-up-comma a = up-comma←is-comma (Slice-is-comma a)
}
}

\subtree[stt-00TO]{
\taxon{Lemma}

\p{We give a presentation of the comma type #{F \downarrow \{b\}} as
the pullback #{A \times_{B} B_{/b}}.}

\agda{
module _
  {𝓤 𝓥}
  {A : Type 𝓤} {B : Type 𝓥}
  (F : A → B)
  (b : B)
  where

  pb-slice←comma-point
    : F ↓ point b → Pullback (Slice-proj: b) F
  pb-slice←comma-point (x , _ , f) = (Slice←Hom f , x , f .Homᵈ.hom0)

  comma-point←pb-slice
    : Pullback (Slice-proj: b) F
    → F ↓ point b
  comma-point←pb-slice (f , c , p) = (c , _ , mk-hom (f .fst) p (f .snd))

  comma-point←pb-slice-is-equiv
    : is-equiv comma-point←pb-slice
  comma-point←pb-slice-is-equiv .is-equiv.qinv .fst = pb-slice←comma-point
  comma-point←pb-slice-is-equiv .is-equiv.qinv .snd = (~refl , ~refl)
  comma-point←pb-slice-is-equiv .is-equiv.coherent = ~refl
}
}


\subtree[tot-0943]{
\title{[Global reflective subuniverses]() are closed under taking slices}
\taxon{Lemma}
\author{samueltoth}
\date{2026-09-22}

\agda{
module gReflectiveSliceClosure
  {α 𝓤} (K : gRSubU α)
  (open gRSubU K renaming (S to 𝓚))
  (open gReflectiveClosure K)
  {C : Type 𝓤} (c : C) (C∈K : C ∈ 𝓚)
  where

  Slice∈S : Slice c ∈ 𝓚
  Slice∈S = fibre∈S (ev i1) c (Π∈S (λ _ → C∈K)) C∈K
}

\p{In particular, slices of [(complete)]() [Segal types]() are (complete) Segal, and
slices of [(pre)]()[categories]() are (pre)categories.}

\agda{
module _ {𝓤} {C : Type 𝓤} (c : C) where

  open gReflectiveSliceClosure Segal-gRSubU c public
    renaming (Slice∈S to Slice-is-segal)

  open gReflectiveSliceClosure Precat-gRSubU c public
    renaming (Slice∈S to Slice-is-precategory)

  -- open gReflectiveSliceClosure CompleteSegal-gRSubU c public
  --   renaming (Slice∈S to Slice-is-complete-segal)

  -- open gReflectiveSliceClosure Category-gRSubU c public
  --   renaming (Slice∈S to Slice-is-category)
}
}

\subtree[tot-00Y6]{
\title{Functoriality of the slice construction}
\taxon{Construction}
\date{2026-09-22}
\author{samueltoth}

\p{The slice construction determines a functor #{\Type_* \to \Type}.}

\agda{
module _ (open Type∗) (open map∗) where

  Slice₀ : ∀ {𝓤} → Type∗ 𝓤 → Type (𝓘 ⊔ 𝓤)
  Slice₀ A = Slice (A .Type∗.pt)

  Slice₁ : ∀ {𝓤 𝓥} {A : Type∗ 𝓤} {B : Type∗ 𝓥} → map∗ A B → Slice₀ A → Slice₀ B
  Slice₁ (mk-map∗ f p) = map-Σ (postcomp Δ¹ f) (λ g → (_∙ p) ∘ ap f)

  Slice-id : ∀ {𝓤} {A : Type∗ 𝓤} → Slice₁ (id∗ A) ~ id: (Slice₀ A)
  Slice-id x = fibre-path→ (refl , (sym (∙-reflr _ ∙ ap-id _)))

  Slice-∘
    : ∀ {𝓤 𝓥 𝓦} {A : Type∗ 𝓤} {B : Type∗ 𝓥} {C : Type∗ 𝓦}
        {f : map∗ B C} {g : map∗ A B}
      → Slice₁ (f ∘∗ g) ~ Slice₁ f ∘ Slice₁ g
  Slice-∘ {f = f} {g} h
    = fibre-path→
        ( refl
        , ap (_∙ f .pres-pt)
            ( ap-∙ (f .hom) _ (g .pres-pt)
            ∙ ap (_∙ ap (f .hom) (g .pres-pt)) (sym (ap-∘ (f .hom) (g .hom) (h .snd))))
        ∙ ∙-assoc (ap (f .hom ∘ g .hom) (h .snd)) (ap (f .hom) (g .pres-pt)) (f .pres-pt))
}
}
