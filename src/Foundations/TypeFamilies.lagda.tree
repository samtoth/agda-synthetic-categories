\subtree[stt-00F8]{
\title{Type families and dependent type families}
\taxon{Definition}

\p{
A \em{type family} is a function #{B : A \to \UU}. A \em{dependent type family} over the
type family #{B : A \to \UU} is a function #{Y : (a : A) \to X(a) \to \UV}.
}

\agda{
Fam : (𝓤1 𝓤2 : Level) → Type (lsuc 𝓤1 ⊔ lsuc 𝓤2)
Fam 𝓤1 𝓤2 = Σ (Type 𝓤1) (λ X → X → Type 𝓤2)

{-# NOINLINE Fam #-}

DepFam
  : {𝓤1 𝓤2 : Level}
  → (𝓤3 𝓤4 : Level)
  → Fam 𝓤1 𝓤2
  → Type (𝓤1 ⊔ lsuc 𝓤3 ⊔ lsuc 𝓤4)
DepFam 𝓤3 𝓤4 (A , B)
  = Σ (A → Type 𝓤3)
      (λ X → (a : A) → X a → Type 𝓤4)

Dep²Fam
  : {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  → (𝓤5 𝓤6 : Level)
  → (F : Fam 𝓤1 𝓤2)
  → DepFam 𝓤3 𝓤4 F
  → Type (𝓤1 ⊔ 𝓤3 ⊔ lsuc 𝓤5 ⊔ lsuc 𝓤6)
Dep²Fam 𝓤5 𝓤6 (A , B) (X , Y)
  = Σ ((a : A) → X a → Type 𝓤5)
      (λ U → (a : A) (x : X a) → U a x → Type 𝓤6)
}
}

\subtree[stt-00KO]{
\title{Maps of type families}
\author{samueltoth}
\date{2026-03-23}

\agda{
module _ {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
         (F@(A , B) : Fam 𝓤1 𝓤2)
         (G@(X , Y) : Fam 𝓤3 𝓤4) where
  Fam-map : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Fam-map = Σ[ f ∶ (A → X) ] (∀ a → B a → Y (f a))

  Cart-fam-map : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Cart-fam-map = Σ[ f ∶ (A → X) ] (∀ a → B a ≃ Y (f a))

module _ {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
         {F@(A , B) : Fam 𝓤1 𝓤2}
         {G@(X , Y) : Fam 𝓤3 𝓤4} where
  Fam-map-homotopy
    : Fam-map F G → Fam-map F G → Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Fam-map-homotopy (f , g) (f' , g')
    = Σ[ H ∶ (f ~ f')] (∀ a → tr Y (H a) ∘ g a ~ g' a)

  Fam-map-refl~
    : ∀ (a : Fam-map F G) → Fam-map-homotopy a a
  Fam-map-refl~ a = (~refl , (λ _ → ~refl))

  is-cartesianᶠ
    : Fam-map F G → Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  is-cartesianᶠ F = ∀ a → is-equiv (F .snd a)

  Cart-fam-map←is-cartesian
    : Σ (Fam-map F G) is-cartesianᶠ → Cart-fam-map F G
  Cart-fam-map←is-cartesian (a , b)
    = (a .fst , λ x → mk≃ (a .snd x) (b x))

  Cart-fam-map←is-cartesian-is-equiv
    : is-equiv Cart-fam-map←is-cartesian
  Cart-fam-map←is-cartesian-is-equiv .is-equiv.qinv .fst (a , b)
    = ((a , _≃_.fwd ∘ b) , _≃_.fwd-is-equiv ∘ b)
  Cart-fam-map←is-cartesian-is-equiv .is-equiv.qinv .snd .fst _ = refl
  Cart-fam-map←is-cartesian-is-equiv .is-equiv.qinv .snd .snd _ = refl
  Cart-fam-map←is-cartesian-is-equiv .is-equiv.coherent _ = refl
}
}

\subtree[stt-00FA]{
\title{Equivalences of type families}
\taxon{Definition}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  (F@(A , B) : Fam 𝓤1 𝓤2)
  (G@(X , Y) : Fam 𝓤3 𝓤4)
  where

  infix 6 _≃ᶠ_
  _≃ᶠ_ : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  _≃ᶠ_ = Σ[ (mk≃ e _) ∶ A ≃ X ] ((a : A) → B a ≃ Y (e a))
}
}

\subtree[stt-00FB]{
\title{Straightening–unstraightening for type families}
\taxon{Construction}

\agda{
arrow←Fam
  : {𝓤1 𝓤2 : Level}
    (F : Fam 𝓤1 𝓤2)
  → Σ (fst F) (snd F) → fst F
arrow←Fam F = fst

arrow←Fam-fibre-fam
  : {𝓤1 𝓤2 : Level}
    {A : Type 𝓤1}
    {B : Type 𝓤2}
    (f : A → B)
  → arrow←Fam (fibre-fam f) ＝ fst
arrow←Fam-fibre-fam f = refl

fibre-fam-arrow←Fam≃ᶠ
  : {𝓤1 𝓤2 : Level}
    (F : Fam 𝓤1 𝓤2)
  → fibre-fam (arrow←Fam F) ≃ᶠ F
fibre-fam-arrow←Fam≃ᶠ (A , B)
  = id≃ , fibre-straighten B
}
}

\subtree[stt-00FC]{
\title{Dependent type families from nondependent type families}
\taxon{Definition}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  (F@(A , B) : Fam 𝓤1 𝓤2)
  (G@(X , Y) : Fam 𝓤3 𝓤4)
  where

  Fam→DepFam : DepFam 𝓤3 𝓤4 F
  Fam→DepFam = ((λ _ → X) , (λ _ → Y))

  Fam→Dep²Fam
    : {𝓤5 𝓤6 : Level}
    → Fam 𝓤5 𝓤6
    → Dep²Fam 𝓤5 𝓤6 F Fam→DepFam
  Fam→Dep²Fam (U , V)
    = ((λ _ _ → U) , (λ _ _ → V))

  DepFam→Dep²Fam
    : {𝓤5 𝓤6 : Level}
    → DepFam 𝓤5 𝓤6 G
    → Dep²Fam 𝓤5 𝓤6 F Fam→DepFam
  DepFam→Dep²Fam (U , V)
    = ((λ _ → U) , (λ _ → V))
}
}

\subtree[stt-00FD]{
\title{Identity and composition of equivalences of type families}
\taxon{Definition}

\agda{
id≃ᶠ : ∀ {𝓤1 𝓤2} (F : Fam 𝓤1 𝓤2) → F ≃ᶠ F
id≃ᶠ (A , B) = id≃ , (λ _ → id≃)

concat≃ᶠ
  : ∀ {𝓤1 𝓤2 𝓤3 𝓤4 𝓤5 𝓤6}
      {F : Fam 𝓤1 𝓤2}
      {G : Fam 𝓤3 𝓤4}
      (H : Fam 𝓤5 𝓤6)
    → F ≃ᶠ G
    → G ≃ᶠ H
    → F ≃ᶠ H
concat≃ᶠ H (e , ef) (e' , eg)
  = e ∙e e'
  , (λ a → ef a ∙e eg (e ._≃_.fwd a))
}
}


\subtree[stt-00KU]{
\taxon{Lemma}
\author{samueltoth}
\date{2026-03-24}

\agda{
postcomp-≃ᶠ
  : ∀ {𝓤 𝓥 𝓦 𝓜 𝓦' 𝓜'} {F : Fam 𝓤 𝓥} {G : Fam 𝓦 𝓜} {H : Fam 𝓦' 𝓜'}
    → G ≃ᶠ H → Cart-fam-map F G → Cart-fam-map F H
postcomp-≃ᶠ (x , y)
  = map-Σ (x ._≃_.fwd ∘_) λ a → postcomp-Π (λ i → _∙e y (a i))
}
}

\subtree[stt-00FE]{
\title{Equivalences of dependent type families over a fixed base}
\taxon{Definition}

\agda{
≃ᵈᶠ-over
  : {𝓤1 𝓤2 𝓤3 𝓤4 𝓤5 𝓤6 : Level}
    (F@(A , B) : Fam 𝓤1 𝓤2)
    (G@(X , Y) : DepFam 𝓤3 𝓤4 F)
    (H@(U , V) : DepFam 𝓤5 𝓤6 F)
  → Type (𝓤1 ⊔ 𝓤3 ⊔ 𝓤4 ⊔ 𝓤5 ⊔ 𝓤6)
≃ᵈᶠ-over F (X , Y) (U , V)
  = (a : fst F) → (X a , Y a) ≃ᶠ (U a , V a)

syntax ≃ᵈᶠ-over F G H = G ≃ᵈᶠ⟦ F ⟧ H
}
}

\subtree[stt-00FF]{
\title{Identity and composition of dependent family equivalences}
\taxon{Definition}

\agda{
id≃ᵈᶠ
  : {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
    (F : Fam 𝓤1 𝓤2)
    (G@(X , Y) : DepFam 𝓤3 𝓤4 F)
  → G ≃ᵈᶠ⟦ F ⟧ G
id≃ᵈᶠ F (X , Y) a = id≃ᶠ (X a , Y a)

concat≃ᵈᶠ
  : {𝓤1 𝓤2 𝓤3 𝓤4 𝓤5 𝓤6 𝓤7 𝓤8 : Level}
    (F : Fam 𝓤1 𝓤2)
    (G : DepFam 𝓤3 𝓤4 F)
    (H : DepFam 𝓤5 𝓤6 F)
    (K : DepFam 𝓤7 𝓤8 F)
  → G ≃ᵈᶠ⟦ F ⟧ H
  → H ≃ᵈᶠ⟦ F ⟧ K
  → G ≃ᵈᶠ⟦ F ⟧ K
concat≃ᵈᶠ F (X , Y) (U , V) (P , Q) e e' a
  = concat≃ᶠ (P a , Q a) (e a) (e' a)
}
}
