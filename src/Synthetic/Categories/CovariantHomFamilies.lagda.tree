\subtree[stt-00D6]{
\title{Straightening the coslice projection}
\taxon{Remark}

\p{The unstraightening of the type family #{\Hom(x,-)} is the canonical projection #{X_{x/} \to X}. Thus
representable families are covariant iff #{X_{x/} \to X} are all left fibrations.}

\agda{
hom-fam-is-cov↔is-left-fibration
  : ∀ {𝓤} {X : Type 𝓤} (x : X)
    → is-covariant (λ a → Hom X x a)
    ↔ is-left-fibration {A = 𝑪ocone (point x)} fst
hom-fam-is-cov↔is-left-fibration {X = X} x
  = is-covariant↔is-left-fibration (λ a → Hom X x a)
  ∙iff right-orthogonal-iff←Arrow-equiv (λ _ → i0) eq where
  eq : Arrow-equiv (fst {B = λ c → (i : 𝟙) → Hom X x c})
                   (fst {B = λ a → Hom X x a})
  eq = mk-arr-equiv (Σ-snd-≃ λ _ → unit-UP≃) id≃ ~refl

hom-fam-is-cov↔𝐂oslice-is-left-fibration
  : ∀ {𝓤} {X : Type 𝓤} (x : X)
    → is-covariant (λ a → Hom X x a)
    ↔ is-left-fibration (𝐂oslice-proj: x)
hom-fam-is-cov↔𝐂oslice-is-left-fibration {X = X} x
  = (is-left-family↔is-covariant (λ a → Hom X x a)) iff⁻¹
  ∙iff right-orthogonal-iff←fam-equiv (point i0)
        {C = fibre (𝐂oslice-proj: x)} {D = Hom X x}
        (id≃ , _e⁻¹ ∘ 𝐂oslice-fibre≃ _ )
  ∙iff are-orthogonal↔are-orthogonal-fibre iff⁻¹
}
}

\subtree[stt-00D9]{
\taxon{Theorem}
\title{Covariance of representable families over left Segal types}

\p{We show that a type #{A} is [left Segal](stt-00DA) iff the family
#{\Hom(x,-)} is covariant for each #{x}.}

\proof{
We will show that every #{A_{x/} \to A} is a left fibration iff A is right
orthogonal to the map #{\Lambda^2_1 \to 1 \bjoin \Delta^1}.

\p{First we give an equivalence of arrows:}

\quiver{
\begin{tikzcd}
	{1\bjoin \Delta^1 \to_\bullet A} && {{A_{x/}}^{\Delta^1}} \\
	\\
	{\Lambda^2_1 \to_\bullet A} && {A^{\Delta^1} \times_A A_{x/}}
	\arrow["\sim", from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow["\sim"', from=3-1, to=3-3]
\end{tikzcd}
}

\p{The top equivalence is given by the [left cone-coslice adjunction](tot-6594), and
the bottom via the universal property of the horn.}

\p{Now we use \ref{stt-00DC} to finish the proof.}
}

\agda{
⟨Λ[2,1],∗A⟩≃⟨0,𝐂oslice⟩
  : ∀ {𝓤} (A : Type∗ 𝓤)
    → Arrow-equiv
        (precomp∗ A Λ[2,1]-incl-Δ¹◅∗)
        (orthogonal-point-gap-map (𝐂oslice-proj: A .Type∗.pt) i0)
⟨Λ[2,1],∗A⟩≃⟨0,𝐂oslice⟩ (mk-type∗ A x)
  = mk-arr-equiv
      LeftCone⊣𝐂oslice
      (  map∗≃fibre-ev _ x
      ∙e Σ-fst-≃ {B = λ p → p .pb.π₁ i0 ＝ x} Wedge-UP≃
      ∙e rearrange)
      (λ a
       → pullback-path→
           ( refl
           , refl
           , ap
               (_∙ refl)
               ( happly (ap (happly ∘ sym) funext-refl) tt
               ∙ sym
                 ( ap-∘ (a .map∗.hom) _ (glue tt)
                 ∙ ap (ap (a .map∗.hom)) (pushout-rec-apβ tt)))))
  where

  rearrange
    : (Σ[ a ∶ Pullback (ev i1) (ev i0) ] (a .pb.π₁ i0 ＝ x))
    ≃ Pullback {B = fibre (ev i0) x} (ev i1 ∘ fst) (ev i0)
  rearrange ._≃_.fwd a
    = ((a .fst .pb.π₁ , a .snd) , a .fst .pb.π₂ , a .fst .pb.filler)
  rearrange ._≃_.fwd-is-equiv .is-equiv.qinv .fst a
    = ((a .pb.π₁ .fst , a .pb.π₂ , a .pb.filler) , a .pb.π₁ .snd)
  rearrange ._≃_.fwd-is-equiv .is-equiv.qinv .snd = (~refl , ~refl)
  rearrange ._≃_.fwd-is-equiv .is-equiv.coherent = ~refl

coslice-proj-is-left-fibration↔is-left-Segal∗
  : ∀ {𝓤} {A : Type 𝓤} (x : A)
    → is-left-fibration (𝐂oslice-proj: x)
    ↔ is-left-segal∗ (mk-type∗ A x)
coslice-proj-is-left-fibration↔is-left-Segal∗ x
  = orthogonal-point-pullback-condition↔ _ i0
  ∙iff src↔tgt-is-equiv←Arrow-equiv (⟨Λ[2,1],∗A⟩≃⟨0,𝐂oslice⟩ (mk-type∗ _ x)) iff⁻¹

hom-fam-is-cov↔is-left-segal
  : ∀ {𝓤} {A : Type 𝓤}
    → (∀ x → is-covariant (λ a → Hom A x a))
    ↔ is-left-segal A
hom-fam-is-cov↔is-left-segal {𝓤} {A}
  =  postcomp-Π-↔ (λ
       x → hom-fam-is-cov↔𝐂oslice-is-left-fibration x
         ∙iff coslice-proj-is-left-fibration↔is-left-Segal∗ x)
  ∙iff pointed-orthogonality↔ Λ[2,1]-incl-Δ¹◅∗ A iff⁻¹
  ∙iff logical←equiv {𝓥 = 𝓤 ⊔ 𝓘} (unit-UP≃ e⁻¹)
}
}

\subtree[stt-00VK]{
\title{Covariance of representable families}
\date{2026-08-18}
\author{fredrikbakke}
\taxon{Theorem}

\p{The proof is due to [[robschellingerhout]].}

\proof{
We already know that the homs of Segal types are #{Δ¹}-discrete, and postcomposition
is a unital transport operation so by the [unital transport criterion](stt-00VJ) we
are done.
}

\agda{
hom-fam-cov
  : ∀ {𝓤} {A : Type 𝓤} → is-segal A → (z : A) → is-covariant (Hom A z)
hom-fam-cov {A = A} 𝐴 z
  = is-covariant←cov-unital-transport
      (λ _ → Hom-is-Δ¹-discrete←is-segal 𝐴)
      (postcomp-hom 𝐴 z , (λ _ → ∘=←Hom2 𝐴 ∘ refl▵~))

Coslice-proj-is-left-fibration
  : ∀ {𝓤} {A : Type 𝓤} → is-segal A
    → (z : A) → is-left-fibration (𝐂oslice-proj: z)
Coslice-proj-is-left-fibration 𝐴 z
  = hom-fam-is-cov↔𝐂oslice-is-left-fibration z .fst (hom-fam-cov 𝐴 z)
}
}

\subtree[stt-00VU]{
\title{Segal types are left Segal}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-08-19}

\agda{
is-left-segal←is-segal : ∀ {𝓤} {A : Type 𝓤} → is-segal A → is-left-segal A
is-left-segal←is-segal 𝐴
  = hom-fam-is-cov↔is-left-segal .fst (hom-fam-cov 𝐴)

is-segal↔is-left-segal : ∀ {𝓤} {A : Type 𝓤} → is-segal A ↔ is-left-segal A
is-segal↔is-left-segal = (is-left-segal←is-segal , is-segal←is-left-segal)
}
}

\subtree[stt-00GB]{
\title{Characterisation of the covariant action of #{\Hom}}
\date{2026-03-20}
\author{fredrikbakke}
\taxon{Theorem}

\p{
Given a [Segal](stt-00AI) type #{A}, the covariant action of
the family #{(a : A) \mapsto \Hom_A(a,{-})} is given by postcomposition.
}

\proof{
\p{
Given composable morphisms #{f : \Hom_A(a,b)} and #{g : \Hom_A(b,c)}, we must show
that covariant transport
#{\Hom_A(b,c) \to \Hom_A(a,b) \to \Hom_A(a,c)} of #{f} along #{g} is equal to the
composite #{g \circ f}. Let #{h} be the transported morphism. Covariance gives a
dependent morphism #{H : \Hom_{\Hom_A(a,{-})}^g(f, h)} over #{g}. Such a dependent
morphism defines a commuting square

\quiver{
\begin{tikzcd}
a && a \\
\\
b && c\nsp{.}
\arrow[from=1-1, to=1-3, equals]
\arrow[from=1-1, to=3-1, "f"']
\arrow[from=3-1, to=3-3, "g"]
\arrow[from=1-3, to=3-3, "h"]
\arrow[from=1-1, to=3-3, "H", phantom]
\end{tikzcd}
}

The diagonal of this square is a composite of #{f} and #{g}, so by
uniqueness of composites it is equal to the canonical composite #{g \circ f}.
Moreover, taking the upper right triangle we obtain a [left homotopy](stt-016T) of
#{h} and the diagonal so they are equal, and hence #{h = g \circ f} as desired.
}
}

\agda{
module _ {𝓤} {A : Type 𝓤} (𝐴 : is-segal A) where

  =∘←Hom-over
    : {a b c : A} (g : Hom A b c) (f : Hom A a b) {h : Hom A a c}
    → Hom-over g f h → h ＝ g ∘[ 𝐴 ] f
  =∘←Hom-over g f {h} α
    = h
        ＝⟨ ＝←~▵ 𝐴 (~▵←Hom-over g f α) ⟩
      diag-hom←Hom-over g f α
        ＝⟨ sym (∘=←Hom2 𝐴 (Hom2←Hom-over g f α)) ⟩
      g ∘[ 𝐴 ] f ∎

  tr-cov-hom-is-∘
    : {a b c : A}
      (g : Hom A b c) (f : Hom A a b)
    → tr-cov-hom (hom-fam-cov 𝐴 a) g f
    ＝ g ∘[ 𝐴 ] f
  tr-cov-hom-is-∘ {a} g f
    = =∘←Hom-over g f (tr-cov-over (hom-fam-cov 𝐴 a) g f)
}
}
