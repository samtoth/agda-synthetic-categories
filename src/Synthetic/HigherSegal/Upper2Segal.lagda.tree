\title{Upper 2-Segal types}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-21}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.HigherSegal.Upper2Segal
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
import Algebra.Lattice.Instances.Polynomial as Poly
open Poly hiding (Δ²)
private Δ² = Poly.Δ² I
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.CocartesianSquares
open import Core.CanonicalPushouts
open import Core.Orthogonal
open import Core.Cube
open import Core.ArrowRetracts
open import Core.FunctorialityPushouts
open import Core.OrthogonalClosure
open import Core.PushoutSums
open Core.Orthogonal.notation

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Horns Δ¹ I
open import Synthetic.Triangles Δ¹ I
open import Synthetic.Tetrahedra Δ¹ I
open import Synthetic.RightHomotopy Δ¹ I
open import Synthetic.Simplicial Δ¹ I
}
}

\subtree[bak-C5E1]{
\title{Upper 2-Segal types}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-21}

\p{
The upper 3-horn #{Λ^3_{1,3}} is the union of the faces #{013} and #{123} in #{Δ³},
glued along the edge #{13}. An \em{upper 2-Segal type} is a type that is local at
this horn inclusion.
}

\quiver{
\begin{tikzcd}[column sep=small, row sep=small]
  & 1 && 3 &&&& 1 && 3 \\
  &&&& {} & {} \\
  0 && 2 &&&& 0 && 2 \\
  & {\Lambda^3_{1,3}} &&&&&& {\Delta^3}
  \arrow[from=3-1, to=1-2]
  \arrow[from=1-2, to=1-4]
  \arrow[from=3-1, to=1-4]
  \arrow[from=3-3, to=1-4]
  \arrow[crossing over, from=1-2, to=3-3]
  \arrow[hook, from=2-5, to=2-6]
  \arrow[from=3-7, to=1-8]
  \arrow[from=1-8, to=1-10]
  \arrow[from=3-7, to=1-10]
  \arrow[from=3-7, to=3-9]
  \arrow[from=3-9, to=1-10]
  \arrow[crossing over, from=1-8, to=3-9]
\end{tikzcd}
}

\p{
Given coordinates #{(i \ge j \ge k) : Δ^3}, then #{Λ^3_{1,3}} is carved out by the
equations #{(i = 1) \lor (j = k)}.
}

\agda{
Λ[3,13]-cocone : Cocone (mk-span Δ¹ δ₀² δ₁²) Δ³
Λ[3,13]-cocone = mk-cocone δ₂³ δ₀³ (λ _ → Δ³-ext refl refl refl)

Λ[3,13] : Type 𝓘
Λ[3,13] = Pushout δ₀² δ₁²

Λ[3,13]-incl : Λ[3,13] → Δ³
Λ[3,13]-incl = cogap Λ[3,13]-cocone

is-upper-2-segal : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
is-upper-2-segal = orthogonal-type Λ[3,13]-incl

is-upper-2-inner-anodyne
  : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} → (X → Y) → Typeω
is-upper-2-inner-anodyne f = is-anodyne f Λ[3,13]-incl
}
}

\subtree[bak-37B9]{
\title{The projection of the walking right homotopy is upper 2-inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-21}

\p{
The argument adapts the upper unitality proof of Feller, Garner, Kock, Proulx, and
Weber \citet{Proposition 2.1}{FGKPW21}. We note that none of the lattice operations
or laws are needed for this argument, it applies with any bounded poset interval.
}

\subtree[bak-BBE4]{
\title{An upper 2-inner anodyne map}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-21}

\p{
Consider the following pair of squares.
}

\quiver{
\begin{tikzcd}
{\Delta^1} && {\Delta^2} && {\Delta^1} \\
\\
{\Delta^2} && {\Delta^3} && {\Delta^2}
\arrow["{\delta^2_1}", from=1-1, to=1-3]
\arrow["{\wedge}", from=1-3, to=1-5]
\arrow["{\delta^2_0}"', from=1-1, to=3-1]
\arrow["{\delta^3_0}" description, from=1-3, to=3-3]
\arrow["{\delta^2_0}", from=1-5, to=3-5]
\arrow["{\delta^3_2}"', from=3-1, to=3-3]
\arrow["{\sigma^3_1}"', from=3-3, to=3-5]
\end{tikzcd}
}

\p{
The cogap of the left square is the upper horn inclusion. Both horizontal composites
are identities, so the outer rectangle is a pushout, therefore, by
[anodyne cancellation for squares](bak-927F), the cogap map of the right square is
upper 2-inner anodyne. Let
#{k \colon \Delta^3 \amalg_{\Delta^2} \Delta^1 \to \Delta^2} be this right cogap map.
}


\agda{
δ₀³-σ₁³-span : Span 𝓘 𝓘 𝓘
δ₀³-σ₁³-span = mk-span Δ² δ₀³ Δ².t

δ₀³-σ₁³-cocone : Cocone δ₀³-σ₁³-span Δ²
δ₀³-σ₁³-cocone = mk-cocone σ₁³ δ₀² (λ _ → Δ²-refl)

δ₀³-σ₁³-cogap : Pushout₀ δ₀³-σ₁³-span → Δ²
δ₀³-σ₁³-cogap = cogap δ₀³-σ₁³-cocone

δ₀³-σ₁³-cogap-is-upper-2-inner-anodyne
  : is-upper-2-inner-anodyne δ₀³-σ₁³-cogap
δ₀³-σ₁³-cogap-is-upper-2-inner-anodyne h orth
  = left-orthogonal-cogap-cancel
      (Arrow-map←Cocone Λ[3,13]-cocone)
      (Arrow-map←Cocone δ₀³-σ₁³-cocone) h orth
      (equiv⊥
        (is-pushout←up-cocartesian _
          (untranspose-square-has-up-cocartesian _
            (cocartesian←equiv-map _ id-is-equiv
              (is-equiv←~ (λ _ → Δ²-refl) id-is-equiv))))
        (h))
}
}

\subtree[bak-C775]{
\title{The square defining the walking right homotopy projection is a retract}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-21}

\p{
The square defining the walking right homotopy projection is a retract of the
right-hand square in [the preceding lemma](bak-BBE4), as displayed by the next
diagram.
}

\quiver{
\begin{tikzcd}[column sep=small, row sep=small]
{\Delta^1} &&&& {\Delta^2} &&&& {\Delta^1} \\
&& {\b1} &&&& {\Delta^1} &&&& {\b1} \\
\\
{\Delta^2} &&&& {\Delta^3} &&&& {\Delta^2} \\
&& {\Delta^1} &&&& {\Delta^2} &&&& {\Delta^1}
\arrow[from=1-1, to=2-3]
\arrow["{\land}", from=1-5, to=2-7]
\arrow[from=1-9, to=2-11]
\arrow["{\delta^2_0}"' near end, from=1-1, to=4-1]
\arrow["{\delta^3_0}"' near end, from=1-5, to=4-5]
\arrow["{\delta^2_0}"' near end, from=1-9, to=4-9]
\arrow["1" near start, from=2-3, to=5-3]
\arrow["1" near start, from=2-11, to=5-11]
\arrow["{\lor}"', from=4-1, to=5-3]
\arrow["{\sigma^3_1}"' near start, from=4-5, to=5-7]
\arrow["{\lor}"', from=4-9, to=5-11]
\arrow["{\delta^2_2}", from=1-1, to=1-5]
\arrow["{\lor}", from=1-5, to=1-9]
\arrow["0" near start, crossing over, from=2-3, to=2-7]
\arrow[crossing over, from=2-7, to=2-11]
\arrow["{\delta^3_3}" very near start, from=4-1, to=4-5]
\arrow["{\sigma^3_2}" very near start, from=4-5, to=4-9]
\arrow["{\delta^2_2}"', from=5-3, to=5-7]
\arrow["{\lor}"', from=5-7, to=5-11]
\arrow["{\delta^2_0}" near start, crossing over, from=2-7, to=5-7]
\end{tikzcd}
}

\agda{
δ₀³-σ₁³-section-cube
  : Cube
      (Arrow-map←Cocone ~Δ-proj-cocone)
      (Arrow-map←Cocone δ₀³-σ₁³-cocone)
δ₀³-σ₁³-section-cube
  = mk-cube
      (mk-amap δ₂² δ₃³ (λ _ → Δ³-ext refl refl refl))
      (mk-amap (point i0) δ₂² (λ _ → Δ²-refl))
      (~refl , (λ _ → Δ²-refl) , (λ _ → Δ²-is-set _ _ _ _))

δ₀³-σ₁³-retraction-cube
  : Cube
      (Arrow-map←Cocone δ₀³-σ₁³-cocone)
      (Arrow-map←Cocone ~Δ-proj-cocone)
δ₀³-σ₁³-retraction-cube
  = mk-cube
      (mk-amap Δ².s σ₂³ (λ _ → Δ²-refl)) (mk-amap ! Δ².s ~refl)
      (~refl , ~refl , (λ _ → carrier-is-set _ _ _ _))
}

\p{
[Retracts of squares yield retracts of cogap maps](bak-6280) which then gives that
the walking right homotopy projection is a retract of arrows of #{k}.
}

\agda{
proj-~Δ-retract-δ₀³-σ₁³-cogap
  : Arrow-retract proj-~Δ δ₀³-σ₁³-cogap
proj-~Δ-retract-δ₀³-σ₁³-cogap
  = mk-Arrow-retract←incoherent
      (cogap-map-square-incoherent-ret←cube-incoherent-ret _ _
        δ₀³-σ₁³-section-cube δ₀³-σ₁³-retraction-cube
        ( ~refl , ~refl , ~refl
        , (λ _ → Δ²-is-set _ _ _ _) , (λ _ → refl)) ~refl)
      (λ _ → carrier-is-set _ _ _ _)
}
}

\p{
Finally, by closure under retracts, the walking right homotopy projection is upper
2-inner anodyne.
}

\agda{
proj-~Δ-is-upper-2-inner-anodyne
  : is-upper-2-inner-anodyne proj-~Δ
proj-~Δ-is-upper-2-inner-anodyne h orth
  = left-orthogonal←Arrow-retract proj-~Δ-retract-δ₀³-σ₁³-cogap h
      (δ₀³-σ₁³-cogap-is-upper-2-inner-anodyne h orth)
}
}

\subtree[bak-A04D]{
\title{Right homotopies characterise equality of morphisms in upper 2-Segal types}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-09-21}

\p{Right homotopies of morphisms characterise equality in upper 2-Segal types.}

\agda{
module _ {𝓤} {A : Type 𝓤} (𝐴 : is-upper-2-segal A) where

  proj-~Δ-local←is-upper-2-segal : orthogonal-type proj-~Δ A
  proj-~Δ-local←is-upper-2-segal
    = orthogonal-type←is-anodyne proj-~Δ-is-upper-2-inner-anodyne 𝐴

  tgt-~Δ-local←is-upper-2-segal : orthogonal-type tgt-~Δ A
  tgt-~Δ-local←is-upper-2-segal
    = 3-for-2' proj-~Δ-local←is-upper-2-segal id-is-equiv

  ▵~-is-torsorial←is-upper-2-segal
    : {a b : A} (f : Hom A a b) → is-torsorial (f ▵~_)
  ▵~-is-torsorial←is-upper-2-segal
    = ▵~-is-torsorial←tgt-local tgt-~Δ-local←is-upper-2-segal

  ▵~←＝-is-equiv←is-upper-2-segal
    : {a b : A} (f g : Hom A a b) → is-equiv (▵~←＝ {f = f} {g = g})
  ▵~←＝-is-equiv←is-upper-2-segal
    = ▵~←＝-is-equiv←tgt-local tgt-~Δ-local←is-upper-2-segal

  Hom-▵~-IdS←is-upper-2-segal
    : {a b : A} → Identity-system (Hom A a b) (𝓤 ⊔ 𝓘)
  Hom-▵~-IdS←is-upper-2-segal .Identity-system.IdS = _▵~_
  Hom-▵~-IdS←is-upper-2-segal .Identity-system.IdS←Id = ▵~←＝
  Hom-▵~-IdS←is-upper-2-segal .Identity-system.IdS←Id-is-equiv
    = ▵~←＝-is-equiv←is-upper-2-segal

  ＝≃▵~←is-upper-2-segal
    : {a b : A} (f g : Hom A a b) → (f ＝ g) ≃ (f ▵~ g)
  ＝≃▵~←is-upper-2-segal
    = ＝≃▵~←tgt-local tgt-~Δ-local←is-upper-2-segal
}
}

\subtree[bak-F0A7]{
\title{The triangulated square inclusion is upper 2-inner anodyne}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-25}

\p{
The [triangulated square inclusion](stt-00CC) is a retract of arrows of the
[pushout product](stt-00BS) of the upper horn inclusion
#{Λ^3_{1,3} \hookrightarrow \Delta^3} with the diagonal map
#{δ₁² \colon Δ¹ \hookrightarrow Δ²}
}

\quiver{
\begin{tikzcd}
\Delta^2 \amalg_{\Delta^1} \Delta^2
&& \Lambda^3_{1,3} \times \Delta^2 \amalg_{\Lambda^3_{1,3} \times \Delta^1} \Delta^3 \times \Delta^1
&& \Delta^2 \amalg_{\Delta^1} \Delta^2 \\
\\
\Delta^1 \times \Delta^1 && \Delta^3 \times \Delta^2 && \Delta^1 \times \Delta^1\nsp{.}
\arrow[from=1-1, to=1-3, dashed]
\arrow[from=1-3, to=1-5, dashed]
\arrow[from=3-1, to=3-3, "I", dashed]
\arrow[from=3-3, to=3-5, "R", dashed]
\arrow[from=1-1, to=3-1]
\arrow[from=1-3, to=3-3, "\iota\pushprod{\delta_1^2}" description]
\arrow[from=1-5, to=3-5]
\end{tikzcd}
}

\agda{
Λ[3,13]□δ₁² : Type 𝓘
Λ[3,13]□δ₁² = mk-arrow (Λ[3,13]-incl □ Δ²-diagonal) .Arrow.dom

Λ[3,13]□δ₁²←⧅-cocone
  : Cocone (mk-span Δ¹ Δ²-diagonal Δ²-diagonal) Λ[3,13]□δ₁²
Λ[3,13]□δ₁²←⧅-cocone
  = mk-cocone
      (λ ((i , j) ⦃ p ⦄) → ι₂ (ι₁ (δ₁² j) , (i , j) ⦃ p ⦄))
      (λ σ → ι₁ (δ₁³ σ , σ .Δ².t))
      (λ t → sym (glue (ι₁ (δ₁² t) , t)))

Λ[3,13]□δ₁²←⧅ : ⧅ → Λ[3,13]□δ₁²
Λ[3,13]□δ₁²←⧅ = cogap Λ[3,13]□δ₁²←⧅-cocone
}

\p{
We define the inclusion and retraction via
##{I(a,b)\defeq((a\ge a\ge a\wedge b),(b\ge a\wedge b)),}
and
##{R((i \ge j \ge k),(u \ge v))\defeq(j\vee v\vee (i\wedge u),k\vee u).}
}

\agda{
Δ³×Δ²←□² : Δ¹ × Δ¹ → Δ³ × Δ²
Δ³×Δ²←□² (a , b)
  = ( mk-tetrahedron a a (a ∧ b) ⦃ ≤-refl ⦄ ⦃ ∧-≤-eliml ≤-refl ⦄
    , (b , a ∧ b) ⦃ ∧-≤-elimr ≤-refl ⦄)

□²←Δ³×Δ² : Δ³ × Δ² → Δ¹ × Δ¹
□²←Δ³×Δ² (mk-tetrahedron i j k , (u , v)) = (j ∨ v ∨ (i ∧ u) , k ∨ u)
}

\p{
We immediately obtain #{R\circ I\sim \id} by idempotence and the absorption laws.
}

\agda{
□²←Δ³×Δ²-sec : □²←Δ³×Δ² ∘ Δ³×Δ²←□² ~ id
□²←Δ³×Δ²-sec (a , b) = ×-path→ (ap (a ∨_) ∨-idem ∙ ∨-∧-abs , ∧-∨-abs')
}

\p{
Now, we argue that the retract lifts to the top row. If #{a\le b} then #{I} lands in
the horn face #{j=k}, and if #{b\le a} then it lands in the diagonal #{u=v}. The
retraction lands in the triangulated square on all three faces of the pushout
product: if #{j=k} then the first coordinate of #{R} is less than or equal to its
second, and if #{i=1} or #{u=v} then the second coordinate is less than or equal to
its first.
}

\agda{
Λ[3,13]□δ₁²←⧅-coh
  : Δ³×Δ²←□² ∘ ⧅-incl
  ~ (Λ[3,13]-incl □ Δ²-diagonal) ∘ Λ[3,13]□δ₁²←⧅
Λ[3,13]□δ₁²←⧅-coh
  = ~←pushout-maps-into-set
      (×-is-set Δ³-is-set Δ²-is-set)
      ( λ ((i , j) ⦃ p ⦄) → ×-path→
        ( Δ³-ext refl refl (≤-min p) , Δ²-ext (refl , ≤-min p)))
      ( λ ((i , j) ⦃ p ⦄) → ×-path→
        ( Δ³-ext refl refl (∧-comm ∙ ≤-min p)
        , Δ²-ext (refl , ∧-comm ∙ ≤-min p)))

⧅-lift-Λ[3,13]×Δ²
  : (h : Λ[3,13]) (τ : Δ²)
  → fibre ⧅-incl (□²←Δ³×Δ² (Λ[3,13]-incl h , τ))
⧅-lift-Λ[3,13]×Δ² h τ
  = pushout-ind
      (λ h → fibre ⧅-incl (□²←Δ³×Δ² (Λ[3,13]-incl h , τ)))
      (mk-coconeᵈ
        ( λ σ
          → ( ι₁ ((Δ².t σ ∨ Δ².s τ , Δ².t σ ∨ Δ².t τ ∨ Δ².s σ ∧ Δ².s τ)
                  ⦃ ≤-∨ ⦃ ≤-refl ⦄ ⦃ ∨-UP (τ .Δ².mono , ∧-≤-elimr ≤-refl) ⦄ ⦄)
            , refl))
        ( λ σ
          → ( ι₂ ((Δ².s σ ∨ Δ².t τ ∨ i1 ∧ Δ².s τ , Δ².t σ ∨ Δ².s τ)
                  ⦃ ∨-UP
                    ( ∨-≤-introl (σ .Δ².mono)
                    , ∨-≤-intror (∨-≤-intror (≥←＝ 1-top'))) ⦄)
          , refl))
        (λ _ → is-prop-map←is-embedding ⧅-incl-is-embedding _ _ _))
      (h)

⧅-lift-Λ[3,13]□δ₁²
  : (p : Λ[3,13]□δ₁²)
  → fibre ⧅-incl (□²←Δ³×Δ² ((Λ[3,13]-incl □ Δ²-diagonal) p))
⧅-lift-Λ[3,13]□δ₁²
  = pushout-ind _
      (mk-coconeᵈ
        ( λ (σ , t)
          → ( ι₂ ((_ , _)
                  ⦃ ∨-UP (∨-≤-introl (σ .Δ³.u≤t) , ∨-≤-intror (∨-≤-introl ≤-refl)) ⦄)
            , refl))
        (λ (h , τ) → ⧅-lift-Λ[3,13]×Δ² h τ)
        (λ _ → is-prop-map←is-embedding ⧅-incl-is-embedding _ _ _))

⧅-incl-retract-Λ[3,13]-incl□δ₁² : Arrow-retract ⧅-incl (Λ[3,13]-incl □ Δ²-diagonal)
⧅-incl-retract-Λ[3,13]-incl□δ₁²
  = mk-arr-retract
      ( Λ[3,13]□δ₁²←⧅
      , fst ∘ ⧅-lift-Λ[3,13]□δ₁²
      , ( λ x
          → unap ⧅-incl-is-embedding
            ( ⧅-lift-Λ[3,13]□δ₁² (Λ[3,13]□δ₁²←⧅ x) .snd
            ∙ ap □²←Δ³×Δ² (sym (Λ[3,13]□δ₁²←⧅-coh x))
            ∙ □²←Δ³×Δ²-sec (⧅-incl x))))
      (Δ³×Δ²←□² , □²←Δ³×Δ² , □²←Δ³×Δ²-sec)
      (Λ[3,13]□δ₁²←⧅-coh)
      ((snd ∘ ⧅-lift-Λ[3,13]□δ₁²) h⁻¹)
      (λ _ → ×-is-set carrier-is-set carrier-is-set _ _ _ _)
}

\p{
Consequently, the [triangulated square inclusion](stt-00CC) is upper 2-inner anodyne,
and, in particular, every [upper 2-Segal type](bak-C5E1) is [triangulated](stt-00LD).
}

\agda{
⧅-incl-is-upper-2-inner-anodyne : is-upper-2-inner-anodyne ⧅-incl
⧅-incl-is-upper-2-inner-anodyne h orth
  = left-orthogonal←Arrow-retract ⧅-incl-retract-Λ[3,13]-incl□δ₁² h
      (left-orthogonal-pushout-product Λ[3,13]-incl h orth Δ²-diagonal)

is-triangulated←is-upper-2-segal
  : ∀ {𝓤} {A : Type 𝓤} → is-upper-2-segal A → is-triangulated A
is-triangulated←is-upper-2-segal A-is-upper-2-segal _
  = orthogonal-type←is-anodyne
      ⧅-incl-is-upper-2-inner-anodyne A-is-upper-2-segal
}
}
