\title{The dependent amazing right adjoint asscociated to a tiny object}
\taxon{Module}
\author{samueltoth}
\date{2026-09-29}
\import{stt-macros}

\agda{
open import Foundations.Prelude
open import Synthetic.Tiny

module Synthetic.Tiny.AmazingProperties
  {@♭ 𝓘} {@♭ I : Type 𝓘}
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ ε√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (I → √ A) → A)
  (@♭ √-is-tiny-str : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure I A (√ A) ε√)
  where

open import Axioms.UF

open Tiny I √ ε√ √-is-tiny-str
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.LiftingSquares
open import Modalities.Cohesion.Continuity
open import Modalities.Instances.Truncation

open import Ergonomics.Extensionality

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.CartesianSquares
open import Core.PiSection
open import Core.GlobalClassesMaps
open import Core.UniversalFibrations
open import Core.Small
open import Core.Postwhisker
}
}

\subtree[tot-ABCD]{
\title{The action of the amazing right adjoint on the universal embedding is an embedding}
\taxon{Lemma}
\date{2026-09-29}
\author{samueltoth}

\p{This proof is due to [[danielgratzer]].}

\agda{
private
  @♭ Prop𝟙 : ∀ {𝓤} → Prop-U 𝓤
  Prop𝟙 = (𝟙ᴸ , trunc!)

  Prop𝟙-sat→ : ∀ {𝓤} {P : Prop-U 𝓤} → (P ＝ Prop𝟙) → P .fst
  Prop𝟙-sat→ refl = ttᴸ

  Prop𝟙-sat : ∀ {𝓤} {P : Prop-U 𝓤} → (P ＝ Prop𝟙) ≃ P .fst
  Prop𝟙-sat {𝓤} {P}
    = {!!}
    ∙e equiv←logical {A = (P .fst) ≃ 𝟙ᴸ: 𝓤}
         (is-prop←is-truncated {!!})
         (is-prop←is-truncated (P .snd))
         ( (λ e → _≃_.bwd e ttᴸ)
         , (λ p
              → equiv←logical
                 (is-prop←is-truncated (P .snd))
                 (is-prop←is-truncated trunc!)
                 (!ᴸ , const p)))

global-√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → ⟨♭| A ⟩ → ⟨♭| √ A ⟩
global-√ = ♭-map (ev tt) ∘ transpose ∘ ♭-map const

global-√-is-equiv : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-equiv (global-√ {A = A})
global-√-is-equiv
  = is-equiv-∘
      (is-♭-equiv←is-equiv (unit-ev-is-equiv))
      (is-equiv-∘
        (is-equiv⁻¹ √-is-tiny-str)
        (is-♭-equiv←is-equiv (sing-const-is-equiv single!)))

√-point : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → @♭ A → 𝟙 → √ A
√-point a = ε♭ (transpose (mod♭ (const a)))

√true : ∀ {@♭ 𝓤} → 𝟙 → √ (Prop-U 𝓤)
√true = √-point Prop𝟙

module _ {@♭ 𝓤} where

  fibre-√true←fibre-true
    : ∀ {@♭ 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
      → ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true tt)
      → ((x : I → Γ) → ϕ x ＝ Prop𝟙)
  fibre-√true←fibre-true ϕ
    = happly
    ∘ tr₂ _＝_
        ( sym (ε♭-natural {f = untranspose} (transpose (mod♭ ϕ)))
        ∙ ap ε♭ (is-tiny.ε (mod♭ ϕ)))
        ( sym (ε♭-natural {f = untranspose} (transpose (mod♭ (const Prop𝟙))))
        ∙ ap ε♭ (is-tiny.ε (mod♭ (const Prop𝟙))))
    ∘ ap untranspose
    ∘ (_∙ sym (ε♭-transpose-∘ (const Prop𝟙) !))
    ∘ funext→

  opaque
    fibre-√true-mapᵈ
      : ∀ {@♭ 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
        → ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true tt) ⟩
        ≃ ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
    fibre-√true-mapᵈ {Γ = Γ} ϕ
      = ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true tt) ⟩
      ≃⟨ ♭≃ (funext≃ e⁻¹) ⟩
        ⟨♭| (ε♭ (transpose (mod♭ ϕ)) ＝ (√true ∘ !)) ⟩
      ≃⟨ ♭≃ (tr≃ (ε♭ (transpose (mod♭ ϕ)) ＝_) (sym (ε♭-transpose-∘ (const Prop𝟙) !))) ⟩
        ⟨♭| (ε♭ (transpose (mod♭ ϕ))) ＝ ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))) ⟩
      ≃⟨ mapply♭≃ ⟩
        mod♭ (ε♭ (transpose (mod♭ ϕ))) ＝ mod♭ (ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))))
      ≃⟨ ＝-preconcat-≃ (mod♭ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))))
      ∙e ＝-postconcat-≃ (sym (mod♭ε♭ (transpose (mod♭ ϕ)))) ⟩
        transpose (mod♭ ϕ) ＝ transpose (mod♭ (point Prop𝟙 ∘ !))
      ≃⟨ mk≃ (ap transpose) (is-embedding←is-equiv (is-equiv⁻¹ √-is-tiny-str)) e⁻¹ ⟩
        mod♭ ϕ ＝ mod♭ (point Prop𝟙 ∘ !)
      ≃⟨ mapply♭≃ e⁻¹ ⟩
        ⟨♭| ϕ ＝ (point Prop𝟙 ∘ !) ⟩
      ≃⟨ ♭≃ (funext≃ {f = ϕ} {const Prop𝟙} ) ⟩
        ⟨♭| ((f : I → Γ) → ϕ f ＝ Prop𝟙) ⟩
      ≃⟨ ♭≃ (postcomp-Π-≃ λ f → Prop𝟙-sat) ⟩
        ⟨♭| ((f : I → Γ) → ϕ f .fst) ⟩
      ≃∎

    fibre-√true-lemmaᵈ
      : ∀ {@♭ 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
        → ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true tt) ⟩
        ≃ ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
    fibre-√true-lemmaᵈ {Γ = Γ} ϕ
      = ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true tt) ⟩
      ≃⟨ ♭≃ (funext≃ e⁻¹) ⟩
        ⟨♭| (ε♭ (transpose (mod♭ ϕ)) ＝ (√true ∘ !)) ⟩
      ≃⟨ ♭≃ (tr≃ (ε♭ (transpose (mod♭ ϕ)) ＝_) (sym (ε♭-transpose-∘ (const Prop𝟙) !))) ⟩
        ⟨♭| (ε♭ (transpose (mod♭ ϕ))) ＝ ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))) ⟩
      ≃⟨ mapply♭≃ ⟩
        mod♭ (ε♭ (transpose (mod♭ ϕ))) ＝ mod♭ (ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))))
      ≃⟨ ＝-preconcat-≃ (mod♭ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))))
      ∙e ＝-postconcat-≃ (sym (mod♭ε♭ (transpose (mod♭ ϕ)))) ⟩
        transpose (mod♭ ϕ) ＝ transpose (mod♭ (point Prop𝟙 ∘ !))
      ≃⟨ mk≃ (ap transpose) (is-embedding←is-equiv (is-equiv⁻¹ √-is-tiny-str)) e⁻¹ ⟩
        mod♭ ϕ ＝ mod♭ (point Prop𝟙 ∘ !)
      ≃⟨ mapply♭≃ e⁻¹ ⟩
        ⟨♭| ϕ ＝ (point Prop𝟙 ∘ !) ⟩
      ≃⟨ ♭≃ (funext≃ {f = ϕ} {const Prop𝟙} ) ⟩
        ⟨♭| ((f : I → Γ) → ϕ f ＝ Prop𝟙) ⟩
      ≃⟨ ♭≃ (postcomp-Π-≃ λ f → Prop𝟙-sat) ⟩
        ⟨♭| ((f : I → Γ) → ϕ f .fst) ⟩
      ≃∎

    fibre-√true-lemma
      : ∀ {@♭ 𝓥} {@♭ Γ : Type 𝓥} (@♭ x : Prop-U 𝓤)
        → ⟨♭| (Γ → √-point x tt ＝ √true tt) ⟩
        ≃ ⟨♭| ((I → Γ) → x .fst) ⟩
    fibre-√true-lemma {Γ = Γ} x
      = ⟨♭| (Γ → √-point x tt ＝ √true tt) ⟩
      ≃⟨ ♭≃ (postcomp-Π-≃ (λ c → tr≃ (_＝ √true tt) (happly (sym (ε♭-transpose-∘ (const x) !)) c) )) ⟩
        ⟨♭| ((x' : Γ) → ε♭ (transpose (mod♭ (λ _ → x))) x' ＝ √true tt) ⟩
      ≃⟨ fibre-√true-lemmaᵈ (const x) ⟩
        ⟨♭| ((I → Γ) → x .fst) ⟩
      ≃∎

    √true-diagonal-is-equiv
      : is-equiv (diagonal (√true {𝓤}))
    √true-diagonal-is-equiv
      = types-separate (diagonal √true)
          λ {_} {Γ}
          → is-equiv←single-to-prop
              (♭-is-single single!)
              (is-prop←equiv
                (fibre-√true-lemma Prop𝟙 e⁻¹ ∙e ♭≃ (postcomp-≃ ((Σ-𝟙 ∙e Σ-𝟙) e⁻¹) {Γ}))
                (♭-is-prop (is-prop←is-truncated trunc!)))
              _

  √true-is-embedding : is-embedding √true
  √true-is-embedding = is-embedding←diagonal-is-equiv _ √true-diagonal-is-equiv

  √true-lift
    : ∀ {@♭ 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
      → LiftMap √true (ε♭ (transpose (mod♭ ϕ)))
      → LiftMap (point Prop𝟙) ϕ
  √true-lift ϕ (s , p)
    = (! , funext→ (sym ∘ fibre-√true←fibre-true ϕ (happly (sym p))))

is-amazingly
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
    → (@♭ P : (I → A) → Prop-U 𝓥)
    → A → Type (lsuc 𝓥)
is-amazingly P x = fibre √true (ε♭ (transpose (mod♭ P)) x)

is-amazingly-is-prop
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
      (@♭ P : (I → A) → Prop-U 𝓥)
    → ∀ (x : A) → is-prop (is-amazingly P x)
is-amazingly-is-prop P x = is-prop-map←is-embedding √true-is-embedding _

opaque
  is-amazingly-UP→
    : ∀ {@♭ 𝓤 𝓥}  {@♭ A : Type 𝓤}
        (@♭ ϕ : (I → A) → Prop-U 𝓥)
      → ((∀ (x : A) → is-amazingly ϕ x))
      → ((∀ (f : I → A) → ϕ f .fst))
  is-amazingly-UP→ ϕ f = Prop𝟙-sat→ ∘ fibre-√true←fibre-true ϕ (sym ∘ snd ∘ f)

  is-amazingly-UP≃
    : ∀ {@♭ 𝓤 𝓥}  {@♭ A : Type 𝓤}
        (@♭ ϕ : (I → A) → Prop-U 𝓥)
      → ⟨♭| (∀ (x : A) → is-amazingly ϕ x) ⟩
      ≃ ⟨♭| (∀ (f : I → A) → ϕ f .fst) ⟩
  is-amazingly-UP≃ am = ♭≃ (postcomp-Π-≃ (λ a → Σ-𝟙 ∙e sym≃)) ∙e fibre-√true-lemmaᵈ am

  is-amazingly-UP
    : ∀ {@♭ 𝓤 𝓥}  {@♭ A : Type 𝓤}
        (@♭ ϕ : (I → A) → Prop-U 𝓥)
      → is-♭-equiv (is-amazingly-UP→ ϕ)
  is-amazingly-UP ϕ
    = is-equiv←~
        (λ _ → ♭-is-prop (Π-is-prop (λ x → is-prop←is-truncated (ϕ x .snd))) _ _)
        (is-amazingly-UP≃ ϕ ._≃_.fwd-is-equiv)
}
}

\agda{
module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Prop-U 𝓥)
  where

  amazing-subtype :  Type (𝓤 ⊔ lsuc 𝓥)
  amazing-subtype = Pullback (ε♭ (transpose (mod♭ ϕ))) √true

  amazing-subtype-incl : amazing-subtype → A
  amazing-subtype-incl = base-change-arrow (ε♭ (transpose (mod♭ ϕ))) √true

  amazing-subtype-base-change : Arrow-map amazing-subtype-incl √true
  amazing-subtype-base-change = base-change-arrow-map (ε♭ (transpose (mod♭ ϕ))) √true

  amazing-subtype-incl-is-embedding
    : is-embedding amazing-subtype-incl
  amazing-subtype-incl-is-embedding
    = is-embedding←pullback-of-embedding
        (base-change-arrow-map (ε♭ (transpose (mod♭ ϕ))) √true)
        (base-change-arrow-map-is-cartesian (ε♭ (transpose (mod♭ ϕ))) √true)
        √true-is-embedding

  is-amazingly←amazing-subtype
    : (x : amazing-subtype) → is-amazingly ϕ (amazing-subtype-incl x)
  is-amazingly←amazing-subtype (a , tt , am) = (tt , sym am)

  is-amazing←amazing-subtype
    : (f : I → amazing-subtype)
    → (∀ i → is-amazingly ϕ (amazing-subtype-incl (f i)))
  is-amazing←amazing-subtype f i = is-amazingly←amazing-subtype (f i)

  is-amazing-natural→
    : ∀ {𝓤} {@♭ 𝓥} {Γ : Type 𝓤} {@♭ X : Type 𝓥} (σ : Γ → X) (@♭ f : X → A)
      → ∀ x → is-amazingly ϕ (f (σ x)) → is-amazingly (ϕ ∘ postcomp I f) (σ x)
  is-amazing-natural→ σ f x
    = total-map (λ a → _∙ sym (happly (ε♭-transpose-∘ ϕ f) (σ x)))

  amazing-is-amazing
    : ∀ (σ : I → amazing-subtype) → fst (ϕ (amazing-subtype-incl ∘ σ))
  amazing-is-amazing
    = is-amazingly-UP→ (ϕ ∘ postcomp I amazing-subtype-incl)
        (λ x
          → is-amazing-natural→
              (point x)
              amazing-subtype-incl
              tt
              (is-amazingly←amazing-subtype x))


  amazing-subtype-square
    : ∀ {𝓧} {Γ : Type 𝓧}
      → Arrow-map
          (postcomp Γ amazing-subtype-incl)
          (postcomp (I → Γ) (fst: (fst ∘ ϕ)))
  amazing-subtype-square {Γ = Γ} .Arrow-Π.top f σ
    = (amazing-subtype-incl ∘ f ∘ σ , amazing-is-amazing (f ∘ σ))
  amazing-subtype-square {Γ = Γ} .Arrow-Π.bot = postcomp I
  amazing-subtype-square {Γ = Γ} .Arrow-Π.comm = ~refl

}

\subtree[stt-00KE]{
\title{Amazing properties}

\p{We give a partial formalisation of an alternative construction for amazing
properties. Instead of using the small map classifier, we may use the small
embedding classifier, so that we directly get a function
#{\rm{is-amazingly} \colon \modflat{A^I \to \Prop} \to A \to \Prop}.}

\remark{This formalisation is incomplete for similar reasons to the previous
construction, in order to make use of the embedding classifier, we need to
show the map #{1 \to \Prop_I} that picks out #{\top}, is an embedding,
which requires showing that (this time the non-dependent) tiny type former
preserves sets. This boils down to characterising the identity type in
amazing right adjoints.}

\agda{

module AmazinglyFibrant
  {@♭ α : Level → Level → Level}
  (@♭ is-fib : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (α 𝓤 𝓥))
  (@♭ is-fib-is-prop : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → is-prop (is-fib B))
  (let
     @♭ is-fib-Prop : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Prop-U (α 𝓤 𝓥)
     is-fib-Prop B = (is-fib B , is-truncated←is-prop (is-fib-is-prop B)))
  (@♭ rel-fib : is-relative-fam I is-fib)
  where

  is-afib : ∀ {@♭ 𝓤} → Type 𝓤 → Type (lsuc (α 𝓘 𝓤))
  is-afib = is-amazingly is-fib-Prop

  is-afib-is-prop
    : ∀ {@♭ 𝓤} {A : Type 𝓤} → is-prop (is-afib A)
  is-afib-is-prop = is-amazingly-is-prop is-fib-Prop _

  -- record UFib (@♭ 𝓤) : Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤)) where
  --   constructor mk-ufib
  --   field
  --     Carrier : Type 𝓤
  --     Carrier-is-afib : is-afib Carrier

  UFib : ∀ (@♭ 𝓤) → Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤))
  UFib 𝓤 = amazing-subtype (is-fib-Prop {𝓥 = 𝓤})

  UFib-π : ∀ {@♭ 𝓤} → UFib 𝓤 → Type 𝓤
  UFib-π {𝓤} = amazing-subtype-incl is-fib-Prop

  UFib-π-is-fib : ∀ {@♭ 𝓤} → is-fib (UFib-π {𝓤})
  UFib-π-is-fib = rel-fib _ .snd (amazing-is-amazing is-fib-Prop)

  UFib-is-fib
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (P : A → UFib 𝓥)
      → is-fib (UFib-π ∘ P)
  UFib-is-fib P
    = is-base-change-stable-fam←is-relative
        I is-fib rel-fib
        P UFib-π
        UFib-π-is-fib

  UFib-transport : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} → (A → UFib 𝓥) → Σ (A → Type 𝓥) is-fib
  UFib-transport f = (UFib-π ∘ f , UFib-is-fib f)

  UFib-path→
    : ∀ {@♭ 𝓤} (A B : UFib 𝓤)
      → UFib-π A ≃ UFib-π B
      → A ＝ B
  UFib-path→ A B e = unap (amazing-subtype-incl-is-embedding is-fib-Prop) (ua e)

  opaque
    UP-UFib
      : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
        → is-♭-equiv (UFib-transport {𝓤} {𝓥} {A})
    UP-UFib = is-equiv←qinv
      ( ♭-ind (λ f → {!!})
      , ♭-ind (λ f
          → mapply♭ (mod♭ (ext! {!!})))
      , ♭-ind (λ f
          → mapply♭ (mod♭ (ext! {!!}))))
  -- opaque
  --   UFib-path←-coe≃-ap
  --     : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
  --       → UFib-path← A B (coe≃ (ap UFib.Carrier p)) ＝ p
  --   UFib-path←-coe≃-ap p =
  --     ap (unap Carrier-is-emb) ua-coe≃ ∙ is-equiv.η Carrier-is-emb p

  --   UFib-path←-β
  --     : ∀ {@♭ 𝓤} (A B : UFib 𝓤) (e : UFib.Carrier A ≃ UFib.Carrier B)
  --       → coe≃ (ap UFib.Carrier (UFib-path← A B e)) ＝ e
  --   UFib-path←-β A B e =  ap coe≃ (is-equiv.ε Carrier-is-emb (ua e)) ∙ coe≃-ua

  instance
    UFib-IdS : ∀ {@♭ 𝓤} → Identity-system (UFib 𝓤) 𝓤
    UFib-IdS {𝓤}
      = IdS←Embedding {f = UFib-π}
          (is-prop-map←is-embedding (amazing-subtype-incl-is-embedding is-fib-Prop))
          (IdS-ua {𝓤})

  -- UFib-tr
  --   : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
  --     → ext! (tr≃ UFib.Carrier p) ＝ p
  -- UFib-tr refl = Id←IdS←Id refl

  -- UP-UFib
  --   : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  --     → is-♭-equiv (UFib-transport {𝓤} {𝓥} {A})
  -- UP-UFib = is-equiv←qinv
  --   ( ♭-ind (λ f
  --       → mod♭ λ a → mk-ufib (fst f a) (ε♭ (liftFib .fst (mod♭ (snd f))) a))
  --   , ♭-ind (λ f
  --       → mapply♭ (mod♭ (ext! (λ a → id≃))))
  --   , ♭-ind (λ f
  --       → mapply♭ (mod♭ (ext! ((λ _ → id≃) , is-fib-is-prop (f .fst) _ _)))))

  -- UP-UFib≃
  --   : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  --     → ⟨♭| (A → UFib 𝓥) ⟩ ≃ ⟨♭| Σ (A → Type 𝓥) is-fib ⟩
  -- UP-UFib≃ {𝓤} {𝓥} {A}
  --     = mk≃ (♭-map (UFib-transport {𝓤} {𝓥} {A})) UP-UFib

  -- UFib-π-is-fib : ∀ {@♭ 𝓤} → is-fib (UFib.Carrier {𝓤})
  -- UFib-π-is-fib = rel-fib _ .snd
  --   (ε♭ (relim (mod♭ (λ a → √ᵈ-naturality→ _ UFib.Carrier a (a .UFib.Carrier-is-afib)))))

  -- UFib-is-fib
