\date{2026-10-28}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\title{Functoriality of the pullback power}

\agda{
module Core.PullbackPowersFunctoriality where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowMorphisms
open import Core.CartesianSquares
open import Core.ArrowEquiv
open import Core.Cube
open import Core.Postwhisker
open import Core.LiftingSquares
open import Core.PullbackPowers
open import Core.PullbackPowersFamilies
}
}

\subtree[stt-00LT]{
\title{Functorial action of the pullback power}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-04-05}

\agda{
pullback-power₁-right
  : ∀ {𝓤 𝓥 𝓐 𝓑 𝓒 𝓓} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
      {A : Type 𝓐} {B : Type 𝓑} {C : Type 𝓒} {D : Type 𝓓}
      {g : A → B} {h : C → D}
    → (F : Arrow-map g h)
    → Arrow-map (pullback-power f g) (pullback-power f h)
pullback-power₁-right f F .Arrow-map.top
  = Arrow-map.top F ∘_
pullback-power₁-right f F .Arrow-map.bot
  = paste-squares F
pullback-power₁-right f F .Arrow-map.comm l
  = Arrow-map-path→ (~refl , Arrow-map.comm F ∘ l , ~refl)
}
}

\subtree[stt-010N]{
\taxon{Construction}
\title{Functoriality of exponential squares}
\date{2025-11-26}
\author{samueltoth}
\contributor{fredrikbakke}

\p{
Morphisms of arrows induce cubes between exponential squares. If the
morphism is an equivalence of arrows the induced cube is an equivalence of squares.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜 𝓝 𝓛}
  {A : Type 𝓤} {B : Type 𝓥}
  {X : Type 𝓦} {Y : Type 𝓜}
  {C : Type 𝓝} {D : Type 𝓛}
  where

  power-hom-cube←right-arrow-map
    : (f : A → B)
      (g : X → Y)
      (g' : C → D)
      (F : Arrow-map g g')
    → Cube (power-hom f g) (power-hom f g')
  power-hom-cube←right-arrow-map f g g' F .Cube.left = postcomp-square F _
  power-hom-cube←right-arrow-map f g g' F .Cube.right = postcomp-square F _
  power-hom-cube←right-arrow-map f g g' F .Cube.comm .fst = ~refl
  power-hom-cube←right-arrow-map f g g' F .Cube.comm .snd .fst = ~refl
  power-hom-cube←right-arrow-map f g g' F .Cube.comm .snd .snd a
      = ∙-reflr _ ∙ ∙-reflr _ ∙ sym (commutes-prewhisker-funext _)

  power-hom-cube←right-arrow-equiv
    : (f : A → B)
      {g : X → Y}
      {g' : C → D}
    → Arrow-equiv g g'
    → Cube-equiv (power-hom f g) (power-hom f g')
  power-hom-cube←right-arrow-equiv f (F , Fe)
    = ( power-hom-cube←right-arrow-map f _ _ F
      , postcomp-square-is-equiv F Fe , postcomp-square-is-equiv F Fe)

  power-hom-cube←left-arrow-map
    : (f : A → B)
      (f' : X → Y)
      (F : Arrow-map f f')
      (g : C → D)
    → Cube
        (transpose-square (power-hom f' g))
        (transpose-square (power-hom f g))
  power-hom-cube←left-arrow-map f f' F g .Cube.left = precomp-square F _
  power-hom-cube←left-arrow-map f f' F g .Cube.right = precomp-square F _
  power-hom-cube←left-arrow-map f f' F g .Cube.comm .fst = ~refl
  power-hom-cube←left-arrow-map f f' F g .Cube.comm .snd .fst = ~refl
  power-hom-cube←left-arrow-map f f' F g .Cube.comm .snd .snd k
    = ∙-reflr _ ∙ ∙-reflr _
    ∙ sym (commutes-postwhisker-funext {h = g} _)
    ∙ ap funext→ (funext→ (◃h∘ g k _ h⁻¹))

  power-hom-cube←left-arrow-equiv
    : {f : A → B} {f' : X → Y}
    → Arrow-equiv f f'
    → (g : C → D)
    → Cube-equiv
        (transpose-square (power-hom f' g))
        (transpose-square (power-hom f g))
  power-hom-cube←left-arrow-equiv (F , Fe) g
    = ( power-hom-cube←left-arrow-map _ _ F g
      , precomp-square-is-equiv F Fe , precomp-square-is-equiv F Fe)
}
}
