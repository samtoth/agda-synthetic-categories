\title{Relative subtypes}
\taxon{Module}
\author{samueltoth}
\date{2026-09-29}
\import{stt-macros}

\subtree[tot-2390]{
\taxon{Idea}

\p{In type theory, given some type #{A} and a predicate #{\phi \colon A \to \Prop},
we may form a subtype of #{A}. The universal property of subtypes says that a map
#{f \colon X \to A} factors through the subtype iff for each #{x : X}, #{f(x) \in \phi}.
If some type #{I} is thought of as a shape, then we may view maps #{A^I} as
#{I}-shaped figures in #{A}. Commonly, we don't want to take restrict a type only
by its \em{elements}, but also by its figures, determined by a predicate
#{\phi \colon A^I \to \Prop}. This is particularly useful when you are using type
theory as an internal language for certain (pre)sheaf models, and
#{I} is some representable object. In the context of synthetic category theory,
we may take #{I} to be the walking morphism, then a subtype relative to #{I} allows
us to take a subtypes which restrict the #{I}-figures in #{A} (which are now just
the morphisms), giving rise to non-full subcategories.
The property of [tininess](Synthetic.Tiny) of #{I} is precisely what allows us to construct
these [relative subtypes](stt-00KE), and their [universal property](tot-0239) gives a
precise formulation of how they restrict the #{I}-figures. In this library we use
relative subtypes to construct the universes of so called
[\em{amazingly fibrant types}](tot-0PVM), giving us classifiers for classes of maps
which are not fibrewise, but can be tested on every base-change to #{\Delta^1}. Examples
include the [left fibration classifier](Synthetic.Categories.Spaces) and the
[Kan fibration classifier](Synthetic.Categories.KanFibrationClassifier).}
}

\agda{
open import Foundations.Prelude
open import Synthetic.Tiny

module Synthetic.Tiny.RelativeSubtypes
  {@♭ 𝓘} {@♭ I : Type 𝓘}
  (@♭ √ : ∀ {@♭ 𝓤} → @♭ Type 𝓤 → Type 𝓤)
  (@♭ ε√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → (I → √ A) → A)
  (@♭ √-is-tiny-str : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-tiny-structure I A (√ A) ε√)
  (open Tiny I √ ε√ √-is-tiny-str)
  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.CartesianSquares
open import Core.GlobalClassesMaps

open import Ergonomics.Extensionality

open import Modalities.Instances.Truncation

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.Continuity
open import Modalities.Cohesion.LiftingSquares
}
}

\subtree[tot-DKSN]{
\title{The universal tiny embedding}
\taxon{Construction}
\date{2026-10-07}
\author{samueltoth}

\p{There is a map #{\top_I \colon \b1 \to \Prop_I} defined as the transpose of the
constant map which picks out the proposition #{\unit}. This map is an embedding and
any crisp proposition #{\phi \colon-flat A^I \to \Prop} can be obtained as a
transposition of a base change of the universal tiny embedding.}

\agda{
√⊤ : ∀ (@♭ 𝓤) → 𝟙 → √(Prop 𝓤)
√⊤ 𝓤 = ε♭ (transpose (mod♭ (const Prop-𝟙)))
}

\subtree[tot-0DAM]{
\title{The fibre of #{⊤_I}}
\taxon{Lemma}

\p{Given some family of propositions #{\phi \colon A^I \to \Prop}, if for all
#{x : A}, the transpose of #{\phi} at #{x} is in the fibre of #{\top_I}, then
#{\phi} has a section. This gives a map #{\fibre{\top_I}{\phi(x)} \to \phi(x)},
which turns out to be a #{\flat}-equivalence.}

\agda{
fibre-√⊤→
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓥} (@♭ ϕ : (I → A) → Prop 𝓤)
    → ((x : A) → fibre (√⊤ 𝓤) (ε♭ (transpose (mod♭ ϕ)) x))
    → (Π (I → A) (fst ∘ ϕ))
fibre-√⊤→ {A = A} ϕ
  = postcomp-Π {I = (I → A)} (λ g p → tr fst p ttᴸ)
  ∘ happly {f = const Prop-𝟙}
  ∘ tr₂ _＝_
      ( sym (ε♭-natural (transpose (mod♭ (const Prop-𝟙)))
      ∙ ap untranspose (funext→ (λ a → transpose-const-naturality {x = a})))
      ∙ ap ε♭ (is-tiny.ε (mod♭ (const Prop-𝟙)))  )
      ( sym (ε♭-natural {f = untranspose} (transpose (mod♭ ϕ)))
      ∙ ap ε♭ (is-tiny.ε (mod♭ ϕ)))
  ∘ ap untranspose
  ∘ funext→
  ∘ postcomp-Π λ x → Σ-𝟙 ._≃_.fwd

fibre-√⊤≃
  : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop 𝓤)
    → ⟨♭| ((x : Γ) → fibre (√⊤ 𝓤) (ε♭ (transpose (mod♭ ϕ)) x)) ⟩
    ≃ ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
fibre-√⊤≃ {𝓤} {Γ = Γ} ϕ
  = ⟨♭| (((x : Γ) → fibre (√⊤ 𝓤) (ε♭ (transpose (mod♭ ϕ)) x))) ⟩
  ≃⟨ ♭≃ (postcomp-Π-≃ (λ x → Σ-𝟙)) ⟩
    ⟨♭| ((x : Γ) → √⊤ _ tt ＝ ε♭ (transpose (mod♭ ϕ)) x) ⟩
  ≃⟨ ♭≃ (postcomp-Π-≃
      (λ c → tr≃ (_＝ (ε♭ (transpose (mod♭ ϕ)) c))
        (transpose-const-naturality ∙ sym transpose-const-naturality))) ⟩
    ⟨♭| ((x' : Γ) → ε♭ (transpose (mod♭ (const Prop-𝟙))) x' ＝ ε♭ (transpose (mod♭ ϕ)) x') ⟩
  ≃⟨ transpose-is-♭-embedding-on-Prop (const Prop-𝟙) ϕ ⟩
    ⟨♭| ((x : I → Γ) → fst Prop-𝟙 ↔ fst (ϕ x)) ⟩
  ≃⟨ ♭≃ (postcomp-Π-≃ (λ _ → Σ-singleton (λ _ → trunc! -2) ∙e sing-UP≃ (trunc! -2))) ⟩
    ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
  ≃∎
}
}

\p{As a corollary of the above lemma, we obtain that the fibre of #{\true_I} is a
proposition and hence this map is an embedding.}

\agda{
opaque
  √⊤-diagonal-is-equiv : ∀ {@♭ 𝓤} → is-equiv (diagonal (√⊤ 𝓤))
  √⊤-diagonal-is-equiv
    = types-separate
        (diagonal (√⊤ _))
        λ {_} {Γ}
        → is-equiv←single-to-prop
            (♭-is-single (trunc! -2))
            (is-prop←equiv
              (  (fibre-√⊤≃ {Γ = Γ} (const Prop-𝟙)) e⁻¹
              ∙e ♭≃
                   (postcomp-Π-≃
                     (λ c → Σ-snd-≃ λ _ → tr≃ (_ ＝_) transpose-const-naturality)
                   ∙e postcomp-≃ (Σ-𝟙) e⁻¹))
              (♭-is-prop (trunc! -1)))
            _

√⊤-is-embedding : ∀ {@♭ 𝓤} → is-embedding (√⊤ 𝓤)
√⊤-is-embedding
  = is-embedding←diagonal-is-equiv (√⊤ _) √⊤-diagonal-is-equiv
}
}

\subtree[stt-00KE]{
\title{Relative subtypes}
\taxon{Definition}
\date{2026-10-15}

\p{We obtain a map #{\Prop_I \to \Prop} by considering the fibre of the [universal
embedding](tot-DKSN). This gives us a function
#{\rm{is-amazingly} \colon \modflat{A^I \to \Prop} \to \modflat{A \to \Prop}} with
the following universal property: let #{\phi} be a subtype of #{A^I}, then we
have an equivalence #{\modflat{\Pi_A \textrm{is-amazingly}(\phi)} \simeq \modflat{\Pi_{A^I} \phi}}.
Given #{\phi : A^I \to \Prop} we call the induced subtype the #{I}-relative subtype
induced by #{\phi}, written #{A_{\phi_I} \subset A}.}

\agda{
module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Prop 𝓥)
  (let
    @♭ ϕᵀ : A → √ (Prop 𝓥)
    ϕᵀ = ε♭ (transpose (mod♭ ϕ)))
  where

  opaque
    is-amazingly : A → Type (lsuc 𝓥)
    is-amazingly
      = fibre (√⊤ _) ∘ ϕᵀ

    is-amazingly-is-subtype
      : is-subtype is-amazingly
    is-amazingly-is-subtype a = is-prop-map←is-embedding √⊤-is-embedding (ϕᵀ a)

  is-amazingly-subtype : Subtype A (lsuc 𝓥)
  is-amazingly-subtype .Subtype.family = is-amazingly
  is-amazingly-subtype .Subtype.family-is-subtype = is-amazingly-is-subtype

  relative-subtype : Type (𝓤 ⊔ lsuc 𝓥)
  relative-subtype = Subtype.Σ̃ is-amazingly-subtype

  opaque
    unfolding is-amazingly
    untranspose-is-amazingly
      : Π A is-amazingly → Π (I → A) (fst ∘ ϕ)
    untranspose-is-amazingly f = fibre-√⊤→ ϕ f

    untranspose-is-amazingly-is-♭-equiv
      : is-♭-equiv (untranspose-is-amazingly)
    untranspose-is-amazingly-is-♭-equiv
      = is-equiv←~
          (λ _ → ♭-is-prop (Π-is-prop (snd ∘ ϕ)) _ _)
          (fibre-√⊤≃ ϕ ._≃_.fwd-is-equiv)

    transpose-is-amazingly
      : ⟨♭| Π (I → A) (fst ∘ ϕ) ⟩ → ⟨♭| Π A is-amazingly ⟩
    transpose-is-amazingly = is-equiv.bwd untranspose-is-amazingly-is-♭-equiv

module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Prop 𝓥)
  (let
    @♭ ϕ-subtype : Subtype (I → A) 𝓥
    ϕ-subtype = mk-subtype (snd ∘ ϕ)

    @♭ ϕᵀ : A → √ (Prop 𝓥)
    ϕᵀ = ε♭ (transpose (mod♭ ϕ)))
  where

  opaque
    unfolding is-amazingly
    is-amazingly-naturality
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → Π Γ (is-amazingly ϕ ∘ σ)
        → Π Γ (is-amazingly (ϕ ∘ postcomp I σ))
    is-amazingly-naturality σ = postcomp-Π
      (λ x → total-map (λ _
         → _∙ (sym (happly
           ( ap ε♭ (transpose-context-naturality σ (mod♭ ϕ))
           ∙ ε♭-natural {f = precomp _ σ} (transpose (mod♭ ϕ))) x))))

    is-amazingly-naturality-is-equiv
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → is-equiv (is-amazingly-naturality σ)
    is-amazingly-naturality-is-equiv σ
      = postcomp-Π-equiv
          (λ {x} → is-total-equiv←is-fibrewise-equiv
            (λ _ → ∙-is-equiv' _))

    is-amazingly-naturality⁻¹
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → Π Γ (is-amazingly (ϕ ∘ postcomp I σ))
        → Π Γ (is-amazingly ϕ ∘ σ)
    is-amazingly-naturality⁻¹ σ = is-equiv.bwd (is-amazingly-naturality-is-equiv σ)
}
}

\subtree[tot-0239]{
\title{The universal property of relative subtypes}
\taxon{Lemma}
\author{samueltoth}

\p{If #{I} is a tiny type, and #{\phi \colon A^I \to \Prop} some family of
propositions, we can consider the [#{I}-relative subtype]() of #{A} induced by #{\phi}
denoted #{A_{\phi}}.}

\p{This type admits an embedding #{A_{\phi} \hookrightarrow A} such that the following
square commutes (writing #{P(-)} for #{-^I}):

\quiver{
\begin{tikzcd}
	{{A_\phi}^\Gamma} && {{({P(A)}_\phi)}^{P(\Gamma)}} \\
	& {\Sigma1{f : A^\Gamma}{\phi(f^I)}} \\
	{A^\Gamma} && {{P(A)}^{P(\Gamma)}}\nsp{.}
	\arrow[from=1-1, to=1-3]
	\arrow[dotted, from=1-1, to=2-2]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=2-2, to=1-3]
	\arrow[from=2-2, to=3-1]
	\arrow["\lrcorner"{anchor=center, pos=0.125}, draw=none, from=2-2, to=3-3]
	\arrow[from=3-1, to=3-3]
\end{tikzcd}
}
}

\p{The universal property of #{A_{\phi}} says that this square is #{\flat}-cartesian.
In the case that the tiny object is the interval, and the given subcategory is wide,
this recovers the universal property of wide subcategories as given
in \citet{Fact 2.11.1}{Hau25}. It still remains to be shown that in the case that
#{\phi} is a wide subcategory and #{A} is Segal, then #{A_{\phi}} is Segal.}

\proof{
\p{The gap map of this square, when viewed in the fibre over a map #{σ \colon A^Γ},
is equivalent to the #{\flat}-equivalence
#{(\Pi_Γ \rm{is-amazingly}(\phi) \circ \Sigma) \to (\Pi_{Γ^I} \phi \circ \sigma_*)}
induced by the transport of #{\rm{is-amazingly}(\phi)} and naturality. }
}

\agda{
module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Prop 𝓥)
  (let
    @♭ ϕ-subtype : Subtype (I → A) 𝓥
    ϕ-subtype = mk-subtype (snd ∘ ϕ))
  where

  is-amazingly-UP→
    : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
      → (Π Γ (is-amazingly ϕ ∘ σ))
      → (Π (I → Γ) (fst ∘ ϕ ∘ postcomp I σ))
  is-amazingly-UP→ σ
    = untranspose-is-amazingly (ϕ ∘ postcomp I σ)
    ∘ is-amazingly-naturality ϕ σ

  opaque
    is-amazingly-UP
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A) → is-♭-equiv (is-amazingly-UP→ σ)
    is-amazingly-UP σ
      = is-♭-equiv-∘
          (untranspose-is-amazingly-is-♭-equiv (ϕ ∘ postcomp I σ))
          (is-♭-equiv←is-equiv (is-amazingly-naturality-is-equiv ϕ σ))

  relative-subtype-fam-map
    : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦}
      → Fam-map
          (⟨♭| (Γ → A) ⟩ , ♭-ind λ σ → Π Γ (is-amazingly ϕ ∘ σ))
          (⟨♭| ((I → Γ) → (I → A))⟩ , ♭-ind λ σ∗ → Π (I → Γ) (fst ∘ ϕ ∘ σ∗))
  relative-subtype-fam-map = (♭-map (postcomp I) , ♭-ind (is-amazingly-UP→))

  relative-subtype-square
    : ∀ {𝓦} {Γ : Type 𝓦}
      → Arrow-map
          (postcomp Γ (Subtype.Σ̃-π (is-amazingly-subtype ϕ)))
          (postcomp (I → Γ) (Subtype.Σ̃-π ϕ-subtype))
  relative-subtype-square .Arrow-Π.top f σ
    = ( Subtype.Σ̃-π (is-amazingly-subtype ϕ) ∘ f ∘ σ
      , is-amazingly-UP→ (Subtype.Σ̃-π (is-amazingly-subtype ϕ)) snd (f ∘ σ))
  relative-subtype-square .Arrow-Π.bot = postcomp I
  relative-subtype-square .Arrow-Π.comm = ~refl

  ♭-gap-relative-subtype≃
    : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦}
      → Arrow-equiv
          (♭-map (gap-square (relative-subtype-square {Γ = Γ})))
          (total-map
            {B = ♭-ind λ σ → ⟨♭| Π Γ (is-amazingly ϕ ∘ σ)⟩}
            {B' = ♭-ind λ σ → ⟨♭| Π (I → Γ) (fst ∘ ϕ ∘ postcomp I σ) ⟩}
            (♭-ind λ (σ : Γ → A) → ♭-map (is-amazingly-UP→ σ)))
  ♭-gap-relative-subtype≃
    = mk-arr-equiv
        (♭≃ (Σ-Π-swap≃ _ _) ∙e ♭-commΣ _ e⁻¹)
        (♭≃
           (  Σ-snd-≃ (λ σ → Σ-fst-≃ {B = λ a → postcomp I σ ＝ a .fst} (Σ-Π-swap≃ _ _)
           ∙e remove-singleton-structure Sing-is-singleton (_ , refl)))
        ∙e ♭-commΣ _ e⁻¹)
        (♭-ind λ x → Σ-path→ (refl , (mapply♭ (mod♭ (funext→ λ a → ϕ _ .snd _ _)))))

  relative-subtype-gap-is-♭-equiv
    : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦}
      → is-♭-equiv (gap-square (relative-subtype-square {Γ = Γ}))
  relative-subtype-gap-is-♭-equiv
    = src-is-equiv←Arrow-equiv
        ♭-gap-relative-subtype≃
        (is-total-equiv←is-fibrewise-equiv (♭-ind is-amazingly-UP))

  relative-subtype-is-♭-cartesian
    : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} → is-♭-cartesian (relative-subtype-square {Γ = Γ})
  relative-subtype-is-♭-cartesian
    = is-♭-cartesian←gap-is-♭-equiv
        relative-subtype-square
        relative-subtype-gap-is-♭-equiv
}
}

\subtree[tot-0PVM]{
\title{Amazingly fibrant types}
\taxon{Construction}

\p{Suppose there is some subclass of type families, whose inhabitants we call
fibrant, then if this subclass is [#{I}-relative](stt-00K1) we may form the subtype
of the universe containing those types which are 'amazingly fibrant'. The idea is
that these types are fibrant over their entire context. Let #{\UU_{\rm{fib}}} be the
aforementioned subtype, then there is a canonical type family over #{\UU_{\rm{fib}}} given
by the inclusion into #{\UU}; by definition this type family is fibrant. The universal
property of the universe of amazingly fibrant types says that any crisp fibrant type
family must factor uniquely through #{\UU_{\rm{fib}}}, i.e. #{\UU_{\rm{fib}}} is the
straightened analogue of a [universal fibration](stt-00K4). More precisely, let
#{\rm{Fib}_{\Gamma}} be the type of type families over some base type #{\Gamma}, then
we may show that the induced map #{(\Gamma \to \UU_{\rm{fib}}) \to \rm{Fib}_{\Gamma^I}}
is a flat equivalence.}

\agda{
module AmazinglyFibrant
  {@♭ α : Level → Level → Level}
  (@♭ is-fib : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (α 𝓤 𝓥))
  (@♭ is-fib-is-prop : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → is-prop (is-fib B))
  (let
    @♭ Fib : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Prop (α 𝓤 𝓥)
    Fib B = is-fib B , is-fib-is-prop B)
  (@♭ rel-fib : is-relative-fam I is-fib)
  where

  is-afib : ∀ {@♭ 𝓤} → Type 𝓤 → Type (lsuc (α 𝓘 𝓤))
  is-afib = is-amazingly Fib

  is-afib-is-prop : ∀ {@♭ 𝓤} → (A : Type 𝓤) → is-prop (is-afib A)
  is-afib-is-prop = is-amazingly-is-subtype Fib

  record UFib (@♭ 𝓤) : Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤)) where
    constructor mk-ufib
    field
      Carrier : Type 𝓤
      Carrier-is-afib : is-afib Carrier

  UFib∙ : ∀ (@♭ 𝓤) → Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤))
  UFib∙ 𝓤 = Σ (UFib 𝓤) UFib.Carrier

  UFib-π : ∀ {@♭ 𝓤} → UFib∙ 𝓤 → UFib 𝓤
  UFib-π = fst

  UFib-π-is-fib : ∀ {@♭ 𝓤} → is-fib (UFib.Carrier {𝓤})
  UFib-π-is-fib
    = rel-fib _ .snd (is-amazingly-UP→ Fib UFib.Carrier UFib.Carrier-is-afib)

  UFib-is-fib
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (P : A → UFib 𝓥)
      → is-fib (UFib.Carrier ∘ P)
  UFib-is-fib P
    = is-base-change-stable-fam←is-relative
        I is-fib rel-fib P UFib.Carrier
        UFib-π-is-fib

  liftFib
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ P : A → Type 𝓥}
      → ⟨♭| is-fib P ⟩ ↔ ⟨♭| (∀ a → is-afib (P a)) ⟩
  liftFib {A = A} {P = P} .fst fib
    = ♭-map
        (is-amazingly-naturality⁻¹ Fib P)
        (transpose-is-amazingly (Fib ∘ postcomp I P)
          (♭-map (rel-fib P .fst) fib))
  liftFib {A = A} {P = P} .snd
    = ♭-map (UFib-is-fib ∘ (λ af a → (mk-ufib (P a) (af a))))

  UFib-transport : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} → (A → UFib 𝓥) → Σ (A → Type 𝓥) is-fib
  UFib-transport f = (UFib.Carrier ∘ f , UFib-is-fib f)

  Carrier-is-prop-map : ∀ {@♭ 𝓤} → is-prop-map (UFib.Carrier {𝓤})
  Carrier-is-prop-map X = is-prop←retraction
    (λ where (a , refl) → a .UFib.Carrier-is-afib)
    ((λ a → (mk-ufib X a , refl)) , λ where (a , refl) → refl)
    (is-afib-is-prop X)

  Carrier-is-emb : ∀ {@♭ 𝓤} → is-embedding (UFib.Carrier {𝓤})
  Carrier-is-emb = is-embedding←is-prop-map Carrier-is-prop-map

  UFib-path→
    : ∀ {@♭ 𝓤} (A B : UFib 𝓤)
      → UFib.Carrier A ≃ UFib.Carrier B
      → A ＝ B
  UFib-path→ A B e = unap Carrier-is-emb (ua e)

  instance
    UFib-IdS : ∀ {@♭ 𝓤} → Identity-system (UFib 𝓤) 𝓤
    UFib-IdS {𝓤} = IdS←Embedding {f = UFib.Carrier} Carrier-is-prop-map (IdS-ua {𝓤})

  UFib-tr
    : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
      → ext! (tr≃ UFib.Carrier p) ＝ p
  UFib-tr refl = Id←IdS←Id refl

  UP-UFib
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
      → is-♭-equiv (UFib-transport {𝓤} {𝓥} {A})
  UP-UFib = is-equiv←qinv
    ( ♭-ind (λ f
        → mod♭ λ a → mk-ufib (fst f a) (ε♭ (liftFib .fst (mod♭ (snd f))) a))
    , ♭-ind (λ f
        → mapply♭ (mod♭ (ext! (λ a → id≃))))
    , ♭-ind (λ f
        → mapply♭ (mod♭ (ext! ((λ _ → id≃) , is-fib-is-prop (f .fst) _ _)))))

  UP-UFib≃
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
      → ⟨♭| (A → UFib 𝓥) ⟩ ≃ ⟨♭| Σ (A → Type 𝓥) is-fib ⟩
  UP-UFib≃ {𝓤} {𝓥} {A} = mk≃ (♭-map (UFib-transport {𝓤} {𝓥} {A})) UP-UFib
}
}

\subtree[tot-022B]{
\title{Amazing fibrancy lifting}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Let #{I} be an inhabited tiny object, and let fibrations be #{I}-relative.
Given a crisp type family #{P \colon-flat A \to \UU}, if #{P} is a fibration then
its fibres are amazingly fibrant.
}

\proof{
\p{
Let #{Q(h,a) \defeq P(a) \colon-flat \textsf{is-fib}(P)\times A \to \UU}. We start by
showing that #{Q} is crisply a fibration. Since fibrations are #{I}-relative, it
suffices to show crisply that #{Q \circ \sigma} is a fibration for every
#{\sigma \colon I \to \textsf{is-fib}(P)\times A}. Since being a fibration is a
proposition, we may assume an element #{i :^♭ I}, and so #{\pi_1 \sigma(i)} is a
proof that #{P} is a fibration. The family #{Q \circ \sigma} is a base change of #{P}
and so it is also a fibration. Abstraction over #{\sigma} thus gives a crisp proof of
the relative fibrancy condition, so we obtain a crisp proof that #{Q} is a fibration.
}

\p{
Now, applying the amazing right adjoint to this crisp witness and using naturality,
we obtain that every #{Q(x)} is amazingly fibrant. Evaluating at #{(h,a)}, where #{h}
is our initial hypothesis that #{P} is fibrant, we conclude that #{P(a)} is amazingly
fibrant.
}
}

\agda{
  lift-fibrancy
    : @♭ ║ I ║₋₁
    → ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ P : A → Type 𝓥)
    → is-fib P → (a : A) → is-afib (P a)
  lift-fibrancy |i| {𝓤} {𝓥} {A} P P-is-fib a
    = ε♭ (liftFib .fst (mod♭ Q-is-fib)) (P-is-fib , a)
    where
    @♭ Q : is-fib P × A → Type 𝓥
    Q = P ∘ snd

    @♭ Q-is-fib : is-fib Q
    Q-is-fib
      = rel-fib Q .snd (λ σ → rel-fib P .fst
          (Trunc.○-rec (is-fib-is-prop P) (fst ∘ σ) |i|)
          (snd ∘ σ))
}
}
