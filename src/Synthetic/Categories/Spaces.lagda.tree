  Δ¹ I I-distr 0≠1 Δ¹-directed Δ¹-is-segal Δ²-is-coskeletal-acyclic
open import Synthetic.Categories.DetectingEquivalencesCovariantFamilies Δ¹ I
}
}

\subtree[stt-00AS]{
\title{There is a universe of amazingly covariant types}
\taxon{Construction}

\p{Assuming that the interval is [tiny](Synthetic.Tiny), there is a universe of
\em{amazingly covariant types}, which weakly classify the left fibrations.
We denote it #{\mathcal{S}}.}

\proof{
\p{Since being covariant (or equivalently being a left fibration), is
a [#{\Delta^1}-relative class of maps](stt-00K1). By the machinery
developed for [amazing right adjoints](stt-00AA), we can construct a universe
which classifies this class.
}
}

\agda{
is-covariant-is-relative : is-relative-fam Δ¹ is-covariant
is-covariant-is-relative {B = A} P = (fwd , bwd) where
  fwd : is-covariant P → (x : Δ¹ → A) → is-covariant (P ∘ x)
  fwd cov f h = cov (f ∘ h)

  bwd : ((x : Δ¹ → A) → is-covariant (P ∘ x)) → is-covariant P
  bwd cov h x₀ = cov h id x₀

open Dependent√ Δ¹ √ √ε √-is-tiny-str
               public
open AmazinglyFibrant
  Δ¹ √ √ε √-is-tiny-str
  is-covariant
  is-covariant-is-prop
  is-covariant-is-relative
  public
  renaming
    ( is-afib to is-acov
    ; UFib to Space
    ; UFib∙ to Space∙
    ; UFib-π-is-fib to Space-π-is-covariant)
}
}

\subtree[stt-00AU]{
\title{The objects of #{\mathcal{S}} are groupoids}
\taxon{Theorem}

\p{If #{A :^\flat \UU} is a groupoid, then #{A} is amazing covariant and so
factors through #{\mathcal{S}}.}

\agda{
groupoids-in-Space : ∀ {@♭ 𝓤} (@♭ A : Type 𝓤) → @♭ is-Δ¹-discrete A → is-acov A
groupoids-in-Space A Δ¹-discrete
  = lift-fibrancy i0 _ (const-is-covariant←is-Δ¹-discrete Δ¹-discrete) tt
}
}

\subtree[stt-00L2]{
\contributor{fredrikbakke}
\title{Closure properties of amazing covariance}
\taxon{Theorem}

\p{
The universe of amazingly covariant types is closed under #{\times}, #{\Sigma} and
identity types.
}

\proof{
\p{
In each case we apply [amazing fibrancy lifting](stt-00KS) to the corresponding type
former, from which the result follows by the usual closure properties.
}
}

\agda{
opaque
  ×-is-acov
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
      → is-acov A → is-acov B → is-acov (A × B)
  ×-is-acov {𝓤} {𝓥} a b
    = lift-fibrancy i0
        (λ ((A , B) : Space 𝓤 × Space 𝓥) → Space.Carrier A × Space.Carrier B)
        (×-is-covariant {P = Space.Carrier ∘ fst} {Q = Space.Carrier ∘ snd}
          (UFib-is-fib fst) (UFib-is-fib snd))
        (mk-ufib _ a , mk-ufib _ b)

instance
  ×-Is-acov
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
        ⦃ _ : is-acov A ⦄ ⦃ _ : is-acov B ⦄
      → is-acov (A × B)
  ×-Is-acov = ×-is-acov auto! auto!

opaque
  Σ-is-acov
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      → is-acov A → (∀ a → is-acov (B a)) → is-acov (Σ A B)
  Σ-is-acov {𝓤} {𝓥} a b
    = lift-fibrancy i0
        ( λ ((A , B) : Σ[ A ∶ Space 𝓤 ] (Space.Carrier A → Space 𝓥))
          → Σ (Space.Carrier A) (Space.Carrier ∘ B))
        (Σ-is-covariant {B = Space.Carrier ∘ fst}
          {C = λ γ a → Space.Carrier (γ .snd a)}
          (UFib-is-fib fst) (UFib-is-fib (uncurry snd)))
        (mk-ufib _ a , (λ x → mk-ufib _ (b x)))

instance
  Σ-Is-acov
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
      → ⦃ _ : is-acov A ⦄ ⦃ _ : ∀ {a} → is-acov (B a) ⦄
      → is-acov (Σ A B)
  Σ-Is-acov = Σ-is-acov auto! (λ _ → auto!)

opaque
  ＝-is-acov
    : ∀ {@♭ 𝓤} {A : Type 𝓤} {a b : A}
      → is-acov A → is-acov (a ＝ b)
  ＝-is-acov {𝓤} {A} ac
    = lift-fibrancy i0
        ( λ ((A , a , b) : Σ[ A ∶ Space 𝓤 ] (Space.Carrier A × Space.Carrier A))
          → (a ＝ b))
        (＝-is-covariant (fst ∘ snd) (snd ∘ snd) (UFib-is-fib fst))
        (mk-ufib A ac , _ , _)

instance
  ＝-is-Acov
    : ∀ {@♭ 𝓤} {A : Type 𝓤} {a b : A} ⦃ _ : is-acov A ⦄
      → is-acov (a ＝ b)
  ＝-is-Acov = ＝-is-acov auto!

opaque
  exp-●-is-acov
   : ∀ {@♭ 𝓤} {A : Type 𝓤}
     → is-acov A
     → (∀ {i} → is-acov (i ＝ i0 → A))
  exp-●-is-acov {𝓤} {A} ac {i}
    = lift-fibrancy i0
        (λ ((A , i) : Space 𝓤 × Δ¹) → (i ＝ i0) → Space.Carrier A)
        (^●-is-covariant Δ¹-directed (Space.Carrier ∘ fst) (UFib-is-fib fst) snd)
        (mk-ufib A ac , i)

instance
  exp-●-is-Acov
    : ∀ {@♭ 𝓤} {A : Type 𝓤} ⦃ _ : is-acov A ⦄
      → (∀ {i} → is-acov (i ＝ i0 → A))
  exp-●-is-Acov = exp-●-is-acov auto!
}
}

\subtree[stt-00K6]{
\title{Equivalences of #{Δ¹}-copresheaves}
\taxon{Lemma}
\contributor{fredrikbakke}

\p{We show that for a pair of copresheaves #{F\ G \colon \Delta^1 \to \mathcal{S}},
a natural transformation #{\alpha \colon \Pi1{i : \Delta^1}{F(i) \to G(i)}} is a
fibrewise equivalence iff the restriction along
#{\partial \Delta^1 \hookrightarrow \Delta^1} is a fibrewise-equivalence.}

\agda{
Cov-Nat-is-equiv
  : ∀ {@♭ 𝓤} (f g : Δ¹ → Space 𝓤) (α : ∀ i → f i .Space.Carrier → g i .Space.Carrier)
    → (∀ x → is-equiv (α (∂Δ¹-incl x))) → ∀ i → is-equiv (α i)
Cov-Nat-is-equiv {𝓤} f g α
  = is-equiv.bwd
       (is-fibrewise-equiv←large-family-separates-with-𝟙
         types-with-initial-object-separate'
         {X = Σ[ X Y ∶ (Δ¹ → Space 𝓤) ] (∀ i → X i .Space.Carrier → Y i .Space.Carrier)}
         {P = λ (X , Y , α) → is-fibrewise-equiv α}
         {Q = λ (X , Y , α) → is-fibrewise-equiv (α ∘ ∂Δ¹-incl)}
         (λ (X , Y , α) → precomp-Π (is-equiv ∘ α) ∂Δ¹-incl)
         {is = 𝟙 , tt , (λ _ → Hom𝟙-is-single .centre) , Hom𝟙-is-single .central (idH tt)}
         single!
         (λ I σ
          → is-equiv←inverse
              (♭-is-prop (Π-is-prop (λ _ → Π-is-prop (λ _ → is-equiv-is-prop))))
              (♭-is-prop (Π-is-prop (λ _ → Π-is-prop (λ _ → is-equiv-is-prop))))
              (♭-ind (λ x → mod♭ (λ c i
               → ∂Δ¹-cov-Nat-is-equiv
                   types-with-initial-object-separate'
                   ∂Δ¹-is-♭-connected
                   (UFib-transport (uncurry (fst ∘ σ)) )
                   (UFib-transport (uncurry (fst ∘ snd ∘ σ)))
                   (uncurry (snd ∘ snd ∘ σ))
                   (λ b i → is-♭-equiv←is-equiv (x b i))
                   (c , i)))))
         (f , g , α))
}
}

\subtree[stt-00KW]{
\title{Paths in #{\mathcal{S}^→}}
\taxon{Lemma}

\agda{
module _ where
  open Space
  SpaceΣ : ∀ (@♭ 𝓤) → Type (lsuc (𝓘 ⊔ 𝓤))
  SpaceΣ 𝓤 = Σ[ A B ∶ Space 𝓤 ] (Carrier A → Carrier B)

  SpaceΣ-Path
    : ∀ {@♭ 𝓤} (x y : SpaceΣ 𝓤)
      → Type 𝓤
  SpaceΣ-Path (A , B , f) (X , Y , g)
    = Σ[ e ∶ A .Carrier ≃ X .Carrier ] Σ[ p ∶ B .Carrier ≃ Y .Carrier ]
        (p ._≃_.fwd ∘ f ~ g ∘ e ._≃_.fwd)

  SpaceΣ-Path-refl
    : ∀ {@♭ 𝓤} (x : (Σ[ A B ∶ Space 𝓤 ] (Carrier A → Carrier B)))
      → SpaceΣ-Path x x
  SpaceΣ-Path-refl x = (id≃ , id≃ , ~refl)

module SpacePath
  (@♭ √ᵈ-is-prop
        : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
          → (∀ g → is-prop (A g)) → ∀ g → is-prop (√ᵈ A g))
  where
  open Space
  open UIdS √ᵈ-is-prop

  opaque
    SpaceΣ-Path-is-torsorial
      : ∀ {@♭ 𝓤} (x : (Σ[ A B ∶ Space 𝓤 ] (Carrier A → Carrier B)))
        → is-torsorial (SpaceΣ-Path x)
    SpaceΣ-Path-is-torsorial (A , B , f)
      = is-singleton-structure←parts
         (SingS-is-single A)
         (A , id≃)
         (is-singleton-structure←parts
           (SingS-is-single B)
           (B , id≃)
           (SingS-is-single f))

  instance
    SpaceΣ-IdS
      : ∀ {@♭ 𝓤} → Identity-system ((Σ[ A B ∶ Space 𝓤 ] (Carrier A → Carrier B))) 𝓤
    SpaceΣ-IdS .Identity-system.IdS = SpaceΣ-Path
    SpaceΣ-IdS .Identity-system.IdS←Id {a = A} refl = SpaceΣ-Path-refl A
    SpaceΣ-IdS .Identity-system.IdS←Id-is-equiv x
      = fundamental-Id _ (SpaceΣ-Path-is-torsorial x) _

  SpaceΣ-Id→
    : ∀ {@♭ 𝓤} (x y : SpaceΣ 𝓤) → (p : SpaceΣ-Path x y) → x ＝ y
  SpaceΣ-Id→ x y p = ext! p

  opaque
    ap-fst-SpaceΣ-Id
      : ∀ {@♭ 𝓤} (x y : SpaceΣ 𝓤) → (p : SpaceΣ-Path x y)
          → ap fst (SpaceΣ-Id→ x y p) ＝ ext! (p .fst)
    ap-fst-SpaceΣ-Id x y = IdSJ {a = x}
      (λ (y , p) → ap fst (SpaceΣ-Id→ x y p) ＝ ext! (p .fst))
      (ap (ap fst) ext-Id₀ ∙ sym ext-Id₀)
}
}

\subtree[stt-00UW]{
\taxon{Lemma}

\p{There is a map ##{(\Gamma \to \Sigma1{X, Y : \mathcal{S}}{(X \to Y)}) \to
\Sigma1{X, Y : \rm{LFib}_\Gamma}{(X \to Y)}} (where the latter type is the type of
[covariant #{Δ¹}-bundles](stt-00V3) over #{Γ}) given by the fact #{\mathcal{S}
\to \UU} is a covariant type family. Because #{\mathcal{S}} is the universal such
family, this map is a #{\flat}-equivalence.}

\agda{
module CovBundle
  (@♭ √ᵈ-is-prop
        : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
          → (∀ g → is-prop (A g)) → ∀ g → is-prop (√ᵈ A g))
  {@♭ 𝓤} {@♭ Γ : Type 𝓤}
  where
  open SpacePath √ᵈ-is-prop
  open UIdS √ᵈ-is-prop

  Cov-bundle←SpaceΣ
    : ∀ {@♭ 𝓥} → (Γ → SpaceΣ 𝓥) → Cov-Δ¹-bundle 𝓥 Γ
  Cov-bundle←SpaceΣ
    = map-Σ
        UFib-transport
        (λ _ → map-Σ UFib-transport (λ _ → id) ∘ Σ-Π-swap _ _)
    ∘ Σ-Π-swap _ _

  Cov-bundle←SpaceΣ-is-♭-equiv
    : ∀ {@♭ 𝓥} → is-♭-equiv (Cov-bundle←SpaceΣ {𝓥})
  Cov-bundle←SpaceΣ-is-♭-equiv {𝓥}
    = is-♭-equiv-∘
        (map-Σ-is-♭-equiv _ _
          UP-UFib
          λ _
           → is-♭-equiv-∘
               (map-Σ-is-♭-equiv _ _
                 UP-UFib
                 λ _ → is-♭-equiv←is-equiv id-is-equiv)
               (is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _))))
        (is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _)))

  ♭Cov-bundle≃♭SpaceΣ
    : ∀ {@♭ 𝓥} → ⟨♭| (Γ → SpaceΣ 𝓥) ⟩ ≃ ⟨♭| Cov-Δ¹-bundle 𝓥 Γ ⟩
  ♭Cov-bundle≃♭SpaceΣ
    = mk≃ (♭-map Cov-bundle←SpaceΣ) Cov-bundle←SpaceΣ-is-♭-equiv
}
}

\subtree[stt-00AT]{
\title{#{\mathcal{S}} is directed univalent}
\taxon{Theorem}
\contributor{fredrikbakke}

\p{We show that #{\mathcal{S}} is directed univalent. That is, morphisms of groupoids
in #{\mathcal{S}} correspond exactly to functions between them.}

\p{We start by noting that there is a canonial map
from #{F : \mathcal{S}^{\Delta^1}} to #{F(0) \to F(1)} given by covariant
transport.}

\agda{
tr-𝓢 : ∀ {@♭ 𝓤} → (f : Δ¹ → Space 𝓤) → Space.Carrier (f i0) → Space.Carrier (f i1)
tr-𝓢 = tr-cov {P = Space.Carrier} Space-π-is-covariant

opaque
  tr-𝓢-unique
    : ∀ {@♭ 𝓤} (f : Δ¹ → Space 𝓤)
        {F : Space.Carrier (f i0) → Space.Carrier (f i1)}
      → ∀ x → (Homᵈ (Space.Carrier ∘ f) x (F x))
      → tr-𝓢 f x ＝ F x
  tr-𝓢-unique f {F = F} x p = ap fst (Space-π-is-covariant f x .central (F x , p))

tr-𝓢-hom
  : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (F : A → Space 𝓥)
      {x y} (f : Hom A x y)
    → Space.Carrier (F x) → Space.Carrier (F y)
tr-𝓢-hom F = tr-cov-hom {P = Space.Carrier ∘ F} (UFib-is-fib F)

tr-𝓢-hom:
  : ∀ {@♭ 𝓤} (A B : Space 𝓤)
    → Hom (Space 𝓤) A B → (Space.Carrier A → Space.Carrier B)
tr-𝓢-hom: A B = tr-𝓢-hom id
{-# INLINE tr-𝓢-hom: #-}

opaque
  tr-𝓢-hom-unique
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (F : A → Space 𝓥) {x y : A} (f : Hom A x y)
        {Ff : Space.Carrier (F x) → Space.Carrier (F y)}
      → ∀ x → (Hom-over f x (Ff x))
      → tr-𝓢-hom F f x ＝ Ff x
  tr-𝓢-hom-unique F f {Ff} x
    = tr-cov-hom-unique (Space.Carrier ∘ F) (UFib-is-fib F) f x (Ff x)
}

\p{We then show that the induced map
#{\mathcal{S}^{\Delta^1} \to \Sigma1{X, Y : \mathcal{S}}{(X \to Y)}}
is an equivalence.}

\proof{
\p{For concision, let #{M \defeq \Sigma1{X, Y : \mathcal{S}}{(X \to Y)}} and
#{N \defeq \Sigma1{X, Y : \rm{LFib}_{\Gamma}}{(X \to Y)}}.
By the fact that types separate, it is enough to show that the induced map
#{\modflat{\mathcal{S}^{\Delta^1 \times \Gamma}} \to \modflat{M^{\Gamma}}} is an
equivalence. We may construct a square:

\quiver{
\begin{tikzcd}[cramped]
	{\modflat{\mathcal{S}^{\Delta^1 \times \Gamma}}} && {\modflat{\rm{LFib}_{\Delta^1 \times \Gamma}}} \\
	\\
	{\modflat{M^\Gamma}} && {\modflat{N}}
	\arrow["\sim", from=1-1, to=1-3]
	\arrow["{tr_{\mathcal{S}}}"', from=1-1, to=3-1]
	\arrow["{tr_{\rm{LFib}}}", from=1-3, to=3-3]
	\arrow["\sim"', from=3-1, to=3-3]
\end{tikzcd}
}

where the top equivalence is given by the universal property of #{\mathcal{S}}, and
the bottom by the equivalence constructed in \ref{stt-00UW}. Finally, the codomain of
this arrow equivalence is itself an equivalence by \ref{stt-00V5}, where the inverse
is given by constructing the [directed glueing family](stt-00UY).
}

\agda{
total-dua→
  : ∀ {@♭ 𝓤} → (Δ¹ → Space 𝓤)
    → Σ[ A B ∶ Space 𝓤 ] (Space.Carrier A → Space.Carrier B)
total-dua→ h = (h i0 , h i1 , tr-𝓢 h)

coe-𝓢
  : ∀ {@♭ 𝓤} (f : Δ¹ → Space 𝓤) {i j} → i ≤ j
    → Space.Carrier (f i) → Space.Carrier (f j)
coe-𝓢 f = coe-cov (Space.Carrier ∘ f) (UFib-is-fib f)

coe-𝓢-id
  : ∀ {@♭ 𝓤} (f : Δ¹ → Space 𝓤) {i} (p : i ≤ i)
    → coe-𝓢 f p ~ id
coe-𝓢-id f = coe-cov-id (Space.Carrier ∘ f) (UFib-is-fib f)

module _
  (@♭ √ᵈ-is-prop
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
      → (∀ g → is-prop (A g)) → ∀ g → is-prop (√ᵈ A g))
  where
  open SpacePath √ᵈ-is-prop
  open UIdS √ᵈ-is-prop
  open CovBundle √ᵈ-is-prop

  total-dua : ∀ {@♭ 𝓤} → is-equiv (total-dua→ {𝓤 ⊔ 𝓘})
  total-dua {𝓤}
    = types-separate total-dua→
        (λ {𝓥} {Γ}
         → src-is-equiv←Arrow-equiv
             ammape
             (total-tr-cov-is-♭-equiv {𝓥} {𝓤}
               (∂Δ¹-cov-Nat-is-equiv
                  types-with-initial-object-separate'
                  ∂Δ¹-is-♭-connected)))
    where
    open Space
    module _ {@♭ 𝓥} {@♭ Γ : Type 𝓥} where opaque

      ammap
        : Arrow-map
            (♭-map (postcomp Γ (total-dua→ {𝓤 ⊔ 𝓘})))
            (♭-map (total-tr-cov {𝓥} {𝓘 ⊔ 𝓤} {Γ}))
      ammap .Arrow-Π.top = ♭-map UFib-transport ∘ ♭-map uncurry
      ammap .Arrow-Π.bot = ♭-map Cov-bundle←SpaceΣ
      ammap .Arrow-Π.comm (mod♭ f) = refl

      ammape
        : Arrow-equiv
            (♭-map (postcomp Γ (total-dua→ {𝓤 ⊔ 𝓘})))
            (♭-map (total-tr-cov  {𝓥} {𝓘 ⊔ 𝓤} {Γ}))
      ammape .fst = ammap
      ammape .snd .fst = is-equiv-∘ UP-UFib (is-♭-equiv←is-equiv uncurry-is-equiv)
      ammape .snd .snd = Cov-bundle←SpaceΣ-is-♭-equiv

  total-dua≃ : ∀ {@♭ 𝓤} → (Δ¹ → Space (𝓤 ⊔ 𝓘)) ≃ SpaceΣ (𝓤 ⊔ 𝓘)
  total-dua≃ {𝓤} = mk≃ total-dua→ (total-dua {𝓤})
}

\p{
As a consequence of the fact that the canonical total map
#{\mathcal{S}^{Δ¹} \to \Sigma1{A, B : \mathcal{S}}{(A \to B)}} is an equivalence,
we immediately get that the canonical fibred map
#{\Hom_\mathcal{S}(A,B) \to (A \to B)} is an equivalence as well.
}

\agda{
  opaque
    unfolding tr-cov-hom

    total-dua-Arrow-equiv
      : ∀ {@♭ 𝓤}
        → Arrow-equiv
            (total-dua→ {𝓤 ⊔ 𝓘})
            (total-map (λ A → total-map {B = Hom (Space (𝓤 ⊔ 𝓘)) A} (tr-𝓢-hom: A)))
    total-dua-Arrow-equiv = mk-arr-equiv total-hom id≃ ~refl

  dua
    : ∀ {@♭ 𝓤} (A B : Space (𝓘 ⊔ 𝓤)) → is-equiv (tr-𝓢-hom: A B)
  dua {𝓤} A
    = is-fibrewise-equiv←is-total-equiv
        (is-fibrewise-equiv←is-total-equiv
          (tgt-is-equiv←Arrow-equiv
            (total-dua-Arrow-equiv {𝓤})
            (total-dua {𝓤}))
          (A))
}
}
}

\subtree[stt-00X0]{
\title{#{Δ²}-directed univalence}
\taxon{Lemma}

\p{Let #{\mathcal{S}_2} denote the type consisting of three spaces #{X, Y, Z},
together with a pair of maps #{Y \to Z} and #{X \to Y}. The induced map
#{\mathcal{S}^{\Delta^2} \to \mathcal{S}_2} given by covariant transport is an equivalence.}

\proof{
We use the fact that [types separate](stt-00NM) so that we may show that for any crisp type
#{\Gamma}, the induced map #{\modflat{\mathcal{S}^{\Delta^2 \times \Gamma}} \to \modflat{{\mathcal{S}_2}^{\Gamma}}}
is an equivalence. We construct a square as in \ref{stt-00AT} so that we may apply the
[corresponding fact for \em{closed} left fibrations](stt-00XA).
}

\agda{
module _
  (@♭ √ᵈ-is-prop
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} (@♭ A : (Δ¹ → Γ) → Type 𝓥)
      → (∀ g → is-prop (A g)) → ∀ g → is-prop (√ᵈ A g))
  where
  open SpacePath √ᵈ-is-prop
  open UIdS √ᵈ-is-prop
  open CovBundle √ᵈ-is-prop

  Space²Σ : ∀ (@♭ 𝓥) → Type (lsuc (𝓘 ⊔ 𝓥))
  Space²Σ 𝓥
    = Σ[ X Y Z ∶ Space 𝓥 ]
      ( (Y .Space.Carrier → Z .Space.Carrier)
      × (X .Space.Carrier → Y .Space.Carrier))

  total-dua²→ : ∀ {@♭ 𝓥} → (Δ² → Space 𝓥) → Space²Σ 𝓥
  total-dua²→ F = (F 0 , F 1 , F 2 , tr-𝓢-hom F Δ²-1≤2 , tr-𝓢-hom F Δ²-0≤1)

  Cov-Δ²-bundle←Space
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} → (Γ → Space²Σ 𝓥) → Cov-Δ²-bundle Γ 𝓥
  Cov-Δ²-bundle←Space
    = map-Σ
        UFib-transport
        (λ a
         → map-Σ
             UFib-transport
             (λ b
              → map-Σ
                  UFib-transport
                  (λ c → Σ-Π-swap _ _)
              ∘ Σ-Π-swap _ _ )
         ∘ Σ-Π-swap _ _)
    ∘ Σ-Π-swap _ _

  Cov-Δ²-bundle←Space-is-♭-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤}
      → is-♭-equiv (Cov-Δ²-bundle←Space {𝓤} {𝓥} {Γ})
  Cov-Δ²-bundle←Space-is-♭-equiv
    = is-♭-equiv-∘
       (map-Σ-is-♭-equiv _ _
         UP-UFib
         (λ _
          → is-♭-equiv-∘
              (map-Σ-is-♭-equiv _ _
                UP-UFib
                (λ _
                 → is-♭-equiv-∘
                     (map-Σ-is-♭-equiv _ _
                        UP-UFib
                        λ _ → is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _)) )
                     (is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _)))))
              (is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _)))))
       (is-♭-equiv←is-equiv (_≃_.fwd-is-equiv (Σ-Π-swap≃ _ _)))

  ♭Cov-Δ²-bundle≃♭Space
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓤} → ⟨♭| (Γ → Space²Σ 𝓥) ⟩ ≃ ⟨♭| Cov-Δ²-bundle Γ 𝓥 ⟩
  ♭Cov-Δ²-bundle≃♭Space
    = mk≃ (♭-map Cov-Δ²-bundle←Space) Cov-Δ²-bundle←Space-is-♭-equiv

  total-dua² : ∀ {@♭ 𝓤} → is-equiv (total-dua²→ {𝓤 ⊔ 𝓘})
  total-dua² {𝓤}
    = types-separate total-dua²→
        (λ {𝓥} {Γ}
         → src-is-equiv←Arrow-equiv
             (mk-arr-equiv
               (♭≃ uncurry≃ ∙e UP-UFib≃)
               ♭Cov-Δ²-bundle≃♭Space
               (♭-ind (λ _ → refl)))
             (total-tr²-cov-is-♭-equiv {𝓥}{𝓤}
               (points-Δ²-cov-Nat-is-equiv
                 types-with-initial-object-separate'
                 ∂Δ¹-is-♭-connected)))

  total-dua²≃ : ∀ {@♭ 𝓤} → (Δ² → Space (𝓤 ⊔ 𝓘)) ≃ Space²Σ (𝓤 ⊔ 𝓘)
  total-dua²≃ {𝓤} = mk≃ total-dua²→ (total-dua² {𝓤})
}
}


\subtree[stt-00XG]{
\title{Space is Segal}
\taxon{Theorem}

\scope{
\put\transclude/toc{false}
\subtree[stt-00XF]{
\taxon{Proof}
\p{First note that the type #{\mathcal{S}_2 \defeq \Sigma1{X,Y,Z : \mathcal{S}}{(Y
\to Z) \times (X \to Y)}} is a pullback of #{\Sigma1{X,Y : \mathcal{S}}{(X \to
Y)}} with #{\Sigma1{Y,Z : \mathcal{S}}{(Y \to Z)}}. Then we may construct a
commuting cube as below where, by [directed univalence](stt-00AT) and
[#{\Delta^2}-directed univalence](stt-00X0), the vertical maps are
equivalences. \ref{stt-00WX} tells us that #{\mathcal{S}} is Segal precisely when
this top square is cartesian.}

\quiver{
\begin{tikzcd}
	{{\mathcal{S}}^{\Delta^2}} &&& {{\mathcal{S}}^{\Delta^1}} && \\
	\\
	& {{\mathcal{S}}^{\Delta^1}} &&&& {{\mathcal{S}}} \\
	{\mathcal{S}_2} &&& {\Sigma1{X,Y : \mathcal{S}}{(X \to Y)}} \\
	\\
	& {\Sigma1{X,Y : \mathcal{S}}{(X \to Y)}} &&&& {\mathcal{S}}
	\arrow[from=1-1, to=1-4]
	\arrow[from=1-1, to=3-2]
	\arrow["\sim"', from=1-1, to=4-1]
	\arrow[from=1-4, to=3-6]
	\arrow["\sim"', from=1-4, to=4-4]
	\arrow[from=3-2, to=3-6]
	\arrow["\sim"', from=3-2, to=6-2]
	\arrow[equals, from=3-6, to=6-6]
	\arrow[from=4-1, to=4-4]
	\arrow[from=4-1, to=6-2]
	\arrow[from=4-4, to=6-6]
	\arrow[""{name=0, anchor=center, inner sep=0}, from=6-2, to=6-6]
	\arrow["\lrcorner"{anchor=center, pos=0.125, rotate=45}, draw=none, from=4-1, to=0]
\end{tikzcd}
}
}
}

\agda{
  SpaceΛ[2,1]-Σ-cospan : ∀ (@♭ 𝓥) → Cospan (lsuc (𝓘 ⊔ 𝓥)) (lsuc (𝓘 ⊔ 𝓥)) (lsuc (𝓘 ⊔ 𝓥))
  SpaceΛ[2,1]-Σ-cospan 𝓥 .Cospan.Centre = Space 𝓥
  SpaceΛ[2,1]-Σ-cospan 𝓥 .Cospan.Left = SpaceΣ 𝓥
  SpaceΛ[2,1]-Σ-cospan 𝓥 .Cospan.left = fst ∘ snd
  SpaceΛ[2,1]-Σ-cospan 𝓥 .Cospan.Right = SpaceΣ 𝓥
  SpaceΛ[2,1]-Σ-cospan 𝓥 .Cospan.right = fst

  Space²-cone : ∀ {@♭ 𝓤} → Cone (SpaceΛ[2,1]-Σ-cospan 𝓤) (Space²Σ 𝓤)
  Space²-cone .Cone.i (A , B , C , f , g) = (A , B , g)
  Space²-cone .Cone.j (A , B , C , f , g) = (B , C , f)
  Space²-cone .Cone.filler = ~refl

  Space²-is-pullback : ∀ {@♭ 𝓥} → is-pullback (Space²-cone {𝓥})
  Space²-is-pullback = is-equiv←qinv
    ( (λ {((a , b , g) , (.b , c , f) , refl) → a , b , c , f , g})
    , ~refl
    , λ {(_ , _ , refl) → refl})
}

\agda{
  opaque
    unfolding tr-cov-hom

    Space²-left-Arrow-equiv
      : ∀ (@♭ 𝓥)
      → Arrow-equiv
          (precomp (Space (𝓥 ⊔ 𝓘)) δ₀²)
          (Space²-cone {𝓥 ⊔ 𝓘} .Cone.j)
    Space²-left-Arrow-equiv 𝓥
      = mk-arr-equiv
          (total-dua²≃ {𝓥})
          (total-dua≃ √ᵈ-is-prop {𝓥})
          (λ F → SpaceΣ-Id→ _ _
            ( tr≃ (Space.Carrier ∘ F) Δ²-refl
            , tr≃ (Space.Carrier ∘ F) Δ²-refl
            , λ x
            → tr-cov-hom-Idᵈ (Space.Carrier ∘ F) (UFib-is-fib F)
                Δ²-refl Δ²-refl (λhom δ₀²) Δ²-1≤2
                ( (λ _ → Δ²-refl)
                , (mk-square (Δ²-is-set _ _ _ _)
                , (mk-square (Δ²-is-set _ _ _ _)))) x ))

    Space²-right-Arrow-equiv
      : ∀ (@♭ 𝓥)
      → Arrow-equiv
          (precomp (Space (𝓥 ⊔ 𝓘)) (point i1))
          (SpaceΛ[2,1]-Σ-cospan (𝓥 ⊔ 𝓘) .Cospan.left)
    Space²-right-Arrow-equiv 𝓥
      = mk-arr-equiv (total-dua≃ √ᵈ-is-prop {𝓥}) unit-UP≃ ~refl

    Space²-cube-equiv
      : ∀ (@♭ 𝓥)
      → Cube-equiv
          (precomp-square Λ[2,1]-Δ²-square (Space (𝓥 ⊔ 𝓘)))
          (Arrow-map←Cone (Space²-cone {𝓥 ⊔ 𝓘}))
    Space²-cube-equiv 𝓥
      = mk-cube-equiv
          (Space²-left-Arrow-equiv 𝓥) (Space²-right-Arrow-equiv 𝓥)
          ( ~refl , ~refl
          , λ a
            → ap
              (_∙ refl)
              ( ∙-reflr _
                ∙ ap-fst-SpaceΣ-Id _ _ _
                ∙ (ext! (tr≃ (Space.Carrier ∘ a) Δ²-refl)
              ＝⟨ ap ext! (ext! (λ _ → tr∘ Space.Carrier a Δ²-refl)) ⟩
                ext! (tr≃ Space.Carrier (ap a Δ²-refl))
              ＝⟨ UFib-tr (ap a Δ²-refl) ⟩
                ap a Δ²-refl
              ＝⟨ ap (ap a) (Δ²-is-set _ _ _ _) ⟩
                ap a (sym Δ²-refl)
              ＝⟨ sym (happly (funext-redex) tt) ⟩
                happly (funext→ (λ x → ap a (sym Δ²-refl))) tt ∎)))

  Space-is-segal
    : ∀ {@♭ 𝓤} → is-segal (Space (𝓤 ⊔ 𝓘))
  Space-is-segal {𝓤}
    = is-segal←is-cartesian
        (front-cartesian←equiv-cube
          (Space²-cube-equiv 𝓤)
          (is-cartesian←cone-is-pullback _ Space²-is-pullback))
}
}
