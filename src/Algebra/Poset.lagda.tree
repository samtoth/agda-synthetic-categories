\date{2025-04-15}
\title{Posets}
\author{markwilliams}
\taxon{Module}

\import{stt-macros}

\agda{
module Algebra.Poset where
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Foundations.PropClosure
}
}

\subtree[stt-00TJ]{
\title{Posets}
\taxon{Definition}
\contributor{fredrikbakke}

\p{
A \em{poset} is a type #{A} together with a propositional binary relation
#{{-} \le {-}} that is reflexive, transitive, and antisymmetric.
}

\agda{
record is-poset {𝓤 𝓥} {A : Type 𝓤} (_≤_ : A → A → Type 𝓥) : Type (𝓤 ⊔ 𝓥) where
  no-eta-equality
  field
    ≤-is-prop : ∀ {a b} → is-prop (a ≤ b)
    ≤-refl    : ∀ {a} → a ≤ a
    ≤-trans   : ∀ {a b c} → a ≤ b → b ≤ c → a ≤ c
    ≤-antisym : ∀ {a b} → a ≤ b → b ≤ a → a ＝ b

  _≥_ : A → A → Type 𝓥
  i ≥ j = j ≤ i

record Poset {𝓤} 𝓥 (A : Type 𝓤) : Type (𝓤 ⊔ lsuc 𝓥) where
  constructor mk-poset
  field
    {_≤_} :  A → A → Type 𝓥
    ≤-is-poset :  is-poset _≤_

  open is-poset ≤-is-poset public

  ≤←＝ : ∀ {a b} → a ＝ b → a ≤ b
  ≤←＝ refl = ≤-refl

  ≥←＝ : ∀ {a b} → a ＝ b → b ≤ a
  ≥←＝ = ≤←＝ ∘ sym

  carrier-is-set : is-set A
  carrier-is-set = is-set←prop-in-Id
    (λ _ _ → ×-is-prop ≤-is-prop ≤-is-prop)
    (λ _ → (≤-refl , ≤-refl))
    (λ (p , q) → ≤-antisym p q)

  carrier-is-0-truncated : is-truncated 0 A
  carrier-is-0-truncated = is-truncated←is-set carrier-is-set

  instance
    Carrier-is-truncated : ∀ {k} → Is-truncated (𝕋←ℕ k) A
    Carrier-is-truncated = truncation-instance 0 carrier-is-0-truncated

    ≤-Is-truncated : ∀ {a b k} → Is-truncated (𝕋←ℕ k) (a ≤ b)
    ≤-Is-truncated = truncation-instance -1 (is-truncated←is-prop ≤-is-prop)
}
}
