\title{Horn glueing}
\author{samueltoth}
\date{2026-06-24}
\taxon{Module}
\import{stt-macros}

\subtree[stt-00X5]{
\taxon{Idea}
\author{samueltoth}

\p{In \ref{Synthetic.Categories.DirectedGlueing}, a glue type is used to give an
equivalence between [covariant families](stt-00AY) over #{\Delta^1 \times \Gamma} and
pairs of covariant families over #{\Gamma} and maps between them
(\ref{stt-00V2}); this in turn shows that
the [category of spaces](stt-00AS) is directed univalent (\ref{stt-00AT}).
In this module we extend this construction to equivalences between covariant families
over #{\Delta^2 \times \Gamma} and triples of covariant families and composable
maps between them. This is a crucial ingredient in the proof that [the category of
spaces is Segal](stt-00XG).}
}

\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Empty
open import Foundations.Singletons
open import Algebra.Lattice
open import Algebra.Lattice.Instances.Polynomial hiding (Δ²)

import Synthetic.Categories.Precategories
open import Synthetic.Directedness
import Synthetic.Hom

module Synthetic.Categories.HornGlueing
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹) (@♭ I-distr : is-distributive I)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (@♭ 0≠1 : i0 ≠ i1)
  (@♭ Δ¹-is-directed : Δ¹-is-directed Δ¹ I)
  (open Synthetic.Categories.Precategories Δ¹ I)
  (@♭ Δ¹-is-segal : is-segal Δ¹)
  (let @♭ Δ² = Algebra.Lattice.Instances.Polynomial.Δ² I)
  (open Synthetic.Hom Δ¹ i0 i1)
  (@♭ Hom-Δ²-is-prop : ∀ {x y} → is-prop (Hom Δ² x y))
  where

module Δ² = Algebra.Lattice.Instances.Polynomial.Δ²
module I[x] = Lattice (Free-Lattice I I-distr)

open import Axioms.UF
}

