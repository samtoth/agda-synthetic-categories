\subtree[stt-00DM]{
\title{Orthogonality with respect to coslice maps}
\taxon{Definition}

\p{Given a map in the coslice #{f : p \to_X q}, and some element #{x} in the
coslice under #{X}, we say that #{f} is orthogonal to #{x} (or #{f \perp x})
when coslice precomposition by #{f} at #{x} is an equivalence.}

\agda{
are-orthogonal-coslice
  : ∀ {𝓧 𝓤 𝓥 𝓦} {X : Type 𝓧} {A : Type 𝓤} {B : Type 𝓥} {p : X → A} {q : X → B}
      {Y : Type 𝓦}
    → (F : Coslice-map p q) → (X → Y) → Type (𝓧 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
are-orthogonal-coslice F k = is-equiv (Coslice-map-precompose k F)

instance
  Orthogonal-coslice-notation
    : ∀ {𝓧 𝓤 𝓥 𝓦} {X : Type 𝓧} {A : Type 𝓤} {B : Type 𝓥} {p : X → A} {q : X → B}
        {Y : Type 𝓦}
      → Orthogonality (Coslice-map p q) (X → Y)
  Orthogonal-coslice-notation .Orthogonality._⊥_ = are-orthogonal-coslice
}
}


\subtree[stt-00DC]{
\title{Coslice orthogonality is orthogonality of the underlying map}
\taxon{Lemma}

\p{Given a map #{f} in the [coslice](stt-0062) #{p \to_X q}, #{f} is orthogonal
to every map #{X \to Y} iff #{f} is left orthogonal to #{Y}.
}

\agda{
coslice-orthogonality
  : ∀ {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥} {X : Type 𝓦} {Y : Type 𝓜}
      {p : X → A} {q : X → B} (f : Coslice-map p q)
    → (f .fst ⊥ Y)
    ↔ (∀ (x : X → Y) → f ⊥ x)
coslice-orthogonality {A = A} {B} {X} {Y} {p} {q} (f , H)
  = tr
      (λ (h : f ∘ p ~ q)
         → orthogonal-type f Y
         ↔ ((x : X → Y) → are-orthogonal-coslice (f , h) x))
      (funext-redex)
      (src↔tgt-is-equiv←Arrow-equiv (amap (funext→ H) , eq)
      ∙iff fibrewise↔total-is-equiv) where

  add-singleton
    : ∀ {𝓠} {Q : Type 𝓠} (p : X → Q) (g : Q → Y)
      → Σ[ x ∶ (X → Y) ] Σ[ f' ∶ (Q → Y) ] (f' ∘ p ~ x)
  add-singleton f g = (g ∘ f , g , ~refl)

  add-singleton-eq
    : ∀ {𝓠} {Q : Type 𝓠} (p : X → Q)
      → quasi-inv (add-singleton p)
  add-singleton-eq p .fst (a , f , H) = f
  add-singleton-eq p .snd .fst x = refl
  add-singleton-eq p .snd .snd (a , f , H)
    = funext-rec
        (λ H → ((f ∘ p) , (f , ~refl)) ＝ (a , (f , H)))
        (λ where refl → refl)
        H

  amap
    : ∀ (H : f ∘ p ＝ q)
      → Arrow-map
          (precomp Y f)
          (total-map (λ a → Coslice-map-precompose a (f , happly H)))
  amap H .Arrow-map.top = add-singleton q
  amap H .Arrow-map.bot =  add-singleton p
  amap refl .Arrow-map.comm x = refl

  eq : is-Arrow-equiv (amap (funext→ H))
  eq .fst = is-equiv←qinv (add-singleton-eq q)
  eq .snd = is-equiv←qinv (add-singleton-eq p)
}
}

\subtree[stt-00DN]{
\taxon{Lemma}

\p{Given a diagram as follows:}

\quiver{
\begin{tikzcd}
	A \\
	&& B && C \\
	{A'}
	\arrow["F"', from=1-1, to=3-1]
	\arrow["f"', from=2-3, to=1-1]
	\arrow["g", from=2-3, to=2-5]
	\arrow["{f'}", from=2-3, to=3-1]
\end{tikzcd}
}

\p{We can take the pushout of the top span, and the bottom span, and by
functoriality, the coslice map #{F} gives us a map of pushouts. We give an
equivalence of arrows between precomposition of the pushout map and
the map between the pullbacks associated to the corresponding precomposition
cospans. As an easy corollary we get the result that #{F} is orthogonal
to #{qg} for all maps #{q : C \to Q} iff the pushout map induced by
#{F} is orthogonal to #{Q}.}

\agda{
Pushout-map-left
  : ∀ {𝓤 𝓤' 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓤'} {B : Type 𝓥} {C : Type 𝓦}
      (f : B → A) (f' : B → A') (g : B → C) → (F : Coslice-map f f')
    → Pushout f g → Pushout f' g
Pushout-map-left f f' g F = Pushout₁ (mk-span-map (F .fst) id id (F .snd) ~refl)

precomp-pullback
  : ∀ {𝓤 𝓤' 𝓥 𝓦 𝓠} {A : Type 𝓤} {A' : Type 𝓤'} {B : Type 𝓥} {C : Type 𝓦}
      (f : B → A) (f' : B → A') (g : B → C) → (F : Coslice-map f f')
    → (Q : Type 𝓠)
    → Cospan-map
        (mk-cospan _ (precomp Q g) (precomp Q f'))
        (mk-cospan _ (precomp Q g) (precomp Q f))
precomp-pullback f f' g F Q .Cospan-map.h₁ = id
precomp-pullback f f' g F Q .Cospan-map.h₂ = id
precomp-pullback f f' g F Q .Cospan-map.h₃ = precomp Q (F .fst)
precomp-pullback f f' g F Q .Cospan-map.H = ~refl
precomp-pullback f f' g F Q .Cospan-map.K a
  = funext→ (postwhisker a _ _ (sym ∘ F .snd))

pushout-arrow-UP
  : ∀ {𝓤 𝓤' 𝓥 𝓦 𝓠} {A : Type 𝓤} {A' : Type 𝓤'} {B : Type 𝓥} {C : Type 𝓦}
      (f : B → A) (f' : B → A') (g : B → C) → (F : Coslice-map f f')
      {Q : Type 𝓠}
    → Arrow-map
        (precomp Q (Pushout-map-left f f' g F))
        (Pullback₁ (precomp-pullback f f' g F Q))
pushout-arrow-UP f f' g F .Arrow-map.top
  = precomp-cocone≃pb' ._≃_.fwd ∘ cocone-map _ pushout
pushout-arrow-UP f f' g F .Arrow-map.bot
  = precomp-cocone≃pb' ._≃_.fwd ∘ cocone-map _ pushout
pushout-arrow-UP f f' g F .Arrow-map.comm a = pullback-path→
  ( refl
  , refl
  , sym (∙-reflr _
    ∙ ap (funext→)
      (funext→ (λ b → ap sym (ap-∘ a _ (glue b)
                             ∙ ap (ap a) (pushout-rec-apβ b
                             ∙ ap (ap ι₁ (F .snd b) ∙_) (∙-reflr _)))))
      ∙ sym (ap (_∙ funext→ (ap (a ∘ ι₁) ∘ sym ∘ F .snd))
                (ap-id (funext→ (sym ∘ ap a ∘ glue)))
      ∙ sym (funext-∙ (sym ∘ ap a ∘ glue) (ap (a ∘ ι₁) ∘ sym ∘ F .snd))
      ∙ ap funext→ (funext→ (λ b
          → ap (sym (ap a (glue b)) ∙_)
               (ap-sym (a ∘ ι₁) (F .snd b) ∙ ap sym (ap-∘ a ι₁ (F .snd b)))
               ∙ sym (∙-symsym (ap a (ap ι₁ (F .snd b))) (ap a (glue b)))
               ∙ ap sym (sym (ap-∙ a (ap ι₁ (F .snd b)) (glue b))))))))

pushout-arrow-UP-is-equiv
  : ∀ {𝓤 𝓤' 𝓥 𝓦 𝓠} {A : Type 𝓤} {A' : Type 𝓤'} {B : Type 𝓥} {C : Type 𝓦}
      (f : B → A) (f' : B → A') (g : B → C) → (F : Coslice-map f f')
      {Q : Type 𝓠}
    → is-Arrow-equiv (pushout-arrow-UP f f' g F {Q})
pushout-arrow-UP-is-equiv f f' g F .fst
  = is-equiv-∘ (precomp-cocone≃pb' ._≃_.fwd-is-equiv) Pushout-has-up-pushout
pushout-arrow-UP-is-equiv f f' g F .snd
  = is-equiv-∘ (precomp-cocone≃pb' ._≃_.fwd-is-equiv) Pushout-has-up-pushout

opaque
  left-orthogonal-type-pushout₁
    : ∀ {𝓤 𝓤' 𝓥 𝓦 𝓠} {A : Type 𝓤} {A' : Type 𝓤'} {B : Type 𝓥} {C : Type 𝓦}
        {f : B → A} {f' : B → A'} {g : B → C} → (F : Coslice-map f f')
        {Q : Type 𝓠}
      → ((Pushout₁ {S = mk-span _ f g}
        (mk-span-map (F .fst) id id (F .snd) ~refl)) ⊥ Q)
      ↔ (∀ (q : C → Q) → F ⊥ (q ∘ g))
  left-orthogonal-type-pushout₁ {A = A} {A'} {C = C} {f} {f'} {g} F {Q}
    = src↔tgt-is-equiv←Arrow-equiv
        (pushout-arrow-UP f f' g F , pushout-arrow-UP-is-equiv f f' g F)
    ∙iff fibrewise↔total-is-equiv
    ∙iff (postcomp-Π-↔ λ q → src↔tgt-is-equiv←Arrow-equiv (hom q) iff⁻¹)
    where
    hom
      : (q : C → Q)
      → Arrow-equiv
          {A = Coslice-map f' (q ∘ g)}
          {B = Coslice-map f (q ∘ g)}
          {X = Σ[ x ∶ (A' → Q) ] (precomp Q g q ＝ precomp Q f' x)}
          {Y = Σ[ x ∶ (A → Q) ] (precomp Q g q ＝ precomp Q f x)}
          (Coslice-map-precompose (q ∘ g) F)
          (λ G
          → precomp Q (F .fst) (G .fst)
          , ap id (G .snd) ∙ funext→ (ap (G .fst) ∘ sym ∘ F .snd))
    hom q
      = mk-arr-equiv
          (Σ-snd-≃ λ _ → funext≃ e⁻¹ ∙e sym≃)
          (Σ-snd-≃ λ _ → funext≃ e⁻¹ ∙e sym≃)
          (λ where
            (x , p) →
              Σ-path→
                ( refl
                , sym
                  ( ap₂
                    (_∙_)
                    (ap-id (sym (funext→ p)))
                    (ap funext→ (funext→ λ b → ap-sym x (F .snd b)) ∙ funext-sym _)
                  ∙ sym (∙-symsym _ (funext→ p))
                  ∙ ap sym (sym (funext-∙ _ _)))))
}
}
