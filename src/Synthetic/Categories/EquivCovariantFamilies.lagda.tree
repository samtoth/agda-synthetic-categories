\title{Detecting equivalences between covariant type families}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

import Synthetic.Cubes

module Synthetic.Categories.EquivCovariantFamilies
  {@♭ 𝓘} (@♭ Δ¹ : Type 𝓘) (@♭ I : Lattice Δ¹)
  (open Lattice I renaming (0l to i0; 1l to i1))
  (open Synthetic.Cubes Δ¹ i0 i1)
  where

import Algebra.Lattice.Instances.Polynomial as Poly
open Poly hiding (Δ²)
private Δ² = Poly.Δ² I
open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Cohesion.Flat
open import Modalities.Cohesion.FlatDiscrete
open import Modalities.Cohesion.Connectivity
open import Modalities.Cohesion.Continuity
open import Modalities.Cohesion.FlatLex
open import Modalities.Cohesion.LiftingSquares
open import Modalities.Cohesion.FlatConnectedMaps

open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.Instances.Truncation
open import Modalities.ConnectedMaps

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.ArrowRetracts
open import Core.Orthogonal
open import Core.OrthogonalClosure

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Horns Δ¹ I
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Triangles Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
}
}

\subtree[stt-00V6]{
\title{The point inclusion of #{0} into the #{n}-cube is left anodyne}
\taxon{Lemma}

\agda{
□-0-is-left-anodyne : ∀ {m : ℕ} → is-left-anodyne (point (□-0 {m}))
□-0-is-left-anodyne {zero} r _ = equiv⊥ lift-is-equiv r
□-0-is-left-anodyne {suc zero} r 0r = 0r
□-0-is-left-anodyne {suc (suc m)}
  = is-anodyne←equiv
      (point □-0 ×₁ point i0) (point □-0)
      (mk-arr-equiv (sing≃𝟙 single!) id≃ ~refl)
      (point i0)
      (λ r 0r → left-orthogonal-× (point □-0) (point i0) r
        (□-0-is-left-anodyne {suc m} r 0r) 0r)
}
}

\subtree[tot-6792]{
\taxon{Lemma}
\date{2026-09-09}

\p{If the inclusion #{∂Δ¹ \to \Delta^1} is #{\flat}-connected, then
so is the inclusion of points #{3 \to \Delta^2}.}

\proof{
We exhibit the map #{3 \to \Delta^2} as a retract of the product of two copies
of #{∂Δ¹ \to Δ¹}.
}

\agda{
Fin3-retract-4 : retract (Fin 3) (∂Δ¹ × ∂Δ¹)
Fin3-retract-4 .fst fzero = (∂Δ¹-0 , ∂Δ¹-0)
Fin3-retract-4 .fst (fsuc fzero) = (∂Δ¹-1 , ∂Δ¹-0)
Fin3-retract-4 .fst (fsuc (fsuc fzero)) = (∂Δ¹-1 , ∂Δ¹-1)
Fin3-retract-4 .snd .fst (∂Δ¹-1 , ∂Δ¹-1) = 2
Fin3-retract-4 .snd .fst (∂Δ¹-1 , ∂Δ¹-0) = 1
Fin3-retract-4 .snd .fst (∂Δ¹-0 , ∂Δ¹-1) = 2
Fin3-retract-4 .snd .fst (∂Δ¹-0 , ∂Δ¹-0) = 0
Fin3-retract-4 .snd .snd fzero = refl
Fin3-retract-4 .snd .snd (fsuc fzero) = refl
Fin3-retract-4 .snd .snd (fsuc (fsuc fzero)) = refl

retract-Δ²-points-∂Δ¹×∂Δ¹
  : Arrow-retract (Δ²-point-incl) (∂Δ¹-incl ×₁ ∂Δ¹-incl)
retract-Δ²-points-∂Δ¹×∂Δ¹ = mk-arr-retract
  Fin3-retract-4 Δ²-retract-Δ¹×Δ¹
  (λ { fzero → refl
     ; (fsuc fzero) → refl
     ; (fsuc (fsuc fzero)) → refl })
  (λ { (∂Δ¹-1 , ∂Δ¹-1) → Δ²-ext (1-coinit  , refl)
     ; (∂Δ¹-1 , ∂Δ¹-0) → Δ²-ext (1-coinit' , refl)
     ; (∂Δ¹-0 , ∂Δ¹-1) → Δ²-ext (1-coinit  , refl)
     ; (∂Δ¹-0 , ∂Δ¹-0) → Δ²-ext (0-bottom  , refl) })
  (λ _ → Δ²-is-set _ _ _ _)

Δ²-points-♭-connected
  : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl
  → is-♭-connected (Truncation-gRSubU -1) Δ²-point-incl
Δ²-points-♭-connected ∂Δ¹-♭-connected
  = is-♭-connected←retraction-arrow-map (Truncation-gRSubU -1)
      retract-Δ²-points-∂Δ¹×∂Δ¹
      (×₁-is-♭-connected (Truncation-gRSubU -1)
        ∂Δ¹-♭-connected ∂Δ¹-♭-connected)
}
}

\subtree[stt-00UT]{
\taxon{Corollary}

\p{As a special case of \ref{stt-00V7}, we note the following.
If [cubes separate](stt-00J7) and crisp elements of #{\Delta^1} are covered by the booleans,
then a crisp transformation between covariant crisp type families #{F, G} over
#{B \times \Delta} is a fibrewise equivalence iff it is a flat equivalence at
#{(b , 0)} and #{(b, 1)} for crisp elements #{b : B}.}

\agda{
module _
  (@♭ cubes-separate : family-separates □^_)
  (@♭ ∂Δ¹-♭-connected : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl)
  (open gRSubUConnectedCharacterisation (Truncation-gRSubU -1))
  where
  ∂Δ¹-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ¹ → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : ∂Δ¹) → is-♭-equiv (α (b , ∂Δ¹-incl x)))
      → is-fibrewise-equiv α
  ∂Δ¹-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-family-separates
        (point i0)
        □^_
        (cubes-separate) □-0 □-0-is-left-anodyne
        (F .fst , is-left-family←is-covariant (F .fst) (F .snd))
        (G .fst , is-left-family←is-covariant (G .fst) (G .snd))
        α
        (λ {(b , i)
         → up-♭-surjection←up-♭-connected-map
             (up-connected-map←is-connected-map _ ∂Δ¹-♭-connected)
             (λ x
               → ( is-♭-equiv (α (b , x))
                 , is-equiv-is-prop))
             (αeq b)
             i})
}

\p{We may also consider the analogous result for the 2-simplex, but this time
making use of \ref{tot-6792} which says that the 3 element type covers the crisp
elements of #{Δ²}.}

\agda{
  points-Δ²-cov-Nat-is-equiv
    : ∀ {@♭ 𝓤 𝓥} {@♭ B : Type 𝓤}
        (@♭ F G : Σ (B × Δ² → Type 𝓥) is-covariant)
        (@♭ α : fibrewise-map (F .fst) (G .fst))
      → @♭ (∀ (@♭ b : B) (@♭ x : Fin 3) → is-♭-equiv (α (b , Δ²-point-incl x)))
      → is-fibrewise-equiv α
  points-Δ²-cov-Nat-is-equiv F G α αeq
    = is-fibrewise-equiv←anodyne-family-separates
        (point i0)
        □^_
        (cubes-separate) □-0 □-0-is-left-anodyne
        (F .fst , is-left-family↔is-covariant (F .fst) .snd (F .snd))
        (G .fst , is-left-family↔is-covariant (G .fst) .snd (G .snd))
        α
        (λ {(b , i)
         → up-♭-surjection←up-♭-connected-map
             (up-connected-map←is-connected-map _
               (Δ²-points-♭-connected ∂Δ¹-♭-connected))
             (λ x → (is-♭-equiv (α (b , x)) , is-equiv-is-prop))
             (αeq b)
             i})
}
}
