\agda{
total-map-fst
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓥} (f : A' → A)
    → {B : A → Type 𝓦} → Σ A' (B ∘ f) → Σ A B
total-map-fst f (a , b) = (f a , b)

total-is-equiv←fst-is-equiv
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓥} {B : A → Type 𝓦}
    {f : A' → A} → is-equiv f → is-equiv (total-map-fst f {B})
total-is-equiv←fst-is-equiv {B = B} {f} feq = is-equiv←qinv qusi where
  open is-equiv feq

  lem : ∀ {a} {b : (B ∘ f) a} →
      tr (B ∘ f) (η a) (tr B (sym (ε (f a))) b) ＝ b
  lem {a} {b} = tr (B ∘ f) (η a) _   ＝⟨ tr∘ B f (η a) ⟩
                tr B (ap f (η a)) _   ＝⟨ ap (λ p → tr B p (tr B (sym (ε (f a))) b))
                                             (coherent a) ⟩
                tr B (ε (f a)) _      ＝⟨ tr∘tr-sym' {P = B} (ε (f a)) b ⟩
                b ∎

  qusi : quasi-inv (total-map-fst f)
  qusi .fst (a , b) = (bwd a , tr B (sym (ε a)) b)
  qusi .snd .fst (a , b) = Σ-path→ (η a ,  lem)
  qusi .snd .snd (a , b) = Σ-path→ (ε a ,  tr∘tr-sym' (ε a) b)

Σ-fst-≃
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓥} {B : A → Type 𝓦}
    → ((mk≃ f _) : A' ≃ A) → Σ A' (B ∘ f) ≃ Σ A B
Σ-fst-≃ (mk≃ f feq)
  = mk≃ (total-map-fst f) (total-is-equiv←fst-is-equiv feq)

Σ-fst-≃-bwd⁻¹
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓥} {B : A → Type 𝓦}
    → (e : A ≃ A') → Σ A B ≃ Σ A' (B ∘ _≃_.bwd e)
Σ-fst-≃-bwd⁻¹ {B = B} (mk≃ f e)
  = Σ-snd-≃ (λ a → tr≃ B (sym (is-equiv.η e a)))
  ∙e Σ-fst-≃ {B = B ∘ is-equiv.bwd e} (mk≃ f e)

Σ-fst-≃-bwd
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {A' : Type 𝓥} {B : A → Type 𝓦}
    → (e : A ≃ A') → Σ A' (B ∘ _≃_.bwd e) ≃ Σ A B
Σ-fst-≃-bwd e = Σ-fst-≃-bwd⁻¹ e e⁻¹

Σ-assoc
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : A → Type 𝓥} {C : (a : A) → B a → Type 𝓦}
    → Σ (Σ A B) (λ x → C (fst x) (snd x)) ≃ Σ A λ a → Σ (B a) λ b → C a b
Σ-assoc {A = A} {B} {C} = mk≃ fwd (mk-eqv qinv coh) where
  fwd : Σ (Σ A B) (λ x → C (fst x) (snd x)) → Σ A (λ a → Σ (B a) (C a))
  fwd ((a , b) , c) = (a , (b , c))

  qinv : quasi-inv fwd
  qinv .fst (a , b , c) = (a , b) , c
  qinv .snd .fst = ~refl
  qinv .snd .snd = ~refl

  coh : qinv-coh qinv
  coh = ~refl

Σ-𝟙 : ∀ {𝓤} {B : 𝟙 → Type 𝓤} → Σ 𝟙 B ≃ B tt
Σ-𝟙 = mk≃ snd (mk-eqv qinv coh) where
  qinv : quasi-inv snd
  qinv .fst = (_ ,_)
  qinv .snd .fst = ~refl
  qinv .snd .snd = ~refl

  coh : qinv-coh qinv
  coh = ~refl

Σ-singl
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥}
    → is-singleton A
    → (x : A) -- todo use @default to make it use singleton if not given
    → Σ[ a ∶ A ] B a
    ≃ B x
Σ-singl {A = A} {B} sa x = mk≃ fwd (is-equiv←qinv qinv) where
  path-to-x : (a : A) → a ＝ x
  path-to-x a = sym (sa .central a) ∙ sa .central x

  fwd : Σ A B → B x
  fwd (a , b) = tr B (path-to-x a) b

  qinv : quasi-inv fwd
  qinv .fst b = (x , b)
  qinv .snd .fst (a , b)
    = Σ-path→ (sym (path-to-x a) , tr∘tr-sym (path-to-x a) b)
  qinv .snd .snd b
    = sym (tr-refl (path-to-x x) b (∙-sym' (sa .central x)))


Σ-＝singl
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {a' : A} {B : (a : A) → a ＝ a' → Type 𝓥}
    → Σ A (λ a → Σ (a ＝ a') λ p → B a p) ≃ B a' refl
Σ-＝singl {A = A} {a'} {B} = mk≃ fwd (mk-eqv qinv coh) where
  fwd : Σ A (λ a → Σ (a ＝ a') (B a)) → B a' refl
  fwd (.a' , refl , ba) = ba

  qinv : quasi-inv fwd
  qinv .fst ba = (a' , refl , ba)
  qinv .snd .fst (.a' , refl , ba) = refl
  qinv .snd .snd = ~refl

  coh : qinv-coh qinv
  coh (.a' , refl , ba) = refl


Σ-＝singl'
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {a' : A} {B : (a : A) → a' ＝ a → Type 𝓥}
    → Σ A (λ a → Σ (a' ＝ a) λ p → B a p) ≃ B a' refl
Σ-＝singl' {A = A} {a'} {B} = mk≃ fwd (mk-eqv qinv coh) where
  fwd : Σ A (λ a → Σ (a' ＝ a) (B a)) → B a' refl
  fwd (.a' , refl , ba) = ba

  qinv : quasi-inv fwd
  qinv .fst ba = a' , refl , ba
  qinv .snd .fst (.a' , refl , ba) = refl
  qinv .snd .snd _ = refl

  coh : qinv-coh qinv
  coh (.a' , refl , ba) = refl


Σ-comm
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : A → B → Type 𝓦}
    → (Σ A λ a → Σ B (C a)) ≃ (Σ B λ b → Σ A λ a → C a b)
Σ-comm {A = A} {B} {C} = mk≃ fwd (mk-eqv qinv coh) where
  fwd : Σ A (λ a → Σ B (C a)) → Σ B (λ b → Σ A (λ a → C a b))
  fwd (a , b , c) = b , a , c

  qinv : quasi-inv fwd
  qinv .fst (b , a , c) = a , b , c
  qinv .snd .fst _ = refl
  qinv .snd .snd _ = refl

  coh : qinv-coh qinv
  coh _ = refl

×-∅ : ∀ {𝓤} {A : Type 𝓤} → ∅ × A ≃ ∅
×-∅ = mk≃ fst (mk-eqv qinv coh) where
  qinv : quasi-inv fst
  qinv .fst ()
  qinv .snd .fst ()
  qinv .snd .snd ()

  coh : qinv-coh qinv
  coh ()

×-swap→ : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} → A × B → B × A
×-swap→ (a , b) = b , a

×-swap
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A × B) ≃ (B × A)
×-swap {A = A} {B} = mk≃ ×-swap→ (mk-eqv qinv coh)  where

  qinv : quasi-inv ×-swap→
  qinv .fst (b , a) = (a , b)
  qinv .snd .fst (a , b) = refl
  qinv .snd .snd (b , a) = refl

  coh : qinv-coh qinv
  coh _ = refl

×-assoc
  : ∀ {𝓤 𝓥 𝓦}
      {A : Type 𝓤}
      {B : Type 𝓥}
      {C : Type 𝓦}
    → (A × B) × C ≃ A × (B × C)
×-assoc = Σ-assoc

Σ-tr
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : A → B → Type 𝓦}
      {a b : A} {p : a ＝ b} {b : B} {c : C a b}
    → (tr (λ a → Σ B (C a)) p (b , c)) ＝ (b , tr (λ a → C a b) p c)
Σ-tr {p = refl} = refl

module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : A → Type 𝓥} {C : A → Type 𝓦}
  {D : (a : A) → B a → C a → Type 𝓜}
  where

  Σ-interchange
    : (Σ[ (a , b) ∶ Σ A B ] Σ (C a) (D a b))
    ≃ (Σ[ (a , c) ∶ Σ A C ] Σ[ b ∶ B a ] D a b c)
  Σ-interchange = mk≃ fwd (mk-eqv qinv coh) where
    fwd
      : (Σ[ (a , b) ∶ Σ A B ] Σ (C a) (D a b))
      → (Σ[ (a , c) ∶ Σ A C ] Σ[ b ∶ B a ] D a b c)
    fwd ((a , b) , (c , d)) = ((a , c) , (b , d))

    qinv : quasi-inv fwd
    qinv .fst ((a , c) , (b , d)) = ((a , b) , (c , d))
    qinv .snd .fst = ~refl
    qinv .snd .snd = ~refl

    coh : qinv-coh qinv
    coh = ~refl

}

\subtree[stt-002T]{
\taxon{Theorem}
\title{Sums of singleton}

\p{Given a family of singleton types #{P \colon A \to \UU}, the projection from the straightening is an equivalence.}
\proof{
\citet{4.9.3}{HoTT}
\p{The fibre of the projection #{\pi : (\Sigma1{x : A}{P(x)}) \to A} at some #{x : A} is equivalent to #{P(x)}. By assumption
we have the each #{P(x)} is singleton, and therefore so is each fibre of #{\pi}, thus it is an equivalence. }

\agda{
fibre-straighten
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : A → Type 𝓥)
    → ∀ x → fibre (fst {B = P}) x ≃ P x
fibre-straighten P x = mk≃ fwd (mk-eqv qinv coh) where
  fwd : fibre fst x → P x
  fwd ((a , p) , refl) = p

  qinv : quasi-inv fwd
  qinv .fst p = (x , p) , refl
  qinv .snd .fst (_ , refl) = refl
  qinv .snd .snd _ = refl

  coh : qinv-coh qinv
  coh (_ , refl) = refl

singleton-fst-is-equiv
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
    → (∀ x → is-singleton (P x))
    → is-equiv (fst {B = P})
singleton-fst-is-equiv {P = P} sngl
  = is-equiv←has-singleton-fibres λ b
    → is-single←equiv⁻¹ (fibre-straighten P b) (sngl b)

fst-is-equiv←is-singleton
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
    → is-equiv (fst {B = P})
    → (∀ x → is-singleton (P x))
fst-is-equiv←is-singleton {P = P} fe x
  = is-single←equiv (fibre-straighten P x)
      (has-singleton-fibres←is-equiv fe x)

Σ-singleton
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {P : A → Type 𝓥}
    → (∀ x → is-singleton (P x))
    → Σ A P ≃ A
Σ-singleton {P = P} sngl
  = mk≃ fst (singleton-fst-is-equiv sngl)
}
}
}

\subtree[stt-012J]{
\title{Products of equivalences}
\taxon{Lemma}
\author{samueltoth}
\contributor{fredrikbakke}

\p{The product of two [equivalences](stt-001U) is an equivalence.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} {D : Type 𝓜}
  where

  ×₁-is-equiv
    : {f : A → B} {g : C → D}
    → is-equiv f → is-equiv g
    → is-equiv (f ×₁ g)
  ×₁-is-equiv {f = f} {g} feq geq = mk-eqv qiso coh where
    qiso : quasi-inv (f ×₁ g)
    qiso .fst (b , d) = (is-equiv.bwd feq b , is-equiv.bwd geq d)
    qiso .snd .fst (a , c) = ×-path→ (is-equiv.η feq a , is-equiv.η geq c)
    qiso .snd .snd (b , d) = ×-path→ (is-equiv.ε feq b , is-equiv.ε geq d)

    coh : qinv-coh qiso
    coh (a , c)
      = ap-×₁-×-path (is-equiv.η feq a) (is-equiv.η geq c)
      ∙ ap ×-path→ (×-path→ (is-equiv.coherent feq a , is-equiv.coherent geq c))

  _×≃_ : A ≃ B → C ≃ D → (A × C) ≃ (B × D)
  (mk≃ f ef) ×≃ (mk≃ g eg) = mk≃ (f ×₁ g) (×₁-is-equiv ef eg)
}
}
