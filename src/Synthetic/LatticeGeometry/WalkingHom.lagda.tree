\title{The walking morphism}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}

\p{This module is about the properties of the interval #{Δ¹} as a category and
as a representing object for morphisms in a category.}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.LatticeGeometry.WalkingHom
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Ergonomics.Auto

open import Synthetic.Hom Δ¹ i0 i1
}
}

\subtree[stt-00X1]{
\title{The objects of #{Δ¹}}

\p{The endpoints #{0} and #{1} are objects of #{Δ¹}, we give a [number](stt-00NP)
instance so that we can use numeral notation. }

\agda{
Δ¹-point-incl : Fin 2 → Δ¹
Δ¹-point-incl 0ᶠ = i0
Δ¹-point-incl 1ᶠ = i1
Δ¹-point-incl (fsuc (fsuc ()))

instance
  Number-Δ¹ : Number Δ¹
  Number-Δ¹ .Number.Constraint m = m <ℕ 2
  Number-Δ¹ .Number.fromNat n = Δ¹-point-incl (Fin←ℕ n 2 auto!)
}
}

\subtree[stt-00UK]{
\title{Morphisms in #{Δ¹}}
\taxon{Construction}

\p{There is a canonical morphism #{\Hom_{\Delta^1}(0,1)} given by the identity
function.}

\agda{
0≤1 : 𝐇om Δ¹ 0 1
0≤1 .𝐡om = id
0≤1 .𝐡om0 = refl
0≤1 .𝐡om1 = refl
}

\p{More generally, for any #{i \le j}, we may construct a morphism #{\Hom(i,j)}. This
morphism is the identity/constant morphism when #{i = j}, and agrees with the
canonical morphism when #{i = 0} and #{j = 1}.}

\agda{
Δ¹-𝐡om←≤ : ∀ {i j} → i ≤ j → 𝐇om Δ¹ i j
Δ¹-𝐡om←≤ {i} {j} p .𝐡om l = (l ∨ i) ∧ (i ∨ j)
Δ¹-𝐡om←≤ p .𝐡om0 = ap₂ (_∧_) 0-bottom' (≤-max p) ∙ p
Δ¹-𝐡om←≤ p .𝐡om1 = ap₂ (_∧_) 1-coinit' (≤-max p) ∙ 1-top'

Δ¹-𝐡om-≤-refl : ∀ {i} (p : i ≤ i) → Δ¹-𝐡om←≤ p ＝ idH i
Δ¹-𝐡om-≤-refl {i} p
  = 𝐇om-ext→ ( (λ a → ap ((a ∨ i) ∧_) ∨-idem ∙ ∨-∧-abs') , prop! , prop!)

Δ¹-𝐡om-0≤1 : (p : 0 ≤ 1) → Δ¹-𝐡om←≤ p ＝ 0≤1
Δ¹-𝐡om-0≤1 p
  = 𝐇om-ext→ ( (λ a → ap₂ (_∧_) 0-bottom 1-coinit ∙ 1-top) , prop! , prop!)
}

\p{We also give a bespoke morphism #{\Hom(0,i)} for any #{i} which is given by a
simpler underlying map. This morphism is (propositionally) equal to the one induced
by #{0 \le i}.}

\agda{
0≤i : ∀ i → 𝐇om Δ¹ 0 i
0≤i i .𝐡om j = j ∧ i
0≤i i .𝐡om0 = 0-init
0≤i i .𝐡om1 = 1-top'

0≤i-at-0 : 0≤i 0 ＝ idH 0
0≤i-at-0 = 𝐇om-ext→ ((λ a → 0-init') , prop! , prop!)
}

\p{There is also a bespoke morphism #{\Hom(i,1)} for every #{i}.}

\agda{
i≤1 : ∀ i → 𝐇om Δ¹ i 1
i≤1 i .𝐡om j = j ∨ i
i≤1 i .𝐡om0 = 0-bottom'
i≤1 i .𝐡om1 = 1-coinit'

i≤1-at-1 : i≤1 1 ＝ idH 1
i≤1-at-1 = 𝐇om-ext→ ((λ a → 1-coinit) , prop! , prop!)
}
}

\subtree[stt-00UH]{
\title{Characterising all morphisms of #{Δ¹}}
\taxon{Lemma}

\p{Under the assumption that #{I[x]} is [quasicoherent](stt-00TA), the [map](stt-00UK)
#{(i \le j) \to \Hom(i,j)} is an equivalence for all #{i} and #{j}.}

\todo{
This remains to be formalised.
}
}
