\subtree[tot-65RY]{
\title{The free covariant family}
\author{samueltoth}
\date{2026-09-24}
\taxon{Definition}

\agda{
FreeCov : ∀ {𝓤 𝓥} {A : Type 𝓤} {E : Type 𝓥} → (E → A) → A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
FreeCov p a = Δ¹Disc.○ (p ↓ point a)
}
}

\subtree[tot-EN21]{
\title{The free covariant family over a Segal type is covariant}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\p{If #{B} is a [Segal]() type, then the free covariant family on any map
#{p \colon E \to B} is a covariant type family.}

\proof{
\p{We use the [unital transport criteria], where the transport is given by
precomposition in the Segal type.}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-free
    : ∀ {a b : B} → Hom B a b → p ↓ point a → p ↓ point b
  transport-free f = total-map (λ c → total-map (λ _ → f ∘[ 𝐵 ]_))

  ○transport-free
    : ∀ {a b : B} → Hom B a b → FreeCov p a → FreeCov p b
  ○transport-free f = Δ¹Disc.○₁ (transport-free f)

  transport-unital
    : ∀ {b : B} → transport-free (idH b) ~ id
  transport-unital x = Σ-path→ (refl , (Σ-path→ (refl , ∘[ 𝐵 ]-right-unit)))

  ○transport-unital
    : ∀ (b : B) → ○transport-free (idH b) ~ id
  ○transport-unital _ = Δ¹Disc.○-~ transport-unital ∙h Δ¹Disc.○₁-id

  FreeCov-is-covariant : is-covariant (FreeCov p)
  FreeCov-is-covariant
    = is-covariant←cov-unital-transport (λ b → Δ¹Disc.○∈S {A = p ↓ point b})
        (○transport-free , ○transport-unital)
}
}

\subtree[tot-0913]{
\title{The free covariant family gives a left anodyne-left fibration factorision}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\p{If #{B} is a [Segal]() type and #{p} any map #{E \to B}, then the canonical lift
of #{|| p \down - ||} along #{p} is a left-anodyne map, and induces a factorisation
of #{p} into a left-anodyne map followed by a left fibration.}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  FreeCov-η : (e : E) → FreeCov p (p e)
  FreeCov-η e = Δ¹Disc.η (e , (_ , idH (p e)))

  FreeCov-η-total : E → Σ B (FreeCov p)
  FreeCov-η-total e = (p e , FreeCov-η e)

  FreeCov-η-is-left-anodyne'
    : ∀ {𝓦 𝓜} {X : Type 𝓦} (Y : X → Type 𝓜) (Y-cov : is-covariant Y)
      → are-orthogonal-fam FreeCov-η-total Y
  FreeCov-η-is-left-anodyne' Y Y-cov g
    = src-is-equiv←Arrow-equiv
        aeq
        (postcomp-Π-equiv
          (λ {e}
           → ev-init-covariant-is-equiv
               (coslice-init 𝐵 (p e))
               (covariant-base-change {P = Y}
                 (g ∘ total-map (λ _ x → Δ¹Disc.η (e , tt , x tt))) Y-cov)))
    where

    eqv : (Σ[ e ∶ E ] Coslice B (point (p e))) ≃ (Σ[ b ∶ B ] (p ↓ point b))
    eqv ._≃_.fwd (e , b , h) = (b , e , (tt , h tt))
    eqv ._≃_.fwd-is-equiv .is-equiv.qinv .fst (b , e , (tt , h)) = (e , b , const h)
    eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd = (~refl , ~refl)
    eqv ._≃_.fwd-is-equiv .is-equiv.coherent = ~refl

    aeq
      : Arrow-equiv
          (precomp-Π (Y ∘ g) (λ e → (p e , FreeCov-η e)))
          (postcomp-Π
            λ (e : E)
            → evᵈ:
                (λ (x : Coslice B (point (p e))) → Y (g (x .fst , Δ¹Disc.η (e , _ , x .snd tt))))
                (p e , λ _ → idH (p e)))
    aeq
      = mk-arr-equiv
          ( curry≃
          ∙e postcomp-Π-≃
               (λ b → Δ¹Disc.○-UPᵈ≃ {P = Y ∘ g ∘ (b ,_)}
                 (is-Δ¹-discrete-family←is-covariant
                   (covariant-base-change {P = Y} (g ∘ (b ,_)) Y-cov)))
          ∙e (uncurry≃ ∙e precomp-Π-≃ _ eqv ∙e curry≃))
          id≃
          ~refl

  FreeCov-η-is-left-anodyne : is-left-anodyne FreeCov-η-total
  FreeCov-η-is-left-anodyne g gleft
    = are-orthogonal←are-orthogonal-fibre
        (FreeCov-η-is-left-anodyne' (fibre g)
          (is-covariant←is-left-family (fibre g)
            (are-orthogonal-fibre←are-orthogonal gleft)))
}
}

\subtree[tot-092B]{
\title{A map into a Segal type is left anodyne iff the free covariant family is an equivalence}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  opaque
    FreeCov-is-equiv←is-left-anodyne
      :  is-left-anodyne p → is-equiv (fst: FreeCov p)
    FreeCov-is-equiv←is-left-anodyne pl
      = is-equiv←self-orthogonal
          (is-anodyne-right-cancel (point i0)
            pl
            (FreeCov-η-is-left-anodyne 𝐵 p)
            fst
            (is-left-fibration←is-covariant (FreeCov p) (FreeCov-is-covariant 𝐵 p)))

    is-left-anodyne←FreeCov-is-equiv
      : is-equiv (fst: FreeCov p) → is-left-anodyne p
    is-left-anodyne←FreeCov-is-equiv fe
      = is-anodyne-∘ {f = fst} (point i0)
          (λ g _ → equiv⊥ fe g)
          (FreeCov-η-is-left-anodyne 𝐵 p)
}
}
