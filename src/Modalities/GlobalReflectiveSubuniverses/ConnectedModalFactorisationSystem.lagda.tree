\title{The connected-modal factorisation system of #{Σ}-closed global reflective subuniverses}
\author{fredrikbakke}
\date{2026-09-12}
\taxon{Module}
\import{stt-macros}

\agda{
module Modalities.GlobalReflectiveSubuniverses.ConnectedModalFactorisationSystem where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Core.Orthogonal
open import Modalities.ReflectiveSubuniverses
open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.ConnectedMaps
open import Modalities.ModalMaps
open import Modalities.Factorisations
open import Modalities.WideSubcategoriesTypes
open import Modalities.GlobalOrthogonalFactorisationSystems
open import Modalities.ReflectiveSubuniverses.ConnectedModalFactorisationSystem
}
}

\subtree[bak-9690]{
\title{The connected-modal orthogonal factorisation system}
\author{fredrikbakke}
\taxon{Construction}
\date{2026-09-12}

\agda{
module GlobalReflectiveFactorisationSystem
  {α} (RS : gRSubU α)
  (open gRSubU RS)
  (SΣ : is-globally-Σ-closed GS)
  (open gReflectiveClosure RS)
  where

  Ll : gWideSubcatType (_⊔_)
  Ll .gWideSubcatType.K .Subtype.family
    = is-connected-map RS
  Ll .gWideSubcatType.K .Subtype.family-is-subtype _
    = Π-is-prop (λ _ → is-single-is-prop)
  Ll .gWideSubcatType.≃∈K e
    = is-connected-map←is-equiv RS (_≃_.fwd-is-equiv e)
  Ll .gWideSubcatType._∘∈K_ gc fc
    = is-connected-map-∘ RS fc gc

  Rr : gWideSubcatType (λ 𝓤 𝓥 → 𝓥 ⊔ α (𝓤 ⊔ 𝓥))
  Rr .gWideSubcatType.K .Subtype.family = is-modal-map GS
  Rr .gWideSubcatType.K .Subtype.family-is-subtype _
    = Π-is-prop (λ _ → ∈-is-prop S _)
  Rr .gWideSubcatType.≃∈K e = is-modal-map←is-equiv RS (e ._≃_.fwd-is-equiv)
  Rr .gWideSubcatType._∘∈K_ gm fm = is-modal-map-∘ {GS = GS} SΣ fm gm

  module _
    {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    (open ConnectedModalFactorisation (is-reflective←gRSubU RS) SΣ f)
    where

    factorisation : gFactorisation (_⊔_) Ll Rr f
    factorisation
      = mk-factorisation Im l l-is-connected r r-is-modal ~refl

  ofs : gOFS (_⊔_) (λ 𝓤 𝓥 → 𝓥 ⊔ α (𝓤 ⊔ 𝓥)) (_⊔_)
  ofs
    = gOFS←unique-lifts Ll Rr factorisation
        ( λ fc gm
          → unique-lifts←are-orthogonal
              (gRSubUConnectedCharacterisation.connected⊥modal RS fc gm))

open GlobalReflectiveFactorisationSystem public using () renaming
  ( ofs to gOFS←Σ-closed-gRSubU)
}
}
