\subtree[bar-D006]{
\title{Disjunctivity at crisp elements}
\taxon{Lemma}
\author{reidbarton}
\contributor{fredrikbakke}

\p{
If #{i\,j :^{\flat} \II} satisfy #{(i\lor j) = 1} then either #{i = 1} or #{j = 1}.
Moreover, by directedness this property transfers along the outgoing edges of an
initial object.
}

\agda{
fam-disjunctive←∨=1-crisp : (@♭ ij : Δ¹ × Δ¹) → ∨=1 ij → fam-disjunctive ij
fam-disjunctive←∨=1-crisp (i , j)
  = ♭Δ¹-ind
      ( λ i
        → (∨=1 (i , j) → fam-disjunctive (i , j))
        , →-is-prop fam-disjunctive-is-prop)
      (λ h → ι₂ (sym (∨-comm ∙ 0-bottom) ∙ h))
      (λ _ → ι₁ refl)
      (i)

fam-disjunctive←∨=1-initial
  : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤}
      (@♭ a : A) (@♭ h : (x : A) → Hom A a x)
      (@♭ f : A → Δ¹ × Δ¹)
    → ((x : A) → ∨=1 (f x)) → ((x : A) → fam-disjunctive (f x))
fam-disjunctive←∨=1-initial a h f hf x
  = fam-disjunctive-is-mono
      ( ≤←Hom Δ¹-directed (ap-hom (fst ∘ f) (h x))
      , ≤←Hom Δ¹-directed (ap-hom (snd ∘ f) (h x)))
      (fam-disjunctive←∨=1-crisp (f a) (hf a))
}
}

\subtree[bar-8029]{
\title{The inclusion #{\Sigma_{(i\,j : \II)}((i = 1) \lor (j = 1)) \to \Sigma_{(i\,j : \II)}((i \lor j) = 1)} has a flat-section}
\taxon{Lemma}
\author{reidbarton}
\contributor{fredrikbakke}

\agda{
♭-postcomp-Λ[2,2]-incl-section
  : ∀ {@♭ 𝓤} {@♭ X : Type-With-Initial-Obj' 𝓤}
    → section (♭-map (postcomp (X .fst) Λ[2,2]-incl))
♭-postcomp-Λ[2,2]-incl-section {X = (A , a , h , ha)} .fst (mod♭ f)
  = mod♭ (λ x → f x .fst , fam-disjunctive←∨=1-initial a h (fst ∘ f) (snd ∘ f) x)

♭-postcomp-Λ[2,2]-incl-section .snd (mod♭ f)
  = mapply♭ (mod♭ (funext→ (λ x → Σ-path→ (refl , ∨=1-is-prop _ _))))
}
}

\subtree[bar-0C79]{
\title{The disjunctive property}
\taxon{Theorem}
\author{reidbarton}
\contributor{fredrikbakke}

\agda{
module _
  (@♭ types-with-initial-object-separate'
    : large-family-separates (λ 𝓤 → Type-With-Initial-Obj' 𝓤) fst)
  where

  Λ[2,2]-incl-is-equiv : is-equiv Λ[2,2]-incl
  Λ[2,2]-incl-is-equiv
    = large-family-separates-with-𝟙
        types-with-initial-object-separate'
        {is = (𝟙 , tt , (λ _ → idH tt) , refl)}
        (single!)
        (mk-arrow Λ[2,2]-incl)
        (λ {i = X}
         → is-equiv←section←injective
            (♭-map-is-injective
              (λ h → funext→ (Λ[2,2]-incl-is-embedding ◂emb happly h)))
            (♭-postcomp-Λ[2,2]-incl-section {X = X}))

  disjunctive-property : (i j : Δ¹) → i ∨ j ＝ i1 → (i ＝ i1) * (j ＝ i1)
  disjunctive-property i j h
    = tr fam-disjunctive (ap fst (is-equiv.ε Λ[2,2]-incl-is-equiv ((i , j) , h)))
        (is-equiv.bwd Λ[2,2]-incl-is-equiv ((i , j) , h) .snd)
}
}
