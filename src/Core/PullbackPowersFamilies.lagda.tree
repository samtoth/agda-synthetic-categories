\title{The pullback power of families}
\taxon{Module}
\author{fredrikbakke}
\date{2026-02-23}
\import{stt-macros}

\agda{
module Core.PullbackPowersFamilies where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
}
}

\subtree[stt-00EO]{
\title{Dependent pullback powers}
\taxon{Definition}

\p{
Given a type family #{B \colon A \to \UU} and a dependent type family over #{B},
#{Y \colon \Pi1{a : A}{X(a) \to \UV}}, then the
\em{dependent pullback power family} #{\pulldpow_B Y} is the type family over
#{\Sigma1{i : \Pi1{a : A}{X(a)}}{(\Pi1{a : A}{B(a) \to Y(a, i(a))})}} given by:

##{
(\pulldpow_B Y) (i , j) \defeq (\Pi1{a : A}{\nullhtpy(j(a))})
}

This is precisely the straightening of the
[dependent pullback power of arrows](stt-00EN).
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  (F@(A , B) : Fam 𝓤1 𝓤2)
  (G@(X , Y) : DepFam 𝓤3 𝓤4 F)
  where

  Fam-Π : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Fam-Π = Σ[ i ∶ ((a : A) → X a) ] ((a : A) → B a → Y a (i a))

  base-Π̂ᶠ : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  base-Π̂ᶠ = Fam-Π

  fam-Π̂ᶠ : base-Π̂ᶠ → Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  fam-Π̂ᶠ (i , j)
    = (a : A) → null-homotopy (j a)

  Π̂ᶠ : Fam (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  Π̂ᶠ = (base-Π̂ᶠ , fam-Π̂ᶠ)
}
}

\subtree[stt-00EQ]{
\title{The nondependent pullback power for families}
\taxon{Definition}

\agda{
⟨_,ᶠ_⟩
  : {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  → Fam 𝓤1 𝓤2
  → Fam 𝓤3 𝓤4
  → Fam (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
⟨ F ,ᶠ H ⟩ = Π̂ᶠ F (Fam→DepFam F H)
}
}

\subtree[stt-00ER]{
\title{#{Π̂} preserves equivalences of dependent type families over a fixed base family}
\taxon{Lemma}

\p{
For a fixed base type family #{F}, any equivalence between dependent families over
#{F}, #{G \simeq H} gives an equivalence #{\pulldpow_F G \simeq \pulldpow_F H}.
}
\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 𝓤5 𝓤6 : Level}
  (F@(A , B) : Fam 𝓤1 𝓤2)
  (G@(X , Y) : DepFam 𝓤3 𝓤4 F)
  (H@(U , V) : DepFam 𝓤5 𝓤6 F)
  (e : G ≃ᵈᶠ⟦ F ⟧ H)
  where

  Π̂ᶠ-≃ᶠ-base-over
    : (i : (a : A) → X a)
    → ((a : A) → B a → Y a (i a))
    ≃ ((a : A) → B a → V a (e a .fst ._≃_.fwd (i a)))
  Π̂ᶠ-≃ᶠ-base-over i
    = Π-fam-≃ (λ a → Π-fam-≃ (λ _ → e a .snd (i a)))

  Π̂ᶠ-≃ᶠ-base
    : base-Π̂ᶠ F G ≃ base-Π̂ᶠ F H
  Π̂ᶠ-≃ᶠ-base
    = Σ-snd-≃ Π̂ᶠ-≃ᶠ-base-over
    ∙e Σ-fst-≃ (Π-fam-≃ (λ a → e a .fst))

  Π̂ᶠ-≃ᶠ-family-over
    : (i : (a : A) → X a)
    → (j : (a : A) → B a → Y a (i a))
    → ((a : A) → null-homotopy (j a))
    ≃ ((a : A) → null-homotopy (λ b → e a .snd (i a) ._≃_.fwd (j a b)))
  Π̂ᶠ-≃ᶠ-family-over i j
    = Π-fam-≃ (λ a → null-homotopy-map-codomain-≃ (e a .snd (i a)) (j a))

  Π̂ᶠ-≃ᶠ-family
    : (fp : base-Π̂ᶠ F G)
    → fam-Π̂ᶠ F G fp ≃ fam-Π̂ᶠ F H (Π̂ᶠ-≃ᶠ-base ._≃_.fwd fp)
  Π̂ᶠ-≃ᶠ-family (i , j)
    = Π̂ᶠ-≃ᶠ-family-over i j

  Π̂ᶠ-≃ᶠ : Π̂ᶠ F G ≃ᶠ Π̂ᶠ F H
  Π̂ᶠ-≃ᶠ = (Π̂ᶠ-≃ᶠ-base , Π̂ᶠ-≃ᶠ-family)
}
}
