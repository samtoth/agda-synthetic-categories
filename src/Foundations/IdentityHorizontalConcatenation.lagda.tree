\date{2026-08-28}
\title{Horizontal concatenation and whiskering of identifications}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Foundations.IdentityHorizontalConcatenation where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.Identity
open import Foundations.Functions
open import Foundations.Homotopy
}
}

\subtree[fre-DABA]{
\title{Whiskering identifications by concatenation}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
infixl 16 _◂_ _▸_

_◂_
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
    → (p : a ＝ b) → {q r : b ＝ c} → q ＝ r → p ∙ q ＝ p ∙ r
p ◂ α = ap (p ∙_) α

_▸_
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
    → {p q : a ＝ b} → p ＝ q → (r : b ＝ c) → p ∙ r ＝ q ∙ r
α ▸ r = ap (_∙ r) α

◂-left-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → (refl ◂ α) ∙ ∙-refll q ＝ ∙-refll p ∙ α
◂-left-unit-nat = homotopy-natural~id ∙-refll

◂-left-unit
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → refl ◂ α ＝ α
◂-left-unit α = sym (∙-reflr (refl ◂ α)) ∙ ◂-left-unit-nat α

▸-right-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {a b : A} {p q : a ＝ b} (α : p ＝ q)
    → (α ▸ refl) ∙ ∙-reflr q ＝ ∙-reflr p ∙ α
▸-right-unit-nat = homotopy-natural~id ∙-reflr

▸-right-unit'
  : ∀ {𝓤} {A : Type 𝓤} {a : A} (α : refl: a ＝ refl: a)
    → α ▸ refl ＝ α
▸-right-unit' α = sym (∙-reflr (α ▸ refl)) ∙ ▸-right-unit-nat α

◂▸-∙-interchange
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
      {p q : a ＝ b} {r s : b ＝ c}
    → (α : p ＝ q) (β : r ＝ s)
    → (p ◂ β) ∙ (α ▸ s) ＝ (α ▸ r) ∙ (q ◂ β)
◂▸-∙-interchange α β = sym (homotopy-natural (α ▸_) β)
}
}

\subtree[fre-2F7B]{
\title{Horizontal concatenation of identifications}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
infixr 15 _◾_

_◾_
  : ∀ {𝓤} {A : Type 𝓤} {x y z : A}
      {p q : x ＝ y} {r s : y ＝ z}
    → p ＝ q → r ＝ s → p ∙ r ＝ q ∙ s
_◾_ = ap₂ (_∙_)

◾-left-unit
  : ∀ {𝓤} {A : Type 𝓤} {x y : A} {p q : x ＝ y} (α : p ＝ q)
    → refl ◾ α ＝ α
◾-left-unit α = ap₂-left-refl (_∙_) α ∙ ap-id α

◾-right-unit-nat
  : ∀ {𝓤} {A : Type 𝓤} {x y : A} {p q : x ＝ y} (α : p ＝ q)
    → (α ◾ refl) ∙ ∙-reflr q ＝ ∙-reflr p ∙ α
◾-right-unit-nat {p = refl} refl = refl

◾-right-unit'
  : ∀ {𝓤} {A : Type 𝓤} {a : A} (α : refl: a ＝ refl: a)
    → α ◾ refl ＝ α
◾-right-unit' α
  = sym (∙-reflr (α ◾ refl)) ∙ ◾-right-unit-nat α

◾-∙-interchange
  : ∀ {𝓤} {A : Type 𝓤} {x y z : A}
      {p p' p'' : x ＝ y} {q q' q'' : y ＝ z}
      (α : p ＝ p') (β : q ＝ q') (γ : p' ＝ p'') (δ : q' ＝ q'')
    → (α ◾ β) ∙ (γ ◾ δ) ＝ (α ∙ γ) ◾ (β ∙ δ)
◾-∙-interchange α β γ δ = ap₂-∙ (_∙_) α γ β δ
}
}

\subtree[fre-1523]{
\title{Whiskering is horizontal concatenation}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-08-28}

\agda{
◂=refl◾
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
      (p : a ＝ b) {q r : b ＝ c} (β : q ＝ r)
    → p ◂ β ＝ refl ◾ β
◂=refl◾ p β = sym (ap₂-left-refl (_∙_) β)

▸=◾refl
  : ∀ {𝓤} {A : Type 𝓤} {a b c : A}
      {p q : a ＝ b} (α : p ＝ q) (r : b ＝ c)
    → α ▸ r ＝ α ◾ refl
▸=◾refl α r = sym (ap₂-right-refl (_∙_) α)
}
}
