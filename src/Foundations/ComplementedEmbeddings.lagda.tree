\subtree[bak-DPOG]{
\title{Complemented embeddings}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-17}

\p{
An [embedding](stt-008I) is \em{complemented} if every element in the codomain either
has a preimage or it doesn't. Its \em{complement} consists of the elements which do
not have a preimage.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B) where

  is-complemented-embedding : Type (𝓤 ⊔ 𝓥)
  is-complemented-embedding
    = is-embedding f × ((b : B) → fibre f b ⊎ ¬ (fibre f b))

  map-complement : Type (𝓤 ⊔ 𝓥)
  map-complement = Σ[ b ∶ B ] ¬ (fibre f b)

  complement-decomp-incl : A ⊎ map-complement → B
  complement-decomp-incl = [⊎ f , fst ]

infix 5 _↪ᶜ_
_↪ᶜ_ : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓤 ⊔ 𝓥)
A ↪ᶜ B = Σ[ f ∶ (A → B) ] is-complemented-embedding f
}
}

\agda{
module ComplementedEmbeddingsWithFunExt
  (FE : FunExt-global) (open WithFunExt-global FE)
  where
}

\subtree[bak-BTCJ]{
\title{The image decomposition of a complemented embedding}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-17}

\p{
The image of a [complemented embedding](bak-DPOG) and its complement
form a [coproduct](stt-002Y) decomposition of the codomain.
}

\agda{
  module _
    {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
    (d : is-complemented-embedding f)
    where

    complement-decomp-incl-is-equiv : is-equiv (complement-decomp-incl f)
    complement-decomp-incl-is-equiv = is-equiv←has-singleton-fibres (λ b
      → is-single←equiv-to-single (fibre-⊎-elim≃ f fst b)
          (mk-singl
            ([⊎ inl , (λ n → inr ((b , n) , refl)) ] (d .snd b))
            (⊎-is-prop
              (is-prop-map←is-embedding (d .fst) b)
              (is-prop←equiv-to-prop
                (fibre-straighten (λ b → ¬ (fibre f b)) b e⁻¹)
                (¬-is-prop FE))
              (λ p q → fibre-straighten (λ b → ¬ (fibre f b)) b ._≃_.fwd q p)
              (_))))

    complemented-embedding-coprod≃ : (A ⊎ map-complement f) ≃ B
    complemented-embedding-coprod≃
      = mk≃ (complement-decomp-incl f) complement-decomp-incl-is-equiv
}
}
