\subtree[tot-DKSN]{
\title{The universal tiny embedding}
\taxon{Construction}
\date{2026-10-07}
\author{samueltoth}

\p{There is a map #{\unitobj \to \Prop_I} which picks out the proposition #{\true}.
This map is an embedding and any crisp proposition #{\phi \colon-flat A^I \to \Prop}
can be obtained as a transposition of a base change of the universal tiny embedding.}

\agda{
Prop-true : ∀ {𝓤} → Prop-U 𝓤
Prop-true = (𝟙ᴸ , trunc!)

√true : ∀ (@♭ 𝓤) → 𝟙 → √(Prop-U 𝓤)
√true 𝓤 = ε♭ (transpose (mod♭ (const (𝟙ᴸ , trunc!))))

proj-√ : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → √ A → A
proj-√ = ev _ ∘ untranspose ∘ point

proj-√-is-♭-equiv : ∀ {@♭ 𝓤} {@♭ A : Type 𝓤} → is-♭-equiv (proj-√ {A = A})
proj-√-is-♭-equiv
  = is-♭-equiv-∘
      (is-♭-equiv←is-equiv (sing-ev-is-equiv trunc!))
      (is-♭-equiv-∘
        √-is-tiny-str
        (is-♭-equiv←is-equiv (point-is-equiv)))

opaque
  transpose-is-♭-embedding
    : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ ψ : (I → Γ) → Prop-U 𝓤)
      → ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ ε♭ (transpose (mod♭ ψ)) x) ⟩
      ≃ ⟨♭| ((x : I → Γ) → fst (ϕ x) ↔ fst (ψ x)) ⟩
  transpose-is-♭-embedding {Γ = Γ} ϕ ψ
    = ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ ε♭ (transpose (mod♭ ψ)) x) ⟩
    ≃⟨ ♭≃ (funext≃ e⁻¹) ⟩
      ⟨♭| (ε♭ (transpose (mod♭ ϕ)) ＝ ε♭ (transpose (mod♭ ψ))) ⟩
    -- ≃⟨ ♭≃ (tr≃ (ε♭ (transpose (mod♭ ϕ)) ＝_) (sym (ε♭-transpose-∘ (const Prop𝟙) !))) ⟩
    --   ⟨♭| (ε♭ (transpose (mod♭ ϕ))) ＝ ε♭ (transpose (mod♭ (point Prop𝟙 ∘ !))) ⟩
    ≃⟨ mapply♭≃ ⟩
      mod♭ (ε♭ (transpose (mod♭ ϕ))) ＝ mod♭ (ε♭ (transpose (mod♭ ψ)))
    ≃⟨ ＝-preconcat-≃ (mod♭ε♭ (transpose (mod♭ ψ)))
    ∙e ＝-postconcat-≃ (sym (mod♭ε♭ (transpose (mod♭ ϕ)))) ⟩
      transpose (mod♭ ϕ) ＝ transpose (mod♭ ψ)
    ≃⟨ mk≃ (ap transpose) (is-embedding←is-equiv (is-equiv⁻¹ √-is-tiny-str)) e⁻¹ ⟩
      mod♭ ϕ ＝ mod♭ ψ
    ≃⟨ mapply♭≃ e⁻¹ ⟩
      ⟨♭| ϕ ＝ ψ ⟩
    ≃⟨ ♭≃ (funext≃ {f = ϕ} {ψ} ) ⟩
      ⟨♭| ((f : I → Γ) → ϕ f ＝ ψ f) ⟩
    ≃⟨ ♭≃ (postcomp-Π-≃ (λ f → IdS≃Id e⁻¹)) ⟩
      ⟨♭| ((f : I → Γ) → ϕ f .fst ↔ ψ f .fst) ⟩
    ≃∎

transpose-const-naturality
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ Γ : Type 𝓥}
      {@♭ a : A} {x : Γ}
      → ε♭ (transpose (mod♭ (const a))) x ＝ ε♭ (transpose (mod♭ (const a))) tt
transpose-const-naturality {a = a} {x}
    = happly (ap ε♭ (transpose-context-naturality ! (mod♭ (const a)))) x
    ∙ happly (ε♭-natural (transpose (mod♭ (const a)))) x

fibre-√true≃
  : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
    → ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true 𝓤 tt) ⟩
    ≃ ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
fibre-√true≃ {𝓤} {Γ = Γ} ϕ
  = ⟨♭| ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true 𝓤 tt) ⟩
  ≃⟨ ♭≃ (postcomp-Π-≃
      (λ c → tr≃ ((ε♭ (transpose (mod♭ ϕ)) c) ＝_)
        (transpose-const-naturality ∙ sym transpose-const-naturality))) ⟩
    ⟨♭| ((x' : Γ) → ε♭ (transpose (mod♭ ϕ)) x' ＝ ε♭ (transpose (mod♭ (const Prop-true))) x') ⟩
  ≃⟨ transpose-is-♭-embedding ϕ (const Prop-true) ⟩
    ⟨♭| ((x : I → Γ) → fst (ϕ x) ↔ fst Prop-true) ⟩
  ≃⟨ ♭≃ (postcomp-Π-≃ (λ _ → ×-swap ∙e (Σ-singleton (λ _ → single!) ∙e sing-UP≃ single!))) ⟩
    ⟨♭| (Π (I → Γ) (fst ∘ ϕ)) ⟩
  ≃∎

fibre-√true→
  : ∀ {@♭ 𝓤 𝓥} {@♭ Γ : Type 𝓥} (@♭ ϕ : (I → Γ) → Prop-U 𝓤)
    → ((x : Γ) → ε♭ (transpose (mod♭ ϕ)) x ＝ √true 𝓤 tt)
    → (Π (I → Γ) (fst ∘ ϕ))
fibre-√true→ {Γ = Γ} ϕ
  = postcomp-Π {I = (I → Γ)} (λ g p → tr fst (sym p) ttᴸ)
  ∘ happly {g = const Prop-true}
  ∘ tr₂ _＝_
      ( sym (ε♭-natural {f = untranspose} (transpose (mod♭ ϕ)))
      ∙ ap ε♭ (is-tiny.ε (mod♭ ϕ)))
      ( sym (ε♭-natural (transpose (mod♭ (const Prop-true)))
      ∙ ap untranspose (funext→ (λ a → transpose-const-naturality {x = a})))
      ∙ ap ε♭ (is-tiny.ε (mod♭ (const Prop-true)))  )
  ∘ ap untranspose ∘ funext→

opaque
  √true-diagonal-is-equiv : ∀ {@♭ 𝓤} → is-equiv (diagonal (√true 𝓤))
  √true-diagonal-is-equiv
    = types-separate
        (diagonal (√true _))
        λ {_} {Γ}
        → is-equiv←single-to-prop
            (♭-is-single single!)
            (is-prop←equiv
              (  (fibre-√true≃ {Γ = Γ} (const Prop-true)) e⁻¹
              ∙e ♭≃ (  postcomp-Π-≃ (λ c → tr≃ (_＝ _) transpose-const-naturality)
                    ∙e postcomp-≃ (Σ-𝟙 ∙e Σ-𝟙) e⁻¹))
              (♭-is-prop (is-prop←is-truncated trunc!)))
            _

√true-is-embedding : ∀ {@♭ 𝓤} → is-embedding (√true 𝓤)
√true-is-embedding
  = is-embedding←diagonal-is-equiv (√true _) √true-diagonal-is-equiv
}
}

\subtree[stt-00KE]{
\title{Amazing properties}

\p{We obtain a map #{\Prop_I \to \Prop} by considering the fibre of the universal
embedding. This gives us a function
#{\rm{is-amazingly} \colon \modflat{A^I \to \Prop} \to \modflat{A \to \Prop}} with
the following universal property: let #{\phi} be a subtype of #{A^I}, then we
have an equivalence #{(\Pi_A \textrm{is-amazingly}_{\phi}) \simeq (\Pi_{A^I} \phi)}.}

\agda{
classify-√-prop : ∀ {@♭ 𝓤} → √(Prop-U 𝓤) → Prop-U (lsuc 𝓤)
classify-√-prop {𝓤} x
  = ( fibre (√true 𝓤) x
    , is-truncated←is-prop (is-prop-map←is-embedding √true-is-embedding x))

is-amazingly-prop
  : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
    → ⟨♭| ((I → A) → Prop-U 𝓥) ⟩ → ⟨♭| (A → Prop-U (lsuc 𝓥)) ⟩
is-amazingly-prop = ♭-map (postcomp _ classify-√-prop) ∘ transpose

module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Type 𝓥)
  (@♭ ϕ-is-prop : ∀ f → is-prop (ϕ f))
  (let
    @♭ ϕ-prop : (I → A) → Prop-U 𝓥
    ϕ-prop f = (ϕ f , is-truncated←is-prop (ϕ-is-prop f))

    @♭ ϕ̄-prop : A → √ (Prop-U 𝓥)
    ϕ̄-prop = ε♭ (transpose (mod♭ ϕ-prop))
    )
  where

  opaque
    is-amazingly : A → Type (lsuc 𝓥)
    is-amazingly
      = fibre (√true _)
      ∘ ε♭ (transpose (mod♭ (λ f → ϕ f , is-truncated←is-prop (ϕ-is-prop f))))

    is-amazingly-is-subtype
      : is-subtype is-amazingly
    is-amazingly-is-subtype a = is-prop-map←is-embedding √true-is-embedding (ϕ̄-prop a)

  is-amazingly-subtype : Subtype A (lsuc 𝓥)
  is-amazingly-subtype .Subtype.family = is-amazingly
  is-amazingly-subtype .Subtype.family-is-subtype = is-amazingly-is-subtype

  relative-subtype : Type (𝓤 ⊔ lsuc 𝓥)
  relative-subtype = Subtype.Σ̃ is-amazingly-subtype

  opaque
    unfolding is-amazingly
    untranspose-is-amazingly
      : Π A is-amazingly → Π (I → A) ϕ
    untranspose-is-amazingly f = fibre-√true→ ϕ-prop (sym ∘ snd ∘ f)

    untranspose-is-amazingly-is-♭-equiv
      : is-♭-equiv (untranspose-is-amazingly)
    untranspose-is-amazingly-is-♭-equiv
      = is-equiv←~
          (λ _ → ♭-is-prop (Π-is-prop ϕ-is-prop) _ _)
          (_≃_.fwd-is-equiv
            (  ♭≃ (postcomp-Π-≃ (λ _ → Σ-𝟙 ∙e sym≃))
            ∙e fibre-√true≃ ϕ-prop))

    transpose-is-amazingly
      : ⟨♭| Π (I → A) ϕ ⟩ → ⟨♭| Π A is-amazingly ⟩
    transpose-is-amazingly = is-equiv.bwd untranspose-is-amazingly-is-♭-equiv

module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Type 𝓥)
  (@♭ ϕ-is-prop : ∀ f → is-prop (ϕ f))
  (let
    @♭ ϕ-prop : (I → A) → Prop-U 𝓥
    ϕ-prop f = (ϕ f , is-truncated←is-prop (ϕ-is-prop f))

    @♭ ϕ̄-prop : A → √ (Prop-U 𝓥)
    ϕ̄-prop = ε♭ (transpose (mod♭ ϕ-prop))
    )
  where

  opaque
    unfolding is-amazingly
    is-amazingly-naturality
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → Π Γ (is-amazingly ϕ ϕ-is-prop ∘ σ)
        → Π Γ (is-amazingly (ϕ ∘ postcomp I σ) (ϕ-is-prop ∘ postcomp I σ))
    is-amazingly-naturality σ = postcomp-Π
      (λ x → total-map (λ _
         → _∙ (sym (happly
           ( ap ε♭ (transpose-context-naturality σ (mod♭ (ϕ-prop)))
           ∙ ε♭-natural {f = precomp _ σ} (transpose (mod♭ ϕ-prop))) x))))

    is-amazingly-naturality-is-equiv
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → is-equiv (is-amazingly-naturality σ)
    is-amazingly-naturality-is-equiv σ
      = postcomp-Π-equiv
          (λ {x} → is-total-equiv←is-fibrewise-equiv
            (λ _ → ∙-is-equiv' _))

    is-amazingly-naturality⁻¹
      : ∀ {@♭ 𝓦} {@♭ Γ : Type 𝓦} (@♭ σ : Γ → A)
        → Π Γ (is-amazingly (ϕ ∘ postcomp I σ) (ϕ-is-prop ∘ postcomp I σ))
        → Π Γ (is-amazingly ϕ ϕ-is-prop ∘ σ)
    is-amazingly-naturality⁻¹ σ = is-equiv.bwd (is-amazingly-naturality-is-equiv σ)
}
}

\subtree[tot-0239]{
\title{The universal property of relative subtypes}
\taxon{Lemma}
\author{samueltoth}

\p{If #{I} is a tiny type, and #{\phi \colon A^I \to \Prop} some family of
propositions, we can consider the #{I}-relative subtype of #{A} denoted #{A_{\phi}}.}

\p{This type admits an embedding #{A_{\phi} \hookrightarrow A} such that the following
square commutes:

\quiver{
\begin{tikzcd}
	{{A_\phi}^\Gamma} && {{({P(A)}_\phi)}^{P(\Gamma)}} \\
	& {\Sigma1{f : A^\Gamma}{\phi(f^I)}} \\
	{A^\Gamma} && {{P(A)}^{P(\Gamma)}}
	\arrow[from=1-1, to=1-3]
	\arrow[dotted, from=1-1, to=2-2]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=2-2, to=1-3]
	\arrow[from=2-2, to=3-1]
	\arrow["\lrcorner"{anchor=center, pos=0.125}, draw=none, from=2-2, to=3-3]
	\arrow[from=3-1, to=3-3]
\end{tikzcd}
}
}

\agda{
module _
  {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
  (@♭ ϕ : (I → A) → Type 𝓥)
  (@♭ ϕ-is-prop : ∀ f → is-prop (ϕ f))
  (let
    @♭ ϕ-subtype : Subtype (I → A) 𝓥
    ϕ-subtype = mk-subtype ϕ-is-prop
    )
  where

  relative-subtype-square
    : ∀ {𝓦} {Γ : Type 𝓦}
      → Arrow-map
          (postcomp Γ (Subtype.Σ̃-π (is-amazingly-subtype ϕ ϕ-is-prop)))
          (postcomp (I → Γ) (Subtype.Σ̃-π ϕ-subtype))
  relative-subtype-square .Arrow-Π.top f σ
    = ( Subtype.Σ̃-π (is-amazingly-subtype ϕ ϕ-is-prop) ∘ f ∘ σ
      , untranspose-is-amazingly
          (ϕ ∘ postcomp I (Subtype.Σ̃-π (is-amazingly-subtype ϕ ϕ-is-prop)))
          (λ _ → ϕ-is-prop _)
          (is-amazingly-naturality ϕ ϕ-is-prop fst snd)
          (f ∘ σ))
  relative-subtype-square .Arrow-Π.bot = postcomp I
  relative-subtype-square .Arrow-Π.comm = ~refl
}

\p{The universal property of #{A_{\phi}} says that this square is flat cartesian, but
this remains to be formalised. This would recover the universal property in
\citet{Fact 2.11.1}{Hau25}. It still remains to be shown that in the case that
#{\phi} is a wide subcategory and #{A} is a (pre)category, then #{A_{\phi}} is a
(pre)category.}
}

\subtree[tot-0PVM]{
\title{Amazingly fibrant types}
\taxon{Construction}

\agda{
module AmazinglyFibrant
  {@♭ α : Level → Level → Level}
  (@♭ is-fib : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → Type (α 𝓤 𝓥))
  (@♭ is-fib-is-prop : ∀ {𝓤 𝓥} {A : Type 𝓤} (B : A → Type 𝓥) → is-prop (is-fib B))
  (@♭ rel-fib : is-relative-fam I is-fib)
  where

  is-afib : ∀ {@♭ 𝓤} → Type 𝓤 → Type (lsuc (α 𝓘 𝓤))
  is-afib = is-amazingly is-fib is-fib-is-prop

  is-afib-is-prop : ∀ {@♭ 𝓤} → (A : Type 𝓤) → is-prop (is-afib A)
  is-afib-is-prop = is-amazingly-is-subtype is-fib is-fib-is-prop

  record UFib (@♭ 𝓤) : Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤)) where
    constructor mk-ufib
    field
      Carrier : Type 𝓤
      Carrier-is-afib : is-afib Carrier

  UFib∙ : ∀ (@♭ 𝓤) → Type (lsuc (α 𝓘 𝓤 ⊔ 𝓤))
  UFib∙ 𝓤 = Σ (UFib 𝓤) UFib.Carrier

  UFib-π : ∀ {@♭ 𝓤} → UFib∙ 𝓤 → UFib 𝓤
  UFib-π = fst

  UFib-π-is-fib : ∀ {@♭ 𝓤} → is-fib (UFib.Carrier {𝓤})
  UFib-π-is-fib = rel-fib _ .snd
    (untranspose-is-amazingly
       (is-fib ∘ postcomp I UFib.Carrier) (is-fib-is-prop ∘ _)
       (is-amazingly-naturality is-fib is-fib-is-prop
         UFib.Carrier UFib.Carrier-is-afib))

  UFib-is-fib
    : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} (P : A → UFib 𝓥)
      → is-fib (UFib.Carrier ∘ P)
  UFib-is-fib P
    = is-base-change-stable-fam←is-relative
        I is-fib rel-fib P UFib.Carrier
        UFib-π-is-fib

  liftFib
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} {@♭ P : A → Type 𝓥}
      → ⟨♭| is-fib P ⟩ ↔ ⟨♭| (∀ a → is-afib (P a)) ⟩
  liftFib {A = A} {P = P} .fst fib
    = ♭-map
        (is-amazingly-naturality⁻¹ (is-fib) (is-fib-is-prop) P)
        (transpose-is-amazingly (is-fib ∘ postcomp I P) (is-fib-is-prop ∘ _)
          (♭-map (rel-fib P .fst) fib))
  liftFib {A = A} {P = P} .snd
    = ♭-map (UFib-is-fib ∘ (λ af a → (mk-ufib (P a) (af a))))

  UFib-transport : ∀ {@♭ 𝓤 𝓥} {A : Type 𝓤} → (A → UFib 𝓥) → Σ (A → Type 𝓥) is-fib
  UFib-transport f = (UFib.Carrier ∘ f , UFib-is-fib f)

  Carrier-is-prop-map : ∀ {@♭ 𝓤} → is-prop-map (UFib.Carrier {𝓤})
  Carrier-is-prop-map X = is-prop←retraction
    (λ where (a , refl) → a .UFib.Carrier-is-afib)
    ((λ a → (mk-ufib X a , refl)) , λ where (a , refl) → refl)
    (is-afib-is-prop X)

  Carrier-is-emb : ∀ {@♭ 𝓤} → is-embedding (UFib.Carrier {𝓤})
  Carrier-is-emb = is-embedding←is-prop-map Carrier-is-prop-map

  UFib-path→
    : ∀ {@♭ 𝓤} (A B : UFib 𝓤)
      → UFib.Carrier A ≃ UFib.Carrier B
      → A ＝ B
  UFib-path→ A B e = unap Carrier-is-emb (ua e)

  instance
    UFib-IdS : ∀ {@♭ 𝓤} → Identity-system (UFib 𝓤) 𝓤
    UFib-IdS {𝓤} = IdS←Embedding {f = UFib.Carrier} Carrier-is-prop-map (IdS-ua {𝓤})

  UFib-tr
    : ∀ {@♭ 𝓤} {A B : UFib 𝓤} (p : A ＝ B)
      → ext! (tr≃ UFib.Carrier p) ＝ p
  UFib-tr refl = Id←IdS←Id refl

  UP-UFib
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
      → is-♭-equiv (UFib-transport {𝓤} {𝓥} {A})
  UP-UFib = is-equiv←qinv
    ( ♭-ind (λ f
        → mod♭ λ a → mk-ufib (fst f a) (ε♭ (liftFib .fst (mod♭ (snd f))) a))
    , ♭-ind (λ f
        → mapply♭ (mod♭ (ext! (λ a → id≃))))
    , ♭-ind (λ f
        → mapply♭ (mod♭ (ext! ((λ _ → id≃) , is-fib-is-prop (f .fst) _ _)))))

  UP-UFib≃
    : ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤}
      → ⟨♭| (A → UFib 𝓥) ⟩ ≃ ⟨♭| Σ (A → Type 𝓥) is-fib ⟩
  UP-UFib≃ {𝓤} {𝓥} {A} = mk≃ (♭-map (UFib-transport {𝓤} {𝓥} {A})) UP-UFib
}
}

\subtree[tot-022B]{
\title{Amazing fibrancy lifting}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-19}

\p{
Let #{I} be an inhabited tiny object, and let fibrations be #{I}-relative.
Given a crisp type family #{P \colon-flat A \to \UU}, if #{P} is a fibration then
its fibres are amazingly fibrant.
}

\proof{
\p{
Let #{Q(h,a) \defeq P(a) \colon-flat \textsf{is-fib}(P)\times A \to \UU}. We start by
showing that #{Q} is crisply a fibration. Since fibrations are #{I}-relative, it
suffices to show crisply that #{Q \circ \sigma} is a fibration for every
#{\sigma \colon I \to \textsf{is-fib}(P)\times A}. Since being a fibration is a
proposition, we may assume an element #{i :^♭ I}, and so #{\pi_1 \sigma(i)} is a
proof that #{P} is a fibration. The family #{Q \circ \sigma} is a base change of #{P}
and so it is also a fibration. Abstraction over #{\sigma} thus gives a crisp proof of
the relative fibrancy condition, so we obtain a crisp proof that #{Q} is a fibration.
}

\p{
Now, applying the amazing right adjoint to this crisp witness and using naturality,
we obtain that every #{Q(x)} is amazingly fibrant. Evaluating at #{(h,a)}, where #{h}
is our initial hypothesis that #{P} is fibrant, we conclude that #{P(a)} is amazingly
fibrant.
}
}

\agda{
  lift-fibrancy
    : @♭ ║ I ║₋₁
    → ∀ {@♭ 𝓤 𝓥} {@♭ A : Type 𝓤} (@♭ P : A → Type 𝓥)
    → is-fib P → (a : A) → is-afib (P a)
  lift-fibrancy |i| {𝓤} {𝓥} {A} P P-is-fib a
    = ε♭ (liftFib .fst (mod♭ Q-is-fib)) (P-is-fib , a)
    where
    @♭ Q : is-fib P × A → Type 𝓥
    Q = P ∘ snd

    @♭ Q-is-fib : is-fib Q
    Q-is-fib
      = rel-fib Q .snd (λ σ → rel-fib P .fst
          (Trunc.○-rec (is-truncated←is-prop (is-fib-is-prop P)) (fst ∘ σ) |i|)
          (snd ∘ σ))
}
}
