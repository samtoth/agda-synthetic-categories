\title{Right homotopies}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-23}
\import{stt-macros}

\transclude{stt-00AB}

\agda{
open import Foundations.Universes
open import Algebra.Lattice
import Algebra.Lattice.Instances.Polynomial as Poly

module Synthetic.RightHomotopy
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  (let Δ² = Poly.Δ² I)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open Poly hiding (Δ²)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.ArrowEquiv
open import Core.Orthogonal
open import Core.Slices
open import Core.CocartesianSquares
open import Core.Cofibres
open import Core.CanonicalPushouts

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Horns Δ¹ I
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Triangles Δ¹ I
}
}

\subtree[stt-0175]{
\title{Right homotopies of morphisms}
\taxon{Definition}
\author{samueltoth}
\author{fredrikbakke}
\date{2026-09-23}

\p{
A \em{right homotopy} #{f \rhtpy g} is a filler of the [triangle](stt-00AK)
}

\quiver{
\begin{tikzcd}
  a && b\nsp{.} \\
  & b
  \arrow[from=1-1, to=1-3, "g"]
  \arrow[from=1-1, to=2-2, "f"']
  \arrow[from=2-2, to=1-3, equals]
\end{tikzcd}
}

\agda{
_▵~_ : ∀ {𝓤} {A : Type 𝓤} {a b : A} → (f g : Hom A a b) → Type (𝓘 ⊔ 𝓤)
f ▵~ g = Hom2 (idH _) f g
}
}

\subtree[stt-0173]{
\title{The walking right homotopy}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-23}

\p{
We define the \em{walking right homotopy} #{\RHtpy} as the
[cofibre](Core.Cofibres) of #{d_0 \colon Δ¹ \to Δ²}, which contracts the edge
#{1 \leq 2}.
}

\agda{
Δ~ : Type 𝓘
Δ~ = Cofibre δ₀²

src-Δ~ : Δ¹ → Δ~
src-Δ~ = ι₁ ∘ δ₂²

tgt-Δ~ : Δ¹ → Δ~
tgt-Δ~ = ι₁ ∘ Δ²-diagonal

Δ~-span : Span 𝓘 𝓘 lzero
Δ~-span = mk-span Δ¹ δ₀² !

Δ~-proj-cocone : Cocone Δ~-span Δ¹
Δ~-proj-cocone = mk-cocone Δ².s (point i1) ~refl

proj-Δ~ : Δ~ → Δ¹
proj-Δ~ = cogap Δ~-proj-cocone

Δ~-rep1
  : ∀ {𝓤} {A : Type 𝓤}
    → (Δ~ → A) ≃ Σ[ x ∶ A ] Ext δ₀² (const x)
Δ~-rep1 = Cofibre-map-repr δ₀²

Δ¹-retract-Δ~ : retract Δ¹ Δ~
Δ¹-retract-Δ~ = (src-Δ~ , proj-Δ~ , ~refl)
}
}

\subtree[stt-016R]{
\title{The walking right homotopy classifies right homotopies}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-23}

\p{Maps #{\RHtpy \to A} classify [right homotopies](stt-0175) in #{A}.}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  right-unit-horn-restrict-Arrow-equiv
    : Arrow-equiv
        (id: (Δ¹ → A))
        ( λ (l : Σ[ x ∶ A ] Ext Λ[2,1]-right-leg-incl (const x))
          → l .snd .fst ∘ Λ[2,1]-left-leg-incl)
  right-unit-horn-restrict-Arrow-equiv
    = mk-arr-equiv
        ( precomp-≃ (cogap-square≃ _ right-unit-horn-is-pushout)
        ∙e Cofibre-map-repr Λ[2,1]-right-leg-incl)
        (id≃)
        (~refl)

  right-unit-horn≃
    : (Δ¹ → A) ≃ Σ[ x ∶ A ] Ext Λ[2,1]-right-leg-incl (const x)
  right-unit-horn≃
    = mk≃ (λ f → (_ , make-horn (idH _) (λhom f) , ~refl))
        (3-for-2
          (tgt-is-equiv←Arrow-equiv right-unit-horn-restrict-Arrow-equiv id-is-equiv)
          id-is-equiv)

  Δ~-rep3
    : (Δ~ → A) ≃ Σ[ f ∶ (Δ¹ → A) ] Ext Λ[2,1]-incl (make-horn (idH _) (λhom f))
  Δ~-rep3
    = Δ~-rep1
    ∙e Σ-snd-≃ (λ a → Ext-compose≃ Λ[2,1]-incl Λ[2,1]-right-leg-incl (const a))
    ∙e (Σ-assoc e⁻¹)
    ∙e (Σ-fst-≃ right-unit-horn≃ e⁻¹)

  Δ~-rep4
    : (Δ~ → A)
    ≃ Σ[ f ∶ (Δ¹ → A) ] Σ[ g ∶ Hom A (f i0) (f i1) ] Hom2 (idH _) (λhom f) g
  Δ~-rep4
    = Δ~-rep3
    ∙e Σ-snd-≃
        ( λ f → Σ-snd-≃ (λ _ → funext≃ e⁻¹)
        ∙e Λ[2,1]-incl-ext≃composite (idH _) (λhom f))

  rep4-src-Δ~
    : fst ∘ Δ~-rep4 ._≃_.fwd ~ precomp A (src-Δ~)
  rep4-src-Δ~ = ~refl

  rep4-tgt-Δ~
    : Homᵈ.hom ∘ fst ∘ snd ∘ Δ~-rep4 ._≃_.fwd ~ precomp A (tgt-Δ~)
  rep4-tgt-Δ~ f
    = composite←Λ[2,1]-incl-ext-diagonal _ _
        (total-map (λ _ → funext→) (Δ~-rep3 ._≃_.fwd f .snd))
    ∙ ap (λ a → a .snd .fst ∘ Δ²-diagonal)
        (_≃_.ε (Σ-fst-≃ {B = Ext Λ[2,1]-incl ∘ fst ∘ snd} right-unit-horn≃) _)

  Δ~-rep-fibre
    : {a b : A} (f : Hom A a b)
    → fibre (precomp A src-Δ~) (f .Homᵈ.hom)
    ≃ Σ[ g ∶ Hom A a b ] (f ▵~ g)
  Δ~-rep-fibre (mk-hom f refl refl)
    = fibre≃←is-equiv (Δ~-rep4 ._≃_.fwd , ~refl) (Δ~-rep4 ._≃_.fwd-is-equiv) f
    ∙e fibre-straighten _ f
}
}

\subtree[stt-016Q]{
\title{Right homotopy is reflexive}
\taxon{Proposition}
\author{samueltoth}
\author{fredrikbakke}
\date{2026-09-23}

\agda{
opaque
  refl▵~ : ∀ {𝓤} {A : Type 𝓤} {a b : A} (f : Hom A a b) → f ▵~ f
  refl▵~ (mk-hom f refl refl)
    = Hom2←square (f ∘ fst) refl refl refl

▵~←＝ : ∀ {𝓤} {A : Type 𝓤} {a b : A} {f g : Hom A a b} → f ＝ g → f ▵~ g
▵~←＝ {f = f} refl = refl▵~ f
}
}

\subtree[stt-0170]{
\title{Locality at the right homotopy characterises equality of homs}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-23}

\p{
A type is local at the right homotopy target inclusion if and only if right
homotopies characterise equality of morphisms.
}

\agda{
module _
  {𝓤} {A : Type 𝓤} (A-is-src-local : orthogonal-type src-Δ~ A)
  where

  opaque
    ▵~-is-torsorial←src-local
      : {a b : A} (f : Hom A a b) → is-torsorial (f ▵~_)
    ▵~-is-torsorial←src-local f
      = is-single←equiv (Δ~-rep-fibre f)
          (has-singleton-fibres←is-equiv A-is-src-local (f .Homᵈ.hom))

  [▵~←＝]-is-equiv←src-local
    : {a b : A} (f g : Hom A a b) → is-equiv (▵~←＝ {f = f} {g = g})
  [▵~←＝]-is-equiv←src-local f
    = fundamental-Id _ (▵~-is-torsorial←src-local f) _

  ＝≃▵~←tgt-local : {a b : A} (f g : Hom A a b) → (f ＝ g) ≃ (f ▵~ g)
  ＝≃▵~←tgt-local f g = mk≃ ▵~←＝ ([▵~←＝]-is-equiv←src-local f g)

module _ {𝓤} {A : Type 𝓤} where

  src-local←▵~-is-torsorial
    : ({a b : A} (f : Hom A a b) → is-torsorial (f ▵~_))
    → orthogonal-type src-Δ~ A
  src-local←▵~-is-torsorial tors
    = is-equiv←has-singleton-fibres (λ f
        → is-single←equiv⁻¹ (Δ~-rep-fibre (λhom f)) (tors (λhom f)))

  src-local←＝≃▵~
    : ({a b : A} (f g : Hom A a b) → (f ＝ g) ≃ (f ▵~ g))
    → orthogonal-type src-Δ~ A
  src-local←＝≃▵~ e
    = src-local←▵~-is-torsorial
        (λ f → is-single←equiv (Σ-snd-≃ (e f)) Sing-is-singleton)

  src-local←[▵~←＝]-is-equiv
    : ({a b : A} (f g : Hom A a b) → is-equiv (▵~←＝ {f = f} {g = g}))
    → orthogonal-type src-Δ~ A
  src-local←[▵~←＝]-is-equiv e
    = src-local←＝≃▵~ (λ f g → mk≃ ▵~←＝ (e f g))

  src-local↔▵~-is-torsorial
    : orthogonal-type src-Δ~ A
    ↔ ({a b : A} (f : Hom A a b) → is-torsorial (f ▵~_))
  src-local↔▵~-is-torsorial
    = (▵~-is-torsorial←src-local , src-local←▵~-is-torsorial)

  src-local↔[▵~←＝]-is-equiv
    : orthogonal-type src-Δ~ A
    ↔ ({a b : A} (f g : Hom A a b) → is-equiv (▵~←＝ {f = f} {g = g}))
  src-local↔[▵~←＝]-is-equiv
    = ([▵~←＝]-is-equiv←src-local , src-local←[▵~←＝]-is-equiv)
}
}


\subtree[stt-0174]{
\title{Right homotopies from morphisms over morphisms}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-09-23}

\p{
Given a dependent morphism in the type family #{\Hom_A({-},c)} over
#{f : \Hom_A(a,b)} from #{h : \Hom_A(a,c)} to #{g : \Hom_A(b,c)}, we extract a
diagonal morphism #{\delta : \Hom_A(a,c)} together with a composition triangle
#{\delta = g \circ f} and a right homotopy #{h \rhtpy \delta}. In particular, when
#{f} is an identity morphism, this gives a left + right homotopy decomposition of a
morphism of morphisms: given two edges #{h, g : \Hom_A(a,c)} and a morphism
#{\alpha : \Hom_{\Hom_A(a,c)}(h,g)}, then #{h \rhtpy \delta} and #{g \lhtpy \delta}.
}

\agda{
module _ {𝓤} {A : Type 𝓤} where

  diag-hom←contra-Hom-over
    : {a b c : A} (g : Hom A b c) (f : Hom A a b) {h : Hom A a c}
    → Hom-over f h g → Hom A a c
  diag-hom←contra-Hom-over g (mk-hom fh refl refl) {h} (mk-hom α refl refl)
    = mk-hom (λ i → α i .Homᵈ.hom i) (h .Homᵈ.hom0) (g .Homᵈ.hom1)

  Hom2←contra-Hom-over
    : {a b c : A} (g : Hom A b c) (f : Hom A a b) {h : Hom A a c}
      (α : Hom-over f h g)
    → Hom2 g f (diag-hom←contra-Hom-over g f α)
  Hom2←contra-Hom-over g f@(mk-hom fh refl refl) {h} α@(mk-hom αh refl refl)
    = tr
        (λ u → Hom2 g u (diag-hom←contra-Hom-over g f α))
        (Hom-ext→ ((λ i → αh i .Homᵈ.hom0) , ∙-reflr _ , ∙-reflr _))
        (Hom2←square (λ (i , j) → αh i .Homᵈ.hom j)
          (h .Homᵈ.hom0) (g .Homᵈ.hom0) (g .Homᵈ.hom1))

  ▵~←Hom-over
    : {a b c : A} (g : Hom A b c) (f : Hom A a b) {h : Hom A a c}
      (α : Hom-over f h g)
    → h ▵~ diag-hom←contra-Hom-over g f α
  ▵~←Hom-over g f@(mk-hom fh refl refl) {h} α@(mk-hom αh refl refl)
    = tr
        (λ u → Hom2 u h (diag-hom←contra-Hom-over g f α))
        (Hom-ext→ ((λ i → αh i .Homᵈ.hom1) , ∙-reflr _ , ∙-reflr _))
        (Hom2←square (λ (i , j) → αh j .Homᵈ.hom i)
          (h .Homᵈ.hom0) (h .Homᵈ.hom1) (g .Homᵈ.hom1))
}
}
