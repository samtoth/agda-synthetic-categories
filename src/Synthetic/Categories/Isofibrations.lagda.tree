\subtree[stt-00QL]{
\title{Isofibrations}
\author{fredrikbakke}
\taxon{Definition}
\date{2026-04-13}

\p{
A map is an \em{isofibration} if it is right orthogonal to the inclusion of the
source object into the [walking isomorphism](Synthetic.Categories.WalkingIso).
}

\agda{
module IsoFib = RightOrthogonalClassClosure (point (point src-ℑ))

is-isofibration : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
is-isofibration = IsoFib.∈R

isofibration : {𝓤 𝓥 : Level} → Type 𝓤 → Type 𝓥 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
isofibration A B = Σ[ f ∶ (A → B)] is-isofibration f

open IsoFib public using () renaming
  ( ∈R←base-change to is-isofibration←base-change
  ; source∈R←is-Arrow-equiv to source-is-isofibration←is-Arrow-equiv
  ; target∈R←is-Arrow-equiv to target-is-isofibration←is-Arrow-equiv
  ; ∈R←is-equiv to is-isofibration←is-equiv
  ; ∈R-iff←equiv to is-isofibration-iff←equiv
  ; ∈R←retraction to is-isofibration←retraction
  ; ∈R-∘ to is-isofibration-∘
  ; ∈R-left-cancel to is-isofibration-left-cancel
  ; ∈R←homotopy to is-isofibration-homotopy
  ; ∈R-∘~ to is-isofibration-∘~
  ; ∈R-left-cancel~ to is-isofibration-left-cancel~)
}
}
