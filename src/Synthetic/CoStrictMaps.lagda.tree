\subtree[bak-3B74]{
\title{Co-strict maps}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-10-02}

\p{
A map #{f \colon A \to B} is \em{co-strict} if it belongs to the
[right orthogonal class](stt-00LS) generated by the #{(0 = 1)}-indexed family of maps
#{\empty \to \b1}. We write #{A \to-s B} for the type of co-strict maps from
#{A} to #{B}.
}

\agda{
generator-fam-co-strict-maps : (p : i0 ＝ i1) → generator-fam-co-strict p → 𝟙
generator-fam-co-strict-maps _ = !

is-co-strict-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
is-co-strict-map = RightOrthogonalClassClosure.∈R generator-fam-co-strict-maps

is-co-strict-map-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    → is-prop (is-co-strict-map f)
is-co-strict-map-is-prop
  = ∈-is-prop (RightOrthogonalClassClosure.R' generator-fam-co-strict-maps)

infixr 5 _→ˢ_
_→ˢ_ : ∀ {𝓤 𝓥} → Type 𝓤 → Type 𝓥 → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
A →ˢ B = Σ[ f ∶ (A → B) ] is-co-strict-map f

instance
  →ˢ-IdS
    : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → Identity-system (A →ˢ B) (𝓤 ⊔ 𝓥)
  →ˢ-IdS = IdS←Subtype is-co-strict-map-is-prop auto!

open RightOrthogonalClassClosure generator-fam-co-strict-maps public
  using () renaming
  ( R-gClass to →ˢ-gClass
  ; ∈R←base-change to is-co-strict-map←base-change
  ; source∈R←Arrow-equiv to source-is-co-strict-map←Arrow-equiv
  ; target∈R←Arrow-equiv to target-is-co-strict-map←Arrow-equiv
  ; ∈R←is-equiv to is-co-strict-map←is-equiv
  ; ∈R-iff←Arrow-equiv to is-co-strict-map-iff←Arrow-equiv
  ; ∈R←Arrow-retract to is-co-strict-map←Arrow-retract
  ; ∈R-∘ to is-co-strict-map-∘
  ; ∈R-left-cancel to is-co-strict-map-left-cancel
  ; ∈R←homotopy to is-co-strict-map-homotopy
  ; ∈R-∘~ to is-co-strict-map-∘~
  ; ∈R-left-cancel~ to is-co-strict-map-left-cancel~)
}
}

\subtree[bak-2E62]{
\title{Co-strict maps have co-strict fibres}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-10-02}

\p{
A map is [co-strict](bak-3B74) if and only if its fibres are [co-strict](bak-8E31).
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  fibres-are-co-strict←is-co-strict-map
    : is-co-strict-map f → (b : B) → is-co-strict (fibre f b)
  fibres-are-co-strict←is-co-strict-map f-is-co-strict b
    = is-null←is-local (λ p
      → are-orthogonal-fibre←are-orthogonal (f-is-co-strict p) (point b))

  is-co-strict-map←fibres-are-co-strict
    : ((b : B) → is-co-strict (fibre f b)) → is-co-strict-map f
  is-co-strict-map←fibres-are-co-strict fibres-are-co-strict p
    = are-orthogonal←are-orthogonal-fibre (λ h
      → is-local←is-null (fibres-are-co-strict (h tt)) p)

  is-co-strict-map↔fibres-are-co-strict
    : is-co-strict-map f ↔ ((b : B) → is-co-strict (fibre f b))
  is-co-strict-map↔fibres-are-co-strict
    = (fibres-are-co-strict←is-co-strict-map , is-co-strict-map←fibres-are-co-strict)
}
}

\subtree[bak-2271]{
\title{Co-strict maps as contractible fibres under #{0 = 1}}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-10-02}

\p{
A map #{f \colon A \to B} is [co-strict](bak-3B74) if and only if
#{\fibre{f}{b}^{(0 = 1)}} is [contractible](stt-0006) for every #{b : B}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  exp-fibres-are-single←is-co-strict-map
    : is-co-strict-map f → (b : B) → is-singleton ((i0 ＝ i1) → fibre f b)
  exp-fibres-are-single←is-co-strict-map f-is-co-strict b
    = exp-is-single←is-co-strict
        (fibres-are-co-strict←is-co-strict-map f-is-co-strict b)

  is-co-strict-map←exp-fibres-are-single
    : ((b : B) → is-singleton ((i0 ＝ i1) → fibre f b)) → is-co-strict-map f
  is-co-strict-map←exp-fibres-are-single fibres-exp-are-single
    = is-co-strict-map←fibres-are-co-strict
        (λ b → is-co-strict←exp-is-single (fibres-exp-are-single b))

  is-co-strict-map↔exp-fibres-are-single
    : is-co-strict-map f ↔ ((b : B) → is-singleton ((i0 ＝ i1) → fibre f b))
  is-co-strict-map↔exp-fibres-are-single
    = ( exp-fibres-are-single←is-co-strict-map
      , is-co-strict-map←exp-fibres-are-single)
}
}

\subtree[bak-F65F]{
\title{Co-strict maps are maps that are equivalences when #{0 = 1}}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-10-02}

\p{
A map is [co-strict](bak-3B74) if and only if it is an equivalence whenever #{0 = 1}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  is-equiv-under-0=1←is-co-strict-map
    : is-co-strict-map f → i0 ＝ i1 → is-equiv f
  is-equiv-under-0=1←is-co-strict-map f-is-co-strict p
    = is-equiv←has-singleton-fibres (λ b
      → is-single←retraction const (ev p , ~refl)
          (exp-fibres-are-single←is-co-strict-map f-is-co-strict b))

  is-co-strict-map←is-equiv-under-0＝1
    : (i0 ＝ i1 → is-equiv f) → is-co-strict-map f
  is-co-strict-map←is-equiv-under-0＝1 f-is-equiv p
    = is-co-strict-map←is-equiv (f-is-equiv p) p

  is-co-strict-map↔is-equiv-under-0＝1
    : is-co-strict-map f ↔ (i0 ＝ i1 → is-equiv f)
  is-co-strict-map↔is-equiv-under-0＝1
    = (is-equiv-under-0=1←is-co-strict-map , is-co-strict-map←is-equiv-under-0＝1)
}
}
