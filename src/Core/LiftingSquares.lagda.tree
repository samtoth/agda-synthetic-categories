\taxon{Module}
\import{stt-macros}

\title{Lifting squares}

\agda{
module Core.LiftingSquares where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Core.Arrows
open import Foundations.Prelude
open import Ergonomics.Representation
open import Ergonomics.Extensionality
}
}

\subtree[stt-0044]{
\title{Lifts of squares}

\p{Given a morphism of arrows, i.e., a square

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=1-1, to=3-3, phantom, "H"]
\end{tikzcd}
}
then a \em{lift} is a map from the bottom left to the top right, #{\ell \colon B \to X},
such that both evident triangles commute \em{and} such that the pasting
of the triangles agrees with the full square. In other words, it is a completion of
the diagram

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=3-1, to=1-3, dashed, "\ell" description]
\arrow[from=1-1, to=3-3, phantom, "L" very near start, "K" very near end]
\end{tikzcd}
}
which coheres with the original homotopy of the square.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {f' : C → D}
  (G : Arrow-map f f')
  (let g = G .Arrow-map.top)
  (let g' = G .Arrow-map.bot)
  (let H = G .Arrow-map.comm)
  where

  record SqLift : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜) where
    constructor mk-square-lift
    field
      lift : B → C
      L : lift ∘ f ~ g
      K : f' ∘ lift ~ g'
      pastes : f' ◃h L ~ K ▹h f ∙h H {- H ~ K ▹h f ∙h f' ◃h L -}

  unquoteDecl SqLift-repr≊ SqLift-repr≃
    = make-record-repr SqLift-repr≊ SqLift-repr≃ (quote SqLift)
}
}

\subtree[stt-0047]{
\title{Unique lifts of squares}
\taxon{Definition}

\p{We say a square has unique lifts if its type of lifts is a singleton.}

\agda{
  has-unique-sqlift : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  has-unique-sqlift = is-singleton SqLift
}
}

\subtree[stt-00ZJ]{
\title{If there is a lift of the identity square then the underlying map is an equivalence}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
is-equiv←self-sqlift
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  → SqLift (id-square: f) → is-equiv f
is-equiv←self-sqlift s
  = is-equiv←qinv (SqLift.lift s , SqLift.L s , SqLift.K s)
}
}

\subtree[stt-00YO]{
\title{The lifting square induced by a diagonal}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
  {C : Type 𝓦} {D : Type 𝓜} {f : A → B} {g : C → D}
  where

  diagonal-square : (B → C) → Arrow-map f g
  diagonal-square d = mk-amap (d ∘ f) (g ∘ d) ~refl

  diagonal-sqlift : (d : B → C) → SqLift (diagonal-square d)
  diagonal-sqlift d = mk-square-lift d ~refl ~refl ~refl

  diagonal-square-htpy
    : {d e : B → C} → d ~ e
    → Arrow-map-path (diagonal-square d) (diagonal-square e)
  diagonal-square-htpy H
    = (H ▹h f , g ◃h H , (∙h-reflr (g ◃h H ▹h f) h⁻¹))
}

\p{
The function \code{diagonal-square} is more commonly known as the
\em{pullback power}, and is studied in [[Core.PullbackPowers]].
}
}

\subtree[stt-00YM]{
\title{Homotopies of lifts of squares}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
  {G : Arrow-map f g}
  where

  SqLift-htpy-boundary
    : (s : SqLift G)
    → Arrow-map-path (diagonal-square (SqLift.lift s)) G
  SqLift-htpy-boundary s = (SqLift.L s , SqLift.K s , SqLift.pastes s)

  coherence-SqLift-htpy
    : (s t : SqLift G)
    → SqLift.lift s ~ SqLift.lift t
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  coherence-SqLift-htpy s t H
    = Arrow-map-path²
        (SqLift-htpy-boundary s)
        (concat-Arrow-map-path (diagonal-square-htpy H) (SqLift-htpy-boundary t))

  SqLift-htpy : (s t : SqLift G) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  SqLift-htpy s t
    = Σ[ H ∶ SqLift.lift s ~ SqLift.lift t ] coherence-SqLift-htpy s t H
}
}

\subtree[stt-00YR]{
\title{Characterising equality of lifts of a square}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-11}

\p{Homotopies of lifts characterise their equality.}

\agda{
  SqLift-htpy-refl : {s : SqLift G} → SqLift-htpy s s
  SqLift-htpy-refl {s}
    = ( ~refl
      , Arrow-map-path²←id
          ( sym (concat-Arrow-map-path-left-unit (SqLift-htpy-boundary s))))

  SqLift-htpy←id : {s t : SqLift G} → s ＝ t → SqLift-htpy s t
  SqLift-htpy←id refl = SqLift-htpy-refl

  opaque
    SqLift-htpy-is-torsorial : (s : SqLift G) → is-torsorial (SqLift-htpy s)
    SqLift-htpy-is-torsorial s
      = is-single←equiv
          (Σ-fst-≃ (SqLift-repr≃ G e⁻¹))
          (is-singleton-structure←parts
            (SingS-is-single (SqLift.lift s)) (SqLift.lift s , ~refl)
            (is-single←equiv⁻¹
              (Σ-snd-≃ (λ p
                → tr≃
                    (Arrow-map-path² (SqLift-htpy-boundary s))
                    (concat-Arrow-map-path-left-unit p)))
              (Arrow-map-path²-is-torsorial (SqLift-htpy-boundary s))))

    SqLift-htpy←id-is-equiv
      : (s t : SqLift G) → is-equiv (SqLift-htpy←id {s} {t})
    SqLift-htpy←id-is-equiv s
      = fundamental-Id (SqLift-htpy s) (SqLift-htpy-is-torsorial s)
          (λ _ → SqLift-htpy←id)

    SqLift-htpy≃ : (s t : SqLift G) → (s ＝ t) ≃ SqLift-htpy s t
    SqLift-htpy≃ s t = mk≃ SqLift-htpy←id (SqLift-htpy←id-is-equiv s t)

    SqLift-htpy→ : {s t : SqLift G} → SqLift-htpy s t → s ＝ t
    SqLift-htpy→ = _≃_.bwd (SqLift-htpy≃ _ _)
}
}
