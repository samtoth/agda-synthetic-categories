\subtree[stt-0044]{
\title{Lifts of squares}

\p{Given a morphism of arrows, i.e., a square

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=1-1, to=3-3, phantom, "H"]
\end{tikzcd}
}
then a \em{lift} is a map from the bottom left to the top right, #{\ell \colon B \to X},
such that both evident triangles commute \em{and} such that the pasting
of the triangles agrees with the full square. In other words, it is a completion of
the diagram

\quiver{
\begin{tikzcd}
A && C \\
\\
B && D
\arrow["f"', from=1-1, to=3-1]
\arrow["f'", from=1-3, to=3-3]
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=3-1, to=1-3, dashed, "\ell" description]
\arrow[from=1-1, to=3-3, phantom, "L" very near start, "K" very near end]
\end{tikzcd}
}
which coheres with the original homotopy of the square.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {f' : C → D}
  (G : Arrow-map f f')
  (let g = G .Arrow-map.top)
  (let g' = G .Arrow-map.bot)
  (let H = G .Arrow-map.comm)
  where

  record Lift : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜) where
    constructor mk-lift
    field
      lift : B → C
      L : lift ∘ f ~ g
      K : f' ∘ lift ~ g'
      pastes : f' ◃h L ~ K ▹h f ∙h H {- H ~ K ▹h f ∙h f' ◃h L -}

  unquoteDecl Lift-repr≊ Lift-repr≃
    = make-record-repr Lift-repr≊ Lift-repr≃ (quote Lift)
}
}

\subtree[stt-0047]{
\title{Unique lifts of squares}
\taxon{Definition}

\p{We say a square has unique lifts if its type of lifts is a singleton.}

\agda{
  has-unique-lift : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  has-unique-lift = is-singleton Lift
}
}

\subtree[stt-00ZJ]{
\title{If there is a lift of the identity square then the underlying map is an equivalence}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
is-equiv←self-lift
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  → Lift (id-square: f) → is-equiv f
is-equiv←self-lift s = is-equiv←qinv (Lift.lift s , Lift.L s , Lift.K s)
}
}

\subtree[stt-004K]{
\taxon{Theorem}
\title{Characterising fibres of the pullback power as lifting squares}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
  {C : Type 𝓦} {D : Type 𝓜} (g : C → D)
  where

  pb-power-fibre≃lifts
    : (G : Arrow-map f g) → fibre (pullback-power f g) G ≃ Lift G
  pb-power-fibre≃lifts G
    = Σ-snd-≃ (λ l → Arrow-map-path≃ (pullback-power f g l) G) ∙e Lift-repr≃ G e⁻¹
}
}

\subtree[stt-00YO]{
\title{The lifting square induced by a diagonal}
\taxon{Definition}
\author{fredrikbakke}
\contributor{samueltoth}
\date{2026-09-11}

\p{If #{f} and #{g} are a pair of maps which we view as forming the boundary of a
square, then the power hom #{\pullpow{f}{g}} induces a square for each
\em{diagonal} map, which is a map from the codmain of #{f} to the domain of #{g}. A
diagonal map #{d} is trivially a lifting of #{\pullpow{f}{g}}. We also record the
fact that homotopies of diagonal maps #{d \sim e} induce homotopies of the squares
#{\pullpow{f}{g}(d) \sim \pullpow{f}{g}(e)}.}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type 𝓤} {B : Type 𝓥}
  {C : Type 𝓦} {D : Type 𝓜} {f : A → B} {g : C → D}
  where

  lift-pullback-power : (d : B → C) → Lift (⟨ f , g ⟩ d)
  lift-pullback-power d = mk-lift d ~refl ~refl ~refl

  pullback-power-htpy
    : {d e : B → C} → d ~ e
    → Arrow-map-path (⟨ f , g ⟩ d) (⟨ f , g ⟩ e)
  pullback-power-htpy H
    = (H ▹h f , g ◃h H , (∙h-reflr (g ◃h H ▹h f) h⁻¹))
}
}

\subtree[stt-00YM]{
\title{Homotopies of lifts of squares}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-11}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜}
  {A : Type 𝓤} {B : Type 𝓥} {f : A → B}
  {C : Type 𝓦} {D : Type 𝓜} {g : C → D}
  {G : Arrow-map f g}
  where

  Lift-htpy-boundary
    : (s : Lift G)
    → Arrow-map-path (⟨ f , g ⟩ (Lift.lift s)) G
  Lift-htpy-boundary s = (Lift.L s , Lift.K s , Lift.pastes s)

  coherence-Lift-htpy
    : (s t : Lift G)
    → Lift.lift s ~ Lift.lift t
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  coherence-Lift-htpy s t H
    = Arrow-map-path²
        (Lift-htpy-boundary s)
        (concat-Arrow-map-path (pullback-power-htpy H) (Lift-htpy-boundary t))

  Lift-htpy : (s t : Lift G) → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓜)
  Lift-htpy s t
    = Σ[ H ∶ Lift.lift s ~ Lift.lift t ] coherence-Lift-htpy s t H
}
}

\subtree[stt-00YR]{
\title{Characterising equality of lifts of a square}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-11}

\p{Homotopies of lifts characterise their equality.}

\agda{
  Lift-htpy-refl : {s : Lift G} → Lift-htpy s s
  Lift-htpy-refl {s}
    = ( ~refl
      , Arrow-map-path²←id
          ( sym (concat-Arrow-map-path-left-unit (Lift-htpy-boundary s))))

  Lift-htpy←id : {s t : Lift G} → s ＝ t → Lift-htpy s t
  Lift-htpy←id refl = Lift-htpy-refl

  opaque
    Lift-htpy-is-torsorial : (s : Lift G) → is-torsorial (Lift-htpy s)
    Lift-htpy-is-torsorial s
      = is-single←equiv
          (Σ-fst-≃ (Lift-repr≃ G e⁻¹))
          (is-singleton-structure←parts
            (SingS-is-single (Lift.lift s)) (Lift.lift s , ~refl)
            (is-single←equiv⁻¹
              (Σ-snd-≃ (λ p
                → tr≃
                    (Arrow-map-path² (Lift-htpy-boundary s))
                    (concat-Arrow-map-path-left-unit p)))
              (Arrow-map-path²-is-torsorial (Lift-htpy-boundary s))))

    Lift-htpy←id-is-equiv
      : (s t : Lift G) → is-equiv (Lift-htpy←id {s} {t})
    Lift-htpy←id-is-equiv s
      = fundamental-Id (Lift-htpy s) (Lift-htpy-is-torsorial s) (λ _ → Lift-htpy←id)

    Lift-htpy≃ : (s t : Lift G) → (s ＝ t) ≃ Lift-htpy s t
    Lift-htpy≃ s t = mk≃ Lift-htpy←id (Lift-htpy←id-is-equiv s t)

    Lift-htpy→ : {s t : Lift G} → Lift-htpy s t → s ＝ t
    Lift-htpy→ = _≃_.bwd (Lift-htpy≃ _ _)
}
}
