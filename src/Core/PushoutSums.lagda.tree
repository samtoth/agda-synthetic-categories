\subtree[stt-00EX]{
\taxon{Construction}
\title{Pushout sums of arrows}

\p{
Given an [arrow](stt-0038) #{f : A \to B} and a dependent arrow over it
#{g : (b : B) \to X(b) \to Y(b)}, then we may form the \em{pushout}
#{\pushsum_f g} as the cogap map in the square

\quiver{
\begin{tikzcd}
	(\Sigma_{(a : A)} X(f(a))) && (\Sigma_{(a : A)} Y(f(a)))\\
	& \bullet \\
	(\Sigma_{(b : B)} X(b)) && (\Sigma_{(b : B)} Y(b))
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=3-1, to=3-3]
	\arrow[from=1-3, to=2-2]
	\arrow[from=3-1, to=2-2]
	\arrow[dashed, from=2-2, to=3-3, "{\pushsum_f g}"]
	\arrow[phantom, from=1-1, to=2-2, "\ulcorner" very near end]
\end{tikzcd}
}
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4}
  {A : Type 𝓤1} {B : Type 𝓤2} (f : A → B)
  {X : B → Type 𝓤3} {Y : B → Type 𝓤4} (g : (b : B) → X b → Y b) where

  Σ̂-left : Σ A (X ∘ f) → Σ B X
  Σ̂-left = total-map-fst f

  Σ̂-top : Σ A (X ∘ f) → Σ A (Y ∘ f)
  Σ̂-top = total-map (λ a → g (f a))

  Σ̂-right : Σ A (Y ∘ f) → Σ B Y
  Σ̂-right = total-map-fst f

  Σ̂-bot : Σ B X → Σ B Y
  Σ̂-bot = total-map g

  Σ̂-square : Arrow-map Σ̂-left Σ̂-right
  Σ̂-square = mk-amap Σ̂-top Σ̂-bot ~refl

  Σ̂ : Pushout Σ̂-left Σ̂-top → Σ B Y
  Σ̂ = cogap-map←square Σ̂-square
}
}

\subtree[stt-00BS]{
\title{Pushout product}
\taxon{Definition}

\p{
The pushout product is, in a sense, dual to the [pullback power](stt-004D).
Given a pair of maps #{f : A \to B} and #{g : C \to D}, we construct a square of both
orders of mapping from #{A \times C} to #{B \times D}, one component
at a time. The pushout product, written #{f \pushprod g}, is the cogap
map of this square.
}

\p{
The pushout product is the nondependent case of the [pushout sum](stt-00EX).
}

\agda{
Product-hom
  : {𝓤 𝓥 𝓦 𝓜 : Level}
    {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    {C : Type 𝓦} {D : Type 𝓜} (g : C → D)
  → Arrow-map (f ⊗1 C) (f ⊗1 D)
Product-hom f g .Arrow-map.top = _ 1⊗ g
Product-hom f g .Arrow-map.bot = _ 1⊗ g
Product-hom f g .Arrow-map.comm = ~refl

pushout-product
  : {𝓤 𝓥 𝓦 𝓜 : Level}
    {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    {C : Type 𝓦} {D : Type 𝓜} (g : C → D)
  → Pushout (f ⊗1 C) (A 1⊗ g) → B × D
pushout-product f g = cogap (Cocone←Arrow-map (Product-hom f g) .snd)

infixl 15 _□_
_□_ = pushout-product
}

\p{The pushout product of #{f} with #{g} is sometimes written #{f \pushprod g}.}
}

\subtree[stt-00EY]{
\taxon{Lemma}
\title{Fibre characterisation of the pushout sum}

\p{
The fibres of #{\pushsum_f g} are given as the fibrewise join of #{f} and #{g}.
Given a pair #{(b , y)} in the codomain of #{\pushsum_f g} then we have

##{\fibre{\pushsum_f g}{(b , y)} \simeq \fibre{f}{b} * \fibre{g(b)}{y}.}
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  {A : Type 𝓤1} {B : Type 𝓤2} (f : A → B)
  {X : B → Type 𝓤3} {Y : B → Type 𝓤4} (g : (b : B) → X b → Y b) where

  Σ̂-fibre-fam
    : Fam (𝓤2 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂-fibre-fam
    = Σ B Y
    , fibre (Σ̂ f g)

  Σ̂ᶠ-unstraight-fibre-fam
    : Fam (𝓤2 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂ᶠ-unstraight-fibre-fam = Σ̂ᶠ (fibre-fam f) (fibre-depfam g)

  Σ̂-fibre-family-over
    : (b : B) (y : Y b)
    → Pushout (Σ̂-left f g) (Σ̂-top f g)
    → Type (𝓤2 ⊔ 𝓤4)
  Σ̂-fibre-family-over b y p = (Σ̂ f g p ＝ (b , y))

  Σ̂-fibre-total-span
    : (b : B) (y : Y b)
    → Span (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  Σ̂-fibre-total-span b y
    = total-span (Σ̂-left f g) (Σ̂-top f g) (Σ̂-fibre-family-over b y)

  private
    module Σ̂-fibre-total-span (b : B) (y : Y b) = Span (Σ̂-fibre-total-span b y)

  Σ̂-cogap-fibre-at
    : (b : B) (y : Y b)
    → fibre (Σ̂ f g) (b , y)
    ≃ Pushout
        (Σ̂-fibre-total-span.left b y)
        (Σ̂-fibre-total-span.right b y)
  Σ̂-cogap-fibre-at b y
    = cogap-fibre (Cocone←Arrow-map (Σ̂-square f g) .snd) (b , y)

  fibre-Σ̂-right≃fibre-base
    : (b : B) (y : Y b)
    → fibre (Σ̂-right f g) (b , y) ≃ fibre f b
  fibre-Σ̂-right≃fibre-base b y = fibre-total-map-fst f b y

  Σ̂-fibre-total-span-centre≃fibrewise-product
    : (b : B) (y : Y b)
    → Σ̂-fibre-total-span.Centre b y
    ≃ (fibre f b × fibre (g b) y)
  Σ̂-fibre-total-span-centre≃fibrewise-product b y
    = fibre-map-Σ-over f g b y

  Σ̂-fibre-span-equiv
    : (b : B) (y : Y b)
    → Span-equiv
        (mk-span (fibre f b × fibre (g b) y) snd fst)
        (mk-span
          (Σ̂-fibre-total-span.Centre b y)
          (Σ̂-fibre-total-span.left b y)
          (Σ̂-fibre-total-span.right b y))
  Σ̂-fibre-span-equiv b y = span-equiv where
    Centre₀ : Type (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
    Centre₀ = Σ̂-fibre-total-span.Centre b y

    left₀ : Centre₀ → Σ̂-fibre-total-span.Left b y
    left₀ = Σ̂-fibre-total-span.left b y

    right₀ : Centre₀ → Σ̂-fibre-total-span.Right b y
    right₀ = Σ̂-fibre-total-span.right b y

    left≃ : Σ̂-fibre-total-span.Left b y ≃ fibre (g b) y
    left≃ = fibre-total-map {f = g} {a = b} {b = y}

    right≃ : Σ̂-fibre-total-span.Right b y ≃ fibre f b
    right≃ = fibre-Σ̂-right≃fibre-base b y

    centre≃ : Centre₀ ≃ (fibre f b × fibre (g b) y)
    centre≃ = Σ̂-fibre-total-span-centre≃fibrewise-product b y

    left₀~left'
      : _≃_.bwd left≃ ∘ snd ∘ _≃_.fwd centre≃ ~ left₀
    left₀~left' ((a , x) , p) = fibre-map-Σ-over-left f g b y a x p ∙ sym α where
      l₀ : Σ̂-fibre-total-span.Left b y
      l₀ = (f a , x) , p

      β : tr (Σ̂-fibre-family-over b y) (sym (glue (a , x))) p ＝ p
      β
        = Idᵈ-const-coe (Σ̂ f g) (sym (glue (a , x))) p
        ∙ ap (_∙ p) (ap (ap (Σ̂ f g)) (sym-sym {p = glue (a , x)}))
        ∙ ap (_∙ p) (pushout-rec-apβ (a , x))

      α : left₀ ((a , x) , p) ＝ l₀
      α = Σ-path→ (refl , β)

    right₀~right'
      : _≃_.bwd right≃ ∘ fst ∘ _≃_.fwd centre≃ ~ right₀
    right₀~right' t = _≃_.η right≃ (right₀ t)

    left-comm
      : _≃_.fwd left≃ ∘ left₀ ~ snd ∘ _≃_.fwd centre≃
    left-comm p
      = sym (ap (_≃_.fwd left≃) (left₀~left' p))
      ∙ _≃_.ε left≃ (snd (_≃_.fwd centre≃ p))

    right-comm
      : _≃_.fwd right≃ ∘ right₀ ~ fst ∘ _≃_.fwd centre≃
    right-comm p
      = sym (ap (_≃_.fwd right≃) (right₀~right' p))
      ∙ _≃_.ε right≃ (fst (_≃_.fwd centre≃ p))

    span-equiv
      : Span-equiv
          (mk-span (fibre f b × fibre (g b) y) snd fst)
          (mk-span Centre₀ left₀ right₀)
    span-equiv
      = Span-equiv←inverse-components
          ( centre≃
          , left≃
          , left-comm
          , right≃
          , right-comm)

  Σ̂-fibre≃fibrewise-join
    : ((b , y) : Σ B Y)
    → fibre (Σ̂ f g) (b , y) ≃ fibre f b * fibre (g b) y
  Σ̂-fibre≃fibrewise-join (b , y)
    = fibre (Σ̂ f g) (b , y)                  ≃⟨ Σ̂-cogap-fibre-at b y ⟩
      Pushout (Σ̂-fibre-total-span.left b y)
              (Σ̂-fibre-total-span.right b y) ≃⟨ Pushout≃←Span-equiv (Σ̂-fibre-span-equiv b y) ∙e pushout-comm ⟩
      (fibre f b * fibre (g b) y)            ≃∎

  Σ̂-unstraighten≃ᶠ
    : Σ̂-fibre-fam ≃ᶠ Σ̂ᶠ-unstraight-fibre-fam
  Σ̂-unstraighten≃ᶠ
    = id≃
    , Σ̂-fibre≃fibrewise-join
}
}

\subtree[stt-00F0]{
\taxon{Theorem}
\title{The equivalence of unstraightened pushout sums}

\agda{
module _ {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
         (B'@(A , B) : Fam 𝓤1 𝓤2)
         (Y'@(X , Y) : DepFam 𝓤3 𝓤4 B')
         (let fᵘ = fst {A = A} {B = B})
         (let gᵘ = λ a → fst {A = X a} {B = Y a})
         (let Bᵘˢ = fibre-fam fᵘ)
         (let Yᵘˢ = fibre-depfam gᵘ) where

  Σ̂ᶠ-fibre-fam-unstraight
    : Fam (𝓤1 ⊔ 𝓤3) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  Σ̂ᶠ-fibre-fam-unstraight = Σ̂ᶠ Bᵘˢ Y'

  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight
    : Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ ≃ᶠ Σ̂ᶠ-fibre-fam-unstraight
  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight
    = Σ̂ᶠ-≃ᶠ Bᵘˢ Yᵘˢ Y' (λ a → (id≃ , fibre-straighten (Y a)))
}
}

\subtree[stt-00F2]{
\taxon{Theorem}
\title{The equivalence of straightened pushout sums}


\p{
Given families #{B : A \to \UU} and #{Y : (a : A) \to X a \to \UV}, their
fibrewise pushout sum is equivalent, as a family, to the straightening of the pushout
sum of total space projections.

##{\pushsum^{\mathrm f} B\ Y \simeq \pushsum_{\text{straight}} B\ Y}
}

\p{
In other words the fibre family of the pushout sum of their unstraightenings,
#{\pushsum_{B^{\mathrm u}}Y^{\mathrm u}}, is the pushout sum of #{B} and #{Y}.

\quiver{
\begin{tikzcd}
	(\Sigma_{((a , b) : \Sigma_{(a : A)} B(a))} \Sigma_{(x : X(a))}{Y(a , x)}) && (\Sigma_{((a , b) : \Sigma_{(a : A)} B(a))} X(a))\\
	& \bullet \\
	(\Sigma_{(a : A)} \Sigma_{(x : X(a))}{Y(a, x)}) && (\Sigma_{(a : A)} X(a))
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=3-1, to=3-3]
	\arrow[from=1-3, to=2-2]
	\arrow[from=3-1, to=2-2]
	\arrow[dashed, from=2-2, to=3-3, "{\pushsum_{B^{\mathrm u}}Y^{\mathrm u}}"]
	\arrow[phantom, from=1-1, to=2-2, "\ulcorner" very near end]
\end{tikzcd}
}
}

\agda{
module _ {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
         (B'@(A , B) : Fam 𝓤1 𝓤2)
         (Y'@(X , Y) : DepFam 𝓤3 𝓤4 B')
         (let fᵘ = fst {A = A} {B = B})
         (let gᵘ = λ a → fst {A = X a} {B = Y a})
         (let Bᵘˢ = fibre-fam fᵘ)
         (let Yᵘˢ = fibre-depfam gᵘ) where

  Σ̂-straight
    : Fam (𝓤1 ⊔ 𝓤3) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂-straight = Σ̂-fibre-fam fᵘ gᵘ

  Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam
    : Σ̂-straight ≃ᶠ Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ
  Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam
    = Σ̂-unstraighten≃ᶠ fᵘ gᵘ

  Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ
    : Σ̂ᶠ-fibre-fam-unstraight B' Y' ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ
    = Σ̂ᶠ-base-fam Y' (fibre-straighten B)

  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ
    : Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ
    = concat≃ᶠ
        (Σ̂ᶠ B' Y')
        (Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight B' Y')
        (Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ)

  Σ̂-straighten≃ᶠ : Σ̂-straight ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂-straighten≃ᶠ
    = concat≃ᶠ
        (Σ̂ᶠ B' Y')
        (Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam)
        (Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ)
}
}

\subtree[fre-1010]{
\date{2026-03-24}
\author{fredrikbakke}
\taxon{Theorem}
\title{Pushouts of products as sums of joins}

% TODO: generalise, and fit in common framework

\agda{
module Pushout-id⊗fst-snd
  {𝓤 𝓥 𝓦} {T : Type 𝓤} (P : Type 𝓥) (Q : T → Type 𝓦)
  where

  Pushout→Σ*
    : Pushout ((id: P) ⊗ (fst: Q)) (snd: (λ _ → Σ T Q))
    → Σ T (λ t → P * Q t)
  Pushout→Σ*
    = pushout-rec
        (mk-cocone
          (λ (p , t) → (t , ι₁ p))
          (λ (t , q) → (t , ι₂ q))
          (λ (p , (t , q)) → Σ-path→ (refl , glue (p , q))))

  Σ*→Pushout
    : Σ T (λ t → P * Q t)
    → Pushout ((id: P) ⊗ (fst: Q)) (snd: (λ _ → Σ T Q))
  Σ*→Pushout (t , d)
    = pushout-rec
        (mk-cocone
          (λ p → ι₁ (p , t))
          (λ q → ι₂ (t , q))
          (λ (p , q) → glue (p , (t , q))))
        d

  Pushout→Σ*-β
    : (p : P) (t : T) (q : Q t)
    → ap Pushout→Σ* (glue (p , (t , q)))
      ＝ Σ-path→ (refl , glue (p , q))
  Pushout→Σ*-β p t q = pushout-rec-apβ (p , (t , q))

  Σ-path→-refl-,
    : (t : T) {d d' : P * Q t} (q : d ＝ d')
    → Σ-path→
        {A = T} {B = λ t → P * Q t}
        {x = (t , d)} {y = (t , d')}
        (refl , q)
      ＝ ap (t ,_) q
  Σ-path→-refl-, t refl = refl

  Σ*→Pushout-β
    : (p : P) (t : T) (q : Q t)
    → ap Σ*→Pushout (Σ-path→ (refl , glue (p , q)))
      ＝ glue (p , (t , q))
  Σ*→Pushout-β p t q
    = ap (ap Σ*→Pushout) (Σ-path→-refl-, t (glue (p , q)))
    ∙ sym (ap-∘ Σ*→Pushout (t ,_) (glue (p , q)))
    ∙ pushout-rec-apβ (p , q)

  Pushout≃Σ*-qiso : quasi-inv Pushout→Σ*
  Pushout≃Σ*-qiso .fst = Σ*→Pushout
  Pushout≃Σ*-qiso .snd .fst x
    = to-rec ∙ sym id-to-rec where

    to-rec
      : Σ*→Pushout (Pushout→Σ* x) ＝ pushout-rec pushout x
    to-rec
      = pushout-rec-unique _ _
          ~refl ~refl
          ( λ (p , (t , q)) →
            ∙-reflr _
            ∙ ap-∘ Σ*→Pushout Pushout→Σ* (glue (p , (t , q)))
            ∙ ap (ap Σ*→Pushout) (Pushout→Σ*-β p t q)
            ∙ Σ*→Pushout-β p t q)
          x

    id-to-rec
      : x ＝ pushout-rec pushout x
    id-to-rec
      = pushout-rec-unique _ _
          ~refl ~refl
          (λ a → ∙-reflr _ ∙ ap-id (glue a))
          x

  Pushout≃Σ*-qiso .snd .snd (t , d)
    = to-rec ∙ sym pair-to-rec where

    C : Cocone (mk-span (P × Q t) fst snd) (Σ T (λ t → P * Q t))
    C = mk-cocone
          (λ p → (t , ι₁ p))
          (λ q → (t , ι₂ q))
          (λ pq → Σ-path→ (refl , glue pq))

    F : P * Q t → Σ T (λ t → P * Q t)
    F d = Pushout→Σ* (Σ*→Pushout (t , d))

    to-rec
      : F d ＝ pushout-rec C d
    to-rec
      = pushout-rec-unique C F
          ~refl ~refl
          ( λ (p , q) →
            ∙-reflr _
            ∙ ap-∘ Pushout→Σ* (λ d → Σ*→Pushout (t , d)) (glue (p , q))
            ∙ ap (ap Pushout→Σ*) (pushout-rec-apβ (p , q))
            ∙ Pushout→Σ*-β p t q)
          d

    pair-to-rec
      : (t , d) ＝ pushout-rec C d
    pair-to-rec
      = pushout-rec-unique C
          (t ,_)
          ~refl ~refl
          (λ pq → ∙-reflr _ ∙ sym (Σ-path→-refl-, t (glue pq)))
          d

  Pushout≃Σ*
    : Pushout ((id: P) ⊗ (fst: Q)) (snd: (λ _ → Σ T Q))
      ≃ Σ T (λ t → P * Q t)
  Pushout≃Σ* = mk≃ _ (is-equiv←qinv Pushout≃Σ*-qiso)
}
}
