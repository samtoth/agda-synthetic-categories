\subtree[stt-00EX]{
\title{Pushout sums of arrows}
\taxon{Construction}

\p{
Given an [arrow](stt-0038) #{f \colon A \to B} and a dependent arrow over it
#{g \colon \Pi1{b : B}{X(b) \to Y(b)}}, then we may form the \em{pushout}
#{\pushsum_f g} as the cogap map in the square

\quiver{
\begin{tikzcd}
	\Sigma1{a : A}{X(f(a))} && \Sigma1{a : A}{Y(f(a))}\\
	& \bullet \\
	\Sigma1{b : B}{X(b)} && \Sigma1{b : B}{Y(b)}
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=3-1, to=3-3]
	\arrow[from=1-3, to=2-2]
	\arrow[from=3-1, to=2-2]
	\arrow[dashed, from=2-2, to=3-3, "{\pushsum_f g}"]
	\arrow[phantom, from=1-1, to=2-2, "\ulcorner" very near end]
\end{tikzcd}
}
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4}
  {A : Type 𝓤1} {B : Type 𝓤2} (f : A → B)
  {X : B → Type 𝓤3} {Y : B → Type 𝓤4} (g : (b : B) → X b → Y b)
  where

  Σ̂-left : Σ A (X ∘ f) → Σ B X
  Σ̂-left = total-map-fst f

  Σ̂-top : Σ A (X ∘ f) → Σ A (Y ∘ f)
  Σ̂-top = total-map (λ a → g (f a))

  Σ̂-right : Σ A (Y ∘ f) → Σ B Y
  Σ̂-right = total-map-fst f

  Σ̂-bot : Σ B X → Σ B Y
  Σ̂-bot = total-map g

  Σ̂-square : Arrow-map Σ̂-left Σ̂-right
  Σ̂-square = mk-amap Σ̂-top Σ̂-bot ~refl

  Σ̂ : Pushout Σ̂-left Σ̂-top → Σ B Y
  Σ̂ = cogap-square Σ̂-square
}
}

\subtree[stt-00BS]{
\title{Pushout product}
\taxon{Definition}

\p{
The pushout product is, in a sense, dual to the [pullback power](stt-004D).
Given a pair of maps #{f \colon A \to B} and #{g \colon C \to D}, we construct a
square of both orders of mapping from #{A \times C} to #{B \times D}, one component
at a time. The pushout product, written #{f \pushprod g}, is the cogap map of this
square.
}

\p{
The pushout product is the nondependent case of the [pushout sum](stt-00EX).
}

\agda{
Product-hom
  : {𝓤 𝓥 𝓦 𝓜 : Level}
    {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    {C : Type 𝓦} {D : Type 𝓜} (g : C → D)
  → Arrow-map (f ×₁1 C) (f ×₁1 D)
Product-hom f g .Arrow-map.top = _ 1×₁ g
Product-hom f g .Arrow-map.bot = _ 1×₁ g
Product-hom f g .Arrow-map.comm = ~refl

pushout-product
  : {𝓤 𝓥 𝓦 𝓜 : Level}
    {A : Type 𝓤} {B : Type 𝓥} (f : A → B)
    {C : Type 𝓦} {D : Type 𝓜} (g : C → D)
  → Pushout (f ×₁1 C) (A 1×₁ g) → B × D
pushout-product f g = cogap (Cocone←Arrow-map (Product-hom f g) .snd)

infixl 15 _□_
_□_ = pushout-product
}

\p{The pushout product of #{f} with #{g} is sometimes written #{f \pushprod g}.}
}

\subtree[stt-00EY]{
\title{Fibre characterisation of the pushout sum}
\taxon{Lemma}

\p{
The fibres of #{\pushsum_f g} are given as the fibrewise join of #{f} and #{g}.
Given a pair #{(b , y)} in the codomain of #{\pushsum_f g} then we have

##{\fibre{\pushsum_f g}{(b , y)} \simeq \fibre{f}{b} * \fibre{g(b)}{y}.}
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  {A : Type 𝓤1} {B : Type 𝓤2} (f : A → B)
  {X : B → Type 𝓤3} {Y : B → Type 𝓤4} (g : (b : B) → X b → Y b)
  where

  Σ̂-fibre-fam
    : Fam (𝓤2 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂-fibre-fam = (Σ B Y , fibre (Σ̂ f g))

  Σ̂ᶠ-unstraight-fibre-fam
    : Fam (𝓤2 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂ᶠ-unstraight-fibre-fam = Σ̂ᶠ (fibre-fam f) (fibre-depfam g)

  Σ̂-fibre-family-over
    : (b : B) (y : Y b)
    → Pushout (Σ̂-left f g) (Σ̂-top f g)
    → Type (𝓤2 ⊔ 𝓤4)
  Σ̂-fibre-family-over b y p = (Σ̂ f g p ＝ (b , y))

  Σ̂-fibre-total-span
    : (b : B) (y : Y b)
    → Span (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤2 ⊔ 𝓤3 ⊔ 𝓤4) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  Σ̂-fibre-total-span b y
    = total-span (Σ̂-left f g) (Σ̂-top f g) (Σ̂-fibre-family-over b y)

  module _
    (b : B) (y : Y b)
    (let module Σ̂-fibre-total-span = Span (Σ̂-fibre-total-span b y))
    where

    Σ̂-cogap-fibre-at
      : fibre (Σ̂ f g) (b , y)
      ≃ Pushout Σ̂-fibre-total-span.left Σ̂-fibre-total-span.right
    Σ̂-cogap-fibre-at
      = cogap-fibre (Cocone←Arrow-map (Σ̂-square f g) .snd) (b , y)

    fibre-Σ̂-right≃fibre-base
      : fibre (Σ̂-right f g) (b , y) ≃ fibre f b
    fibre-Σ̂-right≃fibre-base
      = fibre≃total-map-fst f b y

    Σ̂-fibre-total-span-centre≃fibrewise-product
      : Σ̂-fibre-total-span.Centre
      ≃ (fibre f b × fibre (g b) y)
    Σ̂-fibre-total-span-centre≃fibrewise-product
      = fibre-map-Σ-over f g b y

    Σ̂-fibre-span-components
      : Span-equiv'
          (Σ̂-fibre-total-span b y)
          (mk-span (fibre f b × fibre (g b) y) snd fst)
    Σ̂-fibre-span-components
      = (centre≃ , left≃ , left-comm , right≃ , right-comm)
      where
      left≃ : Σ̂-fibre-total-span.Left ≃ fibre (g b) y
      left≃ = fibre≃total-map {f = g} {a = b} {b = y}

      right≃ : Σ̂-fibre-total-span.Right ≃ fibre f b
      right≃ = fibre-Σ̂-right≃fibre-base

      centre≃ : Σ̂-fibre-total-span.Centre ≃ (fibre f b × fibre (g b) y)
      centre≃ = Σ̂-fibre-total-span-centre≃fibrewise-product

      left₀~left'
        : _≃_.bwd left≃ ∘ snd ∘ centre≃ ._≃_.fwd
        ~ Σ̂-fibre-total-span.left
      left₀~left' ((a , x) , p)
        = fibre-map-Σ-over-left f g b y a x p ∙ sym α
        where
        β : tr (Σ̂-fibre-family-over b y) (sym (glue (a , x))) p ＝ p
        β
          = Idᵈ-const-coe (Σ̂ f g) (sym (glue (a , x))) p
          ∙ (ap (ap (Σ̂ f g)) (sym-sym {p = glue (a , x)}) ▸ p)
          ∙ (pushout-rec-apβ (a , x) ▸ p)

        α : Σ̂-fibre-total-span.left ((a , x) , p) ＝ ((f a , x) , p)
        α = Σ-path→ (refl , β)

      left-comm
        : left≃ ._≃_.fwd ∘ Σ̂-fibre-total-span.left
        ~ snd ∘ centre≃ ._≃_.fwd
      left-comm
        = (left≃ ._≃_.fwd ◃h (left₀~left' h⁻¹))
        ∙h (_≃_.ε left≃ ▹h (snd ∘ centre≃ ._≃_.fwd))

      right-comm
        : right≃ ._≃_.fwd ∘ Σ̂-fibre-total-span.right
        ~ fst ∘ centre≃ ._≃_.fwd
      right-comm
        = (right≃ ._≃_.fwd ◃h ((_≃_.η right≃ ▹h Σ̂-fibre-total-span.right) h⁻¹))
        ∙h (_≃_.ε right≃ ▹h (fst ∘ centre≃ ._≃_.fwd))

    Σ̂-fibre-span-equiv
      : Span-equiv
          (Σ̂-fibre-total-span b y)
          (mk-span (fibre f b × fibre (g b) y) snd fst)
    Σ̂-fibre-span-equiv
      = Span-equiv←components Σ̂-fibre-span-components

  Σ̂-fibre≃fibrewise-join
    : ((b , y) : Σ B Y)
    → fibre (Σ̂ f g) (b , y) ≃ fibre f b * fibre (g b) y
  Σ̂-fibre≃fibrewise-join (b , y)
    = fibre (Σ̂ f g) (b , y)
        ≃⟨ Σ̂-cogap-fibre-at b y ⟩
      Pushout
        (Span.left (Σ̂-fibre-total-span b y))
        (Span.right (Σ̂-fibre-total-span b y))
        ≃⟨ Pushout≃←Span-equiv' (Σ̂-fibre-span-components b y) ⟩
      Pushout snd fst
        ≃⟨ pushout-comm ⟩
      (fibre f b * fibre (g b) y)
        ≃∎

  Σ̂-unstraighten≃ᶠ : Σ̂-fibre-fam ≃ᶠ Σ̂ᶠ-unstraight-fibre-fam
  Σ̂-unstraighten≃ᶠ = (id≃ , Σ̂-fibre≃fibrewise-join)
}
}

\subtree[stt-00F0]{
\title{The equivalence of unstraightened pushout sums}
\taxon{Theorem}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  (B'@(A , B) : Fam 𝓤1 𝓤2)
  (Y'@(X , Y) : DepFam 𝓤3 𝓤4 B')
  (let fᵘ = fst {A = A} {B = B})
  (let gᵘ = λ a → fst {A = X a} {B = Y a})
  (let Bᵘˢ = fibre-fam fᵘ)
  (let Yᵘˢ = fibre-depfam gᵘ)
  where

  Σ̂ᶠ-fibre-fam-unstraight
    : Fam (𝓤1 ⊔ 𝓤3) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤4)
  Σ̂ᶠ-fibre-fam-unstraight = Σ̂ᶠ Bᵘˢ Y'

  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight
    : Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ ≃ᶠ Σ̂ᶠ-fibre-fam-unstraight
  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight
    = Σ̂ᶠ-≃ᶠ Bᵘˢ Yᵘˢ Y' (λ a → (id≃ , fibre-straighten (Y a)))
}
}

\subtree[stt-00F2]{
\title{Straightening pushout sums of total space projections}
\taxon{Theorem}

\p{
Given families #{B \colon A \to \UU} and #{Y \colon \Pi1{a : A}{X a \to \UV}}, their
fibrewise pushout sum is equivalent, as a family, to the straightening of the pushout
sum of total space projections.

##{\pushsum^{\mathrm f} B\ Y \simeq \pushsum_{\text{straight}} B\ Y}
}

\p{
In other words the fibre family of the pushout sum of their unstraightenings,
#{\pushsum_{B^{\mathrm u}}Y^{\mathrm u}}, is the pushout sum of #{B} and #{Y}.

\quiver{
\begin{tikzcd}
	(\Sigma2{(a , b) : \Sigma1{a : A}{B(a)}}{x : X(a)}{Y(a , x)})
  && (\Sigma1{(a , b) : \Sigma1{a : A}{B(a)}}{X(a)})\\
	& \bullet \\
	(\Sigma2{a : A}{x : X(a)}{Y(a, x)}) && (\Sigma1{a : A}{X(a)})
	\arrow[from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow[from=3-1, to=3-3]
	\arrow[from=1-3, to=2-2]
	\arrow[from=3-1, to=2-2]
	\arrow[dashed, from=2-2, to=3-3, "{\pushsum_{B^{\mathrm u}}Y^{\mathrm u}}"]
	\arrow[phantom, from=1-1, to=2-2, "\ulcorner" very near end]
\end{tikzcd}
}
}

\agda{
module _
  {𝓤1 𝓤2 𝓤3 𝓤4 : Level}
  (B'@(A , B) : Fam 𝓤1 𝓤2)
  (Y'@(X , Y) : DepFam 𝓤3 𝓤4 B')
  (let fᵘ = fst {A = A} {B = B})
  (let gᵘ = λ a → fst {A = X a} {B = Y a})
  (let Bᵘˢ = fibre-fam fᵘ)
  (let Yᵘˢ = fibre-depfam gᵘ)
  where

  Σ̂-straight
    : Fam (𝓤1 ⊔ 𝓤3) (𝓤1 ⊔ 𝓤2 ⊔ 𝓤3 ⊔ 𝓤4)
  Σ̂-straight = Σ̂-fibre-fam fᵘ gᵘ

  Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam
    : Σ̂-straight ≃ᶠ Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ
  Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam
    = Σ̂-unstraighten≃ᶠ fᵘ gᵘ

  Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ
    : Σ̂ᶠ-fibre-fam-unstraight B' Y' ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ
    = Σ̂ᶠ-base-fam Y' (fibre-straighten B)

  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ
    : Σ̂ᶠ-unstraight-fibre-fam fᵘ gᵘ ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ
    = concat≃ᶠ
        (Σ̂ᶠ B' Y')
        (Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ-fibre-fam-unstraight B' Y')
        (Σ̂ᶠ-fibre-fam-unstraight≃Σ̂ᶠ)

  Σ̂-straighten≃ᶠ : Σ̂-straight ≃ᶠ Σ̂ᶠ B' Y'
  Σ̂-straighten≃ᶠ
    = concat≃ᶠ
        (Σ̂ᶠ B' Y')
        (Σ̂-straight≃Σ̂ᶠ-unstraight-fibre-fam)
        (Σ̂ᶠ-unstraight-fibre-fam≃Σ̂ᶠ)
}
}
