\date{2025-03-04}
\title{Split Idempotent}
\taxon{Definition}

\import{stt-macros}

\p{Given an endomorphism #{p \colon X \to X} in a category #{\CC}, we say that it is a split idempotent if:

\ul{
\li{There exists a retract
of #{X} - that is a triple #{(Y,r,s) : \Sigma2{Y \colon \CC}{r \colon X \to Y}{(Y \to X)}} such that #{r \circ s = \id_Y}}

\li{The composition, #{s \circ r} is equal to #{p}}
}
}
