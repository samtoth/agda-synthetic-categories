\title{#{♭}-connected maps}
\taxon{Module}
\author{samueltoth}
\date{2026-09-10}
\import{stt-macros}

\agda{
module Modalities.Cohesion.FlatConnectedMaps where

open import Axioms.FunExt
open import Axioms.CanonicalPushouts
}

