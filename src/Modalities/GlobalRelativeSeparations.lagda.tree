\date{2026-09-17}
\title{Global relative separations}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\agda{
module Modalities.GlobalRelativeSeparations where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Foundations.ComplementedEmbeddings
open import Core.RelativeSuspensions
open import Core.RelativeSuspensionsFunctoriality
open import Modalities.ReflectiveSubuniverses
open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.Instances.Localisation
open import Modalities.SeparatedTypes
}
