\subtree[bak-68A4]{
\title{Types over a base}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-23}

\p{
For a type #{B : \UU}, a \em{bundle} over #{B} with domain in #{\UV} consists of a
type #{E : \UV} together with a map #{E \to B}.
}

\agda{
Bundle : ∀ {𝓤} (𝓥 : Level) (B : Type 𝓤) → Type (𝓤 ⊔ lsuc 𝓥)
Bundle 𝓥 B = Σ[ E ∶ Type 𝓥 ] (E → B)
}
}

\subtree[stt-003S]{
\taxon{Theorem}
\title{Replacement by fibres}

\p{Given a map #{p \colon E \to B}, the type #{\Sigma1{b:B}{\fibre{p}{b}}}
is equivalent to the type #{E}. }

\agda{
total←total-fibre
  : ∀ {𝓤} {B : Type 𝓤}
      {𝓥} {A : Type 𝓥} (p : A → B)
    → total-fibre p → A
total←total-fibre p (_ , a , _) = a

refl-fibre
  : ∀ {𝓤} {B : Type 𝓤}
      {𝓥} {A : Type 𝓥} (p : A → B)
    → A → total-fibre  p
refl-fibre p a = (p a , a , refl)

total≃total-fibre
  : ∀ {𝓤} {B : Type 𝓤}
      {𝓥} {A : Type 𝓥} (p : A → B)
    → total-fibre p ≃ A
total≃total-fibre {A = A} p
 = mk≃ (total←total-fibre p) (is-equiv←qinv f-qinv) where
  f-qinv : quasi-inv (total←total-fibre p)
  f-qinv .fst = refl-fibre p
  f-qinv .snd .fst (_ , a , refl) = refl
  f-qinv .snd .snd a = refl
}
}

\agda{
module WithUA (𝓤 𝓥 : Level) (UU : is-univalent (𝓤 ⊔ 𝓥)) (FE : FunExt-global) where
  open WithLocalUnivalence UU
  open WithFunExt-global FE
}

\subtree[stt-003Q]{
\title{Straightening}
\taxon{Theorem}
\contributor{fredrikbakke}
\date{2025-08-06}

\p{
Under the assumption of univalence, given a base type #{B : \UU}, we can define an
equivalence between types \em{over} #{B} — #{\Sigma1{E : \UU \cup \UV}{(E \to B)}}
and type families #{B \to \UU \cup \UV}. The former type is said to be the
\em{unstraightened} version of the latter — and the latter is said to be the
em{straightened} version of the former. We also call the unstraightened perspective
\em{fibred} and the \em{straightened} perspective \em{indexed}.
}

\agda{
  straighten : {B : Type 𝓤} → Bundle (𝓤 ⊔ 𝓥) B → B → Type (𝓤 ⊔ 𝓥)
  straighten (E , p) = fibre p

  unstraighten : {B : Type 𝓤} → (B → Type (𝓤 ⊔ 𝓥)) → Bundle (𝓤 ⊔ 𝓥) B
  unstraighten {B} P = (Σ _ P , fst)

  straighten-qinv : {B : Type 𝓤} → quasi-inv (straighten {B})
  straighten-qinv .fst = unstraighten
  straighten-qinv .snd .snd P
    = funext→ (λ b → ua (fibre-straighten P b))
  straighten-qinv .snd .fst (E , p)
    = Σ-path→
      ( ua (total≃total-fibre p)
      , tr-→-domain (ua (total≃total-fibre p)) fst ∙ ap (fst ∘_) coe-sym-ua)

  straighten-is-equiv : {B : Type 𝓤} → is-equiv (straighten {B})
  straighten-is-equiv = is-equiv←qinv straighten-qinv

  straighten≃ : {B : Type 𝓤} → Bundle (𝓤 ⊔ 𝓥) B ≃ (B → Type (𝓤 ⊔ 𝓥))
  straighten≃ = mk≃ _ straighten-is-equiv

  unstraighten-is-equiv : {B : Type 𝓤} → is-equiv (unstraighten {B})
  unstraighten-is-equiv = is-equiv⁻¹ straighten-is-equiv

  unstraighten≃ : {B : Type 𝓤} → (B → Type (𝓤 ⊔ 𝓥)) ≃ Bundle (𝓤 ⊔ 𝓥) B
  unstraighten≃ = mk≃ _ unstraighten-is-equiv
}
}
