\title{Coherently idempotent maps}
\taxon{Module}

\import{stt-macros}

\agda{
{-# OPTIONS --lossy-unification #-}

open import Foundations.FunExt

module Foundations.IdempotentMaps where
}

\agda-imports{
\agda{
open import Foundations.Universes
open import Foundations.SplittingConstruction
open import Foundations.QuasiidempotentMaps
open import Foundations.Sigma
open import Foundations.Nat
open import Foundations.Univalence
open import Foundations.Equivalences
open import Foundations.Retracts
open import Foundations.FibrewiseEquivalences

import Foundations.IsEquivIsProp
}
}

\subtree[stt-00IG]{
\date{2026-03-11}
\author{fredrikbakke}
\taxon{Definition}
\title{Coherently idempotent maps}

\p{
A \em{(coherently) idempotent map} is a map #{f : X \to X} equipped with a sequence
of [quasiidempotences](stt-00II) #{H} indexed by the
[natural numbers](Foundations.Nat) such that #{H_n} is the [splitting](stt-00HC) of
#{H_{n+1}} for all #{n}.
}

\agda{
module CohIdemWithFunExt
  (FE : FunExt-global)
  (open QIdemWithFunExt FE)
  (open SplittingWithFunExt FE)
  where

  module _ {𝓤} {X : Type 𝓤}  where

    step-qidempotence
      : {f : X → X} → qidempotence f → qidempotence f
    step-qidempotence {f = f} H
      = SmallRetractsWithFunExt.step-qidempotent-map FE X (f , H) .snd

    idempotence-coherence
      : {f : X → X}
      → (ℕ → qidempotence f)
      → Type 𝓤
    idempotence-coherence {f = f} H
      = (n : ℕ)
      → qidempotence-htpy (H n) (step-qidempotence {f = f} (H (suc n)))

    idempotence : (X → X) → Type 𝓤
    idempotence f
      = Σ[ H ∶ (ℕ → qidempotence f) ] idempotence-coherence {f = f} H

  idempotent-map : ∀ {𝓤} → Type 𝓤 → Type 𝓤
  idempotent-map X = Σ[ f ∶ (X → X) ] idempotence f

  module _ {𝓤} {X : Type 𝓤} {f : X → X} where

    Splitting-step-qidempotence≃idempotence
      : Splitting.type step-qidempotence ≃ idempotence f
    Splitting-step-qidempotence≃idempotence
      = Σ-snd-≃ (λ H → Foundations.IsEquivIsProp.Π-fam-≃ FE (λ n
        → Id≃qidempotence-htpy (H n) (step-qidempotence {f = f} (H (suc n)))))
}

\agda{
  module _ {𝓤} {X : Type 𝓤} (open SmallRetractsWithFunExt FE X) where

    Splitting-step-qidempotent-map≃idempotent-map
      : Splitting.type step-qidempotent-map ≃ idempotent-map X
    Splitting-step-qidempotent-map≃idempotent-map
      = splitting-total-map (λ f → step-qidempotence {f = f})
      ∙e Σ-snd-≃ (λ f → Splitting-step-qidempotence≃idempotence {f = f})

    idempotence←qidempotence
      : {f : X → X} → qidempotence f → idempotence f
    idempotence←qidempotence {f} H
      = _≃_.fwd Splitting-step-qidempotent-map≃idempotent-map
          (Splitting.map-retraction step-qidempotent-map
            step-qidempotent-map-is-preidempotent (f , H)) .snd
}
}

\subtree[stt-006R]{
\date{2026-03-25}
\author{fredrikbakke}
\taxon{Theorem}
\title{The universe of retracts is equivalent to the type of idempotent maps}

\p{
The splitting type of the composite map
#{\mathrm{QIdem}(X) \to \mathrm{Retracts}(X) \to \mathrm{QIdem}(X)} is the type of
[idempotent maps](stt-00IG) on #{X}, but these maps already split, so by
[essential uniqueness](stt-006W) of splitting types, the universe of retracts of
#{X} is equivalent to the type of idempotent maps on #{X}.
}

\agda{
module RetractsIdemWithFunExtUnivalence
  (FE : FunExt-global)
  (UA : Univalence)
  (open CohIdemWithFunExt FE)
  (open RetractsQIdempotentsWithFunExtUnivalence FE UA)
  {𝓤 : Level} {X : Type 𝓤}
  (open SmallRetractsWithFunExt FE X)
  where

  Splitting-step-qidempotent-map≃retracts
    : Splitting.type step-qidempotent-map ≃ Retracts 𝓤 X
  Splitting-step-qidempotent-map≃retracts = small-retracts-equiv

  Retracts≃idempotent-map
    : Retracts 𝓤 X ≃ idempotent-map X
  Retracts≃idempotent-map
    = (Splitting-step-qidempotent-map≃retracts e⁻¹)
    ∙e Splitting-step-qidempotent-map≃idempotent-map
}
}
