\subtree[bak-C23E]{
\title{Covariant disks}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be any map, then for any diagram #{b \colon J \to B}
we may form the \em{covariant disk of #{p} over #{b}} as the type
#{\CovDisk(p,b)\defeq ʃ(p \downarrow b)} where #{p \downarrow b} is the
[comma type](stt-00C3) and #{ʃ} is geometric realisation, i.e., nullification at
#{Δ¹}. The type of \em{#{J}-shaped covariant disks of #{p}} is the total type
#{\CovDisk_J(p) \defeq \Sigma1{b \colon J \to B}{\CovDisk(p,b)}}.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) where

  Cov-disk-at : ∀ {𝓙} {J : Type 𝓙} → (J → B) → Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk-at b = Δ¹Disc.○ (p ↓ b)

  Cov-disk-at: : ∀ {𝓙} (J : Type 𝓙) → (J → B) → Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk-at: J = Cov-disk-at

  Cov-disk : ∀ {𝓙} (J : Type 𝓙) →  Type (𝓘 ⊔ 𝓙 ⊔ 𝓤 ⊔ 𝓥)
  Cov-disk J = Σ (J → B) Cov-disk-at

  Cov-disk-π : ∀ {𝓙} {J : Type 𝓙} → Cov-disk J → (J → B)
  Cov-disk-π = fst: Cov-disk-at

  Cov-disk-π: : ∀ {𝓙} (J : Type 𝓙) → Cov-disk J → (J → B)
  Cov-disk-π: J = Cov-disk-π
}
}

\subtree[bak-CA79]{
\title{Transport in covariant disks}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Given a map #{p \colon E \to B} into a [Segal type](stt-00AI) #{B} and a pair of
diagrams in #{B}, #{x \colon J' \to B} and #{y \colon J \to B}, then every reindexing
map #{j₀ \colon J' \to J} equipped with a natural transformation of morphisms
#{{\Hom(x, yj₀)}} gives a transport map between comma types:
##{(p \downarrow x) \to (p \downarrow y)\nsp{,}}
and this transport map descends to covariant disks
##{\CovDisk(p,x) \to \CovDisk(p,y)\nsp{.}}
This action is unital in the sense that it restricts to the identity
function when #{x} is {y}, the reindexing is the identity, and the natural
transformation is given by the identity transformation. Hence, by the
[unital transport criterion](stt-00VJ) #{\CovDisk(p)} defines a covariant family.
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-comma
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → p ↓ x → p ↓ y
  transport-comma j₀ β (e , i , α) = (e , j₀ i , β i ∘[ 𝐵 ] α)

  transport-Cov-disk
    : ∀ {𝓙 𝓙'} {J : Type 𝓙} {J' : Type 𝓙'} {x : J' → B} {y : J → B}
      → (j₀ : J' → J) → (x ⇒ y ∘ j₀)
      → Cov-disk-at p x → Cov-disk-at p y
  transport-Cov-disk j₀ = Δ¹Disc.○₁ ∘ transport-comma j₀

  transport-comma-unital
    : ∀ {𝓙} {J : Type 𝓙} {b : J → B}
      → transport-comma id (idH ∘ b) ~ id
  transport-comma-unital x
    = Σ-path→ (refl , (Σ-path→ (refl , ∘[ 𝐵 ]-right-unit)))

  transport-Cov-disk-unital
    : ∀ {𝓙} {J : Type 𝓙} (b : J → B)
      → transport-Cov-disk id (idH ∘ b) ~ id
  transport-Cov-disk-unital _
    = Δ¹Disc.○-~ transport-comma-unital ∙h Δ¹Disc.○₁-id

  Cov-disk-is-covariant
    : ∀ {𝓙} {J : Type 𝓙} → is-covariant (Cov-disk-at p {J = J})
  Cov-disk-is-covariant
    = ʃ∘-is-covariant
        (transport-comma id ∘ Nat←Hom , (λ _ → transport-comma-unital))

  Cov-disk-π-is-left-fibration
    : ∀ {𝓙} {J : Type 𝓙} → is-left-fibration (Cov-disk-π p {J = J})
  Cov-disk-π-is-left-fibration
    = is-left-fibration←is-covariant (Cov-disk-at p) Cov-disk-is-covariant
}
}

\subtree[bak-E834]{
\title{Base change of covariant disks}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map into a [Segal type](stt-00AI) #{B}, and let
#{b : \Pi1{a : A}{J(a) \to B}} be a family of diagrams. If #{J} admits
[covariant lifts](bak-FEFF), then the type family #{\CovDisk(p)\circ b} is covariant.
}

\proof{
\p{
TODO
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  lift-comma-base-change
    : Covariant-lifts J → Covariant-lifts (λ a → (p ↓ b a))
  lift-comma-base-change lift-J h (e , c)
    = let (c' , k)
            = Σ-covariant-lifts
                {C = λ a j → Hom B (p e) (b a j)}
                lift-J
                (λ g α → hom-fam-cov 𝐵 (p e) (uncurry b ∘ g) α .centre)
                h
                c
      in ((e , c') , ap-hom (e ,_) k)

  transport-comma-base-change
    : Covariant-lifts J → Covariant-transport (λ a → (p ↓ b a))
  transport-comma-base-change
    = cov-transport←lifts {B = (λ a → (p ↓ b a))} ∘ lift-comma-base-change

  Cov-disk-base-change-is-covariant
    : Covariant-lifts J → is-covariant (Cov-disk-at p ∘ b)
  Cov-disk-base-change-is-covariant
    = ʃ∘-is-covariant←lifts {P = (λ a → (p ↓ b a))} ∘ lift-comma-base-change
}
}

\subtree[bak-E9FE]{
\title{The covariant disk bundle}
\taxon{Construction}
\author{fredrikbakke}
\date{2026-11-04}

\p{
Let #{p \colon E \to B} be a map, and #{b : \Pi1{a : A}{J(a) \to B}} a family of
diagrams in #{B}. Then the total space of covariant disks
#{\CovDisk_b(p) \defeq \Sigma1{a : A}{\CovDisk(p,b(a))}} is the
\em{covariant disk bundle of #{p} over #{b}}. This type comes equipped with a unit
map #{\Sigma1{a : A}{p \downarrow b(a)} \to \Sigma1{a : A}{\CovDisk(p,b(a))}} which
is #{Δ¹}-connected. Moreover, when #{B} is Segal and #{J}
admits covariant lifts, the bundle projection map
#{\CovDisk_b(p) \to A} is a [left fibration](stt-00AV).
}

\proof{
\p{
The unit map is #{Δ¹}-connected by sum-closure of connected maps, and the projection
map is a left fibration by [base change of covariant disks](bak-E834).
}
}

\agda{
module _
  {𝓤 𝓥} {B : Type 𝓤} {E : Type 𝓥} (p : E → B)
  {𝓦 𝓙} {A : Type 𝓦} {J : A → Type 𝓙} (b : (a : A) → J a → B)
  where

  Cov-disk-bundle : Type (𝓘 ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓙)
  Cov-disk-bundle = Σ[ a ∶ A ] Cov-disk-at p (b a)

  Cov-disk-bundle-π : Cov-disk-bundle → A
  Cov-disk-bundle-π = fst

  Cov-disk-bundle-η : (Σ[ a ∶ A ] (p ↓ b a)) → Cov-disk-bundle
  Cov-disk-bundle-η = total-map (λ _ → Δ¹Disc.η)

  Cov-disk-bundle-η-is-connected
    : is-connected-map Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
  Cov-disk-bundle-η-is-connected
    = total-map-is-connected Δ¹DiscreteType-gRSubU
        (λ _ → η-is-connected Δ¹DiscreteType-gRSubU Σ-is-Δ¹-discrete)

  ʃCov-disk-bundle≃
    : Δ¹Disc.○ (Σ[ a ∶ A ] (p ↓ b a)) ≃ Δ¹Disc.○ Cov-disk-bundle
  ʃCov-disk-bundle≃ = Σ○≃ Δ¹DiscreteType-gRSubU (λ a → p ↓ b a)

  Cov-disk-bundle-η-is-ʃ-equiv
    : is-modal-equiv Δ¹DiscreteType-gRSubU Cov-disk-bundle-η
  Cov-disk-bundle-η-is-ʃ-equiv = ʃCov-disk-bundle≃ ._≃_.fwd-is-equiv

  Cov-disk-bundle-η-is-left-anodyne
    : is-left-anodyne Cov-disk-bundle-η
  Cov-disk-bundle-η-is-left-anodyne f f-is-left
    = connected⊥modal Δ¹DiscreteType-gRSubU Cov-disk-bundle-η-is-connected
        (is-Δ¹-discrete-family←is-covariant
          (is-covariant←is-left-family (fibre f)
            (are-orthogonal-fibre←are-orthogonal f-is-left)))

module _
  {𝓤 𝓥 𝓦 𝓙} {B : Type 𝓤} {E : Type 𝓥} (p : E → B) (𝐵 : is-segal B) {A : Type 𝓦}
  where

  Cov-disk-bundle-π-is-left-fibration
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → Covariant-lifts J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration b
    = is-left-fibration←is-covariant (Cov-disk-at p ∘ b)
    ∘ Cov-disk-base-change-is-covariant 𝐵 p b

  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant
    : {J : A → Type 𝓙} (b : (a : A) → J a → B)
    → is-covariant J
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-is-left-fibration←diagram-shape-is-covariant b J-is-covariant
    = Cov-disk-bundle-π-is-left-fibration b
        (λ h j → J-is-covariant h j .centre)

  Cov-disk-bundle-π-at-const-fam-is-left-fibration
    : {J : Type 𝓙} (b : A → J → B)
    → is-left-fibration (Cov-disk-bundle-π p b)
  Cov-disk-bundle-π-at-const-fam-is-left-fibration b
    = Cov-disk-bundle-π-is-left-fibration b (λ _ j → (j , idH j))
}
}
