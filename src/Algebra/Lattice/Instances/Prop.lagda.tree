\date{2025-10-22}
\title{The lattice of propositions}
\taxon{Module}
\import{stt-macros}

\agda{
module Algebra.Lattice.Instances.Prop where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude


open import Core.Joins
open import Modalities.Instances.Truncation
open import Algebra.Lattice
}
}


\subtree[stt-009R]{
\title{The lattice of propositions}
\taxon{Example}
\p{The subobject/subtype classifier #{\mathrm{Prop}}
has a canonical lattice structure on it, given by logical and and or}

\agda{
Prop-Lattice : ∀ 𝓤 → Lattice (Prop 𝓤)
Prop-Lattice 𝓤 = mk-lattice _ _ _ _ l where
  l : is-lattice
        (TruncLift -1 𝓤 (∅ , is-prop!))
        (TruncLift -1 𝓤 (𝟙 , is-prop!))
        (λ (A , p) (B , q) → (A × B , ×-is-truncated -1 p q))
        (λ (A , p) (B , q) → (A * B , *-is-prop p q))
  l .is-lattice.∧-assoc
    = Prop-ext→
        ( (λ x → (x .fst , x .snd .fst) , x .snd .snd)
        , (λ x → x .fst .fst , x .fst .snd , x .snd) )
  l .is-lattice.∨-assoc {x} {y} {z}
    = Prop-ext→
        (*-prop-rec xyz-is-prop
            (ι₁ ∘ ι₁)
            (*-prop-rec xyz-is-prop (ι₁ ∘ ι₂) ι₂)
        , *-prop-rec xyz'-is-prop
            (*-prop-rec xyz'-is-prop ι₁ (ι₂ ∘ ι₁))
            (ι₂ ∘ ι₂))
      where

      xyz-is-prop = *-is-prop (*-is-prop (x .snd) (y .snd)) (z .snd)
      xyz'-is-prop = *-is-prop (x .snd) (*-is-prop (y .snd) (z .snd))

  l .is-lattice.∧-comm
    = Prop-ua→ ×-swap
  l .is-lattice.∨-comm
    = Prop-ua→ *-comm
  l .is-lattice.∨-∧-abs {x}
    = Prop-ext→ (*-prop-rec (x .snd) id fst , ι₁)
  l .is-lattice.∧-∨-abs {x}
    = Prop-ext→ (fst , λ x → x , (ι₁ x))
  l .is-lattice.0-bottom {x}
    = Prop-ext→ ( *-prop-rec (x .snd) id (¡ ∘ unlift) , ι₁)
  l .is-lattice.1-top
    = Prop-ext→ ((λ z → z .fst) , (λ z → z , ttᴸ))

Prop-Lattice-is-distributive
  : ∀ {𝓤} → is-distributive (Prop-Lattice 𝓤)
Prop-Lattice-is-distributive .is-distributive.distrib-∨-∧ {x = x} {y} {z}
  = Prop-ext→
      ( *-prop-rec (×-is-prop xy-is-prop xz-is-prop)
          (λ x → (ι₁ x , ι₁ x))
          (λ (y , z) → (ι₂ y , ι₂ z))
      , (λ (xy , xz)
         → *-prop-rec xyz-is-prop
             ι₁
             (λ y → *-prop-rec xyz-is-prop ι₁ (λ z → ι₂ (y , z)) xz)
             xy))
  where

  xy-is-prop = *-is-prop (x .snd) (y .snd)
  xz-is-prop = *-is-prop (x .snd) (z .snd)
  xyz-is-prop = *-is-prop (x .snd) (×-is-prop (y .snd) (z .snd))
}
}
