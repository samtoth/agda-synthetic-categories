\title{Essentially surjective maps}
\taxon{Module}

\import{stt-macros}

\transclude{stt-00AB}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.EssentiallySurjectiveMaps
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Modalities.Instances.Truncation

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Categories.Precategories Δ¹ I
open import Synthetic.Categories.Isomorphisms Δ¹ I
open import Synthetic.Categories.EssentialFibres Δ¹ I
open import Synthetic.Categories.NaturalIsomorphisms Δ¹ I
}
}

\subtree[stt-00PW]{
\title{Essentially surjective maps}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-05-01}

\p{
A map #{f \colon A \to B} is \em{essentially surjective} if each of its
[essential fibres](stt-00PT) is inhabited.
}

\agda{
is-ess-surjective
  : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥} → (A → B) → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
is-ess-surjective {B = B} f = (b : B) → ║ essfibre f b ║₋₁
}
}

\subtree[stt-00QX]{
\title{Composition and right cancellation}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-14}

\agda{
module _
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦} {g : B → C} {f : A → B}
  where

  is-ess-surjective-∘
    : (𝐶 : is-segal C)
    → is-ess-surjective g
    → is-ess-surjective f
    → is-ess-surjective (g ∘ f)
  is-ess-surjective-∘ 𝐶 sg sf c
    = Trunc.○-rec Trunc.○∈S
        (λ (b , β)
         → Trunc.○-rec Trunc.○∈S (λ γ → Trunc.η (essfibre-∘ 𝐶 γ β)) (sf b))
        (sg c)

  is-ess-surjective-right-cancel
    : is-ess-surjective (g ∘ f)
    → is-ess-surjective g
  is-ess-surjective-right-cancel s c
    = Trunc.○-rec Trunc.○∈S (Trunc.η ∘ left←essfibre-∘) (s c)
}
}

\subtree[stt-00QY]{
\title{Closure under natural isomorphisms}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-14}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} (𝐵 : is-segal B) {f g : A → B} where

  is-ess-surjective←NatIso
    : NatIso f g
    → is-ess-surjective g
    → is-ess-surjective f
  is-ess-surjective←NatIso α sg b
    = Trunc.○-rec Trunc.○∈S (λ (a , β) → Trunc.η (a , comp-Iso 𝐵 β (α a))) (sg b)
}
}

\subtree[stt-00QZ]{
\title{Closure under homotopies}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-05-14}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f g : A → B} where

  is-ess-surjective~
    : f ~ g
    → is-ess-surjective f
    → is-ess-surjective g
  is-ess-surjective~ H sg b
    = Trunc.○-rec Trunc.○∈S
        (λ (a , β) → Trunc.η (a , adjust-Iso (H a) refl β))
        (sg b)
}
}
