\date{2026-03-20}
\title{Algebraic laws of composition}
\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}

\p{
We formalise algebraic laws of composition in categories.
}

\transclude{stt-00AB}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.AlgebraicLaws
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open import Synthetic.Categories.AssociativitySegal Δ¹ I public using
  ( ∘[_]-assoc
  ; ∘-assoc
  ; ∘-assoc←is-precategory)

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Ergonomics.Extensionality

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Simplicial Δ¹ I
open import Synthetic.Categories.CovariantFamilies Δ¹ I
open import Synthetic.Categories.Precategories Δ¹ I
open import Synthetic.Categories.Homotopy Δ¹ I
open import Synthetic.Categories.LeftSegal Δ¹ I
open import Synthetic.Categories.CovariantHomFamily Δ¹ I
}
}

\subtree[stt-00GA]{
\title{Unit laws of composition}
\date{2026-03-20}
\author{fredrikbakke}
\taxon{Proposition}

\p{
In a [Segal type](stt-00AI), both unit laws for composition hold. Both follow from
uniqueness of composition together with reflexivity of
[left and right homotopies](stt-00CH).
}

\agda{
module _ {𝓤} {A : Type 𝓤} {a b : A} (𝐴 : is-segal A) where

  opaque
    ∘[_]-right-unit : {f : Hom A a b} → idH b ∘[ 𝐴 ] f ＝ f
    ∘[_]-right-unit {f} = ∘=←Hom2 𝐴 (refl▵~ f)

    ∘[_]-left-unit : {f : Hom A a b} → f ∘[ 𝐴 ] idH a ＝ f
    ∘[_]-left-unit {f} = ∘=←Hom2 𝐴 (refl~▵ f)
}
}

\subtree[stt-00G9]{
\title{Associativity of composition for Segal types}
\date{2026-03-20}
\author{fredrikbakke}
\taxon{Corollary}

\p{
From functoriality of [covariant transport of postcomposition](stt-00GB), we derive
associativity of composition.
}

\p{
I first saw this result mentioned by [[emilyriehl]].
[rzk-lang/sHoTT\startverb#\stopverb150](https://github.com/rzk-lang/sHoTT/issues/150)
}

\agda{
module _
  {𝓤 : Level} {A : Type 𝓤} (𝐴 : is-segal A)
  (open CovariantActionPostcomp 𝐴)
  where

  ∘-assoc'
    : {a b c d : A}
      (h : Hom A c d) (g : Hom A b c) (f : Hom A a b)
    → (h ∘[ 𝐴 ] g) ∘[ 𝐴 ] f
    ＝ h ∘[ 𝐴 ] (g ∘[ 𝐴 ] f)
  ∘-assoc' h g f
    = (h ∘[ 𝐴 ] g) ∘[ 𝐴 ] f
        ＝⟨ sym (tr-cov-hom-is-comp (h ∘[ 𝐴 ] g) f) ⟩
      tr-cov-hom (hom-fam-cov 𝐴 _) (h ∘[ 𝐴 ] g) f
        ＝⟨ tr-cov-∘ 𝐴 (Hom A _) (hom-fam-cov 𝐴 _) h g f ⟩
      tr-cov-hom (hom-fam-cov 𝐴 _) h (tr-cov-hom (hom-fam-cov 𝐴 _) g f)
        ＝⟨ ap (tr-cov-hom (hom-fam-cov 𝐴 _) h) (tr-cov-hom-is-comp g f) ⟩
      tr-cov-hom (hom-fam-cov 𝐴 _) h (g ∘[ 𝐴 ] f)
        ＝⟨ tr-cov-hom-is-comp h (g ∘[ 𝐴 ] f) ⟩
      h ∘[ 𝐴 ] (g ∘[ 𝐴 ] f) ∎
}
}
