\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.BoundedPoset

module Synthetic.CoStrict
  {𝓘 𝓙} (Δ¹ : Type 𝓘) (I : BoundedPoset 𝓙 Δ¹)
  (open BoundedPoset I renaming (0p to i0; 1p to i1))
  where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Ergonomics.Auto
open import Ergonomics.Extensionality

open import Core.Orthogonal
open import Core.OrthogonalClosure

open import Modalities.Instances.Nullification
