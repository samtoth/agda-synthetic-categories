\title{Bounded posets}
\taxon{Module}
\author{fredrikbakke}
\date{2026-09-22}
\import{stt-macros}

\agda{
module Algebra.BoundedPoset where

open import Axioms.FunExt
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Algebra.Poset
open import Algebra.Order.BottomElements
open import Algebra.Order.TopElements
}
}

\subtree[bak-A907]{
\title{Bounded posets}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-22}

\p{
A \em{bounded poset} is a [poset](stt-00TJ) equipped with a
[bottom element](bak-FCC3) and a [top element](bak-5B1C).
}

\agda{
is-bounded-poset : ∀ {𝓤 𝓥} {A : Type 𝓤} → Poset 𝓥 A → Type (𝓤 ⊔ 𝓥)
is-bounded-poset P = bottom-element P × top-element P

is-bounded-poset-is-prop
  : ∀ {𝓤 𝓥} {A : Type 𝓤} (P : Poset 𝓥 A) → is-prop (is-bounded-poset P)
is-bounded-poset-is-prop P
  = ×-is-prop (bottom-element-is-prop P) (top-element-is-prop P)

record BoundedPoset {𝓤} 𝓥 (A : Type 𝓤) : Type (𝓤 ⊔ lsuc 𝓥) where
  no-eta-equality
  constructor mk-bounded-poset
  field
    poset : Poset 𝓥 A
    poset-is-bounded : is-bounded-poset poset

  open Poset poset public

  0p : A
  0p = poset-is-bounded .fst .fst

  1p : A
  1p = poset-is-bounded .snd .fst

  0-bottom : is-bottom-element poset 0p
  0-bottom = poset-is-bounded .fst .snd

  1-top : is-top-element poset 1p
  1-top = poset-is-bounded .snd .snd
}
}
