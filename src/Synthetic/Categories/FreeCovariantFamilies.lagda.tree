\subtree[tot-65RY]{
\title{The free covariant family}
\author{samueltoth}
\date{2026-09-24}
\taxon{Definition}

\p{Let #{p \colon E \to B} be any map, then we define the type family
#{\FreeCov(p)} which sends #{b : B} to the type #{ʃ(p \downarrow b)}, where
#{\downarrow} is the [comma type](stt-00C3) and #{ʃ} is nullification
at #{Δ¹}. Some authors write #{p \downarrow b} as #{p_{/b}}.
}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {E : Type 𝓥} (p : E → A) where

  Free-cov-fam : A → Type (𝓘 ⊔ 𝓤 ⊔ 𝓥)
  Free-cov-fam a = Δ¹Disc.○ (p ↓ point a)

  Free-left-fibration : Σ A Free-cov-fam → A
  Free-left-fibration = fst: Free-cov-fam
}
}

\subtree[tot-EN21]{
\title{The free covariant family over a Segal type is covariant}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\p{If #{B} is a [Segal](stt-00AI) type, then the free covariant family on any map
#{p \colon E \to B} is a [covariant type family](stt-00AY).}

\proof{
\p{We use the [unital transport criterion](stt-00VJ), where the transport map is given
by postcomposition in the Segal type.}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  transport-comma
    : ∀ {a b : B} → Hom B a b → p ↓ point a → p ↓ point b
  transport-comma f = total-map (λ c → total-map (λ _ → f ∘[ 𝐵 ]_))

  transport-Free-cov-fam
    : ∀ {a b : B} → Hom B a b → Free-cov-fam p a → Free-cov-fam p b
  transport-Free-cov-fam f = Δ¹Disc.○₁ (transport-comma f)

  transport-comma-unital
    : ∀ {b : B} → transport-comma (idH b) ~ id
  transport-comma-unital x = Σ-path→ (refl , (Σ-path→ (refl , ∘[ 𝐵 ]-right-unit)))

  transport-Free-cov-fam-unital
    : ∀ (b : B) → transport-Free-cov-fam (idH b) ~ id
  transport-Free-cov-fam-unital _ = Δ¹Disc.○-~ transport-comma-unital ∙h Δ¹Disc.○₁-id

  Free-cov-fam-is-covariant : is-covariant (Free-cov-fam p)
  Free-cov-fam-is-covariant
    = is-covariant←cov-unital-transport (λ b → Δ¹Disc.○∈S {A = p ↓ point b})
        (transport-Free-cov-fam , transport-Free-cov-fam-unital)
}
}

\subtree[tot-0913]{
\title{The free covariant family gives a left anodyne/left fibration factorisation}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\p{If #{B} is a [Segal type](stt-00AI) and #{p} is any map #{E \to B}, then the canonical
lift of #{ʃ(p \downarrow {-})} along #{p} given at #{e} by the the identity
morphism at #{p(e)} is a left-anodyne map, and induces
a factorisation of #{p} into a left-anodyne map followed by a left fibration.}

\proof{
\p{Let #{\eta \colon E \to \FreeCov(p)} be the aforementioned lift. It suffices to show that
for any covariant family #{Y \colon X \to \Type} and any map #{g : \FreeCov(p) \to X},
the induced map #{(\Pi_{\FreeCov(p)} Yg) \to (\Pi_{E} Yg\eta)} is an equivalence.}

\p{To this end we construct an equivalence of arrows:

\quiver{
\begin{tikzcd}
	{\Pi_{\FreeCov(p)} Yg} && {\Pi_E Yg\eta^l} \\
	{\Pi_{(b : B)}\Pi_{x : p \downarrow b} Yg(b,\vert x \vert)} \\
	{\Pi_{(e : E)}\Pi_{(x : B_{p(e)/})} Yg(x_1, \vert(e,x_2)\vert)} && {\Pi_{(e:E)} Yg(p(e),\vert(e,\id_{p(e)})\vert)}\nsp{,}
	\arrow[from=1-1, to=1-3]
	\arrow["\simeq"', from=1-1, to=2-1]
	\arrow[equals, from=1-3, to=3-3]
	\arrow["\simeq"', from=2-1, to=3-1]
	\arrow["{\Pi_E \ev_{\id}}"', from=3-1, to=3-3]
\end{tikzcd}
}

where the left equivalence is given by the universal property of nullification at
#{Δ¹} (#{Yg} is covariant and so in particular a #{Δ¹}-discrete family),
followed by simply rearranging the arguments. Finally the bottom map is an equivalence
by the [Yoneda lemma](stt-00LK).
}
}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  Free-cov-fam-η : (e : E) → Free-cov-fam p (p e)
  Free-cov-fam-η e = Δ¹Disc.η (e , (_ , idH (p e)))

  Free-left-fib-η : E → Σ B (Free-cov-fam p)
  Free-left-fib-η e = (p e , Free-cov-fam-η e)

  Free-cov-fam-η-is-left-anodyne'
    : ∀ {𝓦 𝓜} {X : Type 𝓦} (Y : X → Type 𝓜) (Y-cov : is-covariant Y)
      → are-orthogonal-fam Free-left-fib-η Y
  Free-cov-fam-η-is-left-anodyne' Y Y-cov g
    = src-is-equiv←Arrow-equiv
        aeq
        (postcomp-Π-equiv
          (λ {e}
           → ev-init-covariant-is-equiv
               (coslice-init 𝐵 (p e))
               (covariant-base-change {P = Y}
                 (g ∘ total-map (λ _ x → Δ¹Disc.η (e , tt , x tt))) Y-cov)))
    where

    eqv : (Σ[ e ∶ E ] Coslice B (point (p e))) ≃ (Σ[ b ∶ B ] (p ↓ point b))
    eqv ._≃_.fwd (e , b , h) = (b , e , (tt , h tt))
    eqv ._≃_.fwd-is-equiv .is-equiv.qinv .fst (b , e , (tt , h)) = (e , b , const h)
    eqv ._≃_.fwd-is-equiv .is-equiv.qinv .snd = (~refl , ~refl)
    eqv ._≃_.fwd-is-equiv .is-equiv.coherent = ~refl

    aeq
      : Arrow-equiv
          (precomp-Π (Y ∘ g) (λ e → (p e , Free-cov-fam-η e)))
          (postcomp-Π
            λ (e : E)
            → evᵈ:
                (λ (x : Coslice B (point (p e))) → Y (g (x .fst , Δ¹Disc.η (e , _ , x .snd tt))))
                (p e , λ _ → idH (p e)))
    aeq
      = mk-arr-equiv
          ( curry≃
          ∙e postcomp-Π-≃
               (λ b → Δ¹Disc.○-UPᵈ≃ {P = Y ∘ g ∘ (b ,_)}
                 (is-Δ¹-discrete-family←is-covariant
                   (covariant-base-change {P = Y} (g ∘ (b ,_)) Y-cov)))
          ∙e (uncurry≃ ∙e precomp-Π-≃ _ eqv ∙e curry≃))
          id≃
          ~refl

  Free-left-fib-η-is-left-anodyne : is-left-anodyne Free-left-fib-η
  Free-left-fib-η-is-left-anodyne g gleft
    = are-orthogonal←are-orthogonal-fibre
        (Free-cov-fam-η-is-left-anodyne' (fibre g)
          (is-covariant←is-left-family (fibre g)
            (are-orthogonal-fibre←are-orthogonal gleft)))
}
}

\subtree[tot-092B]{
\title{A map into a Segal type is left anodyne iff the free left fibration is an equivalence}
\author{samueltoth}
\date{2026-09-24}
\taxon{Lemma}

\agda{
module _ {𝓤 𝓥} {B : Type 𝓤} (𝐵 : is-segal B) {E : Type 𝓥} (p : E → B) where

  opaque
    Free-left-fib-is-equiv←is-left-anodyne
      :  is-left-anodyne p → is-equiv (fst: Free-cov-fam p)
    Free-left-fib-is-equiv←is-left-anodyne pl
      = is-equiv←self-orthogonal
          (is-anodyne-right-cancel (point i0)
            pl
            (Free-left-fib-η-is-left-anodyne 𝐵 p)
            fst
            (is-left-fibration←is-covariant (Free-cov-fam p) (Free-cov-fam-is-covariant 𝐵 p)))

    is-left-anodyne←Free-left-fib-is-equiv
      : is-equiv (fst: Free-cov-fam p) → is-left-anodyne p
    is-left-anodyne←Free-left-fib-is-equiv fe
      = is-anodyne-∘ {f = fst} (point i0)
          (λ g _ → equiv⊥ fe g)
          (Free-left-fib-η-is-left-anodyne 𝐵 p)
}
}
