\date{2025-09-11}
\title{Synthetic Hom types}
\taxon{Module}
\author{samueltoth}
\import{stt-macros}


\agda{
open import Foundations.Universes

module Synthetic.Hom {𝓘} (I : Type 𝓘) (i0 i1 : I) where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowEquiv

open import Ergonomics.Representation
open import Ergonomics.Extensionality
}
}

\subtree[stt-00A9]{
\title{Hom types}
\taxon{Definition}
\contributor{fredrikbakke}

\p{For any bipointed type #{I}, we can define the type of synthetic
homomorphisms, which are just (possibly-dependent) functions with specified
end-points.}

\remark{
\p{In this generality, there is not a lot of motivation to call these types
\strong{hom} types. They admit identity homs, but in general not composition.
The idea is that this module will be instantiated with an interval for which
certain types have a notion of fibrancy, and for those fibrant types, the hom
type will deserve its name.}
}

\agda{
record 𝐇omᵈ {𝓤} (A : I → Type 𝓤) (a : A i0) (b : A i1) : Type (𝓤 ⊔ 𝓘) where
  constructor mk-𝐡om
  field
    𝐡om  : Π I A
    𝐡om0 : 𝐡om i0 ＝ a
    𝐡om1 : 𝐡om i1 ＝ b

open 𝐇omᵈ public

unquoteDecl 𝐇omᵈ-repr≊ 𝐇omᵈ-repr≃
  = make-record-repr 𝐇omᵈ-repr≊ 𝐇omᵈ-repr≃ (quote 𝐇omᵈ)

λ𝐡om : ∀ {𝓤} {A : I → Type 𝓤} (f : Π I A) → 𝐇omᵈ A (f i0) (f i1)
λ𝐡om f = mk-𝐡om f refl refl

𝐇om : ∀ {𝓤} (A : Type 𝓤) (a b : A) → Type (𝓤 ⊔ 𝓘)
𝐇om A a b = 𝐇omᵈ (λ _ → A) a b

{-# NOINLINE 𝐇om #-}

idH : ∀ {𝓤} {A : Type 𝓤} → (a : A) → 𝐇om A a a
idH a = λ𝐡om λ _ → a

{-# NOINLINE idH #-}

𝐇omᵈ-over
  : ∀ {𝓤 𝓥} {A : I → Type 𝓤} {B : (i : I) → A i → Type 𝓥} {x : A i0} {y : A i1}
    → 𝐇omᵈ A x y → B i0 x → B i1 y → Type (𝓘 ⊔ 𝓥)
𝐇omᵈ-over {A = A} {B} f x' y'
  = 𝐇omᵈ
      (λ i → B i (f .𝐡om i))
      (tr (B i0) (sym (f .𝐡om0)) x')
      (tr (B i1) (sym (f .𝐡om1)) y')

𝐇om-over
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : A → Type 𝓥} {x y : A}
    → 𝐇om A x y → B x → B y → Type (𝓘 ⊔ 𝓥)
𝐇om-over {A = A} {B} = 𝐇omᵈ-over {A = λ _ → A} {B = λ _ → B}

total-hom
  : ∀ {𝓤} {A : I → Type 𝓤}
    → ((i : I) → A i) ≃ (Σ[ x ∶ A i0 ] Σ[ y ∶ A i1 ] 𝐇omᵈ A x y)
total-hom {A = A} = equiv←qequiv
  (mk≊
    (λ f → (f i0 , f i1 , λ𝐡om f))
    ((λ where (a , b , mk-𝐡om f refl refl) → f)
    , ~refl
    , (λ where (a , b , mk-𝐡om f refl refl) → refl)))
}

\remark{
\p{Unlike in [Cubical Agda](https://agda.readthedocs.io/en/latest/language/cubical.html)
or the [Rzk proof assistant](https://rzk-lang.github.io/rzk/en/latest/),
these hom types do not require their endpoints to be definitionally equal, but only
equal up to a path. It is possible to simulate the \em{definitional} path types
with an indexed-inductive type but this pushes Agda's elaboration beyond what it
is really designed for, and the usability suffers.
}
}
}

\subtree[stt-00AN]{
\title{Extensionality for homs}
\taxon{Theorem}
\contributor{fredrikbakke}

\p{A homorphism #{\Hom_A(x,y)} consist of the data of a map #{C^{\Delta^2}}
together with a pair of identifications. To define a path in #{\Hom_A(x,y)}
between #{f} and #{g}, we need a homotopy #{H} of the underlying maps, but also
coherence data: #{H_{0} \sim g_0 \sim f_0} for #{i = 0,1}.}

\agda{
module _ {𝓤} {A : I → Type 𝓤} {x : A i0} {y : A i1} where

  𝐇om-path : (f g : 𝐇omᵈ A x y)  → Type (𝓘 ⊔ 𝓤)
  𝐇om-path (mk-𝐡om f p q) (mk-𝐡om g r s)
    = Σ[ H ∶ f ~ g ] ((H i0 ∙ r ＝ p) × (H i1 ∙ s ＝ q))

  opaque
    𝐇om-path-is-torsorial
      : (f : 𝐇omᵈ A x y) → is-torsorial (𝐇om-path f)
    𝐇om-path-is-torsorial f
      = is-single←equiv (Σ-fst-≃ (𝐇omᵈ-repr≃ e⁻¹))
          (is-singleton-structure←parts
            (SingS-is-single (f .𝐡om))
            (f .𝐡om , ~refl)
            (is-singleton-structure←parts
              Sing'-is-singleton
              (_ , refl)
              Sing'-is-singleton))

  𝐇om-path-refl
    : {f : 𝐇omᵈ A x y} → 𝐇om-path f f
  𝐇om-path-refl = (~refl , refl , refl)

  instance
    IdS-𝐇om : Identity-system (𝐇omᵈ A x y) (𝓘 ⊔ 𝓤)
    IdS-𝐇om .Identity-system.IdS = 𝐇om-path
    IdS-𝐇om .Identity-system.IdS←Id refl = 𝐇om-path-refl
    IdS-𝐇om .Identity-system.IdS←Id-is-equiv f
      = fundamental-Id (𝐇om-path f) (𝐇om-path-is-torsorial f) _

  𝐇om-ext→
    : {f g : 𝐇omᵈ A x y} → 𝐇om-path f g → f ＝ g
  𝐇om-ext→ = ext!

module _ {𝓤} {A : I → Type 𝓤}  where

  adjust-𝐡om
    : {x x' : A i0} {y y' : A i1} (p : x ＝ x') (q : y ＝ y')
    → 𝐇omᵈ A x y → 𝐇omᵈ A x' y'
  adjust-𝐡om p q (mk-𝐡om fh f0 f1) = mk-𝐡om fh (f0 ∙ p) (f1 ∙ q)

  adjust-𝐡om-refl
    : {x : A i0} {y : A i1}
    → (id: 𝐇omᵈ A x y) ~ adjust-𝐡om refl refl
  adjust-𝐡om-refl f = 𝐇om-ext→ (~refl , ∙-reflr _ , ∙-reflr _)

  adjust-𝐡om-is-equiv
    : {x x' : A i0} {y y' : A i1}  (p : x ＝ x') (q : y ＝ y')
    → is-equiv (adjust-𝐡om p q)
  adjust-𝐡om-is-equiv refl refl
    = is-equiv←~⁻¹ (λ _ → 𝐇om-ext→ (~refl , ∙-reflr _ , ∙-reflr _))id-is-equiv

adjust-idH
  : ∀ {𝓤} {A : Type 𝓤} {x y : A}
    → (p : x ＝ y)
    → idH y ＝ adjust-𝐡om p p (idH x)
adjust-idH refl = adjust-𝐡om-refl (idH _)


module _ {𝓤} {A : I → Type 𝓤}  where

  𝐇om-pathᵈ
    : {x x' : A i0} {y y' : A i1} (p : x ＝ x') (q : y ＝ y')
      (f : 𝐇omᵈ A x y) (g : 𝐇omᵈ A x' y') → Type (𝓘 ⊔ 𝓤)
  𝐇om-pathᵈ p q (mk-𝐡om f f0 f1) (mk-𝐡om g g0 g1)
    = Σ[ H ∶ (f ~ g) ] (Square (H i0) p f0 g0 × Square (H i1) q f1 g1)

  𝐇om-path←pathᵈ
    : {x : A i0} {y : A i1} {f g : 𝐇omᵈ A x y}
    → 𝐇om-pathᵈ refl refl f g → 𝐇om-path f g
  𝐇om-path←pathᵈ (H , K , R)
    = (H , un-square K ∙ ∙-reflr _ , un-square R ∙ ∙-reflr _)

  𝐇om-pathᵈ←path
    : {x : A i0} {y : A i1} {f g : 𝐇omᵈ A x y}
    → 𝐇om-path f g → 𝐇om-pathᵈ refl refl f g
  𝐇om-pathᵈ←path (H , K , R)
    = (H , mk-square (K ∙ sym (∙-reflr _)) , mk-square (R ∙ sym (∙-reflr _)))

  𝐇om-pathᵈ≊path
    : {x : A i0} {y : A i1} {f g : 𝐇omᵈ A x y}
    → 𝐇om-path f g ≊ 𝐇om-pathᵈ refl refl f g
  𝐇om-pathᵈ≊path ._≊_.fwd = 𝐇om-pathᵈ←path
  𝐇om-pathᵈ≊path ._≊_.fwd-qinv .fst = 𝐇om-path←pathᵈ
  𝐇om-pathᵈ≊path ._≊_.fwd-qinv .snd .fst (H , p , q)
    = Σ-path→ (refl , ×-path→
        ( ap (_∙ ∙-reflr _) (un-mk-square (p ∙ sym (∙-reflr _)))
          ∙ (∙-assoc p _ _) ∙ ap (p ∙_) (∙-sym' (∙-reflr _)) ∙ ∙-reflr _
        , ap (_∙ ∙-reflr _) (un-mk-square (q ∙ sym (∙-reflr _)))
          ∙ (∙-assoc q _ _) ∙ ap (q ∙_) (∙-sym' (∙-reflr _)) ∙ ∙-reflr _))
  𝐇om-pathᵈ≊path ._≊_.fwd-qinv .snd .snd (J , p , q)
    = Σ-path→ (refl , ×-path→
      ( ap mk-square (∙-assoc (un-square p) _ _
        ∙ ap (un-square p ∙_) (∙-sym (∙-reflr _)) ∙ ∙-reflr _) ∙ mk-un-square p
      , ap mk-square (∙-assoc (un-square q) _ _
        ∙ ap (un-square q ∙_) (∙-sym (∙-reflr _)) ∙ ∙-reflr _) ∙ mk-un-square q))

  𝐇om-pathᵈ≃path
    : {x : A i0} {y : A i1} {f g : 𝐇omᵈ A x y}
    → 𝐇om-path f g ≃ 𝐇om-pathᵈ refl refl f g
  𝐇om-pathᵈ≃path = equiv←qequiv 𝐇om-pathᵈ≊path

  𝐇om-pathᵈ-is-torsorial
    : {x : A i0} {y : A i1} {f : 𝐇omᵈ A x y}
    → is-torsorial (𝐇om-pathᵈ refl refl f)
  𝐇om-pathᵈ-is-torsorial
    = is-single←equiv (Σ-snd-≃ (λ _ → 𝐇om-pathᵈ≃path)) (𝐇om-path-is-torsorial _)

  𝐇om-pathᵈ-refl
    : {x : A i0} {y : A i1} {f : 𝐇omᵈ A x y}
    → 𝐇om-pathᵈ refl refl f f
  𝐇om-pathᵈ-refl = 𝐇om-pathᵈ←path 𝐇om-path-refl

  𝐇om-extᵈ→
    : {x x' : A i0} {y y' : A i1} (p : x ＝ x') (q : y ＝ y')
    → {f : 𝐇omᵈ A x y} {g : 𝐇omᵈ A x' y'}
    → 𝐇om-pathᵈ p q f g → Idᵈ (ap₂ (𝐇omᵈ A) p q) f g
  𝐇om-extᵈ→ refl refl = 𝐇om-ext→ ∘ 𝐇om-path←pathᵈ

  𝐇om-IdSᵈ
    : {x : A i0} {y : A i1} → Identity-system (𝐇omᵈ A x y) (𝓘 ⊔ 𝓤)
  𝐇om-IdSᵈ .Identity-system.IdS = 𝐇om-pathᵈ refl refl
  𝐇om-IdSᵈ .Identity-system.IdS←Id refl = 𝐇om-pathᵈ-refl
  𝐇om-IdSᵈ .Identity-system.IdS←Id-is-equiv a
    = fundamental-Id _ 𝐇om-pathᵈ-is-torsorial _
}
}

\subtree[stt-00R8]{
\title{Underlying paths of adjusted homs}
\taxon{Lemma}
\author{fredrikbakke}
\contributor{fredrikbakke}

\agda{
module _ {𝓤} {A : I → Type 𝓤} {x : A i0} {y : A i1}  where

  𝐇om-path-𝐡om-ap
    : {f g : 𝐇omᵈ A x y}
    → (p : f ＝ g) (i : I)
    → Identity-system.IdS←Id IdS-𝐇om p .fst i
    ＝ ap (λ h → h .𝐡om i) p
  𝐇om-path-𝐡om-ap refl i = refl

  adjust-𝐡om-refl-𝐡om
    : (f : 𝐇omᵈ A x y) (i : I)
    → ap (λ h → h .𝐡om i) (adjust-𝐡om-refl f) ＝ refl
  adjust-𝐡om-refl-𝐡om f i
    = sym (𝐇om-path-𝐡om-ap (adjust-𝐡om-refl f) i)
    ∙ ap (λ hp → hp .fst i)
         (Identity-system.IdS←Id←IdS IdS-𝐇om
           ( ~refl
           , ∙-reflr _
           , ∙-reflr _))

module _ {𝓤} {A : Type 𝓤} {x y : A} where

  adjust-idH-𝐡om
    : (p : x ＝ y) (i : I)
    → ap (λ h → h .𝐡om i) (adjust-idH p) ＝ sym p
  adjust-idH-𝐡om refl = adjust-𝐡om-refl-𝐡om (idH _)
}
}

\subtree[stt-00CE]{
\title{Functions have an action on synthetic morphisms}
\contributor{fredrikbakke}

\agda{
module _
  {𝓤 𝓥} {A : I → Type 𝓤} {B : I → Type 𝓥}
  where

  ap-hom
    : (f : {i : I} → A i → B i) {x : A i0} {y : A i1}
    → 𝐇omᵈ A x y → 𝐇omᵈ B (f x) (f y)
  ap-hom f (mk-𝐡om 𝐡om 𝐡om0 𝐡om1)
    = mk-𝐡om (f ∘ 𝐡om) (ap f 𝐡om0) (ap f 𝐡om1)

  ap-total-hom
    : ({i : I} → A i → B i)
      → (Σ[ x ∶ A i0 ] Σ[ y ∶ A i1 ] 𝐇omᵈ A x y)
      → Σ[ x' ∶ B i0 ] Σ[ y' ∶ B i1 ] 𝐇omᵈ B x' y'
  ap-total-hom F = map-Σ F (λ a → map-Σ F λ b → ap-hom F)

  ap-total-hom-is-equiv
    : {f : {i : I} → A i → B i}
    → ({i : I} → is-equiv (f {i})) → is-equiv (ap-total-hom f)
  ap-total-hom-is-equiv {f = F} Fe
    = tgt-is-equiv←Arrow-equiv
        (mk-arr-equiv total-hom total-hom ~refl)
        (postcomp-Π-equiv Fe)

  ap-hom-const
    : (b : {i : I} → B i) {x : A i0} {y : A i1}
    → (h : 𝐇omᵈ A x y)
    → ap-hom (λ {i} _ → b {i}) h ＝ λ𝐡om (λ i → b {i})
  ap-hom-const b (mk-𝐡om h refl refl) = refl

ap-hom-over
  : ∀ {𝓤 𝓥} {A : I → Type 𝓤} {B : (i : I) → A i → Type 𝓥}
      (f : {i : I} (a : A i) → B i a)
      {x : A i0} {y : A i1} (h : 𝐇omᵈ A x y)
    → 𝐇omᵈ-over h (f x) (f y)
ap-hom-over F (mk-𝐡om f 𝐡om0 𝐡om1) .𝐡om = F ∘ f
ap-hom-over F (mk-𝐡om f refl 𝐡om1) .𝐡om0 = refl
ap-hom-over F (mk-𝐡om f 𝐡om0 refl) .𝐡om1 = refl
}
}

\subtree[stt-00PD]{
\title{𝐇oms over constant families}
\taxon{Proposition}
\author{fredrikbakke}
\date{2026-05-07}

\p{A morphism in a constant family is the same as an ordinary morphism.}

\agda{
module _
  {𝓤 𝓥} {A : I → Type 𝓤} {B : I → Type 𝓥}
  {x : A i0} {y : A i1} {x' : B i0} {y' : B i1}
  where

  𝐇om←𝐇om-over-const : (f : 𝐇omᵈ A x y) → 𝐇omᵈ-over {B = λ i _ → B i} f x' y' → 𝐇omᵈ B x' y'
  𝐇om←𝐇om-over-const f
    = adjust-𝐡om
        (tr-constant (sym (f .𝐇omᵈ.𝐡om0)) x')
        (tr-constant (sym (f .𝐇omᵈ.𝐡om1)) y')

  𝐇om-over-const←𝐇om
    : (f : 𝐇omᵈ A x y)
    → 𝐇omᵈ B x' y'
    → 𝐇omᵈ-over {B = λ i _ → B i} f x' y'
  𝐇om-over-const←𝐇om f
    = adjust-𝐡om
        (sym (tr-constant (sym (f .𝐇omᵈ.𝐡om0)) x'))
        (sym (tr-constant (sym (f .𝐇omᵈ.𝐡om1)) y'))

  𝐇om←𝐇om-over-const-is-equiv
    : (f : 𝐇omᵈ A x y) → is-equiv (𝐇om←𝐇om-over-const f)
  𝐇om←𝐇om-over-const-is-equiv f
    = adjust-𝐡om-is-equiv
        (tr-constant (sym (f .𝐇omᵈ.𝐡om0)) x')
        (tr-constant (sym (f .𝐇omᵈ.𝐡om1)) y')

  𝐇om-over-const≃𝐇om
    : (f : 𝐇omᵈ A x y)
    → 𝐇omᵈ-over {B = λ i _ → B i} f x' y' ≃ 𝐇omᵈ B x' y'
  𝐇om-over-const≃𝐇om f
    = mk≃ (𝐇om←𝐇om-over-const f) (𝐇om←𝐇om-over-const-is-equiv f)
}
}

\subtree[stt-00DO]{
\title{Morphisms in #{Σ}-types}
\taxon{Remark}
\contributor{fredrikbakke}

\p{We can characterise morphisms in #{\Sigma} types as a pairs of a morphism,
and a dependent morphism.
#{\Hom_{\Sigma_A B}((x,x'), (y, y')) \simeq \Sigma1{f : \Hom_A(x,y)}{\Hom_f(x',y')}}}

\agda{
module _ {𝓤 𝓥} {A : I → Type 𝓤} {P : (i : I) → A i → Type 𝓥} where

  𝐇om-Σ
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
    → (Σ[ f ∶ 𝐇omᵈ A x y ] 𝐇omᵈ-over f x' y')
    → 𝐇omᵈ (λ i → Σ (A i) (P i)) (x , x') (y , y')
  𝐇om-Σ (mk-𝐡om f refl refl , mk-𝐡om f' refl refl) = λ𝐡om (λ i → f i , f' i)

  𝐇om-Σ-fst
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
    → 𝐇omᵈ (λ i → Σ (A i) (P i)) (x , x') (y , y') → 𝐇omᵈ A x y
  𝐇om-Σ-fst (mk-𝐡om f refl refl) = λ𝐡om (fst ∘ f)

  𝐇om-Σ-snd
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
    → (f : 𝐇omᵈ (λ i → Σ (A i) (P i)) (x , x') (y , y'))
    → 𝐇omᵈ-over (𝐇om-Σ-fst f) x' y'
  𝐇om-Σ-snd (mk-𝐡om f refl refl) = λ𝐡om (snd ∘ f)

  𝐇om-Σ-fst-β
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
      (f : 𝐇omᵈ A x y) (f' : 𝐇omᵈ-over f x' y')
    → 𝐇om-Σ-fst (𝐇om-Σ (f , f')) ＝ f
  𝐇om-Σ-fst-β (mk-𝐡om f refl refl) (mk-𝐡om f' refl refl) = refl

  𝐇om-Σ-ap-fst
    : {x : Σ (A i0) (P i0)} {y : Σ (A i1) (P i1)}
    → ap-hom fst {x = x} {y} ~ 𝐇om-Σ-fst
  𝐇om-Σ-ap-fst (mk-𝐡om f refl refl) = refl

  𝐇om-Σ-ap-fst-β
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
      (f : 𝐇omᵈ A x y) (f' : 𝐇omᵈ-over f x' y')
    → ap-hom fst (𝐇om-Σ (f , f')) ＝ f
  𝐇om-Σ-ap-fst-β (mk-𝐡om f refl refl) (mk-𝐡om f' refl refl) = refl

  𝐇om-Σ-snd-β
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
      (f : 𝐇omᵈ A x y) (f' : 𝐇omᵈ-over f x' y')
    → Idᵈ (ap (λ f → 𝐇omᵈ-over f x' y') (𝐇om-Σ-fst-β f f'))
      (𝐇om-Σ-snd (𝐇om-Σ (f , f'))) f'
  𝐇om-Σ-snd-β (mk-𝐡om f refl refl) (mk-𝐡om f' refl refl) = refl

  𝐇om-Σ-is-equiv
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
      → is-equiv (𝐇om-Σ {x' = x'} {y'})
  𝐇om-Σ-is-equiv = is-equiv←qinv
    ( (λ h → 𝐇om-Σ-fst h , 𝐇om-Σ-snd h)
    , (λ where (a , b) → Σ-path→ (𝐇om-Σ-fst-β a b , 𝐇om-Σ-snd-β a b))
    , λ where (mk-𝐡om h refl refl) → refl)

  𝐇om-Σ≃
    : {x : A i0} {y : A i1} {x' : P i0 x} {y' : P i1 y}
    → 𝐇omᵈ (λ i → Σ (A i) (P i)) (_ , x') (_ , y')
    ≃ Σ[ f ∶ 𝐇omᵈ A x y ] (𝐇omᵈ-over f x' y')
  𝐇om-Σ≃ = mk≃ 𝐇om-Σ 𝐇om-Σ-is-equiv e⁻¹

module _
  {𝓤 𝓥 𝓦} {A : I → Type 𝓤}
  {P : (i : I) → A i → Type 𝓥}
  {Q : (i : I) → A i → Type 𝓦}
  (f : (i : I) → A i) {x y a b}
  where

  𝐇omᵈ-×≊
    : (𝐇omᵈ (λ i → P i (f i) × Q i (f i)) (x , a) (y , b))
    ≊ ((𝐇omᵈ (λ i → P i (f i)) x y) × (𝐇omᵈ (λ i → Q i (f i)) a b))
  𝐇omᵈ-×≊ ._≊_.fwd (mk-𝐡om f refl refl)
    = (λ𝐡om (fst ∘ f) , λ𝐡om (snd ∘ f))
  𝐇omᵈ-×≊ ._≊_.fwd-qinv .fst (mk-𝐡om f refl refl , mk-𝐡om g refl refl)
    = λ𝐡om (λ i → f i , g i)
  𝐇omᵈ-×≊ ._≊_.fwd-qinv .snd .fst (mk-𝐡om f refl refl)
   = refl
  𝐇omᵈ-×≊ ._≊_.fwd-qinv .snd .snd (mk-𝐡om f refl refl , mk-𝐡om g refl refl)
    = refl

  𝐇omᵈ-×≃
    : (𝐇omᵈ (λ i → P i (f i) × Q i (f i)) (x , a) (y , b))
    ≃ ((𝐇omᵈ (λ i → P i (f i)) x y) × (𝐇omᵈ (λ i → Q i (f i)) a b))
  𝐇omᵈ-×≃ = equiv←qequiv 𝐇omᵈ-×≊

module _ {𝓤 𝓥} {A : I → Type 𝓤} {B : I → Type 𝓥} {x y a b} where

  𝐇om-×≃
    : (𝐇omᵈ (λ i → (A i) × (B i)) (x , a) (y , b)) ≃ ((𝐇omᵈ A x y) × (𝐇omᵈ B a b))
  𝐇om-×≃ = 𝐇omᵈ-×≃ {P = λ i _ → A i} {Q = λ i _ → B i} (λ _ → 𝟙)

𝐇om𝟙-is-single : is-singleton (𝐇om 𝟙 tt tt)
𝐇om𝟙-is-single = is-single←equiv
  (total-hom ∙e Σ-singl 𝟙-is-singleton tt ∙e Σ-singl 𝟙-is-singleton tt)
  (Π-is-single {A = I} {B = λ _ → 𝟙} λ _ → 𝟙-is-singleton)
}
}

\subtree[stt-00SK]{
\title{Homomorphism systems}
\taxon{Definition}
\author{fredrikbakke}
\author{samueltoth}
\date{2026-06-05}

\p{
A homomorphism system should be the analogue to that of
A homomorphism system should be analogous to an
[identity system](Foundations.IdentitySystems) on types, but for homomorphisms.
Informally, a binary family on a type is a \em{homomorphism system} if it comes
equipped with some sort of fibred equivalence from the #{\Hom} binary family.
}

\p{
For arbitrary types it is not entirely clear how to precisely define a
homomorphism system. Since there is no universal property of the #{\Hom}
binary family out of the box. There is for instance no canonical comparison map
from it to an arbitrary reflexive and transitive binary relation. For this reason
we might want to restrict the term "homomorphism system" to Segal types, where
#{\Hom} has a relevant universal property given by the
[Yoneda lemma](Synthetic.Categories.Yoneda). Though, one could also imagine objects
with weaker structure than being a category, which still have a #{\Hom} binary family
with a universal property.
}
}
