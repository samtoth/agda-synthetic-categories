\subtree[tot-2417]{
\title{The universal property of #{\flat}-connected maps}
\taxon{Definition}

\p{
For a [global subuniverse]() #{\mathcal{K}}, we say that a map #{f} has the universal
property of #{\flat}-#{\mathcal{K}}-connected maps if for each #{\mathcal{K}} valued
type family #{F}, the canoncial map
#{\product{b :^\flat B} F(b) \to \product{a :^\flat A} F(f(a))} is an equivalence.
}

\agda{
module _
  {@♭ 𝓤 𝓥} {𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
  (U : @♭ B → Type 𝓦) (@♭ f : A → B)
  where

  precomp-Π♭ : ((@♭ b : B) → U b) → (@♭ a : A) → U (f a)
  precomp-Π♭ g x = g (f x)

  precomp-Π♭≃
    : Arrow-equiv precomp-Π♭ (precomp-Π (♭-ind U) (♭-map f))
  precomp-Π♭≃ = mk-arr-equiv ♭-ind≃ ♭-ind≃ λ g → funext→ (♭-ind λ _ → refl)

module _
  {@♭ 𝓤 𝓥} {𝓦} {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
  (U : ⟨♭| B ⟩ → Type 𝓦) (@♭ f : A → B)
  where
  precomp-Π♭≃'
    : Arrow-equiv (precomp-Π♭ (λ x → U (mod♭ x)) f) (precomp-Π U (♭-map f))
  precomp-Π♭≃' = mk-arr-equiv ♭-ind≃ ♭-ind≃ (λ g → funext→ (♭-ind λ _ → refl))

up-♭-connected-map
  : ∀ {α} {@♭ 𝓤 𝓥} (K : gSubU α)
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      (@♭ f : A → B)
    → Typeω
up-♭-connected-map K f
  = ∀ {𝓚} {U : @♭ _ → Type 𝓚}
    → (∀ (@♭ b : _) → U b ∈ gSubU.S K)
    → is-equiv (precomp-Π♭ U f)
}
}

\subtree[tot-0L55]{
\taxon{Lemma}

\p{A map #{f} has the unversal property of #{\flat}-connected maps iff the map #{♭ f}
has the [universal property of connected maps]().}

\proof{
There is an equivalence of arrows between
#{\product{b :^\flat B} F(b) \to \product{a :^\flat A} F(f(a))}
and
#{\product{b : ♭ B} \hat{F}(b) \to \product{a : ♭ A} \hat{F}(♭f(a))}
}

\agda{
module
  _
  {α} {@♭ 𝓤 𝓥} (K : gSubU α)
  {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
  {@♭ f : A → B}
  where

  up-connected-♭-map←up-♭-connected-map
    : up-♭-connected-map K f → up-connected-map K (♭-map f)
  up-connected-♭-map←up-♭-connected-map fc {U = U} UK
    = tgt-is-equiv←Arrow-equiv (precomp-Π♭≃' U f)
        (fc {U = λ x → U (mod♭ x)} (λ x → UK (mod♭ x)))

  up-♭-connected-map←up-connected-♭-map
    : up-connected-map K (♭-map f) → up-♭-connected-map K f
  up-♭-connected-map←up-connected-♭-map fc {U = U} UK
    = src-is-equiv←Arrow-equiv (precomp-Π♭≃ U f) (fc (♭-ind UK))
}
}

\subtree[tot-0PSI]{
\title{#{♭}-connected maps}
\taxon{Definition}

\p{For a particular [global reflective subuniverse](), a crisp map #{f} is
\strong{#{\flat}-connected} if #{\flat f} is [connected]().}

\agda{
is-♭-connected
  : ∀ {α : Level → Level} {@♭ 𝓤 𝓥} (K : gRSubU α)
      {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
      (@♭ f : A → B)
    → Type (𝓤 ⊔ 𝓥)
is-♭-connected K f = is-connected-map K (♭-map f)
}
}


\subtree[tot-02LA]{
\title{Flat connected maps are closed under the same operations as connected
maps}
\taxon{Corollary}

\agda{
module _ {α} (𝒦 : gRSubU α) (let 𝒦r = 𝒦 .gRSubU.GS) where
  is-♭-connected←retraction-arrow-map
    : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
        {@♭ A : Type 𝓤} {@♭ B : Type 𝓥}
        {@♭ C : Type 𝓦} {@♭ D : Type 𝓜}
        {@♭ f : A → B} {@♭ g : C → D}
      → (@♭ F : Arrow-map f g)
      → @♭ retraction-arrow-map F
      → is-♭-connected 𝒦 g
      → is-♭-connected 𝒦 f
  is-♭-connected←retraction-arrow-map F Fr gc
    = is-connected-map←up-connected-map _
        (up-connected-map←retraction-arrow-map
          𝒦r
          (♭Square F)
          (♭-retraction-arrow-map F Fr)
          (up-connected-map←is-connected-map _ gc))
    where
    open gRSubUConnectedCharacterisation 𝒦

  ×₁-is-♭-connected
    : ∀ {@♭ 𝓤 𝓥 𝓦 𝓜}
        {@♭ A : Type 𝓤} {@♭ B : Type 𝓥} {@♭ f : A → B}
        {@♭ X : Type 𝓦} {@♭ Y : Type 𝓜} {@♭ g : X → Y}
      → is-♭-connected 𝒦 f
      → is-♭-connected 𝒦 g
      → is-♭-connected 𝒦 (f ×₁ g)
  ×₁-is-♭-connected {f = f} {g = g} fc gc
    = is-connected-map←up-connected-map _
        (src-has-up-connected-map←arrow-equiv
          𝒦r
          (♭-×₁ f g)
          (×₁-up-connected-map 𝒦r
              (up-connected-map←is-connected-map (♭-map f) fc)
              (up-connected-map←is-connected-map (♭-map g) gc)))
    where
    open gRSubUConnectedCharacterisation 𝒦
}
}


