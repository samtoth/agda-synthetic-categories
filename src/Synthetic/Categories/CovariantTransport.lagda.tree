\import{stt-macros}

\subtree[bak-8F11]{
\taxon{Idea}
\author{fredrikbakke}
\date{2026-11-05}

\p{
This module concerns the structure of covariant transport in type families. I.e., given
a type family #{B \colon A \to \UU}, then \em{covariant transport} is a map
##{(\blank)_* \colon \Hom_A(x,y) \to B(x) \to B(y)} for every pair of elements #{x}
and #{y} in #{A}.
}
}

\transclude{stt-00AB}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.CovariantTransport
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Algebra.Lattice.Instances.Polynomial hiding (Δ²)
private Δ² = Algebra.Lattice.Instances.Polynomial.Δ² I

open import Axioms.UF
}

