\subtree[fre-2B35]{
\title{The interchange law}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-08-28}

\p{
Two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}}  on a type #{X}
satisfy \em{the interchange law} if, for all #{a\ b\ c\ d : X}, the following
equation holds
##{(a \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} d) = (a \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} d).}
}

\p{
We say the two binary operations satisfy \em{outer interchange} at an element
#{e : X} if
##{(a \mathbin{◾} e) \mathbin{◽} (e \mathbin{◾} d) = (a \mathbin{◽} e) \mathbin{◾} (e \mathbin{◽} d)}
holds for all #{a\ d : X}, and we say the two binary operations satisfy
\em{inner interchange} at an element #{e : X} if
##{(e \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} e) = (e \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} e)}
holds for all #{b\ c : X}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  InterchangeLaw
    : (X → X → X) → (X → X → X) → Type 𝓤
  InterchangeLaw _◾_ _◽_
    = (a b c d : X)
    → (a ◾ b) ◽ (c ◾ d) ＝ (a ◽ c) ◾ (b ◽ d)

  OuterInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  OuterInterchangeLaw _◾_ _◽_ e
    = (a d : X)
    → (a ◾ e) ◽ (e ◾ d) ＝ (a ◽ e) ◾ (e ◽ d)

  InnerInterchangeLaw
    : (X → X → X) → (X → X → X) → X → Type 𝓤
  InnerInterchangeLaw _◾_ _◽_ e
    = (b c : X)
    → (e ◾ b) ◽ (c ◾ e) ＝ (e ◽ c) ◾ (b ◽ e)
}
}

\subtree[fre-DAF1]{
\title{Outer interchange at the unit implies operations are equal}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{outer interchange law}, for all #{a\ d : X}:
##{(a \mathbin{◾} e) \mathbin{◽} (e \mathbin{◾} d) = (a \mathbin{◽} e) \mathbin{◾} (e \mathbin{◽} d)}
then the two binary operations are equal.
}

\agda{
equal-ops←outer-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → OuterInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ x ◾ y
equal-ops←outer-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ outer-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (r◾ x) (l◾ y)) ⟩
    (x ◾ e) ◽ (e ◾ y)
      ＝⟨ outer-◾-◽-interchange x y ⟩
    (x ◽ e) ◾ (e ◽ y)
      ＝⟨ ap₂ (_◾_) (r◽ x) (l◽ y) ⟩
    x ◾ y ∎
}
}

\subtree[fre-11E4]{
\title{Inner interchange at the unit implies operations are opposites}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{inner interchange law}, for all #{b\ c : X}:
##{(e \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} e) = (e \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} e)}
then the two binary operations are opposites: #{{b}\mathbin{◾}{c} = {c}\mathbin{◽}{b}}
}

\agda{
opposite-ops←inner-interchange
  : ∀ {𝓤} {X : Type 𝓤}
      (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InnerInterchangeLaw (_◾_) (_◽_) e
    → (x y : X)
    → x ◽ y ＝ y ◾ x
opposite-ops←inner-interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ inner-◾-◽-interchange x y
  = x ◽ y
      ＝⟨ sym (ap₂ (_◽_) (l◾ x) (r◾ y)) ⟩
    (e ◾ x) ◽ (y ◾ e)
      ＝⟨ inner-◾-◽-interchange x y ⟩
    (e ◽ y) ◾ (x ◽ e)
      ＝⟨ ap₂ (_◾_) (l◽ y) (r◽ x) ⟩
    y ◾ x ∎
}
}

\subtree[fre-D0CE]{
\title{The algebraic Eckmann–Hilton argument}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-27}

\p{
Given two binary operations #{{-}\mathbin{◾}{-}} and #{{-}\mathbin{◽}{-}} on a type
#{X} which share a two-sided unit element #{e} and which satisfy the
\em{interchange law} for all #{a\ b\ c\ d : X}:
##{(a \mathbin{◾} b) \mathbin{◽} (c \mathbin{◾} d) = (a \mathbin{◽} b) \mathbin{◾} (c \mathbin{◽} d)}
then the two binary operations are equal and symmetric.
}

\proof{
We have seen that outer interchange gives #{x \mathbin{◾} y = x \mathbin{◽} y},
and that inner interchange gives #{x \mathbin{◾} y = y \mathbin{◽} x}, hence
#{x \mathbin{◽} y = y \mathbin{◽} x}.
}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  comm←interchange
    : (_◾_ _◽_ : X → X → X) (e : X)
    → ((x : X) → e ◾ x ＝ x)
    → ((x : X) → x ◾ e ＝ x)
    → ((x : X) → e ◽ x ＝ x)
    → ((x : X) → x ◽ e ＝ x)
    → InterchangeLaw (_◾_) (_◽_)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
  comm←interchange _◾_ _◽_ e l◾ r◾ l◽ r◽ ◾-◽-interchange x y
    = equal-ops←outer-interchange
        (_◾_) (_◽_) e l◾ r◾ l◽ r◽
        (λ a d → ◾-◽-interchange a e e d)
        (x)
        (y)
    ∙ sym
        ( opposite-ops←inner-interchange
          (_◾_) (_◽_) e l◾ r◾ l◽ r◽
          (λ b c → ◾-◽-interchange e b c e)
          (y)
          (x))

  comm←interchange'
    : (_◽_ : X → X → X) (L R : X → X)
    → L ~ id → R ~ id
    → ((x y : X) → L x ◽ R y ＝ R y ◽ L x)
    → (x y : X)
    → x ◽ y ＝ y ◽ x
  comm←interchange' _◽_ L R l r L◽R-commute x y
    = sym (ap₂ (_◽_) (l x) (r y)) ∙ L◽R-commute x y ∙ ap₂ (_◽_) (r y) (l x)
}
}

\subtree[fre-98A0]{
\title{The Eckmann–Hilton argument for double loop spaces}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-28}

\p{The concatenation operation on double loop spaces is commutative.}

\agda{
module _ {𝓤} {X : Type 𝓤} where

  ∙Ω²-comm : {a : X} (p q : Ω² X a) → p ∙ q ＝ q ∙ p
  ∙Ω²-comm
    = comm←interchange' (_∙_) (refl ◂_) (_▸ refl)
        (◂-left-unit)
        (▸-right-unit')
        (λ p q → ◂▸-∙-interchange q p)
}
}

\subtree[fre-1982]{
\title{Syllepsis}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-08-27}
\date{2026-08-28}
\date{2026-08-29}

\p{
The Eckmann–Hilton symmetry #{\operatorname{EH}} is its own inverse on 3-loops. I.e.,
given two 3-loops #{p} and #{q}, then
#{\operatorname{EH}(p,q) = \operatorname{EH}(q,p)^{-1}}.
}

\p{Our proof and formalisation follows Sojakova–Kavvos \cite{SK22}.}



\subtree[fre-BB2E]{
\title{Naturality of the Eckmann–Hilton symmetry}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-29}

\p{
The Eckmann–Hilton symmetry is natural with respect to whiskering.
}

\agda{
module SyllepsisProof {𝓤} {X : Type 𝓤} where

  ∙Ω²-comm-refl-left-coh
    : {a b c : X} {p q : a ＝ b} {r : b ＝ c}
      {α : p ＝ q} {s : p ∙ r ＝ q ∙ r}
    → (θ : α ▸ r ＝ s)
    → (sym (refl ◾ θ) ∙ ◂▸-∙-interchange α refl ∙ (θ ◾ refl)) ∙ ∙-reflr s
    ＝ ∙-refll s
  ∙Ω²-comm-refl-left-coh {α = refl} refl = refl

  ∙Ω²-comm-refl-left
    : {a : X} (p : Ω² X a)
    → ∙Ω²-comm refl p ∙ ∙-reflr p ＝ ∙-refll p
  ∙Ω²-comm-refl-left p = ∙Ω²-comm-refl-left-coh (▸-right-unit' p)

  ∙Ω²-comm-refl-right-coh
    : {a b c : X} {p : a ＝ b} {q r : b ＝ c}
      {α : q ＝ r} {s : p ∙ q ＝ p ∙ r}
    → (θ : p ◂ α ＝ s)
    → (sym (θ ◾ refl) ∙ ◂▸-∙-interchange refl α ∙ (refl ◾ θ)) ∙ ∙-refll s
    ＝ ∙-reflr s
  ∙Ω²-comm-refl-right-coh {α = refl} refl = refl

  ∙Ω²-comm-refl-right
    : {a : X} (p : Ω² X a)
    → ∙Ω²-comm p refl ∙ ∙-refll p ＝ ∙-reflr p
  ∙Ω²-comm-refl-right p = ∙Ω²-comm-refl-right-coh (◂-left-unit p)

  ∙Ω²-comm-nat-left
    : {a : X} {p q : Ω² X a} (r : Ω² X a) (α : p ＝ q)
    → (α ▸ r) ∙ ∙Ω²-comm q r ＝ ∙Ω²-comm p r ∙ (r ◂ α)
  ∙Ω²-comm-nat-left r α = sym (homotopy-natural (λ p → ∙Ω²-comm p r) α)

  ∙Ω²-comm-nat-right
    : {a : X} {p q : Ω² X a} (r : Ω² X a) (α : p ＝ q)
    → (r ◂ α) ∙ ∙Ω²-comm r q ＝ ∙Ω²-comm r p ∙ (α ▸ r)
  ∙Ω²-comm-nat-right r α = sym (homotopy-natural (λ p → ∙Ω²-comm r p) α)

  ∙Ω²-comm-nat-right-coh
    : {a : X} {p : Ω² X a} (α : refl ＝ p)
    → ∙Ω²-comm-nat-right refl α ◫ ▸-right-unit-nat α
    ＝ ((refl ◂ α) ◂ ∙Ω²-comm-refl-left p) ∙ ◂-left-unit-nat α
  ∙Ω²-comm-nat-right-coh refl = refl

  ∙Ω²-comm-nat-left-coh
    : {a : X} {p : Ω² X a} (α : refl ＝ p)
    → ∙Ω²-comm-nat-left refl α ◫ ◂-left-unit-nat α
    ＝ ((α ▸ refl) ◂ ∙Ω²-comm-refl-right p) ∙ ▸-right-unit-nat α
  ∙Ω²-comm-nat-left-coh refl = refl

  ∙Ω²-comm-double-nat
    : {a : X} {p q r s : Ω² X a}
      (α : p ＝ q) (β : r ＝ s)
    → ( ◂▸-∙-interchange α β ▸ ∙Ω²-comm q s)
    ∙ ( ∙Ω²-comm-nat-left r α ⊟ ∙Ω²-comm-nat-right q β)
    ＝ ( ∙Ω²-comm-nat-right p β ⊟ ∙Ω²-comm-nat-left s α)
    ∙ sym (∙Ω²-comm p r ◂ ◂▸-∙-interchange β α)
  ∙Ω²-comm-double-nat refl refl = ∙-reflr' _
}
}

\subtree[fre-A2E5]{
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-28}

\p{
Given a diagram of equalities of the form

\quiver{
\begin{tikzcd}
TODO
\arrow["?", from=?-?, to=?-?]
\end{tikzcd}
}

then ?
}

\p{This is \citet{Lemma 7.2}{SK22}.}

% TODO: add diagram

\agda{
  squeeze-triangle
    : {a b c : X} {p q r : a ＝ b} {p' q' r' : b ＝ c}
      {upper-left  : p  ∙ refl ＝ refl ∙ q }
      {upper-right : q  ∙ refl ＝ refl ∙ r }
      {lower-left  : p' ∙ refl ＝ refl ∙ q'}
      {lower-right : q' ∙ refl ＝ refl ∙ r'}
      {upper       : p  ∙ refl ＝ refl ∙ r }
      {lower       : p' ∙ refl ＝ refl ∙ r'}
    → upper-left ◫ upper-right ＝ upper
    → lower-left ◫ lower-right ＝ lower
    → (∙-reflr' (p ∙ p') ∙ (upper-left ⊟ lower-left))
    ∙ ((∙-reflr' q ∙ upper-right) ◾ (∙-reflr' q' ∙ lower-right))
    ＝ (∙-reflr' p ∙ upper) ◾ (∙-reflr' p' ∙ lower)
  squeeze-triangle
    {p = refl} {p' = refl}
    {upper-left = refl} {upper-right = refl}
    {lower-left = refl} {lower-right = refl}
    refl refl
    = refl
}
}

\subtree[fre-A2E5]{
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-08-28}

\p{This is \citet{Lemma 7.3}{SK22}.}

% TODO: add diagram

\agda{
  syllepsis-pasting
    : {a b : X}
      {top upper-left upper-right lower-left lower-right bottom : a ＝ b}
      {top-left     : upper-left  ＝ top}
      {top-right    : upper-right ＝ top}
      {middle-left  : upper-left  ＝ lower-left}
      {middle-right : lower-right ＝ upper-right}
      {bottom-left  : lower-left  ＝ bottom}
      {bottom-right : lower-right ＝ bottom}
      {upper-square : upper-left ∙ refl ＝ refl ∙ upper-right}
      {lower-square : lower-left ∙ refl ＝ refl ∙ lower-right}
    → (middle-left ▸ refl) ∙ lower-square
    ＝ upper-square ∙ sym (refl ◂ middle-right)
    → (∙-reflr' upper-left ∙ upper-square) ∙ top-right ＝ top-left
    → (∙-reflr' lower-left ∙ lower-square) ∙ bottom-right ＝ bottom-left
    → (sym top-left ∙ middle-left ∙ bottom-left)
    ∙ (sym bottom-right ∙ middle-right ∙ top-right)
    ＝ refl
  syllepsis-pasting
    {top-left = refl} {middle-left = refl}
    {middle-right = refl} {bottom-right = refl}
    square upper-triangle lower-triangle
    = (sym lower-triangle ∙ ∙-reflr _ ∙ (∙-reflr' _ ◂ (square ∙ ∙-reflr _))) ▸ _
    ∙ upper-triangle
}
}

\agda{
module _ {𝓤} {A : Type 𝓤} {a : A} where

  ∙Ω³-comm : (p q : Ω³ A a) → p ∙ q ＝ q ∙ p
  ∙Ω³-comm = ∙Ω²-comm

  ∙Ω³-syllepsis
    : (p q : Ω³ A a)
    → ∙Ω³-comm p q ∙ ∙Ω³-comm q p ＝ refl
  ∙Ω³-syllepsis p q
    = let open SyllepsisProof
    in syllepsis-pasting
        (∙Ω²-comm-double-nat q p)
        (squeeze-triangle (∙Ω²-comm-nat-right-coh p) (∙Ω²-comm-nat-left-coh q))
        (squeeze-triangle (∙Ω²-comm-nat-left-coh q) (∙Ω²-comm-nat-right-coh p))
}
}
}
