\title{STT macros}
\date{2025-02-19}
\author{samueltoth}
\contributor{fredrikbakke}
\tag{macro}

\p{This tree is dedicated to forester macro code, please consult the [source code](https://github.com/samtoth/agda-synthetic-categories/blob/main/trees/macros/stt-macros.tree) instead.}


\export{basic-macros}
\export{agda-macros}

\xmlns:html{http://www.w3.org/1999/xhtml}

% Font
\def\rm[x]{\textrm{\x}}

% Sigma types
\def\Sigma1[x][y]{({\x})\times{\y}}
\def\Sigma2[x][y][z]{({\x})\,({\y})\times{\z}}
\def\Sigma3[x][y][z][w]{({\x})\,({\y})\,({\z})\times{\w}}
\def\Sigma4[x][y][z][w][v]{({\x})\,({\y})\,({\z})\,({\w})\times{\v}}
\def\Sigma5[x][y][z][w][v][u]{({\x})\,({\y})\,({\z})\,({\w})\,({\v})\times{\u}}

% Pi types
\def\Pi1[x][y]{({\x})\to{\y}}
\def\Pi2[x][y][z]{({\x})\,({\y})\to{\z}}
\def\Pi3[x][y][z][w]{({\x})\,({\y})\,({\z})\to{\w}}
\def\Pi4[x][y][z][w][v]{({\x})\,({\y})\,({\z})\,({\w})\to{\v}}
\def\Pi5[x][y][z][w][v][u]{({\x})\,({\y})\,({\z})\,({\w})\,({\v})\to{\u}}

% Identity types
\def\refl{\mathrm{refl}}
\def\depid[p]{=_{\p}}
\def\nullhtpy{\operatorname{\textrm{null{-}htpy}}}
% Concatenation
\def\concat{\mathbin{\boldsymbol{\cdot}}}
\def\hconcat{\mathbin{\vcenter{\hbox{$\scriptscriptstyle\blacksquare$}}}}
\def\vconcat{\mathbin{\vcenter{\hbox{$\scriptscriptstyle\square$}}}}
% Whiskering wrt. concatenation
\def\lwhisk{\mathbin{\vcenter{\hbox{\scalebox{0.65}{$\scriptscriptstyle\blacktriangleleft$}}}}}
\def\rwhisk{\mathbin{\vcenter{\hbox{\scalebox{0.65}{$\scriptscriptstyle\blacktriangleright$}}}}}
% Whiskering wrt. composition
\def\rwhiskcomp{\mathbin{\vcenter{\hbox{$\scriptstyle\triangleright$}}}}
\def\lwhiskcomp{\mathbin{\vcenter{\hbox{$\scriptstyle\triangleleft$}}}}
% Pasting
\def\vpaste{\mathbin{\scriptstyle\boxminus}}
\def\hpaste{\mathbin{\scriptstyle ◫}} % ! WARNING: cannot be used in tikzcd

% Universes
\def\Type{#{\mathsf{Type}}}
\def\Prop{#{\mathsf{Prop}}}

\def\UU{#{\mathcal{U}}}
\def\UV{#{\mathcal{V}}}
\def\UW{#{\mathcal{W}}}

\def\CC{#{\mathcal{C}}}
\def\CD{#{\mathcal{D}}}
\def\CE{#{\mathcal{E}}}
\def\SS{#{\mathcal{S}}}

% Standard functions
\def\id{\operatorname{id}}
\def\tot[x]{{\startverb \~\stopverb{\x}}}
\def\ap{\operatorname{ap}}
\def\fst{\operatorname{fst}}
\def\snd{\operatorname{snd}}
\def\glue{\operatorname{glue}}
\def\point{\operatorname{point}}
\def\Im{\operatorname{Im}}
\def\suc{\operatorname{suc}}
\def\const{\operatorname{const}}
\def\ev{\operatorname{ev}}

% Relations
\def\defeq{\coloneqq} % :=
\def\toeq{\xrightarrow{\sim}}

% Blackboard bold glyphs
\def\b1{#{\mathbb{1}}}
\def\b2{#{\mathbb{2}}}
\def\bR{#{\mathbb{R}}}
\def\bQ{#{\mathbb{Q}}}
\def\bZ{#{\mathbb{Z}}}
\def\bN{#{\mathbb{N}}}

% Empty type
\def\Empty{#{\mathsf{Empty}}}

% Booleans
\def\Bool{#{\mathrm{Bool}}}
\def\true{#{\mathrm{true}}}
\def\false{#{\mathrm{false}}}

% Standard finite types
\def\Fin{\operatorname{Fin}}

% Truncations
\def\trunc[x]{{\left\lVert{\x}\right\rVert}}
\def\proptrunc[x]{\trunc{\x}_{-1}}
\def\settrunc[x]{\trunc{\x}_0}

% Fibres
\def\fibre-noarg{\operatorname{\mathrm{fib}}}
\def\fibre-fam[f]{\fibre-noarg_{\f}}
\def\fibre[f][a]{\fibre-fam{\f}(\a)}

\def\Im{\operatorname{Im}}

% Extensions
\def\Ext-noarg{\operatorname{\mathrm{Ext}}}
\def\Ext-fam[f]{\Ext-noarg_{\f}}
\def\Ext[f][a]{\Ext-fam{\f}(\a)}

% Cofibres
\def\cofibre-noarg{\operatorname{\mathrm{cofib}}}
\def\cofibre[f]{\cofibre-noarg_{\f}}

% Colimits
\def\suspension{\mathop{\kern0pt \mathsf{S}}\nolimits}
\def\reducedsuspension{\mathop{\kern0pt \mathsf{\Sigma}}\nolimits}
\def\loops{\mathop{\kern0pt \mathsf{\Omega}}\nolimits}
\def\sphere[n]{\mathrm{S}^{\n}}
\def\bjoin{\mathbin{\diamond}}

% Pullback power & pushout product
\def\pulldpow{\operatorname{\hat{\mathsf{\Pi}}}}
\def\pullpow[f][g]{{\left\langle{\f},{\g}\right\rangle}}
\def\pushsum{\operatorname{\hat{\mathsf{\Sigma}}}}
\def\pushprod{\mathbin{\square}}
\def\ttt{#{\boxslash}}

% Algebra
\def\II{\mathbb{I}}
\def\Spec{\operatorname{Spec}}
\def\Alg{\mathrm{Alg}}
\def\Obs{\operatorname{\mathcal{O}}}

% Synthetic morphisms
\def\Hom{\operatorname{Hom}}
\def\Iso{\operatorname{Iso}}
\def\Hom2{\Hom^2}
\def\Arr{\operatorname{Arr}}
\def\Gl{\operatorname{Gl}}

\def\lhtpy{\sim_{\Delta}}
\def\rhtpy{\mathrel{{}_{\Delta}{\sim}}}

\def\op{\textrm{op}}

% Modal type theory
% Preserve \colon spacing with superscript
\def\colon-flat{\nobreak\mskip2mu\mathpunct{}\mathchoice{\mkern-3mu}{\mkern-3mu}{}{}{:}^{\flat}\mskip6mu\relax}
\def\colon-sharp{\nobreak\mskip2mu\mathpunct{}\mathchoice{\mkern-3mu}{\mkern-3mu}{}{}{:}^{\sharp}\mskip6mu\relax}

\def\modflat[x]{\langle \flat | {\x} \rangle}
\def\modsharp[x]{\langle \sharp | {\x} \rangle}
\def\mod{\textsf{mod}}
