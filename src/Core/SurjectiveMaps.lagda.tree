\subtree[stt-00GI]{
\date{2026-03-10}
\author{fredrikbakke}
\taxon{Definition}
\title{Surjections}

\p{
A map is \em{surjective} if each of its [fibres](stt-000M) is inhabited, i.e., if the
[propositional truncation](stt-006Q) of every fibre has an element.
}

\agda{
is-surjective
  : {𝓤 𝓥 : Level} {A : Type 𝓤} {B : Type 𝓥}
  → (f : A → B) → Type (𝓤 ⊔ 𝓥)
is-surjective {B = B} f = (b : B) → ║ fibre f b ║
}
}

\subtree[bak-R3BO]{
\title{Propositional induction for surjections}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-10}

\p{
Given a surjection #{f \colon A \to B} and a predicate on #{P}, then to prove
#{\forall b . P(b)} it suffices to prove #{\forall a . P(f(a))}.
}

\agda{
module _
  {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
  {f : A → B} (f-is-surjective : is-surjective f)
  (P : B → Type 𝓦) (P-is-prop : (b : B) → is-prop (P b))
  where

  ind-is-surjective : ((a : A) → P (f a)) → (b : B) → P b
  ind-is-surjective s b
    = Trunc.○-rec
        (is-truncated←is-prop (P-is-prop b))
        (λ (a , p) → tr P p (s a))
        (f-is-surjective b)

  precomp-Π-Prop-is-equiv←is-surjective : is-equiv (precomp-Π P f)
  precomp-Π-Prop-is-equiv←is-surjective
    = is-equiv←inverse
        (Π-is-prop P-is-prop)
        (Π-is-prop (P-is-prop ∘ f))
        (ind-is-surjective)
}
}

\subtree[bak-2D1C]{
\title{Fibrewise equivalences are detected on restrictions along surjections}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-10}

\p{
Given a surjection #{f \colon A \to B}, and a family of maps
#{g : \Pi_{(b : B)}(P(b) \to Q(b))}, then to show #{g} is a family of equivalences
it suffices to show that its retriction along #{f} is.
}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓛} {A : Type 𝓤} {B : Type 𝓥}
  {f : A → B} (f-is-surjective : is-surjective f)
  {P : B → Type 𝓦} {Q : B → Type 𝓛}
  (g : (b : B) → P b → Q b)
  where

  is-fibrewise-equiv←surjective-restrict
    : is-fibrewise-equiv (g ∘ f) → is-fibrewise-equiv g
  is-fibrewise-equiv←surjective-restrict
    = ind-is-surjective f-is-surjective (is-equiv ∘ g) (λ _ → is-equiv-is-prop)
}
}

\subtree[stt-00XZ]{
\title{Surjective dependent precomposition gives fibrewise null-homotopies}
\taxon{Lemma}
\author{fredrikbakke}
\date{2026-09-10}

\p{
Let #{f : A \to B} be such that precomposition at #{U : B \to \Type} is surjective,
and let #{\eta : \Pi_{(b : B)} \fibre{f}{b} \to U(b)}, then each #{\eta(b)} is
merely null-homotopic.
}

\agda{
mere-null-homotopy-fibres←surjective-precomp-Π
  : ∀ {𝓤 𝓥 𝓦} {A : Type 𝓤} {B : Type 𝓥}
    (f : A → B) {U : B → Type 𝓦}
    (η : (b : B) → fibre f b → U b)
  → is-surjective (precomp-Π U f)
  → (b : B) → ║ null-homotopy (η b) ║
mere-null-homotopy-fibres←surjective-precomp-Π f η surj b
  = Trunc.○-rec Trunc.○∈S
      (λ (s , H) → Trunc.η (s b , λ where (a , refl) → happly H a))
      (surj (λ a → η (f a) (a , refl)))
}
}

\subtree[stt-00GJ]{
\date{2026-03-10}
\author{fredrikbakke}
\taxon{Theorem}
\title{Surjections are closed under homotopies}

\agda{
module _
  {𝓤 𝓥 : Level}
  {A : Type 𝓤} {B : Type 𝓥}
  {f g : A → B} where

  is-surjective~ : f ~ g → is-surjective f → is-surjective g
  is-surjective~ H sf b
    = Trunc.○-rec Trunc.○∈S (Trunc.η ∘ fib-map) (sf b) where
    fib-map : fibre f b → fibre g b
    fib-map (a , p) = (a , sym (H a) ∙ p)
}
}

\subtree[stt-00GO]{
\date{2026-03-10}
\author{fredrikbakke}
\taxon{Proposition}
\title{Surjections are closed under composition}

\agda{
module _
  {𝓤 𝓥 𝓦 : Level}
  {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
  {f : B → C} {g : A → B} where

  is-surjective-∘
    : is-surjective f → is-surjective g → is-surjective (f ∘ g)
  is-surjective-∘ sf sg c
    = Trunc.○-rec Trunc.○∈S
        (λ (b , p)
        → Trunc.○-rec Trunc.○∈S (λ (a , q) → Trunc.η (a , ap f q ∙ p)) (sg b))
        (sf c)
}
}

\subtree[stt-00GK]{
\date{2026-03-10}
\author{fredrikbakke}
\taxon{Proposition}
\title{3-for-2 property of surjections}

\agda{
module _
  {𝓤 𝓥 𝓦 : Level}
  {A : Type 𝓤} {B : Type 𝓥} {C : Type 𝓦}
  {f : B → C} {g : A → B} where

  is-surjective-right-cancel
    : is-surjective (f ∘ g) → is-surjective f
  is-surjective-right-cancel s c
    = Trunc.○-rec Trunc.○∈S (λ (a , p) → Trunc.η (g a , p)) (s c)

  is-surjective~∘
    : {h : A → C}
    → h ~ f ∘ g
    → is-surjective f
    → is-surjective g
    → is-surjective h
  is-surjective~∘ H sf sg
    = is-surjective~ (H h⁻¹) (is-surjective-∘ sf sg)

  is-surjective-3-for-2~'
    : {h : A → C}
    → h ~ f ∘ g
    → is-surjective h
    → is-surjective f
  is-surjective-3-for-2~' H sh
    = is-surjective-right-cancel (is-surjective~ H sh)
}
}

\subtree[stt-00GL]{
\date{2026-03-10}
\author{fredrikbakke}
\taxon{Theorem}
\title{A surjective embedding is an equivalence}

\agda{
module _ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥} {f : A → B} where

  has-singleton-fibres←is-surjective-embedding
    : is-surjective f → is-embedding f → has-singleton-fibres f
  has-singleton-fibres←is-surjective-embedding surj emb b
    = Trunc.○-rec
        (is-truncated←is-prop is-single-is-prop)
        (λ fib → mk-singl fib (is-prop-map←is-embedding emb b fib))
        (surj b)

  is-equiv←is-surjective-embedding
    : is-surjective f → is-embedding f → is-equiv f
  is-equiv←is-surjective-embedding surj emb
    = is-equiv←has-singleton-fibres (has-singleton-fibres←is-surjective-embedding surj emb)
}
}
