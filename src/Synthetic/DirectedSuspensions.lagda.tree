open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Boundaries Δ¹ I
}
}

\subtree[stt-014N]{
\title{Directed suspension}
\taxon{Definition}
\author{fredrikbakke}
\date{2026-09-19}

\p{
The \em{directed suspension} of a type #{A}, denoted #{\dirsuspension A}, is its
[relative suspension](stt-012G) with respect to the [boundary inclusion](stt-00LG)
#{∂Δ¹ \to Δ¹}.
}

\agda{
DirectedSusp : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
DirectedSusp = RelativeSusp ∂Δ¹-incl
}

\p{
A map #{f \colon A \to B} induces a map on directed suspensions by the functorial
action

\quiver{
\begin{tikzcd}
\partial\Delta^1 \times A && \partial\Delta^1 \\
& \Delta^1 \times A && \dirsuspension A \\
\partial\Delta^1 \times B && \partial\Delta^1 \\
& \Delta^1 \times B && \dirsuspension B
\arrow[from=1-1, to=1-3]
\arrow[from=3-1, to=3-3]
\arrow[from=1-1, to=3-1]
\arrow[from=1-3, to=3-3]
\arrow[from=2-2, to=2-4, crossing over]
\arrow[from=4-2, to=4-4, crossing over]
\arrow[from=2-2, to=4-2]
\arrow[from=2-4, to=4-4, "\dirsuspension f"]
\arrow[from=1-1, to=2-2]
\arrow[from=3-1, to=4-2]
\arrow[from=1-3, to=2-4]
\arrow[from=3-3, to=4-4]
\end{tikzcd}
}
}

\agda{
DirectedSusp-map
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B) → DirectedSusp A → DirectedSusp B
DirectedSusp-map = RelativeSusp-map ∂Δ¹-incl
}
}

\subtree[stt-014C]{
\title{The hom separation is given by local hom types}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
The \em{hom separation} of a [global subuniverse](stt-007A) is its
[relative separation](stt-012G) at #{∂Δ¹ \to Δ¹}. A type belongs to the hom
separation precisely when all its [hom types](stt-00LG) belong to the original
subuniverse.
}

\agda{
module _ {α} (K : gSubU α) (open gSubU K) where

  is-hom-separated : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤 ⊔ α (𝓘 ⊔ 𝓤))
  is-hom-separated = is-relatively-separated (point ∂Δ¹-incl) K

  HomSeparated-gSubU : gSubU (λ 𝓤 → 𝓘 ⊔ 𝓤 ⊔ α (𝓘 ⊔ 𝓤))
  HomSeparated-gSubU = relatively-separated-gSubU (point ∂Δ¹-incl) K

  module _ {𝓤} {A : Type 𝓤} where

    Hom∈S←is-hom-separated
      : is-hom-separated A
      → (a b : A) → Hom A a b ∈ S
    Hom∈S←is-hom-separated sep a b
      = ∈S←equiv (Hom≃Ext-∂Δ¹-incl e⁻¹) (sep tt (make-∂Δ¹ b a))

    is-hom-separated←Hom∈S
      : ((a b : A) → Hom A a b ∈ S)
      → is-hom-separated A
    is-hom-separated←Hom∈S h _ f
      = ∈S←equiv
          ( Hom≃Ext-∂Δ¹-incl
          ∙e coe≃ (ap (Ext ∂Δ¹-incl) (funext→ (λ where ∂Δ¹-0 → refl; ∂Δ¹-1 → refl))))
          ( h (f ∂Δ¹-0) (f ∂Δ¹-1))

    is-hom-separated↔Hom∈S
      : is-hom-separated A
      ↔ ((a b : A) → Hom A a b ∈ S)
    is-hom-separated↔Hom∈S
      = (Hom∈S←is-hom-separated , is-hom-separated←Hom∈S)
}
}

\subtree[stt-014H]{
\title{Locality at directed suspensions characterises local hom types}
\taxon{Theorem}
\author{fredrikbakke}
\date{2026-09-19}

\p{
A type is local at the directed suspension #{\dirsuspension s} of a map #{s} if and
only if all its hom types are local at #{s}.
}

\agda{
module _ {𝓤 𝓥 𝓦} {C : Type 𝓤} {D : Type 𝓥} (s : C → D) {A : Type 𝓦} where

  Hom-is-local←is-DirectedSusp-local
    : orthogonal-type (DirectedSusp-map s) A
    → (a b : A) → orthogonal-type s (Hom A a b)
  Hom-is-local←is-DirectedSusp-local loc a b
    = Hom∈S←is-hom-separated (Local-gSubU (point s))
        (λ _ f _ → extensions-local←RelativeSusp-local ∂Δ¹-incl s loc f)
        a b tt

  is-DirectedSusp-local←Hom-is-local
    : ((a b : A) → orthogonal-type s (Hom A a b))
    → orthogonal-type (DirectedSusp-map s) A
  is-DirectedSusp-local←Hom-is-local h
    = RelativeSusp-local←extensions-local ∂Δ¹-incl s (λ f
      → is-hom-separated←Hom∈S
          (Local-gSubU (point s))
          (λ a b _ → h a b) tt f tt)

  is-DirectedSusp-local↔Hom-is-local
    : orthogonal-type (DirectedSusp-map s) A
    ↔ ((a b : A) → orthogonal-type s (Hom A a b))
  is-DirectedSusp-local↔Hom-is-local
    = ( Hom-is-local←is-DirectedSusp-local
      , is-DirectedSusp-local←Hom-is-local)
}
}
