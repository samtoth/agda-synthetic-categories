\subtree[stt-00O7]{
\title{Straightening Hom families}
\taxon{Remark}

\p{The unstraightening of the family #{\Hom(-,x)} is the canonical projection #{X_{/x} \to X}. Thus
representable families are contravariant iff #{X_{/x} \to X} are all right
fibrations.}

\agda{
hom-fam-is-contrav↔is-right-fibration
  : ∀ {𝓤} {X : Type 𝓤} (x : X)
    → is-contravariant (λ a → Hom X a x)
    ↔ is-right-fibration {A = Slice X (point x)} fst
hom-fam-is-contrav↔is-right-fibration {X = X} x
  = is-contravariant↔is-right-fibration (λ a → Hom X a x)
  ∙iff right-orthogonal-iff←is-Arrow-equiv (λ _ → i1) (eq .fst) (eq .snd)
  where
  eq : Arrow-equiv (fst: λ a → (i : 𝟙) → Hom X a x)
                   (fst: λ a → Hom X a x)
  eq = mk-arr-equiv (Σ-snd-≃ λ _ → unit-UP≃) id≃ ~refl
}
}

\subtree[stt-00O0]{
\taxon{Theorem}
\title{Contravariance of representable families over right Segal types}

\p{We show that a type #{A} is [right Segal](stt-00O3) iff the family
#{\Hom(-,x)} is contravariant for each #{x}.}

\proof{
We will show that every #{A_{/x} \to A} is a right fibration iff A is
right orthogonal to the map #{\Lambda^2_1 \to \Delta^1 \bjoin 1}.

\p{First we give an equivalence of arrows:}

\quiver{
\begin{tikzcd}
	{\Delta^1\bjoin 1 \to_\bullet A} && {{A_{/x}}^{\Delta^1}} \\
	\\
	{\Lambda^2_1 \to_\bullet A} && {A^{\Delta^1} \times_A A_{/x}}
	\arrow["\sim", from=1-1, to=1-3]
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=3-3]
	\arrow["\sim"', from=3-1, to=3-3]
\end{tikzcd}
}

\p{The top equivalence is given by the [join-slice adjunction](stt-00D5), and
the bottom via the universal property of the horn.}

\p{Now we use \ref{stt-00DC} to finish the proof.}
}

\closedScope{
\subtree[stt-00O1]{
\title{The bottom equivalence}
\agda{
char-slice-lift
  : ∀ {𝓤} {A : Type 𝓤} x
    → Arrow-map (point i1) {C = Slice A (point x)} (fst)
    → Coslice-map {X = Λ[2,1]} (λ _ → ι₂ i1) (point x)
char-slice-lift x (mk-amap top bot comm)
  = cogap (mk-cocone bot
                     (top tt .snd tt .Homᵈ.hom)
                      λ c → comm c ∙ sym (top tt .snd tt .Homᵈ.hom0))
  , λ _ → top tt .snd tt .Homᵈ.hom1

opaque
  char-slice-lift-is-equiv
    : ∀ {𝓤} {A : Type 𝓤} x
      → is-equiv (char-slice-lift {A = A} x)
  char-slice-lift-is-equiv x = is-equiv←qinv qinv where
    qinv : quasi-inv (char-slice-lift x)
    qinv .fst (f , p) = mk-amap (λ _ → (_ , λ _ → mk-hom (f ∘ ι₂) refl (p tt)))
                                (f ∘ ι₁)
                                (ap f ∘ glue)
    qinv .snd .fst (mk-amap top bot comm)
      = let pth = ( (top tt .snd tt .Homᵈ.hom0)
                  , (λ i → ~refl , Square-flatten-hor refl , Square-degen-vert _ _ refl))
        in Arrow-map-path→
             ( (λ a → Slice-path→ pth)
             , ~refl
             , λ a → ap (_∙ ap fst (Slice-path→ pth)) (pushout-rec-apβ a)
                   ∙ ap ((comm tt ∙ sym (Homᵈ.hom0 (top tt .snd tt))) ∙_)
                        (Slice-path-ap-fst pth)
                   ∙ ∙.cancell _ (∙-sym' (Homᵈ.hom0 (top tt .snd tt))) )
    qinv .snd .snd (f , p) = ext!
      ( (sym ∘ pushout-rec-unique _ _ ~refl ~refl ~refl)
      , ~refl)
}
}
}

\agda{
slice-is-right↔right-inner-coslice
  : ∀ {𝓤} {A : Type 𝓤} (x : A)
    → is-right-fibration {A = Slice A (point x)} fst
    ↔ (is-equiv (Coslice-map-precompose (point x) Λ[2,1]-incl▻∙))
slice-is-right↔right-inner-coslice x
  = src↔tgt-is-equiv←Arrow-equiv (amap , amap-eq) module Cov-hom where
  amap : Arrow-map (pullback-power (λ _ → i1) (λ r → fst r))
                   (Coslice-map-precompose (λ _ → x) Λ[2,1]-incl▻∙)
  amap .Arrow-map.top = join←slice-map (λ _ → x)
  amap .Arrow-map.bot = char-slice-lift x
  amap .Arrow-map.comm f = ext!
    ( sym ∘ pushout-rec-unique _ _ ~refl ~refl
              (λ a → ap (_∙ refl) ( ap-∘ _ _ (glue a)
                                  ∙ ap (ap (pushout-rec _)) (pushout-rec-apβ a)
                                  ∙ ap-sym (pushout-rec _) (glue _)
                                  ∙ ap sym (pushout-rec-apβ _))
                    ∙ ∙-reflr _)
    , λ _ → ∙-reflr _ ∙ pushout-rec-apβ _)

  amap-eq : is-Arrow-equiv amap
  amap-eq .fst = join←slice-map-is-equiv (λ _ → x)
  amap-eq .snd = char-slice-lift-is-equiv x

hom-fam-is-contrav↔is-right-segal
  : ∀ {𝓤} {A : Type 𝓤}
    → (∀ (x : A) → is-contravariant (λ a → Hom A a x))
    ↔ is-right-segal A
hom-fam-is-contrav↔is-right-segal {𝓤} {A}
  =  postcomp-Π-↔ (λ
       x → hom-fam-is-contrav↔is-right-fibration x
         ∙iff slice-is-right↔right-inner-coslice x)
  ∙iff logical←equiv (precomp-Π-≃ _ unit-UP≃)
  ∙iff (coslice-orthogonality (Λ[2,1]-incl▻∙) iff⁻¹)
  ∙iff logical←equiv {𝓥 = 𝓘 ⊔ 𝓤} (unit-UP≃ e⁻¹)
}
}

\subtree[stt-00VM]{
\title{Contravariance of representable families}
\date{2026-08-19}
\author{fredrikbakke}
\taxon{Theorem}

\p{The proof is due to [[robschellingerhout]].}

\proof{
We already know that the homs of Segal types are #{Δ¹}-discrete, and precomposition
is a unital transport operation so by the [unital transport criterion](stt-00VL) we
are done.
}

\agda{
hom-fam-contrav
  : ∀ {𝓤} {A : Type 𝓤} → is-segal A → (z : A) → is-contravariant (λ a → Hom A a z)
hom-fam-contrav 𝐴 z
  = is-contravariant←contrav-unital-transport
      (λ _ → Hom-is-Δ¹-discrete←is-segal 𝐴)
      (precomp-hom 𝐴 z , (λ _ → ∘=←Hom2 𝐴 ∘ refl~▵))
}
}

\subtree[stt-00VQ]{
\title{Segal types are right Segal}
\taxon{Corollary}
\author{fredrikbakke}
\date{2026-08-19}

\agda{
is-right-segal←is-segal : ∀ {𝓤} {A : Type 𝓤} → is-segal A → is-right-segal A
is-right-segal←is-segal 𝐴
  = hom-fam-is-contrav↔is-right-segal .fst (hom-fam-contrav 𝐴)

is-segal↔is-right-segal : ∀ {𝓤} {A : Type 𝓤} → is-segal A ↔ is-right-segal A
is-segal↔is-right-segal = (is-right-segal←is-segal , is-segal←is-right-segal)
}
}
