\title{Right Segal types}
\taxon{Module}
\date{2026-05-06}
\import{stt-macros}

\agda{
open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.Categories.RightSegal
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Algebra.Lattice.Instances.Polynomial hiding (Δ²)
private Δ² = Algebra.Lattice.Instances.Polynomial.Δ² I

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Coslices
open import Core.CanonicalPushouts
open import Core.Arrows
open import Core.ArrowRetracts
open import Core.Orthogonal
open import Core.OrthogonalClosure
open import Core.RelativeSuspensions

open import Modalities.GlobalReflectiveSubuniverses
open import Modalities.Instances.Localisation

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Horns Δ¹ I
open import Synthetic.Triangles Δ¹ I
open import Synthetic.Categories.Precategories Δ¹ I
open import Synthetic.Categories.RightCones Δ¹ I

open import Ergonomics.Auto
}
}

\subtree[stt-00O3]{
\taxon{Definition}
\title{Right Segal types}

\p{We call a type \em{right Segal} if it is local with respect to the map
#{\Lambda^2_1 \to (\Delta^1){}^{\rhd}}.}

\remark{
It turns out that Segal types and right Segal types [coincide](stt-00VM).
}

\remark{See [[stt-00DA]] for the dual concept.}

\agda{
Λ[2,1]-incl-Δ¹▻ : Λ[2,1] → Δ¹ ▻
Λ[2,1]-incl-Δ¹▻ = cogap (mk-cocone ▻-ι (▻-hom i1 .Homᵈ.hom) ~refl)

Λ[2,1]-incl-Δ¹▻∗ : map∗ (mk-type∗ Λ[2,1] (ι₂ i1)) (RightCone₀ Δ¹)
Λ[2,1]-incl-Δ¹▻∗ .map∗.hom = Λ[2,1]-incl-Δ¹▻
Λ[2,1]-incl-Δ¹▻∗ .map∗.pres-pt = glue (tt , i1)

is-right-segal : ∀ {𝓤} (A : Type 𝓤) → Type (𝓘 ⊔ 𝓤)
is-right-segal = is-local (point Λ[2,1]-incl-Δ¹▻)
}
}

\subtree[stt-00O4]{
\title{Right Segal types are Segal}
\taxon{Lemma}

\p{Any [right Segal](stt-00O3) type is [Segal](stt-00AI).}

\proof{
\p{
We give a splitting of #{\Delta^2 \hookrightarrow (\Delta^1)^{▻}},
which preserves the inner horn inclusion.
(Note the split embedding #{\Delta^2 \hookrightarrow \square^2} in
\ref{stt-00C7} factors through this map.)}
}

\agda{
Δ²←Δ¹▻ : Δ¹ ▻ → Δ²
Δ²←Δ¹▻
  = RelativeSusp-rec
      (point i1)
      ( point 2
      , λ i → (λ j → (i ∨ j , j) ⦃ ∨-≤-intror ≤-refl ⦄) , λ a → Δ²-ext (1-coinit , refl))

Δ²←Δ¹▻-resp-horn : Δ²←Δ¹▻ ∘ Λ[2,1]-incl-Δ¹▻ ~ Λ[2,1]-incl
Δ²←Δ¹▻-resp-horn = pushout-ind _
  (mk-coconeᵈ
    (λ r → Δ²-ext (0-bottom  , refl))
    (λ l → Δ²-ext (1-coinit' , refl))
    (λ _ → Δ²-is-set _ _ _ _))

Δ¹▻←Δ² : Δ² → Δ¹ ▻
Δ¹▻←Δ² (s , t) = ι₁ (t , s)

Δ¹▻←Δ²-resp-horn
  : Δ¹▻←Δ² ∘ Λ[2,1]-incl ~ Λ[2,1]-incl-Δ¹▻
Δ¹▻←Δ²-resp-horn = pushout-rec-unique _ _
  ~refl
  ~refl
  (λ a
    → ∙-reflr _
    ∙ ap-∘ Δ¹▻←Δ² Λ[2,1]-incl (glue a)
    ∙ ap (ap Δ¹▻←Δ²) (pushout-rec-apβ a)
    ∙ ap-∘ ι₁ _ Δ²-refl ∙ ap (ap ι₁) prop!)

Δ²-retract-of-Δ¹▻ : retract Δ² (Δ¹ ▻)
Δ²-retract-of-Δ¹▻
  = (Δ¹▻←Δ² , Δ²←Δ¹▻ , (λ where ((a , b) ⦃ p ⦄) → Δ²-ext (≤-max' p , refl)))

Λ[2,1]-incl-Arrow-retract-of-Λ[2,1]-incl▻ : Arrow-retract Λ[2,1]-incl Λ[2,1]-incl-Δ¹▻
Λ[2,1]-incl-Arrow-retract-of-Λ[2,1]-incl▻
  = mk-arr-retract idretract Δ²-retract-of-Δ¹▻
      Δ¹▻←Δ²-resp-horn Δ²←Δ¹▻-resp-horn (λ _ → Δ²-is-set _ _ _ _)

is-segal←is-right-segal
  : ∀ {𝓤} {A : Type 𝓤}
    → is-right-segal A
    → is-segal A
is-segal←is-right-segal orth tt
  = orthogonal-type←Arrow-retract _ _
      Λ[2,1]-incl-Arrow-retract-of-Λ[2,1]-incl▻
      (orth tt)
}
}
