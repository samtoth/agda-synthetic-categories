  (open Synthetic.Directedness Δ¹ I)
  (open Synthetic.Boundaries Δ¹ I)
  (@♭ ∂Δ¹-♭-connected : is-♭-connected (Truncation-gRSubU -1) ∂Δ¹-incl)
  (@♭ Δ¹-directed : Δ¹-is-directed)
  where

open import Axioms.UF
}

