\subtree[stt-00RP]{
\title{The functorial action of bipointed wedge sums on bipointed maps}
\taxon{Definition}
\date{2026-05-21}
\author{fredrikbakke}

\agda{
module _
  {𝓤 𝓥 𝓦 𝓜} {A : Type∗∗ 𝓤} {B : Type∗∗ 𝓥} {A' : Type∗∗ 𝓦} {B' : Type∗∗ 𝓜}
  where

  Wedge-map∗∗
    : map∗∗ A A'
    → map∗∗ B B'
    → map∗∗ (Wedge∗∗ A B) (Wedge∗∗ A' B')
  Wedge-map∗∗ F G .map∗∗.hom = Wedge-map (target-map∗ F) (source-map∗ G)
  Wedge-map∗∗ F G .map∗∗.pres-src = ap ι₁ (map∗∗.pres-src F)
  Wedge-map∗∗ F G .map∗∗.pres-tgt = ap ι₂ (map∗∗.pres-tgt G)
}
}
