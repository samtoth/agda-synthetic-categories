\title{The left cone}
\taxon{Module}
\author{samueltoth}
\contributor{fredrikbakke}
\date{2026-09-26}
\import{stt-macros}

\agda{
open import Foundations.Prelude
open import Algebra.Lattice

module Synthetic.Categories.LeftCones
  {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)
  where

open Lattice I renaming (0l to i0; 1l to i1)
open import Algebra.Lattice.Instances.Polynomial hiding (Δ²)
private Δ² = Algebra.Lattice.Instances.Polynomial.Δ² I

open import Axioms.UF
}

\agda-imports{
\agda{
open import Core.Orthogonal
open import Core.CanonicalPushouts
open import Core.RelativeSuspensions

open Core.Orthogonal.notation
open import Ergonomics.Extensionality
open import Ergonomics.Representation

open import Synthetic.Hom Δ¹ i0 i1
open import Synthetic.Boundaries Δ¹ I
open import Synthetic.Categories.Coslices Δ¹ I
}
}

\subtree[tot-0051]{
\title{The left cone on a type}
\taxon{Definition}


\agda{
_◅ : ∀ {𝓤} → Type 𝓤 → Type (𝓘 ⊔ 𝓤)
_◅ = RelativeSusp (point i0)
}
}

\subtree[tot-5051]{
\title{Functoriality of the left cone operation}
\taxon{Construction}

\agda{
LeftCone₀ : ∀ {𝓤} → Type 𝓤 → Type∗ (𝓤 ⊔ 𝓘)
LeftCone₀ A = RelativeSusp∗ i0 A

LeftCone₁
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type 𝓥}
    → (A → B)
    → map∗ (LeftCone₀ A) (LeftCone₀ B)
LeftCone₁ f = RelativeSusp∗₁ i0 f
}
}

\subtree[tot-6594]{
\title{The left cone is a left adjoint}
\taxon{Lemma}

\agda{
LeftCone⊣Coslice
  : ∀ {𝓤 𝓥} {A : Type 𝓤} {B : Type∗ 𝓥}
    → (map∗ (LeftCone₀ A) B) ≃ (A → Coslice₀ B)
LeftCone⊣Coslice = postcomp-≃ (Ext-point≃fibre-ev i0 _) ∘e Susp⊣Ext i0
}
}
