\subtree[stt-008M]{
\date{2025-08-03}
\title{Maps of spans}
\taxon{Definition}

\p{A map between spans #{S} and #{S'} is a diagram as follows where
all the squares commute:}

\quiver{
\begin{tikzcd}
	A && S && B \\
	\\
	{A'} && {S'} && {B'}
	\arrow[from=1-1, to=3-1]
	\arrow[from=1-3, to=1-1]
	\arrow[from=1-3, to=1-5]
	\arrow[from=1-3, to=3-3]
	\arrow[from=1-5, to=3-5]
	\arrow[from=3-3, to=3-1]
	\arrow[from=3-3, to=3-5]
\end{tikzcd}
}


\agda{
record Span-map {𝓤 𝓥 𝓦} (S : Span 𝓤 𝓥 𝓦)
                {𝓤' 𝓥' 𝓦'} (S' : Span 𝓤' 𝓥' 𝓦')
                : Type (𝓤 ⊔ 𝓤' ⊔ 𝓥 ⊔ 𝓥' ⊔ 𝓦 ⊔ 𝓦') where
   constructor mk-span-map
   module S = Span S
   module S' = Span S'
   field
     h₁ : S.Left → S'.Left
     h₂ : S.Centre → S'.Centre
     h₃ : S.Right → S'.Right
     H  : h₁ ∘ S.left ~ S'.left ∘ h₂
     K  : h₃ ∘ S.right ~ S'.right ∘ h₂

   amap-l↓ : Arrow-map S.left S'.left
   amap-l↓ = mk-amap h₂ h₁ H

   amap-l : Arrow-map h₂ h₁
   amap-l = mk-amap S.left S'.left (H h⁻¹)

   amap-r↓ : Arrow-map S.right S'.right
   amap-r↓ = mk-amap h₂ h₃ K

   amap-r : Arrow-map h₂ h₃
   amap-r = mk-amap S.right S'.right (K h⁻¹)

unquoteDecl Span-map-repr≊ Span-map-repr≃
  = make-record-repr Span-map-repr≊ Span-map-repr≃ (quote Span-map)
}

\p{Equivalently, a span map is a pair of arrow maps between the
left and right maps of each span, together with a homotopy between
the two maps between the centre of the spans.}

\agda{
Arrow-maps←Span-map
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦}
      {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-map S S'
    → let module S = Span S ; module S' = Span S'
    in Σ[ F ∶ Arrow-map S.left S'.left ] Σ[ G ∶ Arrow-map S.right S'.right ]
         (F .Arrow-map.top ~ G .Arrow-map.top)
Arrow-maps←Span-map S = (amap-l↓ , amap-r↓ , ~refl) where open Span-map S

Span-map←Arrow-maps
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦}
      {S' : Span 𝓤' 𝓥' 𝓦'}
    → let module S = Span S ; module S' = Span S'
    in Σ[ F ∶ Arrow-map S.left S'.left ] Σ[ G ∶ Arrow-map S.right S'.right ]
         (F .Arrow-map.top ~ G .Arrow-map.top)
    → Span-map S S'
Span-map←Arrow-maps (F , G , H)
  = funext-rec (λ _ → Span-map _ _) at-refl H module from-arrow-map where
  module F = Arrow-map F
  module G = Arrow-map G

  at-refl : F.top ＝ G.top → Span-map _ _
  at-refl refl = mk-span-map F.bot G.top G.bot F.comm G.comm

Span-map≃Arrow-maps
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦}
      {S' : Span 𝓤' 𝓥' 𝓦'}
    → let module S = Span S ; module S' = Span S'
    in (Σ[ F ∶ Arrow-map S.left S'.left ] Σ[ G ∶ Arrow-map S.right S'.right ]
         (F .Arrow-map.top ~ G .Arrow-map.top))
    ≃ Span-map S S'
Span-map≃Arrow-maps = mk≃ Span-map←Arrow-maps (is-equiv←qinv qinv) where
  qinv : quasi-inv Span-map←Arrow-maps
  qinv .fst = Arrow-maps←Span-map
  qinv .snd .fst x@(F , G , HH)
    = funext-rec
        (λ HH'
          → Arrow-maps←Span-map (Span-map←Arrow-maps (F , G , HH')) ＝ (F , G , HH'))
        lem
        HH where
    open Span-map
    lem : (p : (Arrow-map.top F) ＝ (Arrow-map.top G)) →
           Arrow-maps←Span-map (Span-map←Arrow-maps (F , G , happly p)) ＝
           (F , G , happly p)
    lem refl =
      (Arrow-maps←Span-map ∘ Span-map←Arrow-maps) (F , G , ~refl)
        ＝⟨⟩
      Arrow-maps←Span-map (funext-rec (λ _ → Span-map _ _)
        (from-arrow-map.at-refl _ _ _) ~refl)
      ＝⟨ ap Arrow-maps←Span-map (funext-rec-~refl _ (from-arrow-map.at-refl _ _ _)) ⟩
      (F , G , ~refl) ∎ where open Span-map
  qinv .snd .snd F =  funext-rec-~refl _ (from-arrow-map.at-refl _ _ _)

span-map-pathᵈ→
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦}
      {S' : Span 𝓤' 𝓥' 𝓦'}
      {S'' : Span 𝓤' 𝓥' 𝓦'}
      {f : Span-map S' S} {g : Span-map S'' S}
    → let module S = Span S
          module S' = Span S'
          module S'' = Span S''
          module f = Span-map f
          module g = Span-map g
    in (p : S'.Centre ＝ S''.Centre)
    → (q : S'.Left ＝ S''.Left)
    → (r : S'.Right ＝ S''.Right)
    → (h : coe r ∘ S'.right ＝ S''.right ∘ coe p)
    → (k : coe q ∘ S'.left ＝ S''.left ∘ coe p)
    → (Q : f.h₁ ＝ g.h₁ ∘ coe q)
    → (P : f.h₂ ＝ g.h₂ ∘ coe p)
    → (R : f.h₃ ＝ g.h₃ ∘ coe r)
    → (H : f.H ＝   (happly Q ▸ S'.left) ∙h (g.h₁ ◂ happly k)
                  ∙h (g.H ▸ coe p) ∙h (S.left ◂ happly (sym P)))
    → (K : f.K ＝ (happly R ▸ S'.right) ∙h (g.h₃ ◂ happly h)
                 ∙h (g.K ▸ coe p) ∙h S.right ◂ (happly (sym P)))
    → Idᶠ (λ P → Span-map P S) (Span-path→ p q r h k) f g
span-map-pathᵈ→ refl refl refl refl refl refl refl refl refl refl
  = ap₂ (λ P Q → mk-span-map _ _ _ P Q)
        (funext→ (λ a → ∙-reflr _))
        (funext→ (λ a → ∙-reflr _))
}
}

\subtree[stt-00B5]{
\title{Span equivalences}
\taxon{Theorem}

\p{We call a span map an equivalence if each component is an equivalence.
Span equivalences give rise to inverse span maps in the obvious way.}

\agda{
is-Span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-map S S' → Type (𝓤' ⊔ 𝓥' ⊔ 𝓦' ⊔ 𝓤 ⊔ 𝓥 ⊔ 𝓦)
is-Span-equiv F = is-equiv h₁
                    × is-equiv h₂
                    × is-equiv h₃ where
  open Span-map F

l-is-arrow-equiv←is-span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F : Span-map S S') → is-Span-equiv F
    → is-Arrow-equiv (Span-map.amap-l↓ F)
l-is-arrow-equiv←is-span-equiv F eq
  = (eq .snd .fst , eq .fst)

r-is-arrow-equiv←is-span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F : Span-map S S') → is-Span-equiv F
    → is-Arrow-equiv (Span-map.amap-r↓ F)
r-is-arrow-equiv←is-span-equiv F eq
  = (eq .snd .fst , eq .snd .snd)

Span⁻¹←Span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F : Span-map S S') → is-Span-equiv F
    → Span-map S' S
Span⁻¹←Span-equiv F (e1 , e2 , e3)
  = mk-span-map F₁.bwd F₂.bwd F₃.bwd H1 H2 module Span-inv where
  module F = Span-map F
  module S = F.S
  module S' = F.S'
  module F₁ = is-equiv e1
  module F₂ = is-equiv e2
  module F₃ = is-equiv e3


  K1 : F.h₁ ∘ F₁.bwd ∘ S'.left ∘ F.h₂ ~ F.h₁ ∘ S.left ∘ F₂.bwd ∘ F.h₂
  K1 = (F₁.ε ▸ S'.left ▸ F.h₂ ∙h (F.H h⁻¹) ∙h (F.h₁ ◂ (S.left ◂ F₂.η) h⁻¹))

  H1 : F₁.bwd ∘ S'.left ~ S.left ∘ F₂.bwd
  H1 = e1 ◂e⁻¹ K1 ▸e⁻¹ e2

  K2 : F.h₃ ∘ F₃.bwd ∘ S'.right ∘ F.h₂ ~ F.h₃ ∘ S.right ∘ F₂.bwd ∘ F.h₂
  K2 = (F₃.ε ▸ S'.right ▸ F.h₂) ∙h (F.K h⁻¹) ∙h (F.h₃ ◂ (S.right ◂ F₂.η) h⁻¹)

  H2 : F₃.bwd ∘ S'.right ~ S.right ∘ F₂.bwd
  H2 = e3 ◂e⁻¹ K2 ▸e⁻¹ e2
}
}

\subtree[stt-00AJ]{
\title{Span map composition}
\taxon{Construction}
\date{2025-11-21}

\agda{
compose-span-map
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' 𝓤'' 𝓥'' 𝓦''}
      {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'} {S'' : Span 𝓤'' 𝓥'' 𝓦''}
    → Span-map S' S'' → Span-map S S'
    → Span-map S S''
compose-span-map F G = map where
  module F = Span-map F
  module G = Span-map G

  map : Span-map _ _
  map .Span-map.h₁ = F.h₁ ∘ G.h₁
  map .Span-map.h₂ = F.h₂ ∘ G.h₂
  map .Span-map.h₃ = F.h₃ ∘ G.h₃
  map .Span-map.H = (F.h₁ ◂ G.H) ∙h (F.H ▸ G.h₂)
  map .Span-map.K = F.h₃ ◂ G.K ∙h F.K ▸ G.h₂

id-span-map
  : ∀ {𝓤 𝓥 𝓦} {S : Span 𝓤 𝓥 𝓦}
    → Span-map S S
id-span-map = mk-span-map id id id ~refl ~refl

id-span-map-is-equiv
  : ∀ {𝓤 𝓥 𝓦} {S : Span 𝓤 𝓥 𝓦}
    → is-Span-equiv (id-span-map {S = S})
id-span-map-is-equiv = (id-is-equiv , id-is-equiv , id-is-equiv)
}
}

\subtree[stt-00AZ]{
\title{Univalence for spans}
\taxon{Theorem}

\p{Span equivalences are an identity system for spans.}

\agda{
Span-equiv
  : {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' : Level}
  → Span 𝓤 𝓥 𝓦
  → Span 𝓤' 𝓥' 𝓦'
  → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓤' ⊔ 𝓥' ⊔ 𝓦')
Span-equiv S S' = Σ[ F ∶ Span-map S S' ] is-Span-equiv F

Span-equiv'
  : {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦' : Level}
  → Span 𝓤 𝓥 𝓦
  → Span 𝓤' 𝓥' 𝓦'
  → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓤' ⊔ 𝓥' ⊔ 𝓦')
Span-equiv' S S'
  = Σ[ F ∶ (S .Span.Centre ≃ S' .Span.Centre) ]
    Σ[ L ∶ (S .Span.Left ≃ S' .Span.Left) ]
    Σ[ _ ∶ (L ._≃_.fwd ∘ S .Span.left ~ S' .Span.left ∘ F ._≃_.fwd) ]
    Σ[ R ∶ (S .Span.Right ≃ S' .Span.Right) ]
      (R ._≃_.fwd ∘ S .Span.right ~ S' .Span.right ∘ F ._≃_.fwd)

Span-equiv'≃Span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span  𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-equiv S S' ≃ Span-equiv' S S'
Span-equiv'≃Span-equiv {S = S} {S' = S'}
  = mk≃ (qinv ._≊_.fwd) (mk-eqv (qinv ._≊_.fwd-qinv) ~refl) where
  qinv : Span-equiv S S' ≊ Span-equiv' S S'
  qinv ._≊_.fwd (smap , (leq , ceq , req))
    =
    ( mk≃ (smap .Span-map.h₂) ceq
    , mk≃ (smap .Span-map.h₁) leq
    , smap .Span-map.H
    , mk≃ (smap .Span-map.h₃) req
    , smap .Span-map.K)
  qinv ._≊_.fwd-qinv .fst (mk≃ c ceq , mk≃ l leq , H , mk≃ r req , K)
    = (mk-span-map l c r H K , leq , ceq , req)
  qinv ._≊_.fwd-qinv .snd .fst = ~refl
  qinv ._≊_.fwd-qinv .snd .snd = ~refl

components←Span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-equiv S S' → Span-equiv' S S'
components←Span-equiv = _≃_.fwd Span-equiv'≃Span-equiv

Span-equiv←components
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-equiv' S S' → Span-equiv S S'
Span-equiv←components = _≃_.bwd Span-equiv'≃Span-equiv

inverse-components←Span-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-equiv S S'
    → Span-equiv' S' S
inverse-components←Span-equiv {S = S} {S'} e
  = from-components (components←Span-equiv e)
  where
  from-components
    : Span-equiv' S S'
    → Span-equiv' S' S
  from-components (F , L , H , R , K)
    = (F e⁻¹)
    , (L e⁻¹ , left-inv-comm , (R e⁻¹ , right-inv-comm))
    where
    left-inv-comm : _≃_.bwd L ∘ S' .Span.left ~ S .Span.left ∘ _≃_.bwd F
    left-inv-comm p
      = ap (_≃_.bwd L) (ap (S' .Span.left) (sym (_≃_.ε F p)))
      ∙ ap (_≃_.bwd L) (sym (H (_≃_.bwd F p)))
      ∙ _≃_.η L (S .Span.left (_≃_.bwd F p))

    right-inv-comm : _≃_.bwd R ∘ S' .Span.right ~ S .Span.right ∘ _≃_.bwd F
    right-inv-comm p
      = ap (_≃_.bwd R) (ap (S' .Span.right) (sym (_≃_.ε F p)))
      ∙ ap (_≃_.bwd R) (sym (K (_≃_.bwd F p)))
      ∙ _≃_.η R (S .Span.right (_≃_.bwd F p))

Span-equiv←inverse-components
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → Span-equiv' S' S
    → Span-equiv S S'
Span-equiv←inverse-components {S = S} {S'} (F , L , H , R , K)
  = Span-equiv←components
      ( (F e⁻¹)
      , (L e⁻¹)
      , (λ p
          → sym (ap (_≃_.bwd L) (ap (Span.left S) (_≃_.ε F p)))
          ∙ sym (ap (_≃_.bwd L) (H (_≃_.bwd F p)))
          ∙ is-equiv.η (L ._≃_.fwd-is-equiv) (Span.left S' (_≃_.bwd F p)))
      , (R e⁻¹)
      , (λ p
          → sym (ap (_≃_.bwd R) (ap (Span.right S) (_≃_.ε F p)))
          ∙ sym (ap (_≃_.bwd R) (K (_≃_.bwd F p)))
          ∙ is-equiv.η (R ._≃_.fwd-is-equiv) (Span.right S' (_≃_.bwd F p))))

Span-equiv←Id
  : ∀ {𝓤 𝓥 𝓦} {S S' : Span 𝓤 𝓥 𝓦}
    → S ＝ S' → Span-equiv S S'
Span-equiv←Id {S = S} refl = (id-span-map , id-span-map-is-equiv {S = S})

opaque
  Span-equiv←Id-is-equiv
    : ∀ {𝓤 𝓥 𝓦} {S S' : Span 𝓤 𝓥 𝓦} → is-equiv (Span-equiv←Id {S = S} {S'})
  Span-equiv←Id-is-equiv {S = S} {S'}
    = fundamental-Id
       (Span-equiv S)
       (is-single←equiv-to-single
         ((Σ-fst-≃
            {B = λ (C , _ , f , _ , g) → Span-equiv S (mk-span C f g) }
            Span-repr≃ ∙e Σ-snd-≃ (λ a → Span-equiv'≃Span-equiv)) e⁻¹)
         (is-singleton-structure←parts (SingS-is-single (Centre S))
          (S .Centre , id≃)
          (is-singleton-structure←parts
           (SingS-is-single (Left S))
           (Left S , id≃)
           (is-singleton-structure←parts
            (SingS-is-single (left S))
            (left S , ~refl)
            (is-singleton-structure←parts
              (SingS-is-single (Right S))
              (Right S , id≃)
              (SingS-is-single (right S)))))))
       (λ _ → Span-equiv←Id)
       S' where open Span

instance
  SpanIdS : ∀ {𝓤 𝓥 𝓦} → Identity-system (Span 𝓤 𝓥 𝓦) (𝓤 ⊔ 𝓥 ⊔ 𝓦)
  SpanIdS .Identity-system.IdS = Span-equiv
  SpanIdS .Identity-system.IdS←Id = Span-equiv←Id
  SpanIdS .Identity-system.IdS←Id-is-equiv _ _ = Span-equiv←Id-is-equiv
}
}


\subtree[stt-00B0]{
\title{Homotopy of span maps}
\taxon{Definition}

\agda{
Span-map-homotopy
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F G : Span-map S S') → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓤' ⊔ 𝓥' ⊔ 𝓦')
Span-map-homotopy F G
  = Σ[ H₁ ∶ F.h₁ ~ G.h₁ ] Σ[ H₂ ∶ F.h₂ ~ G.h₂ ] Σ[ H₃ ∶ F.h₃ ~ G.h₃ ]
       ((F.H ~ H₁ ▸ F.S.left ∙h G.H ∙h F.S'.left ◂ (H₂ h⁻¹))
       ×  (F.K ~ (H₃ ▸ F.S.right ∙h G.K ∙h F.S'.right ◂ (H₂ h⁻¹)))) where
  module F = Span-map F
  module G = Span-map G

Span-map-homotopy-refl
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F : Span-map S S') → Span-map-homotopy F F
Span-map-homotopy-refl F = ~refl , ~refl , ~refl , ∙h-reflr _ h⁻¹ , ∙h-reflr _ h⁻¹

Span-map-funext→
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
      {F G : Span-map S S'} → Span-map-homotopy F G → F ＝ G
Span-map-funext→ {S = S} {S'} {F} {G} (p , q , r , s , t)
  = span-map-pathᵈ→ refl refl refl refl refl
     (funext→ p) (funext→ q) (funext→ r)
     (funext→ (λ a → s a
                   ∙ ap ((p (S.left a) ∙_) ∘ (G.H a ∙_))
                        (ap (ap G.S'.left) (q-sym-happly a)))
      ∙ ap (λ x → x ▸ G.S.left ∙h G.H ∙h G.S'.left ◂ happly (sym (funext→ q)))
           (sym funext-redex))
     (funext→ (λ a → t a
                   ∙ ap ((r (S.right a) ∙_) ∘ (G.K a ∙_))
                        (ap (ap S'.right) (q-sym-happly a)))
      ∙ ap (λ x → x ▸ G.S.right ∙h G.K ∙h S'.right ◂ happly (sym (funext→ q)))
           (sym funext-redex)) where
   module S = Span S
   module S' = Span S'
   module G = Span-map G

   q-sym-happly : ∀ a → sym (q a) ＝ happly (sym (funext→ q)) a
   q-sym-happly a
     = ap sym (sym (happly funext-redex a))
     ∙ sym (happly (happly-sym (funext→ q) a) a)
}
}

\subtree[stt-00AM]{
\title{Quasi-equivalences of spans}
\taxon{Theorem}

\p{An equivalence of spans gives rise to a quasi-equivalence in span. I.e. we
get a pair of span maps whose composition is homotopic to the identity span map.}


\remark{This remains to be formalised.}

\agda{
record Span-quasi-inv {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
         {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'} (F : Span-map S S')
         : Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓤' ⊔ 𝓥' ⊔ 𝓦') where
  constructor mk-span-qinv
  field
    bwd : Span-map S' S
    ε : Span-map-homotopy (compose-span-map F bwd) id-span-map
    η : Span-map-homotopy (compose-span-map bwd F) id-span-map
}
}


\subtree[stt-00CN]{
\title{Spans of proposition}
\taxon{Definition}

\p{We call a span a \em{span of propositions} if each type is a proposition.}

\agda{
is-prop-span : ∀ {𝓤 𝓥 𝓦} → Span 𝓤 𝓥 𝓦 → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦)
is-prop-span S = is-prop Left × is-prop Centre × is-prop Right
  where open Span S
}

\p{We note that any span map into a propositional span is equal.}

\agda{
Span-map-homotopy←dom-is-prop
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'} {S : Span 𝓤 𝓥 𝓦} {S' : Span 𝓤' 𝓥' 𝓦'}
    → (F G : Span-map S S') → is-prop-span S' → Span-map-homotopy F G
Span-map-homotopy←dom-is-prop F G prp .fst a
  = prp .fst (Span-map.h₁ F a) (Span-map.h₁ G a)
Span-map-homotopy←dom-is-prop F G prp .snd .fst a
  = prp .snd .fst (Span-map.h₂ F a) (Span-map.h₂ G a)
Span-map-homotopy←dom-is-prop F G prp .snd .snd .fst a
  = prp .snd .snd (Span-map.h₃ F a) (Span-map.h₃ G a)
Span-map-homotopy←dom-is-prop F G prp .snd .snd .snd .fst _
  = is-prop←is-single (＝-is-single←is-prop (prp .fst) _ _) _ _
Span-map-homotopy←dom-is-prop F G prp .snd .snd .snd .snd _
  = is-prop←is-single (＝-is-single←is-prop (prp .snd .snd) _ _) _ _
}
}

\subtree[stt-00CO]{
\title{Logical equivalence of spans}
\taxon{Definition}

\p{Given spans #{S} and #{S'} (which are usually spans of propositions),
a logical equivalence #{S \iff S'} of spans is a logical equivalence between
each point of the spans.}

\agda{
Span-logical-equiv
  : ∀ {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
    → Span 𝓤 𝓥 𝓦
    → Span 𝓤' 𝓥' 𝓦'
    → Type (𝓤 ⊔ 𝓥 ⊔ 𝓦 ⊔ 𝓤' ⊔ 𝓥' ⊔ 𝓦')
Span-logical-equiv S S' = (S .Left ↔ S' .Left)
                        × (S .Centre ↔ S' .Centre)
                        × (S .Right ↔ S' .Right)
  where open Span
}

\p{We show a logical equivalence of spans of propositions gives rise to an
equivalence of spans.}

\agda{
module Span-logical-equiv {𝓤 𝓥 𝓦 𝓤' 𝓥' 𝓦'}
         {S : Span 𝓤 𝓥 𝓦} (spr : is-prop-span S)
         {S' : Span 𝓤' 𝓥' 𝓦'} (s'pr : is-prop-span S')
         (e : Span-logical-equiv S S')
         where
  fwd : Span-map S S'
  fwd .Span-map.h₁ = e .fst .fst
  fwd .Span-map.h₂ = e .snd .fst .fst
  fwd .Span-map.h₃ = e .snd .snd .fst
  fwd .Span-map.H _ = s'pr .fst _ _
  fwd .Span-map.K _ = s'pr .snd .snd _ _

  bwd : Span-map S' S
  bwd .Span-map.h₁ = e .fst .snd
  bwd .Span-map.h₂ = e .snd .fst .snd
  bwd .Span-map.h₃ = e .snd .snd .snd
  bwd .Span-map.H _ = spr .fst _ _
  bwd .Span-map.K _ = spr .snd .snd _ _

  fwd-is-equiv : is-Span-equiv fwd
  fwd-is-equiv .fst = is-equiv←inverse (spr .fst) (s'pr .fst) (e .fst .snd)
  fwd-is-equiv .snd .fst
    = is-equiv←inverse (spr .snd .fst) (s'pr .snd .fst) (e .snd .fst .snd)
  fwd-is-equiv .snd .snd
    = is-equiv←inverse (spr .snd .snd) (s'pr .snd .snd) (e .snd .snd .snd)

  fwd-qinv : Span-quasi-inv fwd
  fwd-qinv .Span-quasi-inv.bwd = bwd
  fwd-qinv .Span-quasi-inv.ε = Span-map-homotopy←dom-is-prop _ _ s'pr
  fwd-qinv .Span-quasi-inv.η = Span-map-homotopy←dom-is-prop _ _ spr
}
}
