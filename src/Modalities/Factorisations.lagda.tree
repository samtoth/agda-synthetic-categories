\author{fredrikbakke}
\taxon{Module}
\import{stt-macros}
\title{Factorisations of maps}

\agda{
module Modalities.Factorisations where

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude
open import Ergonomics.Representation
